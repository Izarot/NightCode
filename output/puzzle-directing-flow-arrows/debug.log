 <p class=\"subtitle\">Route the runners to safety!</p>\n            <div class=\"modal-buttons\">\n                <button class=\"modal-btn primary\" id=\"start-game-btn\">Start Game</button>\n                <button class=\"modal-btn\" id=\"level-select-btn\">Level Select</button>\n                <button class=\"modal-btn\" id=\"settings-btn\">Settings</button>\n            </div>\n        </div>\n    </div>\n\n    <!-- Pause Modal -->\n    <div class=\"modal-overlay\" id=\"pause-modal\">\n        <div class=\"modal-card\">\n            <h2 class=\"modal-title\">PAUSED</h2>\n            <div class=\"modal-buttons\">\n                <button class=\"modal-btn primary\" id=\"resume-btn\">Resume</button>\n                <button class=\"modal-btn\" id=\"restart-level-btn\">Restart Level</button>\n                <button class=\"modal-btn\" id=\"pause-level-select-btn\">Level Select</button>\n                <button class=\"modal-btn\" id=\"quit-title-btn\">Quit to Title</button>\n            </div>\n        </div>\n    </div>\n\n    <!-- Level Complete Modal -->\n    <div class=\"modal-overlay\" id=\"complete-modal\">\n        <div class=\"modal-card\">\n            <h2 class=\"modal-title success\">LEVEL COMPLETE!</h2>\n            <div class=\"modal-stats\">\n                <div class=\"stat-item\">\n                    <div class=\"stat-value\" id=\"stat-saved\" style=\"color: var(--accent-green)\">0</div>\n                    <div class=\"stat-label\">Saved</div>\n                </div>\n                <div class=\"stat-item\">\n                    <div class=\"stat-value\" id=\"stat-lost\" style=\"color: var(--accent-orange)\">0</div>\n                    <div class=\"stat-label\">Lost</div>\n                </div>\n                <div class=\"stat-item\">\n                    <div class=\"stat-value\" id=\"stat-time\" style=\"color: var(--accent-gold)\">0:00</div>\n                    <div class=\"stat-label\">Time</div>\n                </div>\n            </div>\n            <div id=\"stars-display\" style=\"text-align: center; font-size: 32px; margin-bottom: 24px;\">⭐⭐⭐</div>\n            <div class=\"modal-buttons\">\n                <button class=\"modal-btn primary\" id=\"next-level-btn\">Next Level</button>\n                <button class=\"modal-btn\" id=\"replay-btn\">Replay</button>\n                <button class=\"modal-btn\" id=\"complete-level-select-btn\">Level Select</button>\n            </div>\n        </div>\n    </div>\n\n    <!-- Level Failed Modal -->\n    <div class=\"modal-overlay\" id=\"failed-modal\">\n        <div class=\"modal-card\">\n            <h2 class=\"modal-title failure\">TRY AGAIN</h2>\n            <p id=\"failure-reason\" style=\"text-align: center; color: var(--text-muted); margin-bottom: 24px;\">Objective failed!</p>\n            <div class=\"modal-buttons\">\n                <button class=\"modal-btn primary\" id=\"retry-btn\">Retry</button>\n                <button class=\"modal-btn\" id=\"failed-level-select-btn\">Level Select</button>\n            </div>\n        </div>\n    </div>\n\n    <!-- Level Select Modal -->\n    <div class=\"modal-overlay\" id=\"level-select-modal\">\n        <div class=\"modal-card\">\n            <h2 class=\"modal-title\">Select Level</h2>\n            <div class=\"level-grid\" id=\"level-grid\"></div>\n            <div class=\"modal-buttons\">\n                <button class=\"modal-btn\" id=\"back-to-title-btn\">Back to Title</button>\n            </div>\n        </div>\n    </div>\n\n    <!-- Settings Modal -->\n    <div class=\"modal-overlay\" id=\"settings-modal\">\n        <div class=\"modal-card\">\n            <h2 class=\"modal-title\">Settings</h2>\n            <div style=\"margin-bottom: 24px;\">\n                <label style=\"display: flex; align-items: center; gap: 12px; margin-bottom: 12px; color: var(--text-primary);\">\n                    <input type=\"checkbox\" id=\"setting-sound\">\n                    Sound Effects\n                </label>\n                <label style=\"display: flex; align-items: center; gap: 12px; color: var(--text-primary);\">\n                    <input type=\"checkbox\" id=\"setting-high-contrast\">\n                    High Contrast Mode\n                </label>\n            </div>\n            <div class=\"modal-buttons\">\n                <button class=\"modal-btn primary\" id=\"settings-close-btn\">Close</button>\n            </div>\n        </div>\n    </div>\n\n    <script>\n    // ==================== GAME ENGINE ====================\n    const Game = {\n        // Constants\n        TICK_RATE: 60,\n        DIRECTIONS: {\n            N: { x: 0, y: -1 },\n            S: { x: 0, y: 1 },\n            E: { x: 1, y: 0 },\n            W: { x: -1, y: 0 },\n            NE: { x: 1, y: -1 },\n            NW: { x: -1, y: -1 },\n            SE: { x: 1, y: 1 },\n            SW: { x: -1, y: 1 }\n        },\n        DIR_ARROWS: {\n            N: '▲', S: '▼', E: '▶', W: '◀',\n            NE: '↗', NW: '↖', SE: '↘', SW: '↙'\n        },\n        DIR_DEG: { N: 0, E: 90, S: 180, W: 270, NE: 45, SE: 135, SW: 225, NW: 315 },\n\n        // Colors\n        COLORS: {\n            bg: '#0E1428',\n            grid: '#1B2438',\n            wall: '#2A2F3E',\n            runner: '#F5F5F0',\n            runnerGlow: '#7FE7FF',\n            exit: '#5EE08C',\n            hazard: '#FF6B4A',\n            spawner: '#FFC857',\n            arrow: '#3FD0C9',\n            conveyor: '#A78BFA',\n            mirror: '#D6D6E0'\n        },\n\n        // State\n        canvas: null,\n        ctx: null,\n        width: 0,\n        height: 0,\n        cellSize: 32,\n        grid: null,\n        gridWidth: 0,\n        gridHeight: 0,\n        offsetX: 0,\n        offsetY: 0,\n        state: 'title', // title, build, run, paused, complete, failed\n        phase: 'build', // build, run\n        tick: 0,\n        lastTime: 0,\n        accumulator: 0,\n        speedMultiplier: 1,\n        soundEnabled: true,\n        highContrast: false,\n        selectedTile: null,\n        mouseX: 0,\n        mouseY: 0,\n        hoveredCell: null,\n        isDragging: false,\n        draggedTile: null,\n        spawnQueue: [],\n        runners: [],\n        particles: [],\n        floaterTexts: [],\n        inventory: [],\n        inventoryIndex: 0,\n        placedTiles: new Map(), // \"x,y\" -> tile data\n        objectives: [],\n        stats: {\n            spawned: 0,\n            saved: 0,\n            lost: 0,\n            startTime: 0,\n            elapsedTime: 0,\n            bestTime: 0\n        },\n        currentLevel: 0,\n        unlockedLevel: 0,\n        levelScores: [], // {stars, time} per level\n        tickInterval: 30, // ticks between runner steps\n        tickCounter: 0,\n        cameraShake: 0,\n        flashIntensity: 0,\n        tickFlash: 0,\n\n        init() {\n            this.canvas = document.getElementById('game-canvas');\n            this.ctx = this.canvas.getContext('2d');\n            this.resize();\n            window.addEventListener('resize', () => this.resize());\n            this.loadProgress();\n            this.bindEvents();\n            this.setupUI();\n            this.lastTime = performance.now();\n            requestAnimationFrame((t) => this.loop(t));\n        },\n\n        resize() {\n            const w = window.innerWidth;\n            const h = window.innerHeight;\n            this.canvas.width = w * window.devicePixelRatio;\n            this.canvas.height = h * window.devicePixelRatio;\n            this.canvas.style.width = w + 'px';\n            this.canvas.style.height = h + 'px';\n            this.ctx.scale(window.devicePixelRatio, window.devicePixelRatio);\n            this.width = w;\n            this.height = h;\n            this.calculateGrid();\n        },\n\n        calculateGrid() {\n            // Determine grid size based on current level\n            const level = LEVELS[this.currentLevel];\n            if (!level) return;\n            this.gridWidth = level.width;\n            this.gridHeight = level.height;\n            // Compute cell size to fit\n            const maxW = this.width - 40;\n            const maxH = this.height - 56 - 88 - 40;\n            this.cellSize = Math.floor(Math.min(maxW / this.gridWidth, maxH / this.gridHeight));\n            this.cellSize = Math.max(16, Math.min(this.cellSize, 64));\n            const gridPxW = this.gridWidth * this.cellSize;\n            const gridPxH = this.gridHeight * this.cellSize;\n            this.offsetX = Math.floor((this.width - gridPxW) / 2);\n            this.offsetY = 56 + Math.floor((maxH - gridPxH) / 2);\n        },\n\n        bindEvents() {\n            this.canvas.addEventListener('mousedown', (e) => this.onMouseDown(e));\n            this.canvas.addEventListener('mousemove', (e) => this.onMouseMove(e));\n            this.canvas.addEventListener('mouseup', (e) => this.onMouseUp(e));\n            this.canvas.addEventListener('mouseleave', (e) => this.onMouseLeave(e));\n            this.canvas.addEventListener('contextmenu', (e) => e.preventDefault());\n            this.canvas.addEventListener('touchstart', (e) => this.onTouchStart(e), { passive: false });\n            this.canvas.addEventListener('touchmove', (e) => this.onTouchMove(e), { passive: false });\n            this.canvas.addEventListener('touchend', (e) => this.onTouchEnd(e), { passive: false });\n\n            document.addEventListener('keydown', (e) => this.onKeyDown(e));\n\n            document.getElementById('sound-btn').addEventListener('click', () => this.toggleSound());\n            document.getElementById('pause-btn').addEventListener('click', () => this.showPause());\n\n            document.getElementById('go-button').addEventListener('click', () => this.startRun());\n            document.getElementById('restart-btn').addEventListener('click', () => this.restartRun());\n            document.getElementById('speed-btn').addEventListener('click', () => this.cycleSpeed());\n            document.getElementById('pause-resume-btn').addEventListener('click', () => this.toggleRunPause());\n\n            document.getElementById('start-game-btn').addEventListener('click', () => this.startGame());\n            document.getElementById('level-select-btn').addEventListener('click', () => this.showLevelSelect());\n            document.getElementById('settings-btn').addEventListener('click', () => this.showSettings());\n\n            document.getElementById('resume-btn').addEventListener('click', () => this.hidePause());\n            document.getElementById('restart-level-btn').addEventListener('click', () => this.restartLevel());\n            document.getElementById('pause-level-select-btn').addEventListener('click', () => { this.hidePause(); this.showLevelSelect(); });\n            document.getElementById('quit-title-btn').addEventListener('click', () => { this.hidePause(); this.showTitle(); });\n\n            document.getElementById('next-level-btn').addEventListener('click', () => this.nextLevel());\n            document.getElementById('replay-btn').addEventListener('click', () => this.restartLevel());\n            document.getElementById('complete-level-select-btn').addEventListener('click', () => this.showLevelSelect());\n\n            document.getElementById('retry-btn').addEventListener('click', () => this.restartLevel());\n            document.getElementById('failed-level-select-btn').addEventListener('click', () => this.showLevelSelect());\n\n            document.getElementById('back-to-title-btn').addEventListener('click', () => { this.hideLevelSelect(); this.showTitle(); });\n\n            document.getElementById('settings-close-btn').addEventListener('click', () => this.hideSettings());\n\n            document.getElementById('setting-sound').addEventListener('change', (e) => { this.soundEnabled = e.target.checked; this.saveProgress(); });\n            document.getElementById('setting-high-contrast').addEventListener('change', (e) => { this.highContrast = e.target.checked; this.saveProgress(); });\n        },\n\n        setupUI() {\n            this.renderLevelGrid();\n            document.getElementById('setting-sound').checked = this.soundEnabled;\n            document.getElementById('setting-high-contrast').checked = this.highContrast;\n        },\n\n        renderLevelGrid() {\n            const grid = document.getElementById('level-grid');\n            grid.innerHTML = '';\n            LEVELS.forEach((lv, i) => {\n                const btn = document.createElement('button');\n                btn.className = 'level-btn';\n                if (i > this.unlockedLevel) btn.classList.add('locked');\n                if (i === this.currentLevel) btn.classList.add('current');\n                const stars = this.levelScores[i] ? '★'.repeat(this.levelScores[i].stars) + '☆'.repeat(3 - this.levelScores[i].stars) : '';\n                btn.innerHTML = `<span>${i + 1}</span>${stars ? `<span class=\"stars\">${stars}</span>` : ''}`;\n                btn.disabled = i > this.unlockedLevel;\n                btn.addEventListener('click', () => {\n                    if (i <= this.unlockedLevel) {\n                        this.currentLevel = i;\n                        this.hideLevelSelect();\n                        this.loadLevel();\n                    }\n                });\n                grid.appendChild(btn);\n            });\n        },\n\n        // ==================== GAME STATE ====================\n        startGame() {\n            document.getElementById('title-modal').classList.remove('active');\n            this.loadLevel();\n        },\n\n        showTitle() {\n            this.state = 'title';\n            document.getElementById('title-modal').classList.add('active');\n            document.getElementById('pause-modal').classList.remove('active');\n        },\n\n        showLevelSelect() {\n            document.getElementById('title-modal').classList.remove('active');\n            document.getElementById('pause-modal').classList.remove('active');\n            this.renderLevelGrid();\n            document.getElementById('level-select-modal').classList.add('active');\n        },\n\n        hideLevelSelect() {\n            document.getElementById('level-select-modal').classList.remove('active');\n        },\n\n        showSettings() {\n            document.getElementById('title-modal').classList.remove('active');\n            document.getElementById('settings-modal').classList.add('active');\n        },\n\n        hideSettings() {\n            document.getElementById('settings-modal').classList.remove('active');\n            document.getElementById('title-modal').classList.add('active');\n        },\n\n        showPause() {\n            if (this.phase === 'run') {\n                this.state = 'paused';\n                document.getElementById('pause-modal').classList.add('active');\n            }\n        },\n\n        hidePause() {\n            this.state = this.phase === 'run' ? 'run' : 'build';\n            document.getElementById('pause-modal').classList.remove('active');\n        },\n\n        loadLevel() {\n            const level = LEVELS[this.currentLevel];\n            if (!level) return;\n            this.gridWidth = level.width;\n            this.gridHeight = level.height;\n            this.grid = Array.from({ length: level.height }, () => Array.from({ length: level.width }, () => null));\n            this.placedTiles.clear();\n            this.runners = [];\n            this.particles = [];\n            this.floaterTexts = [];\n            this.spawnQueue = [];\n            this.stats = { spawned: 0, saved: 0, lost: 0, startTime: 0, elapsedTime: 0, bestTime: 0 };\n            this.tick = 0;\n            this.tickCounter = 0;\n            this.tickInterval = level.tickInterval || 30;\n            this.objectives = [...level.objectives];\n            this.inventory = JSON.parse(JSON.stringify(level.tiles));\n            this.inventoryIndex = 0;\n            this.selectedTile = null;\n            this.phase = 'build';\n            this.state = 'build';\n            this.stats.bestTime = this.levelScores[this.currentLevel] ? this.levelScores[this.currentLevel].time : 0;\n\n            // Load static walls, exits, spawners, hazards\n            for (const w of level.walls || []) this.grid[w[1]][w[0]] = { type: 'wall' };\n            for (const e of level.exits || []) this.grid[e[1]][e[0]] = { type: 'exit', dir: e[2] || null };\n            for (const s of level.spawners || []) {\n                this.grid[s[1]][s[0]] = { type: 'spawner', dir: s[2] || 'E', rate: s[3] || 30, counter: 0, totalToSpawn: s[4] || 0, spawned: 0 };\n                this.spawnQueue.push({ x: s[0], y: s[1], dir: s[2] || 'E', rate: s[3] || 30, counter: 0, total: s[4] || 0, spawned: 0 });\n            }\n            for (const h of level.hazards || []) this.grid[h[1]][h[0]] = { type: 'hazard' };\n\n            this.calculateGrid();\n            this.updateHUD();\n            document.getElementById('bottom-bar').style.display = 'flex';\n            document.getElementById('action-bar').style.display = 'none';\n            document.getElementById('go-button').style.display = 'block';\n            this.renderInventory();\n        },\n\n        startRun() {\n            this.phase = 'run';\n            this.state = 'run';\n            this.stats.startTime = performance.now();\n            document.getElementById('bottom-bar').style.display = 'none';\n            document.getElementById('action-bar').style.display = 'flex';\n            document.getElementById('go-button').style.display = 'none';\n            this.updateActionBar();\n            this.playSound('start');\n        },\n\n        restartRun() {\n            this.loadLevel();\n            this.startRun();\n        },\n\n        toggleRunPause() {\n            if (this.state === 'run') {\n                this.state = 'paused';\n                document.getElementById('pause-resume-btn').innerHTML = '<svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><polygon points=\"5 3 19 12 5 21 5 3\"/></svg> Resume';\n            } else if (this.state === 'paused') {\n                this.state = 'run';\n                document.getElementById('pause-resume-btn').innerHTML = '<svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><rect x=\"6\" y=\"4\" width=\"4\" height=\"16\"/><rect x=\"14\" y=\"4\" width=\"4\" height=\"16\"/></svg> Pause';\n            }\n        },\n\n        cycleSpeed() {\n            const speeds = [1, 2, 4];\n            const idx = speeds.indexOf(this.speedMultiplier);\n            this.speedMultiplier = speeds[(idx + 1) % speeds.length];\n            this.updateActionBar();\n        },\n\n        updateActionBar() {\n            document.querySelector('.speed-display').textContent = this.speedMultiplier + '×';\n        },\n\n        restartLevel() {\n            document.getElementById('pause-modal').classList.remove('active');\n            document.getElementById('complete-modal').classList.remove('active');\n            document.getElementById('failed-modal').classList.remove('active');\n            this.loadLevel();\n        },\n\n        nextLevel() {\n            document.getElementById('complete-modal').classList.remove('active');\n            if (this.currentLevel < LEVELS.length - 1) {\n                this.currentLevel++;\n                if (this.currentLevel > this.unlockedLevel) this.unlockedLevel = this.currentLevel;\n                this.saveProgress();\n                this.loadLevel();\n            } else {\n                this.showTitle();\n            }\n        },\n\n        toggleSound() {\n            this.soundEnabled = !this.soundEnabled;\n            this.saveProgress();\n            document.getElementById('setting-sound').checked = this.soundEnabled;\n        },\n\n        // ==================== INVENTORY ====================\n        renderInventory() {\n            const bar = document.getElementById('bottom-bar');\n            bar.innerHTML = '';\n            const tileTypes = ['arrow', 'mirror', 'conveyor', 'teleporter'];\n            const tileIcons = { arrow: '➤', conveyor: '═', mirror: '◢', teleporter: '⊙' };\n            const tileNames = { arrow: 'Arrow', conveyor: 'Conveyor', mirror: 'Mirror', teleporter: 'Teleporter' };\n            let idx = 0;\n            for (const type of tileTypes) {\n                const slot = document.createElement('div');\n                slot.className = 'inventory-slot';\n                const count = this.inventory[idx] || 0;\n                if (count === 0) slot.classList.add('disabled');\n                if (idx === this.inventoryIndex && count > 0) slot.classList.add('selected');\n                slot.innerHTML = `\n                    <div class=\"tile-icon\">${tileIcons[type]}</div>\n                    ${count > 0 ? `<div class=\"count-badge\">${count}</div>` : ''}\n                    <div class=\"key-hint\">${idx + 1}</div>\n                `;\n                slot.addEventListener('click', () => this.selectInventory(idx));\n                slot.addEventListener('mouseenter', () => this.showTooltip(tileNames[type], event));\n                slot.addEventListener('mouseleave', () => this.hideTooltip();\n                slot.addEventListener('mousemove', (e) => this.moveTooltip(e));\n                bar.appendChild(slot);\n                idx++;\n            }\n        },\n\n        selectInventory(i) {\n            if ((this.inventory[i] || 0) > 0) {\n                this.inventoryIndex = i;\n                this.renderInventory();\n            }\n        },\n\n        // ==================== INPUT ====================\n        getMousePos(e) {\n            const rect = this.canvas.getBoundingClientRect();\n            const cx = (e.touches ? e.touches[0].clientX : e.clientX) - rect.left;\n            const cy = (e.touches ? e.touches[0].clientY : e.clientY) - rect.top;\n            this.mouseX = cx;\n            this.mouseY = cy;\n            return { x: cx, y: cy };\n        },\n\n        cellAtPos(x, y) {\n            const gx = Math.floor((x - this.offsetX) / this.cellSize);\n            const gy = Math.floor((y - this.offsetY) / this.cellSize);\n            if (gx < 0 || gx >= this.gridWidth || gy < 0 || gy >= this.gridHeight) return null;\n            return { x: gx, y: gy };\n        },\n\n        onMouseDown(e) {\n            if (this.state !== 'build') return;\n            const pos = this.getMousePos(e);\n            const cell = this.cellAtPos(pos.x, pos.y);\n            if (!cell) return;\n            const tileData = this.grid[cell.y][cell.x];\n            // Right click = remove placed tile\n            if (e.button === 2) {\n                if (tileData && tileData.placed) {\n                    this.removeTile(cell.x, cell.y);\n                }\n                return;\n            }\n            // Left click on existing placed tile = remove\n            if (tileData && tileData.placed) {\n                this.removeTile(cell.x, cell.y);\n                return;\n            }\n            // Otherwise place selected tile if empty\n            if (!tileData && this.inventory[this.inventoryIndex] > 0) {\n                this.placeTile(cell.x, cell.y, this.inventoryIndex);\n            } else if (!tileData && this.inventory[this.inventoryIndex] === 0) {\n                // Try other tiles in inventory\n                for (let i = 0; i < this.inventory.length; i++) {\n                    if (this.inventory[i] > 0) {\n                        this.inventoryIndex = i;\n                        this.placeTile(cell.x, cell.y, i);\n                        this.renderInventory();\n                        break;\n                    }\n                }\n            }\n        },\n\n        onMouseMove(e) {\n            const pos = this.getMousePos(e);\n            const cell = this.cellAtPos(pos.x, pos.y);\n            this.hoveredCell = cell;\n            this.moveTooltip(e);\n        },\n\n        onMouseUp(e) { this.isDragging = false; },\n        onMouseLeave(e) { this.hoveredCell = null; this.hideTooltip(); },\n\n        onTouchStart(e) {\n            e.preventDefault();\n            this.onMouseDown(e);\n        },\n\n        onTouchMove(e) {\n            e.preventDefault();\n            this.onMouseMove(e);\n        },\n\n        onTouchEnd(e) {\n            e.preventDefault();\n            this.onMouseUp(e);\n        },\n\n        onKeyDown(e) {\n            if (e.key >= '1' && e.key <= '4') {\n                const i = parseInt(e.key) - 1;\n                this.selectInventory(i);\n            } else if (e.key === ' ' || e.key === 'Enter') {\n                if (this.state === 'build') this.startRun();\n                else if (this.state === 'run') this.toggleRunPause();\n                else if (this.state === 'paused') this.toggleRunPause();\n            } else if (e.key === 'Escape') {\n                if (this.state === 'run') this.showPause();\n                else if (this.state === 'paused') this.hidePause();\n            } else if (e.key === 'r' || e.key === 'R') {\n                if (this.phase === 'run') this.restartRun();\n            } else if (e.key === 'Tab') {\n                e.preventDefault();\n                this.cycleSpeed();\n            }\n        },\n\n        // ==================== TILE PLACEMENT ====================\n        placeTile(x, y, typeIdx) {\n            const types = ['arrow', 'mirror', 'conveyor', 'teleporter'];\n            const type = types[typeIdx];\n            this.grid[y][x] = { type: type, placed: true, dir: 'N', pair: null };\n            this.inventory[typeIdx]--;\n            // If teleporter, find or create pair\n            if (type === 'teleporter') {\n                const other = this.findUnpairedTeleporter(x, y);\n                if (other) {\n                    this.grid[y][x].pair = { x: other.x, y: other.y };\n                    this.grid[other.y][other.x].pair = { x, y };\n                }\n            }\n            this.playSound('place');\n            this.renderInventory();\n        },\n\n        removeTile(x, y) {\n            const tile = this.grid[y][x];\n            if (!tile || !tile.placed) return;\n            const types = ['arrow', 'mirror', 'conveyor', 'teleporter'];\n            const idx = types.indexOf(tile.type);\n            this.inventory[idx] = (this.inventory[idx] || 0) + 1;\n            // If teleporter, unlink pair\n            if (tile.type === 'teleporter' && tile.pair) {\n                this.grid[tile.pair.y][tile.pair.x].pair = null;\n            }\n            this.grid[y][x] = null;\n            this.playSound('remove');\n            this.renderInventory();\n        },\n\n        findUnpairedTeleporter(x, y) {\n            for (let yy = 0; yy < this.gridHeight; yy++) {\n                for (let xx = 0; xx < this.gridWidth; xx++) {\n                    const t = this.grid[yy][xx];\n                    if (t && t.type === 'teleporter' && !t.pair && !(xx === x && yy === y)) {\n                        return { x: xx, y: yy };\n                    }\n                }\n            }\n            return null;\n        },\n\n        // ==================== RUN PHASE ====================\n        tickLogic() {\n            this.tick++;\n            this.tickCounter++;\n            this.tickFlash = 1;\n\n            // Spawn runners\n            for (const sp of this.spawnQueue) {\n                sp.counter++;\n                if (sp.counter >= sp.rate && sp.spawned < sp.total) {\n                    sp.counter = 0;\n                    sp.spawned++;\n                    // Check if spawn cell is clear\n                    if (!this.grid[sp.y][sp.x] || !this.grid[sp.y][sp.x].type || this.grid[sp.y][sp.x].type === 'arrow') {\n                        const runner = {\n                            x: sp.x + 0.5,\n                            y: sp.y + 0.5,\n                            dir: sp.dir,\n                            onConveyor: 0,\n                            color: '#' + Math.floor(Math.random() * 0xFFFFFF).toString(16).padStart(6, '0'),\n                            age: 0\n                        };\n                        this.runners.push(runner);\n                        this.stats.spawned++;\n                    }\n                }\n            }\n\n            // Move runners\n            if (this.tickCounter >= this.tickInterval) {\n                this.tickCounter = 0;\n                const newRunners = [];\n                const toRemove = [];\n                for (let i = 0; i < this.runners.length; i++) {\n                    const r = this.runners[i];\n                    r.age++;\n                    const gx = Math.floor(r.x);\n                    const gy = Math.floor(r.y);\n                    let cell = this.grid[gy] && this.grid[gy][gx];\n                    let nextDir = r.dir;\n                    let moved = false;\n\n                    if (cell) {\n                        if (cell.type === 'wall' || cell.type === 'hazard') {\n                            // Crashed\n                            this.stats.lost++;\n                            this.spawnParticles(r.x * this.cellSize + this.offsetX, r.y * this.cellSize + this.offsetY, this.COLORS.hazard);\n                            this.cameraShake = 8;\n                            this.flashIntensity = 0.3;\n                            toRemove.push(i);\n                            continue;\n                        }\n                        if (cell.type === 'exit') {\n                            // Saved\n                            this.stats.saved++;\n                            this.spawnParticles(r.x * this.cellSize + this.offsetX, r.y * this.cellSize + this.offsetY, this.COLORS.exit);\n                            this.playSound('save');\n                            toRemove.push(i);\n                            continue;\n                        }\n                        if (cell.type === 'arrow' && cell.placed) {\n                            nextDir = cell.dir;\n                        }\n                        if (cell.type === 'mirror' && cell.placed) {\n                            // Reflect direction\n                            const reflections = {\n                                'N': 'E', 'E': 'S', 'S': 'W', 'W': 'N',\n                                'NE': 'SE', 'SE': 'SW', 'SW': 'NW', 'NW': 'NE'\n                            };\n                            nextDir = reflections[r.dir] || r.dir;\n                        }\n                        if (cell.type === 'conveyor' && cell.placed) {\n                            nextDir = cell.dir;\n                            r.onConveyor = 1;\n                        }\n                        if (cell.type === 'teleporter' && cell.placed && cell.pair) {\n                            r.x = cell.pair.x + 0.5;\n                            r.y = cell.pair.y + 0.5;\n                            moved = true;\n                            this.spawnParticles(r.x * this.cellSize + this.offsetX, r.y * this.cellSize + this.offsetY, this.COLORS.teleporter);\n                        }\n                    }\n\n                    // Move\n                    if (!moved) {\n                        const d = this.DIRECTIONS[nextDir];\n                        r.x += d.x;\n                        r.y += d.y;\n                        r.dir = nextDir;\n                    }\n\n                    // Out of bounds check\n                    if (r.x < 0 || r.x >= this.gridWidth || r.y < 0 || r.y >= this.gridHeight) {\n                        this.stats.lost++;\n                        this.spawnParticles(r.x * this.cellSize + this.offsetX, r.y * this.cellSize + this.offsetY, this.COLORS.hazard);\n                        toRemove.push(i);\n                        continue;\n                    }\n\n                    // Anti-collision: prevent overlap on same cell\n                    let overlap = false;\n                    for (let j = 0; j < i; j++) {\n                        if (toRemove.includes(j)) continue;\n                        const other = this.runners[j];\n                        if (Math.floor(other.x) === Math.floor(r.x) && Math.floor(other.y) === Math.floor(r.y)) {\n                            // Both lost\n                            this.stats.lost++;\n                            this.spawnParticles(r.x * this.cellSize + this.offsetX, r.y * this.cellSize + this.offsetY, this.COLORS.hazard);\n                            this.stats.lost++;\n                            toRemove.push(i);\n                            toRemove.push(j);\n                            this.cameraShake = 6;\n                            overlap = true;\n                            break;\n                        }\n                    }\n                    if (!overlap) newRunners.push(r);\n                }\n                // Remove indices in reverse\n                toRemove.sort((a, b) => b - a);\n                for (const idx of toRemove) this.runners.splice(idx, 1);\n                for (const r of newRunners) {\n                    if (!this.runners.includes(r)) this.runners.push(r);\n                }\n            }\n\n            // Update elapsed time\n            this.stats.elapsedTime = (performance.now() - this.stats.startTime) / 1000;\n\n            // Check objectives\n            this.checkObjectives();\n            this.updateHUD();\n        },\n\n        checkObjectives() {\n            // If all spawners done and no runners remain, check objectives\n            let allSpawned = true;\n            for (const sp of this.spawnQueue) if (sp.spawned < sp.total) allSpawned = false;\n            if (allSpawned && this.runners.length === 0) {\n                // Determine pass/fail\n                let passed = true;\n                for (const obj of this.objectives) {\n                    if (obj.type === 'save' && this.stats.saved < obj.count) passed = false;\n                    if (obj.type === 'lose_max' && this.stats.lost > obj.count) passed = false;\n                }\n                if (passed) this.completeLevel();\n                else this.failLevel();\n            }\n        },\n\n        completeLevel() {\n            this.state = 'complete';\n            const time = this.stats.elapsedTime;\n            let stars = 0;\n            const lvl = LEVELS[this.currentLevel];\n            if (lvl.parTimes) {\n                if (time <= lvl.parTimes[2]) stars = 3;\n                else if (time <= lvl.parTimes[1]) stars = 2;\n                else stars = 1;\n            } else stars = 1;\n            const prev = this.levelScores[this.currentLevel];\n            if (!prev || time < prev.time || stars > prev.stars) {\n                this.levelScores[this.currentLevel] = { stars, time };\n                if (this.currentLevel >= this.unlockedLevel && this.currentLevel < LEVELS.length - 1) {\n                    this.unlockedLevel = this.currentLevel + 1;\n                }\n                this.saveProgress();\n            }\n            document.getElementById('stat-saved').textContent = this.stats.saved;\n            document.getElementById('stat-lost').textContent = this.stats.lost;\n            const m = Math.floor(time / 60);\n            const s = Math.floor(time % 60);\n            document.getElementById('stat-time').textContent = m + ':' + s.toString().padStart(2, '0');\n            document.getElementById('stars-display').textContent = '★'.repeat(stars) + '☆'.repeat(3 - stars);\n            document.getElementById('complete-modal').classList.add('active');\n            this.playSound('win');\n        },\n\n        failLevel() {\n            this.state = 'failed';\n            document.getElementById('failure-reason').textContent = 'You lost too many runners!';\n            document.getElementById('failed-modal').classList.add('active');\n            this.playSound('fail');\n        },\n\n        // ==================== PARTICLES ====================\n        spawnParticles(px, py, color) {\n            for (let i = 0; i < 12; i++) {\n                const angle = Math.random() * Math.PI * 2;\n                const speed = 1 + Math.random() * 3;\n                this.particles.push({\n                    x: px, y: py,\n                    vx: Math.cos(angle) * speed,\n                    vy: Math.sin(angle) * speed,\n                    life: 1,\n                    color: color,\n                    size: 2 + Math.random() * 3\n                });\n            }\n        },\n\n        updateParticles(dt) {\n            for (let i = this.particles.length - 1; i >= 0; i--) {\n                const p = this.particles[i];\n                p.x += p.vx;\n                p.y += p.vy;\n                p.vy += 0.1;\n                p.life -= 0.02;\n                if (p.life <= 0) this.particles.splice(i, 1);\n            }\n        },\n\n        // ==================== AUDIO ====================\n        audioCtx: null,\n        playSound(type) {\n            if (!this.soundEnabled) return;\n            try {\n                if (!this.audioCtx) this.audioCtx = new (window.AudioContext || window.webkitAudioContext)();\n                const ctx = this.audioCtx;\n                const osc = ctx.createOscillator();\n                const gain = ctx.createGain();\n                osc.connect(gain);\n                gain.connect(ctx.destination);\n                const now = ctx.currentTime;\n                if (type === 'place') {\n                    osc.frequency.setValueAtTime(440, now);\n                    osc.frequency.exponentialRampToValueAtTime(660, now + 0.05);\n                    gain.gain.setValueAtTime(0.1, now);\n                    gain.gain.exponentialRampToValueAtTime(0.001, now + 0.08