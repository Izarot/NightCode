-green); }\n        #lost-counter .counter-fill { background: var(--accent-orange); }\n        #lost-counter .counter-value { color: var(--accent-orange); }\n\n        /* Tick Timer Ring */\n        #tick-timer {\n            position: absolute;\n            top: 64px;\n            left: 50%;\n            transform: translateX(-50%);\n            width: 60px;\n            height: 60px;\n        }\n\n        #tick-timer svg {\n            transform: rotate(-90deg);\n        }\n\n        #tick-timer circle {\n            fill: none;\n            stroke-width: 4;\n        }\n\n        #tick-timer .bg {\n            stroke: var(--bg-button);\n        }\n\n        #tick-timer .progress {\n            stroke: var(--accent-green);\n            stroke-linecap: round;\n            transition: stroke-dashoffset 0.1s linear, stroke 0.3s ease;\n        }\n\n        #tick-timer .time-text {\n            position: absolute;\n            top: 50%;\n            left: 50%;\n            transform: translate(-50%, -50%);\n            font-family: 'JetBrains Mono', monospace;\n            font-size: 11px;\n            color: var(--text-primary);\n        }\n\n        /* Bottom Inventory Bar */\n        #bottom-bar {\n            position: absolute;\n            bottom: 0;\n            left: 0;\n            right: 0;\n            height: 88px;\n            background: rgba(14, 20, 40, 0.92);\n            border-top: 1px solid var(--bg-button);\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            gap: 12px;\n            padding: 0 16px;\n        }\n\n        .inventory-slot {\n            width: 64px;\n            height: 64px;\n            background: var(--bg-card);\n            border: 2px solid var(--bg-button);\n            border-radius: 8px;\n            cursor: pointer;\n            display: flex;\n            flex-direction: column;\n            align-items: center;\n            justify-content: center;\n            pos