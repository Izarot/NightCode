uto;\n        }\n\n        /* Top Bar */\n        #top-bar {\n            position: absolute;\n            top: 0;\n            left: 0;\n            right: 0;\n            height: 56px;\n            background: rgba(14, 20, 40, 0.9);\n            border-bottom: 1px solid var(--bg-button);\n            display: flex;\n            align-items: center;\n            justify-content: space-between;\n            padding: 0 16px;\n        }\n\n        #level-title {\n            color: var(--text-primary);\n            font-size: 18px;\n            font-weight: 600;\n        }\n\n        #objectives {\n            display: flex;\n            gap: 8px;\n        }\n\n        .objective-badge {\n            background: rgba(20, 28, 50, 0.85);\n            color: var(--text-primary);\n            padding: 6px 12px;\n            border-radius: 14px;\n            font-size: 13px;\n            display: flex;\n            align-items: center;\n            gap: 6px;\n            border: 1px solid var(--bg-button);\n        }\n\n        .objective-badge.completed {\n            border-color: var(--accent-green);\n            background: rgba(94, 224, 140, 0.15);\n        }\n\n        .objective-badge.failed {\n            border-color: var(--accent-orange);\n            background: rgba(255, 107, 74, 0.15);\n        }\n\n        #top-controls {\n            display: flex;\n            gap: 8px;\n        }\n\n        .icon-btn {\n            width: 40px;\n            height: 40px;\n            border-radius: 50%;\n            background: var(--bg-button);\n            border: none;\n            color: var(--text-primary);\n            cursor: pointer;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            transition: all 0.15s ease;\n        }\n\n        .icon-btn:hover {\n            background: var(--bg-button-hover);\n            transform: scale(1.05);\n        }\n\n        .icon-btn svg {\n            width: 20px;\n     