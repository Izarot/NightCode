  "index.html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, user-scalable=no\">\n  <title>Lava Diversion</title>\n  <link rel=\"icon\" href=\"data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🌋</text></svg>\">\n  <style>\n    * { margin: 0; padding: 0; box-sizing: border-box; }\n    body { background: #1a1a2e; overflow: hidden; font-family: 'Segoe UI', sans-serif; }\n    #gameCanvas { display: block; position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); max-width: 100vw; max-height: 100vh; }\n    #uiOverlay { position: absolute; top: 0; left: 0; width: 100%; height: 100%; pointer-events: none; }\n    .hud { position: absolute; color: #fff; font-size: 14px; text-shadow: 1px 1px 2px #000; pointer-events: auto; }\n    #timer { top: 10px; right: 10px; font-size: 18px; font-weight: bold; color: #ff6b35; }\n    #score { top: 10px; left: 10px; }\n    #highScore { top: 35px; left: 10px; color: #ffd700; font-size: 12px; }\n    #homeHealthContainer { bottom: 10px; left: 10px; display: flex; flex-direction: column; gap: 4px; }\n    .homeHealth { display: flex; align-items: center; gap: 6px; background: rgba(0,0,0,0.6); padding: 4px 8px; border-radius: 4px; backdrop-filter: blur(4px); }\n    .homeHealthBar { width: 80px; height: 8px; background: #333; border-radius: 4px; overflow: hidden; }\n    .homeHealthFill { height: 100%; background: linear-gradient(90deg, #ff6b35, #ffd700); transition: width 0.3s; }\n    .homeLabel { font-size: 11px; color: #fff; min-width: 50px; }\n    #gameStateOverlay { position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.85); display: flex; flex-direction: column; align-items: center; justify-content: center; z-index: 10; pointer-events: auto; }\n    .hidden { display: none !important; }\n    #gameStateOverlay h1 { color: #ff6b35; font-size: 2.5rem; margin-bottom: 1rem; text-shadow: 2px 2px 4px #000; }\n    #gameStateOverlay p { color: #ccc; font-size: 1.2rem; margin-bottom: 2rem; max-width: 80%; text-align: center; }\n    #gameStateOverlay button { background: linear-gradient(135deg, #ff6b35, #e55a2b); border: none; color: white; padding: 12px 32px; font-size: 1.1rem; border-radius: 8px; cursor: pointer; transition: transform 0.1s, box-shadow 0.1s; box-shadow: 0 4px 15px rgba(255,107,53,0.4); }\n    #gameStateOverlay button:active { transform: scale(0.97); box-shadow: 0 2px 8px rgba(255,107,53,0.4); }\n    #controlsHint { position: absolute; bottom: 10px; right: 10px; color: #888; font-size: 12px; text-align: right; line-height: 1.5; }\n  </style>\n</head>\n<body>\n  <canvas id=\"gameCanvas\"></canvas>\n  <div id=\"uiOverlay\">\n    <div id=\"timer\" class=\"hud\">00:00.00</div>\n    <div id=\"score\" class=\"hud\">Score: 0</div>\n    <div id=\"highScore\" class=\"hud\">Best: 0</div>\n    <div id=\"homeHealthContainer\" class=\"hud\"></div>\n    <div id=\"controlsHint\" class=\"hud\">WASD/Arrows: Move\nSpace: Jump\nClick/Drag: Dig Tunnel</div>\n    <div id=\"gameStateOverlay\" class=\"hidden\">\n      <h1 id=\"overlayTitle\">LAVA DIVERSION</h1>\n      <p id=\"overlayText\">Redirect the lava flow to save the homes. Dig tunnels with your mouse.</p>\n      <button id=\"startBtn\">Start Game</button>\n    </div>\n  </div>\n  <script src=\"main.js\"></script>\n</body>\n</html>",
  "main.js": "// Lava Diversion - Main Entry Point\nclass Game {\n  constructor() {\n    this.canvas = document.getElementById('gameCanvas');\n    this.ctx = this.canvas.getContext('2d');\n    this.resize();\n    window.addEventListener('resize', () => this.resize());\n\n    this.state = 'START';\n    this.lastTime = 0;\n    this.score = 0;\n    this.highScore = parseInt(localStorage.getItem('lavaDiversionHighScore')) || 0;\n    this.startTime = 0;\n    this.elapsedTime = 0;\n    this.gameSpeed = 1;\n\n    this.map = new Map(this);\n    this.player = new Player(this);\n    this.lava = new LavaSystem(this);\n    this.tunnels = new TunnelSystem(this);\n    this.homes = new HomeSystem(this);\n    this.ui = new UIManager(this);\n    this.sound = new SoundManager();\n    this.levelManager = new LevelManager(this);\n\n    this.input = {\n      left: false, right: false, up: false, down: false,\n      jump: false, dig: false, digStart: null, digEnd: null\n    };\n\n    this.setupInput();\n    this.updateHighScoreDisplay();\n    requestAnimationFrame(this.gameLoop.bind(this));\n  }\n\n  resize() {\n    const maxWidth = window.innerWidth * 0.98;\n    const maxHeight = window.innerHeight * 0.98;\n    const aspectRatio = 16 / 9;\n    let width = maxWidth;\n    let height = width / aspectRatio;\n    if (height > maxHeight) {\n      height = maxHeight;\n      width = height * aspectRatio;\n    }\n    this.canvas.width = width;\n    this.canvas.height = height;\n    this.scale = width / 800; // Base resolution 800x450\n    if (this.map) this.map.onResize(width, height);\n  }\n\n  setupInput() {\n    window.addEventListener('keydown', e => {\n      if (['ArrowLeft','KeyA'].includes(e.code)) this.input.left = true;\n      if (['ArrowRight','KeyD'].includes(e.code)) this.input.right = true;\n      if (['ArrowUp','KeyW','Space'].includes(e.code)) this.input.jump = true;\n      if (['ArrowDown','KeyS'].includes(e.code)) this.input.down = true;\n    });\n    window.addEventListener('keyup', e => {\n      if (['ArrowLeft','KeyA'].includes(e.code)) this.input.left = false;\n      if (['ArrowRight','KeyD'].includes(e.code)) this.input.right = false;\n      if (['ArrowUp','KeyW','Space'].includes(e.code)) this.input.jump = false;\n      if (['ArrowDown','KeyS'].includes(e.code)) this.input.down = false;\n    });\n\n    this.canvas.addEventListener('mousedown', e => {\n      if (this.state === 'EXPLORE' || this.state === 'DIRECT' || this.state === 'SOLVE') {\n        const rect = this.canvas.getBoundingClientRect();\n        this.input.dig = true;\n        this.input.digStart = {\n          x: (e.clientX - rect.left) / this.scale,\n          y: (e.clientY - rect.top) / this.scale\n        };\n        this.sound.play('digStart');\n      }\n    });\n    window.addEventListener('mousemove', e => {\n      if (this.input.dig) {\n        const rect = this.canvas.getBoundingClientRect();\n        this.input.digEnd = {\n          x: (e.clientX - rect.left) / this.scale,\n          y: (e.clientY - rect.top) / this.scale\n        };\n      }\n    });\n    window.addEventListener('mouseup', () => {\n      if (this.input.dig) {\n        this.input.dig = false;\n        if (this.input.digStart && this.input.digEnd) {\n          this.tunnels.digTunnel(this.input.digStart, this.input.digEnd);\n          this.sound.play('digEnd');\n        }\n        this.input.digStart = null;\n        this.input.digEnd = null;\n      }\n    });\n\n    // Touch support\n    this.canvas.addEventListener('touchstart', e => {\n      if (this.state !== 'START' && this.state !== 'VICTORY' && this.state !== 'GAME_OVER') {\n        e.preventDefault();\n        const touch = e.touches[0];\n        const rect = this.canvas.getBoundingClientRect();\n        this.input.dig = true;\n        this.input.digStart = {\n          x: (touch.clientX - rect.left) / this.scale,\n          y: (touch.clientY - rect.top) / this.scale\n        };\n        this.sound.play('digStart');\n      }\n    }, { passive: false });\n    this.canvas.addEventListener('touchmove', e => {\n      if (this.input.dig) {\n        e.preventDefault();\n        const touch = e.touches[0];\n        const rect = this.canvas.getBoundingClientRect();\n        this.input.digEnd = {\n          x: (touch.clientX - rect.left) / this.scale,\n          y: (touch.clientY - rect.top) / this.scale\n        };\n      }\n    }, { passive: false });\n    this.canvas.addEventListener('touchend', () => {\n      if (this.input.dig) {\n        this.input.dig = false;\n        if (this.input.digStart && this.input.digEnd) {\n          this.tunnels.digTunnel(this.input.digStart, this.input.digEnd);\n          this.sound.play('digEnd');\n        }\n        this.input.digStart = null;\n        this.input.digEnd = null;\n      }\n    });\n\n    document.getElementById('startBtn').addEventListener('click', () => this.startGame());\n  }\n\n  startGame() {\n    this.state = 'EXPLORE';\n    document.getElementById('gameStateOverlay').classList.add('hidden');\n    this.levelManager.loadLevel(1);\n    this.score = 0;\n    this.startTime = performance.now();\n    this.elapsedTime = 0;\n    this.ui.updateScore(0);\n    this.sound.play('ambient', { loop: true, volume: 0.3 });\n  }\n\n  gameLoop(time) {\n    const dt = Math.min((time - this.lastTime) / 1000, 0.1);\n    this.lastTime = time;\n\n    if (this.state === 'EXPLORE' || this.state === 'DIRECT' || this.state === 'SOLVE') {\n      this.elapsedTime = (time - this.startTime) / 1000;\n      this.update(dt);\n    }\n    this.render();\n    requestAnimationFrame(this.gameLoop.bind(this));\n  }\n\n  update(dt) {\n    this.player.update(dt, this.input);\n    this.lava.update(dt);\n    this.tunnels.update(dt);\n    this.homes.update(dt);\n    this.checkGameState();\n    this.ui.updateTimer(this.elapsedTime);\n  }\n\n  checkGameState() {\n    const aliveHomes = this.homes.homes.filter(h => h.health > 0);\n    const destroyedHomes = this.homes.homes.filter(h => h.health <= 0);\n\n    if (this.state === 'EXPLORE' && this.tunnels.segments.length > 0) {\n      this.state = 'DIRECT';\n    }\n    if (this.state === 'DIRECT' && this.lava.hasDiverted) {\n      this.state = 'SOLVE';\n    }\n\n    if (aliveHomes.length === 0) {\n      this.gameOver();\n    } else if (this.lava.isContained && aliveHomes.length > 0) {\n      // Check if lava has been contained for a while\n      this.lava.containedTime += 1/60;\n      if (this.lava.containedTime > 3) {\n        this.victory();\n      }\n    } else {\n      this.lava.containedTime = 0;\n    }\n  }\n\n  gameOver() {\n    this.state = 'GAME_OVER';\n    this.sound.stop('ambient');\n    this.sound.play('gameOver');\n    document.getElementById('overlayTitle').textContent = 'GAME OVER';\n    document.getElementById('overlayText').textContent = `The lava consumed the homes. Final Score: ${this.score}`;\n    document.getElementById('startBtn').textContent = 'Try Again';\n    document.getElementById('gameStateOverlay').classList.remove('hidden');\n  }\n\n  victory() {\n    this.state = 'VICTORY';\n    this.sound.stop('ambient');\n    this.sound.play('victory');\n    const timeBonus = Math.max(0, Math.floor(120 - this.elapsedTime)) * 10;\n    const efficiencyBonus = this.tunnels.segments.length * 5;\n    const finalScore = this.score + timeBonus + efficiencyBonus;\n    if (finalScore > this.highScore) {\n      this.highScore = finalScore;\n      localStorage.setItem('lavaDiversionHighScore', this.highScore);\n      this.updateHighScoreDisplay();\n    }\n    document.getElementById('overlayTitle').textContent = 'VICTORY!';\n    document.getElementById('overlayText').innerHTML = `All homes saved!<br>Time: ${this.formatTime(this.elapsedTime)}<br>Tunnels: ${this.tunnels.segments.length}<br>Final Score: ${finalScore}`;\n    document.getElementById('startBtn').textContent = 'Next Level';\n    document.getElementById('gameStateOverlay').classList.remove('hidden');\n  }\n\n  formatTime(seconds) {\n    const mins = Math.floor(seconds / 60);\n    const secs = Math.floor(seconds % 60);\n    const ms = Math.floor((seconds % 1) * 100);\n    return `${mins.toString().padStart(2,'0')}:${secs.toString().padStart(2,'0')}.${ms.toString().padStart(2,'0')}`;\n  }\n\n  updateHighScoreDisplay() {\n    document.getElementById('highScore').textContent = `Best: ${this.highScore}`;\n  }\n\n  addScore(points) {\n    this.score += points;\n    this.ui.updateScore(this.score);\n  }\n\n  render() {\n    this.ctx.save();\n    this.ctx.scale(this.scale, this.scale);\n    this.ctx.clearRect(0, 0, 800, 450);\n\n    this.map.render(this.ctx);\n    this.lava.render(this.ctx);\n    this.tunnels.render(this.ctx);\n    this.homes.render(this.ctx);\n    this.player.render(this.ctx);\n\n    // Dig preview\n    if (this.input.dig && this.input.digStart && this.input.digEnd) {\n      this.ctx.strokeStyle = 'rgba(255, 215, 0, 0.8)';\n      this.ctx.lineWidth = 3;\n      this.ctx.setLineDash([5, 5]);\n      this.ctx.beginPath();\n      this.ctx.moveTo(this.input.digStart.x, this.input.digStart.y);\n      this.ctx.lineTo(this.input.digEnd.x, this.input.digEnd.y);\n      this.ctx.stroke();\n      this.ctx.setLineDash([]);\n    }\n\n    this.ctx.restore();\n  }\n}\n\n// Start the game when DOM is ready\nwindow.addEventListener('DOMContentLoaded', () => {\n  window.game = new Game();\n});",
  "game/Player.js": "class Player {\n  constructor(game) {\n    this.game = game;\n    this.width = 24;\n    this.height = 32;\n    this.x = 100;\n    this.y = 300;\n    this.vx = 0;\n    this.vy = 0;\n    this.speed = 180;\n    this.jumpPower = 380;\n    this.gravity = 980;\n    this.friction = 0.85;\n    this.airFriction = 0.95;\n    this.onGround = false;\n    this.coyoteTime = 0;\n    this.jumpBuffer = 0;\n    this.color = '#ffd700';\n    this.digRange = 60;\n  }\n\n  update(dt, input) {\n    // Horizontal movement with momentum\n    let targetVx = 0;\n    if (input.left) targetVx -= this.speed;\n    if (input.right) targetVx += this.speed;\n\n    if (this.onGround) {\n      this.vx = this.vx * this.friction + targetVx * (1 - this.friction);\n    } else {\n      this.vx = this.vx * this.airFriction + targetVx * (1 - this.airFriction) * 0.3;\n    }\n\n    // Jump buffering and coyote time\n    if (input.jump) this.jumpBuffer = 0.1;\n    else this.jumpBuffer = Math.max(0, this.jumpBuffer - dt);\n\n    if (this.onGround) this.coyoteTime = 0.1;\n    else this.coyoteTime = Math.max(0, this.coyoteTime - dt);\n\n    if (this.jumpBuffer > 0 && this.coyoteTime > 0) {\n      this.vy = -this.jumpPower;\n      this.onGround = false;\n      this.coyoteTime = 0;\n      this.jumpBuffer = 0;\n      this.game.sound.play('jump');\n    }\n\n    // Gravity\n    this.vy += this.gravity * dt;\n    this.vy = Math.min(this.vy, 600); // Terminal velocity\n\n    // Move X\n    this.x += this.vx * dt;\n    this.handleCollisionsX();\n\n    // Move Y\n    this.y += this.vy * dt;\n    this.onGround = false;\n    this.handleCollisionsY();\n\n    // Keep in bounds\n    this.x = Math.max(this.width/2, Math.min(this.game.map.width - this.width/2, this.x));\n    if (this.y > this.game.map.height + 100) {\n      this.y = 100;\n      this.vy = 0;\n    }\n\n    // Lava damage\n    this.checkLavaDamage();\n  }\n\n  handleCollisionsX() {\n    const tileSize = this.game.map.tileSize;\n    const leftTile = Math.floor((this.x - this.width/2) / tileSize);\n    const rightTile = Math.floor((this.x + this.width/2 - 0.01) / tileSize);\n    const topTile = Math.floor((this.y - this.height/2) / tileSize);\n    const bottomTile = Math.floor((this.y + this.height/2 - 0.01) / tileSize);\n\n    for (let ty = topTile; ty <= bottomTile; ty++) {\n      if (this.vx > 0) {\n        const tile = this.game.map.getTile(rightTile, ty);\n        if (tile && tile.solid) {\n          this.x = rightTile * tileSize - this.width/2;\n          this.vx = 0;\n          break;\n        }\n      } else if (this.vx < 0) {\n        const tile = this.game.map.getTile(leftTile, ty);\n        if (tile && tile.solid) {\n          this.x = (leftTile + 1) * tileSize + this.width/2;\n          this.vx = 0;\n          break;\n        }\n      }\n    }\n  }\n\n  handleCollisionsY() {\n    const tileSize = this.game.map.tileSize;\n    const leftTile = Math.floor((this.x - this.width/2) / tileSize);\n    const rightTile = Math.floor((this.x + this.width/2 - 0.01) / tileSize);\n    const topTile = Math.floor((this.y - this.height/2) / tileSize);\n    const bottomTile = Math.floor((this.y + this.height/2 - 0.01) / tileSize);\n\n    for (let tx = leftTile; tx <= rightTile; tx++) {\n      if (this.vy > 0) {\n        const tile = this.game.map.getTile(tx, bottomTile);\n        if (tile && tile.solid) {\n          this.y = bottomTile * tileSize - this.height/2;\n          this.vy = 0;\n          this.onGround = true;\n          break;\n        }\n      } else if (this.vy < 0) {\n        const tile = this.game.map.getTile(tx, topTile);\n        if (tile && tile.solid) {\n          this.y = (topTile + 1) * tileSize + this.height/2;\n          this.vy = 0;\n          break;\n        }\n      }\n    }\n  }\n\n  checkLavaDamage() {\n    const tileSize = this.game.map.tileSize;\n    const tx = Math.floor(this.x / tileSize);\n    const ty = Math.floor(this.y / tileSize);\n    const tile = this.game.map.getTile(tx, ty);\n    if (tile && tile.lavaAmount > 0.3) {\n      // Player takes damage - could implement health system\n      this.game.sound.play('hurt', { volume: 0.2 });\n    }\n  }\n\n  render(ctx) {\n    // Body\n    ctx.fillStyle = this.color;\n    ctx.beginPath();\n    ctx.roundRect(this.x - this.width/2, this.y - this.height/2, this.width, this.height, 4);\n    ctx.fill();\n    \n    // Eyes\n    ctx.fillStyle = '#1a1a2e';\n    const eyeOffset = this.vx > 0 ? 4 : this.vx < 0 ? -4 : 0;\n    ctx.beginPath();\n    ctx.arc(this.x - 6 + eyeOffset, this.y - 8, 3, 0, Math.PI * 2);\n    ctx.arc(this.x + 6 + eyeOffset, this.y - 8, 3, 0, Math.PI * 2);\n    ctx.fill();\n\n    // Dig indicator\n    if (this.game.input.dig && this.game.input.digStart) {\n      const dist = Math.hypot(this.x - this.game.input.digStart.x, this.y - this.game.input.digStart.y);\n      if (dist < this.digRange) {\n        ctx.strokeStyle = 'rgba(255, 215, 0, 0.6)';\n        ctx.lineWidth = 2;\n        ctx.beginPath();\n        ctx.arc(this.x, this.y, this.digRange, 0, Math.PI * 2);\n        ctx.stroke();\n      }\n    }\n  }\n}",
  "game/LavaSystem.js": "class LavaSystem {\n  constructor(game) {\n    this.game = game;\n    this.particles = [];\n    this.sources = [];\n    this.flowSpeed = 80;\n    this.maxParticles = 300;\n    this.hasDiverted = false;\n    this.isContained = false;\n    this.containedTime = 0;\n    this.lavaColor1 = '#ff4500';\n    this.lavaColor2 = '#ff6347';\n    this.glowColor = 'rgba(255, 69, 0, 0.6)';\n  }\n\n  addSource(x, y) {\n    this.sources.push({ x, y, active: true, timer: 0 });\n  }\n\n  update(dt) {\n    // Spawn particles from sources\n    for (const source of this.sources) {\n      if (source.active && this.particles.length < this.maxParticles) {\n        source.timer += dt;\n        if (source.timer > 0.15) {\n          this.particles.push({\n            x: source.x + (Math.random() - 0.5) * 10,\n            y: source.y,\n            vx: (Math.random() - 0.5) * 20,\n            vy: 0,\n            size: 4 + Math.random() * 4,\n            life: 1,\n            maxLife: 8 + Math.random() * 4,\n            temperature: 1\n          });\n          source.timer = 0;\n        }\n      }\n    }\n\n    // Update particles\n    let lavaReachedHome = false;\n    let lavaInTunnels = false;\n    \n    for (let i = this.particles.length - 1; i >= 0; i--) {\n      const p = this.particles[i];\n      p.life -= dt;\n      \n      // Gravity and flow\n      p.vy += 400 * dt;\n      p.vy = Math.min(p.vy, this.flowSpeed * 2);\n      \n      // Check tile below for flow direction\n      const tileSize = this.game.map.tileSize;\n      const tx = Math.floor(p.x / tileSize);\n      const ty = Math.floor((p.y + p.size) / tileSize);\n      const tileBelow = this.game.map.getTile(tx, ty);\n      const tileLeft = this.game.map.getTile(tx - 1, ty);\n      const tileRight = this.game.map.getTile(tx + 1, ty);\n      const tileCurrent = this.game.map.getTile(tx, Math.floor(p.y / tileSize));\n\n      // Flow logic: prefer down, then down-left/down-right, then sideways\n      if (tileBelow && !tileBelow.solid && tileBelow.lavaAmount < 1) {\n        p.vx *= 0.95;\n      } else {\n        // Blocked below, try sides\n        const canGoLeft = tileLeft && !tileLeft.solid && tileLeft.lavaAmount < 1;\n        const canGoRight = tileRight && !tileRight.solid && tileRight.lavaAmount < 1;\n        \n        if (canGoLeft && canGoRight) {\n          p.vx += (Math.random() - 0.5) * 200 * dt;\n        } else if (canGoLeft) {\n          p.vx -= 150 * dt;\n        } else if (canGoRight) {\n          p.vx += 150 * dt;\n        } else {\n          p.vx *= 0.9;\n          p.vy = Math.max(p.vy * 0.5, 0);\n        }\n      }\n\n      // Apply velocity\n      p.x += p.vx * dt;\n      p.y += p.vy * dt;\n\n      // Tile interaction\n      const currentTile = this.game.map.getTile(Math.floor(p.x / tileSize), Math.floor(p.y / tileSize));\n      if (currentTile) {\n        currentTile.lavaAmount = Math.min(1, (currentTile.lavaAmount || 0) + dt * 0.5);\n        \n        // Check if lava in tunnel\n        if (currentTile.tunnel) lavaInTunnels = true;\n        \n        // Damage homes\n        for (const home of this.game.homes.homes) {\n          const hx = Math.floor(home.x / tileSize);\n          const hy = Math.floor(home.y / tileSize);\n          if (Math.abs(currentTile.x - hx) <= 1 && Math.abs(currentTile.y - hy) <= 1 && currentTile.lavaAmount > 0.3) {\n            lavaReachedHome = true;\n            home.takeDamage(dt * 15);\n          }\n        }\n\n        // Cooling by water (if implemented)\n        if (currentTile.waterAmount > 0) {\n          currentTile.lavaAmount = Math.max(0, currentTile.lavaAmount - dt * 2);\n          currentTile.waterAmount = Math.max(0, currentTile.waterAmount - dt);\n          p.temperature *= 0.95;\n          if (p.temperature < 0.2) p.life = 0;\n        }\n      }\n\n      // Remove dead particles\n      if (p.life <= 0 || p.y > this.game.map.height + 50) {\n        this.particles.splice(i, 1);\n      }\n    }\n\n    // Update lava tiles cooling\n    this.game.map.tiles.forEach(row => {\n      row.forEach(tile => {\n        if (tile.lavaAmount > 0) {\n          tile.lavaAmount = Math.max(0, tile.lavaAmount - dt * 0.05);\n        }\n      });\n    });\n\n    // Check diversion status\n    this.hasDiverted = lavaInTunnels;\n    this.isContained = this.particles.length < 20 && !lavaReachedHome;\n  }\n\n  render(ctx) {\n    // Render lava in tiles (pools)\n    const tileSize = this.game.map.tileSize;\n    for (let y = 0; y < this.game.map.tiles[y].length; y++) {\n      const tile = this.game.map.tiles[y][x];\n      if (tile.lavaAmount > 0.05) {\n        const intensity = tile.lavaAmount;\n        const px = x * tileSize;\n        const py = y * tileSize;\n        \n        // Lava pool\n        const gradient = ctx.createLinearGradient(px, py, px, py + tileSize);\n        gradient.addColorStop(0, this.lavaColor2);\n        gradient.addColorStop(1, this.lavaColor1);\n        ctx.fillStyle = gradient;\n        ctx.globalAlpha = 0.7 * intensity;\n        ctx.fillRect(px, py, tileSize, tileSize);\n        \n        // Glow effect\n        ctx.globalAlpha = 0.3 * intensity;\n        ctx.shadowColor = this.glowColor;\n        ctx.shadowBlur = 10;\n        ctx.fillRect(px - 2, py - 2, tileSize + 4, tileSize + 4);\n        ctx.shadowBlur = 0;\n        ctx.globalAlpha = 1;\n\n        // Animated surface\n        ctx.fillStyle = `rgba(255, 100, 0, ${0.4 * intensity})`;\n        const time = Date.now() * 0.005;\n        for (let i = 0; i < 3; i++) {\n          const waveX = px + (Math.sin(time + x * 0.5 + i) * 3);\n          const waveY = py + tileSize - 4 - i * 3;\n          ctx.beginPath();\n          ctx.arc(waveX, waveY, 2 + intensity * 3, 0, Math.PI * 2);\n          ctx.fill();\n        }\n      }\n    }\n  }\n\n  // Render lava particles\n  for (const p of this.particles) {\n    const alpha = p.life / p.maxLife;\n    const size = p.size * alpha;\n    const temp = p.temperature;\n    \n    ctx.globalAlpha = alpha;\n    const gradient = ctx.createRadialGradient(p.x, p.y, 0, p.x, p.y, size);\n    gradient.addColorStop(0, `rgba(255, ${Math.floor(100 + 155 * temp)}, 0, 1)`);\n    gradient.addColorStop(1, `rgba(255, ${Math.floor(50 * temp)}, 0, 0)`);\n    ctx.fillStyle = gradient;\n    ctx.beginPath();\n    ctx.arc(p.x, p.y, size, 0, Math.PI * 2);\n    ctx.fill();\n  }\n  ctx.globalAlpha = 1;\n}\n}",
  "game/TunnelSystem.js": "class TunnelSystem {\n  constructor(game) {\n    this.game = game;\n    this.segments = [];\n    this.digRadius = 12;\n    this.maxSegments = 50;\n  }\n\n  digTunnel(start, end) {\n    const dx = end.x - start.x;\n    const dy = end.y - start.y;\n    const distance = Math.hypot(dx, dy);\n    \n    if (distance < 5) return;\n\n    const steps = Math.ceil(distance / (this.digRadius * 0.5));\n    for (let i = 0; i <= steps; i++) {\n      const t = i / steps;\n      const x = start.x + dx * t;\n      const y = start.y + dy * t;\n      this.digAt(x, y);\n    }\n\n    // Add segment for tracking\n    this.segments.push({ start: { ...start }, end: { ...end }, time: Date.now() });\n    if (this.segments.length > this.maxSegments) {\n      this.segments.shift();\n    }\n\n    this.game.addScore(5);\n  }\n\n  digAt(x, y) {\n    const tileSize = this.game.map.tileSize;\n    const cx = Math.floor(x / tileSize);\n    const cy = Math.floor(y / tileSize);\n    const radiusTiles = Math.ceil(this.digRadius / tileSize);\n\n    for (let ty = -radiusTiles; ty <= radiusTiles; ty++) {\n      for (let tx = -radiusTiles; tx <= radiusTiles; tx++) {\n        const dist = Math.hypot(tx, ty);\n        if (dist <= radiusTiles) {\n          const tileX = cx + tx;\n          const tileY = cy + ty;\n          const tile = this.game.map.getTile(tileX, tileY);\n          if (tile && tile.solid && !tile.indestructible) {\n            tile.solid = false;\n            tile.tunnel = true;\n            tile.lavaAmount = 0;\n            this.createDebris(x, y);\n          }\n        }\n      }\n    }\n  }\n\n  createDebris(x, y) {\n    for (let i = 0; i < 3; i++) {\n      this.game.map.debris.push({\n        x: x + (Math.random() - 0.5) * 20,\n        y: y + (Math.random() - 0.5) * 20,\n        vx: (Math.random() - 0.5) * 100,\n        vy: -Math.random() * 150 - 50,\n        size: 2 + Math.random() * 3,\n        life: 1,\n        color: `hsl(${20 + Math.random() * 20}, 60%, ${30 + Math.random() * 20}%)`\n      });\n    }\n  }\n\n  update(dt) {\n    // Update debris\n    for (let i = this.game.map.debris.length - 1; i >= 0; i--) {\n      const d = this.game.map.debris[i];\n      d.life -= dt * 2;\n      d.vy += 400 * dt;\n      d.x += d.vx * dt;\n      d.y += d.vy * dt;\n      d.vx *= 0.99;\n      if (d.life <= 0) {\n        this.game.map.debris.splice(i, 1);\n      }\n    }\n  }\n\n  render(ctx) {\n    // Render debris\n    for (const d of this.game.map.debris) {\n      ctx.globalAlpha = d.life;\n      ctx.fillStyle = d.color;\n      ctx.beginPath();\n      ctx.arc(d.x, d.y, d.size, 0, Math.PI * 2);\n      ctx.fill();\n    }\n    ctx.globalAlpha = 1;\n\n    // Render tunnel entrances glow\n    for (const seg of this.segments) {\n      const age = (Date.now() - seg.time) / 1000;\n      if (age < 10) {\n        const alpha = Math.max(0, 1 - age / 10) * 0.3;\n        ctx.strokeStyle = `rgba(255, 215, 0, ${alpha})`;\n        ctx.lineWidth = 2;\n        ctx.beginPath();\n        ctx.moveTo(seg.start.x, seg.start.y);\n        ctx.lineTo(seg.end.x, seg.end.y);\n        ctx.stroke();\n      }\n    }\n  }\n}",
  "game/HomeSystem.js": "class HomeSystem {\n  constructor(game) {\n    this.game = game;\n    this.homes = [];\n    this.homeTypes = [\n      { name: 'Cottage', width: 40, height: 35, color: '#8b4513', roofColor: '#8b0000', health: 100, points: 100 },\n      { name: 'Villa', width: 60, height: 45, color: '#a0522d', roofColor: '#b22222', health: 150, points: 200 },\n      { name: 'Mansion', width: 80, height: 55, color: '#cd853f', roofColor: '#dc143c', health: 200, points: 300 }\n    ];\n  }\n\n  spawnHomes(count, level) {\n    this.homes = [];\n    const map = this.game.map;\n    const groundY = map.height - 50;\n    \n    for (let i = 0; i < count; i++) {\n      const type = this.homeTypes[Math.min(Math.floor(level / 2), this.homeTypes.length - 1)];\n      const x = 150 + i * (map.width - 300) / Math.max(1, count - 1) + (Math.random() - 0.5) * 40;\n      const y = groundY;\n      \n      this.homes.push({\n        x, y,\n        width: type.width,\n        height: type.height,\n        color: type.color,\n        roofColor: type.roofColor,\n        health: type.health,\n        maxHealth: type.health,\n        name: type.name,\n        points: type.points,\n        saved: false,\n        particles: []\n      });\n    }\n  }\n\n  update(dt) {\n    for (const home of this.homes) {\n      // Generate safety particles when not threatened\n      const tileSize = this.game.map.tileSize;\n      const hx = Math.floor(home.x / tileSize);\n      const hy = Math.floor(home.y / tileSize);\n      let threatened = false;\n      \n      for (let ty = -2; ty <= 2; ty++) {\n        for (let tx = -2; tx <= 2; tx++) {\n          const tile = this.game.map.getTile(hx + tx, hy + ty);\n          if (tile && tile.lavaAmount > 0.2) {\n            threatened = true;\n          }\n        }\n      }\n\n      if (!threatened && Math.random() < 0.02) {\n        home.particles.push({\n          x: home.x + (Math.random() - 0.5) * home.width,\n          y: home.y - home.height / 2,\n          vx: (Math.random() - 0.5) * 20,\n          vy: -Math.random() * 30 - 10,\n          life: 1,\n          color: `hsl(${40 + Math.random() * 30}, 80%, 60%)`\n        });\n      }\n\n      // Update particles\n      for (let i = home.particles.length - 1; i >= 0; i--) {\n        const p = home.particles[i];\n        p.life -= dt;\n        p.x += p.vx * dt;\n        p.y += p.vy * dt;\n        p.vy += 20 * dt;\n        if (p.life <= 0) home.particles.splice(i, 1);\n      }\n\n      // Check if saved (lava contained and home intact)\n      if (home.health > 0 && this.game.lava.isContained && !home.saved) {\n        home.saved = true;\n        this.game.addScore(home.points);\n        this.createCelebration(home);\n      }\n    }\n  }\n\n  createCelebration(home) {\n    for (let i = 0; i < 20; i++) {\n      home.particles.push({\n        x: home.x + (Math.random() - 0.5) * home.width,\n        y: home.y - home.height / 2 + (Math.random() - 0.5) * home.height,\n        vx: (Math.random() - 0.5) * 200,\n        vy: -Math.random() * 200 - 50,\n        life: 2,\n        color: `hsl(${Math.random() * 60}, 100%, 60%)`\n      });\n    }\n    this.game.sound.play('homeSaved');\n  }\n\n  takeDamage(home, amount) {\n    home.health -= amount;\n    if (home.health <= 0 && home.health + amount > 0) {\n      this.game.sound.play('homeLost');\n      this.createDestruction(home);\n    }\n  }\n\n  createDestruction(home) {\n    for (let i = 0; i < 30; i++) {\n      this.game.map.debris.push({\n        x: home.x + (Math.random() - 0.5) * home.width,\n        y: home.y - home.height / 2 + Math.random() * home.height,\n        vx: (Math.random() - 0.5) * 300,\n        vy: -Math.random() * 300 - 100,\n        size: 3 + Math.random() * 5,\n        life: 3,\n        color: home.color\n      });\n    }\n  }\n\n  render(ctx) {\n    for (const home of this.homes) {\n      if (home.health <= 0) {\n        // Ruins\n        ctx.fillStyle = '#333';\n        ctx.fillRect(home.x - home.width/2, home.y - home.height/2, home.width, home.height * 0.3);\n        ctx.fillStyle = '#555';\n        for (let i = 0; i < 5; i++) {\n          ctx.fillRect(home.x - home.width/2 + i * (home.width/5) + 2, home.y - home.height/2, home.width/5 - 4, home.height * 0.3);\n        }\n        continue;\n      }\n\n      // House body\n      ctx.fillStyle = home.color;\n      ctx.fillRect(home.x - home.width/2, home.y - home.height/2, home.width, home.height);\n\n      // Roof\n      ctx.fillStyle = home.roofColor;\n      ctx.beginPath();\n      ctx.moveTo(home.x - home.width/2 - 5, home.y - home.height/2);\n      ctx.lineTo(home.x, home.y - home.height/2 - home.height * 0.4);\n      ctx.lineTo(home.x + home.width/2 + 5, home.y - home.height/2);\n      ctx.closePath();\n      ctx.fill();\n\n      // Door\n      ctx.fillStyle = '#4a2c1a';\n      const doorW = home.width * 0.25;\n      const doorH = home.height * 0.5;\n      ctx.fillRect(home.x - doorW/2, home.y - home.height/2 + home.height - doorH, doorW, doorH);\n\n      // Windows\n      ctx.fillStyle = home.saved ? '#ffff00' : '#87ceeb';\n      const windowSize = home.width * 0.15;\n      const windowY = home.y - home.height/2 + home.height * 0.2;\n      ctx.fillRect(home.x - home.width/2 + 5, windowY, windowSize, windowSize);\n      ctx.fillRect(home.x + home.width/2 - 5 - windowSize, windowY, windowSize, windowSize);\n\n      // Health bar\n      if (home.health < home.maxHealth) {\n        const barW = home.width;\n        const barH = 4;\n        const barX = home.x - barW/2;\n        const barY = home.y - home.height/2 - 10;\n        ctx.fillStyle = '#333';\n        ctx.fillRect(barX, barY, barW, barH);\n        ctx.fillStyle = home.health > home.maxHealth * 0.5 ? '#4caf50' : home.health > home.maxHealth * 0.25 ? '#ff9800' : '#f44336';\n        ctx.fillRect(barX, barY, barW * (home.health / home.maxHealth), barH);\n      }\n\n      // Celebration particles\n      for (const p of home.particles) {\n        ctx.globalAlpha = p.life;\n        ctx.fillStyle = p.color;\n        ctx.beginPath();\n        ctx.arc(p.x, p.y, 3, 0, Math.PI * 2);\n        ctx.fill();\n      }\n      ctx.globalAlpha = 1;\n\n      // Name label\n      ctx.fillStyle = '#fff';\n      ctx.font = '10px Segoe UI';\n      ctx.textAlign = 'center';\n      ctx.fillText(home.name, home.x, home.y + home.height/2 + 12);\n    }\n  }\n}",
  "game/Map.js": "class Map {\n  constructor(game) {\n    this.game = game;\n    this.tileSize = 20;\n    this.width = 800;\n    this.height = 450;\n    this.cols = Math.ceil(this.width / this.tileSize);\n    this.rows = Math.ceil(this.height / this.tileSize);\n    this.tiles = [];\n    this.debris = [];\n    this.backgroundLayers = [];\n    this.generate();\n  }\n\n  generate() {\n    this.tiles = [];\n    for (let y = 0; y < this.rows; y++) {\n      this.tiles[y] = [];\n      for (let x = 0; x < this.cols; x++) {\n        this.tiles[y][x] = {\n          x, y,\n          solid: false,\n          indestructible: false,\n          lavaAmount: 0,\n          waterAmount: 0,\n          tunnel: false,\n          type: 'air'\n        };\n      }\n    }\n\n    // Generate terrain with noise\n    const seed = Math.random() * 1000;\n    for (let x = 0; x < this.cols; x++) {\n      // Base ground height with variation\n      const noise1 = this.noise(x * 0.02 + seed, 0) * 60;\n      const noise2 = this.noise(x * 0.05 + seed, 100) * 20;\n      const noise3 = this.noise(x * 0.1 + seed, 200) * 10;\n      let groundHeight = this.rows - 3 - Math.floor((noise1 + noise2 + noise3) / this.tileSize);\n      groundHeight = Math.max(this.rows - 15, Math.min(this.rows - 3, groundHeight));\n\n      // Fill ground\n      for (let y = groundHeight; y < this.rows; y++) {\n        const tile = this.tiles[y][x];\n        tile.solid = true;\n        tile.type = y === groundHeight ? 'grass' : y < groundHeight + 3 ? 'dirt' : 'stone';\n        if (y > this.rows - 3) tile.indestructible = true;\n      }\n\n      // Add some caves\n      if (Math.random() < 0.08) {\n        const caveY = groundHeight - Math.floor(Math.random() * 8) - 3;\n        const caveSize = 2 + Math.floor(Math.random() * 3);\n        for (let cy = 0; cy < caveSize; cy++) {\n          for (let cx = -caveSize; cx <= caveSize; cx++) {\n            if (cx * cx + cy * cy < caveSize * caveSize) {\n              const tx = x + cx;\n              const ty = caveY + cy;\n              if (tx >= 0 && tx < this.cols && ty >= 0 && ty < this.rows) {\n                this.tiles[ty][tx].solid = false;\n              }\n            }\n          }\n        }\n      }\n    }\n\n    // Ensure flat areas for homes\n    const homeRows = 3;\n    for (let x = 0; x < this.cols; x++) {\n      for (let y = this.rows - homeRows; y < this.rows; y++) {\n        this.tiles[y][x].indestructible = true;\n      }\n    }\n\n    // Generate background layers for parallax\n    this.generateBackground();\n  }\n\n  generateBackground() {\n    this.backgroundLayers = [];\n    // Far mountains\n    this.backgroundLayers.push({\n      speed: 0.1,\n      color: '#2a2a4a',\n      points: this.generateMountainPoints(0.005, 150, 100)\n    });\n    // Mid hills\n    this.backgroundLayers.push({\n      speed: 0.25,\n      color: '#3a3a5a',\n      points: this.generateMountainPoints(0.01, 100, 50)\n    });\n    // Near hills\n    this.backgroundLayers.push({\n      speed: 0.5,\n      color: '#4a4a6a',\n      points: this.generateMountainPoints(0.02, 60, 30)\n    });\n  }\n\n  generateMountainPoints(freq, amplitude, offset) {\n    const points = [];\n    const seed = Math.random() * 1000;\n    for (let x = 0; x <= this.width; x += 20) {\n      const y = this.height - offset - (this.noise(x * freq + seed, 0) * amplitude);\n      points.push({ x, y });\n    }\n    points.push({ x: this.width, y: this.height });\n    points.push({ x: 0, y: this.height });\n    return points;\n  }\n\n  noise(x, y) {\n    // Simple pseudo-random noise\n    const n = Math.sin(x * 12.9898 + y * 78.233) * 43758.5453;\n    return n - Math.floor(n);\n  }\n\n  onResize(width, height) {\n    this.width = width / this.game.scale;\n    this.height = height / this.game.scale;\n    this.cols = Math.ceil(this.width / this.tileSize);\n    this.rows = Math.ceil(this.height / this.tileSize);\n    // Regenerate would reset game state, so just update dimensions\n  }\n\n  getTile(x, y) {\n    if (x < 0 || x >= this.cols || y < 0 || y >= this.rows) return null;\n    return this.tiles[y][x];\n  }\n\n  setTile(x, y, props) {\n    const tile = this.getTile(x, y);\n    if (tile) Object.assign(tile, props);\n  }\n\n  isSolid(x, y) {\n    const tile = this.getTile(x, y);\n    return tile && tile.solid;\n  }\n\n  render(ctx) {\n    // Sky gradient\n    const skyGradient = ctx.createLinearGradient(0, 0, 0, this.height);\n    skyGradient.addColorStop(0, '#0d0d1a');\n    skyGradient.addColorStop(0.5, '#1a1a3a');\n    skyGradient.addColorStop(1, '#2a2a4a');\n    ctx.fillStyle = skyGradient;\n    ctx.fillRect(0, 0, this.width, this.height);\n\n    // Stars\n    ctx.fillStyle = '#fff';\n    for (let i = 0; i < 100; i++) {\n      const x = (i * 97 + 13) % this.width;\n      const y = (i * 53 + 7) % (this.height * 0.6);\n      const size = (i * 17) % 2 + 0.5;\n      const alpha = 0.3 + ((i * 31) % 100) / 100 * 0.7;\n      ctx.globalAlpha = alpha;\n      ctx.beginPath();\n      ctx.arc(x, y, size, 0, Math.PI * 2);\n      ctx.fill();\n    }\n    ctx.globalAlpha = 1;\n\n    // Background layers\n    const playerX = this.game.player.x;\n    for (const layer of this.backgroundLayers) {\n      ctx.fillStyle = layer.color;\n      ctx.beginPath();\n      const offsetX = (playerX * layer.speed) % this.width;\n      for (const p of layer.points) {\n        let px = p.x - offsetX;\n        while (px < -20) px += this.width;\n        while (px > this.width + 20) px -= this.width;\n        if (p === layer.points[0]) ctx.moveTo(px, p.y);\n        else ctx.lineTo(px, p.y);\n      }\n      ctx.lineTo(this.width, this.height);\n      ctx.lineTo(0, this.height);\n      ctx.closePath();\n      ctx.fill();\n    }\n\n    // Volcano in background\n    this.renderVolcano(ctx, playerX);\n\n    // Render tiles\n    for (let y = 0; y < this.rows; y++) {\n      for (let x = 0; x < this.cols; x++) {\n        const tile = this.tiles[y][x];\n        if (!tile.solid) continue;\n\n        const px = x * this.tileSize;\n        const py = y * this.tileSize;\n        const isSurface = y > 0 && !this.tiles[y-1][x].solid;\n\n        if (tile.type === 'grass') {\n          // Grass top\n          const grad = ctx.createLinearGradient(px, py, px, py + this.tileSize);\n          grad.addColorStop(0, '#2d5a2d');\n          grad.addColorStop(1, '#1a3a1a');\n          ctx.fillStyle = grad;\n          ctx.fillRect(px, py, this.tileSize, this.tileSize);\n          // Grass blades\n          ctx.fillStyle = '#3d7a3d';\n          for (let b = 0; b < 3; b++) {\n            ctx.fillRect(px + 3 + b * 5, py - 2, 2, 6);\n          }\n        } else if (tile.type === 'dirt') {\n          const grad = ctx.createLinearGradient(px, py, px, py + this.tileSize);\n          grad.addColorStop(0, '#5d4037');\n          grad.addColorStop(1, '#3e2723');\n          ctx.fillStyle = grad;\n          ctx.fillRect(px, py, this.tileSize, this.tileSize);\n          // Dirt texture\n          ctx.fillStyle = 'rgba(0,0,0,0.1)';\n          for (let t = 0; t < 2; t++) {\n            ctx.fillRect(px + (t * 7 + 3) % this.tileSize, py + (t * 11 + 5) % this.tileSize, 1, 1);\n          }\n        } else if (tile.type === 'stone') {\n          const grad = ctx.createLinearGradient(px, py, px, py + this.tileSize);\n          grad.addColorStop(0, '#555');\n          grad.addColorStop(1, '#333');\n          ctx.fillStyle = grad;\n          ctx.fillRect(px, py, this.tileSize, this.tileSize);\n          // Stone texture\n          ctx.strokeStyle = 'rgba(255,255,255,0.05)';\n          ctx.strokeRect(px + 0.5, py + 0.5, this.tileSize - 1, this.tileSize - 1);\n        }\n\n        // Tunnel indicator\n        if (tile.tunnel) {\n          ctx.strokeStyle = 'rgba(255, 215, 0, 0.5)';\n          ctx.lineWidth = 1;\n          ctx.strokeRect(px + 1, py + 1, this.tileSize - 2, this.tileSize - 2);\n        }\n      }\n    }\n\n    // Bedrock bottom\n    ctx.fillStyle = '#111';\n    ctx.fillRect(0, (this.rows - 2) * this.tileSize, this.width, this.tileSize * 2);\n    ctx.fillStyle = '#222';\n    for (let x = 0; x < this.cols; x++) {\n      ctx.fillRect(x * this.tileSize, (this.rows - 2) * this.tileSize, this.tileSize, 2);\n    }\n  }\n\n  renderVolcano(ctx, playerX) {\n    const volcanoX = this.width * 0.9;\n    const volcanoY = this.height - 100;\n    const parallaxX = volcanoX - playerX * 0.05;\n    \n    // Volcano body\n    ctx.fillStyle = '#2a1a1a';\n    ctx.beginPath();\n    ctx.moveTo(parallaxX - 80, this.height);\n    ctx.lineTo(parallaxX, volcanoY - 60);\n    ctx.lineTo(parallaxX + 80, this.height);\n    ctx.closePath();\n    ctx.fill();\n\n    // Volcano glow\n    const glowGradient = ctx.createRadialGradient(parallaxX, volcanoY - 40, 0, parallaxX, volcanoY - 40, 60);\n    glowGradient.addColorStop(0, 'rgba(255, 100, 0, 0.4)');\n    glowGradient.addColorStop(1, 'rgba(255, 50, 0, 0)');\n    ctx.fillStyle = glowGradient;\n    ctx.beginPath();\n    ctx.arc(parallaxX, volcanoY - 40, 60, 0, Math.PI * 2);\n    ctx.fill();\n\n    // Smoke particles\n    const time = Date.now() * 0.001;\n    for (let i = 0; i < 5; i++) {\n      const smokeX = parallaxX + Math.sin(time + i) * 20;\n      const smokeY = volcanoY - 60 - (time * 30 + i * 40) % 200;\n      const alpha = 0.1 * (1 - (time * 30 + i * 40) % 200 / 200);\n      ctx.globalAlpha = alpha;\n      ctx.fillStyle = '#444';\n      ctx.beginPath();\n      ctx.arc(smokeX, smokeY, 15 + (time * 30 + i * 40) % 200 / 10, 0, Math.PI * 2);\n      ctx.fill();\n    }\n    ctx.globalAlpha = 1;\n  }\n}",
  "game/UIManager.js": "class UIManager {\n  constructor(game) {\n    this.game = game;\n    this.scoreElement = document.getElementById('score');\n    this.timerElement = document.getElementById('timer');\n    this.homeHealthContainer = document.getElementById('homeHealthContainer');\n  }\n\n  updateScore(score) {\n    this.scoreElement.textContent = `Score: ${score}`;\n  }\n\n  updateTimer(seconds) {\n    const mins = Math.floor(seconds / 60);\n    const secs = Math.floor(seconds % 60);\n    const ms = Math.floor((seconds % 1) * 100);\n    this.timerElement.textContent = `${mins.toString().padStart(2,'0')}:${secs.toString().padStart(2,'0')}.${ms.toString().padStart(2,'0')}`;\n  }\n\n  updateHomeHealth() {\n    this.homeHealthContainer.innerHTML = '';\n    for (const home of this.game.homes.homes) {\n      if (home.health > 0) {\n        const div = document.createElement('div');\n        div.className = 'homeHealth';\n        const percent = Math.max(0