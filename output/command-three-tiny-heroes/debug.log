            // ==================== INPUT ====================
            setupInput: function() {
                // Keyboard controls
                document.addEventListener('keydown', (e) => {
                    if (this.isPaused || this.isGameOver) return;

                    switch (e.key) {
                        case 'ArrowUp': case 'w': case 'W':
                            this.heroMove(0, -1);
                            break;
                        case 'ArrowDown': case 's': case 'S':
                            this.heroMove(0, 1);
                            break;
                        case 'ArrowLeft': case 'a': case 'A':
                            this.heroMove(-1, 0);
                            break;
                        case 'ArrowRight': case 'd': case 'D':
                            this.heroMove(1, 0);
                            break;
                        case ' ': case 'Enter':
                            // Attack or ability (alternate with move)
                            if (this.currentHero !== undefined) {
                                this.heroAttack();
                            }
                            break;
                    }
                });

                // Command wheel (right-click or space)
                document.getElementById('commandWheel').addEventListener('click', (e) => {
                    if (e.target.tagName === 'BUTTON') {
                        const cmd = e.target.dataset.command;
                        this.currentHero = cmd;
                        this.heroMove(0, 0); // Reset position
                        this.updateHUD();
                        this.showToast(cmd.charAt(0).toUpperCase() + cmd.slice(1));
                    }
                });

                // Keyboard command selection
                document.addEventListener('keydown', (e) => {
                    if (this.isPaused || this.isGameOver) return;
                    switch (e.key) {
                        case 'm': // Move
                            this.heroMove(0, -1);
                            break;
                        case 'a': // Attack
                            this.heroAttack();
                            break;
                        case 'i': // Ability
                            this.heroUseAbility('ability');
                            break;
                        case ' ': // Interact (space bar)
                            this.heroInteract();
                            break;
                    }
                });
            },

            // ==================== INITIALIZATION ====================
            init: function() {
                this.loadHighScore();
                this.addHero('warrior');
                this.addHero('mage');
                this.addHero('rogue');
                this.startTurn();
                this.updateHUD();
            }
        };

        // Start the game
        window.onload = () => Game.init();
    </script>
</body>
</html>
