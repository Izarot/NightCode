                    localStorage.setItem('tinyheroes_highscore', this.highScore);
                } catch (e) { /* ignore */ }
            },

            // ==================== HEROES ====================
            createHero: function(type) {
                const baseStats = {
                    warrior: { health: 30, mana: 20, attack: 12, defense: 5, speed: 2, agility: 1 },
                    mage: { health: 25, mana: 35, attack: 8, defense: 2, speed: 1.5, agility: 1.5 },
                    rogue: { health: 28, mana: 22, attack: 10, defense: 4, speed: 2.5, agility: 2 }
                };
                const stats = baseStats[type] || baseStats.warrior;
                return {
                    id: this.heroes.length,
                    type,
                    x: Math.floor(Math.random() * CONFIG.GRID_WIDTH),
                    y: Math.floor(Math.random() * CONFIG.GRID_HEIGHT),
                    health: stats.health,
                    mana: stats.mana,
                    attack: stats.attack,
                    defense: stats.defense,
                    speed: stats.speed,
                    agility: stats.agility,
                    maxHealth: stats.health,
                    maxMana: stats.mana,
                    // Synergy bonus
                    synergyBonus: 0,
                    // State
                    isAlive: true,
                    cooldown: 0,
                    abilityCooldown: 0,
                    // Visuals
                    portrait: type === 'warrior' ? 'hero-warrior' : type === 'mage' ? 'hero-mage' : 'hero-rogue'
                };
            },

            addHero: function(type) {
                const hero = this.createHero(type);
                this.heroes.push(hero);
                return hero;
            },

            // ==================== ENEMIES ====================
            addEnemy: function(type) {
                const enemy = {
                    id: this.enemies.length,
                    x: Math.floor(Math.random() * CONFIG.GRID_WIDTH),
                    y: Math.floor(Math.random() * CONFIG.GRID_HEIGHT),
                    health: type === 'goblin' ? 15 : 25,
                    attack: type === 'goblin' ? 6 : 8,
                    defense: type === 'goblin' ? 3 : 5,
                    type,
                    // AI behavior
                    target: null,
                    state: 'idle' // idle, alert, attack, dead
                };
                this.enemies.push(enemy);
                return enemy;
            },

            // ==================== TURN LOGIC ====================
            startTurn: function() {
                this.turn++;
                this.updateActionPoints();
                this.updateSpeedrunTimer();
                this.processCommands();
            },

            processCommands: function() {
                if (this.isGameOver) return;

                // Apply action points
                if (this.actionPoints > 0) {
                    this.actionPoints--;
                    this.lastActionCost = this.actionPoints;
                }

                // Get current command
                const cmd = this.getCurrentCommand();

                // Execute command for all heroes
                for (const hero of this.heroes) {
                    if (!hero.isAlive) continue;

                    if (cmd === 'move') {
                        hero.move(cmd);
                    } else if (cmd === 'attack') {
                        hero.attack(cmd);
                    } else if (cmd === 'ability') {
                        hero.useAbility(cmd);
                    } else if (cmd === 'interact') {
                        hero.interact(cmd);
                    }
                }

                // Enemy AI turn
                this.enemyAIMove();
            },

            getCurrentCommand: function() {
                // Simple command selection: Move, Attack, Ability, Interact
                // In a real game, this would be from UI input
                return this.currentHero !== undefined ? 'move' : 'attack';
            },

            enemyAIMove: function() {
                this.enemies.forEach(enemy => {
                    if (!enemy.isAlive) return;

                    // Simple AI: move toward nearest hero or random
                    let dx = 0, dy = 0;
                    let minDist = Infinity;

                    for (const hero of this.heroes) {
                        if (!hero.isAlive) continue;
                        const dist = this.calculateDistance(hero, enemy);
                        if (dist < minDist) {
                            minDist = dist;
                            dx = hero.x - enemy.x;
                            dy = hero.y - enemy.y;
                        }
                    }

                    if (minDist > 0) {
                        // Move one step toward hero
                        const stepX = dx > 0 ? 1 : (dx < 0 ? -1 : 0);
                        const stepY = dy > 0 ? 1 : (dy < 0 ? -1 : 0);

                        if (this.canMove(enemy, stepX, stepY)) {
                            enemy.x += stepX;
                            enemy.y += stepY;
                        }
                    }

                    // Check if enemy reached hero (attack)
                    if (Math.abs(enemy.x - this.heroes[0].x) < 2 && Math.abs(enemy.y - this.heroes[0].y) < 2) {
                        enemy.attack();
                    }
                });
            },

            canMove: function(enemy, dx, dy) {
                const hero = this.heroes[0]; // Use first hero as reference
                if (!hero || !enemy.isAlive) return false;

                // Check wall/corridor
                const tx = enemy.x + dx;
                const ty = enemy.y + dy;

                // Simple wall check: if adjacent to wall, can't move
                if (this.grid[enemy.y + dy]?.wall || this.grid[enemy.x + dx]?.wall) {
                    return false;
                }

                // Check if target tile is free (not occupied by another hero)
                if (this.grid[enemy.y + dy]?.x === enemy.x + dx && 
                    this.grid[enemy.y + dy]?.x === enemy.x && 
                    this.grid[enemy.y + dy]?.y === enemy.y) {
                    return false;
                }

                return true;
            },

            // ==================== COMBAT ====================
            heroMove: function(hero) {
                const cmd = this.getCurrentCommand();
                if (cmd === 'move') {
                    hero.move(cmd);
                }
            },

            heroAttack: function(hero) {
                if (hero.cooldown > 0) return;
                hero.cooldown = 2; // 2 turns cooldown
                hero.attack();
            },

            heroUseAbility: function(hero) {
                if (hero.abilityCooldown > 0) return;
                hero.abilityCooldown = 3;
                hero.useAbility('ability');
            },

            heroInteract: function(hero) {
                // Simple interaction: pick up loot or use item
                if (hero.mana < 5) return;
                // Pick up loot
                const loot = this.grid[hero.y][hero.x]?.loot;
                if (loot) {
                    hero.mana += 10;
                    this.grid[hero.y][hero.x] = { ...this.grid[hero.y][hero.x], loot: null };
                }
            },

            heroAttack: function() {
                const target = this.getNearestEnemy(this.heroes[0]);
                if (target) {
                    const damage = this.calculateDamage(this.hero.attack, target.defense);
                    target.health -= damage;
                    this.createParticles(target.x, target.y, COLORS.enemy, 'critical' + (Math.random() > 0.7));
                    if (target.health <= 0) {
                        this.onEnemyDeath(target);
                    }
                }
            },

            calculateDamage: function(attack, defense) {
                const raw = attack - defense;
                return Math.max(1, Math.floor(raw));
            },

            onEnemyDeath: function(enemy) {
                // Remove enemy
                const idx = this.enemies.findIndex(e => e.id === enemy.id);
                if (idx > -1) this.enemies.splice(idx, 1);

                // Add XP
                const xp = 10 + Math.floor(this.turn * 2);
                this.highScore = Math.min(this.highScore + xp, 100); // Cap at 100

                // Spawn loot
                if (Math.random() > 0.5) {
                    const lootType = Math.random() > 0.5 ? 'potion' : 'key';
                    this.grid[enemy.y][enemy.x] = {
                        type: lootType,
                        x: enemy.x,
                        y: enemy.y,
                        loot: lootType
                    };
                }

                // Update HUD
                this.updateHUD();
            },

            // ==================== PARTICLES ====================
            createParticles: function(x, y, color, type = 'success') {
                for (let i = 0; i < 5; i++) {
                    this.particles.push({
                        x, y,
                        vx: (Math.random() - 0.5) * 8,
                        vy: (Math.random() - 0.5) * 8,
                        life: 1.0,
                        color,
                        type
                    });
                }
            },

            updateParticles: function() {
                for (let i = this.particles.length - 1; i >= 0; i--) {
                    const p = this.particles[i];
                    p.x += p.vx;
                    p.y += p.vy;
                    p.life -= 0.03;
                    if (p.life <= 0) {
                        this.particles.splice(i, 1);
                    }
                }
            },

            // ==================== HUD UPDATES ====================
            updateHUD: function() {
                // Health bars
                const warriorHealth = document.getElementById('warriorHealth');
                const warriorMana = document.getElementById('warriorMana');
                const mageHealth = document.getElementById('mageHealth');
                const mageMana = document.getElementById('mageMana');
                const rogueHealth = document.getElementById('rogueHealth');
                const rogueMana = document.getElementById('rogueMana');

                warriorHealth.style.width = (warriorHealth.querySelector('.health-fill').getBoundingClientRect().width * 0.5 + 'px');
                warriorMana.style.width = (warriorMana.querySelector('.mana-fill').getBoundingClientRect().width * 0.5 + 'px');
                mageHealth.style.width = (mageHealth.querySelector('.health-fill').getBoundingClientRect().width * 0.5 + 'px');
                mageMana.style.width = (mageMana.querySelector('.mana-fill').getBoundingClientRect().width * 0.5 + 'px');
                rogueHealth.style.width = (rogueHealth.querySelector('.health-fill').getBoundingClientRect().width * 0.5 + 'px');
                rogueMana.style.width = (rogueMana.querySelector('.mana-fill').getBoundingClientRect().width * 0.5 + 'px');

                // Action points
                document.getElementById('actionPoints').textContent = this.actionPoints;

                // Turn counter
                document.getElementById('turnCounter').textContent = this.turn;
