            updateSpeedrunTimer: function() {
                if (this.speedrunTimer > 0) {
                    this.speedrunTimer--;
                    const timerEl = document.getElementById('speedrun-timer');
                    timerEl.textContent = this.speedrunTimer;
                } else {
                    this.speedrunTimer = CONFIG.SPEEDRUN_TIME;
                    timerEl.textContent = CONFIG.SPEEDRUN_TIME;
