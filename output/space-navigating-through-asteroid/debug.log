r {\n    position: absolute;\n    top: 20px;\n    right: 20px;\n    z-index: 10;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n}\n\n#timer {\n    font-size: 4rem;\n    font-weight: 300;\n    letter-spacing: 0.1em;\n    color: var(--accent-gold);\n    text-shadow: 0 0 20px rgba(255, 215, 0, 0.5);\n}\n\n.speedrun-status {\n    font-size: 1.2rem;\n    padding: 4px 12px;\n    border-radius: 50%;\n    background: linear-gradient(135deg, var(--accent-teal), var(--accent-purple));\n    color: white;\n    transition: transform 0.3s ease;\n}\n\n.speedrun-status.running { transform: scale(1.1); }\n.speedrun-status.completed { opacity: 0.7; }\n\n/* Game board */\n.game-board {\n    position: relative;\n    border: 3px solid var(--border-color);\n    border-radius: 16px;\n    background: var(--bg-secondary);\n    box-shadow: 0 0 40px rgba(0, 212, 170, 0.15);\n    overflow: hidden;\n    max-width: 600px;\n    max-height: 500px;\n}\n\n#gameCanvas {\n    display: block;\n    cursor: pointer;\n}\n\n/* High score section */\n.high-score {\n    text-align: center;\n    margin-top: 25px;\n}\n\n#high-score h2 {\n    color: var(--accent-gold);\n    font-size: 1.5rem;\n    margin-bottom: 10px;\n}\n\n#high-score p {\n    font-size: 1.2rem;\n    color: var(--text-muted);\n}\n\n/* Responsive adjustments */\n@media (max-width: 480px) {\n    .speedrun-timer {\n        left: 10px;\n        right: 10px;\n        top: 10px;\n    }\n    #timer {\n        font-size: 3rem;\n    }\n    .game-board {\n        max-width: 90vw;\n        max-height: 70vh;\n    }\n}\n'), write(file='/frontend/game.js', content='// Vibrant Dash - Interactive Game with LocalStorage High Scores & Speedrun Timer\n\n// ============================================\n// Configuration & Constants\n// ============================================\nconst CONFIG = {\n    CANVAS_SIZE: 600,\n    FPS: 60,\n    SPEEDUP_FACTOR: 1.5,\n    COLORS: {\n        bg: '#0f0c29',\n        grid: '#2a2a4a',\n        accentGold: '#ffd700',\n        accentTeal: '#00d4aa',\n        accentPurple: '#a855f7'\n    },\n    HIGH_SCORE_KEY: 'vibrant-dash-highscore'\n};\n\n// ============================================\n// Audio System (Web Audio API)\n// ============================================\nconst AudioSystem = {\n    ctx: null,\n    init() {\n        this.ctx = new (window.AudioContext || window.webkitAudioContext)();\n    },\n    playTone(freq, duration, type = 'sine') {\n        if (!this.ctx) return;\n        const osc = this.ctx.createOscillator();\n        const gain = this.ctx.createGain();\n        osc.type = type;\n        osc.frequency.setValueAtTime(freq, this.ctx.currentTime);\n        gain.gain.setValueAtTime(0.08, this.ctx.currentTime);\n        gain.gain.exponentialRampToValueAtTime(0.001, this.ctx.currentTime + duration);\n        osc.connect(gain).connect(this.ctx.destination);\n        osc.start(this.ctx.currentTime);\n        osc.stop(this.ctx.currentTime + duration);\n    },\n    playJumpSound() {\n        this.playTone(440, 0.1, 'square');\n    },\n    playScoreSound() {\n        this.playTone(880, 0.3, 'triangle');\n        setTimeout(() => this.playTone(660, 0.2, 'triangle'), 100);\n    },\n    playSpeedup() {\n        // Fast ascending tone\n        const freqs = [220, 330, 440, 550, 660];\n        freqs.forEach((freq, i) => {\n            setTimeout(() => {\n                this.playTone(freq, 0.15, \'sine\');\n            }, i * 80);\n        });\n    }\n};\n\n// ============================================\n// Game State\n// ============================================\nconst GameState = {\n    score: 0,\n    timeLeft: 60,\n    isRunning: false,\n    speedMultiplier: 1.0,\n    lastFrameTime: 0,\n    particles: [],\n    highScore: 0,\n    speedRunTimer: null\n};\n\n// ============================================\n// Canvas Setup\n// ============================================\nconst canvas = document.getElementById('gameCanvas');\nconst ctx = canvas.getContext('2d');\n\nfunction resizeCanvas() {\n    const rect = canvas.parentElement.getBoundingClientRect();\n    canvas.width = CONFIG.CANVAS_SIZE;\n    canvas.height = CONFIG.CANVAS_SIZE;\n}\n\n// ============================================\n// Initialize Game\n// ============================================\nfunction initGame() {\n    resizeCanvas();\n    AudioSystem.init();\n    loadHighScore();\n    updateUI();\n}\n\n// ============================================\n// Load / Save High Score via LocalStorage\n// ============================================\nfunction loadHighScore() {\n    try {\n        const stored = localStorage.getItem(CONFIG.HIGH_SCORE_KEY);\n        GameState.highScore = stored ? parseInt(stored, 10) : 0;\n    } catch (e) {\n        GameState.highScore = 0;\n    }\n}\n\nfunction saveHighScore() {\n    try {\n        localStorage.setItem(CONFIG.HIGH_SCORE_KEY, String(GameState.highScore));\n    } catch (e) {\n        console.warn('Failed to save high score:', e);\n    }\n}\n\n// ============================================\n// Speedrun Timer\n// ============================================\nfunction startSpeedrun() {\n    if (GameState.isRunning) return;\n    GameState.isRunning = true;\n    GameState.timeLeft = 60;\n    GameState.speedMultiplier = 1.0;\n    updateSpeedrunUI();\n    \n    // Start timer interval\n    const interval = setInterval(() => {\n        if (!GameState.isRunning) return;\n        \n        const now = performance.now();\n        const elapsed = Math.floor((now - GameState.lastFrameTime) / 1000);\n        GameState.timeLeft = Math.max(0, GameState.timeLeft - (elapsed / 60));\n        \n        // Update speed multiplier based on remaining time\n        if (GameState.timeLeft > 0) {\n            GameState.speedMultiplier = 1.0 + (60 - GameState.timeLeft) / 1200;\n        }\n        \n        updateSpeedrunUI();\n        updateTimerDisplay();\n        \n        // Check for completion\n        if (GameState.timeLeft <= 0) {\n            endSpeedrun();\n        }\n    }, 1000);\n}\n\nfunction stopSpeedrun() {\n    clearInterval(GameState.speedrunTimer);\n    GameState.isRunning = false;\n    updateSpeedrunUI();\n}\n\nfunction updateSpeedrunUI() {\n    const statusEl = document.getElementById('speedrun-status');\n    if (GameState.isRunning) {\n        statusEl.textContent = 'Running';\n        statusEl.classList.add('running');\n    } else {\n        statusEl.textContent = 'Paused';\n        statusEl.classList.remove('running');\n    }\n}\n\nfunction updateTimerDisplay() {\n    const minutes = Math.floor(GameState.timeLeft / 60);\n    const seconds = GameState.timeLeft % 60;\n    document.getElementById('timer').textContent = `${minutes}:${seconds.toString().padStart(2, \'0\')}`;\n}\n\n// ============================================\n// Game Logic\n// ============================================\nfunction spawnParticles(x, y, count) {\n    for (let i = 0; i < count; i++) {\n        GameState.particles.push({\n            x: x,\n            y: y,\n            vx: (Math.random() - 0.5) * 8,\n            vy: (Math.random() - 0.5) * 8 - 2,\n            life: 1.0,\n            decay: 0.02 + Math.random() * 0.03,\n            color: Math.random() > 0.5 ? CONFIG.COLORS.accentGold : CONFIG.COLORS.accentTeal\n        });\n    }\n}\n\nfunction updateParticles() {\n    for (let i = GameState.particles.length - 1; i >= 0; i--) {\n        const p = GameState.particles[i];\n        p.x += p.vx;\n        p.y += p.vy;\n        p.life -= p.decay;\n        if (p.life <= 0) {\n            GameState.particles.splice(i, 1);\n        }\n    }\n}\n\nfunction drawGrid() {\n    const gridSize = 40;\n    const offsetX = (canvas.width - (CONFIG.CANVAS_SIZE * CONFIG.SPEEDUP_FACTOR * 0.8)) / 2;\n    const offsetY = (canvas.height - (CONFIG.CANVAS_SIZE * CONFIG.SPEEDUP_FACTOR * 0.8)) / 2;\n    \n    ctx.strokeStyle = CONFIG.COLORS.grid;\n    ctx.lineWidth = 1;\n    \n    for (let x = 0; x < CONFIG.CANVAS_SIZE; x += gridSize) {\n        ctx.beginPath();\n        ctx.moveTo(x, 0);\n        ctx.lineTo(x, canvas.height);\n        ctx.stroke();\n    }\n    \n    for (let y = 0; y < CONFIG.CANVAS_SIZE; y += gridSize) {\n        ctx.beginPath();\n        ctx.moveTo(0, y);\n        ctx.lineTo(canvas.width, y);\n        ctx.stroke();\n    }\n}\n\nfunction drawGame() {\n    // Clear canvas\n    ctx.clearRect(0, 0, canvas.width, canvas.height);\n    \n    // Draw grid\n    drawGrid();\n    \n    // Draw particles\n    for (const p of GameState.particles) {\n        ctx.globalAlpha = p.life;\n        ctx.fillStyle = p.color;\n        ctx.beginPath();\n        ctx.arc(p.x, p.y, 3, 0, Math.PI * 2);\n        ctx.fill();\n    }\n    ctx.globalAlpha = 1;\n    \n    // Draw score counter\n    ctx.font = 'bold 24px Segoe UI';\n    ctx.fillStyle = CONFIG.COLORS.accentGold;\n    ctx.textAlign = 'center';\n    ctx.fillText(`Score: ${GameState.score}`, canvas.width / 2, 50);\n}\n\n// ============================================\n// Input Handling\n// ============================================\nconst INPUT = {\n    jump: false,\n    space: false,\n    mouseDown: false\n};\n\nwindow.addEventListener('keydown', (e) => {\n    if (e.code === 'Space' || e.code === 'ArrowUp') {\n        e.preventDefault();\n        INPUT.jump = true;\n        INPUT.space = true;\n    }\n});\n\nwindow.addEventListener('keyup', (e) => {\n    if (e.code === 'Space' || e.code === 'ArrowUp') {\n        e.preventDefault();\n        INPUT.jump = false;\n        INPUT.space = false;\n    }\n});\n\ncanvas.addEventListener('mousedown', () => {\n    INPUT.mouseDown = true;\n});\n\ncanvas.addEventListener('mouseup', () => {\n    INPUT.mouseDown = false;\n});\n\n// Touch support for mobile\ncanvas.addEventListener('touchstart', (e) => {\n    INPUT.mouseDown = true;\n    INPUT.jump = true;\n}, { passive: false });\n\ncanvas.addEventListener('touchend', () => {\n    INPUT.mouseDown = false;\n    INPUT.jump = false;\n});\n\n// ============================================\n// Main Game Loop\n// ============================================\nlet lastTime = performance.now();\n\nfunction gameLoop(timestamp) {\n    const deltaTime = (timestamp - GameState.lastFrameTime) / 1000;\n    GameState.lastFrameTime = timestamp;\n    \n    // Update speed run timer\n    if (GameState.isRunning) {\n        const elapsed = timestamp - GameState.lastFrameTime;\n        GameState.timeLeft = Math.max(0, GameState.timeLeft - elapsed * GameState.speedMultiplier);\n        \n        // If we hit the target speed multiplier, trigger speedup effect\n        if (GameState.speedMultiplier >= 2.0 && GameState.timeLeft <= 30) {\n            AudioSystem.playSpeedup();\n            GameState.speedMultiplier = 2.0;\n        }\n    }\n    \n    // Update game state\n    updateGame();\n    updateParticles();\n    drawGame();\n    \n    requestAnimationFrame(gameLoop);\n}\n\nfunction updateGame() {\n    // Player movement (simplified - jumping over obstacles)\n    if (INPUT.jump && GameState.isRunning) {\n        // Simple vertical motion simulation\n        const velocity = 0;\n        if (Math.random() > 0.95) velocity = -8; // Jump impulse\n        \n        // Apply gravity\n        velocity *= 0.98;\n        \n        // Move up/down based on velocity\n        // In a real game, this would interact with level geometry\n        // For now, we just animate the player element\n    }\n    \n    // Score accumulation based on speed\n    if (GameState.isRunning && GameState.timeLeft > 0) {\n        const pointsPerSecond = 2;\n        GameState.score += pointsPerSecond * (1 + (GameState.speedMultiplier - 1) * 0.5);\n        \n        // Visual feedback - spawn particles at score milestones\n        if (GameState.score % 50 === 0) {\n            const mid = canvas.width / 2;\n            spawnParticles(mid, canvas.height / 2, 5);\n        }\n    }\n}\n\n// ============================================\n// Start the Game\n// ============================================\ndocument.addEventListener('DOMContentLoaded', () => {\n    initGame();\n    // Start speedrun timer immediately\n    startSpeedrun();\n});\n'), write(file='/shared/utils.js', content='// Shared Utilities\n\n// Color palette helper\nconst Palette = {\n    primary: '#ffd700',      // Gold\n    teal: '#00d4aa',         // Teal\n    purple: '#a855f7',       // Purple\n    dark: '#0f0c29',        // Dark purple base\n    light: '#ffffff',        // White highlight\n    grid: '#2a2a4a'          // Grid lines\n};\n\n// Utility: format time as MM:SS\nconst formatTime = (seconds) => {\n    const mins = Math.floor(seconds / 60);\n    const secs = Math.floor(seconds % 60);\n    return `${mins}:${secs.toString().padStart(2, \'0\')}`;\n};\n\n// Utility: clamp value between min and max\nconst clamp = (value, min, max) => Math.max(min, Math.min(max, value));\n\n// Utility: generate random number within range\nconst rand = (min, max) => Math.floor(Math.random() * (max - min + 1)) + min;\n\n// Export for use in other modules\nmodule.exports = { Palette, formatTime, clamp, rand };\n'), write(file='/security/encryption.js', content='// Security Module - Encryption for High Score Protection\n\nconst CryptoUtils = {\n    /**\n     * Simple AES-like encryption using Web Crypto API\n     * In production, use proper libraries like crypto-js or webcryptjs\n     * This is a demonstration of secure local storage handling\n     */\n    \n    static encrypt(text, key) {\n        if (!window.crypto) throw new Error(\'Web Crypto API not available\');\n        \n        // Generate a key from a password (in reality, use a proper key derivation function)\n        const password = key || \'default-secret-key-change-me\';\n        const encoder = new TextEncoder();\n        const data = encoder.encode(text);\n        \n        // Create a KeyMaterial from password\n        const keyMaterial = await window.crypto.subtle.importKey(\n            "raw",\n            encoder.toArray(password),\n            { name: "PBKDF2" },\n            false,\n            ["deriveKey"]\n        );\n        \n        const key = await window.crypto.subtle.deriveKey(\n            {\n                name: "PBKDF2",\n                salt: encoder.toArray("salt"),\n                iterations: 100000,\n            },\n            keyMaterial,\n            { name: "AES-GCM", "length": 128 },\n            "encrypt",\n            "final"\n        );\n        \n        // Encrypt the string\n        const iv = window.crypto.getRandomValues(new Uint8Array(16));\n        const ciphertext = await window.crypto.subtle.encrypt(\n            { name: "AES-GCM", length: 128 },\n            key,\n            iv,\n            data\n        );\n        \n        // Combine IV and ciphertext\n        const combined = new Uint8Array(iv.length + ciphertext.byteLength);\n        combined.set(iv, 0);\n        combined.set(ciphertext, iv.length);\n        \n        return btoa(String.fromCharCode(...combined));\n    },\n    \n    static decrypt(encryptedData, key) {\n        if (!window.crypto) throw new Error(\'Web Crypto API not available\');\n        \n        const decoded = Buffer.from(decryptData(encryptedData), \'base64\');\n        const iv = decoded.slice(0, 16);\n        const ciphertext = decoded.slice(16);\n        \n        const keyMaterial = await window.crypto.subtle.importKey(\n            "raw",\n            encoder.toArray(key || \'default-secret-key-change-me\'),\n            { name: "PBKDF2" },\n            false,\n            ["deriveKey"]\n        );\n        \n        const decrypted = await window.crypto.subtle.decrypt(\n            { name: "AES-GCM", length: 128 },\n            keyMaterial,\n            iv\n        );\n        \n        return decrypted.toString(\'utf8\');\n    },\n    \n    /**\n     * Verify high score integrity\n     */\n    static verifyHighScore(encodedScore, providedScore) {\n        try {\n            const decrypted = CryptoUtils.decrypt(encodedScore, providedScore);\n            return decrypted === providedScore;\n        } catch (e) {\n            return false;\n        }\n    }\n};\n\n// Export for use in other modules\nmodule.exports = CryptoUtils;\n'), write(file='/config/config.js', content='// Configuration - Environment Specific Settings\n\nconst Config = {\n    // Application settings\n    appName: \'Vibrant Dash\',\n    version: \'1.0.0\',\n    theme: {\n        mode: \'dark\', // \'dark\' or \'light\'\n        accent: \'gold\' // gold, teal, purple\n    },\n    \n    // Game settings\n    game: {\n        canvasSize: 600,\n        fps: 60,\n        defaultSpeedMultiplier: 1.0,\n        maxScoreThreshold: 500,\n        speedupTrigger: 30 // seconds\n    },\n    \n    // Audio settings\n    audio: {\n        enabled: true,\n        masterVolume: 0.7,\n        bassBoost: 0.1\n    },\n    \n    // High score persistence\n    storage: {\n        key: \'vibrant-dash-highscore\',\n        loadOnStart: true,\n        saveOnUpdate: true,\n        retentionDays: 365\n    },\n    \n    // Security settings\n    security: {\n        encryptionKey: \'default-secret-key-change-me\', // Should be changed per environment\n        requireEncryption: true\n    },\n    \n    // Mobile responsiveness\n    responsive: {\n        maxScreenWidth: 900,\n        touchZoom: 1.5,\n        animatedTransitions: true\n    }\n};\n\nmodule.exports = Config;\n'), write(file='/backend/server.js', content='// Backend Server - Simple Node.js HTTP Server\nconst http = require(\'http\');\nconst fs = require(\'fs\');\nconst path = require(\'path\');\n\nconst PORT = process.env.PORT || 3000;\nconst CONFIG = require(\'../config/config.js\');\n\nconst server = http.createServer((req, res) => {\n    // Serve static files from frontend directory\n    const filePath = req.url === \'/\' ? \'/index.html\' : \n                     req.url.startsWith(\'/frontend/\') ? req.url : \n                     \'/backend/server.js\';\n    \n    const ext = path.extname(filePath);\n    let contentType = \'text/html\';\n    \n    switch (ext) {\n        case \'.css\':\n            contentType = \'text/css\';\n            break;\n        case \'.js\':\n            contentType = \'application/javascript\';\n            break;\n        case \'.html\':\n            contentType = \'text/html\';\n            break;\n        default:\n            contentType = \'application/octet-stream\';\n    }\n    \n    fs.readFile(filePath, (err, data) => {\n        if (err) {\n            if (err.code === \'ENOENT\') {\n                // File not found - 404\n                res.writeHead(404, { \'Content-Type\': contentType });\n                res.end(\'Not Found\');\n            } else {\n                res.writeHead(500, { \'Content-Type\': contentType });\n                res.end(\'Server Error\');\n            }\n            return;\n        }\n        \n        res.writeHead(200, { \'Content-Type\': contentType });\n        res.end(data);\n    });\n});\n\n// Health check endpoint\nserver.on(\'GET\', (req, res) => {\n    if (req.url === \'/health\') {\n        res.writeHead(200, { \'Content-Type\': \'application/json\' });\n        res.end(JSON.stringify({\n            status: \'healthy\',\n            version: Config.version,\n            timestamp: new Date().toISOString()\n        }));\n    } else {\n        res.writeHead(404);\n        res.end(\'Not Found\');\n    }\n});\n\nserver.listen(PORT, () => {\n    console.log(`Vibrant Dash server running on port ${PORT}`);\n    console.log(`App Name: ${Config.appName}`);\n    console.log(`Version: ${Config.version}`);\n});\n'), write(file='/tests/test-game.js', content='// Simple Test Suite for Vibrant Dash\n\n// Mock DOM elements for testing\nglobal.document = {\n    getElementsByClassName: (cls) => {\n        const container = document.querySelector(\'.container\');\n        return Array.from(container.querySelectorAll(cls));\n    },\n    addEventListener: (event, callback) => {\n        // Mock event listener registration\n        return { dispose: () => {} };\n    }\n};\n\nglobal.document.getElementById = (id) => {\n    return {\n        click: () => {},\n        dblclick: () => {},\n        style: (props) => props\n    };\n};\n\n// Test: High Score Persistence\nconsole.log(\'=== Testing High Score Persistence ===\');\n\n// Simulate loading high score\nconst mockLocalStorage = (() => {\n    const store = new Map();\n    return {\n        getItem: (key) => store.get(key) || null,\n        setItem: (key, value) => { store.set(key, value); }\n    };\n})();\n\nconst testLoadHighScore = async () => {\n    try {\n        const stored = mockLocalStorage.getItem(CONFIG.HIGH_SCORE_KEY);\n        console.log(\'Current high score (mock):\', stored);\n        return parseInt(stored, 10) || 0;\n    } catch (e) {\n        console.error(\'Error reading high score:\', e);\n        return 0;\n    }\n};\n\n// Test: Save High Score\nasync function testSaveHighScore(score) {\n    try {\n        mockLocalStorage.setItem(CONFIG.HIGH_SCORE_KEY, String(score));\n        const loaded = mockLocalStorage.getItem(CONFIG.HIGH_SCORE_KEY);\n        console.log(\'Saved and reloaded high score:\', loaded || \'not found\');\n        return parseInt(loaded, 10) || 0;\n    } catch (e) {\n        console.error(\'Error saving high score:\', e);\n        return 0;\n    }\n}\n\n// Run tests\nasync function runTests() {\n    console.log(\'\\n--- Running Tests ---\\n\');\n    \n    // Test 1: Load existing high score\n    const originalScore = testLoadHighScore();\n    console.log(\'Test 1 - Load High Score:\', originalScore);\n    \n    // Test 2: Save new high score\n    const newScore = 150;\n    testSaveHighScore(newScore);\n    const reloaded = testLoadHighScore();\n    console.log(\'Test 2 - Save & Reload High Score:\', reloaded);\n    \n    // Test 3: Edge case - negative score handling\n    const negativeScore = -50;\n    try {\n        mockLocalStorage.setItem(CONFIG.HIGH_SCORE_KEY, String(negativeScore));\n        const result = mockLocalStorage.getItem(CONFIG.HIGH_SCORE_KEY);\n        console.log(\'Test 3 - Negative score handled:\', result || \'not found\');\n    } catch (e) {\n        console.error(\'Test 3 failed:\', e);\n    }\n    \n    console.log(\'\\n--- All Tests Completed ---\\n\');\n}\n\n// Execute tests if run directly\nif (require.main === module) {\n    runTests().catch(console.error);\n}\n')]<|tool_call_end|>]

{"files": [{"file": "/frontend/index.html", "content": "<!DOCTYPE html>\\n<html lang=\"en\">\\n<head>\\n    <meta charset=\"UTF-8\">\\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\\n    <title>Vibrant Dash</title>\\n    <!-- Emoji favicon -->\\n    <img src=\"data:image/svg+xml,%3Csvg xmlns=\'http://www.w3.org/2000/svg\' viewBox=\'0 0 64 64\'%3E%3Ccircle cx=\'32\' cy=\'32\' r=\'30\' fill=\%23FF6B9D\'/%3E%3Ctext x=\'36\' y=\'42\' font-size=\\'20\\' fill=\'%23FFFFFF\' align=\'center\'%3E⚡%3C/text%3E%3C/svg%3E\" alt=\"⚡\" width=\"48\">\\n    <link rel=\"stylesheet\" href=\"styles.css\">\\n</head>\\n<body>\\n    <div class=\"container\">\\n        <header class=\"speedrun-timer\">\\n            <span id=\"timer\">00:00</span>\\n            <span class=\"speedrun-status\" id=\"speedrun-status\">Ready</span>\\n        </header>\\n        \\n        <main class=\"game-board\">\\n            <canvas id=\"gameCanvas\"></canvas>\\n        </main>\\n        \\n        <footer class=\"high-score\">\\n            <h2>High Score</h2>\\n            <p id=\"high-score\">0</p>\\n        </footer>\\n    </body>\\n    <script src=\"game.js\"></script>\\n</html>\\n"}, {"file": "/frontend/styles.css", "content": "/* Unique vibrant color palette */\\n:root {\\n    --bg-primary: #0f0c29;\\n    --bg-secondary: #302b63;\\n    --accent-gold: #ffd700;\\n    --accent-teal: #00d4aa;\\n    --accent-purple: #a855f7;\\n    --text-primary: #ffffff;\\n    --text-muted: #a0a0a0;\\n    --border-color: #4a4a6a;\\n}\\n\\n* {\\n    margin: 0;\\n    padding: 0;\\n    box-sizing: border-box;\\n}\\n\\nbody {\\n    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;\\n    background: var(--bg-primary);\\n    min-height: 100vh;\\n    display: flex;\\n    justify-content: center;\\n    align-items: center;\\n    color: var(--text-primary);\\n}\\n\\n.container {\\n    position: relative;\\n    display: flex;\\n    flex-direction: column;\\n    align-items: center;\\n    gap: 20px;\\n    padding: 20px;\\n}\\n\\n/* Speedrun timer in top corner */\\n.speedrun-timer {\\n    position: absolute;\\n    top: 20px;\\n    right: 20px;\\n    z-index: 10;\\n    display: flex;\\n    flex-direction: column;\\n    align-items: center;\\n}\\n\\n#timer {\\n    font-size: 4rem;\\n    font-weight: 300;\\n    letter-spacing: 0.1em;\\n    color: var(--accent-gold);\\n    text-shadow: 0 0 20px rgba(255, 215, 0, 0.5);\\n}\\n\\n.speedrun-status {\\n    font-size: 1.2rem;\\n    padding: 4px 12px;\\n    border-radius: 50%;\\n    background: linear-gradient(135deg, var(--accent-teal), var(--accent-purple));\\n    color: white;\\n    transition: transform 0.3s ease;\\n}\\n\\n.speedrun-status.running { transform: scale(1.1); }\\n.speedrun-status.completed { opacity: 0.7; }\\n\\n/* Game board */\\n.game-board {\\n    position: relative;\\n    border: 3px solid var(--border-color);\\n    border-radius: 16px;\\n    background: var(--bg-secondary);\\n    box-shadow: 0 0 40px rgba(0, 212, 170, 0.15);\\n    overflow: hidden;\\n    max-width: 600px;\\n    max-height: 500px;\\n}\\n\\n#gameCanvas {\\n    display: block;\\n    cursor: pointer;\\n}\\n\\n/* High score section */\\n.high-score {\\n    text-align: center;\\n    margin-top: 25px;\\n}\\n\\n#high-score h2 {\\n    color: var(--accent-gold);\\n    font-size: 1.5rem;\\n    margin-bottom: 10px;\\n}\\n\\n#high-score p {\\n    font-size: 1.2rem;\\n    color: var(--text-muted);\\n}\\n\\n/* Responsive adjustments */\\n@media (max-width: 480px) {\\n    .speedrun-timer {\\n        left: 10px;\\n        right: 10px;\\n        top: 10px;\\n    }\\n    #timer {\\n        font-size: 3rem;\\n    }\\n    .game-board {\\n        max-width: 90vw;\\n        max-height: 70vh;\\n    }\\n}"}, {"file": "/frontend/game.js", "content":"// Vibrant Dash - Interactive Game with LocalStorage High Scores & Speedrun Timer\\n\\n// ============================================\\n// Configuration & Constants\\n// ============================================\nconst CONFIG = {\\n    CANVAS_SIZE: 600,\\n    FPS: 60,\\n    SPEEDUP_FACTOR: 1.5,\\n    COLORS: {\\n        bg: '#0f0c29',\\n        grid: '#2a2a4a',\\n        accentGold: '#ffd700',\\n        accentTeal: '#00d4aa',\\n        accentPurple: '#a855f7'\\n    },\\n    HIGH_SCORE_KEY: 'vibrant-dash-highscore'\\n};\\n\\n// ============================================\\n// Audio System (Web Audio API)\\n// ============================================\nconst AudioSystem = {\\n    ctx: null,\\n    init() {\\n        this.ctx = new (window.AudioContext || window.webkitAudioContext)();\\n    },\\n    playTone(freq, duration, type = 'sine') {\\n        if (!this.ctx) return;\\\n        const osc = this.ctx.createOscillator();\\n        const gain = this.ctx.createGain();\\n        osc.type = type;\\n        osc.frequency.setValueAtTime(freq, this.ctx.currentTime);\\n        gain.gain.setValueAtTime(0.08, this.ctx.currentTime);\\n        gain.gain.exponentialRampToValueAtTime(0.001, this.ctx.currentTime + duration);\\n        osc.connect(gain).connect(this.ctx.destination);\\n        osc.start(this.ctx.currentTime);\\n        osc.stop(this.ctx.currentTime + duration);\\n    },\\n    playJumpSound() {\\n        this.playTone(440, 0.1, 'square');\\n    },\\n    playScoreSound() {\\n        this.playTone(880, 0.3, 'triangle');\\n        setTimeout(() => this.playTone(660, 0.2, 'triangle'), 100);\\n    },\\n    playSpeedup() {\\n        // Fast ascending tone\\n        const freqs = [220, 330, 440, 550, 660];\\n        freqs.forEach((freq, i) => {\\n            setTimeout(() => {\\n                this.playTone(freq, 0.15, 'sine');\\n            }, i * 80);\\n        });\\n    }\\n};\\n\\n// ============================================\\n// Game State\\n// ============================================\nconst GameState = {\\n    score: 0,\\n    timeLeft: 60,\\n    isRunning: false,\\n    speedMultiplier: 1.0,\\n    lastFrameTime: 0,\\n    particles: [],\\n    highScore: 0,\\n    speedRunTimer: null\\n};\\n\\n// ============================================\\n// Canvas Setup\\n// ============================================\nconst canvas = document.getElementById('gameCanvas');\\nconst ctx = canvas.getContext('2d');\\n\\nfunction resizeCanvas() {\\n    const rect = canvas.parentElement.getBoundingClientRect();\\n    canvas.width = CONFIG.CANVAS_SIZE;\\n    canvas.height = CONFIG.CANVAS_SIZE;\\n}\\n\\n// ============================================\\n// Initialize Game\\n// ============================================\nfunction initGame() {\\n    resizeCanvas();\\n    AudioSystem.init();\\n    loadHighScore();\\n    updateUI();\\n}\\n\\n// ============================================\\n// Load / Save High Score via LocalStorage\\n// ============================================\nfunction loadHighScore() {\\n    try {\\n        const stored = localStorage.getItem(CONFIG.HIGH_SCORE_KEY);\\n        GameState.highScore = stored ? parseInt(stored, 10) : 0;\\n    } catch (e) {\\n        GameState.highScore = 0;\\n    }\\n}\\n\\nfunction saveHighScore() {\\n    try {\\n        localStorage.setItem(CONFIG.HIGH_SCORE_KEY, String(GameState.highScore));\\n    } catch (e) {\\n        console.warn('Failed to save high score:', e);\\n    }\\n}\\n\\n// ============================================\\n// Speedrun Timer\\n// ============================================\nfunction startSpeedrun() {\\n    if (GameState.isRunning) return;\\\n    GameState.isRunning = true;\\n    GameState.timeLeft = 60;\\n    GameState.speedMultiplier = 1.0;\\n    updateSpeedrunUI();\\n    \\n    // Start timer interval\\n    const interval = setInterval(() => {\\n        if (!GameState.isRunning) return;\\\n        \\n        const now = performance.now();\\n        const elapsed = Math.floor((now - GameState.lastFrameTime) / 1000);\\n        GameState.timeLeft = Math.max(0, GameState.timeLeft - (elapsed / 60));\\n        \\n        // Update speed multiplier based on remaining time\\n        if (GameState.timeLeft > 0) {\\n            GameState.speedMultiplier = 1.0 + (60 - GameState.timeLeft) / 1200;\\n        }\\n        \\n        updateSpeedrunUI();\\n        updateTimerDisplay();\\n        \\n        // Check for completion\\n        if (GameState.timeLeft <= 0) {\\n            endSpeedrun();\\n        }\\n    }, 1000);\\n}\\n\\nfunction stopSpeedrun() {\\n    clearInterval(GameState.speedrunTimer);\\n    GameState.isRunning = false;\\n    updateSpeedrunUI();\\n}\\n\\nfunction updateSpeedrunUI() {\\n    const statusEl = document.getElementById('speedrun-status');\\n    if (GameState.isRunning) {\\n        statusEl.textContent = 'Running';\\n        statusEl.classList.add('running');\\n    } else {\\n        statusEl.textContent = 'Paused';\\n        statusEl.classList.remove('running');\\n    }\\n}\\n\\nfunction updateTimerDisplay() {\\n    const minutes = Math.floor(GameState.timeLeft / 60);\\n    const seconds = GameState.timeLeft % 60;\\n    document.getElementById('timer').textContent = `${minutes}:${seconds.toString().padStart(2, '0')}`;\\n}\\n\\n// ============================================\\n// Game Logic\\n// ============================================\nfunction spawnParticles(x, y, count) {\\n    for (let i = 0; i < count; i++) {\\n        GameState.particles.push({\\n            x: x,\\n            y: y,\\n            vx: (Math.random() - 0.5) * 8,\\n            vy: (Math.random() - 0.5) * 8 - 2,\\n            life: 1.0,\\n            decay: 0.02 + Math.random() * 0.03,\\n            color: Math.random() > 0.5 ? CONFIG.COLORS.accentGold : CONFIG.COLORS.accentTeal\\n        });\\n    }\\n}\\n\\nfunction updateParticles() {\\n    for (let i = GameState.particles.length - 1; i >= 0; i--) {\\n        const p = GameState.particles[i];\\n        p.x += p.vx;\\n        p.y += p.vy;\\n        p.life -= p.decay;\\n        if (p.life <= 0) {\\n            GameState.particles.splice(i, 1);\\n        }\\n    }\\n}\\n\\nfunction drawGrid() {\\n    const gridSize = 40;\\n    const offsetX = (canvas.width - (CONFIG.CANVAS_SIZE * CONFIG.SPEEDUP_FACTOR * 0.8)) / 2;\\n    const offsetY = (canvas.height - (CONFIG.CANVAS_SIZE * CONFIG.SPEEDUP_FACTOR * 0.8)) / 2;\\n    \\n    ctx.strokeStyle = CONFIG.COLORS.grid;\\n    ctx.lineWidth = 1;\\n    \\n    for (let x = 0; x < CONFIG.CANVAS_SIZE; x += gridSize) {\\n        ctx.beginPath();\\n        ctx.moveTo(x, 0);\\n        ctx.lineTo(x, canvas.height);\\n        ctx.stroke();\\n    }\\n    \\n    for (let y = 0; y < CONFIG.CANVAS_SIZE; y += gridSize) {\\n        ctx.beginPath();\\n        ctx.moveTo(0, y);\\n        ctx.lineTo(canvas.width, y);\\n        ctx.stroke();\\n    }\\n}\\n\\nfunction drawGame() {\\n    // Clear canvas\\n    ctx.clearRect(0, 0, canvas.width, canvas.height);\\n    \\n    // Draw grid\\n    drawGrid();\\n    \\n    // Draw particles\\n    for (const p of GameState.particles) {\\n        ctx.globalAlpha = p.life;\\n        ctx.fillStyle = p.color;\\n        ctx.beginPath();\\n        ctx.arc(p.x, p.y, 3, 0, Math.PI * 2);\\n        ctx.fill();\\n    }\\n    ctx.globalAlpha = 1;\\n    \\n    // Draw score counter\\n    ctx.font = 'bold 24px Segoe UI';\\n    ctx.fillStyle = CONFIG.COLORS.accentGold;\\n    ctx.textAlign = 'center';\\n    ctx.fillText(`Score: ${GameState.score}`, canvas.width / 2, 50);\\n}\\n\\n// ============================================\\n// Input Handling\\n// ============================================\nconst INPUT = {\\n    jump: false,\\n    space: false,\\n    mouseDown: false\\n};\\n\\nwindow.addEventListener('keydown', (e) => {\\n    if (e.code === 'Space' || e.code === 'ArrowUp') {\\n        e.preventDefault();\\n        INPUT.jump = true;\\n        INPUT.space = true;\\n    }\\n});\\n\\nwindow.addEventListener('keyup', (e) => {\\n    if (e.code === 'Space' || e.code === 'ArrowUp') {\\n        e.preventDefault();\\n        INPUT.jump = false;\\n        INPUT.space = false;\\n    }\\n});\\n\\ncanvas.addEventListener('mousedown', () => {\\n    INPUT.mouseDown = true;\\n});\\n\\ncanvas.addEventListener('mouseup', () => {\\n    INPUT.mouseDown = false;\\n});\\n\\n// Touch support for mobile\\ncanvas.addEventListener('touchstart', (e) => {\\n    INPUT.mouseDown = true;\\n    INPUT.jump = true;\\n}, { passive: false });\\n\\ncanvas.addEventListener('touchend', () => {\\n    INPUT.mouseDown = false;\\n    INPUT.jump = false;\\n});\\n\\n// ============================================\\n// Main Game Loop\\n// ============================================\nlet lastTime = performance.now();\\n\\nfunction gameLoop(timestamp) {\\n    const deltaTime = (timestamp - GameState.lastFrameTime) / 1000;\\\\n    GameState.lastFrameTime = timestamp;\\\\n    \\n    // Update speed run timer\\n    if (GameState.isRunning) {\\n        const elapsed = timestamp - GameState.lastFrameTime;\\\\n        GameState.timeLeft = Math.max(0, GameState.timeLeft - elapsed * GameState.speedMultiplier);\\\\n        \\\\n        // If we hit the target speed multiplier, trigger speedup effect\\n        if (GameState.speedMultiplier >= 2.0 && GameState.timeLeft <= 30) {\\n            AudioSystem.playSpeedup();\\n            GameState.speedMultiplier = 2.0;\\\\n        }\\n    }\\n    \\n    // Update game state\\n    updateGame();\\n    updateParticles();\\n    drawGame();\\n    \\n    requestAnimationFrame(gameLoop);\\n}\\n\\n\\n// ============================================\\n// Update Game State\\n// ============================================\nfunction updateGame() {\\n    // Player movement (simplified - jumping over obstacles)\\n    if (INPUT.jump && GameState.isRunning) {\\n        // Simple vertical motion simulation\\n        const velocity = 0;\\\\n        if (Math.random() > 0.95) velocity = -8; // Jump impulse\\\\n        \\\\n        // Apply gravity\\n        velocity *= 0.98;\\\\n        \\\\n        // Move up/down based on velocity\\n        // In a real game, this would interact with level geometry\\n        // For now, we just animate the player element\\n    }\\n    \\n    // Score accumulation based on speed\\n    if (GameState.isRunning && GameState.timeLeft > 0) {\\n        const pointsPerSecond = 2;\\\\n        GameState.score += pointsPerSecond * (1 + (GameState.speedMultiplier - 1) * 0.5);\\\\n        \\\\n        // Visual feedback - spawn particles at score milestones\\n        if (GameState.score % 50 === 0) {\\n            const mid = canvas.width / 2;\\\\n            spawnParticles(mid, canvas.height / 2, 5);\\\\n        }\\n    }\\n}\\n\\n// ============================================\\n// Start the Game\\n// ============================================\ndocument.addEventListener('DOMContentLoaded', () => {\\n    initGame();\\n    // Start speedrun timer immediately\\n    startSpeedrun();\\n});\\n"}')]