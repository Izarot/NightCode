", "systems/ensembleManager.js": "import { Creature } from './creature.js';\
\
export class EnsembleManager {\
  constructor(renderer) {\
    this.renderer = renderer;\
    this.creatures = [];\
    this.pool = [];\
    this.formations = new Map();\
    this.harmonyWeb = [];\
    this._initPool();\
  }\
\
  _initPool() {\
    for (let i = 0; i < 500; i++) {\
      this.pool.push(new Creature());\
    }\
  }\
\
  spawn(type, formation, params = {}) {\
    const creature = this.pool.pop() || new Creature();\
    creature.init(type, formation, params);\
    this.creatures.push(creature);\
    return creature;\
  }\
\
  update(dt) {\
    for (const creature of this.creatures) {\
      creature.update(dt);\
    }\
    // Remove dead creatures\
    this.creatures = this.creatures.filter(c => {\
      if (c.dead) {\
        c.reset();\
        this.pool.push(c);\
        return false;\
      }\
      return true;\
    });\
    this._updateHarmonyWeb();\
  }\
\
  _updateHarmonyWeb() {\
    this.harmonyWeb = [];\
    const resonators = this.creatures.filter(c => c.type === 'RESONATOR');\
    for (let i = 0; i < resonators.length; i++) {\
      for (let j = i + 1; j < resonators.length; j++) {\
        const dist = Math.hypot(\
          resonators[i].x - resonators[j].x,\
          resonators[i].y - resonators[j].y\
        );\
        if (dist < 300) {\
          this.harmonyWeb.push({ a: resonators[i], b: resonators[j], dist });\
        }\
      }\
    }\
  }\
\
  render(ctx) {\
    for (const creature of this.creatures) {\
      creature.render(ctx);\
    }\
    this._renderHarmonyWeb(ctx);\
  }\
\
  _renderHarmonyWeb(ctx) {\
    ctx.strokeStyle = 'rgba(147, 51, 234, 0.4)';\
    ctx.lineWidth = 2;\
    for (const link of this.harmonyWeb) {\
      ctx.beginPath();\
      ctx.moveTo(link.a.x, link.a.y);\
      ctx.lineTo(link.b.x, link.b.y);\
      ctx.stroke();\
    }\
  }\
\
  renderVFX(ctx) {\
    for (const creature of this.creatures) {\
      creature.renderVFX(ctx);\
    }\
  }\
}\
