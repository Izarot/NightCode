    function triggerCameraShake() {
        cameraShake = true;
        const canvas = document.getElementById('gameCanvas');
        const centerX = canvas.width / 2;
        const centerY = canvas.height / 2;
        
        // Decay wave effect
        const waveOffset = (performance.now() * 0.003) % 4;
        
        // Apply shake to canvas transform
        if (canvas.transform) {
            canvas.style.transform = `translate(${waveOffset}px, ${waveOffset}px) rotate(${waveOffset * 0.5}deg)`;
        } else {
            canvas.style.transform = `translate(${waveOffset}px, ${waveOffset}px) rotate(${waveOffset * 0.5}deg)`;
        }
        
        // Add a brief translation pulse
        setTimeout(() => {
            if (canvas.transform) {
                const current = parseFloat(canvas.style.transform.replace('translate(.*)', '').replace('rotate(.*)', '')) || 0;
                canvas.style.transform = `translate(${current - 2}px, ${current - 2}px) rotate(${current * 0.5}deg)`;
            }
        }, 200);
    }
    
