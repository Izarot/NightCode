    // Handle Lane Hit - Check Timing and Update State
    function handleLaneHit(laneColor, key) {
        // Only process if we're in a lane and within the timing window
        if (gameState.currentLane === laneColor) {
            gameState.currentLane = laneColor;
            gameState.combo++;
            gameState.score += 100 * gameState.combo;
            
            // Check for perfect hit (within 20ms of hit line)
            const now = performance.now();
            const hitTime = now - gameState.lastHitTime;
            const timeSinceHitLine = now - gameState.hitLineY;
            
            if (Math.abs(timeSinceHitLine) < 20) {
                // Perfect hit
                gameState.combo++;
                gameState.score += 300;
                showJudgment('PERFECT');
                triggerCameraShake();
                // Update high score
                if (gameState.score > gameState.highScore) {
                    gameState.highScore = gameState.score;
                    localStorage.setItem('beatbox_highscore', gameState.highScore);
                }
            } else if (Math.abs(timeSinceHitLine) < 100) {
                // Great hit
                gameState.combo++;
                gameState.score += 200;
                showJudgment('GREAT');
                triggerCameraShake();
            } else if (Math.abs(timeSinceHitLine) < 200) {
                // Good hit
                gameState.combo++;
                gameState.score += 150;
                showJudgment('GOOD');
                triggerCameraShake();
            } else {
                // Miss - combo breaks
                gameState.combo = 0;
                gameState.score = 0;
                showJudgment('MISS');
                triggerCameraShake();
            }
            
            // Update HUD
            renderHUD();
            
            // Update speedrun timer
            updateSpeedrun();
            
            // Spawn next note
            spawnNote();
        }
    }
    
    // Spawn a new note at a random lane
    function spawnNote() {
        const lanes = [COLORS.lane1, COLORS.lane2, COLORS.lane3, COLORS.lane4];
        const lane = lanes[Math.floor(Math.random() * lanes.length)];
        gameState.currentLane = lane;
        
        // Add a small delay before the note appears
        setTimeout(() => {
            const x = Math.random() * CANVAS.width;
            const y = CANVAS.height - 50;
            createBox(x, y, lane, laneColor: lane);
        }, 100 + Math.random() * 200);
    }
    
    // Create a box on the canvas
    function createBox(x, y, lane, laneColor) {
        const box = {
            x,
            y,
            width: 80,
            height: 60,
            color: laneColor,
            hitLineY: y,
            isHeld: false,
            heldKey: null,
            heldTime: 0,
            hit: false
        };
        
        // Add to renderer's box list
        renderer.boxes.push(box);
        
        // Visual feedback on hit
        if (box.hit) {
            box.animation = {
                type: 'squashStretch',
                scale: 1.2,
                duration: 150
            };
        }
    }
    
    // Renderer Module
    const renderer = {
        boxes: [],
        animation: [],
        
        // Draw a single box
        drawBox(x, y, color, hitLineY, isHeld) {
            const alpha = isHeld ? 0.5 : 1.0;
            const glowIntensity = isHeld ? 0.3 : 0;
            
            // Main box with glow
            const grad = ctx.createLinearGradient(x, y, x, y + 60);
            grad.addColorStop(0, color + '40');
            grad.addColorStop(0.5, color + '20');
            grad.addColorStop(1, color + '10');
            
            ctx.save();
            ctx.globalAlpha = alpha;
            ctx.globalCompositeOperation = 'lighter';
            
            // Box body
            ctx.fillStyle = color;
            ctx.strokeStyle = color + '80';
            ctx.lineWidth = 2;
            
            // Rounded box
            const radius = 8;
            ctx.beginPath();
            ctx.roundRect(x + 4, y + 10, x + 72 - 8, 50 - 20, radius);
            ctx.fill();
            ctx.stroke();
            
            // Glow effect
            if (glowIntensity > 0) {
                ctx.fillStyle = color + '100';
                ctx.beginPath();
                ctx.arc(x + 36, y + 35, 25, 0, Math.PI * 2);
                ctx.fill();
            }
            
            ctx.restore();
        },
        
        // Update and draw all boxes
        updateAndDraw() {
            for (const box of this.boxes) {
                // Check if box has been hit
                if (box.hit) {
                    // Remove after a short delay
                    setTimeout(() => {
                        this.boxes = this.boxes.filter(b => b !== box);
                    }, 300);
                    continue;
                }
                
                // Update animation
                if (box.animation) {
                    const elapsed = performance.now() - box.animation.startTime;
                    if (elapsed < box.animation.duration) {
                        // Squash and stretch animation
                        const progress = Math.min(elapsed / box.animation.duration, 1);
                        const scale = 1 + (1 - progress) * 0.2;
                        box.scale = scale;
                        
                        // Update visual properties
                        if (box.animation.type === 'squashStretch') {
                            box.scale = 1.2;
                        }
                    }
                }
                
                // Draw the box
                this.drawBox(box.x, box.y, box.color, box.hitLineY, box.isHeld);
            }
        },
        
        // Update all animations
        updateAnimations() {
            for (const box of this.boxes) {
                if (box.animation) {
                    const elapsed = performance.now() - box.animation.startTime;
                    if (elapsed < box.animation.duration) {
                        // Continue animation
                    } else {
                        // Animation complete - reset
                        box.animation = null;
                    }
                }
            }
        }
    };
    
