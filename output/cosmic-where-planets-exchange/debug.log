 transition: opacity 0.5s ease, visibility 0.5s ease;\n}\n\n.loading-screen.hidden {\n    opacity: 0;\n    visibility: hidden;\n    pointer-events: none;\n}\n\n.loading-spinner {\n    width: 60px;\n    height: 60px;\n    border: 3px solid var(--panel-border);\n    border-top-color: transparent;\n    border-radius: 50%;\n    animation: spin 1s linear infinite;\n    margin-bottom: 20px;\n}\n\n@keyframes spin {\n    to { transform: rotate(360deg); }\n}\n\n.loading-screen p {\n    color: var(--text-dim);\n    font-size: 14px;\n    letter-spacing: 2px;\n}\n\n#hud {\n    position: fixed;\n    top: 0;\n    left: 0;\n    width: 100%;\n    height: 100%;\n    pointer-events: none;\n    z-index: 100;\n}\n\n.panel {\n    background: var(--panel-bg);\n    border: 1px solid var(--panel-border);\n    border-radius: 4px;\n    padding: 8px 12px;\n    font-size: 12px;\n    color: var(--text);\n}\n\n#objectiveBanner {\n    position: absolute;\n    top: 20px;\n    left: 50%;\n    transform: translateX(-50%);\n    text-align: center;\n    pointer-events: none;\n}\n\n#objectiveBanner .panel {\n    display: inline-block;\n    min-width: 200px;\n}\n\n#fuelGauge {\n    position: absolute;\n    top: 20px;\n    right: 20px;\n    width: 200px;\n}\n\n#fuelBar {\n    width: 100%;\n    height: 8px;\n    background: rgba(0, 0, 0, 0.5);\n    border: 1px solid var(--panel-border);\n    border-radius: 2px;\n    overflow: hidden;\n    margin-top: 8px;\n}\n\n#fuelFill {\n    height: 100%;\n    background: linear-gradient(90deg, var(--primary), var(--success));\n    transition: width 0.1s ease, background 0.3s ease;\n}\n\n#fuelFill.low {\n    background: linear-gradient(90deg, var(--danger), var(--warning));\n    animation: pulse 1s ease-in-out infinite;\n}\n\n@keyframes pulse {\n    0%, 100% { opacity: 1; }\n    50% { opacity: 0.5; }\n}\n\n#swapCooldown {\n    position: absolute;\n    top: 20px;\n    left: 20px;\n    width: 80px;\n    height: 80px;\n}\n\n#swapIcon {\n    position: relative;\n    width: 60px;\n    height: 60px;\n    margin: 0 auto;\n}\n\n#swapRadial {\n    position: absolute;\n    top: 0;\n    left: 0;\n    width: 100%;\n    height: 100%;\n    border-radius: 50%;\n    border: 3px solid var(--panel-border);\n    clip-path: inset(0 0 0 0);\n    transition: clip-path 0.1s linear;\n}\n\n#swapRadial.ready {\n    border-color: var(--success);\n    box-shadow: 0 0 10px var(--success);\n}\n\n#swapCharges {\n    position: absolute;\n    bottom: -5px;\n    right: -5px;\n    background: var(--background);\n    border: 1px solid var(--panel-border);\n    border-radius: 50%;\n    width: 24px;\n    height: 24px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    font-size: 10px;\n    color: var(--primary);\n}\n\n#contextTooltip {\n    position: absolute;\n    bottom: 20px;\n    left: 50%;\n    transform: translateX(-50%);\n    text-align: center;\n    pointer-events: none;\n    transition: opacity 0.2s ease;\n}\n\n#contextTooltip .panel {\n    display: inline-block;\n    min-width: 180px;\n}\n\n#minimap {\n    position: absolute;\n    bottom: 20px;\n    left: 20px;\n    width: 150px;\n    height: 150px;\n    border: 1px solid var(--panel-border);\n    border-radius: 4px;\n    background: rgba(5, 5, 16, 0.8);\n    overflow: hidden;\n}\n\n#minimapCanvas {\n    width: 100%;\n    height: 100%;\n    display: block;\n}\n\n#speedrunTimer {\n    position: absolute;\n    top: 20px;\n    left: 50%;\n    transform: translateX(-50%);\n    margin-top: 60px;\n    font-size: 18px;\n    font-weight: bold;\n    color: var(--primary);\n    text-shadow: 0 0 10px var(--primary);\n    letter-spacing: 2px;\n}\n\n#highScoreDisplay {\n    position: absolute;\n    top: 20px;\n    right: 20px;\n    margin-top: 60px;\n    font-size: 12px;\n    color: var(--text-dim);\n}\n\n#highScoreDisplay .value {\n    color: var(--warning);\n    font-weight: bold;\n}\n\n.planet-label {\n    position: absolute;\n    pointer-events: none;\n    font-size: 10px;\n    color: var(--primary);\n    text-shadow: 0 0 5px var(--primary);\n    white-space: nowrap;\n    transform: translateX(-50%);\n    transition: opacity 0.1s ease;\n}\n\n.planet-label.hidden {\n    opacity: 0;\n    pointer-events: none;\n}\n\n#pauseMenu, #gameOverMenu, #levelCompleteMenu {\n    position: fixed;\n    top: 0;\n    left: 0;\n    width: 100%;\n    height: 100%;\n    background: rgba(5, 5, 16, 0.95);\n    display: none;\n    flex-direction: column;\n    align-items: center;\n    justify-content: center;\n    z-index: 200;\n    gap: 20px;\n}\n\n#pauseMenu.visible, #gameOverMenu.visible, #levelCompleteMenu.visible {\n    display: flex;\n}\n\n.menu-panel {\n    background: var(--panel-bg);\n    border: 1px solid var(--panel-border);\n    border-radius: 4px;\n    padding: 40px 60px;\n    text-align: center;\n    min-width: 300px;\n}\n\n.menu-panel h1 {\n    font-size: 28px;\n    margin-bottom: 10px;\n    color: var(--primary);\n}\n\n.menu-panel p {\n    color: var(--text-dim);\n    margin-bottom: 20px;\n}\n\n.menu-btn {\n    background: transparent;\n    border: 1px solid var(--panel-border);\n    color: var(--text);\n    font-family: inherit;\n    font-size: 14px;\n    padding: 10px 30px;\n    margin: 5px;\n    cursor: pointer;\n    transition: all 0.2s ease;\n}\n\n.menu-btn:hover {\n    background: var(--primary);\n    color: var(--background);\n}\n\n.menu-btn:disabled {\n    opacity: 0.4;\n    cursor: not-allowed;\n}\n\n#reticle {\n    position: fixed;\n    width: 32px;\n    height: 32px;\n    pointer-events: none;\n    z-index: 50;\n    transform: translate(-50%, -50%);\n    transition: opacity 0.1s ease;\n}\n\n#reticle.hidden {\n    opacity: 0;\n}\n\n#reticle svg {\n    width: 100%;\n    height: 100%;\n}\n\n@media (max-width: 768px) {\n    #fuelGauge { width: 150px; }\n    #swapCooldown { top: 10px; left: 10px; }\n    #objectiveBanner { top: 10px; }\n    #speedrunTimer { font-size: 14px; margin-top: 50px; }\n    #highScoreDisplay { right: 10px; margin-top: 50px; }\n    #minimap { bottom: 10px; left: 10px; width: 120px; height: 120px; }\n    #contextTooltip { bottom: 10px; font-size: 11px; }\n    .menu-panel { padding: 30px 40px; min-width: 280px; }\n}", "src/js/main.js": "import { Game } from './game/Game.js';\nimport { InputManager } from './engine/InputManager.js';\nimport { AudioManager } from './engine/AudioManager.js';\nimport { AssetLoader } from './engine/AssetLoader.js';\n\nclass GravityExchange {\n    constructor() {\n        this.canvas = document.getElementById('gameCanvas');\n        this.ctx = this.canvas.getContext('2d');\n        this.loadingScreen = document.getElementById('loadingScreen');\n        \n        this.input = new InputManager();\n        this.audio = new AudioManager();\n        this.assetLoader = new AssetLoader();\n        \n        this.game = null;\n        this.lastTime = 0;\n        this.accumulator = 0;\n        this.fixedTimestep = 1 / 60;\n        this.maxSubSteps = 5;\n        \n        this.isRunning = false;\n        this.resizeTimeout = null;\n        \n        this.init();\n    }\n\n    async init() {\n        try {\n            await this.assetLoader.load();\n            this.setupCanvas();\n            this.setupEventListeners();\n            \n            this.game = new Game(this.canvas, this.ctx, this.input, this.audio);\n            await this.game.init();\n            \n            this.loadingScreen.classList.add('hidden');\n            this.isRunning = true;\n            requestAnimationFrame(this.gameLoop.bind(this));\n        } catch (error) {\n            console.error('Failed to initialize game:', error);\n            this.loadingScreen.querySelector('p').textContent = 'ERROR: ' + error.message;\n            this.loadingScreen.querySelector('p').style.color = '#ff3344';\n        }\n    }\n\n    setupCanvas() {\n        const resize = () => {\n            const dpr = window.devicePixelRatio || 1;\n            const rect = this.canvas.parentElement.getBoundingClientRect();\n            \n            this.canvas.width = rect.width * dpr;\n            this.canvas.height = rect.height * dpr;\n            this.canvas.style.width = rect.width + 'px';\n            this.canvas.style.height = rect.height + 'px';\n            \n            this.ctx.scale(dpr, dpr);\n            \n            if (this.game) {\n                this.game.onResize(rect.width, rect.height);\n            }\n        };\n\n        window.addEventListener('resize', () => {\n            clearTimeout(this.resizeTimeout);\n            this.resizeTimeout = setTimeout(resize, 100);\n        });\n        \n        resize();\n    }\n\n    setupEventListeners() {\n        document.addEventListener('visibilitychange', () => {\n            if (document.hidden) {\n                this.audio.pauseAll();\n            } else {\n                this.audio.resumeAll();\n            }\n        });\n    }\n\n    gameLoop(timestamp) {\n        if (!this.isRunning) return;\n\n        const deltaTime = (timestamp - this.lastTime) / 1000;\n        this.lastTime = timestamp;\n\n        this.accumulator += Math.min(deltaTime, 0.1);\n\n        let subSteps = 0;\n        while (this.accumulator >= this.fixedTimestep && subSteps < this.maxSubSteps) {\n            this.game.update(this.fixedTimestep);\n            this.accumulator -= this.fixedTimestep;\n            subSteps++;\n        }\n\n        const alpha = this.accumulator / this.fixedTimestep;\n        this.game.render(alpha);\n\n        requestAnimationFrame(this.gameLoop.bind(this));\n    }\n}\n\nnew GravityExchange();", "src/js/engine/InputManager.js": "export class InputManager {\n    constructor() {\n        this.keys = new Set();\n        this.keysPressed = new Set();\n        this.keysReleased = new Set();\n        \n        this.mouse = {\n            x: 0,\n            y: 0,\n            worldX: 0,\n            worldY: 0,\n            left: false,\n            right: false,\n            leftPressed: false,\n            rightPressed: false,\n            leftReleased: false,\n            rightReleased: false\n        };\n        \n        this.touch = {\n            active: false,\n            x: 0,\n            y: 0,\n            startX: 0,\n            startY: 0\n        };\n\n        this.bindEvents();\n    }\n\n    bindEvents() {\n        window.addEventListener('keydown', (e) => {\n            if (!this.keys.has(e.code)) {\n                this.keysPressed.add(e.code);\n            }\n            this.keys.add(e.code);\n            \n            if (['Space', 'ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight', 'KeyW', 'KeyA', 'KeyS', 'KeyD'].includes(e.code)) {\n                e.preventDefault();\n            }\n        });\n\n        window.addEventListener('keyup', (e) => {\n            this.keys.delete(e.code);\n            this.keysReleased.add(e.code);\n        });\n\n        window.addEventListener('mousemove', (e) => {\n            this.mouse.x = e.clientX;\n            this.mouse.y = e.clientY;\n        });\n\n        window.addEventListener('mousedown', (e) => {\n            if (e.button === 0) {\n                if (!this.mouse.left) this.mouse.leftPressed = true;\n                this.mouse.left = true;\n            } else if (e.button === 2) {\n                if (!this.mouse.right) this.mouse.rightPressed = true;\n                this.mouse.right = true;\n            }\n        });\n\n        window.addEventListener('mouseup', (e) => {\n            if (e.button === 0) {\n                this.mouse.left = false;\n                this.mouse.leftReleased = true;\n            } else if (e.button === 2) {\n                this.mouse.right = false;\n                this.mouse.rightReleased = true;\n            }\n        });\n\n        window.addEventListener('contextmenu', (e) => e.preventDefault());\n\n        window.addEventListener('touchstart', (e) => {\n            if (e.touches.length > 0) {\n                this.touch.active = true;\n                this.touch.startX = e.touches[0].clientX;\n                this.touch.startY = e.touches[0].clientY;\n                this.touch.x = e.touches[0].clientX;\n                this.touch.y = e.touches[0].clientY;\n                this.mouse.x = this.touch.x;\n                this.mouse.y = this.touch.y;\n                this.mouse.leftPressed = true;\n                this.mouse.left = true;\n            }\n            e.preventDefault();\n        }, { passive: false });\n\n        window.addEventListener('touchmove', (e) => {\n            if (e.touches.length > 0) {\n                this.touch.x = e.touches[0].clientX;\n                this.touch.y = e.touches[0].clientY;\n                this.mouse.x = this.touch.x;\n                this.mouse.y = this.touch.y;\n            }\n            e.preventDefault();\n        }, { passive: false });\n\n        window.addEventListener('touchend', (e) => {\n            this.touch.active = false;\n            this.mouse.left = false;\n            this.mouse.leftReleased = true;\n            e.preventDefault();\n        });\n    }\n\n    updateWorldMouse(camera) {\n        const rect = this.canvas?.getBoundingClientRect() || { left: 0, top: 0 };\n        const screenX = this.mouse.x - rect.left;\n        const screenY = this.mouse.y - rect.top;\n        \n        const world = camera.screenToWorld(screenX, screenY);\n        this.mouse.worldX = world.x;\n        this.mouse.worldY = world.y;\n    }\n\n    isKeyDown(code) {\n        return this.keys.has(code);\n    }\n\n    isKeyPressed(code) {\n        return this.keysPressed.has(code);\n    }\n\n    isKeyReleased(code) {\n        return this.keysReleased.has(code);\n    }\n\n    clearFrame() {\n        this.keysPressed.clear();\n        this.keysReleased.clear();\n        this.mouse.leftPressed = false;\n        this.mouse.rightPressed = false;\n        this.mouse.leftReleased = false;\n        this.mouse.rightReleased = false;\n    }\n\n    getThrustInput() {\n        let thrust = 0;\n        if (this.isKeyDown('KeyW') || this.isKeyDown('ArrowUp')) thrust = 1;\n        if (this.isKeyDown('KeyS') || this.isKeyDown('ArrowDown')) thrust = -1;\n        return thrust;\n    }\n\n    getRotationInput() {\n        let rotation = 0;\n        if (this.isKeyDown('KeyA') || this.isKeyDown('ArrowLeft')) rotation = -1;\n        if (this.isKeyDown('KeyD') || this.isKeyDown('ArrowRight')) rotation = 1;\n        return rotation;\n    }\n}", "src/js/engine/Camera.js": "export class Camera {\n    constructor(canvasWidth, canvasHeight, worldBounds) {\n        this.x = 0;\n        this.y = 0;\n        this.zoom = 1;\n        this.targetX = 0;\n        this.targetY = 0;\n        \n        this.canvasWidth = canvasWidth;\n        this.canvasHeight = canvasHeight;\n        this.worldBounds = worldBounds;\n        \n        this.deadzone = 300;\n        this.lerpFactor = 0.1;\n        \n        this.shakeIntensity = 0;\n        this.shakeDecay = 0.8;\n        this.shakeOffsetX = 0;\n        this.shakeOffsetY = 0;\n    }\n\n    setTarget(x, y) {\n        this.targetX = x;\n        this.targetY = y;\n    }\n\n    update(dt) {\n        const halfWidth = this.canvasWidth / (2 * this.zoom);\n        const halfHeight = this.canvasHeight / (2 * this.zoom);\n        \n        const dx = this.targetX - this.x;\n        const dy = this.targetY - this.y;\n        const dist = Math.sqrt(dx * dx + dy * dy);\n        \n        if (dist > this.deadzone) {\n            const factor = Math.min(1, (dist - this.deadzone) / 100);\n            this.x += dx * this.lerpFactor * factor;\n            this.y += dy * this.lerpFactor * factor;\n        } else {\n            this.x += dx * this.lerpFactor;\n            this.y += dy * this.lerpFactor;\n        }\n\n        const minX = this.worldBounds.left + halfWidth;\n        const maxX = this.worldBounds.right - halfWidth;\n        const minY = this.worldBounds.top + halfHeight;\n        const maxY = this.worldBounds.bottom - halfHeight;\n        \n        this.x = Math.max(minX, Math.min(maxX, this.x));\n        this.y = Math.max(minY, Math.min(maxY, this.y));\n\n        if (this.shakeIntensity > 0.5) {\n            this.shakeOffsetX = (Math.random() - 0.5) * this.shakeIntensity * 2;\n            this.shakeOffsetY = (Math.random() - 0.5) * this.shakeIntensity * 2;\n            this.shakeIntensity *= this.shakeDecay;\n        } else {\n            this.shakeIntensity = 0;\n            this.shakeOffsetX = 0;\n            this.shakeOffsetY = 0;\n        }\n    }\n\n    shake(intensity) {\n        this.shakeIntensity = Math.max(this.shakeIntensity, intensity);\n    }\n\n    screenToWorld(screenX, screenY) {\n        return {\n            x: (screenX / this.zoom) + this.x - this.canvasWidth / (2 * this.zoom) + this.shakeOffsetX,\n            y: (screenY / this.zoom) + this.y - this.canvasHeight / (2 * this.zoom) + this.shakeOffsetY\n        };\n    }\n\n    worldToScreen(worldX, worldY) {\n        return {\n            x: (worldX - this.x + this.canvasWidth / (2 * this.zoom)) * this.zoom,\n            y: (worldY - this.y + this.canvasHeight / (2 * this.zoom)) * this.zoom\n        };\n    }\n\n    applyTransform(ctx) {\n        ctx.save();\n        ctx.translate(\n            this.canvasWidth / 2 - (this.x + this.shakeOffsetX) * this.zoom,\n            this.canvasHeight / 2 - (this.y + this.shakeOffsetY) * this.zoom\n        );\n        ctx.scale(this.zoom, this.zoom);\n    }\n\n    resetTransform(ctx) {\n        ctx.restore();\n    }\n\n    isVisible(x, y, radius) {\n        const halfWidth = this.canvasWidth / (2 * this.zoom);\n        const halfHeight = this.canvasHeight / (2 * this.zoom);\n        return x + radius > this.x - halfWidth &&\n               x - radius < this.x + halfWidth &&\n               y + radius > this.y - halfHeight &&\n               y - radius < this.y + halfHeight;\n    }\n\n    onResize(width, height) {\n        this.canvasWidth = width;\n        this.canvasHeight = height;\n    }\n}", "src/js/engine/AudioManager.js": "export class AudioManager {\n    constructor() {\n        this.audioContext = null;\n        this.masterGain = null;\n        this.musicGain = null;\n        this.sfxGain = null;\n        this.isMuted = false;\n        this.musicSource = null;\n        this.musicBuffer = null;\n        \n        this.initAudioContext();\n        this.createSounds();\n    }\n\n    initAudioContext() {\n        try {\n            this.audioContext = new (window.AudioContext || window.webkitAudioContext)();\n            this.masterGain = this.audioContext.createGain();\n            this.masterGain.connect(this.audioContext.destination);\n            this.masterGain.gain.value = 0.3;\n\n            this.musicGain = this.audioContext.createGain();\n            this.musicGain.connect(this.masterGain);\n            this.musicGain.gain.value = 0.5;\n\n            this.sfxGain = this.audioContext.createGain();\n            this.sfxGain.connect(this.masterGain);\n            this.sfxGain.gain.value = 0.7;\n        } catch (e) {\n            console.warn('Web Audio API not supported');\n        }\n    }\n\n    createSounds() {\n        this.sounds = {};\n        \n        this.sounds.thrust = this.createThrustSound();\n        this.sounds.swap = this.createSwapSound();\n        this.sounds.crash = this.createCrashSound();\n        this.sounds.wormhole = this.createWormholeSound();\n        this.sounds.uiClick = this.createUIClickSound();\n        this.sounds.checkpoint = this.createCheckpointSound();\n        this.sounds.fuelLow = this.createFuelLowSound();\n    }\n\n    createOscillator(type, frequency, duration, gainValue = 0.1) {\n        if (!this.audioContext) return null;\n        \n        const oscillator = this.audioContext.createOscillator();\n        const gain = this.audioContext.createGain();\n        \n        oscillator.type = type;\n        oscillator.frequency.value = frequency;\n        gain.gain.value = gainValue;\n        \n        oscillator.connect(gain);\n        gain.connect(this.sfxGain);\n        \n        oscillator.start();\n        oscillator.stop(this.audioContext.currentTime + duration);\n        \n        return { oscillator, gain };\n    }\n\n    createThrustSound() {\n        return () => {\n            if (!this.audioContext) return;\n            const osc = this.audioContext.createOscillator();\n            const gain = this.audioContext.createGain();\n            const filter = this.audioContext.createBiquadFilter();\n            \n            osc.type = 'sawtooth';\n            osc.frequency.setValueAtTime(80, this.audioContext.currentTime);\n            osc.frequency.exponentialRampToValueAtTime(120, this.audioContext.currentTime + 0.1);\n            \n            filter.type = 'lowpass';\n            filter.frequency.value = 200;\n            \n            gain.gain.setValueAtTime(0, this.audioContext.currentTime);\n            gain.gain.linearRampToValueAtTime(0.05, this.audioContext.currentTime + 0.05);\n            \n            osc.connect(filter);\n            filter.connect(gain);\n            gain.connect(this.sfxGain);\n            \n            osc.start();\n            \n            return { stop: () => {\n                gain.gain.exponentialRampToValueAtTime(0.001, this.audioContext.currentTime + 0.1);\n                setTimeout(() => osc.stop(), 100);\n            }};\n        };\n    }\n\n    createSwapSound() {\n        return () => {\n            if (!this.audioContext) return;\n            const now = this.audioContext.currentTime;\n            \n            const osc1 = this.audioContext.createOscillator();\n            const osc2 = this.audioContext.createOscillator();\n            const gain = this.audioContext.createGain();\n            const filter = this.audioContext.createBiquadFilter();\n            \n            osc1.type = 'sine';\n            osc1.frequency.setValueAtTime(220, now);\n            osc1.frequency.exponentialRampToValueAtTime(440, now + 0.3);\n            \n            osc2.type = 'triangle';\n            osc2.frequency.setValueAtTime(110, now);\n            osc2.frequency.exponentialRampToValueAtTime(880, now + 0.4);\n            \n            filter.type = 'bandpass';\n            filter.frequency.value = 500;\n            filter.Q.value = 10;\n            \n            gain.gain.setValueAtTime(0.15, now);\n            gain.gain.exponentialRampToValueAtTime(0.001, now + 0.5);\n            \n            osc1.connect(filter);\n            osc2.connect(filter);\n            filter.connect(gain);\n            gain.connect(this.sfxGain);\n            \n            osc1.start(now);\n            osc2.start(now);\n            osc1.stop(now + 0.5);\n            osc2.stop(now + 0.5);\n        };\n    }\n\n    createCrashSound() {\n        return () => {\n            if (!this.audioContext) return;\n            const now = this.audioContext.currentTime;\n            \n            const osc = this.audioContext.createOscillator();\n            const gain = this.audioContext.createGain();\n            const noise = this.createNoiseBuffer(0.3);\n            const noiseSource = this.audioContext.createBufferSource();\n            const noiseGain = this.audioContext.createGain();\n            \n            osc.type = 'square';\n            osc.frequency.setValueAtTime(150, now);\n            osc.frequency.exponentialRampToValueAtTime(50, now + 0.3);\n            \n            gain.gain.setValueAtTime(0.2, now);\n            gain.gain.exponentialRampToValueAtTime(0.001, now + 0.4);\n            \n            noiseSource.buffer = noise;\n            noiseGain.gain.setValueAtTime(0.1, now);\n            noiseGain.gain.exponentialRamp(0.001, now + 0.4);\n            \n            osc.connect(gain);\n            gain.connect(this.sfxGain);\n            \n            noiseSource.connect(noiseGain);\n            noiseGain.connect(this.sfxGain);\n            \n            osc.start(now);\n            noiseSource.start(now);\n            osc.stop(now + 0.4);\n            noiseSource.stop(now + 0.4);\n        };\n    }\n\n    createWormholeSound() {\n        return () => {\n            if (!this.audioContext) return;\n            const now = this.audioContext.currentTime;\n            \n            const osc = this.audioContext.createOscillator();\n            const gain = this.audioContext.createGain();\n            const filter = this.audioContext.createBiquadFilter();\n            \n            osc.type = 'sine';\n            osc.frequency.setValueAtTime(100, now);\n            osc.frequency.exponentialRampToValueAtTime(800, now + 0.2);\n            osc.frequency.exponentialRampToValueAtTime(200, now + 0.8);\n            \n            filter.type = 'lowpass';\n            filter.frequency.setValueAtTime(2000, now);\n            filter.frequency.exponentialRampToValueAtTime(200, now + 0.8);\n            \n            gain.gain.setValueAtTime(0.1, now);\n            gain.gain.exponentialRampToValueAtTime(0.001, now + 1);\n            \n            osc.connect(filter);\n            filter.connect(gain);\n            gain.connect(this.sfxGain);\n            \n            osc.start(now);\n            osc.stop(now + 1);\n        };\n    }\n\n    createUIClickSound() {\n        return () => {\n            if (!this.audioContext) return;\n            const now = this.audioContext.currentTime;\n            \n            const osc = this.audioContext.createOscillator();\n            const gain = this.audioContext.createGain();\n            \n            osc.type = 'square';\n            osc.frequency.value = 800;\n            \n            gain.gain.setValueAtTime(0.05, now);\n            gain.gain.exponentialRampToValueAtTime(0.001, now + 0.1);\n            \n            osc.connect(gain);\n            gain.connect(this.sfxGain);\n            \n            osc.start(now);\n            osc.stop(now + 0.1);\n        };\n    }\n\n    createCheckpointSound() {\n        return () => {\n            if (!this.audioContext) return;\n            const now = this.audioContext.currentTime;\n            \n            [523.25, 659.25, 783.99].forEach((freq, i) => {\n                const osc = this.audioContext.createOscillator();\n                const gain = this.audioContext.createGain();\n                \n                osc.type = 'sine';\n                osc.frequency.value = freq;\n                \n                gain.gain.setValueAtTime(0, now + i * 0.1);\n                gain.gain.linearRampToValueAtTime(0.1, now + i * 0.1 + 0.05);\n                gain.gain.exponentialRampToValueAtTime(0.001, now + i * 0.1 + 0.3);\n                \n                osc.connect(gain);\n                gain.connect(this.sfxGain);\n                \n                osc.start(now + i * 0.1);\n                osc.stop(now + i * 0.1 + 0.4);\n            });\n        };\n    }\n\n    createFuelLowSound() {\n        return () => {\n            if (!this.audioContext) return;\n            const now = this.audioContext.currentTime;\n            \n            const osc = this.audioContext.createOscillator();\n            const gain = this.audioContext.createGain();\n            \n            osc.type = 'square';\n            osc.frequency.setValueAtTime(200, now);\n            osc.frequency.setValueAtTime(150, now + 0.2);\n            \n            gain.gain.setValueAtTime(0.08, now);\n            gain.gain.setValueAtTime(0, now + 0.1);\n            gain.gain.setValueAtTime(0.08, now + 0.2);\n            gain.gain.exponentialRampToValueAtTime(0.001, now + 0.4);\n            \n            osc.connect(gain);\n            gain.connect(this.sfxGain);\n            \n            osc.start(now);\n            osc.stop(now + 0.4);\n        };\n    }\n\n    createNoiseBuffer(duration) {\n        const sampleRate = this.audioContext.sampleRate;\n        const length = sampleRate * duration;\n        const buffer = this.audioContext.createBuffer(1, length, sampleRate);\n        const data = buffer.getChannelData(0);\n        \n        for (let i = 0; i < length; i++) {\n            data[i] = Math.random() * 2 - 1;\n        }\n        \n        return buffer;\n    }\n\n    playSound(name) {\n        if (this.isMuted || !this.sounds[name] || !this.audioContext) return;\n        if (this.audioContext.state === 'suspended') {\n            this.audioContext.resume();\n        }\n        return this.sounds[name]();\n    }\n\n    playMusic() {\n        if (this.isMuted || !this.audioContext) return;\n        \n        const now = this.audioContext.currentTime;\n        \n        const playNote = (freq, startTime, duration, type = 'sine', gainVal = 0.02) => {\n            const osc = this.audioContext.createOscillator();\n            const gain = this.audioContext.createGain();\n            \n            osc.type = type;\n            osc.frequency.value = freq;\n            \n            gain.gain.setValueAtTime(0, startTime);\n            gain.gain.linearRampToValueAtTime(gainVal, startTime + 0.1);\n            gain.gain.exponentialRampToValueAtTime(0.001, startTime + duration);\n            \n            osc.connect(gain);\n            gain.connect(this.musicGain);\n            \n            osc.start(startTime);\n            osc.stop(startTime + duration);\n        };\n        \n        const scheduleLoop = (time) => {\n            const notes = [\n                { freq: 110, dur: 2, type: 'sine' },\n                { freq: 146.83, dur: 2, type: 'sine' },\n                { freq: 164.81, dur: 2, type: 'sine' },\n                { freq: 220, dur: 4, type: 'triangle' }\n            ];\n            \n            let noteTime = time;\n            notes.forEach(note => {\n                playNote(note.freq, noteTime, note.dur, note.type);\n                noteTime += note.dur;\n            });\n            \n            this.musicTimeout = setTimeout(() => scheduleLoop(this.audioContext.currentTime), noteTime * 1000);\n        };\n        \n        scheduleLoop(now);\n    }\n\n    stopMusic() {\n        if (this.musicTimeout) {\n            clearTimeout(this.musicTimeout);\n            this.musicTimeout = null;\n        }\n    }\n\n    setMasterVolume(value) {\n        if (this.masterGain) this.masterGain.gain.value = Math.max(0, Math.min(1, value));\n    }\n\n    setMusicVolume(value) {\n        if (this.musicGain) this.musicGain.gain.value = Math.max(0, Math.min(1, value));\n    }\n\n    setSFXVolume(value) {\n        if (this.sfxGain) this.sfxGain.gain.value = Math.max(0, Math.min(1, value));\n    }\n\n    toggleMute() {\n        this.isMuted = !this.isMuted;\n        if (this.masterGain) this.masterGain.gain.value = this.isMuted ? 0 : 0.3;\n        return this.isMuted;\n    }\n\n    pauseAll() {\n        if (this.audioContext && this.audioContext.state === 'running') {\n            this.audioContext.suspend();\n        }\n    }\n\n    resumeAll() {\n        if (this.audioContext && this.audioContext.state === 'suspended') {\n            this.audioContext.resume();\n        }\n    }\n}", "src/js/engine/AssetLoader.js": "export class AssetLoader {\n    constructor() {\n        this.assets = {};\n        this.loadQueue = [];\n    }\n\n    async load() {\n        this.loadQueue = [\n            { name: 'planetTexture', type: 'image', src: 'data:image/svg+xml,<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 256 256\"><defs><radialGradient id=\"g\" cx=\"40%\" cy=\"40%\" r=\"60%\"><stop offset=\"0%\" stop-color=\"%234488ff\"/><stop offset=\"100%\" stop-color=\"%23112266\"/></radialGradient></defs><circle cx=\"128\" cy=\"128\" r=\"128\" fill=\"url(%23g)\"/><circle cx=\"128\" cy=\"128\" r=\"120\" fill=\"none\" stroke=\"%2366aaff\" stroke-width=\"2\" opacity=\"0.5\"/></svg>' },\n            { name: 'planetTexture2', type: 'image', src: 'data:image/svg+xml,<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 256 256\"><defs><radialGradient id=\"g\" cx=\"40%\" cy=\"40%\" r=\"60%\"><stop offset=\"0%\" stop-color=\"%23ff4466\"/><stop offset=\"100%\" stop-color=\"%23661122\"/></radialGradient></defs><circle cx=\"128\" cy=\"128\" r=\"128\" fill=\"url(%23g)\"/><ellipse cx=\"128\" cy=\"128\" rx=\"100\" ry=\"20\" fill=\"%23ff6688\" opacity=\"0.3\"/></svg>' },\n            { name: 'planetTexture3', type: 'image', src: 'data:image/svg+xml,<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 256 256\"><defs><radialGradient id=\"g\" cx=\"40%\" cy=\"40%\" r=\"60%\"><stop offset=\"0%\" stop-color=\"%2344ff88\"/><stop offset=\"100%\" stop-color=\"%23116633\"/></radialGradient></defs><circle cx=\"128\" cy=\"128\" r=\"128\" fill=\"url(%23g)\"/><path d=\"M80,128 Q128,80 176,128 Q128,176 80,128\" fill=\"%2366ffaa\" opacity=\"0.3\"/></svg>' },\n            { name: 'planetTexture4', type: 'image', src: 'data:image/svg+xml,<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 256 256\"><defs><radialGradient id=\"g\" cx=\"40%\" cy=\"40%\" r=\"60%\"><stop offset=\"0%\" stop-color=\"%23ffaa00\"/><stop offset=\"100%\" stop-color=\"%23664400\"/></radialGradient></defs><circle cx=\"128\" cy=\"128\" r=\"128\" fill=\"url(%23g)\"/><circle cx=\"128\" cy=\"128\" r=\"80\" fill=\"none\" stroke=\"%23ffcc00\" stroke-width=\"4\" opacity=\"0.4\"/></svg>' },\n            { name: 'wormholeTexture', type: 'image', src: 'data:image/svg+xml,<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 256 256\"><defs><radialGradient id=\"w\" cx=\"50%\" cy=\"50%\" r=\"50%\"><stop offset=\"0%\" stop-color=\"%23ffffff\"/><stop offset=\"30%\" stop-color=\"%2300ffff\"/><stop offset=\"70%\" stop-color=\"%23ff0066\"/><stop offset=\"100%\" stop-color=\"%23000033\"/></radialGradient></defs><circle cx=\"128\" cy=\"128\" r=\"128\" fill=\"url(%23w)\"/></svg>' },\n            { name: 'shipTexture', type: 'image', src: 'data:image/svg+xml,<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 64 64\"><polygon points=\"32,4 56,60 32,50 8,60\" fill=\"%2300ffff\" stroke=\"%23ffffff\" stroke-width=\"1.5\"/><polygon points=\"32,16 44,44 32,38 20,44\" fill=\"%230088ff\"/></svg>' },\n            { name: 'particleTexture', type: 'image', src: 'data:image/svg+xml,<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 16 16\"><circle cx=\"8\" cy=\"8\" r=\"8\" fill=\"%2300ffff\"/></svg>' },\n            { name: 'fuelTexture', type: 'image', src: 'data:image/svg+xml,<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 32 32\"><rect x=\"8\" y=\"4\" width=\"16\" height=\"24\" rx=\"2\" fill=\"%23113355\" stroke=\"%2300ffff\" stroke-width=\"1\"/><rect x=\"10\" y=\"6\" width=\"12\" height=\"20\" fill=\"%2300ffff\" opacity=\"0.8\"/></svg>' },\n            { name: 'checkpointTexture', type: 'image', src: 'data:image/svg+xml,<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 64 64\"><circle cx=\"32\" cy=\"32\" r=\"28\" fill=\"none\" stroke=\"%2300ff88\" stroke-width=\"3\"/><path d=\"M20,32 L28,40 L44,20\" fill=\"none\" stroke=\"%2300ff88\" stroke-width=\"4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>' }\n        ];\n\n        const promises = this.loadQueue.map(asset => this.loadAsset(asset));\n        await Promise.all(promises);\n    }\n\n    loadAsset(asset) {\n        return new Promise((resolve, reject) => {\n            if (asset.type === 'image') {\n                const img = new Image();\n                img.onload = () => {\n                    this.assets[asset.name] = img;\n                    resolve();\n                };\n                img.onerror = () => reject(new Error(`Failed to load ${asset.name}`));\n                img.src = asset.src;\n            }\n        });\n    }\n\n    get(name) {\n        return this.assets[name];\n    }\n}", "src/js/game/Game.js": "import { Camera } from '../engine/Camera.js';\nimport { Ship } from './entities/Ship.js';\nimport { Planet } from './entities/Planet.js';\nimport { Wormhole } from './entities/Wormhole.js';\nimport { ParticleSystem } from './systems/ParticleSystem.js';\nimport { LevelManager } from './systems/LevelManager.js';\nimport { UIManager } from './systems/UIManager.js';\nimport { InputManager } from '../engine/InputManager.js';\nimport { AudioManager } from '../engine/AudioManager.js';\n\nexport class Game {\n    constructor(canvas, ctx, input, audio) {\n        this.canvas = canvas;\n        this.ctx = ctx;\n        this.input = input;\n        this.audio = audio;\n        \n        this.worldBounds = { left: -5000, right: 5000, top: -5000, bottom: 5000 };\n        this.camera = new Camera(canvas.width, canvas.height, this.worldBounds);\n        \n        this.ship = null;\n        this.planets = [];\n        this.wormholes = [];\n        this.particles = new ParticleSystem();\n        this.levelManager = new LevelManager(this);\n        this.ui = new UIManager(this);\n        \n        this.currentLevel = 0;\n        this.gameState = 'playing';\n        this.isPaused = false;\n        \n        this.gravityConstant = 0.3;\n        this.swapCooldown = 0;\n        this.maxSwapCooldown = 2.0;\n        this.swapCharges = 3;\n        this.maxSwapCharges = 3;\n        \n        this.timeScale = 1;\n        this.levelStartTime = 0;\n        this.totalTime = 0;\n        \n        this.thrustSound = null;\n        this.fuelWarningPlayed = false;\n    }\n\n    async init() {\n        this.levelManager.generateLevel(0);\n        this.levelStartTime = performance.now();\n        this.audio.playMusic();\n    }\n\n    onResize(width, height) {\n        this.camera.onResize(width, height);\n        this.ui.onResize(width, height);\n    }\n\n    update(dt) {\n        if (this.isPaused) return;\n\n        dt *= this.timeScale;\n        this.totalTime += dt;\n\n        this.input.updateWorldMouse(this.camera);\n\n        if (this.input.isKeyPressed('Escape')) {\n            this.togglePause();\n        }\n\n        if (this.gameState === 'playing') {\n            this.updateShip(dt);\n            this.updatePlanets(dt);\n            this.updateWormholes(dt);\n            this.updateSwapCooldown(dt);\n            this.checkCollisions();\n            this.checkWinCondition();\n            this.camera.setTarget(this.ship.x, this.ship.y);\n        }\n\n        this.camera.update(dt);\n        this.particles.update(dt);\n        this.ui.update(dt);\n        this.input.clearFrame();\n    }\n\n    updateShip(dt) {\n        const thrust = this.input.getThrustInput();\n        const rotation = this.input.getRotationInput();\n        \n        this.ship.update(dt, thrust, rotation, this.planets, this.gravityConstant);\n        \n        if (thrust !== 0) {\n            if (!this.thrustSound) {\n                this.thrustSound = this.audio.playSound('thrust');\n            }\n            this.particles.emitThruster(this.ship.x, this.ship.y, this.ship.rotation, thrust > 0);\n        } else {\n            if (this.thrustSound) {\n                this.thrustSound.stop();\n                this.thrustSound = null;\n            }\n        }\n\n        if (this.input.isKeyPressed('Space') || this.input.mouse.rightPressed) {\n            this.attemptSwap();\n        }\n\n        if (this.ship.fuel < 15 && !this.fuelWarningPlayed) {\n            this.audio.playSound('fuelLow');\n            this.fuelWarningPlayed = true;\n        } else if (this.ship.fuel >= 15) {\n            this.fuelWarningPlayed = false;\n        }\n    }\n\n    updatePlanets(dt) {\n        this.planets.forEach(planet => planet.update(dt));\n    }\n\n    updateWormholes(dt) {\n        this.wormholes.forEach(wormhole => wormhole.update(dt));\n    }\n\n    updateSwapCooldown(dt) {\n        if (this.swapCooldown > 0) {\n            this.swapCooldown = Math.max(0, this.swapCooldown - dt);\n        }\n        \n        if (this.swapCharges < this.maxSwapCharges && this.swapCooldown === 0) {\n            this.swapCharges = Math.min(this.maxSwapCharges, this.swapCharges + dt * 0.5);\n            if (this.swapCharges >= 1) {\n                this.swapCharges = Math.floor(this.swapCharges);\n            }\n        }\n    }\n\n    attemptSwap() {\n        if (this.swapCooldown > 0 || this.swapCharges < 1) return;\n\n        const nearestPlanet = this.findNearestPlanet();\n        if (!nearestPlanet) return;\n\n        const dx = nearestPlanet.x - this.ship.x;\n        const dy = nearestPlanet.y - this.ship.y;\n        const dist = Math.sqrt(dx * dx + dy * dy);\n\n        if (dist > nearestPlanet.radius + 100) return;\n\n        this.performSwap(nearestPlanet);\n    }\n\n    findNearestPlanet() {\n        let nearest = null;\n        let minDist = Infinity;\n\n        this.planets.forEach(planet => {\n            const dx = planet.x - this.ship.x;\n            const dy = planet.y - this.ship.y;\n            const dist = Math.sqrt(dx * dx + dy * dy);\n            if (dist < minDist) {\n                minDist = dist;\n                nearest = planet;\n            }\n        });\n\n        return nearest;\n    }\n\n    performSwap(planet) {\n        const oldX = this.ship.x;\n        const oldY = this.ship.y;\n        const oldVx = this.ship.vx;\n        const oldVy = this.ship.vy;\n\n        this.ship.x = planet.x;\n        this.ship.y = planet.y;\n        this.ship.vx = planet.vx;\n        this.ship.vy = planet.vy;\n\n        planet.x = oldX;\n        planet.y = oldY;\n        planet.vx = oldVx;\n        planet.vy = oldVy;\n\n        this.swapCooldown = this.maxSwapCooldown;\n        this.swapCharges--;\n\n        this.audio.playSound('swap');\n        this.camera.shake(10);\n        this.particles.emitSwap(oldX, oldY, planet.x, planet.y);\n    }\n\n    checkCollisions() {\n        this.planets.forEach(planet => {\n            const dx = this.ship.x - planet.x;\n            const dy = this.ship.y - planet.y;\n            const dist = Math.sqrt(dx * dx + dy * dy);\n            const minDist = this.ship.radius + planet.radius;\n\n            if (dist < minDist) {\n                const overlap = minDist - dist;\n                const nx = dx / dist || 1;\n                const ny = dy / dist || 0;\n\n                this.ship.x += nx * overlap * 0.5;\n                this.ship.y += ny * overlap * 0.5;\n                planet.x -= nx * overlap * 0.5;\n                planet.y -= ny * overlap * 0.5;\n\n                const rvx = this.ship.vx - planet.vx;\n                const rvy = this.ship.vy - planet.vy;\n                const velAlongNormal = rvx * nx + rvy * ny;\n\n                if (velAlongNormal > 0) return;\n\n                const e = 0.3;\n                const j = -(1 + e) * velAlongNormal;\n                const jOverMass = j / (this.ship.mass + planet.mass);\n\n                this.ship.vx += nx * jOverMass * this.ship.mass;\n                this.ship.vy += ny * jOverMass * this.ship.mass;\n                planet.vx -= nx * jOverMass * planet.mass;\n                planet.vy -= ny * jOverMass * planet.mass;\n\n                if (velAlongNormal < -5) {\n                    this.audio.playSound('crash');\n                    this.camera.shake(20);\n                    this.particles.emitCrash(this.ship.x, this.ship.y);\n                    this.ship.takeDamage(10);\n                }\n            }\n        });\n\n        this.wormholes.forEach(wormhole => {\n            const dx = this.ship.x - wormhole.x;\n            const dy = this.ship.y - wormhole.y;\n            const dist = Math.sqrt(dx * dx + dy * dy);\n\n            if (dist < wormhole.radius + this.ship.radius) {\n                this.triggerWormhole(wormhole);\n            }\n        });\n\n        this.planets.forEach((planet, i) => {\n            this.planets.slice(i + 1).forEach(other => {\n                const dx = planet.x - other.x;\n                const dy = planet.y - other.y;\n                const dist = Math.sqrt(dx * dx + dy * dy);\n                const minDist = planet.radius + other.radius;\n\n                if (dist < minDist) {\n                    const overlap = minDist - dist;\n                    const nx = dx / dist || 1;\n                    const ny = dy / dist || 0;\n\n                    planet.x += nx * overlap * 0.5;\n                    planet.y += ny * overlap * 0.5;\n                    other.x -= nx * overlap * 0.5;\n                    other.y -= ny * overlap * 0.5;\n                }\n            });\n        });\n    }\n\n    triggerWormhole(wormhole) {\n        this.audio.playSound('wormhole');\n        this.camera.shake(30);\n        this.particles.emitWormhole(wormhole.x, wormhole.y);\n        \n        setTimeout(() => {\n            this.levelComplete();\n        }, 500);\n    }\n\n    checkWinCondition() {\n        if (this.ship.health <= 0) {\n            this.gameOver();\n        }\n    }\n\n    levelComplete() {\n        this.gameState = 'levelComplete';\n        this.audio.playSound('checkpoint');\n        this.audio.stopMusic();\n        this.ui.showLevelComplete(this.currentLevel, this.totalTime);\n    }\n\n    gameOver() {\n        this.gameState = 'gameOver';\n        this.audio.stopMusic();\n        this.ui.showGameOver();\n    }\n\n    togglePause() {\n        this.isPaused = !this.isPaused;\n        this.ui.togglePauseMenu(this.isPaused);\n        if (this.isPaused) {\n            this.audio.pauseAll();\n        } else {\n            this.audio.resumeAll();\n        }\n    }\n\n    restartLevel() {\n        this.levelManager.generateLevel(this.currentLevel);\n        this.levelStartTime = performance.now();\n        this.totalTime = 0;\n        this.gameState = 'playing';\n        this.isPaused = false;\n        this.ui.hideMenus();\n        this.audio.playMusic();\n    }\n\n    nextLevel() {\n        this.currentLevel++;\n        this.levelManager.generateLevel(this.currentLevel);\n        this.levelStartTime = performance.now();\n        this.totalTime = 0;\n        this.gameState = 'playing';\n        this.isPaused = false;\n        this.ui.hideMenus();\n        this.audio.playMusic();\n    }\n\n    render(alpha) {\n        this.ctx.clearRect(0, 0, this.canvas.width, this.canvas.height);\n        \n        this.ctx.fillStyle = '#050510';\n        this.ctx.fillRect(0, 0, this.canvas.width, this.canvas.height);\n\n        this.camera.applyTransform(this.ctx);\n\n        this.renderBackground();\n        this.wormholes.forEach(w => w.render(this.ctx, this.camera));\n        this.planets.forEach(p => p.render(this.ctx, this.camera, this));\n        this.ship.render(this.ctx, this.camera);\n        this.particles.render(this.ctx, this.camera);\n\n        this.camera.resetTransform(this.ctx);\n\n        this.ui.render(this.ctx, alpha);\n    }\n\n    renderBackground() {\n        const halfWidth = this.camera.canvasWidth / (2 * this.camera.zoom);\n        const halfHeight = this.camera.cameraHeight / (2 * this.camera.zoom);\n        \n        this.ctx.save();\n        this.ctx.globalAlpha = 0.1;\n        \n        const gridSize = 200;\n        const startX = Math.floor((this.camera.x - halfWidth) / gridSize) * gridSize;\n        const startY = Math.floor((this.camera.y - halfHeight) / gridSize) * gridSize;\n        const endX = this.camera.x + halfWidth;\n        const endY = this.camera.y + halfHeight;\n\n        this.ctx.strokeStyle = '#00ffff';\n        this.ctx.lineWidth = 0.5;\n\n        for (let x = startX; x <= endX; x += gridSize) {\n            this.ctx.beginPath();\n            this.ctx.moveTo(x, startY);\n            this.ctx.lineTo(x, endY);\n            this.ctx.stroke();\n        }\n\n        for (let y = startY; y <= endY; y += gridSize) {\n            this.ctx.beginPath();\n            this.ctx.moveTo(startX, y);\n            this.ctx.lineTo(endX, y);\n            this.ctx.stroke();\n        }\n\n        this.ctx.restore();\n    }\n}", "src/js/game/entities/Ship.js": "export class Ship {\n    constructor(x, y) {\n        this.x = x;\n        this.y = y;\n        this.vx = 0;\n        this.vy = 0;\n        this.rotation = -Math.PI / 2;\n        this.radius = 16;\n        this.mass = 1;\n        \n        this.maxSpeed = 300;\n        this.thrustPower = 400;\n        this.rotationSpeed = 3;\n        \n        this.fuel = 100;\n        this.maxFuel = 100;\n        this.fuelConsumption = 15;\n        \n        this.health = 100;\n        this.maxHealth = 100;\n        \n        this.trail = [];\n        this.maxTrailLength = 20;\n    }\n\n    update(dt, thrust, rotation, planets, gravityConstant) {\n        if (rotation !== 0) {\n            this.rotation += rotation * this.rotationSpeed * dt;\n        }\n\n        if (thrust !== 0 && this.fuel > 0) {\n            const thrustX = Math.cos(this.rotation) * this.thrustPower * thrust;\n            const thrustY = Math.sin(this.rotation) * this.thrustPower * thrust;\n            \n            this.vx += thrustX * dt;\n            this.vy += thrustY * dt;\n            \n            this.fuel = Math.max(0, this.fuel - this.fuelConsumption * dt * Math.abs(thrust));\n        }\n\n        planets.forEach(planet => {\n            const dx = planet.x - this.x;\n            const dy = planet.y - this.y;\n            const distSq = dx * dx + dy * dy;\n            const dist = Math.sqrt(distSq);\n            \n            if (dist > planet.radius) {\n                const force = (gravityConstant * planet.mass) / distSq;\n                const fx = (dx / dist) * force;\n                const fy = (dy / dist) * force;\n                \n                this.vx += fx * dt;\n                this.vy += fy * dt;\n            }\n        });\n\n        const speed = Math.sqrt(this.vx * this.vx + this.vy * this.vy);\n        if (speed > this.maxSpeed) {\n            this.vx = (this.vx / speed) * this.maxSpeed;\n            this.vy = (this.vy / speed) * this.maxSpeed;\n        }\n\n