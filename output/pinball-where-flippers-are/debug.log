  "styles.css": "* {\n    margin: 0;\n    padding: 0;\n    box-sizing: border-box;\n}\n\n:root {\n    --bg: #0a0a12;\n    --fg: #f0f0ff;\n    --neon-pink: #ff006e;\n    --neon-blue: #00f3ff;\n    --neon-green: #39ff14;\n    --neon-purple: #bc13fe;\n    --neon-orange: #ff6b00;\n    --card: #12121f;\n    --border: #2a2a3e;\n}\n\nbody {\n    background: var(--bg);\n    color: var(--fg);\n    font-family: 'JetBrains Mono', 'Fira Code', monospace;\n    min-height: 100vh;\n    display: flex;\n    justify-content: center;\n    align-items: center;\n    overflow: hidden;\n    touch-action: none;\n}\n\nbody::before {\n    content: '';\n    position: fixed;\n    inset: 0;\n    background: \n        radial-gradient(ellipse 80% 50% at 50% 0%, rgba(255,0,110,0.15) 0%, transparent 50%),\n        radial-gradient(ellipse 60% 40% at 100% 100%, rgba(0,243,255,0.1) 0%, transparent 50%),\n        radial-gradient(ellipse 50% 30% at 0% 50%, rgba(188,19,254,0.1) 0%, transparent 50%);\n    pointer-events: none;\n    z-index: -1;\n}\n\n.game-container {\n    width: 100%;\n    max-width: 900px;\n    height: 100vh;\n    max-height: 900px;\n    display: flex;\n    flex-direction: column;\n    position: relative;\n}\n\n.ui-top {\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    padding: 12px 20px;\n    flex-shrink: 0;\n}\n\n.timer {\n    font-size: 1.4rem;\n    font-weight: 700;\n    font-variant-numeric: tabular-nums;\n    color: var(--neon-green);\n    text-shadow: 0 0 10px var(--neon-green), 0 0 20px var(--neon-green);\n    letter-spacing: 2px;\n    background: rgba(0,0,0,0.5);\n    padding: 6px 16px;\n    border-radius: 8px;\n    border: 1px solid var(--neon-green);\n    box-shadow: inset 0 0 10px rgba(57,255,20,0.2);\n}\n\n.score-panel {\n    display: flex;\n    gap: 24px;\n    font-size: 0.9rem;\n}\n\n.score-panel span {\n    background: rgba(0,0,0,0.5);\n    padding: 6px 12px;\n    border-radius: 6px;\n    border: 1px solid var(--border);\n}\n\n.score-panel span:first-child {\n    color: var(--neon-orange);\n    border-color: var(--neon-orange);\n}\n\n.score-panel span:last-child {\n    color: var(--neon-pink);\n    border-color: var(--neon-pink);\n}\n\n#gameCanvas {\n    flex: 1;\n    width: 100%;\n    height: 100%;\n    display: block;\n    background: #05050a;\n    border-radius: 0 0 12px 12px;\n    box-shadow: \n        0 0 40px rgba(255,0,110,0.2),\n        inset 0 0 60px rgba(0,0,0,0.5);\n}\n\n.ui-bottom {\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    padding: 16px 20px;\n    flex-shrink: 0;\n}\n\n.controls-hint {\n    font-size: 0.8rem;\n    color: var(--neon-blue);\n    opacity: 0.7;\n    letter-spacing: 1px;\n    animation: pulse 2s ease-in-out infinite;\n}\n\n@keyframes pulse {\n    0%, 100% { opacity: 0.5; }\n    50% { opacity: 1; }\n}\n\n.btn-restart, .btn-start, #playAgainBtn {\n    background: transparent;\n    border: 2px solid var(--neon-pink);\n    color: var(--neon-pink);\n    padding: 12px 32px;\n    font-family: inherit;\n    font-size: 1rem;\n    font-weight: 700;\n    letter-spacing: 2px;\n    text-transform: uppercase;\n    cursor: pointer;\n    border-radius: 8px;\n    transition: all 0.2s ease;\n    box-shadow: 0 0 20px rgba(255,0,110,0.3);\n}\n\n.btn-restart:hover, .btn-start:hover, #playAgainBtn:hover {\n    background: var(--neon-pink);\n    color: var(--bg);\n    box-shadow: 0 0 30px rgba(255,0,110,0.6), 0 0 60px rgba(255,0,110,0.3);\n    transform: scale(1.02);\n}\n\n.btn-restart:active, .btn-start:active, #playAgainBtn:active {\n    transform: scale(0.98);\n}\n\n.overlay {\n    position: absolute;\n    inset: 0;\n    background: rgba(10,10,18,0.95);\n    display: flex;\n    flex-direction: column;\n    justify-content: center;\n    align-items: center;\n    gap: 24px;\n    z-index: 10;\n    border-radius: 12px;\n    backdrop-filter: blur(10px);\n}\n\n.overlay.hidden {\n    display: none;\n}\n\n.overlay h1 {\n    font-size: clamp(2.5rem, 8vw, 4rem);\n    font-weight: 800;\n    background: linear-gradient(135deg, var(--neon-pink), var(--neon-blue), var(--neon-green));\n    -webkit-background-clip: text;\n    -webkit-text-fill-color: transparent;\n    background-clip: text;\n    text-shadow: none;\n    letter-spacing: 4px;\n    animation: glow 3s ease-in-out infinite;\n}\n\n@keyframes glow {\n    0%, 100% { filter: drop-shadow(0 0 10px var(--neon-pink)); }\n    33% { filter: drop-shadow(0 0 10px var(--neon-blue)); }\n    66% { filter: drop-shadow(0 0 10px var(--neon-green)); }\n}\n\n.subtitle {\n    color: var(--neon-blue);\n    font-size: 1.2rem;\n    letter-spacing: 8px;\n    text-transform: uppercase;\n    font-weight: 400;\n}\n\n.instructions {\n    display: flex;\n    flex-direction: column;\n    gap: 8px;\n    margin-top: 16px;\n    font-size: 0.85rem;\n    color: #888;\n}\n\n.instructions kbd {\n    background: var(--card);\n    border: 1px solid var(--border);\n    padding: 2px 8px;\n    border-radius: 4px;\n    color: var(--neon-green);\n    font-family: inherit;\n}\n\n.final-stats {\n    display: flex;\n    gap: 32px;\n    margin: 16px 0;\n}\n\n.stat {\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    gap: 4px;\n    background: rgba(0,0,0,0.5);\n    padding: 16px 32px;\n    border-radius: 12px;\n    border: 1px solid var(--border);\n    min-width: 120px;\n}\n\n.stat .label {\n    font-size: 0.7rem;\n    text-transform: uppercase;\n    letter-spacing: 2px;\n    color: #888;\n}\n\n.stat .value {\n    font-size: 1.5rem;\n    font-weight: 700;\n    font-variant-numeric: tabular-nums;\n}\n\n.stat:nth-child(1) .value { color: var(--neon-green); }\n.stat:nth-child(2) .value { color: var(--neon-orange); }\n.stat:nth-child(3) .value { color: var(--neon-pink); }\n\n@media (max-width: 600px) {\n    .ui-top { padding: 8px 12px; flex-wrap: wrap; gap: 8px; }\n    .timer { font-size: 1.1rem; padding: 4px 12px; }\n    .score-panel { gap: 12px; font-size: 0.8rem; }\n    .ui-bottom