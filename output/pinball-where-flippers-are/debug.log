  "game.js": "const canvas = document.getElementById('gameCanvas');\nconst ctx = canvas.getContext('2d');\n\nconst timerEl = document.getElementById('timer');\nconst scoreEl = document.getElementById('score');\nconst highScoreEl = document.getElementById('highScore');\nconst startOverlay = document.getElementById('startOverlay');\nconst gameOverOverlay = document.getElementById('gameOverOverlay');\nconst startBtn = document.getElementById('startBtn');\nconst restartBtn = document.getElementById('restartBtn');\nconst playAgainBtn = document.getElementById('playAgainBtn');\nconst controlsHint = document.getElementById('controlsHint');\nconst finalTimeEl = document.getElementById('finalTime');\nconst finalScoreEl = document.getElementById('finalScore');\nconst finalBestEl = document.getElementById('finalBest');\n\nconst COLORS = {\n    bg: '#05050a',\n    ground: '#0d0d1a',\n    player: '#00f3ff',\n    playerGlow: '#00f3ff',\n    platform: '#1a1a2e',\n    platformEdge: '#ff006e',\n    spike: '#ff6b00',\n    spikeGlow: '#ff6b00',\n    coin: '#ffd700',\n    coinGlow: '#ffd700',\n    particle: ['#ff006e', '#00f3ff', '#39ff14', '#bc13fe', '#ff6b00'],\n    text: '#f0f0ff',\n    grid: '#1a1a2e'\n};\n\nlet highScore = parseInt(localStorage.getItem('neonVelocityHighScore')) || 0;\nhighScoreEl.textContent = highScore;\nfinalBestEl.textContent = highScore;\n\nconst audioCtx = new (window.AudioContext || window.webkitAudioContext)();\n\nfunction createOscillator(frequency, type, duration, volume = 0.1, freqEnd = null) {\n    if (audioCtx.state === 'suspended') audioCtx.resume();\n    const osc = audioCtx.createOscillator();\n    const gain = audioCtx.createGain();\n    osc.type = type;\n    osc.frequency.value = frequency;\n    if (freqEnd) {\n        osc.frequency.exponentialRampToValueAtTime(freqEnd, audioCtx.currentTime + duration);\n    }\n    gain.gain.setValueAtTime(volume, audioCtx.currentTime);\n    gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + duration);\n    osc.connect(gain);\n    gain.connect(audioCtx.destination);\n    osc.start();\n    osc.stop(audioCtx.currentTime + duration);\n}\n\nfunction playJumpSound() {\n    createOscillator(400, 'square', 0.1, 0.08, 800);\n    createOscillator(200, 'triangle', 0.15, 0.05, 50);\n}\n\nfunction playDoubleJumpSound() {\n    createOscillator(600, 'square', 0.08, 0.06, 1200);\n    createOscillator(300, 'sawtooth', 0.1, 0.04, 100);\n}\n\nfunction playCoinSound() {\n    createOscillator(800, 'sine', 0.1, 0.08, 1600);\n    createOscillator(1200, 'triangle', 0.15, 0.05, 2000);\n}\n\nfunction playDeathSound() {\n    createOscillator(200, 'sawtooth', 0.3, 0.1, 50);\n    createOscillator(100, 'square', 0.5, 0.08, 30);\n}\n\nfunction playLandSound() {\n    createOscillator(150, 'triangle', 0.05, 0.06, 80);\n}\n\nfunction resizeCanvas() {\n    const container = canvas.parentElement;\n    const maxWidth = container.clientWidth;\n    const maxHeight = container.clientHeight - document.querySelector('.ui-top').offsetHeight - document.querySelector('.ui-bottom').offsetHeight;\n    const aspectRatio = 16 / 9;\n    let width = maxWidth;\n    let height = width / aspectRatio;\n    if (height > maxHeight) {\n        height = maxHeight;\n        width = height * aspectRatio;\n    }\n    canvas.width = width;\n    canvas.height = height;\n    canvas.style.width = width + 'px';\n    canvas.style.height = height + 'px';\n}\n\nconst GRAVITY = 0.5;\nconst JUMP_FORCE = -14;\nconst MOVE_SPEED = 6;\nconst GAME_SPEED_BASE = 4;\nconst GAME_SPEED_MAX = 12;\n\nlet player = {\n    x: 0,\n    y: 0,\n    width: 0,\n    height: 0,\n    vy: 0,\n    grounded: false,\n    jumps: 0,\n    maxJumps: 2,\n    color: COLORS.player,\n    trail: [],\n    invincible: 0\n};\n\nlet platforms = [];\nlet spikes = [];\nlet coins = [];\nlet particles = [];\nlet backgroundStars = [];\n\nlet gameSpeed = GAME_SPEED_BASE;\nlet score = 0;\nlet distance = 0;\nlet startTime = 0;\nlet elapsedTime = 0;\nlet running = false;\nlet gameOver = false;\nlet animationId = null;\n\nfunction initBackgroundStars() {\n    backgroundStars = [];\n    for (let i = 0; i < 100; i++) {\n        backgroundStars.push({\n            x: Math.random() * canvas.width,\n            y: Math.random() * canvas.height,\n            size: Math.random() * 2 + 0.5,\n            speed: Math.random() * 0.5 + 0.1,\n            color: [COLORS.neonPink, COLORS.neonBlue, COLORS.neonGreen, COLORS.neonPurple][Math.floor(Math.random() * 4)],\n            alpha: Math.random() * 0.5 + 0.2\n        });\n    }\n}\n\nfunction resetGame() {\n    const pw = canvas.width * 0.035;\n    const ph = canvas.height * 0.06;\n    player = {\n        x: canvas.width * 0.15,\n        y: canvas.height * 0.5,\n        width: pw,\n        height: ph,\n        vy: 0,\n        grounded: false,\n        jumps: 0,\n        maxJumps: 2,\n        color: COLORS.player,\n        trail: [],\n        invincible: 0\n    };\n    platforms = [];\n    spikes = [];\n    coins = [];\n    particles = [];\n    gameSpeed = GAME_SPEED_BASE;\n    score = 0;\n    distance = 0;\n    startTime = performance.now();\n    elapsedTime = 0;\n    running = true;\n    gameOver = false;\n    scoreEl.textContent = '0';\n    initBackgroundStars();\n    spawnInitialPlatforms();\n}\n\nfunction spawnInitialPlatforms() {\n    const groundY = canvas.height * 0.85;\n    platforms.push({\n        x: 0,\n        y: groundY,\n        width: canvas.width * 3,\n        height: canvas.height * 0.15,\n        type: 'ground'\n    });\n    for (let i = 1; i < 8; i++) {\n        spawnPlatform(i * (canvas.width * 0.4));\n    }\n}\n\nfunction spawnPlatform(offsetX) {\n    const gap = canvas.height * 0.35;\n    const minY = canvas.height * 0.25;\n    const maxY = canvas.height * 0.75;\n    const y = minY + Math.random() * (maxY - minY);\n    const width = canvas.width * (0.15 + Math.random() * 0.15);\n    const height = canvas.height * 0.03;\n    platforms.push({\n        x: offsetX,\n        y: y,\n        width: width,\n        height: height,\n        type: 'floating',\n        passed: false\n    });\n    if (Math.random() < 0.4) {\n        spikes.push({\n            x: offsetX + width / 2 - 10,\n            y: y - 20,\n            width: 20,\n            height: 20,\n            animation: Math.random() * Math.PI * 2\n        });\n    }\n    if (Math.random() < 0.5) {\n        coins.push({\n            x: offsetX + width / 2 - 12,\n            y: y - 40,\n            width: 24,\n            height: 24,\n            collected: false,\n            bob: Math.random() * Math.PI * 2\n        });\n    }\n}\n\nfunction jump() {\n    if (!running || gameOver) return;\n    if (player.jumps < player.maxJumps) {\n        player.vy = JUMP_FORCE;\n        player.jumps++;\n        player.grounded = false;\n        if (player.jumps === 1) {\n            playJumpSound();\n        } else {\n            playDoubleJumpSound();\n        }\n        for (let i = 0; i < 8; i++) {\n            particles.push({\n                x: player.x + player.width / 2,\n                y: player.y + player.height,\n                vx: (Math.random() - 0.5) * 4,\n                vy: Math.random() * 2 + 1,\n                size: Math.random() * 4 + 2,\n                color: COLORS.particle[Math.floor(Math.random() * COLORS.particle.length)],\n                life: 1,\n                decay: Math.random() * 0.02 + 0.015\n            });\n        }\n    }\n}\n\nfunction handleInput(e) {\n    if (e.type === 'keydown' && e.code !== 'Space') return;\n    if (e.type === 'click' || e.type === 'touchstart') {\n        const rect = canvas.getBoundingClientRect();\n        const x = (e.clientX || e.touches[0].clientX) - rect.left;\n        const y = (e.clientY || e.touches[0].clientY) - rect.top;\n        if (x < 0 || x > rect.width || y < 0 || y > rect.height) return;\n    }\n    e.preventDefault();\n    if (!running && !gameOver) {\n        startGame();\n    } else {\n        jump();\n    }\n}\n\nfunction startGame() {\n    startOverlay.classList.add('hidden');\n    resetGame();\n    gameLoop();\n}\n\nfunction endGame() {\n    running = false;\n    gameOver = true;\n    playDeathSound();\n    for (let i = 0; i < 30; i++) {\n        particles.push({\n            x: player.x + player.width / 2,\n            y: player.y + player.height / 2,\n            vx: (Math.random() - 0.5) * 12,\n            vy: (Math.random() - 0.5) * 12,\n            size: Math.random() * 6 + 3,\n            color: COLORS.particle[Math.floor(Math.random() * COLORS.particle.length)],\n            life: 1,\n            decay: Math.random() * 0.015 + 0.01\n        });\n    }\n    if (score > highScore) {\n        highScore = score;\n        localStorage.setItem('neonVelocityHighScore', highScore);\n        highScoreEl.textContent = highScore;\n    }\n    setTimeout(() => {\n        finalTimeEl.textContent = formatTime(elapsedTime);\n        finalScoreEl.textContent = score;\n        finalBestEl.textContent = highScore;\n        gameOverOverlay.classList.remove('hidden');\n    }, 500);\n}\n\nfunction formatTime(ms) {\n    const totalSeconds = Math.floor(ms / 1000);\n    const minutes = Math.floor(totalSeconds / 60);\n    const seconds = totalSeconds % 60;\n    const centiseconds = Math.floor((ms % 1000) / 10);\n    return `${minutes.toString().padStart(2, '0')}:${seconds.toString().padStart(2, '0')}.${centiseconds.toString().padStart(2, '0')}`;\n}\n\nfunction update(deltaTime) {\n    if (!running) return;\n    elapsedTime = performance.now() - startTime;\n    timerEl.textContent = formatTime(elapsedTime);\n    gameSpeed = Math.min(GAME_SPEED_BASE + distance * 0.00008, GAME_SPEED_MAX);\n    distance += gameSpeed;\n    score = Math.floor(distance / 10) + coins.filter(c => c.collected).length * 50;\n    scoreEl.textContent = score;\n    player.vy += GRAVITY;\n    player.y += player.vy;\n    player.trail.unshift({ x: player.x + player.width / 2, y: player.y + player.height / 2, alpha: 1 });\n    if (player.trail.length > 15) player.trail.pop();\n    player.trail.forEach(t => t.alpha -= 0.07);\n    if (player.invincible > 0) player.invincible--;\n    platforms.forEach(p => {\n        p.x -= gameSpeed;\n        if (p.type === 'floating' && !p.passed && p.x + p.width < player.x) {\n            p.passed = true;\n        }\n    });\n    spikes.forEach(s => {\n        s.x -= gameSpeed;\n        s.animation += 0.1;\n    });\n    coins.forEach(c => {\n        c.x -= gameSpeed;\n        c.bob += 0.08;\n    });\n    backgroundStars.forEach(star => {\n        star.x -= star.speed * (gameSpeed / GAME_SPEED_BASE);\n        if (star.x < 0) {\n            star.x = canvas.width;\n            star.y = Math.random() * canvas.height;\n        }\n    });\n    particles.forEach(p => {\n        p.x += p.vx;\n        p.y += p.vy;\n        p.vy += 0.1;\n        p.life -= p.decay;\n    });\n    particles = particles.filter(p => p.life > 0);\n    platforms = platforms.filter(p => p.x + p.width > -50);\n    spikes = spikes.filter(s => s.x + s.width > -50);\n    coins = coins.filter(c => c.x + c.width > -50);\n    const lastPlatform = platforms[platforms.length - 1];\n    if (lastPlatform && lastPlatform.x < canvas.width * 1.5) {\n        spawnPlatform(lastPlatform.x + canvas.width * (0.35 + Math.random() * 0.25));\n    }\n    checkCollisions();\n    if (player.y > canvas.height + 100) {\n        endGame();\n    }\n}\n\nfunction checkCollisions() {\n    player.grounded = false;\n    platforms.forEach(p => {\n        if (player.x < p.x + p.width &&\n            player.x + player.width > p.x &&\n            player.y + player.height > p.y &&\n            player.y + player.height < p.y + p.height + 20 &&\n            player.vy >= 0) {\n            player.y = p.y - player.height;\n            player.vy = 0;\n            player.grounded = true;\n            player.jumps = 0;\n            if (p.type === 'floating') playLandSound();\n        }\n    });\n    if (player.invincible <= 0) {\n      