            ctx.fillStyle = COLORS.platform;
            ctx.fillRect(p.x, p.y, p.width, p.height);
            ctx.strokeStyle = COLORS.platformEdge;
            ctx.lineWidth = 2;
            ctx.shadowColor = COLORS.platformEdge;
            ctx.shadowBlur = 8;
            ctx.strokeRect(p.x, p.y, p.width, p.height);
            ctx.shadowBlur = 0;
        }
    });
    spikes.forEach(s => {
        const spikeCount = 3;
        const spikeWidth = s.width / spikeCount;
        ctx.fillStyle = COLORS.spike;
        ctx.shadowColor = COLORS.spikeGlow;
        ctx.shadowBlur = 12;
        for (let i = 0; i < spikeCount; i++) {
            ctx.beginPath();
            ctx.moveTo(s.x + i * spikeWidth, s.y + s.height);
            ctx.lineTo(s.x + i * spikeWidth + spikeWidth / 2, s.y);
            ctx.lineTo(s.x + (i + 1) * spikeWidth, s.y + s.height);
            ctx.closePath();
            ctx.fill();
        }
        ctx.shadowBlur = 0;
    });
    coins.forEach(c => {
        if (!c.collected) {
            const bobY = Math.sin(c.bob) * 5;
            ctx.fillStyle = COLORS.coin;
            ctx.shadowColor = COLORS.coinGlow;
            ctx.shadowBlur = 15;
            ctx.beginPath();
            ctx.arc(c.x + c.width / 2, c.y + c.height / 2 + bobY, c.width / 2, 0, Math.PI * 2);
            ctx.fill();
            ctx.shadowBlur = 0;
            ctx.fillStyle = '#fff';
            ctx.beginPath();
            ctx.arc(c.x + c.width / 2, c.y + c.height / 2 + bobY, c.width / 4, 0, Math.PI * 2);
            ctx.fill();
        }
    });
    player.trail.forEach((t, i) => {
        ctx.globalAlpha = t.alpha * (i / player.trail.length) * 0.5;
        ctx.fillStyle = player.color;
        ctx.shadowColor = player.color;
        ctx.shadowBlur = 15;
        ctx.beginPath();
        ctx.arc(t.x, t.y, player.width * 0.3, 0, Math.PI * 2);
        ctx.fill();
    });
    ctx.globalAlpha = 1;
    ctx.shadowBlur = 0;
    if (player.invincible > 0 && player.invincible % 6 < 3) {
        ctx.globalAlpha = 0.5;
    }
    ctx.fillStyle = player.color;
    ctx.shadowColor = player.color;
    ctx.shadowBlur = 20;
    ctx.beginPath();
    ctx.roundRect(player.x, player.y, player.width, player.height, 6);
    ctx.fill();
    ctx.shadowBlur = 0;
    ctx.fillStyle = '#fff';
    ctx.beginPath();
    ctx.arc(player.x + player.width * 0.3, player.y + player.height * 0.4, player.width * 0.15, 0, Math.PI * 2);
    ctx.fill();
    ctx.fillStyle = COLORS.text;
    ctx.font = 'bold 12px "JetBrains Mono", monospace';
    ctx.textAlign = 'center';
    ctx.fillText('⚡', player.x + player.width / 2, player.y - 8);
    particles.forEach(p => {
        ctx.globalAlpha = p.life;
        ctx.fillStyle = p.color;
        ctx.shadowColor = p.color;
        ctx.shadowBlur = 8;
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
        ctx.fill();
    });
    ctx.globalAlpha = 1;
    ctx.shadowBlur = 0;
    if (!running && !gameOver) {
        // nothing
    } else if (!running) {
        ctx.fillStyle = 'rgba(255, 0, 110, 0.3)';
        ctx.fillRect(0, 0, canvas.width, canvas.height);
    }
}

function gameLoop() {
    if (!running) return;
    update();
    draw();
    animationId = requestAnimationFrame(gameLoop);
}

function handleResize() {
    resizeCanvas();
    initBackgroundStars();
}

window.addEventListener('resize', handleResize);
canvas.addEventListener('click', handleInput);
canvas.addEventListener('touchstart', handleInput, { passive: false });
document.addEventListener('keydown', handleInput);

startBtn.addEventListener('click', startGame);
restartBtn.addEventListener('click', startGame);
playAgainBtn.addEventListener('click', () => {
    gameOverOverlay.classList.add('hidden');
    startGame();
});

resizeCanvas();
initBackgroundStars();


