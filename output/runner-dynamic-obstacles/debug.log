  "index.html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, user-scalable=no\">\n    <title>Runner with Dynamic Obstacles</title>\n    <link rel=\"icon\" href=\"data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🏃</text></svg>\">\n    <link rel=\"stylesheet\" href=\"styles.css\">\n</head>\n<body>\n    <canvas id=\"gameCanvas\"></canvas>\n    <div id=\"touchControls\" class=\"hidden\">\n        <div id=\"leftBtn\" class=\"touch-btn\">◀</div>\n        <div id=\"rightBtn\" class=\"touch-btn\">▶</div>\n        <div id=\"jumpBtn\" class=\"touch-btn jump-btn\">⬆</div>\n        <div id=\"slideBtn\" class=\"touch-btn slide-btn\">⬇</div>\n    </div>\n    <script src=\"src/constants.js\"></script>\n    <script src=\"src/helpers.js\"></script>\n    <script src=\"src/core/assetLoader.js\"></script>\n    <script src=\"src/core/input.js\"></script>\n    <script src=\"src/audio/audioManager.js\"></script>\n    <script src=\"src/entities/player.js\"></script>\n    <script src=\"src/entities/obstacle.js\"></script>\n    <script src=\"src/systems/collision.js\"></script>\n    <script src=\"src/systems/proceduralGeneration.js\"></script>\n    <script src=\"src/systems/scoring.js"></script>\n    <script src=\"src/ui/hud.js\"></script>\n    <script src=\"src/ui/menus.js\"></script>\n    <script src=\"src/core/game.js\"></script>\n    <script>\n        // Initialize game when all scripts loaded\n        window.addEventListener('load', () => {\n            Game.init();\n        });\n    </script>\n</body>\n</html>",
  "styles.css": "* {\n    margin: 0;\n    padding: 0;\n    box-sizing: border-box;\n    -webkit-tap-highlight-color: transparent;\n}\n\nbody {\n    background: #1a1a2e;\n    overflow: hidden;\n    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;\n    touch-action: none;\n}\n\n#gameCanvas {\n    display: block;\n    position: absolute;\n    top: 50%;\n    left: 50%;\n    transform: translate(-50%, -50%);\n    max-width: 100vw;\n    max-height: 100vh;\n    image-rendering: pixelated;\n    image-rendering: crisp-edges;\n}\n\n#touchControls {\n    position: fixed;\n    bottom: 20px;\n    left: 0;\n    right: 0;\n    display: flex;\n    justify-content: space-between;\n    padding: 0 20px;\n    pointer-events: none;\n    z-index: 100;\n}\n\n#touchControls:not(.hidden) {\n    pointer-events: auto;\n}\n\n.touch-btn {\n    width: 70px;\n    height: 70px;\n    background: rgba(0, 102, 255, 0.8);\n    border: 2px solid #ffcc00;\n    border-radius: 15px;\n    color: #fff;\n    font-size: 28px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    user-select: none;\n    touch-action: manipulation;\n    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.5);\n    transition: transform 0.1s, background 0.1s;\n}\n\n.touch-btn:active {\n    transform: scale(0.9);\n    background: rgba(255, 204, 0, 0.9);\n}\n\n.jump-btn, .slide-btn {\n    margin-bottom: 10px;\n}\n\n.hidden {\n    display: none !important;\n}\n\n@media (hover: hover) and (pointer: fine) {\n    #touchControls {\n        display: none;\n    }\n}",
  "src/constants.js": "const CONSTANTS = {\n    // Canvas\n    DESIGN_WIDTH: 960,\n    DESIGN_HEIGHT: 540,\n    \n    // Colors - Vibrant Palette\n    COLORS: {\n        PRIMARY: '#0066FF',\n        ACCENT: '#FFCC00',\n        BACKGROUND: '#1a1a2e',\n        SKY: '#0f0f23',\n        HILL_FAR: '#16213e',\n        HILL_MID: '#1f4068',\n        HILL_NEAR: '#0066ff',\n        GROUND: '#0f3460',\n        SPIKE: '#ff3366',\n        BALL: '#ffcc00',\n        WALL: '#00ff88',\n        POWERUP_SPEED: '#ff3366',\n        POWERUP_SHIELD: '#00ffff',\n        POWERUP_LIFE: '#ff33ff',\n        PARTICLE: '#ffffff',\n        UI_TEXT: '#ffffff',\n        UI_SHADOW: '#000000',\n        COMBO: '#ffcc00'\n    },\n    \n    // Player\n    PLAYER: {\n        WIDTH: 40,\n        HEIGHT: 48,\n        SLIDE_HEIGHT: 24,\n        LANE_WIDTH: 120,\n        LANES: 3,\n        START_LANE: 1, // 0,1,2\n        FORWARD_SPEED: 8, // px/ms\n        JUMP_IMPULSE: -1.5, // px/ms\n        GRAVITY: 0.0025, // px/ms^2\n        MAX_FALL_SPEED: -4, // px/ms\n        JUMP_DURATION: 350, // ms\n        SLIDE_DURATION: 600, // ms\n        SLIDE_COOLDOWN: 500, // ms\n        LANE_CHANGE_DURATION: 200, // ms\n        INVULNERABILITY_DURATION: 100, // ms\n        INPUT_DEBOUNCE: 150 // ms\n    },\n    \n    // Obstacles\n    OBSTACLE: {\n        BASE_SPAWN_INTERVAL: 1200, // ms\n        MIN_SPAWN_INTERVAL: 400,\n        SPEED_MULTIPLIER: 1.0,\n        TYPES: {\n            SPIKE: 'spike',\n            BALL: 'ball',\n            WALL: 'wall',\n            GAP: 'gap',\n            POWERUP: 'powerup'\n        }\n    },\n    \n    // Difficulty thresholds (distance in meters)\n    DIFFICULTY: {\n        STAGE_1: 500,\n        STAGE_2: 1500,\n        STAGE_3: 3000\n    },\n    \n    // Scoring\n    SCORING: {\n        BASE_MULTIPLIER: 1000,\n        COMBO_INCREMENT: 0.1,\n        MAX_COMBO: 3.0,\n        POWERUP_BONUS: {\n            SPEED: 2000,\n            SHIELD: 1500,\n            LIFE: 5000\n        }\n    },\n    \n    // Power-ups\n    POWERUP: {\n        SPEED_DURATION: 5000,\n        SHIELD_DURATION: 3000,\n        SPEED_MULTIPLIER: 1.5\n    },\n    \n    // Audio\n    AUDIO: {\n        MASTER_VOLUME: 0.4,\n        SFX_VOLUME: 0.6,\n        MUSIC_VOLUME: 0.3\n    },\n    \n    // Game States\n    STATE: {\n        LOADING: 'loading',\n        MENU: 'menu',\n        PLAYING: 'playing',\n        PAUSED: 'paused',\n        GAME_OVER: 'gameOver'\n    },\n    \n    // Physics\n    FIXED_TIMESTEP: 1000 / 60, // ms\n    MAX_SUBSTEPS: 5\n};\n\n// Make globally available\nwindow.CONSTANTS = CONSTANTS;",
  "src/helpers.js": "const Helpers = {\n    // Clamp value between min and max\n    clamp(value, min, max) {\n        return Math.max(min, Math.min(max, value));\n    },\n    \n    // Linear interpolation\n    lerp(start, end, t) {\n        return start + (end - start) * t;\n    },\n    \n    // Random integer between min and max (inclusive)\n    randomInt(min, max) {\n        return Math.floor(Math.random() * (max - min + 1)) + min;\n    },\n    \n    // Random float between min and max\n    randomFloat(min, max) {\n        return Math.random() * (max - min) + min;\n    },\n    \n    // Distance between two points\n    distance(x1, y1, x2, y2) {\n        const dx = x2 - x1;\n        const dy = y2 - y1;\n        return Math.sqrt(dx * dx + dy * dy);\n    },\n    \n    // Check AABB collision\n    checkAABB(rect1, rect2) {\n        return rect1.x < rect2.x + rect2.w &&\n               rect1.x + rect1.w > rect2.x &&\n               rect1.y < rect2.y + rect2.h &&\n               rect1.y + rect1.h > rect2.y;\n    },\n    \n    // Check Circle vs AABB collision\n    checkCircleAABB(circle, rect) {\n        const distX = Math.abs(circle.x - rect.x - rect.w / 2);\n        const distY = Math.abs(circle.y - rect.y - rect.h / 2);\n        \n        if (distX > (rect.w / 2 + circle.r)) return false;\n        if (distY > (rect.h / 2 + circle.r)) return false;\n        \n        if (distX <= (rect.w / 2)) return true;\n        if (distY <= (rect.h / 2)) return true;\n        \n        const dx = distX - rect.w / 2;\n        const dy = distY - rect.h / 2;\n        return (dx * dx + dy * dy) <= (circle.r * circle.r);\n    },\n    \n    // Format time as MM:SS:ms\n    formatTime(ms) {\n        const minutes = Math.floor(ms / 60000);\n        const seconds = Math.floor((ms % 60000) / 1000);\n        const milliseconds = Math.floor((ms % 1000) / 10);\n        return `${minutes.toString().padStart(2, '0')}:${seconds.toString().padStart(2, '0')}.${milliseconds.toString().padStart(2, '0')}`;\n    },\n    \n    // Format score with commas\n    formatScore(score) {\n        return score.toString().replace(/\\B(?=(\\d{3})+(?!\\d))/g, \",\");\n    },\n    \n    // Generate simple geometric shapes for obstacles (since no sprites)\n    drawRoundedRect(ctx, x, y, w, h, radius, fillStyle, strokeStyle) {\n        ctx.beginPath();\n        ctx.moveTo(x + radius, y);\n        ctx.lineTo(x + w - radius, y);\n        ctx.quadraticCurveTo(x + w, y, x + w, y + radius);\n        ctx.lineTo(x + w, y + h - radius);\n        ctx.quadraticCurveTo(x + w, y + h, x + w - radius, y + h);\n        ctx.lineTo(x + radius, y + h);\n        ctx.quadraticCurveTo(x, y + h, x, y + h - radius);\n        ctx.lineTo(x, y + radius);\n        ctx.quadraticCurveTo(x, y, x + radius, y);\n        ctx.closePath();\n        \n        if (fillStyle) {\n            ctx.fillStyle = fillStyle;\n            ctx.fill();\n        }\n        if (strokeStyle) {\n            ctx.strokeStyle = strokeStyle;\n            ctx.stroke();\n        }\n    },\n    \n    // Draw triangle (for spikes)\n    drawTriangle(ctx, x, y, size, fillStyle) {\n        ctx.beginPath();\n        ctx.moveTo(x, y);\n        ctx.lineTo(x - size / 2, y + size);\n        ctx.lineTo(x + size / 2, y + size);\n        ctx.closePath();\n        ctx.fillStyle = fillStyle;\n        ctx.fill();\n    },\n    \n    // Draw particle\n    drawParticle(ctx, x, y, size, color, alpha) {\n        ctx.globalAlpha = alpha;\n        ctx.fillStyle = color;\n        ctx.beginPath();\n        ctx.arc(x, y, size, 0, Math.PI * 2);\n        ctx.fill();\n        ctx.globalAlpha = 1;\n    },\n    \n    // Detect touch device\n    isTouchDevice() {\n        return 'ontouchstart' in window || navigator.maxTouchPoints > 0;\n    },\n    \n    // Get high score from localStorage\n    getHighScore() {\n        return parseInt(localStorage.getItem('runnerHighScore') || '0', 10);\n    },\n    \n    // Save high score to localStorage\n    saveHighScore(score) {\n        const currentHigh = this.getHighScore();\n        if (score > currentHigh) {\n            localStorage.setItem('runnerHighScore', score.toString());\n            return true;\n        }\n        return false;\n    }\n};\n\nwindow.Helpers = Helpers;",
  "src/core/assetLoader.js": "const AssetLoader = {\n    assets: {},\n    loadQueue: [],\n    onProgress: null,\n    onComplete: null,\n    \n    // Add asset to load queue\n    add(name, src, type = 'image') {\n        this.loadQueue.push({ name, src, type });\n    },\n    \n    // Load all queued assets\n    load() {\n        return new Promise((resolve) => {\n            this.onComplete = resolve;\n            let loaded = 0;\n            const total = this.loadQueue.length;\n            \n            if (total === 0) {\n                this.onComplete();\n                return;\n            }\n            \n            this.loadQueue.forEach(asset => {\n                if (asset.type === 'image') {\n                    const img = new Image();\n                    img.onload = () => {\n                        this.assets[asset.name] = img;\n                        loaded++;\n                        if (this.onProgress) this.onProgress(loaded / total);\n                        if (loaded === total) this.onComplete();\n                    };\n                    img.onerror = () => {\n                        console.warn(`Failed to load image: ${asset.src}`);\n                        loaded++;\n                        if (loaded === total) this.onComplete();\n                    };\n                    img.src = asset.src;\n                } else if (asset.type === 'audio') {\n                    // Audio will be handled by AudioManager\n                    loaded++;\n                    if (loaded === total) this.onComplete();\n                }\n            });\n        });\n    },\n    \n    // Get loaded asset\n    get(name) {\n        return this.assets[name];\n    },\n    \n    // Create placeholder graphics programmatically\n    createPlaceholders() {\n        const canvas = document.createElement('canvas');\n        const ctx = canvas.getContext('2d');\n        \n        // Player sprite sheet (4 walk frames, 2 jump, 3 slide, 1 idle)\n        // Each frame 96x96\n        canvas.width = 96 * 10;\n        canvas.height = 96;\n        \n        // Simple runner character - blue with yellow accents\n        for (let i = 0; i < 10; i++) {\n            const x = i * 96;\n            ctx.fillStyle = CONSTANTS.COLORS.PRIMARY;\n            // Body\n            ctx.fillRect(x + 28, 20, 40, 48);\n            // Head\n            ctx.beginPath();\n            ctx.arc(x + 48, 30, 18, 0, Math.PI * 2);\n            ctx.fill();\n            // Eyes\n            ctx.fillStyle = '#fff';\n            ctx.fillRect(x + 42, 24, 6, 6);\n            ctx.fillRect(x + 54, 24, 6, 6);\n            // Accent stripe\n            ctx.fillStyle = CONSTANTS.COLORS.ACCENT;\n            ctx.fillRect(x + 28, 40, 40, 4);\n            \n            // Leg animation offset\n            const legOffset = (i % 4) * 4;\n            ctx.fillStyle = CONSTANTS.COLORS.PRIMARY;\n            ctx.fillRect(x + 32, 68 + legOffset, 12, 20);\n            ctx.fillRect(x + 52, 68 - legOffset, 12, 20);\n        }\n        \n        this.assets['player'] = canvas;\n        \n        // Create simple obstacle graphics\n        this.createObstacleGraphics();\n        \n        // Create particle canvas\n        this.createParticleGraphics();\n    },\n    \n    createObstacleGraphics() {\n        // Spike\n        const spikeCanvas = document.createElement('canvas');\n        spikeCanvas.width = 48;\n        spikeCanvas.height = 48;\n        const spikeCtx = spikeCanvas.getContext('2d');\n        spikeCtx.fillStyle = CONSTANTS.COLORS.SPIKE;\n        Helpers.drawTriangle(spikeCtx, 24, 0, 48, CONSTANTS.COLORS.SPIKE);\n        this.assets['spike'] = spikeCanvas;\n        \n        // Ball\n        const ballCanvas = document.createElement('canvas');\n        ballCanvas.width = 48;\n        ballCanvas.height = 48;\n        const ballCtx = ballCanvas.getContext('2d');\n        const gradient = ballCtx.createRadialGradient(24, 24, 0, 24, 24, 24);\n        gradient.addColorStop(0, '#fff9c4');\n        gradient.addColorStop(1, CONSTANTS.COLORS.BALL);\n        ballCtx.fillStyle = gradient;\n        ballCtx.beginPath();\n        ballCtx.arc(24, 24, 20, 0, Math.PI * 2);\n        ballCtx.fill();\n        this.assets['ball'] = ballCanvas;\n        \n        // Wall\n        const wallCanvas = document.createElement('canvas');\n        wallCanvas.width = 120;\n        wallCanvas.height = 48;\n        const wallCtx = wallCanvas.getContext('2d');\n        const wallGradient = wallCtx.createLinearGradient(0, 0, 120, 0);\n        wallGradient.addColorStop(0, CONSTANTS.COLORS.WALL);\n        wallGradient.addColorStop(1, '#00cc6a');\n        wallCtx.fillStyle = wallGradient;\n        Helpers.drawRoundedRect(wallCtx, 0, 0, 120, 48, 8, wallGradient);\n        this.assets['wall'] = wallCanvas;\n        \n        // Power-ups\n        const powerupTypes = ['speed', 'shield', 'life'];\n        const powerupColors = [\n            CONSTANTS.COLORS.POWERUP_SPEED,\n            CONSTANTS.COLORS.POWERUP_SHIELD,\n            CONSTANTS.COLORS.POWERUP_LIFE\n        ];\n        \n        powerupTypes.forEach((type, i) => {\n            const canvas = document.createElement('canvas');\n            canvas.width = 48;\n            canvas.height = 48;\n            const ctx = canvas.getContext('2d');\n            \n            // Glow effect\n            ctx.shadowColor = powerupColors[i];\n            ctx.shadowBlur = 15;\n            \n            ctx.fillStyle = powerupColors[i];\n            Helpers.drawRoundedRect(ctx, 4, 4, 40, 40, 8, powerupColors[i]);\n            \n            // Symbol\n            ctx.fillStyle = '#fff';\n            ctx.font = 'bold 24px Arial';\n            ctx.textAlign = 'center';\n            ctx.textBaseline = 'middle';\n            const symbols = ['⚡', '🛡', '❤'];\n            ctx.fillText(symbols[i], 24, 26);\n            \n            ctx.shadowBlur = 0;\n            this.assets[`powerup_${type}`] = canvas;\n        });\n    },\n    \n    createParticleGraphics() {\n        const canvas = document.createElement('canvas');\n        canvas.width = 16;\n        canvas.height = 16;\n        const ctx = canvas.getContext('2d');\n        ctx.fillStyle = '#fff';\n        ctx.beginPath();\n        ctx.arc(8, 8, 4, 0, Math.PI * 2);\n        ctx.fill();\n        this.assets['particle'] = canvas;\n    }\n};\n\nwindow.AssetLoader = AssetLoader;",
  "src/core/input.js": "const InputManager = {\n    keys: {},\n    keyPressTime: {},\n    lastActionTime: {},\n    actions: {\n        jump: false,\n        slide: false,\n        left: false,\n        right: false,\n        pause: false\n    },\n    \n    init() {\n        window.addEventListener('keydown', this.onKeyDown.bind(this));\n        window.addEventListener('keyup', this.onKeyUp.bind(this));\n        \n        // Touch controls\n        this.setupTouchControls();\n    },\n    \n    onKeyDown(e) {\n        this.keys[e.code] = true;\n        this.keyPressTime[e.code] = performance.now();\n        \n        // Prevent default for game keys\n        const gameKeys = ['Space', 'ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight', 'KeyP', 'Escape'];\n        if (gameKeys.includes(e.code)) {\n            e.preventDefault();\n        }\n    },\n    \n    onKeyUp(e) {\n        this.keys[e.code] = false;\n    },\n    \n    setupTouchControls() {\n        const touchControls = document.getElementById('touchControls');\n        if (Helpers.isTouchDevice()) {\n            touchControls.classList.remove('hidden');\n        }\n        \n        const buttons = {\n            leftBtn: 'left',\n            rightBtn: 'right',\n            jumpBtn: 'jump',\n            slideBtn: 'slide'\n        };\n        \n        Object.entries(buttons).forEach(([id, action]) => {\n            const btn = document.getElementById(id);\n            if (!btn) return;\n            \n            const handleStart = (e) => {\n                e.preventDefault();\n                this.actions[action] = true;\n                this.keyPressTime[action] = performance.now();\n            };\n            \n            const handleEnd = (e) => {\n                e.preventDefault();\n                this.actions[action] = false;\n            };\n            \n            btn.addEventListener('touchstart', handleStart, { passive: false });\n            btn.addEventListener('touchend', handleEnd, { passive: false });\n            btn.addEventListener('touchcancel', handleEnd, { passive: false });\n            \n            // Mouse support for testing\n            btn.addEventListener('mousedown', handleStart);\n            btn.addEventListener('mouseup', handleEnd);\n            btn.addEventListener('mouseleave', handleEnd);\n        });\n    },\n    \n    update() {\n        const now = performance.now();\n        const debounce = CONSTANTS.PLAYER.INPUT_DEBOUNCE;\n        \n        // Keyboard mappings\n        const keyMap = {\n            jump: ['Space', 'ArrowUp'],\n            slide: ['ArrowDown'],\n            left: ['ArrowLeft'],\n            right: ['ArrowRight'],\n            pause: ['KeyP', 'Escape']\n        };\n        \n        Object.entries(keyMap).forEach(([action, codes]) => {\n            const pressed = codes.some(code => this.keys[code]);\n            const touchPressed = this.actions[action];\n            \n            if (pressed || touchPressed) {\n                const lastTime = this.lastActionTime[action] || 0;\n                if (now - lastTime > debounce) {\n                    this.lastActionTime[action] = now;\n                    return true; // Action triggered\n                }\n            }\n        });\n        \n        return false;\n    },\n    \n    // Check if action was just pressed (for one-time actions)\n    isActionPressed(action) {\n        const keyMap = {\n            jump: ['Space', 'ArrowUp'],\n            slide: ['ArrowDown'],\n            left: ['ArrowLeft'],\n            right: ['ArrowRight'],\n            pause: ['KeyP', 'Escape']\n        };\n        \n        const codes = keyMap[action];\n        const keyboardPressed = codes.some(code => this.keys[code]);\n        const touchPressed = this.actions[action];\n        \n        return keyboardPressed || touchPressed;\n    },\n    \n    // Consume action (call after processing)\n    consumeAction(action) {\n        this.actions[action] = false;\n        const keyMap = {\n            jump: ['Space', 'ArrowUp'],\n            slide: ['ArrowDown'],\n            left: ['ArrowLeft'],\n            right: ['ArrowRight'],\n            pause: ['KeyP', 'Escape']\n        };\n        keyMap[action].forEach(code => this.keys[code] = false);\n    },\n    \n    reset() {\n        this.keys = {};\n        this.keyPressTime = {};\n        this.lastActionTime = {};\n        this.actions = {\n            jump: false,\n            slide: false,\n            left: false,\n            right: false,\n            pause: false\n        };\n    }\n};\n\nwindow.InputManager = InputManager;",
  "src/audio/audioManager.js": "const AudioManager = {\n    audioContext: null,\n    masterGain: null,\n    sfxGain: null,\n    musicGain: null,\n    buffers: {},\n    musicSource: null,\n    musicBuffer: null,\n    isMuted: false,\n    \n    init() {\n        try {\n            this.audioContext = new (window.AudioContext || window.webkitAudioContext)();\n            \n            // Create gain nodes\n            this.masterGain = this.audioContext.createGain();\n            this.masterGain.gain.value = CONSTANTS.AUDIO.MASTER_VOLUME;\n            this.masterGain.connect(this.audioContext.destination);\n            \n            this.sfxGain = this.audioContext.createGain();\n            this.sfxGain.gain.value = CONSTANTS.AUDIO.SFX_VOLUME;\n            this.sfxGain.connect(this.masterGain);\n            \n            this.musicGain = this.audioContext.createGain();\n            this.musicGain.gain.value = CONSTANTS.AUDIO.MUSIC_VOLUME;\n            this.musicGain.connect(this.masterGain);\n            \n            // Generate synthetic sounds\n            this.generateSounds();\n            \n            // Resume context on user interaction\n            document.addEventListener('click', () => this.resumeContext(), { once: true });\n            document.addEventListener('keydown', () => this.resumeContext(), { once: true });\n            \n        } catch (e) {\n            console.warn('Web Audio API not supported:', e);\n        }\n    },\n    \n    resumeContext() {\n        if (this.audioContext && this.audioContext.state === 'suspended') {\n            this.audioContext.resume();\n        }\n    },\n    \n    // Generate procedural sounds using Web Audio API\n    generateSounds() {\n        if (!this.audioContext) return;\n        \n        // Jump sound - quick sine wave sweep\n        this.buffers.jump = this.createTone(440, 880, 0.15, 'sine', 0.3);\n        \n        // Slide sound - noise burst\n        this.buffers.slide = this.createNoise(0.2, 0.4);\n        \n        // Hit sound - descending tone with noise\n        this.buffers.hit = this.createHitSound();\n        \n        // Powerup sound - ascending arpeggio\n        this.buffers.powerup = this.createPowerupSound();\n        \n        // Game over sound - sad descending\n        this.buffers.gameover = this.createGameOverSound();\n        \n        // Background music - simple loop\n        this.musicBuffer = this.createMusicLoop();\n    },\n    \n    createTone(startFreq, endFreq, duration, type = 'sine', volume = 1) {\n        const sampleRate = this.audioContext.sampleRate;\n        const length = sampleRate * duration;\n        const buffer = this.audioContext.createBuffer(1, length,sampleRate * duration;\n        const buffer = this.audioContext.createBuffer(1, length, sampleRate);\n        const data = buffer.getChannelData(0);\n        \n        for (let i = 0; i < length; i++) {\n            const t = i / length;\n            const freq = startFreq + (endFreq - startFreq) * t;\n            const phase = 2 * Math.PI * freq * (i / sampleRate);\n            let sample = Math.sin(phase);\n            \n            // Apply envelope\n            const attack = 0.01;\n            const release = 0.3;\n            if (t < attack) sample *= t / attack;\n            else sample *= Math.pow(1 - t, release);\n            \n            data[i] = sample * volume;\n        }\n        return buffer;\n    },\n    \n    createNoise(duration, volume = 1) {\n        const sampleRate = this.audioContext.sampleRate;\n        const length = sampleRate * duration;\n        const buffer = this.audioContext.createBuffer(1, length, sampleRate);\n        const data = buffer.getChannelData(0);\n        \n        for (let i = 0; i < length; i++) {\n            const t = i / length;\n            data[i] = (Math.random() * 2 - 1) * volume * Math.pow(1 - t, 2);\n        }\n        return buffer;\n    },\n    \n    createHitSound() {\n        const sampleRate = this.audioContext.sampleRate;\n        const duration = 0.3;\n        const length = sampleRate * duration;\n        const buffer = this.audioContext.createBuffer(1, length, sampleRate);\n        const data = buffer.getChannelData(0);\n        \n        for (let i = 0; i < length; i++) {\n            const t = i / length;\n            const freq = 200 - 150 * t;\n            const phase = 2 * Math.PI * freq * (i / sampleRate);\n            let sample = Math.sin(phase) * 0.5;\n            sample += (Math.random() * 2 - 1) * 0.3;\n            sample *= Math.pow(1 - t, 3);\n            data[i] = sample;\n        }\n        return buffer;\n    },\n    \n    createPowerupSound() {\n        const sampleRate = this.audioContext.sampleRate;\n        const duration = 0.5;\n        const length = sampleRate * duration;\n        const buffer = this.audioContext.createBuffer(1, length, sampleRate);\n        const data = buffer.getChannelData(0);\n        \n        const notes = [523.25, 659.25, 783.99, 1046.50]; // C5, E5, G5, C6\n        \n        for (let i = 0; i < length; i++) {\n            const t = i / length;\n            const noteIndex = Math.floor(t * notes.length);\n            const freq = notes[Math.min(noteIndex, notes.length - 1)];\n            const phase = 2 * Math.PI * freq * (i / sampleRate);\n            let sample = Math.sin(phase) * 0.4;\n            sample *= Math.pow(1 - t, 1.5);\n            data[i] = sample;\n        }\n        return buffer;\n    },\n    \n    createGameOverSound() {\n        const sampleRate = this.audioContext.sampleRate;\n        const duration = 1.0;\n        const length = sampleRate * duration;\n        const buffer = this.audioContext.createBuffer(1, length, sampleRate);\n        const data = buffer.getChannelData(0);\n        \n        for (let i = 0; i < length; i++) {\n            const t = i / length;\n            const freq = 440 - 300 * t;\n            const phase = 2 * Math.PI * freq * (i / sampleRate);\n            let sample = Math.sin(phase) * 0.5;\n            sample *= Math.pow(1 - t, 2);\n            data[i] = sample;\n        }\n        return buffer;\n    },\n    \n    createMusicLoop() {\n        const sampleRate = this.audioContext.sampleRate;\n        const duration = 8.0; // 8 second loop\n        const length = sampleRate * duration;\n        const buffer = this.audioContext.createBuffer(1, length, sampleRate);\n        const data = buffer.getChannelData(0);\n        \n        // Simple chord progression: Am - F - C - G\n        const chords = [\n            [220, 329.63, 440],     // Am\n            [174.61, 261.63, 349.23], // F\n            [130.81, 261.63, 329.63], // C\n            [196, 246.94, 293.66]    // G\n        ];\n        const chordDuration = duration / chords.length;\n        \n        for (let i = 0; i < length; i++) {\n            const t = i / length;\n            const chordIndex = Math.floor(t * chords.length);\n            const chord = chords[Math.min(chordIndex, chords.length - 1)];\n            const chordT = (t * chords.length) % 1;\n            \n            let sample = 0;\n            chord.forEach(freq => {\n                const phase = 2 * Math.PI * freq * (i / sampleRate);\n                sample += Math.sin(phase) * 0.1;\n            });\n            \n            // Add subtle rhythm\n            const beat = Math.sin(2 * Math.PI * 2 * t) * 0.05;\n            sample += beat;\n            \n            // Envelope per chord\n            const env = Math.sin(Math.PI * chordT);\n            data[i] = sample * env * 0.3;\n        }\n        return buffer;\n    },\n    \n    playSound(name, volume = 1, playbackRate = 1) {\n        if (!this.audioContext || this.isMuted) return;\n        \n        const buffer = this.buffers[name];\n        if (!buffer) return;\n        \n        const source = this.audioContext.createBufferSource();\n        source.buffer = buffer;\n        source.playbackRate.value = playbackRate;\n        \n        const gain = this.audioContext.createGain();\n        gain.gain.value = volume;\n        \n        source.connect(gain);\n        gain.connect(this.sfxGain);\n        source.start(0);\n    },\n    \n    playMusic() {\n        if (!this.audioContext || this.isMuted || this.musicSource) return;\n        \n        this.musicSource = this.audioContext.createBufferSource();\n        this.musicSource.buffer = this.musicBuffer;\n        this.musicSource.loop = true;\n        this.musicSource.connect(this.musicGain);\n        this.musicSource.start(0);\n    },\n    \n    stopMusic() {\n        if (this.musicSource) {\n            this.musicSource.stop();\n            this.musicSource = null;\n        }\n    },\n    \n    setMasterVolume(volume) {\n        if (this.masterGain) {\n            this.masterGain.gain.value = Helpers.clamp(volume, 0, 1);\n        }\n    },\n    \n    setMuted(muted) {\n        this.isMuted = muted;\n        if (this.masterGain) {\n            this.masterGain.gain.value = muted ? 0 : CONSTANTS.AUDIO.MASTER_VOLUME;\n        }\n    },\n    \n    toggleMute() {\n        this.setMuted(!this.isMuted);\n        return this.isMuted;\n    }\n};\n\nwindow.AudioManager = AudioManager;",
  "src/entities/player.js": "const Player = {\n    x: 0,\n    y: 0,\n    targetX: 0,\n    targetLane: 1,\n    currentLane: 1,\n    laneChangeProgress: 1,\n    velocityY: 0,\n    isGrounded: true,\n    isJumping: false,\n    isSliding: false,\n    jumpTime: 0,\n    slideTime: 0,\n    slideCooldown: 0,\n    invulnerabilityTime: 0,\n    hasShield: false,\n    shieldTime: 0,\n    speedBoostTime: 0,\n    animationTime: 0,\n    animationFrame: 0,\n    width: CONSTANTS.PLAYER.WIDTH,\n    height: CONSTANTS.PLAYER.HEIGHT,\n    \n    init() {\n        this.reset();\n    },\n    \n    reset() {\n        this.currentLane = CONSTANTS.PLAYER.START_LANE;\n        this.targetLane = this.currentLane;\n        this.laneChangeProgress = 1;\n        this.x = this.getLaneX(this.currentLane);\n        this.targetX = this.x;\n        this.y = CONSTANTS.DESIGN_HEIGHT - 80 - this.height;\n        this.velocityY = 0;\n        this.isGrounded = true;\n        this.isJumping = false;\n        this.isSliding = false;\n        this.jumpTime = 0;\n        this.slideTime = 0;\n        this.slideCooldown = 0;\n        this.invulnerabilityTime = 0;\n        this.hasShield = false;\n        this.shieldTime = 0;\n        this.speedBoostTime = 0;\n        this.animationTime = 0;\n        this.animationFrame = 0;\n    },\n    \n    getLaneX(lane) {\n        const centerX = CONSTANTS.DESIGN_WIDTH / 2;\n        const laneOffset = (lane - 1) * CONSTANTS.PLAYER.LANE_WIDTH;\n        return centerX + laneOffset - this.width / 2;\n    },\n    \n    update(deltaTime, gameSpeed) {\n        const speedMultiplier = this.speedBoostTime > 0 ? CONSTANTS.POWERUP.SPEED_MULTIPLIER : 1;\n        const effectiveSpeed = gameSpeed * speedMultiplier;\n        \n        // Handle input\n        this.handleInput();\n        \n        // Lane changing\n        if (this.laneChangeProgress < 1) {\n            this.laneChangeProgress += deltaTime / CONSTANTS.PLAYER.LANE_CHANGE_DURATION;\n            this.laneChangeProgress = Math.min(1, this.laneChangeProgress);\n            this.x = Helpers.lerp(this.x, this.targetX, this.laneChangeProgress);\n        }\n        \n        // Jumping\n        if (this.isJumping) {\n            this.jumpTime += deltaTime;\n            this.velocityY += CONSTANTS.PLAYER.GRAVITY * deltaTime;\n            \n            if (this.velocityY > 0 && this.jumpTime > CONSTANTS.PLAYER.JUMP_DURATION) {\n                this.velocityY = Math.max(this.velocityY, CONSTANTS.PLAYER.MAX_FALL_SPEED);\n            }\n        }\n        \n        // Apply gravity\n        if (!this.isGrounded) {\n            this.velocityY += CONSTANTS.PLAYER.GRAVITY * deltaTime;\n            this.velocityY = Math.max(this.velocityY, CONSTANTS.PLAYER.MAX_FALL_SPEED);\n        }\n        \n        this.y += this.velocityY * deltaTime;\n        \n        // Ground collision\n        const groundY = CONSTANTS.DESIGN_HEIGHT - 80 - (this.isSliding ? CONSTANTS.PLAYER.SLIDE_HEIGHT : this.height);\n        if (this.y >= groundY) {\n            this.y = groundY;\n            this.velocityY = 0;\n            this.isGrounded = true;\n            this.isJumping = false;\n        } else {\n            this.isGrounded = false;\n        }\n        \n        // Sliding\n        if (this.isSliding) {\n            this.slideTime += deltaTime;\n            if (this.slideTime >= CONSTANTS.PLAYER.SLIDE_DURATION) {\n                this.isSliding = false;\n                this.slideCooldown = CONSTANTS.PLAYER.SLIDE_COOLDOWN;\n            }\n        }\n        \n        if (this.slideCooldown > 0) {\n            this.slideCooldown -= deltaTime;\n        }\n        \n        // Invulnerability\n        if (this.invulnerabilityTime > 0) {\n            this.invulnerabilityTime -= deltaTime;\n        }\n        \n        // Shield\n        if (this.shieldTime > 0) {\n            this.shieldTime -= deltaTime;\n            if (this.shieldTime <= 0) {\n                this.hasShield = false;\n            }\n        }\n        \n        // Speed boost\n        if (this.speedBoostTime > 0) {\n            this.speedBoostTime -= deltaTime;\n        }\n        \n        // Animation\n        this.animationTime += deltaTime;\n        if (this.isGrounded && !this.isSliding) {\n            this.animationFrame = Math.floor(this.animationTime / 100) % 4;\n        } else if (this.isJumping) {\n            this.animationFrame = 4 + (this.velocityY < 0 ? 0 : 1);\n        } else if (this.isSliding) {\n            this.animationFrame = 6 + Math.floor(this.animationTime / 150) % 3;\n        }\n    },\n    \n    handleInput() {\n        // Jump\n        if (InputManager.isActionPressed('jump') && this.isGrounded && !this.isSliding) {\n            this.jump();\n            InputManager.consumeAction('jump');\n        }\n        \n        // Slide\n        if (InputManager.isActionPressed('slide') && this.isGrounded && !this.isJumping && this.slideCooldown <= 0) {\n            this.slide();\n            InputManager.consumeAction('slide');\n        }\n        \n        // Lane change left\n        if (InputManager.isActionPressed('left') && this.laneChangeProgress >= 1 && this.targetLane > 0) {\n            this.targetLane--;\n            this.targetX = this.getLaneX(this.targetLane);\n            this.laneChangeProgress = 0;\n            InputManager.consumeAction('left');\n        }\n        \n        // Lane change right\n        if (InputManager.isActionPressed('right') && this.laneChangeProgress >= 1 && this.targetLane < CONSTANTS.PLAYER.LANES - 1) {\n            this.targetLane++;\n            this.targetX = this.getLaneX(this.targetLane);\n            this.laneChangeProgress = 0;\n            InputManager.consumeAction('right');\n        }\n    },\n    \n    jump() {\n        this.isJumping = true;\n        this.isGrounded = false;\n        this.velocityY = CONSTANTS.PLAYER.JUMP_IMPULSE;\n        this.jumpTime = 0;\n        AudioManager.playSound('jump', 0.5);\n    },\n    \n    slide() {\n        this.isSliding = true;\n        this.slideTime = 0;\n        AudioManager.playSound('slide', 0.4);\n    },\n    \n    getHitbox() {\n        const h = this.isSliding ? CONSTANTS.PLAYER.SLIDE_HEIGHT : this.height;\n        return {\n            x: this.x + 4,\n            y: this.y + (this.height - h),\n            w: this.width - 8,\n            h: h - 4\n        };\n    },\n    \n    takeDamage() {\n        if (this.invulnerabilityTime > 0 || this.hasShield) {\n            if (this.hasShield) {\n                this.hasShield = false;\n                this.shieldTime = 0;\n                AudioManager.playSound('powerup', 0.5, 1.2);\n            }\n            return false; // No damage taken\n        }\n        \n        this.invulnerabilityTime = CONSTANTS.PLAYER.INVULNERABILITY_DURATION;\n        AudioManager.playSound('hit', 0.6);\n        return true; // Damage taken\n    },\n    \n    activateShield() {\n        this.hasShield = true;\n        this.shieldTime = CONSTANTS.POWERUP.SHIELD_DURATION;\n        AudioManager.playSound('powerup', 0.5, 1.5);\n    },\n    \n    activateSpeedBoost() {\n        this.speedBoostTime = CONSTANTS.POWERUP.SPEED_DURATION;\n        AudioManager.playSound('powerup', 0.5, 1.3);\n    },\n    \n    addLife() {\n        AudioManager.playSound('powerup', 0.5, 1.1);\n    },\n    \n    render(ctx) {\n        const sprite = AssetLoader.get('player');\n        if (!sprite) return;\n        \n        const frameWidth = 96;\n        const frameHeight = 96;\n        const sx = this.animationFrame * frameWidth;\n        const sy = 0;\n        \n        // Flash when invulnerable\n        if (this.invulnerabilityTime > 0 && Math.floor(this.invulnerabilityTime / 50) % 2 === 0) {\n            ctx.globalAlpha = 0.5;\n        }\n        \n        // Shield effect\n        if (this.hasShield) {\n            ctx.save();\n            ctx.strokeStyle = CONSTANTS.COLORS.POWERUP_SHIELD;\n            ctx.lineWidth = 3;\n            ctx.shadowColor = CONSTANTS.COLORS.POWERUP_SHIELD;\n            ctx.shadowBlur = 15;\n            ctx.beginPath();\n            ctx.arc(this.x + this.width / 2, this.y + this.height / 2, this.width, 0, Math.PI * 2);\n            ctx.stroke();\n            ctx.restore();\n        }\n        \n        // Speed boost trail\n        if (this.speedBoostTime > 0) {\n            ctx.fillStyle = CONSTANTS.COLORS.POWERUP_SPEED;\n            ctx.globalAlpha = 0.3;\n            for (let i = 1; i <= 3; i++) {\n                ctx.fillRect(this.x - i * 10, this.y + 10, this.width, this.height - 20);\n            }\n            ctx.globalAlpha = 1;\n        }\n        \n        // Draw player sprite\n        const drawHeight = this.isSliding ? CONSTANTS.PLAYER.SLIDE_HEIGHT : this.height;\n        const drawY = this.isSliding ? this.y + (this.height - drawHeight) : this.y;\n        \n        ctx.drawImage(sprite, sx, sy, frameWidth, frameHeight, this.x, drawY, this.width, drawHeight);\n        \n        ctx.globalAlpha = 1;\n    }\n};\n\nwindow.Player = Player;",
  "src/entities/obstacle.js": "const Obstacle = {\n    obstacles: [],\n    particles: [],\n    spawnTimer: 0,\n    nextSpawnDistance: 0,\n    distanceTraveled: 0,\n    \n    init() {\n        this.obstacles = [];\n        this.particles = [];\n        this.spawnTimer = 0;\n        this.distanceTraveled = 0;\n        this.nextSpawnDistance = this.getRandomSpawnDistance();\n    },\n    \n    getRandomSpawnDistance() {\n        const base = CONSTANTS.OBSTACLE.BASE_SPAWN_INTERVAL;\n        const min = CONSTANTS.OBSTACLE.MIN_SPAWN_INTERVAL;\n        // Distance decreases as game progresses\n        const factor = Math.max(0.3, 1 - this.distanceTraveled / 10000);\n        return Helpers.randomInt(min, base * factor);\n    },\n    \n    update(deltaTime, gameSpeed, difficulty) {\n        this.distanceTraveled += gameSpeed * deltaTime;\n        \n        // Spawn obstacles\n        this.spawnTimer += gameSpeed * deltaTime;\n        if (this.spawnTimer >= this.nextSpawnDistance) {\n            this.spawnObstacle(difficulty);\n            this.spawnTimer = 0;\n            this.nextSpawnDistance = this.getRandomSpawnDistance();\n        }\n        \n        // Update obstacles\n        for (let i = this.obstacles.length - 1; i >= 0; i--) {\n            const obs = this.obstacles[i];\n            obs.x -= gameSpeed * deltaTime;\n            \n            // Update obstacle-specific behavior\n            this.updateObstacleBehavior(obs, deltaTime);\n            \n            // Remove off-screen obstacles\n            if (obs.x + obs.width < -50) {\n                this.obstacles.splice(i, 1);\n            }\n        }\n        \n        // Update particles\n        for (let i = this.particles.length - 1; i >= 0; i--) {\n            const p = this.particles[i];\n            p.x += p.vx * deltaTime;\n            p.y += p.vy * deltaTime;\n            p.vy += 0.001 * deltaTime; // gravity\n            p.life -= deltaTime;\n            p.alpha = p.life / p.maxLife;\n            \n            if (p.life <= 0) {\n                this.particles.splice(i, 1);\n            }\n        }\n    },\n    \n    spawnObstacle(difficulty) {\n        const lane = Helpers.randomInt(0, CONSTANTS.PLAYER.LANES - 1);\n        const laneX = CONSTANTS.DESIGN_WIDTH / 2 + (lane - 1) * CONSTANTS.PLAYER.LANE_WIDTH;\n        \n        // Determine obstacle type based on difficulty\n        const types = this.getAvailableTypes(difficulty);\n        const type = types[Helpers.randomInt(0, types.length - 1)];\n        \n        let obstacle = {\n            x: CONSTANTS.DESIGN_WIDTH + 50,\n            lane: lane,\n            type: type,\n            passed: false,\n            animationTime: 0\n        };\n        \n        switch (type) {\n            case CONSTANTS.OBSTACLE.TYPES.SPIKE:\n                obstacle.width = 48;\n                obstacle.height = 48;\n                obstacle.y = CONSTANTS.DESIGN_HEIGHT - 80 - obstacle.height;\n                obstacle.hitbox = { x: 8, y: 8, w: 32, h: 40 };\n                break;\n            case CONSTANTS.OBSTACLE.TYPES.BALL:\n                obstacle.width = 48;\n                obstacle.height = 48;\n                obstacle.y = CONSTANTS.DESIGN_HEIGHT - 80 - obstacle.height;\n                obstacle.radius = 20;\n                obstacle.hitbox = { x: 4, y: 4, w: 40, h: 40 };\n                // Balls can bounce\n                obstacle.bounce = Helpers.randomFloat(0.5, 1.5);\n                obstacle.bouncePhase = Helpers.randomFloat(0, Math.PI * 2);\n                break;\n            case CONSTANTS.OBSTACLE.TYPES.WALL:\n                obstacle.width = 120;\n                obstacle.height = 48;\n                obstacle.y = CONSTANTS.DESIGN_HEIGHT - 80 - obstacle.height;\n                obstacle.hitbox = { x: 10, y: 0, w: 100, h: 48 };\n                break;\n            case CONSTANTS.OBSTACLE.TYPES.GAP:\n                // Gap is a missing section of ground - handled in rendering\n                obstacle.width = CONSTANTS.PLAYER.LANE_WIDTH * 1.5;\n                obstacle.height = 80;\n                obstacle.y = CONSTANTS.DESIGN_HEIGHT - 80;\n                obstacle.isGap = true;\n                break;\n            case CONSTANTS.OBSTACLE.TYPES.POWERUP:\n                obstacle.width = 48;\n                obstacle.height = 48;\n                obstacle.y = CONSTANTS.DESIGN_HEIGHT - 80 - obstacle.height - Helpers.randomInt(0, 60);\n                obstacle.powerupType = ['speed', 'shield', 'life'][Helpers.randomInt(0, 2)];\n                obstacle.hitbox = { x: 4, y: 4, w: 40, h: 40 };\n                obstacle.bobPhase = Helpers.randomFloat(0, Math.PI * 2);\n                break;\n        }\n        \n        this.obstacles.push(obstacle);\n    },\n    \n    getAvailableTypes(difficulty) {\n        const types = [CONSTANTS.OBSTACLE.TYPES.SPIKE];\n        \n        if (difficulty >= 1) types.push(CONSTANTS.OBSTACLE.TYPES.BALL);\n        if (difficulty >= 2) types.push(CONSTANTS.OBSTACLE.TYPES.WALL);\n        if (difficulty >= 1) types.push(CONSTANTS.OBSTACLE.TYPES.GAP);\n        if (difficulty >= 0) types.push(CONSTANTS.OBSTACLE.TYPES.POWERUP);\n        \n        // Weight powerups less\n        const weighted = [...types];\n        if (types.includes(CONSTANTS.OBSTACLE.TYPES.POWERUP)) {\n            // Add extra spikes/balls to reduce powerup frequency\n            weighted.push(CONSTANTS.OBSTACLE.TYPES.SPIKE, CONSTANTS.OBSTACLE.TYPES.BALL);\n        }\n        \n        return weighted;\n    },\n    \n    updateObstacleBehavior(obs, deltaTime) {\n        obs.animationTime += deltaTime;\n        \n        if (obs.type === CONSTANTS.OBSTACLE.TYPES.BALL) {\n            // Bouncing animation\n            obs.bouncePhase += deltaTime * 0.01;\n            const bounceOffset = Math.sin(obs.bouncePhase) * obs.bounce * 10;\n            obs.y = CONSTANTS.DESIGN_HEIGHT - 80 - obs.height + bounceOffset;\n        } else if (obs.type === CONSTANTS.OBSTACLE.TYPES.POWERUP) {\n            // Bobbing animation\n            obs.bobPhase += deltaTime * 0.005;\n            obs.y += Math.sin(obs.bobPhase) * 0.5;\n        }\n    },\n    \n    createParticles(x, y, color, count = 10) {\n        for (let i = 0; i < count; i++) {\n            const angle = Helpers.randomFloat(0, Math.PI * 2);\n            const speed = Helpers.randomFloat(0.5, 2);\n            this.particles.push({\n                x: x,\n                y: y,\n                vx: Math.cos(angle) * speed,\n                vy: Math.sin(angle) * speed - Helpers.randomFloat(0, 1),\n                size: Helpers.randomFloat(2, 6),\n                color: color,\n                life: Helpers.randomFloat(300, 800),\n                maxLife: 800,\n                alpha: 1\n            });\n        }\n    },\n    \n    checkCollision(playerHitbox) {\n        for (let i = this.obstacles.length - 1; i >= 0; i--) {\n            const obs = this.obstacles[i];\n            \n            if (obs.type === CONSTANTS.OBSTACLE.TYPES.GAP) {\n                // Gap collision handled separately\n                continue;\n            }\n            \n            if (obs.type === CONSTANTS.OBSTACLE.TYPES.POWERUP) {\n                const powerupHitbox = {\n                    x: obs.x + obs.hitbox.x,\n                    y: obs.y + obs.hitbox.y,\n                    w: obs.hitbox.w,\n                    h: obs.hitbox.h\n                };\n                \n                if (Helpers.checkAABB(playerHitbox, powerupHitbox)) {\n                    const type = obs.powerupType;\n                    this.obstacles.splice(i, 1);\n                    this.createParticles(obs.x + obs.width / 2, obs.y + obs.height / 2, \n                        CONSTANTS.COLORS[`POWERUP_${type.toUpperCase()}`], 15);\n                    return { type: 'powerup', powerupType: type };\n                }\n                continue;\n            }\n            \n            const obsHitbox = {\n                x: obs.x + obs.hitbox.x,\n                y: obs.y + obs.hitbox.y,\n                w: obs.hitbox.w,\n                h: obs.hitbox.h\n            };\n            \n            if (Helpers.checkAABB(playerHitbox, obsHitbox)) {\n                this.createParticles(obs.x + obs.width / 2, obs.y + obs.height / 2, \n                    CONSTANTS.COLORS[obs.type.toUpperCase()], 12);\n                return { type: 'obstacle', obstacle: obs };\n            }\n        }\n        return null;\n    },\n    \n    checkGapCollision(player) {\n        for (const obs of this.obstacles) {\n            if (obs.type === CONSTANTS.OBSTACLE.TYPES.GAP && obs.lane === player.currentLane) {\n                const gapLeft = obs.x;\n                const gapRight = obs.x + obs.width;\n                const playerLeft = player.x;\n                const playerRight = player.x + player.width;\n                \n                // Player is over gap\n                if (playerRight > gapLeft && playerLeft < gapRight) {\n                    // Check if player is grounded (falling into gap)\n                    if (player.isGrounded && !player.isJumping) {\n                        return true;\n                    }\n                }\n            }\n        }\n        return false;\n    },\n    \n    render(ctx) {\n        // Render obstacles\n        for (const obs of this.obstacles) {\n            if (obs.type === CONSTANTS.OBSTACLE.TYPES.GAP) {\n                // Render gap as dark pit\n                ctx.fillStyle = '#000000';\n                ctx.fillRect(obs.x, obs.y, obs.width, obs.height);\n                // Edge highlight\n                ctx.fillStyle = CONSTANTS.COLORS.SPIKE;\n                ctx.fillRect(obs.x, obs.y, 4, obs.height);\n                ctx.fillRect(obs.x + obs.width - 4, obs.y, 4, obs.height);\n                continue;\n            }\n            \n            const asset = AssetLoader.get(obs.type === CONSTANTS.OBSTACLE.TYPES.POWERUP ? \n                `powerup_${obs.powerupType}` : obs.type);\n            \n            if (asset) {\n                ctx.drawImage(asset, obs.x, obs.y, obs.width, obs.height);\n            } else {\n                // Fallback rendering\n                ctx.fillStyle = CONSTANTS.COLORS[obs.type.toUpperCase()] || '#fff';\n                ctx.fillRect(obs.x, obs.y, obs.width, obs.height);\n            }\n        }\n        \n        // Render particles\n        for (const p of this.particles) {\n            ctx.globalAlpha = p.alpha;\n            ctx.fillStyle = p.color;\n            ctx.beginPath();\n            ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);\n            ctx.fill();\n        }\n        ctx.globalAlpha = 1;\n    }\n};\n\nwindow.Obstacle = Obstacle;",
  "src/systems/collision.js": "const CollisionSystem = {\n    checkPlayerObstacle(player, obstacles) {\n        const playerHitbox = player.getHitbox();\n        return Obstacle.checkCollision(playerHitbox);\n    },\n    \n    checkPlayerGap(player, obstacles) {\n        return Obstacle.checkGapCollision(player);\n    },\n    \n    // Broad phase: quick distance check before detailed collision\n    broadPhaseCheck(player, obstacle) {\n        const dx = Math.abs((player.x + player.width / 2) - (obstacle.x + obstacle.width / 2));\n        const dy = Math.abs((player.y + player.height / 2) - (obstacle.y + obstacle.height / 2));\n        const maxDist = (player.width + obstacle.width) / 2 + 20;\n        return dx < maxDist && dy < maxDist;\n    }\n};\n\nwindow.CollisionSystem =