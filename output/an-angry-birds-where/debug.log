game.js content:

```javascript
const canvas = document.getElementById('gameCanvas');
const ctx = canvas.getContext('2d');

function resizeCanvas() {
  canvas.width = window.innerWidth;
  canvas.height = window.innerHeight;
}
window.addEventListener('resize', resizeCanvas);
resizeCanvas();

let game = {
  birds: [],
  structures: [],
  pigs: [],
  timer: 60,
  startTime: 0,
  score: 0,
  highScore: parseInt(localStorage.getItem('angry_avian_highscore')) || 0,
  birdCount: 5,
  gameOver: false,
  paused: false,
};

function loadLevel() {
  // Simple level data
  game.structures = [
    { x: 200, y: 150, w: 300, h: 100, health: 30, type: 'wood' },
    { x: 500, y: 120, w: 200, h: 80, health: 20, type: 'stone' },
  ];
  game.pigs = [
    { x: 250, y: 160, w: 30, h: 30, health: 10, type: 'wood' },
    { x: 550, y: 130, w: 30, h: 30, health: 10, type: 'stone' },
  ];
}
loadLevel();

function update(dt) {
  if (game.gameOver) return;
  // Timer
  game.timer = 60 - Math.floor((performance.now() - game.startTime) / 1000);
  if (game.timer <= 0) {
    endGame(false);
    return;
  }

  // Update birds
  for (let bird of game.birds) {
    bird.update(dt);
    if (bird.y > canvas.height) {
      // bird went off screen, remove
      game.birds = game.birds.filter(b => b !== bird);
      game.birdCount--;
    }
  }

  // Update structures (e.g., falling)
  // Not needed for simple static structures

  // Check collisions
  for (let bird of game.birds) {
    for (let struct of game.structures) {
      if (collideAABB(bird, struct)) {
        applyDamage(bird, struct);
        // remove bird after hit
        game.birds = game.birds.filter(b => b !== bird);
        game.birdCount--;
        break;
      }
    }
    for (let pig of game.pigs) {
      if (collideAABB(bird, pig)) {
        applyDamage(bird, pig);
        game.birds = game.birds.filter(b => b !== bird);
        game.birdCount--;
        break;
      }
    }
  }

  // Remove dead structures
  game.structures = game.structures.filter(s => s.health > 0);
  game.pigs = game.pigs.filter(p => p.health > 0);

  // Check win condition
  if (game.structures.length === 0 && game.pigs.length === 0) {
    endGame(true);
  }
}

function applyDamage(bird, target) {
  let damage = 0;
  switch (bird.type) {
    case 'basic': damage = 1; break;
    case 'egg': damage = 5; break;
    case 'boomerang': damage = 2; break;
    case 'ice': damage = 1; break;
    case 'poison': damage = 1; break;
  }
  target.health -= damage;
  game.score += damage * 10;
  // Play sound
  playSFX(800, 0.05);
}

// Simple AABB collision
function collideAABB(a, b) {
  return a.x < b.x + b.w &&
         a.x + a.radius > b.x &&
         a.y < b.y + b.h &&
         a.y + a.radius > b.y;
}

// End game
function endGame(won) {
  game.gameOver = true;
  const high = game.score > game.highScore ? game.score : game.highScore;
  localStorage.setItem('angry_avian_highscore', high);
  showResult(won);
}

// Show result overlay
function showResult(won) {
  const overlay = document.createElement('div');
  overlay.id = 'resultOverlay';
  overlay.style.position = 'absolute';
  overlay.style.top = '50%';
  overlay.style.left = '50%';
  overlay.style.transform = 'translate(-50%, -50%)';
  overlay.style.textAlign = 'center';
  overlay.style.color = '#fff';
  overlay.style.fontSize = '24px';
  overlay.style.background = 'rgba(0,0,0,0.8)';
  overlay.style.padding = '20px';
  overlay.style.borderRadius = '10px';
  overlay.innerHTML = won
    ? `<h1>Victory!</h1><p>Score: ${game.score}</p><p>Stars: ★★★</p>`
    : `<h1>Defeat</h1><p>Score: ${game.score}</p><p>Stars: ★★</p>`;
  document.body.appendChild(overlay);
}

// Game loop
let lastTime = 0;
function gameLoop(timestamp) {
  const dt = (timestamp - lastTime) / 1000; // seconds
  lastTime = timestamp;
  update(dt);
  render();
  requestAnimationFrame(gameLoop);
}
requestAnimationFrame(gameLoop);

// Input handling for slingshot
let isDragging = false;
let dragStart = { x: 0, y: 0 };
let launchAngle = 0;
let launchPower = 0;

canvas.addEventListener('mousedown', (e) => {
  if (game.gameOver || game.paused) return;
  isDragging = true;
  const rect = canvas.getBoundingClientRect();
  dragStart = { x: e.clientX - rect.left, y: e.clientY - rect.top };
  launchAngle = Math.atan2(dragStart.y - canvas.height/2, dragStart.x - canvas.width/2);
  launchPower = Math.min(Math.hypot(dragStart.x - canvas.width/2, dragStart.y - canvas.height/2) / 100, 10);
});
canvas.addEventListener('mouseup', (e) => {
  if (!isDragging) return;
  isDragging = false;
  launchBird(launchAngle, launchPower);
});
canvas.addEventListener('mousemove', (e) => {
  if (!isDragging) return;
  const rect = canvas.getBoundingClientRect();
  const cur = { x: e.clientX - rect.left, y: e.clientY - rect.top };
  // Update visual indicator (not needed for code)
});

function launchBird(angle, power) {
  if (game.birdCount <= 0) return;
  const birdType = getBirdType(); // random or selector
  const radius = 15;
  const x = canvas.width/2 - radius;
  const y = canvas.height/2 - radius;
  const vx = Math.cos(angle) * power * 200;
  const vy = Math.sin(angle) * power * 200;
  const bird = new Bird(birdType, x, y, vx, vy);
  game.birds.push(bird);
  game.birdCount--;
  playSFX(600, 0.1);
}

// Bird type selector (simple random)
function getBirdType() {
  const types = ['basic','egg','boomerang','ice','poison'];
  return types[Math.floor(Math.random()*types.length)];
}

// Rendering
function render() {
  // Clear
  ctx.clearRect(0,0,canvas.width,canvas.height);

  // Draw background gradient
  const grad = ctx.createLinearGradient(0,0,0,canvas.height);
  grad.addColorStop(0,'#87CEEB');
  grad.addColorStop(1,'#00BFFF');
  ctx.fillStyle = grad;
  ctx.fillRect(0,0,canvas.width,canvas.height);

  // Draw structures
  for (let s of game.structures) {
    ctx.fillStyle = s.type === 'wood' ? '#8B4513' : '#7F7F7F';
    ctx.fillRect(s.x, s.y, s.w, s.h);
  }
  // Draw pigs
  for (let p of game.pigs) {
    ctx.fillStyle = '#FF0000';
    ctx.fillRect(p.x, p.y, p.w, p.h);
  }

  // Draw birds
  for (let b of game.birds) {
    ctx.fillStyle = '#FFD700';
    ctx.beginPath();
    ctx.arc(b.x, b.y, b.radius, 0, Math.PI*2);
    ctx.fill();
  }

  // HUD
  drawHUD();

  // Timer
  ctx.fillStyle = '#fff';
  ctx.font = '20px Arial';
  ctx.fillText(`Time: ${game.timer}s`, 10, 30);
}

// HUD drawing
function drawHUD() {
  const hud = document.getElementById('hud');
  if (!hud) return;
  hud.innerHTML = `<span>Birds: ${game.birdCount}/5</span>`;
}

// End game overlay already shown via showResult

// Sound
function playSFX(freq, dur) {
  const ctx = new (window.AudioContext || window.webkitAudioContext)();
  const osc = ctx.createOscillator();
  osc.type = 'sine';
  osc.frequency.value = freq;
  const gain = ctx.createGain();
  gain.gain.value = 0.2;
  osc.connect(gain).connect(ctx.destination);
  osc.start();
  osc.stop(ctx.currentTime + dur);
}

// Initialize start time
game.startTime = performance.now();
```

