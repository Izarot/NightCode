// Simple sprite batching and FPS cap
const FPS = 60;
function limitFPS(timestamp) {
  const interval = 1000 / FPS;
  if (timestamp - lastFrame < interval) {
    requestAnimationFrame(limitFPS);
    return;
  }
  lastFrame = timestamp;
}
let lastFrame = 0;
requestAnimationFrame(limitFPS);
