"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <title>Angry Avian Assault</title>\n  <link rel=\"icon\" href=\"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='0.9em' font-size='80'>🐦</text></svg>\" alt=\"Emoji Favicon\"/>\n  <style>\n    body { margin:0; overflow:hidden; background:linear-gradient(to bottom, #87CEEB, #00BFFF); font-family:Arial, sans-serif; }\n    canvas { display:block; width:100%; height:100%; }\n    #hud { position:absolute; top:10px; left:10px; color:#fff; font-size:18px; background:rgba(0,0,0,0.5); padding:5px; border-radius:5px; }\n    #resultOverlay { position:absolute; top:50%; left:50%; transform:translate(-50%,-50%); text-align:center; color:#fff; font-size:24px; background:rgba(0,0,0,0.8); padding:20px; border-radius:10px; }\n    .colorblind { filter: invert(1) hue-rotate(180deg); }\n  </style>\n</head>\n<body>\n  <canvas id=\"gameCanvas\"></canvas>\n  <div id=\"hud\"></div>\n  <script src=\"game.js\" defer></script>\n  <script src=\"physics.js\" defer></script>\n  <script src=\"birds.js\" defer></script>\n  <script src=\"structures.js\" defer></script>\n  <script src=\"hud.js\" defer></script>\n  <script src=\"post-level-screen.js\" defer></script>\n  <script src=\"sound.js\" defer></script>\n  <script src=\"accessibility.js\" defer></script>\n  <script src=\"achievements.js\" defer></script>\n  <script src=\"worker.js\" defer></script>\n  <script src=\"optimization.js\" defer></script>\n</body>\n</html>"

