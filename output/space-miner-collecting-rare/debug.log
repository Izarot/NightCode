Raw: {"index.html":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Void Miner: Asteroid Rift</title>\n<link rel=\"icon\" href=\"data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ctext y='.9em' font-size='90'%3E🚀%3C/text%3E%3C/svg%3E\">\n<style>\n* { margin: 0; padding: 0; box-sizing: border-box; }\nbody { background: #050510; overflow: hidden; font-family: 'Courier New', Courier, monospace; color: #00ffff; }\ncanvas { display: block; width: 100vw; height: 100vh; }\n</style>\n</head>\n<body>\n<canvas id=\"gameCanvas\"></canvas>\n<script src=\"game.js\"></script>\n</body>\n</html>","game.js":"const canvas = document.getElementById('gameCanvas');\nconst ctx = canvas.getContext('2d');\nlet W, H;\nfunction resize(){ W = canvas.width = window.innerWidth; H = canvas.height = window.innerHeight; }\nwindow.addEventListener('resize', resize); resize();\n\nconst COLORS = { bg:'#050510', ship:'#00ffcc', common:'#a0a0a0', rare:'#00ffff', epic:'#8a2be2', legendary:'#ffd700', ui:'#00ffff', heat:'#ff3333' };\nconst TIERS = [\n  {name:'Common', color:COLORS.common, hp:50, value:10, weight:60},\n  {name:'Rare', color:COLORS.rare, hp:100, value:50, weight:30},\n  {name:'Epic', color:COLORS.epic, hp:200, value:150, weight:8},\n  {name:'Legendary', color:COLORS.legendary, hp:500, value:400, weight:2}\n];\n\nlet audioCtx;\nfunction initAudio(){ if(!audioCtx) audioCtx = new (window.AudioContext||window.webkitAudioContext)(); }\nfunction playSound(type){\n  if(!audioCtx) return;\n  const osc = audioCtx.createOscillator();\n  const gain = audioCtx.createGain();\n  osc.connect(gain); gain.connect(audioCtx.destination);\n  const now = audioCtx.currentTime;\n  if(type==='laser'){ osc.type='square'; osc.frequency.setValueAtTime(800,now); gain.gain.setValueAtTime(0.08,now); gain.gain.exponentialRampToValueAtTime(0.01,now+0.08); osc.start(now); osc.stop(now+0.08); }\n  else if(type==='hit'){ osc.type='sine'; osc.frequency.setValueAtTime(120,now); osc.frequency.exponentialRampToValueAtTime(40,now+0.1); gain.gain.setValueAtTime(0.15,now); gain.gain.exponentialRampToValueAtTime(0.01,now+0.1); osc.start(now); osc.stop(now+0.1); }\n  else if(type==='thrust'){ osc.type='sawtooth'; osc.frequency.setValueAtTime(140,now); gain.gain.setValueAtTime(0.04,now); gain.gain.exponentialRampToValueAtTime(0.01,now+0.15); osc.start(now); osc.stop(now+0.15); }\n}\n\nlet state='MENU', score=0, highScore=parseInt(localStorage.getItem('vmhs')||'0'), startTime=0, timer=0;\nlet particles=[], asteroids=[], stars=[];\nfor(let i=0;i<150;i++) stars.push({x:Math.random()*W,y:Math.random()*H,s:Math.random()*2+0.5});\n\nconst ship = {x:W/2,y:H/2,vx:0,vy:0,angle:-Math.PI/2,thrust:false,left:false,right:false,fire:false,heat:0,maxHeat:100,shield:100,hull:100,radius:12,overheat:0};\nconst keys={};\nlet laserTimer=0;\n\nfunction spawnAsteroid(){\n  const roll = Math.random()*100;\n  let w=0, tier=null;\n  for(const t of TIERS){ w+=t.weight; if(roll<w){tier=t;break;} }\n  if(!tier) tier=TIERS[0];\n  let x,y;\n  if(Math.random()>0.5){ x = Math.random()<0.5?-60:W+60; y=Math.random()*H; }\n  else { x=Math.random()*W; y=Math.random()<0.5?-60:H+60; }\n  asteroids.push({x,y,vx:(Math.random()-0.5)*50,vy:(Math.random()-0.5)*50,radius:20+tier.hp/12,hp:tier.hp,maxHp:tier.hp,tier,color:tier.color,angle:Math.random()*Math.PI*2,va:(Math.random()-0.5)*2,verts:Math.floor(Math.random()*6)+5});\n}\n\nfunction resetGame(){\n  ship.x=W/2; ship.y=H/2; ship.vx=0; ship.vy=0; ship.angle=-Math.PI/2; ship.heat=0; ship.shield=100; ship.hull=100; ship.overheat=0;\n  asteroids=[]; particles=[]; score=0; startTime=Date.now(); timer=0;\n  for(let i=0;i<6;i++) spawnAsteroid();\n}\n\nwindow.addEventListener('keydown',e=>e=>{keys[e.code]=true;initAudio();if(e.code==='Space')ship.fire=true;if(e.code==='KeyR'&&state==='GAMEOVER')resetGame();if(e.code==='KeyM'&&state==='MENU'){state='PLAY';resetGame();}});\nwindow.addEventListener('keyup',e=>{keys[e.code]=false;if(e.code==='Space')ship.fire=false;});\n\nfunction spawnParticle(x,y,color,count=6){for(let i=0;i<count;i++){particles.push({x,y:vx:(Math.random()-0.5)*100,vy:(Math.random()-0.5)*100,life:1,color,size:Math.random()*3+1});}}\n\nfunction update(dt){\n  if(state!=='PLAY')return;\n  timer=(Date.now()-startTime)/1000;\n  \n  // Ship movement\n  if(ship.left) ship.angle-=3*dt;\n  if(ship.right) ship.angle+=3*dt;\n  ship.thrust=keys['KeyW']||keys['ArrowUp'];\n  if(ship.thrust){\n    ship.vx+=Math.cos(ship.angle)*150*dt;\n    ship.vy+=Math.sin(ship.angle)*150*dt;\n    ship.heat+=20*dt;\n    playSound('thrust');\n    spawnParticle(ship.x-Math.cos(ship.angle)*14, ship.y-Math.sin(ship.angle)*14, '#ffaa00', 1);\n  }\n  ship.vx*=0.98;\n  ship.vy*=0.98;\n  ship.x+=ship.vx*dt;\n  ship.y+=ship.vy*dt;\n  \n  // Wrap around\n  if(ship.x<-50)ship.x=W+50;if(ship.x>W+50)ship.x=-50;\n  if(ship.y<-50)ship.y=H+50;if(ship.y>H+50)ship.y=-50;\n  \n  // Heat\n  if(ship.heat>0)ship.heat-=10*dt;\n  if(ship.heat>100){ship.heat=100;ship.overheat=1;}\n  else ship.overheat=0;\n  \n  // Fire\n  if(ship.fire && ship.heat<100 && laserTimer<=0){\n    laserTimer=0.15;\n    ship.heat+=15;\n    playSound('laser');\n    const lx=ship.x+Math.cos(ship.angle)*18;\n    const ly=ship.y+Math.sin(ship.angle)*18;\n    for(let a of asteroids){\n      const dx=lx-a.x, dy=ly-a.y;\n      if(dx*dx+dy*dy<a.radius*a.radius+100){\n        a.hp-=25;\n        spawnParticle(a.x,a.y,a.color,3);\n        playSound('hit');\n        if(a.hp<=0){score+=a.tier.value;spawnParticle(a.x,a.y,a.color,10);}\n      }\n    }\n  }\n  if(laserTimer>0)laserTimer-=dt;\n  \n  // Asteroids\n  if(Math.random()<0.02)spawnAsteroid();\n  for(let i=asteroids.length-1;i>=0;i--){\n    let a=asteroids[i];\n    a.x+=a.vx*dt;a.y+=a.vy*dt;a.angle+=a.va*dt;\n    if(a.x<-100)a.x=W+100;if(a.x>W+100)a.x=-100;\n    if(a.y<-100)a.y=H+100;if(a.y>H+100)a.y=-100;\n    \n    const dx=ship.x-a.x, dy=ship.y-a.y;\n    if(dx*dx+dy*dy<(ship.radius+a.radius)*(ship.radius+a.radius)){\n      if(ship.shield>0){ship.shield-=20*dt*10;if(ship.shield<0)ship.shield=0;}\n      else {ship.hull-=20*dt*10;if(ship.hull<0)ship.hull=0;}\n      spawnParticle(a.x,a.y,a.color,2);\n      if(ship.hull<=0){state='GAMEOVER';if(score>highScore){highScore=score;localStorage.setItem('vmhs',String(highScore));}}\n    }\n    if(a.hp<=0){asteroids.splice(i,1);score+=a.tier.value;spawnParticle(a.x,a.y,a.color,8);}\n  }\n  \n  // Particles\n  for(let i=particles.length-1;i>=0;i--){\n    let p=particles[i];\n    p.x+=p.vx*dt;p.y+=p.vy*dt;p.life-=2*dt;\n    if(p.life<=0)particles.splice(i,1);\n  }\n}\n\nfunction draw(){\n  ctx.fillStyle=COLORS.bg;\n  ctx.fillRect(0,0,W,H);\n  \n  // Stars\n  ctx.fillStyle='#ffffff';\n  for(let s of stars){ctx.globalAlpha=0.5;ctx.fillRect(s.x,s.y,s.s,s.s);}\n  ctx.globalAlpha=1;\n  \n  if(state==='PLAY'||state==='GAMEOVER'){\n    // Ship\n    ctx.save();\n    ctx.translate(ship.x,ship.y);\n    ctx.rotate(ship.angle);\n    ctx.strokeStyle=ship.overheat?COLORS.heat:COLORS.ship;\n    ctx.lineWidth=2;\n    ctx.beginPath();\n    ctx.moveTo(16,0);ctx.lineTo(-10,8);ctx.lineTo(-10,-8);ctx.closePath();\n    ctx.stroke();\n    ctx.restore();\n    \n    // Laser\n    if(ship.fire && laserTimer>0){\n      ctx.beginPath();\n      ctx.moveTo(ship.x+Math.cos(ship.angle)*18, ship.y+Math.sin(ship.angle)*18);\n      ctx.lineTo(ship.x+Math.cos(ship.angle)*600, ship.y+Math.sin(ship.angle)*600);\n      ctx.strokeStyle=COLORS.ship;\n      ctx.lineWidth=2;\n      ctx.stroke();\n    }\n    \n    // Asteroids\n    for(let a of asteroids){\n      ctx.save();\n      ctx.translate(a.x,a.y);\n      ctx.rotate(a.angle);\n      ctx.strokeStyle=a.color;\n      ctx.lineWidth=2;\n      ctx.beginPath();\n      for(let v=0;v<=a.verts;v++){\n        const ang=(v/a.verts)*Math.PI*2;\n        const r=a.radius+(Math.sin(v*7)*4);\n        ctx.lineTo(Math.cos(ang)*r,Math.sin(ang)*r);\n      }\n      ctx.closePath();\n      ctx.stroke();\n      ctx.restore();\n      \n      // HP bar\n      ctx.fillStyle='#333';\n      ctx.fillRect(a.x-a.radius,a.y-a.radius-10,a.radius*2,4);\n      ctx.fillStyle=a.color;\n      ctx.fillRect(a.x-a.radius,a.y-a.radius-10,(a.radius*2)*(a.hp/a.maxHp),4);\n    }\n    \n    // Particles\n    for(let p of particles){\n      ctx.globalAlpha=p.life;\n      ctx.fillStyle=p.color;\n      ctx.beginPath();\n      ctx.arc(p.x,p.y,p.size,0,Math.PI*2);\n      ctx.fill();\n    }\n    ctx.globalAlpha=1;\n    \n    // UI\n    ctx.fillStyle=COLORS.ui;\n    ctx.font='16px Courier New';\n    ctx.fillText(`SCORE ${score}`,20,30);\n    ctx.fillText(`HULL ${Math.max(0,Math.floor(ship.hull))}%`,20,50);\n    ctx.fillText(`SHIELD ${Math.max(0,Math.floor(ship.shield))}%`,20,70);\n    ctx.fillText(`HEAT ${Math.floor(ship.heat)}`,20,90);\n    ctx.fillText(`TIME ${Math.floor(timer)}s`,20,110);\n    \n    // Heat bar\n    ctx.fillStyle='#222';\n    ctx.fillRect(20,100,100,8);\n    ctx.fillStyle=ship.overheat?COLORS.heat:COLORS.ui;\n    ctx.fillRect(20,100,ship.heat,8);\n  }\n  \n  if(state==='MENU'){\n    ctx.textAlign='center';\n    ctx.fillStyle=COLORS.ui;\n    ctx.font='32px Courier New';\n    ctx.fillText('VOID MINER',W/2,H/2-40);\n    ctx.font='16px Courier New';\n    ctx.fillText('PRESS M TO START',W/2,H/2+10);\n    ctx.fillText(`HIGH SCORE: ${highScore}`,W/2,H/2+40);\n    ctx.textAlign='left';\n  }\n  \n  if(state==='GAMEOVER'){\n    ctx.textAlign='center';\n    ctx.fillStyle=COLORS.heat;\n    ctx.font='32px Courier New';\n    ctx.fillText('HULL BREACH',W/2,H/2-40);\n    ctx.fillStyle=COLORS.ui;\n    ctx.font='16px Courier New';\n    ctx.fillText(`FINAL SCORE: ${score}`,W/2,H/2+10);\n    ctx.fillText(`HIGH SCORE: ${highScore}`,W/2,H/2+40);\n    ctx.fillText('PRESS R TO RESTART',W/2,H/2+70);\n    ctx.textAlign='left';\n  }\n}\n\nfunction loop(){update(0.016);draw();requestAnimationFrame(loop