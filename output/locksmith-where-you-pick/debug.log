}

function drawPinIndicator() {
  const w = actualW();
  const h = actualH();
  const ix = 60;
  const iy = h * 0.35;
  
  ctx.fillStyle = '#2a2a2a';
  ctx.beginPath();
  ctx.arc(ix, iy, 40, 0, Math.PI * 2);
  ctx.fill();
  
  for (let i = 0; i < gameState.pinCount; i++) {
    const angle = -Math.PI/2 + (i / (gameState.pinCount - 1)) * Math.PI;
    const px = ix + Math.cos(angle) * 25;
    const py = iy + Math.sin(angle) * 25;
    
    ctx.fillStyle = gameState.pins[i]?.set ? '#d4a017' : '#5a5a5a';
    ctx.beginPath();
    ctx.arc(px, py, 6, 0, Math.PI * 2);
    ctx.fill();
  }
  
  ctx.fillStyle = '#3a3a3a';
  ctx.beginPath();
  ctx.arc(ix, iy, 10, 0, Math.PI * 2);
  ctx.fill();
  
  ctx.fillStyle = '#f5f5dc';
  ctx.font = 'bold 14px monospace';
  ctx.textAlign = 'center';
  ctx.textBaseline = 'middle';
  ctx.fillText(gameState.currentPin + 1, ix, iy);
}

function draw() {
  ctx.clearRect(0, 0, actualW(), actualH());
  drawLock();
  
  if (gameState.precision) {
    const w = actualW();
    const h = actualH();
    ctx.strokeStyle = 'rgba(139, 92, 246, 0.3)';
    ctx.lineWidth = 2;
    ctx.setLineDash([5, 5]);
    ctx.strokeRect(w * 0.1, h * 0.1, w * 0.8, h * 0.8);
    ctx.setLineDash([]);
  }
}

let lastTime = 0;
function gameLoop(timestamp) {
  const dt = Math.min((timestamp - lastTime) / 1000, 0.1);
  lastTime = timestamp;
  
  update(dt);
  draw();
  
  requestAnimationFrame(gameLoop);
}

document.getElementById('startBtn').addEventListener('click', () => {
  const selected = document.querySelector('#difficultySelect button.active');
  gameState.difficulty = parseInt(selected?.dataset.difficulty || '1');
  overlay.classList.add('hidden');
  gameState.active = true;
  initLock();
  if (audioCtx.state === 'suspended') audioCtx.resume();
});

document.querySelectorAll('#difficultySelect button').forEach(btn => {
  btn.addEventListener('click', () => {
    document.querySelectorAll('#difficultySelect button').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
  });
});

document.getElementById('nextLockBtn').addEventListener('click', () => {
  gameState.lockNumber++;
  if (gameState.lockNumber > gameState.totalLocks) {
    gameState.lockNumber = 1;
    gameState.difficulty = Math.min(gameState.difficulty + 1, 8);
  }
  completeScreen.classList.remove('show');
  initLock();
  gameState.active = true;
});

document.getElementById('menuBtn').addEventListener('click', () => {
  gameState.active = false;
  gameState.lockNumber = 1;
  completeScreen.classList.remove('show');
  overlay.classList.remove('hidden');
});

document.getElementById('startBtn').addEventListener('mouseenter', () => {
  playTone(800, 0.05, 'sine', 0.1);
});

document.getElementById('startBtn').addEventListener('click', () => {
  playTone(600, 0.1, 'sine', 0.15);
});

requestAnimationFrame(gameLoop);
</script>
</body>
</html>