ew Projectile(spawnX, spawnY, vx, vy);\n    }\n\n    render(ctx) {\n        ctx.save();\n        ctx.translate(this.x, this.y);\n\n        // Base\n        ctx.beginPath();\n        ctx.arc(0, 0, 25, 0, Math.PI * 2);\n        ctx.fillStyle = COLORS.launcher;\n        ctx.fill();\n        ctx.strokeStyle = '#5a5a6a';\n        ctx.lineWidth = 2;\n        ctx.stroke();\n\n        // Barrel\n        ctx.rotate(this.angle);\n        ctx.fillStyle = '#4a4a5a';\n        ctx.fillRect(0, -this.barrelWidth / 2, this.barrelLength, this.barrelWidth);\n        ctx.strokeStyle = '#6a6a7a';\n        ctx.strokeRect(0, -this.barrelWidth / 2, this.barrelLength, this.barrelWidth);\n\n        // Barrel opening\n        ctx.beginPath();\n        ctx.arc(this.barrelLength, 0, this.barrelWidth / 2 + 2, 0, Math.PI * 2);\n        ctx.fillStyle = '#2a2a3a';\n        ctx.fill();\n\n        ctx.restore();\n\n        // Cooldown indicator\n        if (this.cooldown > 0) {\n            const progress = 1 - (this.cooldown / this.maxCooldown);\n            ctx.beginPath();\n            ctx.arc(this.x, this.y, 30, -Math.PI / 2, -Math.PI / 2 + progress * Math.PI * 2);\n            ctx.strokeStyle = '#666666';\n            ctx.lineWidth = 3;\n            ctx.stroke();\n        } else {\n            ctx.beginPath();\n            ctx.arc(this.x, this.y, 30, 0, Math.PI * 2);\n            ctx.strokeStyle = COLORS.accent;\n            ctx.lineWidth = 3;\n            ctx.stroke();\n        }\n    }\n\n    setPosition(x, y) {\n        this.x = x;\n        this.y = y;\n    }\n\n    setCooldown(cooldown) {\n        this.maxCooldown = cooldown;\n    }\n}\n\n// ============================================\n// HUD\n// ============================================\nclass HUD {\n    constructor() {\n        this.score = 0;\n        this.combo = 1;\n        this.maxCombo = 1;\n        this.comboTimer = 0;\n        this.highScore = parseInt(localStorage.getItem('glowOrbHighScore')) || 0;\n        this.time = 0;\n        this.comboPulse = 0;\n    }\n\n    addScore(points, orbY, canvasHeight) {\n        let totalPoints = points;\n        if (orbY < canvasHeight / 2) {\n            totalPoints += 5;\n        }\n        this.score += totalPoints * this.combo;\n        if (this.score > this.highScore) {\n            this.highScore = this.score;\n            localStorage.setItem('glowOrbHighScore', this.highScore.toString());\n        }\n        return totalPoints * this.combo;\n    }\n\n    incrementCombo() {\n        if (this.comboTimer > 0) {\n            this.combo = Math.min(this.combo + 1, CONFIG.MAX_COMBO);\n            if (this.combo > this.maxCombo) this.maxCombo = this.combo;\n        }\n        this.comboTimer = CONFIG.COMBO_WINDOW;\n        this.comboPulse = 1;\n    }\n\n    resetCombo() {\n        this.combo = 1;\n        this.comboTimer = 0;\n    }\n\n    update(deltaTime) {\n        if (this.comboTimer > 0) {\n            this.comboTimer -= deltaTime;\n            if (this.comboTimer <= 0) {\n                this.combo = 1;\n            }\n        }\n        if (this.comboPulse > 0) {\n            this.comboPulse -= 0.05;\n        }\n        this.time += deltaTime;\n    }\n\n    formatTime(ms) {\n        const totalSeconds = Math.floor(ms / 1000);\n        const minutes = Math.floor(totalSeconds / 60);\n        const seconds = totalSeconds % 60;\n        return `${minutes.toString().padStart(2, '0')}:${seconds.toString().padStart(2, '0')}`;\n    }\n\n    render(ctx, canvas) {\n        // Background bar\n        ctx.fillStyle = 'rgba(0, 0, 0, 0.5)';\n        ctx.fillRect(0, 0, canvas.width, 45);\n\n        ctx.font = '18px Orbitron, monospace';\n        ctx.textBaseline = 'middle';\n        ctx.letterSpacing = '2px';\n\n        const y = 25;\n        let x = 20;\n\n        // Score\n        ctx.fillStyle = COLORS.text;\n        ctx.fillText(`SCORE: ${this.score.toString().padStart(4, '0')}`, x, y);\n        x += 200;\n\n        // Combo\n        if (this.combo > 1 || this.comboPulse > 0) {\n            const scale = 1 + this.comboPulse * 0.2;\n            ctx.save();\n            ctx.translate(x + 50, y);\n            ctx.scale(scale, scale);\n            ctx.fillStyle = COLORS.accent;\n            ctx.fillText(`COMBO: x${this.combo}`, -50, 0);\n            ctx.restore();\n        } else {\n            ctx.fillStyle = '#888888';\n            ctx.fillText('COMBO: x1', x, y);\n        }\n        x += 200;\n\n        // High Score\n        ctx.fillStyle = '#aaaaaa';\n        ctx.fillText(`HIGH: ${this.highScore.toString().padStart(4, '0')}`, x, y);\n        x += 180;\n\n        // Timer\n        ctx.fillStyle = COLORS.text;\n        ctx.fillText(`${this.formatTime(this.time)}`, x, y);\n    }\n\n    reset() {\n        this.score = 0;\n        this.combo = 1;\n        this.maxCombo = 1;\n        this.comboTimer = 0;\n        this.time = 0;\n        this.comboPulse = 0;\n        this.highScore = parseInt(localStorage.getItem('glowOrbHighScore')) || 0;\n    }\n}\n\n// ============================================\n// INPUT MANAGER\n// ============================================\nclass InputManager {\n    constructor(canvas) {\n        this.canvas = canvas;\n        this.mouseX = 0;\n        this.mouseY = 0;\n        this.mouseDown = false;\n        this.touchActive = false;\n        this.keys = {};\n\n        this.setupListeners();\n    }\n\n    setupListeners() {\n        this.canvas.addEventListener('mousemove', (e) => {\n            const rect = this.canvas.getBoundingClientRect();\n            const scaleX = this.canvas.width / rect.width;\n            const scaleY = this.canvas.height / rect.height;\n            this.mouseX = (e.clientX - rect.left) * scaleX;\n            this.mouseY = (e.clientY - rect.top) * scaleY;\n        });\n\n        this.canvas.addEventListener('mousedown', (e) => {\n            e.preventDefault();\n            this.mouseDown = true;\n        });\n\n        this.canvas.addEventListener('mouseup', (e) => {\n            e.preventDefault();\n            this.mouseDown = false;\n        });\n\n        this.canvas.addEventListener('touchstart', (e) => {\n            e.preventDefault();\n            this.touchActive = true;\n            this.handleTouch(e.touches[0]);\n        }, { passive: false });\n\n        this.canvas.addEventListener('touchmove', (e) => {\n            e.preventDefault();\n            if (e.touches.length > 0) {\n                this.handleTouch(e.touches[0]);\n            }\n        }, { passive: false });\n\n        this.canvas.addEventListener('touchend', (e) => {\n            e.preventDefault();\n            this.touchActive = false;\n            this.mouseDown = false;\n        }, { passive: false });\n\n        document.addEventListener('keydown', (e) => {\n            this.keys[e.key.toLowerCase()] = true;\n        });\n\n        document.addEventListener('keyup', (e) => {\n            this.keys[e.key.toLowerCase()] = false;\n        });\n    }\n\n    handleTouch(touch) {\n        const rect = this.canvas.getBoundingClientRect();\n        const scaleX = this.canvas.width / rect.width;\n        const scaleY = this.canvas.height / rect.height;\n        this.mouseX = (touch.clientX - rect.left) * scaleX;\n        this.mouseY = (touch.clientY - rect.top) * scaleY;\n        this.mouseDown = true;\n    }\n\n    isKeyPressed(key) {\n        return this.keys[key.toLowerCase()] || false;\n    }\n}\n\n// ============================================\n// STAR FIELD BACKGROUND\n// ============================================\nclass StarField {\n    constructor(canvas) {\n        this.stars = [];\n        this.canvas = canvas;\n        this.generateStars();\n    }\n\n    generateStars() {\n        this.stars = [];\n        for (let i = 0; i < 50; i++) {\n            this.stars.push({\n                x: Math.random() * this.canvas.width,\n                y: Math.random() * this.canvas.height,\n                size: 0.5 + Math.random() * 1.5,\n                opacity: 0.2 + Math.random() * 0.4\n            });\n        }\n    }\n\n    render(ctx) {\n        this.stars.forEach(star => {\n            ctx.beginPath();\n            ctx.arc(star.x, star.y, star.size, 0, Math.PI * 2);\n            ctx.fillStyle = `rgba(255, 255, 255, ${star.opacity})`;\n            ctx.fill();\n        });\n    }\n\n    resize(canvas) {\n        this.canvas = canvas;\n        this.generateStars();\n    }\n}\n\n// ============================================\n// MAIN GAME CLASS\n// ============================================\nclass Game {\n    constructor() {\n        this.canvas = document.getElementById('gameCanvas');\n        this.ctx = this.canvas.getContext('2d');\n        this.audio = new AudioManager();\n        this.input = new InputManager(this.canvas);\n        this.particles = new ParticleSystem();\n        this.hud = new HUD();\n        this.starField = new StarField(this.canvas);\n\n        this.state = 'title'; // title, playing, paused, gameover\n        this.orb = null;\n        this.projectiles = [];\n        this.launcher = null;\n\n        this.gravity = CONFIG.GRAVITY;\n        this.launchCooldown = CONFIG.LAUNCH_COOLDOWN;\n        this.lastTime = 0;\n        this.difficultyTimer = 0;\n        this.orbHitCooldown = new Set();\n\n        this.resize();\n        this.setupEventListeners();\n        this.init();\n\n        document.getElementById('loading').style.display = 'none';\n        requestAnimationFrame((t) => this.gameLoop(t));\n    }\n\n    init() {\n        this.orb = new Orb(this.canvas.width / 2, this.canvas.height / 3);\n        this.launcher = new Launcher(80, this.canvas.height - 80);\n        this.launcher.setCooldown(this.launchCooldown);\n        this.projectiles = [];\n        this.hud.reset();\n        this.gravity = CONFIG.GRAVITY;\n        this.launchCooldown = CONFIG.LAUNCH_COOLDOWN;\n        this.launcher.setCooldown(this.launchCooldown);\n        this.difficultyTimer = 0;\n        this.orbHitCooldown.clear();\n    }\n\n    resize() {\n        const minWidth = 800;\n        const minHeight = 600;\n        const maxWidth = window.innerWidth;\n        const maxHeight = window.innerHeight;\n\n        // Calculate aspect ratio maintaining minimum size\n        let width = Math.max(minWidth, maxWidth);\n        let height = Math.max(minHeight, maxHeight);\n\n        // Scale down for mobile\n        const scale = Math.min(1, Math.min(width / minWidth, height / minHeight));\n        width = Math.floor(minWidth * scale);\n        height = Math.floor(minHeight * scale);\n\n        // For responsive scaling, use CSS instead\n        this.canvas.style.width = maxWidth + 'px';\n        this.canvas.style.height = maxHeight + 'px';\n        this.canvas.width = maxWidth;\n        this.canvas.height = maxHeight;\n\n        if (this.starField) {\n            this.starField.resize(this.canvas);\n        }\n        if (this.launcher) {\n            this.launcher.setPosition(80, this.canvas.height - 80);\n        }\n    }\n\n    setupEventListeners() {\n        window.addEventListener('resize', () => this.resize());\n    }\n\n    handleInput() {\n        // Update launcher aim\n        this.launcher.setAngle(this.input.mouseX, this.input.mouseY);\n\n        // Fire projectile\n        if ((this.input.mouseDown || this.input.isKeyPressed(' ')) && this.state === 'playing') {\n            this.tryFireProjectile();\n            this.input.mouseDown = false;\n        }\n\n        // Keyboard controls\n        if (this.input.isKeyPressed('r')) {\n            this.restart();\n        }\n        if (this.input.isKeyPressed('p') && this.state === 'playing') {\n            this.state = 'paused';\n        } else if (this.input.isKeyPressed('p') && this.state === 'paused') {\n            this.state = 'playing';\n        }\n\n        // Click to start/restart\n        if (this.input.mouseDown) {\n            if (this.state === 'title') {\n                this.state = 'playing';\n                this.audio.init();\n            } else if (this.state === 'gameover') {\n                this.restart();\n            }\n            this.input.mouseDown = false;\n        }\n    }\n\n    tryFireProjectile() {\n        if (this.launcher.canFire() && this.projectiles.length < CONFIG.MAX_PROJECTILES) {\n            const projectile= this.launcher.fire();
            if (projectile) {
                this.projectiles.push(projectile);
                this.audio.playSound('fire');
                this.particles.emit(projectile.x, projectile.y, 5, 'rgba(255, 107, 53, 1)', [2, 5], [2, 5], [10, 20]);
            }
        }

        checkCollisions() {
            for (let i = this.projectiles.length - 1; i >= 0; i--) {
                const proj = this.projectiles[i];
                if (!proj.active) continue;

                // Projectile-Orb collision
                const dx = proj.x - this.orb.x;
                const dy = proj.y - this.orb.y;
                const dist = Math.sqrt(dx * dx + dy * dy);
                const minDist = proj.radius + this.orb.radius;

                if (dist < minDist) {
                    // Elastic collision response
                    const nx = dx / dist;
                    const ny = dy / dist;
                    const dvx = proj.vx - this.orb.vx;
                    const dvy = proj.vy - this.orb.vy;
                    const dvn = dvx * nx + dvy * ny;

                    if (dvn > 0) {
                        const m1 = proj.mass;
                        const m2 = this.orb.mass;
                        const impulse = (2 * dvn) / (m1 + m2);

                        proj.vx -= impulse * m2 * nx * 0.8;
                        proj.vy -= impulse * m2 * ny * 0.8;
                        this.orb.vx += impulse * m1 * nx * 1.2;
                        this.orb.vy += impulse * m1 * ny * 1.2;

                        // Separate objects
                        const overlap = minDist - dist;
                        proj.x += nx * overlap * 0.5;
                        proj.y += ny * overlap * 0.5;
                        this.orb.x -= nx * overlap * 0.5;
                        this.orb.y -= ny * overlap * 0.5;

                        // Score and effects
                        const points = this.hud.addScore(10, this.orb.y, this.canvas.height);
                        this.hud.incrementCombo();
                        this.particles.emitCollisionSparks((proj.x + this.orb.x) / 2, (proj.y + this.orb.y) / 2);
                        this.particles.emit((proj.x + this.orb.x) / 2, (proj.y + this.orb.y) / 2, 8, 'rgba(255, 200, 100, 1)', [3, 7], [3, 6], [15, 30]);
                        this.audio.playSound('bounce');

                        if (this.hud.combo >= 3) {
                            this.audio.playSound('combo');
                        }
                    }
                }

                // Wall collisions for scoring
                if (proj.x - proj.radius < 5 || proj.x + proj.radius > this.canvas.width - 5) {
                    if (!this.orbHitCooldown.has('wall')) {
                        this.hud.addScore(2, this.orb.y, this.canvas.height);
                        this.orbHitCooldown.add('wall');
                        setTimeout(() => this.orbHitCooldown.delete('wall'), 100);
                    }
                }
            }
        }

        updateDifficulty() {
            this.difficultyTimer++;
            if (this.difficultyTimer % 600 === 0) { // Every 10 seconds
                this.gravity = Math.min(CONFIG.MAX_GRAVITY, this.gravity + 0.005);
                this.launchCooldown = Math.max(CONFIG.MIN_COOLDOWN, this.launchCooldown - 10);
                this.launcher.setCooldown(this.launchCooldown);
            }
        }

        update(deltaTime) {
            if (this.state !== 'playing') return;

            this.hud.update(deltaTime);
            this.launcher.update(deltaTime);

            const orbHitFloor = this.orb.update(this.gravity, this.particles, this);

            this.projectiles = this.projectiles.filter(p => p.update(this.gravity, this.canvas));
            this.particles.update();
            this.checkCollisions();
            this.updateDifficulty();

            if (orbHitFloor) {
                this.gameOver();
            }
        }

        gameOver() {
            this.state = 'gameover';
            this.audio.playSound('gameover');
            this.particles.emit(this.orb.x, this.orb.y, 30, 'rgba(255, 50, 50, 1)', [5, 15], [5, 10], [30, 60]);
        }

        restart() {
            this.init();
            this.state = 'playing';
            this.audio.init();
        }

        render() {
            // Background
            this.ctx.fillStyle = COLORS.background;
            this.ctx.fillRect(0, 0, this.canvas.width, this.canvas.height);

            // Stars
            this.starField.render(this.ctx);

            // Floor
            this.ctx.fillStyle = 'rgba(50, 50, 70, 0.5)';
            this.ctx.fillRect(0, this.canvas.height - 50, this.canvas.width, 50);

            // Floor glow line
            const floorGradient = this.ctx.createLinearGradient(0, this.canvas.height - 50, 0, this.canvas.height - 45);
            floorGradient.addColorStop(0, 'rgba(255, 50, 50, 0.8)');
            floorGradient.addColorStop(1, 'rgba(255, 50, 50, 0)');
            this.ctx.fillStyle = floorGradient;
            this.ctx.fillRect(0, this.canvas.height - 50, this.canvas.width, 5);

            // Danger zone indicator
            this.ctx.fillStyle = 'rgba(255, 50, 50, 0.1)';
            this.ctx.fillRect(0, this.canvas.height - 100, this.canvas.width, 50);

            // Top boundary
            this.ctx.fillStyle = 'rgba(100, 100, 150, 0.3)';
            this.ctx.fillRect(0, 0, this.canvas.width, 30);
            this.ctx.strokeStyle = 'rgba(100, 100, 150, 0.5)';
            this.ctx.beginPath();
            this.ctx.moveTo(0, 30);
            this.ctx.lineTo(this.canvas.width, 30);
            this.ctx.stroke();

            // Render game objects
            this.projectiles.forEach(p => p.render(this.ctx));
            if (this.state !== 'gameover') {
                this.orb.render(this.ctx);
            }
            this.particles.render(this.ctx);
            this.launcher.render(this.ctx);

            // HUD
            if (this.state === 'playing' || this.state === 'paused' || this.state === 'gameover') {
                this.hud.render(this.ctx, this.canvas);
            }

            // State overlays
            if (this.state === 'title') {
                this.renderTitleScreen();
            } else if (this.state === 'paused') {
                this.renderPauseScreen();
            } else if (this.state === 'gameover') {
                this.renderGameOverScreen();
            }
        }

        renderTitleScreen() {
            this.ctx.fillStyle = 'rgba(0, 0, 0, 0.7)';
            this.ctx.fillRect(0, 0, this.canvas.width, this.canvas.height);

            this.ctx.textAlign = 'center';
            this.ctx.textBaseline = 'middle';

            // Title
            this.ctx.font = 'bold 64px Orbitron, monospace';
            this.ctx.fillStyle = COLORS.orbCore;
            this.ctx.shadowColor = COLORS.orbCore;
            this.ctx.shadowBlur = 30;
            this.ctx.fillText('GLOW ORB', this.canvas.width / 2, this.canvas.height / 3);
            this.ctx.shadowBlur = 0;

            // Instructions
            this.ctx.font = '24px Orbitron, monospace';
            this.ctx.fillStyle = COLORS.text;
            this.ctx.fillText('Aim with mouse, click or SPACE to fire', this.canvas.width / 2, this.canvas.height / 2);
            this.ctx.fillText('Keep the orb in the air!', this.canvas.width / 2, this.canvas.height / 2 + 40);

            // Start prompt
            const pulse = 0.5 + 0.5 * Math.sin(Date.now() / 300);
            this.ctx.fillStyle = `rgba(57, 255, 20, ${pulse})`;
            this.ctx.fillText('Click or tap to start', this.canvas.width / 2, this.canvas.height / 2 + 120);

            this.ctx.textAlign = 'left';
        }

        renderPauseScreen() {
            this.ctx.fillStyle = 'rgba(0, 0, 0, 0.5)';
            this.ctx.fillRect(0, 0, this.canvas.width, this.canvas.height);

            this.ctx.textAlign = 'center';
            this.ctx.textBaseline = 'middle';
            this.ctx.font = 'bold 48px Orbitron, monospace';
            this.ctx.fillStyle = COLORS.text;
            this.ctx.fillText('PAUSED', this.canvas.width / 2, this.canvas.height / 2);

            this.ctx.font = '24px Orbitron, monospace';
            this.ctx.fillStyle = '#aaaaaa';
            this.ctx.fillText('Press P or click to continue', this.canvas.width / 2, this.canvas.height / 2 + 50);

            this.ctx.textAlign = 'left';
        }

        renderGameOverScreen() {
            this.ctx.fillStyle = 'rgba(0, 0, 0, 0.8)';
            this.ctx.fillRect(0, 0, this.canvas.width, this.canvas.height);

            this.ctx.textAlign = 'center';
            this.ctx.textBaseline = 'middle';

            // Game Over
            this.ctx.font = 'bold 56px Orbitron, monospace';
            this.ctx.fillStyle = '#ff4444';
            this.ctx.shadowColor = '#ff4444';
            this.ctx.shadowBlur = 20;
            this.ctx.fillText('GAME OVER', this.canvas.width / 2, this.canvas.height / 3 - 40);
            this.ctx.shadowBlur = 0;

            // Final score
            this.ctx.font = '32px Orbitron, monospace';
            this.ctx.fillStyle = COLORS.text;
            this.ctx.fillText(`Final Score: ${this.hud.score}`, this.canvas.width / 2, this.canvas.height / 2 - 30);

            // High score
            this.ctx.font = '24px Orbitron, monospace';
            this.ctx.fillStyle = COLORS.accent;
            this.ctx.fillText(`High Score: ${this.hud.highScore}`, this.canvas.width / 2, this.canvas.height / 2 + 20);

            // Max combo
            this.ctx.fillStyle = '#aaaaaa';
            this.ctx.fillText(`Max Combo: x${this.hud.maxCombo}`, this.canvas.width / 2, this.canvas.height / 2 + 60);

            // Restart prompt
            const pulse = 0.5 + 0.5 * Math.sin(Date.now() / 300);
            this.ctx.fillStyle = `rgba(57, 255, 20, ${pulse})`;
            this.ctx.fillText('Click or press R to restart', this.canvas.width / 2, this.canvas.height / 2 + 130);

            this.ctx.textAlign = 'left';
        }

        gameLoop(currentTime) {
            const deltaTime = currentTime - this.lastTime;
            this.lastTime = currentTime;

            this.handleInput();
            this.update(deltaTime);
            this.render();

            requestAnimationFrame((t) => this.gameLoop(t));
        }
    }

    // Start the game
    window.addEventListener('load', () => {
        new Game();
    });
`);

        const script = document.createElement('script');
        script.type = 'module';
        script.textContent = Game;
        document.body.appendChild(script);
    </script>
