v>\n        <button id=\"btnBringToLife\" class=\"prominent\">Bring to Life ▶</button>\n      </div>\n    </div>\n  </div>\n  <div id=\"levelSelectScreen\" class=\"screen\" style=\"display:none\">\n    <h2>Select Level</h2>\n    <div id=\"levelButtons\"></div>\n    <button id=\"btnBackToMenu\">Back</button>\n  </div>\n  <div id=\"pauseScreen\" class=\"screen overlay\" style=\"display:none\">\n    <h2>Paused</h2>\n    <button id=\"btnResume\">Resume</button>\n    <button id=\"btnRestartCheckpoint\">Restart Checkpoint</button>\n    <button id=\"btnRestartLevel\">Restart Level</button>\n    <button id=\"btnEditSketch\">Edit Sketch</button>\n    <button id=\"btnPauseSettings\">Settings</button>\n    <button id=\"btnQuitToMenu\">Return to Title</button>\n  </div>\n  <div id=\"levelCompleteScreen\" class=\"screen overlay\" style=\"display:none\">\n    <h2>Level Complete!</h2>\n    <div id=\"completionStats\"></div>\n    <button id=\"btnRetry\">Retry</button>\n    <button id=\"btnEditSketchComplete\">Edit Sketch</button>\n    <button id=\"btnNextLevel\">Next Level ▶</button>\n  </div>\n  <div id=\"campaignCompleteScreen\" class=\"screen overlay\" style=\"display:none\">\n    <h2>Campaign Complete!</h2>\n    <div id=\"campaignStats\"></div>\n    <button id=\"btnPlayAgain\">Play Again</button>\n  </div>\n  <div id=\"settingsScreen\" class=\"screen overlay\" style=\"display:none\">\n    <h2>Settings</h2>\n    <label>Music Volume:<input type=\"range\" id=\"musicVol\" min=\"0\" max=\"100\" value=\"50\"></label>\n    <label>SFX Volume:<input type=\"range\" id=\"sfxVol\" min=\"0\" max=\"100\" value=\"70\"></label>\n    <label><input type=\"checkbox\" id=\"reducedMotion\"> Reduced Motion</label>\n    <label><input type=\"checkbox\" id=\"highContrast\"> High Contrast Outlines</label>\n    <label><input type=\"checkbox\" id=\"showTimer\"> Show Timer</label>\n    <button id=\"btnSettingsBack\">Back</button>\n  </div>\n  <div id=\"toast\" class=\"toast\"></div>\n</div>\n<script src=\"game.js\"></script>\n</body>\n</html>", "style.css": "*{margin:0;padding:0;box-sizing:border-box}body{font-family:'Segoe UI',sans-serif;background:#1A1A2E;overflow:hidden;width:100vw;height:100vh;touch-action:none}#app{position:relative;width:100%;height:100%;display:flex;align-items:center;justify-content:center}canvas{display:block;image-rendering:auto}#gameCanvas{background:#FFF8E7;border-radius:4px;box-shadow:0 0 40px rgba(0,0,0,.5)}#hud{position:absolute;top:0;left:0;right:0;pointer-events:none;display:flex;justify-content:space-between;align-items:center;padding:8px 16px;background:linear-gradient(to bottom,rgba(255,248,231,.9),transparent);font-size:16px;color:#2D2D2D;font-weight:600}#hud-left,#hud-center,#hud-right{display:flex;align-items:center;gap:8px}#abilityBar{position:absolute;bottom:16px;left:50%;transform:translateX(-50%);pointer-events:none;background:rgba(255,255,255,.85);padding:6px 16px;border-radius:20px;font-size:14px;display:flex;align-items:center;gap:6px}#touchControls{position:absolute;bottom:0;left:0;right:0;display:none;justify-content:space-between;align-items:flex-end;padding:16px;pointer-events:none}#touchControls>*{pointer-events:auto}.touchBtn{width:56px;height:56px;border-radius:50%;border:2px solid rgba(45,45,45,.3);background:rgba(255,255,255,.7);font-size:20px;display:flex;align-items:center;justify-content:center;user-select:none;-webkit-user-select:none}#touchLeft,#touchRight{margin-left:8px}.touchBtn:active{background:rgba(255,200,200,.8)}#menuScreen,#workshopScreen,#levelSelectScreen,.overlay{position:absolute;top:0;left:0;right:0;bottom:0;display:flex;flex-direction:column;align-items:center;justify-content:center;background:rgba(26,26,46,.92);z-index:10;border-radius:4px}h1{font-size:42px;color:#FF6B6B;margin-bottom:24px;text-shadow:2px 2px 0 #2D2D2E}h2{font-size:28px;color:#2EC4B6;margin-bottom:16px}button{font-size:16px;padding:10px 24px;margin:6px;border:none;border-radius:8px;cursor:pointer;background:#9B5DE5;color:#fff;font-weight:600;transition:all .15s}button:hover{transform:scale(1.05);filter:brightness(1.1)}button:active{transform:scale(.97)}button.prominent{background:#FF6B6B;font-size:18px;padding:14px 32px}#workshopLayout{display:flex;gap:12px;max-width:95vw;max-height:90vh;overflow:auto}#toolRail{display:flex;flex-direction:column;gap:6px;padding:8px;background:rgba(255,255,255,.1);border-radius:8px;min-width:100px}#toolRail button{font-size:12px;padding:6px 10px;margin:2px}#drawingArea{background:#fff;border-radius:8px;box-shadow:0 2px 20px rgba(0,0,0,.2)}#previewPanel{display:flex;flex-direction:column;gap:8px;padding:8px;background:rgba(255,255,255,.1);border-radius:8px;min-width:180px}#previewPanel canvas{background:#f5f0e8;border-radius:4px}#rigControls label{font-size:12px;color:#fff;display:block;margin:4px 0}.toast{position:absolute;bottom:80px;left:50%;transform:translateX(-50%);background:rgba(45,45,45,.9);color:#fff;padding:8px 20px;border-radius:20px;font-size:14px;opacity:0;transition:opacity .3s;pointer-events:none}.toast.show{opacity:1}@media(max-width:768px){#workshopLayout{flex-direction:column;align-items:center}#toolRail{flex-direction:row;flex-wrap:wrap;min-width:auto}#touchControls{display:flex}#menuScreen h1{font-size:28px}button{font-size:14px;padding:8px 16px;margin:4px}}@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}", "game.js": "const C=Object.freeze({MAX_HSPEED:230,GROUND_ACC:1900,GROUND_BRK:2300,AIR_ACC:1200,AIR_BRK:250,GRAVITY:1500,JUMP_VEL:-540,MAX_FALL:780,COYOTE:110,JUMP_BUF:130,JUMP_CLAMP:-220,CHAR_W:32,CHAR_H:52,DRAW_W:72,DRAW_H:80,FEATHER_MAX_FALL:110,FEATHER_DUR:1.5,SPARK_DASH_SPD:560,SPARK_DUR:140,SPARK_COOLDOWN:750,SPRING_JUMP_VEL:-480,ONE_WAY_IGNORE:200,CRUMBLE_DELAY:500,CRUMBLE_RESPAWN:3000,BOUNCE_VEL:-690,MARGIN:100,SMOOTH:120,LOOK_AHEAD:80,SHAKE_MAX:4,MAX_PARTICLES:250,PHYSICS_DT:1/60,MAX_FRAME_DT:.1,MAX_STEPS:6,MAX_STROKES:200,MAX_POINTS:8000,UNDO_MAX:50,DRAW_CANVAS:480,MIN_PATH_LEN:12});\nconst LEVELS=[{name:'1. First Steps',width:3200,height:900,spawn:{x:100,y:400},exit:{x:3000,y:350},platforms:[{x:0,y:700,w:400,h:40},{x:500,y:650,w:200,h:20},{x:800,y:600,w:200,h:20},{x:1100,y:550,w:200,h:20},{x:1400,y:500,w:200,h:20},{x:1700,y:450,w:200,h:20},{x:2000,y:400,w:200,h:20},{x:2300,y:350,w:200,h:20},{x:2600,y:300,w:200,h:20},{x:2900,y:350,w:200,h:20}],hazards:[],checkpoints:[{x:600,y:700},{x:1800,y:450}],droplets:[{x:250,y:680,id:'d1_1'},{x:550,y:630,id:'d1_2'},{x:850,y:580,id:'d1_3'},{x:1150,y:530,id:'d1_4'},{x:1450,y:480,id:'d1_5'},{x:1750,y:430,id:'d1_6'},{x:2050,y:380,id:'d1_7'},{x:2350,y:330,id:'d1_8'},{x:2650,y:280,id:'d1_9'},{x:3050,y:330,id:'d1_10'},{x:300,y:550,id:'d1_11'},{x:900,y:500,id:'d1_12'},{x:1500,y:450,id:'d1_13'},{x:2100,y:400,id:'d1_14'},{x:2700,y:350,id:'d1_15'}],stars:[{x:400,y:500,id:'s1_1'},{x:1200,y:400,id:'s1_2'},{x:2400,y:250,id:'s1_3'}],doors:[]},{name:'2. Margin Hops',width:3800,height:900,spawn:{x:100,y:400},exit:{x:3500,y:350},platforms:[{x:0,y:750,w:300,h:20},{x:400,y:700,w:150,h:20,type:'oneWay'},{x:650,y:650,w:150,h:20},{x:900,y:600,w:150,h:20,type:'oneWay'},{x:1150,y:550,w:150,h:20},{x:1400,y:500,w:150,h:20,type:'oneWay'},{x:1650,y:450,w:150,h:20},{x:1900,y:400,w:150,h:20,type:'oneWay'},{x:2150,y:350,w:150,h:20},{x:2400,y:300,w:150,h:20,type:'oneWay'},{x:2650,y:350,w:150,h:20},{x:2900,y:300,w:150,h:20,type:'oneWay'},{x:3150,y:350,w:200,h:20}],hazards:[{x:350,y:770,w:40,h:10,type:'spike'},{x:700,y:720,w:40,h:10,type:'spike'},{x:1000,y:670,w:40,h:10,type:'spike'}],checkpoints:[{x:700,y:700},{x:2000,y:450}],droplets:[],stars:[],doors:[]},{name:'3. Eraser Alley',width:4000,height:900,spawn:{x:100,y:400},exit:{x:3700,y:350},platforms:[{x:0,y:750,w:300,h:20},{x:400,y:700,w:200,h:20},{x:700,y:650,w:200,h:20},{x:1000,y:600,w:200,h:20},{x:1300,y:550,w:200,h:20},{x:1600,y:500,w:200,h:20},{x:1900,y:450,w:200,h:20},{x:2200,y:400,w:200,h:20},{x:2500,y:350,w:200,h:20},{x:2800,y:300,w:200,h:20},{x:3100,y:350,w:200,h:20},{x:3400,y:300,w:200,h:20}],hazards:[{x:500,y:760,w:60,h:10,type:'spike',patrol:{dx:0,dy:0}},{x:1100,y:660,w:60,h:10,type:'spike',patrol:{dx:0,dy:0}},{x:1700,y:560,w:60,h:10,type:'spike',patrol:{dx:0,dy:0}},{x:2300,y:460,w:60,h:10,type:'spike',patrol:{dx:0,dy:0}},{x:2900,y:360,w:60,h:10,type:'spike',patrol:{dx:0,dy:0}}],checkpoints:[{x:500,y:750},{x:1900,y:500}],droplets:[],stars:[],doors:[]},{name:'4. Loose Pages',width:4500,height:900,spawn:{x:100,y:400},exit:{x:4200,y:350},platforms:[{x:0,y:750,w:200,h:20},{x:350,y:700,w:150,h:20,type:'moving',move:{dx:100,dy:0,spd:1}},{x:600,y:650,w:150,h:20},{x:850,y:600,w:150,h:20,type:'moving',move:{dx:0,dy:-80,spd:0.8}},{x:1100,y:550,w:150,h:20},{x:1350,y:500,w:150,h:20,type:'crumble'},{x:1600,y:450,w:150,h:20,type:'moving',move:{dx:150,dy:0,spd:1.2}},{x:1900,y:400,w:150,h:20},{x:2200,y:350,w:150,h:20,type:'crumble'},{x:2500,y:300,w:150,h:20,type:'moving',move:{dx:0,dy:100,spd:0.6}},{x:2800,y:350,w:150,h:20},{x:3100,y:300,w:150,h:20,type:'crumble'},{x:3400,y:350,w:150,h:20,type:'moving',move:{dx:100,dy:0,spd:1}},{x:3700,y:300,w:200,h:20}],hazards:[],checkpoints:[{x:700,y:700},{x:2000,y:450}],droplets:[],stars:[],doors:[]},{name:'5. The Big Doodle',width:5000,height:900,spawn:{x:100,y:400},exit:{x:4700,y:350},platforms:[{x:0,y:750,w:300,h:20},{x:400,y:700,w:200,h:20},{x:700,y:650,w:200,h:20,type:'moving',move:{dx:80,dy:0,spd:1}},{x:1000,y:600,w:200,h:20},{x:1300,y:550,w:200,h:20,type:'crumble'},{x:1600,y:500,w:200,h:20,type:'moving',move:{dx:0,dy:-60,spd:0.7}},{x:1900,y:450,w:200,h:20},{x:2200,y:400,w:200,h:20,type:'crumble'},{x:2500,y:350,w:200,h:20,type:'moving',move:{dx:100,dy:0,spd:1.5}},{x:2800,y:300,w:200,h:20},{x:3100,y:350,w:200,h:20,type:'crumble'},{x:3400,y:300,w:200,h:20,type:'moving',move:{dx:0,dy:80,spd:0.9}},{x:3700,y:250,w:200,h:20},{x:4000,y:300,w:200,h:20,type:'crumble'},{x:4300,y:350,w:200,h:20},{x:4600,y:300,w:200,h:20}],hazards:[{x:500,y:760,w:50,h:10,type:'spike'},{x:1200,y:660,w:50,h:10,type:'spike'},{x:2000,y:560,w:50,h:10,type:'spike'},{x:2800,y:460,w:50,h:10,type:'spike'},{x:3600,y:410,w:50,h:10,type:'spike'},{x:4400,y:460,w:50,h:10,type:'spike'}],checkpoints:[{x:600,y:750},{x:1400,y:550},{x:2300,y:350},{x:3300,y:300},{x:4200,y:300}],droplets:[],stars:[],doors:[]}];\nconst ABILITIES=[{id:'feather',name:'Feather',icon:'🪶',desc:'Float gently downward',cooldown:0}, {id:'spark',name:'Spark',icon:'⚡',desc:'Dash through obstacles',cooldown:C.SPARK_COOLDOWN}, {id:'spring',name:'Spring',icon:'🔵',desc:'Bounce high into the air',cooldown:0}];\nconst COLORS=['#FF6B6B','#FFD93D','#6BCB77','#4D96FF','#9B5DE5','#FF9578','#F15BB5','#00BBF9','#FEE440','#2EC4B6','#333333','#FFFFFF'];\nlet gameState='menu';let currentLevel=0;let player=null;let platforms=[];let droplets=[];let stars=[];let hazards=[];let checkpoints=[];let particles=[];let camera={x:0,y:0};let keys={};let touchState={left:false,right:false,jump:false,ability:false};let lastTime=0;let dt=0;let accumulatedDt=0;let pauseTime=0;let totalTime=0;let levelStartTime=0;let starsCollected=new Set();let dropletsCollected=new Set();let currentCheckpoint={x:100,y:400};let abilityState={type:null,timer:0,cooldown:0};let screenShake={x:0,y:0,intensity:0};let undoStack=[];let redoStack=[];let savedSketch=null;let completedLevels=new Set();\nfunction lerp(a,b,t){return a+(b-a)*t}function clamp(v,min,max){return Math.max(min,Math.min(max,v))}function randRange(a,b){return a+Math.random()*(b-a)}function dist(x1,y1,x2,y2){return Math.hypot(x2-x1,y2-y1)}function rectOverlap(ax,ay,aw,ah,bx,by,bw,bh){return ax<bx+bw&&ax+aw>bx&&ay<by+bh&&ay+ah>by}\nfunction showToast(msg,dur=2000){const t=document.getElementById('toast');t.textContent=msg;t.classList.add('show');clearTimeout(t._timer);t._timer=setTimeout(()=>t.classList.remove('show'),dur)}\nfunction screenFlash(color,dur=100){const c=document.createElement('canvas');c.width=canvas.width;c.height=canvas.height;const cx=c.getContext('2d');cx.fillStyle=color;cx.globalAlpha=.3;cx.fillRect(0,0,c.width,c.height);cx.globalAlpha=1;canvas._flashCtx=cx;canvas._flashTime=performance.now();canvas._flashDur=dur}\nfunction updateCamera(){const targetX=player.x-camera.x+C.MARGIN-C.CHAR_W/2;const targetY=player.y-camera.y+C.MARGIN-C.CHAR_H/2;camera.x=lerp(camera.x,targetX,.12);camera.y=lerp(camera.y,targetY,.12);camera.x=Math.max(0,Math.min(camera.x,levels[currentLevel].width-canvas.width+50));camera.y=Math.max(0,Math.min(camera.y,levels[currentLevel].height-canvas.height+50))}\nfunction spawnParticles(x,y,count,color,spd=100,life=1){for(let i=0;i<count&&particles.length<C.MAX_PARTICLES;i++){const a=Math.random()*Math.PI*2;const s=Math.random()*spd;particles.push({x,y,vx:Math.cos(a)*s,vy:Math.sin(a)*s,life,maxLife:life,color,size:2+Math.random()*3})}}\nfunction updateParticles(dt){for(let i=particles.length-1;i>=0;i--){const p=particles[i];p.x+=p.vx*dt;p.y+=p.vy*dt;p.vy+=400*dt;p.life-=dt;if(p.life<=0)particles.splice(i,1)}}\nfunction drawParticles(ctx){particles.forEach(p=>{const a=clamp(p.life/p.maxLife,0,1);ctx.globalAlpha=a;ctx.fillStyle=p.color;ctx.beginPath();ctx.arc(p.x-camera.x,p.y-camera.y,p.size,0,Math.PI*2);ctx.fill()});ctx.globalAlpha=1}\nfunction initPlayer(spawn){player={x:spawn.x,y:spawn.y,vx:0,vy:0,onGround:false,coyoteTimer:0,jumpBuffer:0,ability:type,null,abilityTimer:0,abilityCooldown:0,facing:1,w:C.CHAR_W,h:C.CHAR_H,wasOnGround:false,prevY:spawn.y,featherFallVel:0,sparkDashTimer:0,springBounce:0,oneWayTop:false}}function resetPlayerToCheckpoint(){initPlayer(currentCheckpoint);player.vx=0;player.vy=0}function initLevel(idx){const lv=LEVELS[idx];platforms=lv.platforms.map(p=>({...p,origX:p.x,origY:p.y,origDX:p.move?.dx||0,origDY:p.move?.dy||0,origSpd:p.move?.spd||1,timer:0,crumbling:false,crumbleTimer:0,respawnTimer:0,origW:p.w,origH:p.h}));droplets=lv.droplets.map(d=>({...d,collected:false,anim:Math.random()*Math.PI*2}));stars=lv.stars.map(s=>({...s,collected:false,anim:Math.random()*Math.PI*2,sparkParticles:[]}));hazards=lv.hazards.map(h=>({...h,patrolTimer:0,origX:h.x,origY:h.y}));checkpoints=lv.checkpoints.map(c=>({...c}));currentCheckpoint={x:lv.spawn.x,y:lv.spawn.y};starsCollected=new Set();dropletsCollected=new Set();abilityState={type:null,timer:0,cooldown:0};particles=[];screenShake={x:0,y:0,intensity:0};player=null;totalTime=0;levelStartTime=performance.now()}function startLevel(idx