renderHUD(){
const p=this.player;
document.getElementById('dist').textContent=this.dist.toFixed(1)+'M';
document.getElementById('mult').textContent='x'+p.mult;
document.getElementById('score').textContent=Math.floor(this.score);
document.getElementById('timer').textContent=Math.floor(this.time/60)+':'+String(Math.floor(this.time%60)).padStart(2,'0');
document.getElementById('bpm').textContent=String(Math.floor(this.hr)).padStart(3,'0');
document.getElementById('ecg').textContent='♥'.repeat(Math.max(1,Math.floor(this.hr/20)))+'♦'.repeat(Math.max(1,Math.floor((180-this.hr)/20)));
document.getElementById('d1').style.color=p.dashes>=1?'#00e5ff':'#333';
document.getElementById('d2').style.color=p.dashes>=2?'#00e5ff':'#333';
document.getElementById('d3').style.color=p.dashes>=3?'#00e5ff':'#333';
}
loop(t){
const dt=Math.min((t-this.lastT)/1000,1/G.FPS);
this.accum+=dt;
while(this.accum>=1/G.FPS){
this.update(1/G.FPS);
this.accum-=1/G.FPS;
}
this.lastT=t;
this.render();
requestAnimationFrame(p=>this.loop(p));
}
start(){
this.state='RUN';
this.player={x:150,y:G.H/2,w:24,h:16,vx:280,vy:0,state:'AIRBORNE',jumping:false,jumpT:0,grd:false,dashes:3,dashT:0,dashing:false,dashInv:false,timer:0,mult:1,multT:0,invT:0};
this.world.reset();
this.score=0;this.dist=0;this.time=0;this.hr=60;this.scroll=280;this.slowMo=0;
this.poolWBC.clear();this.poolAb.clear();this.poolChol.clear();this.poolFibrin.clear();this.poolCramp.clear();this.poolOrb.clear();this.poolOxy.clear();this.poolStem.clear();
this.audio.init();
document.getElementById('menu').classList.add('hid');
document.getElementById('over').classList.add('hid');
document.getElementById('h').classList.remove('hid');
this.lastT=performance.now();
}
gameOver(){
this.state='GAMEOVER';
document.getElementById('h').classList.add('hid');
document.getElementById('over').classList.remove('hid');
const s=this.dist;
if(s>this.best){this.best=s;localStorage.setItem('marrowBest',s.toString());this.updateBest()}
document.getElementById('stats').innerHTML=`<div><span>DISTANCE</span><span>${s.toFixed(1)}M</span></div><div><span>SCORE</span><span>${Math.floor(this.score)}</span></div><div><span>PEAK BPM</span><span>${Math.floor(this.hr)}</span></div><div><span>MAX MULT</span><span>x${this.player.mult}</span></div>${s>=this.best?'<div class="hs">★ NEW RECORD ★</div>':''}`;
}
spawnEnts(){
if(Math.random()<.008){const e=this.poolWBC.spawn();if(e)Object.assign(e,{x:this.world.offset+G.W+50,y:G.H*.2+Math.random()*G.H*.6,w:32,h:32,vx:-40,vy:0,type:'wbc',timer:0,state:'patrol'});}
if(Math.random()<.012){const e=this.poolAb.spawn();if(e){const bh=G.H*.15+Math.random()*G.H*.25;Object.assign(e,{x:this.world.offset+G.W+30,y:this.world.getBot(this.world.offset+G.W+30)-bh-60,w:24,h:bh,vx:0,vy:0,type:'ab'})}}
if(Math.random()<.015){const e=this.poolChol.spawn();if(e){const cx=this.world.offset+G.W+50;Object.assign(e,{x:cx,y:this.world.getTop(cx)-30,w:28,h:50,vx:0,vy:0,type:'chol'})}}
if(Math.random()<.006){const e=this.poolFibrin.spawn();if(e){Object.assign(e,{x:this.world.offset+G.W+30,y:0,w:15,h:G.H,type:'fibrin',timer:0,closed:false,gapY:80+Math.random()*(G.H-160)})}}
if(Math.random()<.004){const e=this.poolCramp.spawn();if(e){Object.assign(e,{x:this.world.offset+G.W+50,y:0,w:50,h:G.H,type:'cramp',timer:0,dur:1.2,str:.6})}}
if(Math.random()<.02){const e=this.poolOrb.spawn();if(e){Object.assign(e,{x:this.world.offset+G.W+50,y:G.H*.2+Math.random()*G.H*.6,w:12,h:12,vx:0,vy:0,type:'orb',timer:0})}}
if(Math.random()<.003){const e=this.poolOxy.spawn();if(e){Object.assign(e,{x:this.world.offset+G.W+50,y:G.H*.2+Math.random()*G.H*.6,w:18,h:18,vx:0,vy:0,type:'oxy',timer:0})}}
if(Math.random()<.002){const e=this.poolStem.spawn();if(e){Object.assign(e,{x:this.world.offset+G.W+50,y:G.H*.2+Math.random()*G.H*.6,w:16,h:16,vx:0,vy:0,type:'stem',timer:0})}}
}
update(dt){
if(this.state!=='RUN')return;
this.time+=dt;
this.dist+=this.scroll*dt/60;
this.score+=this.scroll*dt*this.player.mult*.01;
this.hr=Math.min(180,60+this.dist/100*1.2);
this.audio.setHR(this.hr);
this.ecgT+=dt;
if(this.ecgT>60/this.hr){this.ecgT=0;this.ecgBeat=8;this.audio.bpm()}
this.ecgBeat=Math.max(0,this.ecgBeat-dt*30);
const prog=Math.min(1,this.time/90);
this.scroll=280+prog*(620-280);
if(this.slowMo>0){this.slowMo-=dt;this.scroll*=1-this.slowMo*.6}
const eff=this.slowMo>0?.4:1;
this.world.update(dt,this.scroll*eff,this.hr,60+this.dist/50);
const p=this.player;
p.timer+=dt;
if(p.dashT>0)p.dashT-=dt*1000;
if(p.dashT<=0&&p.dashes<3)p.dashes++;
if(p.invT>0)p.invT-=dt;
if(p.multT>0){p.multT-=dt;if(p.multT<=0)p.mult=1}
if(this.jumpHeld&&!p.jumping){
if(p.grd){p.vy=G.JUMP_V;p.grd=false;p.jumping=true;p.jumpT=0;this.audio.jump()}
else if(p.dashes>0&&!p.dashing&&this.dashHeld){p.dashing=true;p.dashInv=true;p.dashT=G.DASH_DUR;p.invT=.4;p.dashes--;p.vx=150;p.timer=0;this.audio.dash();setTimeout(()=>{p.dashing=false;p.dashInv=false},400)}}
if(p.jumping&&this.jumpHeld){const held=performance.now()-this.jumpStart;if(held<G.JUMP_MAX){p.vy=G.JUMP_V*(1-held/G.JUMP_MAX*.5)}if(held>G.JUMP_MAX)p.jumping=false}else{p.jumping=false}
if(!this.jumpHeld)p.jumping=false;
p.vy+=G.GRAV*dt;
p.y+=p.vy*dt;
if(p.dashing)p.vx-=150*dt*2.5;else p.vx=Math.max(280,p.vx-100*dt);
const gh=this.world.getH(p.x);
const th=this.world.getH(p.x+p.w);
if(p.y+p.h>gh){p.y=gh-p.h;p.vy=0;p.grd=true}else if(p.y<th){p.grd=false}else{p.grd=true}
if(p.y<0){p.y=0;p.vy=0}
if(p.y+p.h>G.H){p.y=G.H-p.h;p.vy=-p.vy*.5}
this.spawnEnts();
this.poolWBC.update(dt);this.poolAb.update(dt);this.poolChol.update(dt);this.poolFibrin.update(dt);this.poolCramp.update(dt);this.poolOrb.update(dt);this.poolOxy.update(dt);this.poolStem.update(dt);
this.poolWBC.active.forEach(e=>{e.x-=this.scroll*eff*dt;if(e.state==='patrol'&&Math.abs(e.x-p.x)<120)e.state='lunge';if(e.state==='lunge'){const dx=p.x-e.x,dy=p.y-e.y,d=Math.sqrt(dx*dx+dy*dy);e.x+=dx/d*80*dt;e.y+=dy/d*80*dt}});
this.poolAb.active.forEach(e=>{e.y=this.world.getBot(e.x)-e.h});
this.poolFibrin.active.forEach(e=>{e.timer+=dt;if(e.timer>2)e.closed=!e.closed;e.timer=0});
this.poolCramp.active.forEach(e=>{e.timer+=dt;if(e.timer>e.dur)e.active=false});
this.poolOrb.active.forEach(e=>{e.x-=this.scroll*eff*dt;e.timer+=dt;e.y+=Math.sin(e.timer*3)*.5});
this.poolOxy.active.forEach(e=>{e.x-=this.scroll*eff*dt;e.timer+=dt;e.y+=Math.sin(e.timer*2)*.8});
this.poolStem.active.forEach(e=>{e.x-=this.scroll*eff*dt;e.timer+=dt;e.y+=Math.cos(e.timer*2.5)*.6});
if(!p.dashInv){
[this.poolWBC.active,this.poolAb.active,this.poolChol.active,this.poolCramp.active,this.poolFibrin.active].forEach(pool=>{pool.forEach(e=>{const ex=e.x-p.x,ey=e.y-p.y;if(Math.abs(ex)<(e.w+p.w)/2&&Math.abs(ey)<(e.h+p.h)/2){if(e.type==='fibrin'&&e.closed)return;if(e.type==='fibrin'&&Math.abs(e.y+e.gapY-p.y-p.h/2)>40)return;this.audio.hit();this.gameOver()}})})}
[this.poolOrb.active,this.poolOxy.active,this.poolStem.active].forEach(pool=>{for(let i=pool.length-1;i>=0;i--){const e=pool[i];const dx=e.x-p.x,dy=e.y-p.y;if(Math.sqrt(dx*dx+dy*dy)<(e.w+p.w)){if(e.type==='orb'){p.mult=Math.min(5,p.mult+1);p.multT=2;this.score+=10;this.audio.collect(p.mult)}else if(e.type==='oxy'){this.slowMo=.5}else if(e.type==='stem'){p.dashes=Math.min(3,p.dashes+1)}e.active=false}}});
}
render(){
const ctx=this.ctx;
ctx.fillStyle=C.BG1;
ctx.fillRect(0,0,G.W,G.H);
if(this.state==='MENU'||this.state==='GAMEOVER'){this.renderMenu();return}
const w=this.world;
const off=this.world.offset;
ctx.save();
for(let x=0;x<G.W;x+=3){
const h=w.getH(off+x);
ctx.fillStyle=`rgba(61,12,20,${.3+Math.sin(x*.02+this.time*2)*.1})`;
ctx.fillRect(x,0,3,h);
ctx.fillStyle=`rgba(61,12,20,${.3+Math.sin(x*.02+this.time*2)*.1})`;
ctx.fillRect(x,G.H-h,3,h)}
ctx.fillStyle=C.WALL;
ctx.beginPath();
ctx.moveTo(0,G.H);
for(let x=0;x<=G.W;x+=4){ctx.lineTo(x,G.H-w.getH(off+x))}
ctx.lineTo(G.W,G.H);ctx.closePath();ctx.fill();
ctx.beginPath();
ctx.moveTo(0,0);
for(let x=0;x<=G.W;x+=4){ctx.lineTo(x,w.getH(off+x))}
ctx.lineTo(G.W,0);ctx.closePath();ctx.fill();
ctx.strokeStyle=C.WALL_HL;ctx.lineWidth=2;
ctx.beginPath();ctx.moveTo(0,w.getH(off));
for(let x=4;x<=G.W;x+=4){ctx.lineTo(x,w.getH(off+x))}ctx.stroke();
ctx.beginPath();ctx.moveTo(0,G.H-w.getH(off));
for(let x=4;x<=G.W;x+=4){ctx.lineTo(x,G.H-w.getH(off+x))}ctx.stroke();
w.contractions.forEach(c=>{const cx=c.x-off;if(cx>-c.w&&cx<G.W+c.w){ctx.fillStyle=`rgba(139,26,43,${.4*c.str})`;ctx.fillRect(cx-c.w,0,c.w*2,G.H)}});
this.poolWBC.active.forEach(e=>{const ex=e.x-off;ctx.fillStyle='#f0f0e0';ctx.beginPath();ctx.arc(ex,e.y,e.w/2+Math.sin(e.timer*5)*3,0,Math.PI*2);ctx.fill();ctx.fillStyle='#d0d0c0';ctx.beginPath();ctx.arc(ex-5,e.y-3,4,0,Math.PI*2);ctx.fill()});
this.poolAb.active.forEach(e=>{const ex=e.x-off;ctx.strokeStyle='#f5f5dd';ctx.lineWidth=3;ctx.beginPath();ctx.moveTo(ex,e.y);ctx.lineTo(ex-12,e.y+e.h);ctx.moveTo(ex,e.y);ctx.lineTo(ex+12,e.y+e.h*.6);ctx.moveTo(ex,e.y);ctx.lineTo(ex,e.y+e.h);ctx.stroke()});
this.poolChol.active.forEach(e=>{const ex=e.x-off;ctx.fillStyle='#c4a000';ctx.beginPath();ctx.moveTo(ex,e.y+e.h);ctx.lineTo(ex+e.w/2,e.y);ctx.lineTo(ex+e.w,e.y+e.h);ctx.closePath();ctx.fill()});
this.poolFibrin.active.forEach(e=>{const ex=e.x-off;ctx.strokeStyle='rgba(200,200,255,.4)';ctx.lineWidth=1;for(let gy=10;gy<G.H;gy+=15){if(e.closed||Math.abs(gy-e.gapY)<40)continue;ctx.beginPath();ctx.moveTo(ex,gy);ctx.lineTo(ex+e.w,gy);ctx.stroke()}ctx.strokeStyle='rgba(200,200,255,.3)';for(let gx=0;gx<e.w;gx+=10){ctx.beginPath();ctx.moveTo(ex+gx,0);ctx.lineTo(ex+gx,G.H);ctx.stroke()}});
this.poolCramp.active.forEach(e=>{const ex=e.x-off;const str=e.str*(e.timer/e.dur);ctx.fillStyle=`rgba(139,26,43,${.7*str})`;ctx.fillRect(ex,0,e.w,G.H)});
this.poolOrb.active.forEach(e=>{const ex=e.x-off;ctx.fillStyle=C.PROBE;ctx.shadowColor=C.PROBE;ctx.shadowBlur=10;ctx.beginPath();ctx.arc(ex,e.y,6,0,Math.PI*2);ctx.fill();ctx.shadowBlur=0});
this.poolOxy.active.forEach(e=>{const ex=e.x-off;ctx.fillStyle=C.GOLD;ctx.shadowColor=C.GOLD;ctx.shadowBlur=12;ctx.beginPath();ctx.arc(ex,e.y,9,0,Math.PI*2);ctx.fill();ctx.shadowBlur=0});
this.poolStem.active.forEach(e=>{const ex=e.x-off;ctx.fillStyle=C.DANGER;ctx.shadowColor=C.DANGER;ctx.shadowBlur=10;ctx.beginPath();ctx.arc(ex,e.y,8,0,Math.PI*2);ctx.fill();ctx.shadowBlur=0});
const p=this.player;
ctx.fillStyle=p.dashInv?'rgba(0,229,255,.5)':C.PROBE;
ctx.shadowColor=C.PROBE;ctx.shadowBlur=15;
ctx.beginPath();ctx.ellipse(p.x+p.w/2,p.y+p.h/2,p.w/2,p.h/2,0,0,Math.PI*2);ctx.fill();
ctx.fillStyle='#fff';ctx.beginPath();ctx.arc(p.x+p.w*.65,p.y+p.h*.35,3,0,Math.PI*2);ctx.fill();ctx.shadowBlur=0;
for(let i=0;i<3;i++){const t=this.time*5+i*.5;ctx.strokeStyle=`rgba(0,229,255,${.4-i*.1})`;ctx.lineWidth=1;ctx.beginPath();ctx.moveTo(p.x-p.w*.2,p.y+p.h*.5);ctx.lineTo(p.x-p.w*.4-i*4+Math.sin(t)*2,p.y+p.h*.5+Math.cos(t)*3);ctx.stroke()}
ctx.restore();
this.renderHUD();
}
renderMenu(){
const ctx=this.ctx;
ctx.fillStyle=C.BG1;ctx.fillRect(0,0,G.W,G.H);
for(let i=0;i<100;i++){const x=Math.random()*G.W,y=Math.random()*G.H,r=1+Math.random()*2;ctx.fillStyle=`rgba(139,26,43,${.1+Math.random()*.2})`;ctx.beginPath();ctx.arc(x,y,r,0,Math.PI*2);ctx.fill()}
ctx.fillStyle=C.WALL_HL;ctx.font='bold 80px monospace';ctx.textAlign='center';
ctx.fillText('M',G.W/2-80,G.H/2-20);ctx.fillStyle=C.PROBE;ctx.fillText('A',G.W/2,G.H/2-20);ctx.fillStyle=C.WALL_HL;ctx.fillText('R',G.W/2+80,G.H/2-20);ctx.fillStyle=C.WALL_HL;ctx.fillText('R',G.W/2+160,G.H/2-20);ctx.fillStyle=C.PROBE;ctx.fillText('O',G.W/2+240,G.H/2-20);ctx.fillStyle=C.WALL_HL;ctx.fillText('W',G.W/2+320,G.H/2-20);
ctx.strokeStyle=C.PROBE;ctx.lineWidth=2;ctx.beginPath();const t=performance.now()/1000;for(let i=0;i<G.W;i+=2){const v=.5+.5*Math.sin(i*.05+t*4)+.3*Math.sin(i*.02+t*2);ctx.lineTo(i,G.H/2+40+v*15)}ctx.stroke();
ctx.fillStyle=C.TEXT;ctx.font='14px monospace';ctx.textAlign='center';
ctx.fillText('A SYMBIOTIC SURVIVAL RUNNER',G.W/2,G.H/2+60);
ctx.font='12px monospace';ctx.fillStyle='#666';
ctx.fillText('SPACE/UP: JUMP | SHIFT: DASH',G.W/2,G.H/2+90);
ctx.fillText('COLLECT ORBS FOR MULTIPLIERS',G.W/2,G.H/2+110);
}
renderHUD(){
const p=this.player;
document.getElementById('dist').textContent=this.dist.toFixed(1)+'M';
document.getElementById('mult').textContent='x'+p.mult;
document.getElementById('score').textContent=Math.floor(this.score);
document.getElementById('timer').textContent=Math.floor(this.time/60)+':'+String(Math.floor(this.time%60)).padStart(2,'0');
document.getElementById('bpm').textContent=String(Math.floor(this.hr)).padStart(3,'0');
document.getElementById('ecg').textContent='♥'.repeat(Math.max(1,Math.floor(this.hr/20)))+'♦'.repeat(Math.max(1,Math.floor((180-this.hr)/20)));
document.getElementById('d1').style.color=p.dashes>=1?'#00e5ff':'#333';
document.getElementById('d2').style.color=p.dashes>=2?'#00e5ff':'#333';
document.getElementById('d3').style.color=p.dashes>=3?'#00e5ff':'#333';
}
loop(t){
const dt=Math.min((t-this.lastT)/1000,1/G.FPS);
this.accum+=dt;
while(this.accum>=1/G.FPS){this.update(1/G.FPS);this.accum-=1/G.FPS}
this.lastT=t;
this.render();
requestAnimationFrame(p=>this.loop(p));
}
}
const game=new Game();
game.loop(performance.now());
</script>
</body>
</html>"}