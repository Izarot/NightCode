  "index.html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, user-scalable=no\">\n  <title>City Defender</title>\n  <link rel=\"icon\" href=\"data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🛡️</text></svg>\">\n  <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n  <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n  <link href=\"https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700&display=swap\" rel=\"stylesheet\">\n  <link rel=\"stylesheet\" href=\"styles.css\">\n</head>\n<body>\n  <div id=\"game-container\">\n    <canvas id=\"game-canvas\"></canvas>\n    <div id=\"hud-overlay\" class=\"hud\">\n      <div id=\"city-health\" class=\"hud-panel top-center\">\n        <div class=\"label\">CITY INTEGRITY</div>\n        <div id=\"health-segments\" class=\"health-bar\"></div>\n      </div>\n      <div id=\"player-status\" class=\"hud-panel top-left\">\n        <div class=\"status-row\"><span class=\"icon\">✈️</span><span id=\"lives\">3</span></div>\n        <div class=\"status-row\"><div class=\"energy-bar\"><div id=\"energy-fill\"></div></div><span id=\"energy-text\">100%</span></div>\n        <div class=\"status-row\"><span class=\"icon\">💰</span><span id=\"salvage\">0</span></div>\n      </div>\n      <div id=\"wave-info\" class=\"hud-panel top-right\">\n        <div id=\"wave-text\" class=\"label\">WAVE 01</div>\n        <div id=\"distance-text\" class=\"label\">50.0 km</div>\n        <div id=\"warning-text\" class=\"warning hidden\">INCOMING WAVE</div>\n      </div>\n      <div id=\"minimap\" class=\"hud-panel bottom-right\">\n        <canvas id=\"minimap-canvas\" width=\"160\" height=\"120\"></canvas>\n      </div>\n      <div id=\"timer\" class=\"hud-panel top-center-timer\">\n        <span class=\"label\">TIME</span><span id=\"timer-value\">00:00.000</span>\n      </div>\n      <div id=\"notifications\" class=\"hud-panel bottom-center\"></div>\n      <div id=\"touch-controls\" class=\"touch-controls hidden\">\n        <div id=\"joy-left\" class=\"joystick\"><div class=\"stick\"></div></div>\n        <div id=\"joy-right\" class=\"joystick fire\"><div class=\"stick\"></div></div>\n      </div>\n      <div id=\"menus\" class=\"menus\">\n        <div id=\"menu-main\" class=\"menu active\">\n          <h1>CITY DEFENDER</h1>\n          <button id=\"btn-start\">START</button>\n          <button id=\"btn-highscore\">HIGH SCORE: <span id=\"highscore-val\">0</span></button>\n        </div>\n        <div id=\"menu-pause\" class=\"menu\"><h1>PAUSED</h1><button id=\"btn-resume\">RESUME</button><button id=\"btn-quit\">QUIT</button></div>\n        <div id=\"menu-gameover\" class=\"menu\"><h1>GAME OVER</h1><div id=\"final-stats\"></div><button id=\"btn-retry\">RETRY</button></div>\n        <div id=\"menu-victory\" class=\"menu\"><h1>VICTORY</h1><div id=\"victory-stats\"></div><button id=\"btn-next\">MAIN MENU</button></div>\n      </div>\n    </div>\n  </div>\n  <script type=\"module\" src=\"src/main.js\"></script>\n</body>\n</html>",
  "styles.css": "*{box-sizing:border-box;margin:0;padding:0}body{background:#0a0e17;color:#fff;font-family:'Orbitron',monospace;overflow:hidden;height:100vh;width:100vw}#game-container{position:relative;width:100%;height:100%;display:flex;justify-content:center;align-items:center}#game-canvas{display:block;background:#0a0e17}#hud-overlay{position:absolute;top:0;left:0;width:100%;height:100%;pointer-events:none}.hud-panel{position:absolute;pointer-events:auto}.top-center{top:20px;left:50%;transform:translateX(-50%);text-align:center}.top-center-timer{top:60px;left:50%;transform:translateX(-50%);font-size:1.2rem;letter-spacing:2px}.top-left{top:20px;left:20px}.top-right{top:20px;right:20px;text-align:right}.bottom-right{bottom:20px;right:20px}.bottom-center{bottom:40px;left:50%;transform:translateX(-50%);text-align:center;min-height:30px}.label{font-size:0.7rem;letter-spacing:2px;color:#00d2ff;text-transform:uppercase;margin-bottom:4px}.health-bar{display:flex;gap:2px;height:16px;width:600px}.health-segment{flex:1;background:#1a1f2e;border:1px solid #00d2ff;transition:background 0.2s,box-shadow 0.2s}.health-segment.damaged{background:#ff0055;box-shadow:0 0 8px #ff0055}.health-segment.destroyed{background:#333;border-color:#555}.status-row{display:flex;align-items:center;gap:8px;margin:8px 0;font-size:1rem}.icon{font-size:1.2rem}.energy-bar{width:120px;height:8px;background:#1a1f2e;border:1px solid #00d2ff;border-radius:4px;overflow:hidden}#energy-fill{height:100%;width:100%;background:linear-gradient(90deg,#00d2ff,#ff0055);transition:width 0.2s}.warning{color:#ff0055;animation:pulse 0.5s infinite;font-size:1rem}.hidden{display:none}@keyframes pulse{0%,100%{opacity:1}50%{opacity:0.3}}#minimap-canvas{background:rgba(0,0,0,0.6);border:1px solid #00d2ff;border-radius:8px;display:block}#notifications .toast{display:inline-block;padding:8px 16px;background:rgba(10,14,23,0.9);border:1px solid #00d2ff;border-radius:4px;margin:4px;animation:fade 3s forwards}@keyframes fade{0%,