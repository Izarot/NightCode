  "src/config.js": "export const CONFIG = {\n  LOGICAL_W: 1280,\n  LOGICAL_H: 720,\n  CITY_SPEED: 1.2,\n  CITY_SEGMENTS: 5,\n  CITY_SEGMENT_HP: 1000,\n  PLAYER: {\n    RADIUS: 12,\n    MAX_SPEED: 8,\n    BOOST_SPEED: 14,\n    THRUST: 0.15,\n    ROT_SPEED: 0.08,\n    DAMPING: 0.98,\n    FIRE_RATE: 10,\n    BOOST_COST: 2,\n    ENERGY_MAX: 100,\n    ENERGY_REGEN: 0.3\n  },\n  BULLET: {\n    PLAYER: { SPEED: 10, DAMAGE: 25, LIFETIME: 60, SIZE: {w:6,h:12} },\n    ENEMY: { SPEED: 5, DAMAGE: 10, LIFETIME: 120, SIZE: {w:4,h:8} },\n    TURRET: { SPEED: 8, DAMAGE: 10, LIFETIME: 80, SIZE: {w:4,h:8} }\n  },\n  ENEMY_TYPES: {\n    INTERCEPTOR: { hp:100, speed:4, radius:16, score:50, color:'#ff6b6b' },\n    BOMBER: { hp:300, speed:1.5, radius:24, score:150, color:'#ff9f43' },\n    Gunship: { hp:200, speed:2, radius:20, score:100, color:'#ee5253' },\n    SIEGE: { hp:800, speed:1.2, radius:32, score:300, color:'#ff6b6b' }\n  },\n  WAVE_DISTANCE: 2000,\n  WIN_DISTANCE: 50000,\n  PICKUP_CHANCE: 0.15,\n  COLORS: {\n    BG: '#0a0e17',\n    CITY: '#2d3436',\n    CITY_ACCENT: '#00d2ff',\n    PLAYER: '#00d2ff',\n    PLAYER_GLOW: '#ff0055',\n    ENEMY: '#ff6b6b',\n    UI_TEXT: '#ffffff',\n    UI_ACCENT: '#00d2ff',\n    HEALTH_GOOD: '#00d2ff',\n    HEALTH_LOW: '#ff0055'\n  },\n  POOL_SIZES: { bullets:300, enemies:50, particles:500, pickups:20 }\n};\n\nexport const WAVE_TABLE = [\n  { distance:0, enemies:[{type:'INTERCEPTOR',count:3}] },\n  { distance:2000, enemies:[{type:'INTERCEPTOR',count:5},{type:'BOMBER',count:1}] },\n  { distance:4000, enemies:[{type:'INTERCEPTOR',count:4},{type:'GUNSHIP',count:2}] },\n  { distance:6000, enemies:[{type:'BOMBER',count:3},{type:'GUNSHIP',count:1}] },\n  { distance:8000, enemies:[{type:'INTERCEPTOR',count:6},{type:'SIEGE',count:1}] },\n  { distance:10000, enemies:[{type:'INTERCEPTOR',count:8},{type:'BOMBER',count:2},{type:'GUNSHIP',count:2}] },\n  { distance:15000, enemies:[{type:'SIEGE',count:2},{type:'BOMBER',count:3}] },\n  { distance:20000, enemies:[{type:'INTERCEPTOR',count:10},{type:'GUNSHIP',count:3},{type:'SIEGE',count:1}] },\n  { distance:30000, enemies:[{type:'INTERCEPTOR',count:12},{type:'BOMBER',count:4},{type:'GUNSHIP',count:3},{type:'SIEGE',count:2}] },\n  { distance:40000, enemies:[{type:'SIEGE',count:3},{type:'BOMBER',count:5},{type:'GUNSHIP',count:4}] }\n];",
  "src/core/Input.js": "export class Input {\n  constructor() {\n    this.keys = new Set();\n    this.keyMap = {\n      'ArrowLeft':'LEFT','ArrowRight':'RIGHT','ArrowUp':'UP','ArrowDown':'DOWN',\n      'KeyA':'LEFT','KeyD':'RIGHT','KeyW':'UP','KeyS':'DOWN',\n      'Space':'FIRE','ShiftLeft':'BOOST','ShiftRight':'BOOST'\n    };\n    this.actions = { LEFT:false, RIGHT:false, UP:false, DOWN:false, FIRE:false, BOOST:false };\n    this.gamepad = null;\n    this.touch = { left:{active:false,x:0,y:0,dx:0,dy:0}, right:{active:false,x:0,y:0,dx:0,dy:0} };\n    this.fireBuffered = false;\n    this.bind();\n  }\n  bind() {\n    window.addEventListener('keydown', e => {\n      const action = this.keyMap[e.code];\n      if (action) { e.preventDefault(); this.keys.add(action); }\n    });\n    window.addEventListener('keyup', e => {\n      const action = this.keyMap[e.code];\n      if (action) this.keys.delete(action);\n    });\n    window.addEventListener('gamepadconnected', e => { this.gamepad = e.gamepad; });\n    window.addEventListener('gamepaddisconnected', () => { this.gamepad = null; });\n    const leftJoy = document.getElementById('joy-left');\n    const rightJoy = document.getElementById('joy-right');\n    const handleTouch = (e, joy) => {\n      e.preventDefault();\n      const touch = e.touches[0] || e.changedTouches[0];\n      const rect = joy.getBoundingClientRect();\n      const cx = rect.left + rect.width/2;\n      const cy = rect.top + rect.height/2;\n      const dx = (touch.clientX - cx) / (rect.width/2);\n      const dy = (touch.clientY - cy) / (rect.height/2);\n      const dist = Math.min(1, Math.hypot(dx, dy));\n      const angle = Math.atan2(dy, dx);\n      this.touch[joy.id === 'joy-left' ? 'left' : 'right'] = {\n        active: e.type !== 'touchend',\n        x: Math.cos(angle) * dist,\n        y: Math.sin(angle) * dist,\n        dx: Math.cos(angle) * dist,\n        dy: Math.sin(angle) * dist\n      };\n      if (joy.id === 'joy-right' && this.touch.right.active) this.fireBuffered = true;\n    };\n    ['touchstart','touchmove'].forEach(ev => {\n      leftJoy.addEventListener(ev, e => handleTouch(e, leftJoy), {passive:false});\n      rightJoy.addEventListener(ev, e => handleTouch(e, rightJoy), {passive:false});\n    });\n    leftJoy.addEventListener('touchend', e => handleTouch(e, leftJoy));\n    rightJoy.addEventListener('touchend', e => handleTouch(e, rightJoy));\n  }\n  update() {\n    this.actions.LEFT = this.keys.has('LEFT') || (this.gamepad && this.gamepad.axes[0] < -0.2) || this.touch.left.dx < -0.3;\n    this.actions.RIGHT = this.keys.has('RIGHT') || (this.gamepad && this.gamepad.axes[0] > 0.2) || this.touch.left.dx > 0.3;\n    this.actions.UP = this.keys.has('UP') || (this.gamepad && this.gamepad.axes[1] < -0.2) || this.touch.left.dy < -0.3;\n    this.actions.DOWN = this.keys.has('DOWN') || (this.gamepad && this.gamepad.axes[1] > 0.2) || this.touch.left.dy > 0.3;\n    this.actions.FIRE = this.keys.has('FIRE') || (this.gamepad && this.gamepad.buttons[0]?.pressed) || this.fireBuffered;\n    this.actions.BOOST = this.keys.has('BOOST') || (this.gamepad && this.gamepad.buttons[7]?.pressed);\n    this.fireBuffered = false;\n    if (this.gamepad) navigator.getGamepads()[this.gamepad.index];\n  }\n  isTouchDevice() { return 'ontouchstart' in window; }\n}",
  "src/core/Camera.js": "export class Camera {\n  constructor(world) {\n    this.world = world;\n    this.x = 0;\n    this.y = 0;\n    this.targetX = 0;\n    this.targetY = 0;\n    this.shake = { x:0, y:0, magnitude:0, decay:0.9 };\n    this.lerp = 0.1;\n  }\n  update() {\n    const city = this.world.city;\n    this.targetX = city.x - 200;\n    this.targetY = city.y;\n    this.x += (this.targetX - this.x) * this.lerp;\n    this.y += (this.targetY - this.y) * this.lerp;\n    if (this.shake.magnitude > 0.5) {\n      this.shake.x = (Math.random() - 0.5) * 2 * this.shake.magnitude;\n      this.shake.y = (Math.random() - 0.5) * 2 * this.shake.magnitude;\n      this.shake.magnitude *= this.shake.decay;\n    } else {\n      this.shake.x = this.shake.y = this.shake.magnitude = 0;\n    }\n  }\n  getShakeOffset() { return { x: this.shake.x, y: this.shake.y }; }\n  worldToScreen(wx, wy) {\n    return { x: wx - this.x + this.shake.x, y: wy - this.y + this.shake.y };\n  }\n  screenToWorld(sx, sy) {\n    return { x: sx + this.x - this.shake.x, y: sy + this.y - this.shake.y };\n  }\n  addShake(magnitude) { this.shake.magnitude = Math.max(this.shake.magnitude, magnitude); }\n}",
  "src/core/ObjectPool.js": "export class ObjectPool {\n  constructor(createFn, resetFn, initialSize) {\n    this.createFn = createFn;\n    this.resetFn = resetFn;\n    this.pool = [];\n    this.active = [];\n    for (let i = 0; i < initialSize; i++) this.pool.push(createFn());\n  }\n  acquire() {\n    let obj = this.pool.pop() || this.createFn();\n    this.active.push(obj);\n    return obj;\n  }\n  release(obj) {\n    const idx = this.active.indexOf(obj);\n    if (idx !== -1) {\n      this.active.splice(idx, 1);\n      this.resetFn(obj);\n      this.pool.push(obj);\n    }\n  }\n  releaseAll() {\n    this.active.forEach(obj => this.resetFn(obj));\n    this.pool.push(...this.active);\n    this.active = [];\n  }\n  getActive() { return this.active; }\n}",
  "src/core/Collision.js": "export function circleCollide(x1, y1, r1, x2, y2, r2) {\n  const dx = x2 - x1, dy = y2 - y1;\n  return dx*dx + dy*dy <= (r1 + r2) * (r1 + r2);\n}\nexport function circleRectCollide(cx, cy, cr, rx, ry, rw, rh) {\n  const closestX = Math.max(rx, Math.min(cx, rx + rw));\n  const closestY = Math.max(ry, Math.min(cy, ry + rh));\n  return (cx - closestX)**2 + (cy - closestY)**2 <= cr*cr;\n}\nexport function rectRectCollide(r1, r2) {\n  return r1.x < r2.x + r2.w && r1.x + r1.w > r2.x && r1.y < r2.y + r2.h && r1.y + r1.h > r2.y;\n}",
  "src/core/Audio.js": "export class Audio {\n  constructor() {\n    this.ctx = new (window.AudioContext || window.webkitAudioContext)();\n    this.masterGain = this.ctx.createGain();\n    this.masterGain.connect(this.ctx.destination);\n    this.masterGain.gain.value = 0.3;\n    this.musicGain = this.ctx.createGain();\n    this.musicGain.connect(this.masterGain);\n    this.sfxGain = this.ctx.createGain();\n    this.sfxGain.connect(this.masterGain);\n    this.sfxGain.gain.value = 0.5;\n    this.musicSource = null;\n  }\n  resume() { if (this.ctx.state === 'suspended') this.ctx.resume(); }\n  playTone(freq, dur, type='sine', gain=0.1, start=0) {\n    const osc = this.ctx.createOscillator();\n    const g = this.ctx.createGain();\n    osc.type = type; osc.frequency.value = freq;\n    g.gain.setValueAtTime(0, this.ctx.currentTime + start);\n    g.gain.linearRampToValueAtTime(gain, this.ctx.currentTime + start + 0.01);\n    g.gain.exponentialRampToValueAtTime(0.001, this.ctx.currentTime + start + dur);\n    osc.connect(g); g.connect(this.sfxGain);\n    osc.start(this.ctx.currentTime + start);\n    osc.stop(this.ctx.currentTime + start + dur + 0.1);\n  }\n  playNoise(dur, gain=0.1) {\n    const bufferSize = this.ctx.sampleRate * dur;\n    const buffer = this.ctx.createBuffer(1, bufferSize, this.ctx.sampleRate);\n    const data = buffer.getChannelData(0);\n    for (let i = 0; i < bufferSize; i++) data[i] = Math.random() * 2 - 1;\n    const source = this.ctx.createBufferSource();\n    source.buffer = buffer;\n    const g = this.ctx.createGain();\n    g.gain.value = gain;\n    source.connect(g); g.connect(this.sfxGain);\n    source.start();\n  }\n  shoot() { this.playTone(400, 0.1, 'square', 0.05); this.playTone(800, 0.05, 'square', 0.03, 0.02); }\n  enemyShoot() { this.playTone(200, 0.15, 'sawtooth', 0.04); }\n  explosion(size=1) { this.playNoise(0.3, 0.1*size); this.playTone(80, 0.3, 'sine', 0.1*size); }\n  cityHit() { this.playTone(150, 0.2, 'triangle', 0.1); this.playTone(100, 0.3, 'sine', 0.05, 0.1); }\n  pickup() { this.playTone(600, 0.1, 'sine', 0.05); this.playTone(800, 0.1, 'sine', 0.05, 0.05); this.playTone(1000, 0.1, 'sine', 0.05, 0.1); }\n  waveWarning() { this.playTone(300, 0.5, 'sawtooth', 0.05); this.playTone(250, 0.5, 'sawtooth', 0.05, 0.1); }\n  startMusic() {\n    if (this.musicSource) return;\n    const osc = this.ctx.createOscillator();\n    const g = this.ctx.createGain();\n    osc.type = 'sine'; osc.frequency.value = 60;\n    g.gain.value = 0.02;\n    osc.connect(g); g.connect(this.musicGain);\n    osc.start();\n    this.musicSource = osc;\n    // modulate\n    const lfo = this.ctx.createOscillator();\n    lfo.type = 'sine'; lfo.frequency.value = 0.1;\n    const lfoGain = this.ctx.createGain(); lfoGain.gain.value = 10;\n    lfo.connect(lfoGain); lfoGain.connect(osc.frequency);\n    lfo.start();\n  }\n  setMusicIntensity(hpRatio) { if (this.musicGain) this.musicGain.gain.value = 0.02 + 0.03 * (1 - hpRatio); }\n  setMasterVolume(vol) { this.masterGain.gain.value = vol; }\n}",
  "src/entities/PlayerShip.js": "import { CONFIG } from '../config.js';\nexport class PlayerShip {\n  constructor(world) {\n    this.world = world;\n    this.reset();\n  }\n  reset() {\n    this.x = this.world.city.x - 100;\n    this.y = this.world.city.y;\n    this.vx = 0; this.vy = 0;\n    this.angle = 0;\n    this.angularVel = 0;\n    this.hp = 3;\n    this.maxHp = 3;\n    this.energy = CONFIG.PLAYER.ENERGY_MAX;\n    this.maxEnergy = CONFIG.PLAYER.ENERGY_MAX;\n    this.fireCooldown = 0;\n    this.boosting = false;\n    this.invuln = 0;\n    this.overcharge = 0;\n    this.shield = false;\n    this.salvage = 0;\n    this.score = 0;\n    this.lives = 3;\n  }\n  update(input) {\n    if (this.invuln > 0) this.invuln--;\n    if (this.overcharge > 0) this.overcharge--;\n    \n    // Rotation\n    if (input.actions.LEFT) this.angularVel = -CONFIG.PLAYER.ROT_SPEED;\n    else if (input.actions.RIGHT) this.angularVel = CONFIG.PLAYER.ROT_SPEED;\n    else this.angularVel *= 0.9;\n    this.angle += this.angularVel;\n    \n    // Thrust\n    let thrust = 0;\n    if (input.actions.UP) thrust = 1;\n    else if (input.actions.DOWN) thrust = -0.5;\n    \n    this.boosting = input.actions.BOOST && this.energy > 0;\n    const accel = CONFIG.PLAYER.THRUST * (this.boosting ? 2 : 1);\n    if (this.boosting) this.energy = Math.max(0, this.energy - CONFIG.PLAYER.BOOST_COST);\n    else this.energy = Math.min(this.maxEnergy, this.energy + CONFIG.PLAYER.ENERGY_REGEN);\n    \n    this.vx += Math.cos(this.angle) * thrust * accel;\n    this.vy += Math.sin(this.angle) * thrust * accel;\n    \n    const maxSpeed = this.boosting ? CONFIG.PLAYER.BOOST_SPEED : CONFIG.PLAYER.MAX_SPEED;\n    const speed = Math.hypot(this.vx, this.vy);\n    if (speed > maxSpeed) { this.vx = (this.vx/speed)*maxSpeed; this.vy = (this.vy/speed)*maxSpeed; }\n    \n    this.vx *= CONFIG.PLAYER.DAMPING;\n    this.vy *= CONFIG.PLAYER.DAMPING;\n    this.x += this.vx;\n    this.y += this.vy;\n    \n    // Boundary spring\n    const cx = this.world.city.x;\n    const cy = this.world.city.y;\n    const dx = this.x - cx;\n    const dy = this.y - cy;\n    if (dx < -400) this.vx += 0.05 * (-400 - dx);\n    if (dx > 400) this.vx += 0.05 * (400 - dx);\n    if (dy < -300) this.vy += 0.05 * (-300 - dy);\n    if (dy > 300) this.vy += 0.05 * (300 - dy);\n    \n    // Fire\n    if (this.fireCooldown > 0) this.fireCooldown--;\n    const fireRate = this.overcharge > 0 ? CONFIG.PLAYER.FIRE_RATE / 3 : CONFIG.PLAYER.FIRE_RATE;\n    if (input.actions.FIRE && this.fireCooldown <= 0) {\n      this.fire();\n      this.fireCooldown = fireRate;\n    }\n    \n    // Emit// Emit engine particles
    if (thrust > 0) {
      const px = this.x - Math.cos(this.angle) * 16;
      const py = this.y - Math.sin(this.angle) * 16;
      this.world.particles.emit(px, py, Math.atan2(-Math.sin(this.angle), -Math.cos(this.angle)), 0.5, '#00d2ff', 8);
    }
    if (this.boosting) {
      const px = this.x - Math.cos(this.angle) * 18;
      const py = this.y - Math.sin(this.angle) * 18;
      this.world.particles.emit(px, py, Math.atan2(-Math.sin(this.angle), -Math.cos(this.angle)), 1, '#ff0055', 12);
    }
  }
  fire() {
    const spread = this.overcharge > 0 ? 0.15 : 0;
    const count = this.overcharge > 0 ? 3 : 1;
    for (let i = 0; i < count; i++) {
      const a = this.angle + (i - (count-1)/2) * spread;
      const b = this.world.bullets.acquire();
      b.init(this.x + Math.cos(a)*14, this.y + Math.sin(a)*14, a, 'PLAYER');
      this.world.audio.shoot();
    }
  }
  takeDamage(dmg) {
    if (this.invuln > 0 || this.shield) return false;
    this.hp -= dmg;
    this.invuln = 60;
    this.world.camera.addShake(5);
    if (this.hp <= 0) {
      this.lives--;
      if (this.lives > 0) {
        this.hp = this.maxHp;
        this.invuln = 180;
        this.x = this.world.city.x - 100;
        this.y = this.world.city.y;
        this.vx = this.vy = 0;
      }
      return true;
    }
    return false;
  }
  heal(amount) { this.hp = Math.min(this.maxHp, this.hp + amount); }
  addEnergy(amount) { this.energy = Math.min(this.maxEnergy, this.energy + amount); }
  addSalvage(amount) { this.salvage += amount; this.score += amount; }
  activateOvercharge() { this.overcharge = 300; }
  activateShield() { this.shield = true; setTimeout(() => this.shield = false, 5000); }
  render(ctx) {
    ctx.save();
    ctx.translate(this.x, this.y);
    ctx.rotate(this.angle);
    // Ship body
    ctx.beginPath();
    ctx.moveTo(16, 0);
    ctx.lineTo(-12, -10);
    ctx.lineTo(-8, 0);
    ctx.lineTo(-12, 10);
    ctx.closePath();
    ctx.fillStyle = this.shield ? 'rgba(0,210,255,0.3)' : '#00d2ff';
    ctx.fill();
    ctx.strokeStyle = this.shield ? '#00d2ff' : '#fff';
    ctx.lineWidth = 2;
    ctx.stroke();
    // Cockpit
    ctx.beginPath();
    ctx.arc(4, 0, 3, 0, Math.PI*2);
    ctx.fillStyle = '#fff';
    ctx.fill();
    // Engine glow
    const glow = this.boosting ? 20 : 10;
    const grad = ctx.createRadialGradient(-10, 0, 0, -10, 0, glow);
    grad.addColorStop(0, this.boosting ? '#ff0055' : '#00d2ff');
    grad.addColorStop(1, 'transparent');
    ctx.beginPath();
    ctx.arc(-10, 0, glow, 0, Math.PI*2);
    ctx.fillStyle = grad;
    ctx.fill();
    // Invuln flash
    if (this.invuln > 0 && Math.floor(this.invuln/4)%2 === 0) {
      ctx.strokeStyle = 'rgba(255,255,255,0.5)';
      ctx.lineWidth = 3;
      ctx.beginPath();
      ctx.arc(0, 0, 20, 0, Math.PI*2);
      ctx.stroke();
    }
    ctx.restore();
  }
}",
  "src/entities/City.js": "import { CONFIG } from '../config.js';\nexport class City {\n  constructor() {\n    this.x = 0;\n    this.y = 0;\n    this.segments = [];\n    this.width = 400;\n    this.height = 120;\n    this.distance = 0;\n    this.speed = CONFIG.CITY_SPEED;\n    this.initSegments();\n  }\n  initSegments() {\n    this.segments = [];\n    const segWidth = this.width / CONFIG.CITY_SEGMENTS;\n    for (let i = 0; i < CONFIG.CITY_SEGMENTS; i++) {\n      this.segments.push({\n        x: -this.width/2 + i * segWidth,\n        w: segWidth,\n        hp: CONFIG.CITY_SEGMENT_HP,\n        maxHp: CONFIG.CITY_SEGMENT_HP,\n        destroyed: false\n      });\n    }\n  }\n  update() {\n    this.x += this.speed;\n    this.distance += this.speed;\n  }\n  takeDamage(segIndex, dmg) {\n    if (segIndex < 0 || segIndex >= this.segments.length) return;\n    const seg = this.segments[segIndex];\n    if (seg.destroyed) return;\n    seg.hp -= dmg;\n    if (seg.hp <= 0) {\n      seg.hp = 0;\n      seg.destroyed = true;\n      this.world?.audio?.cityHit();\n      this.world?.camera?.addShake(8);\n    }\n  }\n  getTotalHp() {\n    return this.segments.reduce((sum, s) => sum + s.hp, 0);\n  }\n  getMaxHp() {\n    return this.segments.reduce((sum, s) => sum + s.maxHp, 0);\n  }\n  getHpRatio() {\n    return this.getTotalHp() / this.getMaxHp();\n  }\n  getSegmentAtWorldX(wx) {\n    const localX = wx - this.x;\n    const idx = Math.floor((localX + this.width/2) / (this.width / CONFIG.CITY_SEGMENTS));\n    return Math.max(0, Math.min(CONFIG.CITY_SEGMENTS - 1, idx));\n  }\n  render(ctx) {\n    ctx.save();\n    ctx.translate(this.x, this.y);\n    // Base platform\n    ctx.fillStyle = CONFIG.COLORS.CITY;\n    ctx.fillRect(-this.width/2, -this.height/2, this.width, this.height);\n    // Segments\n    this.segments.forEach((seg, i) => {\n      const sx = seg.x;\n      const ratio = seg.hp / seg.maxHp;\n      ctx.fillStyle = seg.destroyed ? '#333' : `rgb(${Math.floor(255*(1-ratio))}, ${Math.floor(255*ratio)}, 0)`;\n      ctx.fillRect(sx, -this.height/2, seg.w, this.height);\n      // Accent lines\n      ctx.strokeStyle = CONFIG.COLORS.CITY_ACCENT;\n      ctx.lineWidth = 1;\n      ctx.strokeRect(sx, -this.height/2, seg.w, this.height);\n      // Damage indicator\n      if (seg.destroyed) {\n        ctx.fillStyle = '#ff0055';\n        ctx.fillRect(sx + 2, -this.height/2 + 2, seg.w - 4, this.height - 4);\n      }\n    });\n    // Core reactor\n    const corePulse = Math.sin(Date.now()/200) * 0.3 + 0.7;\n    const grad = ctx.createRadialGradient(0, 0, 0, 0, 0, 30);\n    grad.addColorStop(0, `rgba(0,210,255,${corePulse})`);\n    grad.addColorStop(1, 'transparent');\n    ctx.beginPath();\n    ctx.arc(0, 0, 30, 0, Math.PI*2);\n    ctx.fillStyle = grad;\n    ctx.fill();\n    ctx.beginPath();\n    ctx.arc(0, 0, 12, 0, Math.PI*2);\n    ctx.fillStyle = '#00d2ff';\n    ctx.fill();\n    ctx.restore();\n  }\n}",
  "src/entities/Enemy.js": "import { CONFIG } from '../config.js';\nimport { circleCollide } from '../core/Collision.js';\nexport class Enemy {\n  constructor(world, type, x, y) {\n    this.world = world;\n    this.type = type;\n    const def = CONFIG.ENEMY_TYPES[type];\n    this.hp = def.hp;\n    this.maxHp = def.hp;\n    this.speed = def.speed;\n    this.radius = def.radius;\n    this.score = def.score;\n    this.color = def.color;\n    this.x = x;\n    this.y = y;\n    this.vx = 0;\n    this.vy = 0;\n    this.angle = 0;\n    this.fireCooldown = 60 + Math.random() * 60;\n    this.behaviorTimer = 0;\n    this.state = 'approach';\n    this.targetX = 0;\n    this.targetY = 0;\n  }\n  update() {\n    const city = this.world.city;\n    const player = this.world.player;\n    const dx = city.x - this.x;\n    const dy = city.y - this.y;\n    const distToCity = Math.hypot(dx, dy);\n    \n    this.behaviorTimer++;\n    \n    switch(this.type) {\n      case 'INTERCEPTOR': this.updateInterceptor(player, dx, dy, distToCity); break;\n      case 'BOMBER': this.updateBomber(city, dx, dy, distToCity); break;\n      case 'GUNSHIP': this.updateGunship(player, city, dx, dy, distToCity); break;\n      case 'SIEGE': this.updateSiege(city, dx, dy, distToCity); break;\n    }\n    \n    this.x += this.vx;\n    this.y += this.vy;\n    this.angle = Math.atan2(this.vy, this.vx);\n    \n    // Fire at city or player\n    if (this.fireCooldown > 0) this.fireCooldown--;\n    if (this.fireCooldown <= 0 && distToCity < 400) {\n      this.fireAt(city.x, city.y);\n      this.fireCooldown = this.type === 'SIEGE' ? 30 : 90 + Math.random() * 60;\n    }\n    \n    // Check collision with city\n    if (distToCity < this.radius + 60) {\n      const segIdx = city.getSegmentAtWorldX(this.x);\n      city.takeDamage(segIdx, 10);\n      this.world.particles.emit(this.x, this.y, 0, 1, this.color, 15);\n      this.world.audio.explosion(0.5);\n      return true; // destroyed\n    }\n    return false;\n  }\n  updateInterceptor(player, dx, dy, distToCity) {\n    const pdx = player.x - this.x;\n    const pdy = player.y - this.y;\n    const pdist = Math.hypot(pdx, pdy);\n    \n    if (pdist < 300 && this.state !== 'attack') {\n      this.state = 'attack';\n      this.targetX = player.x;\n      this.targetY = player.y;\n    }\n    \n    if (this.state === 'attack') {\n      const tx = player.x - this.x;\n      const ty = player.y - this.y;\n      const ta = Math.atan2(ty, tx);\n      this.vx += Math.cos(ta) * 0.3;\n      this.vy += Math.sin(ta) * 0.3;\n      if (pdist > 400) this.state = 'approach';\n    } else {\n      const ta = Math.atan2(dy, dx);\n      this.vx += Math.cos(ta) * 0.15;\n      this.vy += Math.sin(ta) * 0.15;\n    }\n    \n    const speed = Math.hypot(this.vx, this.vy);\n    if (speed > this.speed) { this.vx = (this.vx/speed)*this.speed; this.vy = (this.vy/speed)*this.speed; }\n  }\n  updateBomber(city, dx, dy, distToCity) {\n    const ta = Math.atan2(dy, dx);\n    this.vx += Math.cos(ta) * 0.08;\n    this.vy += Math.sin(ta) * 0.08;\n    const speed = Math.hypot(this.vx, this.vy);\n    if (speed > this.speed) { this.vx = (this.vx/speed)*this.speed; this.vy = (this.vy/speed)*this.speed; }\n    // Strafe\n    if (this.behaviorTimer % 180 < 90) {\n      this.vx += Math.cos(ta + Math.PI/2) * 0.05;\n      this.vy += Math.sin(ta + Math.PI/2) * 0.05;\n    } else {\n      this.vx += Math.cos(ta - Math.PI/2) * 0.05;\n      this.vy += Math.sin(ta - Math.PI/2) * 0.05;\n    }\n  }\n  updateGunship(player, city, dx, dy, distToCity) {\n    const pdx = player.x - this.x;\n    const pdy = player.y - this.y;\n    const pdist = Math.hypot(pdx, pdy);\n    \n    // Orbit player at medium range\n    if (pdist < 350) {\n      const orbitDir = this.behaviorTimer % 360 < 180 ? 1 : -1;\n      const ta = Math.atan2(pdy, pdx) + orbitDir * Math.PI/2;\n      this.vx += Math.cos(ta) * 0.2;\n      this.vy += Math.sin(ta) * 0.2;\n    } else {\n      const ta = Math.atan2(dy, dx);\n      this.vx += Math.cos(ta) * 0.1;\n      this.vy += Math.sin(ta) * 0.1;\n    }\n    const speed = Math.hypot(this.vx, this.vy);\n    if (speed > this.speed) { this.vx = (this.vx/speed)*this.speed; this.vy = (this.vy/speed)*this.speed; }\n  }\n  updateSiege(city, dx, dy, distToCity) {\n    const ta = Math.atan2(dy, dx);\n    this.vx += Math.cos(ta) * 0.05;\n    this.vy += Math.sin(ta) * 0.05;\n    const speed = Math.hypot(this.vx, this.vy);\n    if (speed > this.speed) { this.vx = (this.vx/speed)*this.speed; this.vy = (this.vy/speed)*this.speed; }\n    // Deploy mines occasionally\n    if (this.behaviorTimer % 300 === 0 && distToCity < 500) {\n      this.deployMine();\n    }\n  }\n  fireAt(tx, ty) {\n    const angle = Math.atan2(ty - this.y, tx - this.x);\n    const b = this.world.bullets.acquire();\n    b.init(this.x + Math.cos(angle)*this.radius, this.y + Math.sin(angle)*this.radius, angle, 'ENEMY');\n    this.world.audio.enemyShoot();\n  }\n  deployMine() {\n    const mine = this.world.enemies.acquire();\n    mine.init(this.x, this.y, 'MINE');\n  }\n  takeDamage(dmg) {\n    this.hp -= dmg;\n    this.world.particles.emit(this.x, this.y, Math.random()*Math.PI*2, 0.5, this.color, 5);\n    if (this.hp <= 0) {\n      this.world.player.addSalvage(this.score);\n      this.world.particles.emit(this.x, this.y, 0, 2, this.color, 30);\n      this.world.audio.explosion(this.radius/16);\n      // Drop pickup\n      if (Math.random() < CONFIG.PICKUP_CHANCE) {\n        const pickups = ['HEALTH', 'ENERGY', 'OVERCHARGE', 'SHIELD', 'SALVAGE'];\n        this.world.pickups.acquire().init(this.x, this.y, pickups[Math.floor(Math.random()*pickups.length)]);\n      }\n      return true;\n    }\n    return false;\n  }\n  render(ctx) {\n    ctx.save();\n    ctx.translate(this.x, this.y);\n    ctx.rotate(this.angle);\n    \n    switch(this.type) {\n      case 'INTERCEPTOR':\n        ctx.beginPath();\n        ctx.moveTo(this.radius, 0);\n        ctx.lineTo(-this.radius*0.7, -this.radius*0.5);\n        ctx.lineTo(-this.radius*0.3, 0);\n        ctx.lineTo(-this.radius*0.7, this.radius*0.5);\n        ctx.closePath();\n        break;\n      case 'BOMBER':\n        ctx.beginPath();\n        ctx.ellipse(0, 0, this.radius, this.radius*0.7, 0, 0, Math.PI*2);\n        break;\n      case 'GUNSHIP':\n        ctx.beginPath();\n        ctx.moveTo(this.radius*0.8, 0);\n        ctx.lineTo(-this.radius, -this.radius*0.8);\n        ctx.lineTo(-this.radius*0.5, 0);\n        ctx.lineTo(-this.radius, this.radius*0.8);\n        ctx.closePath();\n        break;\n      case 'SIEGE':\n        ctx.beginPath();\n        ctx.moveTo(this.radius, 0);\n        for(let i=1;i<6;i++) {\n          const a = (i/6)*Math.PI*2;\n          const r = i%2===0 ? this.radius : this.radius*0.6;\n          ctx.lineTo(Math.cos(a)*r, Math.sin(a)*r);\n        }\n        ctx.closePath();\n        break;\n    }\n    \n    const hpRatio = this.hp / this.maxHp;\n    ctx.fillStyle = this.color;\n    ctx.globalAlpha = 0.8;\n    ctx.fill();\n    ctx.globalAlpha = 1;\n    ctx.strokeStyle = '#fff';\n    ctx.lineWidth = 1.5;\n    ctx.stroke();\n    \n    // Health bar\n    if (this.hp < this.maxHp) {\n      ctx.fillStyle = '#333';\n      ctx.fillRect(-this.radius, -this.radius-10, this.radius*2, 4);\n      ctx.fillStyle = hpRatio > 0.5 ? '#00d2ff' : '#ff0055';\n      ctx.fillRect(-this.radius, -this.radius-10, this.radius*2*hpRatio, 4);\n    }\n    \n    ctx.restore();\n  }\n}",
  "src/entities/Bullet.js": "import { CONFIG } from '../config.js';\nexport class Bullet {\n  constructor() { this.active = false; }\n  init(x, y, angle, owner) {\n    this.x = x; this.y = y; this.angle = angle; this.owner = owner;\n    const def = CONFIG.BULLET[owner];\n    this.speed = def.SPEED;\n    this.damage = def.DAMAGE;\n    this.lifetime = def.LIFETIME;\n    this.w = def.SIZE.w;\n    this.h = def.SIZE.h;\n    this.active = true;\n    this.vx = Math.cos(angle) * this.speed;\n    this.vy = Math.sin(angle) * this.speed;\n  }\n  update() {\n    if (!this.active) return;\n    this.x += this.vx;\n    this.y += this.vy;\n    this.lifetime--;\n    if (this.lifetime <= 0) this.active = false;\n    // Bounds check\n    const city = this.world?.city;\n    if (city && (this.x < city.x - 800 || this.x > city.x + 800 || this.y < city.y - 600 || this.y > city.y + 600)) {\n      this.active = false;\n    }\n  }\n  render(ctx) {\n    if (!this.active) return;\n    ctx.save();\n    ctx.translate(this.x, this.y);\n    ctx.rotate(this.angle);\n    ctx.fillStyle = this.owner === 'PLAYER' ? '#00d2ff' : '#ff0055';\n    ctx.fillRect(-this.w/2, -this.h/2, this.w, this.h);\n    // Glow\n    const grad = ctx.createLinearGradient(-this.w/2, 0, this.w/2, 0);\n    grad.addColorStop(0, 'transparent');\n    grad.addColorStop(0.5, this.owner === 'PLAYER' ? 'rgba(0,210,255,0.8)' : 'rgba(255,0,85,0.8)');\n    grad.addColorStop(1, 'transparent');\n    ctx.fillStyle = grad;\n    ctx.fillRect(-this.w, -this.h, this.w*2, this.h*2);\n    ctx.restore();\n  }\n}",
  "src/entities/Particle.js": "export class Particle {\n  constructor() { this.active = false; }\n  init(x, y, angle, speed, color, life, size) {\n    this.x = x; this.y = y;\n    this.vx = Math.cos(angle) * speed;\n    this.vy = Math.sin(angle) * speed;\n    this.color = color;\n    this.life = life;\n    this.maxLife = life;\n    this.size = size;\n    this.active = true;\n  }\n  update() {\n    if (!this.active) return;\n    this.x += this.vx;\n    this.y += this.vy;\n    this.vx *= 0.98;\n    this.vy *= 0.98;\n    this.life--;\n    if (this.life <= 0) this.active = false;\n  }\n  render(ctx) {\n    if (!this.active) return;\n    const alpha = this.life / this.maxLife;\n    ctx.globalAlpha = alpha;\n    ctx.fillStyle = this.color;\n    ctx.beginPath();\n    ctx.arc(this.x, this.y, this.size * alpha, 0, Math.PI*2);\n    ctx.fill();\n    ctx.globalAlpha = 1;\n  }\n}",
  "src/entities/Pickup.js": "export class Pickup {\n  constructor() { this.active = false; }\n  init(x, y, type) {\n    this.x = x; this.y = y; this.type = type;\n    this.vy = -0.5;\n    this.rotation = 0;\n    this.life = 600;\n    this.active = true;\n    this.radius = 12;\n    this.colors = {\n      HEALTH: '#00ff88',\n      ENERGY: '#00d2ff',\n      OVERCHARGE: '#ff0055',\n      SHIELD: '#ffff00',\n      SALVAGE: '#ffaa00'\n    };\n    this.symbols = {\n      HEALTH: '+',\n      ENERGY: '⚡',\n      OVERCHARGE: '★',\n      SHIELD: '⛨',\n      SALVAGE: '$'\n    };\n  }\n  update() {\n    if (!this.active) return;\n    this.y += this.vy;\n    this.vy += 0.02;\n    this.rotation += 0.02;\n    this.life--;\n    if (this.life <= 0) this.active = false;\n    // Magnet to player\n    const player = this.world?.player;\n    if (player) {\n      const dx = player.x - this.x;\n      const dy = player.y - this.y;\n      const dist = Math.hypot(dx, dy);\n      if (dist < 150) {\n        this.x += dx * 0.05;\n        this.y += dy * 0.05;\n      }\n      if (dist < player.radius + this.radius) {\n        this.collect(player);\n      }\n    }\n  }\n  collect(player) {\n    this.active = false;\n    this.world?.audio?.pickup();\n    switch(this.type) {\n      case 'HEALTH': player.heal(1); break;\n      case 'ENERGY': player.addEnergy(30); break;\n      case 'OVERCHARGE': player.activateOvercharge(); break;\n      case 'SHIELD': player.activateShield(); break;\n      case 'SALVAGE': player.addSalvage(50); break;\n    }\n    this.world?.notifications?.show(`+${this.type}`, this.colors[this.type]);\n  }\n  render(ctx) {\n    if (!this.active) return;\n    ctx.save();\n    ctx.translate(this.x, this.y);\n    ctx.rotate(this.rotation);\n    const color = this.colors[this.type];\n    const pulse = Math.sin(Date.now()/100) * 0.2 + 0.8;\n    // Outer glow\n    const grad = ctx.createRadialGradient(0, 0, 0, 0, 0, this.radius*1.5);\n    grad.addColorStop(0, color);\n    grad.addColorStop(1, 'transparent');\n    ctx.fillStyle = grad;\n    ctx.beginPath();\n    ctx.arc(0, 0, this.radius*1.5*pulse, 0, Math.PI*2);\n    ctx.fill();\n    // Core\n    ctx.fillStyle = color;\n    ctx.beginPath();\n    ctx.moveTo(this.radius, 0);\n    for(let i=1;i<6;i++) {\n      const a = (i/6)*Math.PI*2;\n      const r = i%2===0 ? this.radius : this.radius*0.5;\n      ctx.lineTo(Math.cos(a)*r, Math.sin(a)*r);\n    }\n    ctx.closePath();\n    ctx.fill();\n    ctx.strokeStyle = '#fff';\n    ctx.lineWidth = 1;\n    ctx.stroke();\n    // Symbol\n    ctx.fillStyle = '#000';\n    ctx.font = 'bold 14px Orbitron';\n    ctx.textAlign = 'center';\n    ctx.textBaseline = 'middle';\n    ctx.fillText(this.symbols[this.type], 0, 1);\n    ctx.restore();\n  }\n}",
  "src/entities/ParticleSystem.js": "import { Particle } from './Particle.js';\nexport class ParticleSystem {\n  constructor(pool) { this.pool = pool; }\n  emit(x, y, angle, speed, color, count, spread = Math.PI/4) {\n    for (let i = 0; i < count; i++) {\n      const a = angle + (Math.random() - 0.5) * spread * 2;\n      const s = speed * (0.5 + Math.random() * 0.5);\n      const life = 20 + Math.random() * 30;\n      const size = 1 + Math.random() * 3;\n      const p = this.pool.acquire();\n      p.init(x, y, a, s, color, life, size);\n    }\n  }\n  update() { this.pool.getActive().forEach(p => p.update()); }\n  render(ctx) { this.pool.getActive().forEach(p => p.render(ctx)); }\n}",
  "src/entities/PickupSystem.js": "import { Pickup } from './Pickup.js';\nexport class PickupSystem {\n  constructor(pool) { this.pool = pool; }\n  update() { this.pool.getActive().forEach(p => p.update()); }\n  render(ctx) { this.pool.getActive().forEach(p => p.render(ctx)); }\n}",
  "src/systems/WaveManager.js": "import { CONFIG, WAVE_TABLE } from '../config.js';\nexport class WaveManager {\n  constructor(world) {\n    this.world = world;\n    this.currentWave = 0;\n    this.spawned = 0;\n    this.warningTimer = 0;\n    this.showWarning = false;\n  }\n  update() {\n    const dist = this.world.city.distance;\n    \n    // Check for next wave\n    while (this.currentWave < WAVE_TABLE.length && dist >= WAVE_TABLE[this.currentWave].distance) {\n      this.triggerWave(this.currentWave);\n      this.currentWave++;\n    }\n    \n    // Spawn enemies from current wave queue\n    if (this.spawnQueue && this.spawnQueue.length > 0) {\n      this.spawnTimer = (this.spawnTimer || 0) + 1;\n      if (this.spawnTimer >= 30) {\n        const spawn = this.spawnQueue.shift();\n        this.spawnEnemy(spawn.type, spawn.x, spawn.y);\n        this.spawnTimer = 0;\n        if (this.spawnQueue.length === 0) this.spawnQueue = null;\n      }\n    }\n    \n    // Warning display\n    if (this.warningTimer > 0) {\n      this.warningTimer--;\n      this.showWarning = this.warningTimer % 20 < 10;\n    } else {\n      this.showWarning = false;\n    }\n  }\n  triggerWave(waveIndex) {\n    const wave = WAVE_TABLE[waveIndex];\n    this.spawnQueue = [];\n    wave.enemies.forEach(group => {\n      for (let i = 0; i < group.count; i++) {\n        const angle = (Math.PI * 2 / group.count) * i + Math.random() * 0.5;\n        const dist = 600 + Math.random() * 200;\n        const city = this.world.city;\n        this.spawnQueue.push({\n          type: group.type,\n          x: city.x + Math.cos(angle) * dist,\n          y: city.y + Math.sin(angle) * dist\n        });\n      }\n    });\n    this.spawnTimer = 0;\n    this.warningTimer = 120;\n    this.world.audio.waveWarning();\n    this.world.notifications.show(`WAVE ${waveIndex + 1} INCOMING`, '#ff0055');\n  }\n  spawnEnemy(type, x, y) {\n    const enemy = this.world.enemies.acquire();\n    enemy.constructor.call(enemy, this.world, type, x, y);\n  }\n  getWaveInfo() {\n    return { current: this.currentWave, total: WAVE_TABLE.length, warning: this.showWarning };\n  }\n  reset() {\n    this.currentWave = 0;\n    this.spawned = 0;\n    this.warningTimer = 0;\n    this.showWarning = false;\n    this.spawnQueue = null;\n  }\n}",
  "src/systems/NotificationSystem.js": "export class NotificationSystem {\n  constructor() { this.container = document.getElementById('notifications'); }\n  show(text, color = '#00d2ff') {\n    const el = document.createElement('div');\n    el.className = 'toast';\n    el.style.borderColor = color;\n    el.style.color = color;\n    el.textContent = text;\n    this.container.appendChild(el);\n    setTimeout(() => el.remove(), 3000);\n  }\n}",
  "src/systems/Minimap.js": "export class Minimap {\n  constructor(canvas) {\n    this.canvas = canvas;\n    this.ctx = canvas.getContext('2d');\n    this.width = canvas.width;\n    this.height = canvas.height;\n  }\n  render(world) {\n    const ctx = this.ctx;\n    ctx.clearRect(0, 0, this.width, this.height);\n    const city = world.city;\n    const player = world.player;\n    const scaleX = this.width / 1600;\n    const scaleY = this.height / 1200;\n    const offsetX = this.width / 2;\