{
  "index.html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Ghost Hunt</title>\n    <link rel=\"stylesheet\" href=\"styles/global.css\">\n    <link rel=\"icon\" href=\"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'><text y='0.5em' font-size='48'>🕵️‍♂️</text></svg>\">\n</head>\n<body>\n    <canvas id=\"gameCanvas\"></canvas>\n    <script src=\"src/main.js\"></script>\n</body>\n</html>\n",
  "src/main.js": "import { GameLoop } from './core/GameLoop.js';\nimport { InputManager } from './core/InputManager.js';\nimport { Player } from './systems/Player.js';\nimport { LevelManager } from './levels/LevelManager.js';\nimport { HUD } from './ui/HUD.js';\n\nconst canvas = document.getElementById('gameCanvas');\nconst ctx = canvas.getContext('2d');\n\n// Set up responsive canvas\nfunction resizeCanvas() {\n    const dpr = window.devicePixelRatio || 1;\n    canvas.width = canvas.clientWidth * dpr;\n    canvas.height = canvas.clientHeight * dpr;\n    ctx.scale(dpr, dpr);\n}\nwindow.addEventListener('resize', resizeCanvas);\nresizeCanvas();\n\nconst player = new Player();\nconst level = new LevelManager();\nconst hud = new HUD();\n\nconst gameLoop = new GameLoop(() => {\n    // Update\n    level.update();\n    player.update();\n    // Render\n    ctx.clearRect(0, 0, canvas.width, canvas.height);\n    level.render(ctx);\n    player.render(ctx);\n    hud.render(ctx);\n});\n\ngameLoop.start();\n",
  "src/core/GameLoop.js": "export class GameLoop {\n    constructor(callback) {\n        this.callback = callback;\n        this.lastTime = 0;\n        this.fixedDelta = 1 / 60;\n        this.accumulator = 0;\n        this.running = false;\n    }\n\n    start() {\n        this.running = true;\n        requestAnimationFrame(this.loop.bind(this));\n    }\n\n    stop() {\n        this.running = false;\n    }\n\n    loop(timestamp) {\n        if (!this.running) return;\n        const deltaTime = (timestamp - this.lastTime) / 1000;\n        this.lastTime = timestamp;\n        this.accumulator += deltaTime;\n        while (this.accumulator >= this.fixedDelta) {\n            this.callback(this.fixedDelta);\n            this.accumulator -= this.fixedDelta;\n        }\n        requestAnimationFrame(this.loop.bind(this));\n    }\n}\n",
  "src/core/InputManager.js": "export class InputManager {\n    constructor() {\n        this.keys = new Set();\n        this.mouse = { x: 0, y: 0, down: false };\n        window.addEventListener('keydown', e => this.keys.add(e.code));\n        window.addEventListener('keyup', e => this.keys.delete(e.code));\n        window.addEventListener('mousemove', e => {\n            const rect = canvas.getBoundingClientRect();\n            this.mouse.x = (e.clientX - rect.left) * (canvas.width / rect.width);\n            this.mouse.y = (e.clientY - rect.top) * (canvas.height / rect.height);\n        });\n        window.addEventListener('mousedown', e => this.mouse.down = true);\n        window.addEventListener('mouseup', e => this.mouse.down = false);\n    }\n\n    isDown(keyCode) {\n        return this.keys.has(keyCode);\n    }\n\n    getMousePos() {\n        return { x: this.mouse.x, y: this.mouse.y };\n    }\n}\n",
  "src/core/PhysicsEngine.js": "export class PhysicsEngine {\n    constructor() {\n        this.gravity = 0.5;\n        this.friction = 0.9;\n        this.maxSpeed = 5;\n        this.coyoteTime = 0.2;\n        this.coyoteTimer = 0;\n    }\n\n    update(player, deltaTime) {\n        // Apply gravity\n        player.velocity.y += this.gravity * deltaTime;\n        // Horizontal movement\n        let moveX = 0;\n        if (input.isDown('ArrowLeft')) moveX -= 1;\n        if (input.isDown('ArrowRight')) moveX += 1;\n        player.velocity.x = moveX * 10;\n        // Apply friction\n        player.velocity.x *= this.friction;\n        // Clamp speed\n        player.velocity.x = Math.max(-this.maxSpeed, Math.min(this.maxSpeed, player.velocity.x));\n        // Update position\n        player.x += player.velocity.x * deltaTime;\n        player.y += player.velocity.y * deltaTime;\n        // Simple ground check (assume ground at y = canvas.height)\n        if (player.y > canvas.height - player.size) {\n            player.y = canvas.height - player.size;\n            player.velocity.y = 0;\n            this.coyoteTimer = this.coyoteTime;\n        } else {\n            this.coyoteTimer -= deltaTime;\n        }\n    }\n}\n",
  "src/core/ObjectPool.js": "export class ObjectPool {\n    constructor(createFn, maxSize = 100) {\n        this.createFn = createFn;\n        this.maxSize = maxSize;\n        this.pool = [];\n    }\n\n    acquire() {\n        if (this.pool.length > 0) {\n            return this.pool.pop();\n        }\n        return this.createFn();\n    }\n\n    release(obj) {\n        if (this.pool.length < this.maxSize) {\n            this.pool.push(obj);\n        }\n    }\n}\n",
  "src/core/AssetLoader.js": "export class AssetLoader {\n    static loadImages(sources) {\n        return new Promise((resolve, reject) => {\n            const images = {};\n            let loaded = 0;\n            const total = Object.keys(sources).length;\n            for (const [key, src] of Object.entries(sources)) {\n                const img = new Image();\n                img.onload = () => {\n                    images[key] = img;\n                    loaded++;\n                    if (loaded === total) resolve(images);\n                };\n                img.onerror = () => reject(new Error(`Failed to load image ${src}`));\n                img.src = src;\n            }\n        });\n    }\n\n    static loadAudio(sources) {\n        return new Promise((resolve, reject) => {\n            const audio = {};\n            let loaded = 0;\n            const total = Object.keys(sources).length;\n            for (const [key, src] of Object.entries(sources)) {\n                const audioCtx = new (window.AudioContext || window.webkitAudioContext)();\n                fetch(src)\n                    .then(r => r.arrayBuffer())\n                    .then(data => audioCtx.decodeAudioData(data))\n                    .then(buffer => {\n                        const sound = { buffer };\n                        audio[key] = sound;\n                        loaded++;\n                        if (loaded === total) resolve(audio);\n                    })\n                    .catch(err => reject(new Error(`Failed to load audio ${src}`)));\n            }\n        });\n    }\n}\n",
  "src/systems/Player.js": "import { PhysicsEngine } from '../core/PhysicsEngine.js';\nimport { InputManager } from '../core/InputManager.js';\n\nexport class Player {\n    constructor() {\n        this.size = 40;\n        this.x = 100;\n        this.y = canvas.height - this.size - 10;\n        this.velocity = { x: 0, y: 0 };\n        this.physics = new PhysicsEngine();\n    }\n\n    update(deltaTime) {\n        this.physics.update(this, deltaTime);\n    }\n\n    render(ctx) {\n        ctx.fillStyle = '#ffcc00';\n        ctx.fillRect(this.x, this.y, this.size, this.size);\n    }\n}\n",
  "src/systems/DisguiseSystem.js": "import { InputManager } from '../core/InputManager.js';\n\nexport class DisguiseSystem {\n    constructor() {\n        this.state = 'idle'; // idle, scanning, captured, restored\n        this.targetButton = null;\n        this.timer = 0;\n        this.isCaptured = false;\n    }\n\n    update(deltaTime) {\n        switch (this.state) {\n            case 'idle':\n                if (input.isDown('Space')) {\n                    this.state = 'scanning';\n                    this.timer = 0;\n                }\n                break;\n            case 'scanning':\n                this.timer += deltaTime;\n                if (this.timer >= 2) { // 2 seconds scan\n                    this.state = 'captured';\n                    this.isCaptured = true;\n                }\n                break;\n            case 'captured':\n                // Check if player is near button\n                if (this.isNearButton()) {\n                    this.state = 'restored';\n                }\n                break;\n            case 'restored':\n                this.isCaptured = false;\n                break;\n        }\n    }\n\n    isNearButton() {\n        // Simplified: check if player is within 50px of any button\n        const playerPos = { x: player.x + player.size/2, y: player.y + player.size/2 };\n        for (const btn of level.buttons) {\n            const dist = Math.hypot(btn.x - playerPos.x, btn.y - playerPos.y);\n            if (dist < 50) return true;\n        }\n        return false;\n    }\n}\n",
  "src/systems/InspectMechanic.js": "import { InputManager } from '../core/InputManager.js';\n\nexport class InspectMechanic {\n    constructor() {\n        this.state = 'idle';\n        this.timer = 0;\n        this.scanDuration = 1.5;\n    }\n\n    update(deltaTime) {\n        switch (this.state) {\n            case 'idle':\n                if (input.isDown('E')) {\n                    this.state = 'scanning';\n                    this.timer = 0;\n                }\n                break;\n            case 'scanning':\n                this.timer += deltaTime;\n                if (this.timer >= this.scanDuration) {\n                    this.state = 'reveal';\n                }\n                break;\n            case 'reveal':\n                // Reveal hidden object after scan\n                this.state = 'idle';\n                break;\n        }\n    }\n}\n",
  "src/systems/CaptureMechanic.js": "import { InputManager } from '../core/InputManager.js';\n\nexport class CaptureMechanic {\n    constructor() {\n        this.dragging = false;\n        this.dragStart = null;\n        this.ghost = null;\n    }\n\n    startDrag(button) {\n        this.dragging = true;\n        this.dragStart = { x: button.x, y: button.y };\n        this.ghost = { ...button };\n    }\n\n    update(deltaTime) {\n        if (!this.dragging) return;\n        const mouse = input.getMousePos();\n        this.ghost.x = mouse.x - this.ghost.size/2;\n        this.ghost.y = mouse.y - this.ghost.size/2;\n        // Snap to slots\n        const slot = this.findSlot(this.ghost);\n        if (slot) {\n            this.ghost.x = slot.x;\n            this.ghost.y = slot.y;\n            if (this.isValidPlacement(slot)) {\n                this.finishDrag();\n            }\n        }\n    }\n\n    finishDrag() {\n        this.dragging = false;\n        // Transfer ghost to inventory if valid\n        const slot = this.findSlot(this.ghost);\n        if (slot && this.isValidPlacement(slot)) {\n            inventory.addItem(slot.index, this.ghost.type);\n        }\n    }\n\n    isValidPlacement(slot) {\n        // Simple: slot must be empty\n        return inventory.isSlotEmpty(slot.index);\n    }\n\n    findSlot(ghost) {\n        // Return slot index that matches ghost type or first empty\n        for (let i = 0; i < inventory.slots.length; i++) {\n            const s = inventory.slots[i];\n            if (s.type === ghost.type || s.type === null) {\n                return { index: i, x: s.x, y: s.y };\n            }\n        }\n        return null;\n    }\n}\n",
  "src/systems/Restoration.js": "import { InputManager } from '../core/InputManager.js';\n\nexport class Restoration {\n    constructor() {\n        this.state = 'idle';\n        this.timer = 0;\n        this.duration = 1;\n    }\n\n    start() {\n        this.state = 'restoring';\n        this.timer = 0;\n    }\n\n    update(deltaTime) {\n        if (this.state !== 'restoring') return;\n        this.timer += deltaTime;\n        if (this.timer >= this.duration) {\n            this.state = 'idle';\n        }\n    }\n\n    render(ctx) {\n        if (this.state === 'restoring') {\n            // Simple progress bar\n            const progress = Math.min(this.timer / this.duration, 1);\n            ctx.fillStyle = '#00ff00';\n            ctx.fillRect(10, 10, 100 * progress, 10);\n        }\n    }\n}\n",
  "src/systems/AudioFeedback.js": "export class AudioFeedback {\n    constructor() {\n        this.ctx = new (window.AudioContext || window.webkitAudioContext)();\n    }\n\n    playBeep() {\n        const osc = this.ctx.createOscillator();\n        const gain = this.ctx.createGain();\n        osc.type = 'sine';\n        osc.frequency.value = 440;\n        gain.gain.value = 0.2;\n        osc.connect(gain).connect(this.ctx.destination);\n        osc.start();\n        osc.stop(this.ctx.currentTime + 0.1);\n    }\n}\n",
  "src/ui/HUD.js": "import { InputManager } from '../core/InputManager.js';\n\nexport class HUD {\n    constructor() {\n        this.objective = 'Find the hidden button';\n        this.counter = 0;\n        this.timer = 0;\n        this.maxTime = 180; // seconds\n        this.audio = new AudioFeedback();\n    }\n\n    update(deltaTime) {\n        this.timer += deltaTime;\n        if (this.timer >= this.maxTime) {\n            this.gameOver();\n        }\n    }\n\n    gameOver() {\n        this.audio.playBeep();\n        // Show toast\n        toast.show('Time\'s up!');\n    }\n\n    render(ctx) {\n        ctx.save();\n        ctx.font = '16px Arial';\n        ctx.fillStyle = '#fff';\n        ctx.fillText(this.objective, 10, 30);\n        ctx.fillText(`Time: ${Math.max(0, Math.floor(this.maxTime - this.timer))}`, 10, 50);\n        ctx.restore();\n    }\n}\n",
  "src/ui/Inventory.js": "export class Inventory {\n    constructor() {\n        this.slots = [null, null, null, null]; // 4 slots\n        this.items = [];\n    }\n\n    addItem(index, type) {\n        if (index >= 0 && index < this.slots.length) {\n            this.slots[index] = { type, x: 0, y: 0 };\n        }\n    }\n\n    isSlotEmpty(index) {\n        return this.slots[index] === null;\n    }\n\n    render(ctx) {\n        ctx.save();\n        ctx.font = '14px Arial';\n        for (let i = 0; i < this.slots.length; i++) {\n            const slot = this.slots[i];\n            ctx.strokeStyle = '#fff';\n            ctx.strokeRect(10 + i * 60, 40, 50, 50);\n            if (slot && slot.type) {\n                // Placeholder for item sprite\n                ctx.fillStyle = '#0f0';\n                ctx.fillRect(10 + i * 60 + 5, 40 + 5, 40, 40);\n            }\n        }\n        ctx.restore();\n    }\n}\n",
  "src/ui/ToastNotifications.js": "export class Toast {\n    constructor() {\n        this.element = document.createElement('div');\n        this.element.style.position = 'fixed';\n        this.element.style.bottom = '20px';\n        this.element.style.left = '50%';\n        this.element.style.transform = 'translateX(-50%)';\n        this.element.style.padding = '10px 20px';\n        this.element.style.background = 'rgba(0,0,0,0.8)';\n        this.element.style.color = '#fff';\n        this.element.style.borderRadius = '5px';\n        this.element.style.zIndex = '9999';\n        document.body.appendChild(this.element);\n    }\n\n    show(message) {\n        this.element.textContent = message;\n        this.element.style.opacity = '1';\n        setTimeout(() => {\n            this.element.style.opacity = '0';\n        }, 2000);\n    }\n}\n\nconst toast = new Toast();\nexport const toast = toast; // export for convenience\n",
  "src/ui/Accessibility.js": "export class Accessibility {\n    constructor() {\n        this.reducedMotion = false;\n        window.addEventListener('wheel', e => {\n            if (this.reducedMotion) e.preventDefault();\n        });\n        window.addEventListener('keydown', e => {\n            if (e.key === 'r' && !this.reducedMotion) {\n                this.reducedMotion = true;\n                document.body.classList.add('reduced-motion');\n            }\n        });\n    }\n}\n",
  "src/levels/LevelManager.js": "import { InputManager } from '../core/InputManager.js';\nimport { DisguiseSystem } from '../systems/DisguiseSystem.js';\nimport { InspectMechanic } from '../systems/InspectMechanic.js';\nimport { CaptureMechanic } from '../systems/CaptureMechanic.js';\nimport { Restoration } from '../systems/Restoration.js';\n\nexport class LevelManager {\n    constructor() {\n        this.buttons = [];\n        this.player = null;\n        this.disguise = new DisguiseSystem();\n        this.inspect = new InspectMechanic();\n        this.capture = new CaptureMechanic();\n        this.restoration = new Restoration();\n        this.loadLevel(0);\n    }\n\n    loadLevel(id) {\n        // Simple level data\n        this.buttons = [\n            { x: 150, y: 100, type: 'normal', state: 'idle' },\n            { x: 300, y: 150, type: 'hidden', state: 'idle' },\n            { x: 450, y: 200, type: 'normal', state: 'idle' }\n        ];\n        this.player = new Player();\n    }\n\n    update(deltaTime) {\n        this.buttons.forEach(btn => {\n            if (btn.state === 'idle') {\n                // Check for player interaction\n                const dist = Math.hypot(btn.x - (this.player.x + this.player.size/2), btn.y - (this.player.y + this.player.size/2));\n                if (dist < 50 && input.isDown('Space')) {\n                    btn.state = 'captured';\n                }\n            }\n        });\n        this.disguise.update(deltaTime);\n        this.inspect.update(deltaTime);\n        this.capture.update(deltaTime);\n        this.restoration.update(deltaTime);\n    }\n\n    render(ctx) {\n        // Render buttons\n        this.buttons.forEach(btn => {\n            this.renderButton(ctx, btn);\n        });\n    }\n\n    renderButton(ctx, btn) {\n        ctx.save();\n        ctx.translate(btn.x, btn.y);\n        if (btn.state === 'captured') {\n            ctx.fillStyle = '#0f0';\n            ctx.fillRect(-25, -25, 50, 50);\n        } else {\n            ctx.fillStyle = '#555';\n            ctx.fillRect(-25, -25, 50, 50);\n            ctx.strokeStyle = '#fff';\n            ctx.strokeRect(-25, -25, 50, 50);\n        }\n        ctx.restore();\n    }\n}\n",
  "src/levels/LevelData.js": "export const LEVEL_DATA = {\n    0: {\n        buttons: [\n            { x: 150, y: 100, type: 'normal', state: 'idle' },\n            { x: 300, y: 150, type: 'hidden', state: 'idle' },\n            { x: 450, y: 200, type: 'normal', state: 'idle' }\n        ],\n        objective: 'Capture the hidden button',\n        timeLimit: 180\n    }\n};\n",
  "src/render/Renderer.js": "export class Renderer {\n    constructor(canvas, ctx) {\n        this.canvas = canvas;\n        this.ctx = ctx;\n        this.width = canvas.width;\n        this.height = canvas.height;\n        this.scale = window.devicePixelRatio || 1;\n        this.drawBackground();\n    }\n\n    drawBackground() {\n        // Dark background\n        this.ctx.fillStyle = '#0a0a0a';\n        this.ctx.fillRect(0, 0, this.width, this.height);\n        // Scanlines\n        this.ctx.strokeStyle = 'rgba(255,255,255,0.1)';\n        for (let y = 0; y < this.height; y += 2) {\n            this.ctx.beginPath();\n            this.ctx.moveTo(0, y);\n            this.ctx.lineTo(this.width, y);\n            this.ctx.stroke();\n        }\n        // Vignette\n        const gradient = this.ctx.createRadialGradient(\n            this.width/2, this.height/2, this.width/4,\n            this.width/2, this.height/2, this.height\n        );\n        gradient.addColorStop(0, 'rgba(0,0,0,0.6)');\n        gradient.addColorStop(1, 'rgba(0,0,0,0)');\n        this.ctx.fillStyle = gradient;\n        this.ctx.fillRect(0, 0, this.width, this.height);\n    }\n\n    clear() {\n        this.ctx.clearRect(0, 0, this.width, this.height);\n    }\n}\n",
  "src/render/ButtonRenderer.js": "import { Renderer } from './Renderer.js';\n\nexport class ButtonRenderer {\n    constructor(ctx, canvasSize) {\n        this.ctx = ctx;\n        this.canvasSize = canvasSize;\n    }\n\n    renderButton(btn, x, y) {\n        const size = 50;\n        const radius = 5;\n        this.ctx.save();\n        this.ctx.translate(x, y);\n        if (btn.state === 'captured') {\n            this.ctx.fillStyle = '#0f0';\n        } else {\n            this.ctx.fillStyle = '#555';\n        }\n        this.ctx.beginPath();\n        this.ctx.roundRect(-size/2, -size/2, size, size, radius, radius);\n        this.ctx.fill();\n        this.ctx.strokeStyle = '#fff';\n        this.ctx.stroke();\n        this.ctx.restore();\n    }\n}\n",
  "src/render/EffectRenderer.js": "export class EffectRenderer {\n    constructor(ctx) {\n        this.ctx = ctx;\n    }\n\n    shake() {\n        // Simple screen shake effect\n        this.ctx.translate(Math.random() * 10 - 5, Math.random() * 10 - 5);\n    }\n\n    particles(count, x, y) {\n        this.ctx.save();\n        this.ctx.translate(x, y);\n        for (let i = 0; i < count; i++) {\n            this.ctx.fillStyle = '#fff';\n            this.ctx.beginPath();\n            this.ctx.arc(0, 0, Math.random() * 5, 0, Math.PI * 2);\n            this.ctx.fill();\n        }\n        this.ctx.restore();\n    }\n}\n",
  "assets/sprites/placeholder.png": "",
  "styles/global.css": "/* Global styles */\nhtml, body {\n    margin: 0;\n    padding: 0;\n    width: 100%;\n    height: 100%;\n    background: var(--bg-dark);\n    font-family: Arial, sans-serif;\n    color: #fff;\n}\n\ncanvas {\n    display: block;\n    width: 100%;\n    height: 100%;\n    background: var(--bg-dark);\n}\n\n:root {\n    --bg-dark: #0a0a0a;\n    --accent-cyan: #00ffff;\n    --accent-mint: #00ff9f;\n    --accent-lavender: #b497bd;\n    --text-light: #e0e0e0;\n}\n\n/* HUD */\n.hud {\n    position: absolute;\n    top: 10px;\n    left: 10px;\n    font-size: 16px;\n    color: var(--text-light);\n}\n\n/* Toast */\n.toast {\n    position: fixed;\n    bottom: 20px;\n    left: 50%;\n    transform: translateX(-50%);\n    background: rgba(0,0,0,0.8);\n    color: #fff;\n    padding: 10px 20px;\n    border-radius: 5px;\n    z-index: 9999;\n}\n\n/* Reduced motion */\n.reduced-motion .hud {\n    transition: none !important;\n}\n",
  "README.md": "# Ghost Hunt Game\n\nA simple 2D canvas game where you explore, capture hidden objects, and restore them.\n\n## Features\n- Responsive canvas for mobile\n- Emoji favicon\n- Vibrant color palette\n- LocalStorage high score\n- WebAudio sound effects\n- Speedrun timer\n- Accessibility options\n\n## Controls\n- Arrow keys / WASD: Move\n- Space: Scan / Interact\n- E: Inspect\n- Drag ghost to inventory slots\n\n## Build & Run\nOpen `index.html` in a browser. No build step required.\n"
}
