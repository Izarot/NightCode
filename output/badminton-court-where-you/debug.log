const GAME_WIDTH = 1280;
const GAME_HEIGHT = 720;
const FPS = 60;
const DT = 1 / FPS;

class Game {
  constructor(canvas) {
    this.canvas = canvas;
    this.ctx = canvas.getContext('2d');
    this.width = GAME_WIDTH;
    this.height = GAME_HEIGHT;
    this.scale = 1;
    this.lastTime = 0;
    this.accumulator = 0;
    this.running = false;
    this.drill = new Drill('High Clear');
    this.player = new Player();
    this.shuttle = new Shuttle();
    this.ai = new AI();
    this.ui = new UI();
    this.audio = new AudioManager();
    this.highScore = parseInt(localStorage.getItem('badmintonHighScore')) || 0;
    this.score = 0;
    this.totalShots = 0;
    this.successfulShots = 0;
    this.drillStartTime = performance.now();
    this.drillTimeLimit = this.drill.timeLimit;
    this.init();
  }

  init() {
    // set up input
    window.addEventListener('keydown', e => this.handleKeyDown(e));
    window.addEventListener('keyup', e => this.handleKeyUp(e));
    // resize canvas to container
    this.resizeCanvas();
    // start loop
    this.running = true;
    requestAnimationFrame(this.loop.bind(this));
  }

  resizeCanvas() {
    const container = this.canvas.parentElement;
    const cw = container.clientWidth;
    const ch = container.clientHeight;
    this.scale = Math.min(cw / this.width, ch / this.height);
    this.canvas.style.transform = `scale(${this.scale})`;
  }

  loop(timestamp) {
    const delta = (timestamp - this.lastTime) / 1000; // seconds
    this.lastTime = timestamp;
    this.accumulator += delta;
    while (this.accumulator >= DT) {
      this.update(DT);
      this.accumulator -= DT;
    }
    this.render();
    if (this.running) requestAnimationFrame(this.loop.bind(this));
  }

  update(dt) {
    this.player.update(dt, this.inputState);
    this.shuttle.update(dt);
    this.ai.update(dt, this.shuttle);
    this.ui.update(dt, this.score, this.totalShots, this.successfulShots, this.drillTimeLimit - (performance.now() - this.drillStartTime));
    // check drill time
    if (performance.now() - this.drillStartTime >= this.drillTimeLimit * 1000) {
      this.endDrill();
    }
  }

  render() {
    this.ctx.clearRect(0, 0, this.width, this.height);
    this.drawBackground();
    this.player.draw(this.ctx);
    this.shuttle.draw(this.ctx);
    this.ai.draw(this.ctx);
    this.ui.draw(this.ctx);
  }

  drawBackground() {
    // court lines
    this.ctx.strokeStyle = '#fff';
    this.ctx.lineWidth = 2;
    // sidelines
    this.ctx.beginPath();
    this.ctx.moveTo(0, this.height/2);
    this.ctx.lineTo(this.width, this.height/2);
    this.ctx.stroke();
    // service lines etc (simplified)
  }

  handleKeyDown(e) {
    this.inputState = this.inputState || {};
    switch(e.key) {
      case 'ArrowLeft':
      case 'a':
        this.inputState.left = true;
        break;
      case 'ArrowRight':
      case 'd':
        this.inputState.right = true;
        break;
      case 'ArrowUp':
      case 'w':
        this.inputState.forward = true;
        break;
      case 'ArrowDown':
      case 's':
        this.inputState.backward = true;
        break;
      case 'Shift':
      case ' ':
        this.inputState.shift = true;
        break;
      case ' ':
        this.inputState.space = true;
        break;
    }
  }

  handleKeyUp(e) {
    this.inputState = this.inputState || {};
    switch(e.key) {
      case 'ArrowLeft':
      case 'a':
        this.inputState.left = false;
        break;
      case 'ArrowRight':
      case 'd':
        this.inputState.right = false;
        break;
      case 'ArrowUp':
      case 'w':
        this.inputState.forward = false;
        break;
      case 'ArrowDown':
      case 's':
        this.inputState.backward = false;
        break;
      case 'Shift':
      case ' ':
        this.inputState.shift = false;
        break;
      case ' ':
        this.inputState.space = false;
        break;
    }
  }

  update(dt) {
    this.player.update(dt, this.inputState);
    this.shuttle.update(dt);
    this.ai.update(dt, this.shuttle);
    // scoring
    if (this.shuttle.hitPlayer(this.player)) {
      this.totalShots++;
      this.successfulShots++;
      this.score += 10;
      this.audio.playSound('hit');
    }
    // maybe also check net collision
    if (this.shuttle.collidesNet()) {
      this.totalShots++;
      this.successfulShots++;
      this.score += 5;
      this.audio.playSound('net');
    }
  }

  endDrill() {
    this.running = false;
    // update high score
    if (this.score > this.highScore) {
      this.highScore = this.score;
      localStorage.setItem('badmintonHighScore', this.highScore);
    }
    // show results (simple alert)
    alert(`Drill completed! Score: ${this.score}\nHigh Score: ${this.highScore}`);
  }

  render() {
    this.ctx.clearRect(0,0,this.width,this.height);
    this.drawBackground();
    this.player.draw(this.ctx);
    this.shuttle.draw(this.ctx);
    this.ai.draw(this.ctx);
    this.ui.update(this.score, this.totalShots, this.successfulShots, this.drillTimeLimit - (performance.now() - this.drillStartTime));
    this.ui.draw(this.ctx);
  }
}

class Player {
  constructor() {
    this.size = { w: 32, h: 48 };
    this.position = { x: this.canvas.width/2, y: this.canvas.height/2 };
    this.velocity = { x:0, y:0 };
    this.acceleration = 12;
    this.deceleration = 10;
    this.maxSpeed = 6.75;
    this.onGround = true;
    this.jumpVelocity = 0;
    this.gravity = 8;
    this.jumpDuration = 0.3;
    this.jumpTimer = 0;
    this.keys = { forward:false, backward:false, left:false, right:false, shift:false, space:false };
  }

  update(dt, input) {
    // horizontal movement
    let targetX = 0;
    if (input.left) targetX -= 1;
    if (input.right) targetX += 1;
    // apply acceleration
    this.velocity.x += targetX * this.acceleration * dt;
    // limit speed
    if (Math.abs(this.velocity.x) > this.maxSpeed) {
      this.velocity.x = this.maxSpeed * Math.sign(this.velocity.x);
    }
    // apply deceleration when no input
    if (!input.left && !input.right) {
      this.velocity.x *= Math.max(0, 1 - this.deceleration * dt);
    }
    this.position.x += this.velocity.x * dt;

    // vertical movement (jump)
    if (input.space && this.onGround) {
      this.jumpTimer = this.jumpDuration;
      this.velocity.y = -this.jumpVelocity;
      this.onGround = false;
    }
    if (!input.space) {
      this.jumpTimer = Math.max(0, this.jumpTimer - dt);
    }
    if (this.jumpTimer > 0) {
      this.velocity.y += this.gravity * dt;
      this.jumpTimer -= dt;
    } else {
      this.velocity.y += this.gravity * dt;
    }
    this.position.y += this.velocity.y * dt;

    // ground collision (court boundaries)
    const groundY = this.canvas.height/2; // approximate ground line
    const courtTop = 0;
    const courtBottom = this.canvas.height/2;
    if (this.position.y > courtBottom) {
      this.position.y = courtBottom;
      this.velocity.y = 0;
      this.onGround = true;
    } else if (this.position.y < courtTop) {
      this.position.y = courtTop;
      this.velocity.y = 0;
      this.onGround = true;
    }
  }

  draw(ctx) {
    ctx.save();
    ctx.translate(this.position.x, this.position.y);
    // draw player sprite (placeholder rectangle)
    ctx.fillStyle = '#1e90ff';
    ctx.fillRect(-this.size.w/2, -this.size.h/2, this.size.w, this.size.h);
    ctx.restore();
  }
}

class Shuttle {
  constructor() {
    this.position = { x: 0, y: 0 };
    this.velocity = { x:0, y:0 };
    this.speed = 0;
    this.angle = 0; // radians
    this.trail = [];
    this.life = 0; // seconds
    this.maxLife = 2;
    this.onGround = false;
    this.reset();
  }

  reset() {
    this.position.x = -this.canvas.width/4; // start from left side
    this.position.y = this.canvas.height/4;
    this.speed = 8 + Math.random()*6; // 8-14
    this.angle = (Math.PI/4) + (Math.random()*Math.PI/6); // 45° +/- 30°
    this.trail = [];
    this.life = 0;
    this.onGround = false;
  }

  update(dt) {
    // simple projectile motion with gravity and drag
    const g = 9.8;
    const drag = 0.02;
    // update speed based on drag (approx)
    this.speed *= Math.max(0.9, 1 - drag * dt);
    // update position
    this.position.x += Math.cos(this.angle) * this.speed * dt;
    this.position.y += Math.sin(this.angle) * this.speed * dt;
    this.speed -= g * dt; // gravity reduces speed (vertical component)
    // apply gravity to vertical component
    this.velocity.y += g * dt;
    this.position.y += this.velocity.y * dt;
    // ground collision
    const groundY = this.canvas.height/2;
    if (this.position.y > groundY) {
      this.position.y = groundY;
      this.velocity.y = 0;
      this.onGround = true;
    }
    // net collision (y = canvas.height/4? Actually net height 0.2 units; we approximate)
    // We'll treat net as y = canvas.height/4 (approx)
    const netY = this.canvas.height/4;
    if (this.position.y < netY) {
      // bounce
      this.position.y = netY;
      this.velocity.y = -this.velocity.y * 0.7; // elastic
      this.speed = Math.abs(this.velocity.x) + Math.abs(this.velocity.y);
    }
    // update trail
    this.life += dt;
    if (this.life < 0.5) {
      this.trail.push({x:this.position.x, y:this.position.y, age:0});
      // keep max 10 particles
      while (this.trail.length > 10) this.trail.shift();
    } else {
      // fade out
      this.trail = this.trail.filter(p => p.age < 0.5);
      this.trail.forEach(p => p.age += dt);
    }
  }

  draw(ctx) {
    // draw trail particles
    ctx.save();
    for (let p of this.trail) {
      ctx.globalAlpha = p.age / 0.5;
      ctx.fillStyle = '#ffd700';
      ctx.beginPath();
      ctx.arc(p.x, p.y, 2, 0, Math.PI*2);
      ctx.fill();
    }
    ctx.restore();

    // draw shuttle (simple circle)
    ctx.save();
    ctx.translate(this.position.x, this.position.y);
    ctx.rotate(this.angle);
    ctx.fillStyle = '#ffd700';
    ctx.beginPath();
    ctx.arc(0,0,5,0,Math.PI*2);
    ctx.fill();
    ctx.restore();
  }

  collidesNet() {
    const netY = this.canvas.height/4;
    return this.position.y < netY && Math.abs(this.position.x) < this.canvas.width/8;
  }

  hitPlayer(player) {
    const dx = this.position.x - player.position.x;
    const dy = this.position.y - player.position.y;
    const dist = Math.hypot(dx, dy);
    return dist < 10; // simple radius
  }
}

class AI {
  constructor() {
    this.position = { x: this.canvas.width/2, y: this.canvas.height/4 };
    this.velocity = { x:0, y:0 };
    this.maxSpeed = 5.4; // 0.8 * player max speed
    this.onGround = true;
  }

  update(dt, shuttle) {
    // move towards shuttle
    const dx = shuttle.position.x - this.position.x;
    const dy = shuttle.position.y - this.position.y;
    const distance = Math.hypot(dx, dy);
    if (distance > 0.1) {
      const speed = Math.min(this.maxSpeed, distance * 2);
      this.velocity.x = (dx / distance) * speed;
      this.velocity.y = (dy / distance) * speed;
    } else {
      this.velocity.x = 0;
      this.velocity.y = 0;
    }
    this.position.x += this.velocity.x * dt;
    this.position.y += this.velocity.y * dt;

    // keep on court
    const courtTop = 0;
    const courtBottom = this.canvas.height/2;
    if (this.position.y > courtBottom) {
      this.position.y = courtBottom;
      this.velocity.y = 0;
      this.onGround = true;
    } else if (this.position.y < courtTop) {
      this.position.y = courtTop;
      this.velocity.y = 0;
      this.onGround = true;
    }
  }

  draw(ctx) {
    ctx.save();
    ctx.translate(this.position.x, this.position.y);
    ctx.fillStyle = '#ff4500';
    ctx.fillRect(-16, -24, 32, 48);
    ctx.restore();
  }
}

class UI {
  constructor() {
    this.scoreEl = document.getElementById('score');
    this.drillInfoEl = document.getElementById('drillInfo');
    this.timerEl = document.getElementById('timer');
    this.powerFill = document.querySelector('#powerMeter .fill');
    this.progressFill = document.querySelector('#progressWheel .fill');
  }

  update(dt, score, totalShots, successfulShots, timeLeft) {
    this.scoreEl.textContent = `Score: ${score} / Accuracy: ${Math.round((successfulShots/totalShots)*100)}%`;
    this.drillInfoEl.textContent = `Drill: ${this.drillInfoEl.textContent.split(': ')[1]}`;
    const minutes = Math.floor(timeLeft/60);
    const seconds = Math.floor(timeLeft%60);
    this.timerEl.textContent = `Time: ${minutes}:${seconds.toString().padStart(2,'0')}`;
    // power meter: based on player shift hold time (simulate)
    const power = Math.min(1, this.playerShiftHold / 2); // placeholder
    this.powerFill.style.width = `${power*100}%`;
    // progress wheel: based on score / 200
    const progress = Math.min(1, score/200);
    this.progressFill.style.width = `${progress*100}%`;
  }

  draw(ctx) {
    // nothing else, UI already drawn via DOM
  }
}

class AudioManager {
  constructor() {
    this.ctx = new (window.AudioContext || window.webkitAudioContext)();
    this.buffers = {};
    this.loadSounds();
  }

  async loadSounds() {
    // generate simple tones for each sound type
    const createOsc = (type, freq, duration) => {
      const osc = this.ctx.createOscillator();
      const gain = this.ctx.createGain();
      osc.type = type;
      osc.frequency.value = freq;
      gain.gain.setValueAtTime(0.2, this.ctx.currentTime);
      gain.gain.exponentialRampToValueAtTime(0.001, this.ctx.currentTime + duration);
      osc.connect(gain).connect(this.ctx.destination);
      osc.start(this.ctx.currentTime);
      osc.stop(this.ctx.currentTime + duration);
    };
    // serve thud
    await this.playTone('thud', 110, 0.1);
    // whoosh (scaled later)
    this.whooshFreq = 440;
    // tap
    await this.playTone('tap', 880, 0.05);
    // ding
    await this.playTone('ding', 1760, 0.1);
    // oops
    await this.playTone('oops', 220, 0.2);
  }

  playTone(type, freq, duration) {
    return new Promise(resolve => {
      const osc = this.ctx.createOscillator();
      const gain = this.ctx.createGain();
      osc.type = type;
      osc.frequency.value = freq;
      gain.gain.setValueAtTime(0.2, this.ctx.currentTime);
      gain.gain.exponentialRampToValueAtTime(0.001, this.ctx.currentTime + duration);
      osc.connect(gain).connect(this.ctx.destination);
      osc.start(this.ctx.currentTime);
      osc.stop(this.ctx.currentTime + duration);
      osc.onended = () => resolve();
    });
  }

  playSound(type) {
    // map type to frequency
    const map = {
      hit: 660,
      net: 550,
      serve: 110,
      whoosh: this.whooshFreq,
      success: 1760,
      miss: 220
    };
    const freq = map[type] || 660;
    const now = this.ctx.currentTime;
    const osc = this.ctx.createOscillator();
    const gain = this.ctx.createGain();
    osc.type = 'sine';
    osc.frequency.value = freq;
    gain.gain.setValueAtTime(0.15, now);
    gain.gain.exponentialRampToValueAtTime(0.001, now + 0.2);
    osc.connect(gain).connect(this.ctx.destination);
    osc.start(now);
    osc.stop(now + 0.2);
  }
}

