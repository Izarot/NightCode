  "index.html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, user-scalable=no\">\n    <title>SKY TYPER</title>\n    <link rel=\"icon\" href=\"data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🛸</text></svg>\">\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n    <link href=\"https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap\" rel=\"stylesheet\">\n    <link rel=\"stylesheet\" href=\"css/style.css\">\n</head>\n<body>\n    <div id=\"game-container\">\n        <canvas id=\"game-canvas\"></canvas>\n        <div id=\"hud\" class=\"glass\">\n            <div class=\"hud-block top-left\">\n                <div class=\"hud-label\">SCORE</div>\n                <div id=\"score-value\" class=\"hud-value\">0</div>\n                <div class=\"hud-label\">COMBO</div>\n                <div id=\"combo-value\" class=\"hud-value combo\">x1</div>\n            </div>\n            <div class=\"hud-block top-center\">\n                <div id=\"timer-value\" class=\"hud-timer\">00:00.00</div>\n            </div>\n            <div class=\"hud-block top-right\">\n                <div class=\"hud-label\">LIVES</div>\n                <div id=\"lives-display\" class=\"hud-lives\"></div>\n                <div class=\"hud-label\">ACCURACY</div>\n                <div id=\"accuracy-value\" class=\"hud-value accuracy\">100%</div>\n            </div>\n            <div class=\"hud-block bottom-center\">\n                <div id=\"progress-bar-container\">\n                    <div id=\"progress-bar-fill\"></div>\n                </div>\n            </div>\n            <div id=\"input-buffer\" class=\"glass input-buffer\"></div>\n        </div>\n        <div id=\"start-screen\" class=\"glass overlay\">\n            <h1>SKY TYPER</h1>\n            <p>Type the falling words before they reach the bottom.</p>\n            <p class=\"controls\">Press any key to start</p>\n            <div id=\"high-score-display\" class=\"high-score\">HIGH SCORE: <span id=\"high-score-value\">0</span></div>\n        </div>\n        <div id=\"game-over-screen\" class=\"glass overlay hidden\">\n            <h1>GAME OVER</h1>\n            <p>Final Score: <span id=\"final-score\">0</span></p>\n            <p>Accuracy: <span id=\"final-accuracy\">0%</span></p>\n            <p class=\"controls\">Press any key to restart</p>\n        </div>\n    </div>\n    <script type=\"module\" src=\"js/main.js\"></script>\n</body>\n</html>",
  "css/style.css": ":root {\n    --bg-deep: #0B0C2A;\n    --bg-black: #000000;\n    --neon-cyan: #00F0FF;\n    --neon-magenta: #FF0055;\n    --neon-yellow: #F2FF00;\n    --neon-green: #00FF88;\n    --glass-bg: rgba(255, 255, 255, 0.05);\n    --glass-border: rgba(255, 255, 255, 0.1);\n    --text-white: #FFFFFF;\n    --text-dim: #8888AA;\n}\n\n* {\n    margin: 0;\n    padding: 0;\n    box-sizing: border-box;\n    font-family: 'Press Start 2P', cursive;\n}\n\nbody {\n    background: var(--bg-black);\n    color: var(--text-white);\n    overflow: hidden;\n    height: 100vh;\n    width: 100vw;\n    display: flex;\n    justify-content: center;\n    align-items: center;\n    touch-action: none;\n}\n\n#game-container {\n    position: relative;\n    width: 100%;\n    height: 100%;\n    max-width: 1200px;\n    max-height: 900px;\n    background: var(--bg-deep);\n    border: 2px solid var(--neon-cyan);\n    box-shadow: 0 0 30px rgba(0, 240, 255, 0.3), inset 0 0 60px rgba(0, 0, 0, 0.5);\n}\n\n#game-canvas {\n    display: block;\n    width: 100%;\n    height: 100%;\n    position: absolute;\n    top: 0;\n    left: 0;\n    z-index: 1;\n}\n\n#hud {\n    position: absolute;\n    top: 0;\n    left: 0;\n    width: 100%;\n    height: 100%;\n    pointer-events: none;\n    z-index: 10;\n    display: flex;\n    flex-direction: column;\n    justify-content: space-between;\n    padding: 15px;\n}\n\n.glass {\n    background: var(--glass-bg);\n    backdrop-filter: blur(4px);\n    -webkit-backdrop-filter: blur(4px);\n    border: 1px solid var(--glass-border);\n}\n\n.hud-block {\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    gap: 4px;\n}\n\n.top-left { align-items: flex-start; }\n.top-right { align-items: flex-end; }\n.top-center { position: absolute; top: 15px; left: 50%; transform: translateX(-50%); }\n.bottom-center { position: absolute; bottom: 15px; left: 50%; transform: translateX(-50%); width: 80%; max-width: 400px; }\n\n.hud-label {\n    font-size: 8px;\n    color: var(--text-dim);\n    text-transform: uppercase;\n    letter-spacing: 1px;\n}\n\n.hud-value {\n    font-size: 18px;\n    font-weight: bold;\n    line-height: 1;\n    text-shadow: 0 0 5px currentColor;\n}\n\n.hud-value.combo { color: var(--neon-yellow); animation: pulse 1s infinite alternate; }\n.hud-value.accuracy.green { color: var(--neon-green); }\n.hud-value.accuracy.yellow { color: var(--neon-yellow); }\n.hud-value.accuracy.red { color: var(--neon-magenta); }\n\n@keyframes pulse { from { transform: scale(1); } to { transform: scale(1.1); } }\n\n.hud-timer {\n    font-size: 20px;\n    font-variant-numeric: tabular-nums;\n    color: var(--neon-cyan);\n    text-shadow: 0 0 10px var(--neon-cyan);\n    background: rgba(0, 0, 0, 0.5);\n    padding: 4px 12px;\n    border-radius: 4px;\n    border: 1px solid var(--neon-cyan);\n}\n\n.hud-lives {\n    display: flex;\n    gap: 6px;\n}\n\n.life-icon {\n    width: 14px;\n    height: 14px;\n    border: 2px solid var(--neon-cyan);\n    border-radius: 50%;\n    box-shadow: 0 0 5px var(--neon-cyan);\n    background: transparent;\n}\n\n.life-icon.lost {\n    border-color: var(--neon-magenta);\n    box-shadow: 0 0 5px var(--neon-magenta);\n    opacity: 0.3;\n}\n\n#progress-bar-container {\n    height: 6px;\n    background: rgba(0, 0, 0, 0.5);\n    border: 1px solid var(--neon-cyan);\n    border-radius: 3px;\n    overflow: hidden;\n    box-shadow: 0 0 10px rgba(0, 240, 255, 0.2);\n}\n\n#progress-bar-fill {\n    height: 100%;\n    width: 0%;\n    background: linear-gradient(90deg, var(--neon-cyan), var(--neon-yellow));\n    box-shadow: 0 0 10px var(--neon-cyan);\n    transition: width 0.1s linear, background 0.2s;\n}\n\n#progress-bar-fill.danger {\n    background: var(--neon-magenta);\n    box-shadow: 0 0 10px var(--neon-magenta);\n    animation: flash 0.5s infinite alternate;\n}\n\n@keyframes flash { from { opacity: 1; } to { opacity: 0.5; } }\n\n.input-buffer {\n    position: absolute;\n    bottom: 80px;\n    left: 50%;\n    transform: translateX(-50%);\n    padding: 8px 20px;\n    border-radius: 20px;\n    font-size: 24px;\n    color: var(--neon-yellow);\n    text-shadow: 0 0 10px var(--neon-yellow);\n    border: 2px solid var(--neon-yellow);\n    min-width: 60px;\n    text-align: center;\n    opacity: 0;\n    transition: opacity 0.1s;\n    pointer-events: none;\n    white-space: nowrap;\n}\n\n.input-buffer.active { opacity: 1; }\n\n.overlay {\n    position: absolute;\n    top: 0;\n    left: 0;\n    width: 100%;\n    height: 100%;\n    display: flex;\n    flex-direction: column;\n    justify-content: center;\n    align-items: center;\n    gap: 20px;\n    padding: 20px;\n    text-align: center;\n    z-index: 20;\n    background: rgba(11, 12, 42, 0.95);\n}\n\n.overlay.hidden { display: none; }\n\n.overlay h1 {\n    font-size: clamp(32px, 10vw, 64px);\n    color: var(--neon-cyan);\n    text-shadow: 0 0 20px var(--neon-cyan), 0 0 40px var(--neon-cyan);\n    letter-spacing: 4px;\n    animation: glow 2s infinite alternate;\n}\n\n@keyframes glow { from { text-shadow: 0 0 10px var(--neon-cyan); } to { text-shadow: 0 0 30px var(--neon-cyan), 0 0 60px var(--neon-cyan); } }\n\n.overlay p {\n    font-size: clamp(10px, 3vw, 14px);\n    color: var(--text-dim);\n    max-width: 80%;\n    line-height: 1.6;\n}\n\n.overlay p.controls {\n    color: var(--neon-yellow);\n    animation: blink 1s infinite;\n}\n\n@keyframes blink { 0%, 100% { opacity: 1; } 50% { opacity: 0.3; } }\n\n.high-score {\n    margin-top: 20px;\n    font-size: 14px;\n    color: var(--neon-yellow);\n    border-top: 1px solid var(--glass-border);\n    padding-top: 20px;\n    width: 100%;\n    max-width: 400px;\n}\n\n@media (max-width: 600px) {\n    .hud-value { font-size: 14px; }\n    .hud-label { font-size: 6px; }\n    .hud-timer { font-size: 16px; padding: 2px 8px; }\n    #hud { padding: 10px; }\n    .life-icon { width: 10px; height: 10px; }\n    .input-buffer { font-size: 18px; padding: 6px 15px; bottom: 60px; }\n}",
  "js/audio.js": "export class AudioEngine {\n    constructor() {\n        this.ctx = null;\n        this.masterGain = null;\n        this.enabled = true;\n        this.init();\n    }\n\n    init() {\n        try {\n            this.ctx = new (window.AudioContext || window.webkitAudioContext)();\n            this.masterGain = this.ctx.createGain();\n            this.masterGain.gain.value = 0.3;\n            this.masterGain.connect(this.ctx.destination);\n        } catch (e) {\n            console.warn('Web Audio API not supported');\n            this.enabled = false;\n        }\n    }\n\n    resume() {\n        if (this.ctx && this.ctx.state === 'suspended') {\n            this.ctx.resume();\n        }\n    }\n\n    playKeystroke(correct = true) {\n        if (!this.enabled) return;\n        this.resume();\n        const now = this.ctx.currentTime;\n        const osc = this.ctx.createOscillator();\n        const gain = this.ctx.createGain();\n        osc.type = correct ? 'square' : 'sawtooth';\n        osc.frequency.setValueAtTime(correct ? 880 : 220, now);\n        osc.frequency.exponentialRampToValueAtTime(correct ? 1760 : 110, now + 0.05);\n        gain.gain.setValueAtTime(0.1, now);\n        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.1);\n        osc.connect(gain).connect(this.masterGain);\n        osc.start(now);\n        osc.stop(now + 0.15);\n    }\n\n    playExplosion() {\n        if (!this.enabled) return;\n        this.resume();\n        const now = this.ctx.currentTime;\n        const noiseBuffer = this.ctx.createBuffer(1, this.ctx.sampleRate * 0.3, this.ctx.sampleRate);\n        const data = noiseBuffer.getChannelData(0);\n        for (let i = 0; i < data.length; i++) {\n            data[i] = Math.random() * 2 - 1;\n        }\n        const noise = this.ctx.createBufferSource();\n        noise.buffer = noiseBuffer;\n        const filter = this.ctx.createBiquadFilter();\n        filter.type = 'bandpass';\n        filter.frequency.setValueAtTime(800, now);\n        filter.frequency.exponentialRampToValueAtTime(200, now + 0.3);\n        filter.Q.value = 2;\n        const gain = this.ctx.createGain();\n        gain.gain.setValueAtTime(0.2, now);\n        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.4);\n        noise.connect(filter).connect(gain).connect(this.masterGain);\n        noise.start(now);\n        noise.stop(now + 0.4);\n    }\n\n    playStrike() {\n        if (!this.enabled) return;\n        this.resume();\n        const now = this.ctx.currentTime;\n        const osc = this.ctx.createOscillator();\n        const gain = this.ctx.createGain();\n        osc.type = 'sawtooth';\n        osc.frequency.setValueAtTime(150, now);\n        osc.frequency.exponentialRampToValueAtTime(50, now + 0.2);\n        gain.gain.setValueAtTime(0.15, now);\n        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.3);\n        osc.connect(gain).connect(this.masterGain);\n        osc.start(now);\n        osc.stop(now + 0.3);\n    }\n\n    playWaveBreach() {\n        if (!this.enabled) return;\n        this.resume();\n        const now = this.ctx.currentTime;\n        [440, 554, 660, 880].forEach((freq, i) => {\n            const osc = this.ctx.createOscillator();\n            const gain = this.ctx.createGain();\n            osc.type = 'triangle';\n            osc.frequency.value = freq;\n            gain.gain.setValueAtTime(0, now + i * 0.05);\n            gain.gain.linearRampToValueAtTime(0.08, now + i * 0.05 + 0.02);\n            gain.gain.exponentialRampToValueAtTime(0.001, now + i * 0.05 + 0.3);\n            osc.connect(gain).connect(this.masterGain);\n            osc.start(now + i * 0.05);\n            osc.stop(now + i * 0.05 + 0.4);\n        });\n    }\n\n    playGameOver() {\n        if (!this.enabled) return;\n        this.resume();\n        const now = this.ctx.currentTime;\n        [330, 294, 262, 247].forEach((freq, i) => {\n            const osc = this.ctx.createOscillator();\n            const gain = this.ctx.createGain();\n            osc.type = 'sine';\n            osc.frequency.value = freq;\n            gain.gain.setValueAtTime(0, now + i * 0.15);\n            gain.gain.linearRampToValueAtTime(0.1, now + i * 0.15 + 0.05);\n            gain.gain.exponentialRampToValueAtTime(0.001, now + i * 0.15 + 0.8);\n            osc.connect(gain).connect(this.masterGain);\n            osc.start(now + i * 0.15);\n            osc.stop(now + i * 0.15 + 1);\n        });\n    }\n}",
