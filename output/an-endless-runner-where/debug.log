const Input = {
  keys: {},
  jumpPressed: false,
  jumpHeld: false,
  swipeDown: false,
  init() {
    window.addEventListener('keydown', e => {
      if (e.code === 'Space' || e.code === 'ArrowUp' || e.code === 'KeyW') {
        this.jumpPressed = true;
        this.jumpHeld = true;
        e.preventDefault();
      }
      if (e.code === 'KeyP' || e.code === 'Escape') {
        this.pauseRequested = true;
      }
      if (e.code === 'KeyR') {
        this.restartRequested = true;
      }
    });
    window.addEventListener('keyup', e => {
      if (e.code === 'Space' || e.code === 'ArrowUp' || e.code === 'KeyW') {
        this.jumpHeld = false;
      }
    });
    const canvas = document.getElementById('gameCanvas');
    canvas.addEventListener('touchstart', e => {
      e.preventDefault();
      this.handleTouch(e.touches[0]);
    }, { passive: false });
    canvas.addEventListener('touchend', e => {
      this.jumpHeld = false;
    }, { passive: false });
    canvas.addEventListener('mousedown', e => {
      this.handleMouse(e);
    });
    canvas.addEventListener('mouseup', () => {
      this.jumpHeld = false;
    });
  },
  handleTouch(touch) {
    // tap = jump, hold = higher jump, swipe down = fast fall
    const rect = canvas.getBoundingClientRect();
    const x = touch.clientX - rect.left;
    const y = touch.clientY - rect.top;
    // Simple: tap anywhere = jump
    this.jumpPressed = true;
    this.jumpHeld = true;
    this.lastTouchX = x;
    this.lastTouchY = y;
    this.touchStartTime = Date.now();
  },
  handleMouse(e) {
    this.jumpPressed = true;
    this.jumpHeld = true;
  },
  consumeJump() {
    const v = this.jumpPressed;
    this.jumpPressed = false;
    return v;
  },
  isJumpHeld() { return this.jumpHeld; },
  requestPause() { this.pauseRequested = true; },
  requestRestart() { this.restartRequested = true; },
  clearRequests() {
    this.pauseRequested = false;
    this.restartRequested = false;
  }
};
```

