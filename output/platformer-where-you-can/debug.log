// src/main.js
const canvas = document.getElementById('gameCanvas');
const ctx = canvas.getContext('2d');
const uiTimer = document.getElementById('timer');
const uiHud = document.getElementById('hud');
const uiRank = document.getElementById('rank');

// Resize canvas to window size
function resizeCanvas() {
  canvas.width = window.innerWidth;
  canvas.height = window.innerHeight;
}
window.addEventListener('resize', resizeCanvas);
resizeCanvas();

// Game constants
const GRAVITY = 2500;
const JUMP_FORCE = -700;
const MAX_SPEED = 400;
const NORMAL_SCALE = 1.0;
const SMALL_SCALE = 0.5;
const SHRINK_TIME = 0.35;
const COOLDOWN = 1.0;

// Colors (vibrant palette)
const COLORS = {
  background: '#0B0C15',
  playerNormal: '#00F0FF',
  playerSmall: '#FF0055',
  platform: '#222',
  gap: '#00F0FF',
  timer: '#fff',
  hud: '#fff',
};

// Audio
let audioCtx;
let jumpSound;
let shrinkSound;
let landSound;
let collectSound;
let hazardSound;

function initAudio() {
  audioCtx = new (window.AudioContext || window.webkitAudioContext)();
  const oscillator = audioCtx.createOscillator();
  const gain = audioCtx.createGain();
  oscillator.type = 'sine';
  oscillator.frequency.value = 440;
  gain.gain.value = 0.2;
  oscillator.connect(gain).connect(audioCtx.destination);
  // create buffer for short sounds
  function playTone(freq, duration) {
    const ctx = audioCtx;
    const osc = ctx.createOscillator();
    const gain = ctx.createGain();
    osc.type = 'sine';
    osc.frequency.value = freq;
    gain.gain.setValueAtTime(0.2, ctx.currentTime);
    gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + duration);
    osc.connect(gain).connect(ctx.destination);
    osc.start();
    osc.stop(ctx.currentTime + duration);
  }
  jumpSound = () => playTone(880, 0.07);
  shrinkSound = () => playTone(660, 0.1);
  landSound = () => playTone(330, 0.15);
  collectSound = () => playTone(1320, 0.07);
  hazardSound = () => playTone(110, 0.2);
}
initAudio();

// Load level
async function loadLevel() {
  const resp = await fetch('src/assets/levels/level1.json');
  const data = await resp.json();
  return data;
}

// Player class
class Player {
  constructor(x, y) {
    this.x = x;
    this.y = y;
    this.vx = 0;
    this.vy = 0;
    this.sx = NORMAL_SCALE;
    this.sy = NORMAL_SCALE;
    this.scaleTimer = 0;
    this.shrinkCooldown = 0;
    this.coyoteTime = 0;
    this.jumpBuffer = 0;
    this.state = 'idle';
  }
  update(dt) {
    // Apply gravity
    this.vy += GRAVITY * dt;
    // Horizontal movement
    let accel = 2000;
    if (this.sx === SMALL_SCALE) accel *= 0.5;
    if (this.state === 'air') accel *= 0.6;
    this.vx += accel * dt;
    // Cap speed
    const speedCap = this.sx === SMALL_SCALE ? MAX_SPEED * 0.5 : MAX_SPEED;
    if (this.vx > speedCap) this.vx = speedCap;
    if (this.vx < -speedCap) this.vx = -speedCap;
    // Apply movement
    this.x += this.vx * dt;
    this.y += this.vy * dt;
    // Ground detection
    // (Assume ground is y > some value; for simplicity, treat any y as ground if not colliding)
    // We'll handle collisions later.
    // Coyote time
    if (this.coyoteTime > 0) this.coyoteTime -= dt;
    // Jump buffer
    if (this.jumpBuffer > 0) this.jumpBuffer -= dt;
    // Shrink/expand handling
    if (this.shrinkCooldown > 0) this.shrinkCooldown -= dt;
    // Input handling will set state
    // Update scale timer if shrinking/expanding
    if (this.state === 'shrinking') {
      this.scaleTimer += dt;
      if (this.scaleTimer >= SHRINK_TIME) {
        this.sx = SMALL_SCALE;
        this.state = 'normal';
        this.scaleTimer = 0;
        // Play sound
        shrinkSound();
      }
    }
    if (this.state === 'expanding') {
      this.scaleTimer += dt;
      if (this.scaleTimer >= SHRINK_TIME) {
        this.sx = NORMAL_SCALE;
        this.state = 'normal';
        this.scaleTimer = 0;
        // Play sound
        shrinkSound(); // reuse same sound for expand
      }
    }
  }
  // Input methods
  startShrink() {
    if (this.shrinkCooldown <= 0) {
      this.state = 'shrinking';
      this.scaleTimer = 0;
      this.shrinkCooldown = COOLDOWN;
    }
  }
  startExpand() {
    if (this.state === 'shrinking' || this.state === 'normal') {
      this.state = 'expanding';
      this.scaleTimer = 0;
    }
  }
  // Apply coyote time when landing
  onGround() {
    this.coyoteTime = 0.1;
    this.jumpBuffer = 0;
  }
  setJumpBuffer() {
    this.jumpBuffer = 0.15;
  }
  // Rendering
  draw(ctx) {
    const size = this.sx * 32; // 32px base size
    ctx.fillStyle = this.sx === NORMAL_SCALE ? COLORS.playerNormal : COLORS.playerSmall;
    ctx.beginPath();
    ctx.arc(this.x + size/2, this.y + size/2, size/2, 0, Math.PI*2);
    ctx.fill();
    // glow when small
    if (this.sx === SMALL_SCALE) {
      const glow = ctx.createRadialGradient(this.x, this.y, size/2, this.x, this.y, size);
      glow.addColorStop(0, 'rgba(255,0,85,0.6)');
      glow.addColorStop(1, 'rgba(255,0,85,0)');
      ctx.fillStyle = glow;
      ctx.beginPath();
      ctx.arc(this.x, this.y, size, 0, Math.PI*2);
      ctx.fill();
    }
  }
}

// Simple Enemy
class Enemy {
  constructor(x, y, patrolRange) {
    this.x = x;
    this.y = y;
    this.vx = 100;
    this.patrolRange = patrolRange;
    this.sx = NORMAL_SCALE;
    this.sy = NORMAL_SCALE;
    this.direction = 1;
  }
  update(dt) {
    this.x += this.vx * dt;
    if (this.x > this.patrolRange[1]) this.direction = -1;
    if (this.x < this.patrolRange[0]) this.direction = 1;
    this.vx *= this.direction;
  }
  draw(ctx) {
    ctx.fillStyle = '#FF0055';
    ctx.fillRect(this.x, this.y, 32*this.sx, 32*this.sy);
  }
}

// Particle system (simple)
class Particle {
  constructor(x, y, vx, vy, size, life) {
    this.x = x;
    this.y = y;
    this.vx = vx;
    this.vy = vy;
    this.size = size;
    this.life = life;
    this.alpha = 1;
  }
  update(dt) {
    this.x += this.vx * dt;
    this.y += this.vy * dt;
    this.life -= dt;
    this.alpha = this.life / 1;
  }
  draw(ctx) {
    ctx.fillStyle = `rgba(255,255,255,${this.alpha})`;
    ctx.beginPath();
    ctx.arc(this.x, this.y, this.size, 0, Math.PI*2);
    ctx.fill();
  }
}
class ParticleSystem {
  constructor() {
    this.particles = [];
  }
  add(x, y, vx, vy, size, life) {
    this.particles.push(new Particle(x, y, vx, vy, size, life));
  }
  update(dt) {
    this.particles = this.particles.filter(p => p.life > 0);
    this.particles.forEach(p => p.update(dt));
  }
  draw(ctx) {
    this.particles.forEach(p => p.draw(ctx));
  }
}

// Level data (simple)
const levelData = {
  tiles: [
    // 0: empty, 1: solid, 2: gap, 3: platform, 4: hazard
  ],
  width: 20,
  height: 10,
  startX: 100,
  startY: 300
};

// Game state
const state = {
  playing: true,
  paused: false,
  level: null,
  player: null,
  enemies: [],
  particles: new ParticleSystem(),
  highScore: parseInt(localStorage.getItem('highScore')) || 0,
  startTime: 0,
  elapsedTime: 0,
  levelComplete: false
};

// Initialize game
async function init() {
  state.level = await loadLevel();
  state.player = new Player(state.level.startX, state.level.startY);
  // Setup input
  document.addEventListener('keydown', e => {
    if (!state.playing) return;
    if (e.key === 'Shift') state.player.startShrink();
    if (e.key === ' ') state.player.startExpand();
    if (e.code === 'Space') {
      // Jump buffer
      if (state.player.coyoteTime > 0 || state.player.jumpBuffer > 0) {
        state.player.vy = JUMP_FORCE;
        state.player.coyoteTime = 0;
        state.player.jumpBuffer = 0;
        landSound();
      }
    }
  });
  document.addEventListener('keyup', e => {
    if (e.key === 'Shift') {
      // If holding shift, lock until space
      if (state.player.state === 'shrinking') {
        // lock until space
        state.player.shrinkCooldown = 0; // will be handled by expand
      }
    }
  });
  // Touch for mobile (simple)
  let touchStart = null;
  canvas.addEventListener('touchstart', e => {
    if (!state.playing) return;
    const touch = e.touches[0];
    touchStart = { x: touch.clientX, y: touch.clientY };
  });
  canvas.addEventListener('touchend', e => {
    if (!state.playing || !touchStart) return;
    const touch = e.changedTouches[0];
    const dx = touch.clientX - touchStart.x;
    const dy = touch.clientY - touchStart.y;
    if (Math.abs(dx) > Math.abs(dy)) {
      // horizontal swipe
      if (dx > 0) state.player.startExpand();
      else state.player.startShrink();
    } else {
      // vertical tap
      if (state.player.coyoteTime > 0 || state.player.jumpBuffer > 0) {
        state.player.vy = JUMP_FORCE;
        state.player.coyoteTime = 0;
        state.player.jumpBuffer = 0;
        landSound();
      }
    }
    touchStart = null;
  });
  // Start loop
  requestAnimationFrame(gameLoop);
}

// Game loop
function gameLoop(timestamp) {
  const dt = (timestamp - (state.lastTime || timestamp)) / 1000; // seconds
  state.lastTime = timestamp;
  if (!state.playing) {
    // maybe handle pause/menu
    requestAnimationFrame(gameLoop);
    return;
  }
  // Update
  state.player.update(dt);
  // Simple gravity ground check (assume ground at y > canvas.height - 100)
  if (state.player.y > state.level.startY + 200) {
    // ground
    state.player.onGround();
  }
  // Input buffer for jump (space already handled in keydown)
  // Update timer
  state.elapsedTime = timestamp - state.startTime;
  uiTimer.textContent = `Time: ${Math.floor(state.elapsedTime / 1000)}s`;
  // Check win condition (reach exit at y ~ 100)
  if (state.player.y < 100) {
    state.levelComplete = true;
    uiRank.textContent = 'Rank: S';
    // Save high score
    const score = Math.floor(60000 - state.elapsedTime);
    if (score > state.highScore) {
      state.highScore = score;
      localStorage.setItem('highScore', state.highScore);
    }
    // Play victory sound (simple tone)
    const osc = audioCtx.createOscillator();
    const gain = audioCtx.createGain();
    osc.type = 'sine';
    osc.frequency.value = 1000;
    gain.gain.setValueAtTime(0.2, audioCtx.currentTime);
    osc.connect(gain).connect(audioCtx.destination);
    osc.start();
    osc.stop(audioCtx.currentTime + 0.5);
  }
  // Render
  // Clear background
  ctx.fillStyle = COLORS.background;
  ctx.fillRect(0, 0, canvas.width, canvas.height);
  // Draw level (simple)
  // For demo, draw platforms as rectangles
  // (In real game, parse tiles)
  // Draw player
  state.player.draw(ctx);
  // Draw enemies
  state.enemies.forEach(e => e.update(dt), state);
  state.enemies.forEach(e => e.draw(ctx));
  // Particles
  state.particles.update(dt);
  state.particles.draw(ctx);
  // UI
  // Health (3 icons)
  for (let i = 0; i < 3; i++) {
    const x = 20 + i * 20;
    ctx.strokeStyle = state.player.state === 'dead' ? '#ff0000' : '#fff';
    ctx.lineWidth = 2;
    ctx.strokeRect(x, 10, 16, 16);
  }
  // Data chips collected (placeholder)
  // Show rank
  // End of loop
  requestAnimationFrame(gameLoop);
}

// Start
init();
