inNode);\n        musicGainNode.connect(audioContext.destination);\n        \n        osc.start(now);\n        osc.stop(now + musicDuration);\n        \n        osc.onended = playMusicLoop;\n    }\n    \n    playMusicLoop();\n    updateNoteIcon();\}\n\nfunction stopMusic() {\n    musicPlaying = false;\n    if (musicGainNode) {\n        musicGainNode.disconnect();\n    }\n    updateNoteIcon();\n}\n\nfunction updateNoteIcon() {\n    const noteIcon = document.getElementById('noteIcon');\n    const musicStatus = document.getElementById('musicStatus');\n    \n    if (musicPlaying) {\n        noteIcon.className = 'note-icon active';\n        musicStatus.textContent = 'MUSIC: ON';\n    } else {\n        noteIcon.className = 'note-icon inactive';\n        musicStatus.textContent = 'MUSIC: OFF';\n    }\n}\n\n// Level Design\nfunction createLevel(levelNum) {\n    platforms = [];\n    enemies = [];\n    hazards = [];\n    soundEmitters = [];\n    silenceZones = [];\n    powerUps = [];\n    particles = [];\n    \n    const levelWidth = 2000;\n    const levelHeight = 600;\n    \n    // Ground\n    for (let i = 0; i < 20; i++) {\n        platforms.push({\n            x: i * 100, y: 550, width: 95, height: 20,\n            type: 'ground', color: '#4a00e5', pulse: 0\n        });\n    }\n    \n    // Platforms based on level\n    if (levelNum >= 1) {\n        platforms.push({x: 200, y: 450, width: 150, height: 20, type: 'platform', color: '#00ffff', pulse: 0});\n        platforms.push({x: 400, y: 350, width: 150, height: 20, type: 'platform', color: '#ff00ff', pulse: 0});\n    }\n    \n    if (levelNum >= 2) {\n        platforms.push({x: 600, y: 400, width: 100, height: 20, type: 'platform', color: '#00ff88', pulse: 0});\n        platforms.push({x: 750, y: 300, width: 100, height: 20, type: 'platform', color: '#ffaa00', pulse: 0});\n        platforms.push({x: 900, y: 200, width: 100, height: 20, type: 'platform', color: '#ff0000', pulse: 0});\n    }\n    \n    if (levelNum >= 3) {\n