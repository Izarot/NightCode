// src/systems/Input.js
export function initInput(player) {
  const onKeyDown = e => {
    if (e.key === 'Shift') player.startShrink();
    if (e.key === ' ') player.startExpand();
    if (e.code === 'Space') {
      if (player.coyoteTime > 0 || player.jumpBuffer > 0) {
        player.vy = JUMP_FORCE;
        player.coyoteTime = 0;
        player.jumpBuffer = 0;
        landSound();
      }
    }
  };
  const onKeyUp = e => {
    if (e.key === 'Shift') {
      if (player.state === 'shrinking') player.startExpand();
    }
  };
  const onTouchStart = e => {
    const touch = e.touches[0];
    input.touchStart = { x: touch.clientX, y: touch.clientY };
  };
  const onTouchEnd = e => {
    if (!input.touchStart) return;
    const touch = e.changedTouches[0];
    const dx = touch.clientX - input.touchStart.x;
    const dy = touch.clientY - input.touchStart.y;
    if (Math.abs(dx) > Math.abs(dy)) {
      if (dx > 0) player.startExpand();
      else player.startShrink();
    } else {
      if (player.coyoteTime > 0 || player.jumpBuffer > 0) {
        player.vy = JUMP_FORCE;
        player.coyoteTime = 0;
        player.jumpBuffer = 0;
        landSound();
      }
    }
    input.touchStart = null;
  };
  window.addEventListener('keydown', onKeyDown);
  window.addEventListener('keyup', onKeyUp);
  canvas.addEventListener('touchstart', onTouchStart);
  canvas.addEventListener('touchend', onTouchEnd);
}
