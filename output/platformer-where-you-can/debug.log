);\n    --text-muted: #888;\n}\n\n* {\n    margin: 0;\n    padding: 0;\n    box-sizing: border-box;\n}\n\nbody {\n    font-family: \'Segoe UI\', Tahoma, Geneva, Verdana, sans-serif;\n    background: var(--bg-dark);\n    color: var(--fg-light);\n    overflow: hidden;\n    height: 100vh;\n    display: flex;\n    flex-direction: column;\n}\n\n#gameCanvas {\n    width: 100%;\n    height: 100%;\n    display: block;\n    image-rendering: pixelated;\n}\n\n/* ========== HUD ========== */\n#hud {\n    position: absolute;\n    top: 12px;\n    left: 12px;\n    right: 12px;\n    z-index: 100;\n    pointer-events: none;\n}\n\n.hud-item {\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    gap: 2px;\n}\n\n.score {\n    font-size: 28px;\n    font-weight: bold;\n    color: var(--accent-coral);\n    text-shadow: 0 2px 4px rgba(0,0,0,0.5);\n}\n\ntimer {\n    font-size: 22px;\n    font-weight: bold;\n    color: var(--accent-teal);\n    text-shadow: 0 2px 4px rgba(0,0,0,0.5);\n}\n\n.lives {\n    font-size: 20px;\n    color: var(--accent-gold);\n}\n\n/* ========== Rewind Bar ========== */\n.rewind-bar {\n    height: 6px;\n    background: var(--accent-teal);\n    transition: width 0.3s linear;\n}\n\n.rewind-bar.filled {\n    background: var(--accent-gold);\n}\n\n.rewind-icon {\n    position: absolute;\n    top: 50%;\n    transform: translateY(-50%);\n    width: 18px;\n    height: 18px;\n    border-radius: 50%;\n    background: var(--accent-coral);\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    transition: transform 0.3s ease;\n}\n\n.rewind-icon.paused {\n    opacity: 0.5;\n}\n\n.fast-rewind-indicator {\n    position: absolute;\n    top: 50%;\n    transform: translateY(-50%);\n    font-size: 11px;\n    color: var(--accent-coral);\n    font-weight: bold;\n}\n\n/* ========== Responsive Canvas Wrapper ========== */\n#gameCanvas {\n    max-width: 100vw;\n    max-height: 90vh;\n}\n\n@media (max-width: 480px) {\n    #gameCanvas {\n        width: 95vw;\n        height: auto;\n        max-height: 70vh;\n    }\n}\n')]<|tool_call_end|>{
