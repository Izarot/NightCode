\"></canvas>\n    <div id=\"ui\">\n        <div class=\"hud\">\n            <div class=\"health\" id=\"health\">♥♥♥♥♥</div>\n            <div class=\"layer-indicator\"><div class=\"layer-icon\" id=\"layerIcon">🔵</div><div class=\"cooldown\" id=\"cooldown" style=\"display:none\"></div></div>\n            <div class=\"score\" id=\"score\">Score: 0</div>\n            <div class=\"timer\" id=\"timer\">Time: 00:00</div>\n        </div>\n    </div>\n    <div id=\"startScreen\">\n        <h1 style=\"font-size:60px; margin-bottom:30px; color:#4ecdc4;\">🎮 LayerShift</h1>\n        <p style=\"font-size:24px; margin-bottom:30px;\">Switch between layers to navigate!</p>\n        <button onclick=\"startGame()\">Start Game</button>\n        <button onclick=\"showInstructions()\">Instructions</button>\n    </div>\n    <div id=\"gameOver\" style=\"display:none\">\n        <h1 style=\"font-size:60px; margin-bottom:30px; color:#ff6b6b;\">Game Over</h1>\n        <p id=\"finalScore\" style=\"font-size:24px; margin-bottom:30px;\"></p>\n        <button onclick=\"restartGame()\">Restart</button>\n        <button onclick=\"mainMenu()\">Main Menu</button>\n    </div>\n    <div id=\"instructions\" style=\"position:absolute; top:0; left:0; right:0; bottom:0; background:rgba(0,0,0,0.9); display:none; flex-direction:column; justify-content:center; align-items:center; color:white; padding:40px; text-align:center;\">\n        <h2 style=\"font-size:40px; margin-bottom:20px; color:#4ecdc4;\">How to Play</h2>\n        <p style=\"font-size:20px; max-width:600px; margin-bottom:20px;\">Use <strong>SPACEBAR</strong> or <strong>CLICK</strong> to switch between foreground (🔴) and background (🔵) layers. Navigate platforms, avoid enemies, and reach the exit!</p>\n        <p style=\"font-size:20px; max-width:600px; margin-bottom:30px;\">Press <strong>R</strong> to restart, <strong>ESC</strong> to pause.</p>\n        <button onclick=\"hideInstructions()\">Back to Menu</button>\n    </div>\n    <script>\n        const canvas = document.getElementById('gameCanvas');\n        const ctx = canvas.getContext('2d');\n        let width, height, scale;\n        \n        function resizeCanvas() {\n            const maxWidth = window.innerWidth;\n            const maxHeight = window.innerHeight;\n            const aspect = 1920 / 1080;\n            \n            if (maxWidth / maxHeight > aspect) {\n                height = maxHeight;\n                width = height * aspect;\n            } else {\n                width = maxWidth;\n                height = width / aspect;\n            }\n            \n            scale = width / 1920;\n            canvas.width = width;\n            canvas.height = height;\n            canvas.style.width = width + 'px';\n            canvas.style.height = height + 'px';\n        }\n        \n        window.addEventListener('resize', resizeCanvas);\n        resizeCanvas();\n        \n        // Game State\n        let gameState = 'menu';\n        let currentLayer = 'background';\n        let lastSwitchTime = 0;\n        let switchCooldown = 300;\n        let gameStartTime = 0;\n        let elapsedTime = 0;\n        let score = 0;\n        let highScore = localStorage.getItem('layerShiftHighScore') || 0;\n        let player = { x: 100, y: 500, w: 32, h: 48, vx: 0, vy: 0, onGround: false, color: '#4ecdc4' };\n        let gravity = 0.6;\n        let jumpForce = -12;\n        let speed = 4.5;\n        let acceleration = 0.4;\n        let friction = 0.85;\n        let coyoteTime = 100; // ms\n        let lastGroundedTime = 0;\n        let jumpBufferTime = 150; // ms\n        let lastJumpAttempt = 0;\n        let keys = {};\n        let particles = [];\n        let enemies = [];\n        let platforms = [];\n        let exit = null;\n        \n        // Audio\n        let audioCtx;\n        function initAudio() {\n            if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();\n        }\n        \n        function playSound(frequency, duration, type) {\n            if (!audioCtx) initAudio();\n            const osc = audioCtx.createOscillator();\n            const gain = audioCtx.createGain();\n            osc.connect(gain);\n            osc.frequency.value = frequency;\n            osc.type = type || 'sine';\n            gain.connect(osc.destination);\n            gain.gain.setValueAtTime(0.3, audioCtx.currentTime);\n            gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + duration);\n            osc.start();\n            osc.stop(audioCtx.currentTime + duration);\n        }\n        \n        function layerSwitchSound() {\n            playSound(440, 0.1, 'square');\n            setTimeout(() => playSound(880, 0.1, 'square'), 50);\n        }\n        \n        function jumpSound() { playSound(330, 0.1, 'sine'); }\n        function landSound() { playSound(220, 0.15, 'sine'); }\n        function collectSound() { playSound(660, 0.1, 'square'); }\n        \n        // Particles\n        function createParticles(x, y, color, count = 12) {\n            for (let i = 0; i < count; i++) {\n                particles.push({\n                    x, y,\n                    vx: (Math.random() - 0.5) * 6,\n                    vy: (Math.random() - 0.5) * 6,\n                    life: 30,\n                    color\n                });\n            }\n        }\n        \n        // Level Data\n        function initLevel() {\n            platforms = [\n                { x: 0, y: 650, w: 1920, h: 30, layer: 'background' },\n                { x: 200, y: 550, w: 200, h: 20, layer: 'background' },\n                { x: 500, y: 450, w: 200, h: 20, layer: 'background' },\n                { x: 800, y: 400, w: 200, h: 20, layer: 'background' },\n                { x: 1100, y: 500, w: 200, h: 20, layer: 'background' },\n                { x: 1400, y: 400, w: 200, h: 20, layer: 'background' },\n                { x: 1700, y: 500, w: 200, h: 20, layer: 'background' },\n                { x: 0, y: 750, w: 1920, h: 30, layer: 'main' },\n                { x: 150, y: 650, w: 150, h: 20, layer: 'main' },\n                { x: 350, y: 580, w: 150, h: 20, layer: 'main' },\n                { x: 550, y: 520, w: 150, h: 20, layer: 'main' },\n                { x: 750, y: 480, w: 150, h: 20, layer: 'main' },\n                { x: 950, y: 550, w: 150, h: 20, layer: 'main' },\n                { x: 1150, y: 480, w: 150, h: 20, layer: 'main' },\n                { x: 1350, y: 550, w: 150, h: 20, layer: 'main' },\n                { x: 1550, y: 480, w: 150, h: 20, layer: 'main' },\n                { x: 100, y: 380, w: 100, h: 20, layer: 'foreground' },\n                { x: 300, y: 350, w: 100, h: 20, layer: 'foreground' },\n                { x: 500, y: 320, w: 100, h: 20, layer: 'foreground' },\n                { x: 700, y: 280, w: 100, h: 20, layer: 'foreground' },\n                { x: 900, y: 350, w: 100, h: 20, layer: 'foreground' },\n                { x: 1100, y: 280, w: 100, h: 20, layer: 'foreground' },\n                { x: 1300, y: 350, w: 100, h: 20, layer: 'foreground' },\n                { x: 1500, y: 280, w: 100, h: 20, layer: 'foreground' },\n                { x: 1700, y: 350, w: 100, h: 20, layer: 'foreground' },\n            ];\n            \n            enemies = [\n                { x: 400, y: 530, w: 32, h: 32, vx: 1.5, layer: 'main', type: 'patrol' },\n                { x: 1000, y: 450, w: 32, h: 32, vx: -1.5, layer: 'main', type: 'patrol' },\n                { x: 1400, y: 450, w: 32, h: 32, vx: 1.5, layer: 'main', type: 'patrol' },\n            ];\n            \n            exit = { x: 1850, y: 300, w: 50, h: 50, color: '#ff6b6b' };\n            \n            player.x = 100;\n            player.y = 600;\n            player.vx = 0;\n            player.vy = 0;\n            player.onGround = false;\n            score = 0;\n            elapsedTime = 0;\n            gameStartTime = 0;\n            particles = [];\n        }\n        \n        // Input\n        window.addEventListener('keydown', e => {\n            keys[e.code] = true;\n            if (e.code === 'Space') e.preventDefault();\n            if (e.code === 'KeyR' && gameState === 'playing') restartLevel();\n            if (e.code === 'Escape') togglePause();\n        });\n        \n        window.addEventListener('keyup', e => keys[e.code] = false);\n               \n        canvas.addEventListener('click', e => {\n            if (gameState === 'playing') switchLayer();\n        });\n        \n        function switchLayer() {\n            const now = Date.now();\n            if (now - lastSwitchTime < switchCooldown) return;\n            \n            currentLayer = currentLayer === 'background' ? 'foreground' : 'background';\n            lastSwitchTime = now;\n            layerSwitchSound();\n            createParticles(player.x, player.y, currentLayer === 'foreground' ? '#ff6b6b' : '#4ecdc4');\n            document.getElementById('layerIcon').textContent = currentLayer === 'foreground' ? '🔴' : '🔵';\n            document.getElementById('cooldown').style.display = 'block';\n            setTimeout(() => document.getElementById('cooldown').style.display = 'none', switchCooldown);\n        }\n        \n        function togglePause() {\n            if (gameState === 'paused') resumeGame();\n            else if (gameState === 'playing') pauseGame();\n        }\n        \n        function startGame() {\n            gameState = 'playing';\n            document.getElementById('startScreen').style.display = 'none';\n            document.getElementById('instructions').style.display = 'none';\n            initLevel();\n            gameStartTime = Date.now();\n            requestAnimationFrame(gameLoop);\n        }\n        \n        function pauseGame() {\n            gameState = 'paused';\n            const pauseOverlay = document.createElement('div');\n            pauseOverlay.style.cssText = 'position:absolute;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,0.7);display:flex;flex-direction:column;justify-content:center;align-items:center;color:white;font-size:24px;z-index:10;';\n            pauseOverlay.innerHTML = '<h2 style="margin-bottom:20px;">Paused</h2><button onclick="resumeGame()">Resume</button><button onclick="restartLevel()">Restart</button>';\n            document.body.appendChild(pauseOverlay);\n        }\n        \n        function resumeGame() {\n            gameState = 'playing';\n            document.querySelectorAll('div[style*=\"position:absolute\"]').forEach(el => {\n                if (el.style.zIndex === '10') el.remove();\n            });\n            gameStartTime = Date.now() - elapsedTime;\n            requestAnimationFrame(gameLoop);\n        }\n        \n        function restartLevel() {\n            gameState = 'playing';\n            initLevel();\n            gameStartTime = Date.now();\n            requestAnimationFrame(gameLoop);\n        }\n        \n        function restartGame() {\n            document.getElementById('gameOver').style.display = 'none';\n            startGame();\n        }\n        \n        function mainMenu() {\n            gameState = 'menu';\n            document.getElementById('startScreen').style.display = 'flex';\n            document.getElementById('gameOver').style.display = 'none';\n        }\n        \n        function showInstructions() {\n            document.getElementById('startScreen').style.display = 'none';\n            document.getElementById('instructions').style.display = 'flex';\n        }\n        \n        function hideInstructions() {\n            document.getElementById('instructions').style.display = 'none';\n            document.getElementById('startScreen').style.display = 'flex';\n        }\n        \n        // Game Loop\n        function gameLoop(timestamp) {\n            if (gameState !== 'playing') return;\n            \n            if (!gameStartTime) gameStartTime = timestamp;\n            elapsedTime = timestamp - gameStartTime;\n            \n            update();\n            render();\n            \n            requestAnimationFrame(gameLoop);\n        }\n        \n        function update() {\n            // Movement\n            if (keys['ArrowLeft'] || keys['KeyA']) player.vx -= acceleration;\n            if (keys['ArrowRight'] || keys['KeyD']) player.vx += acceleration;\n            player.vx *= friction;\n            player.vx = Math.max(-speed, Math.min(speed, player.vx));\n            \n            // Jumping\n            if (keys['Space'] || keys['ArrowUp'] || keys['KeyW']) {\n                if (lastJumpAttempt < Date.now() - jumpBufferTime) {\n                    if (player.onGround || (Date.now() - lastGroundedTime < coyoteTime)) {\n                        player.vy = jumpForce;\n                        jumpSound();\n                        lastGroundedTime = 0;\n                    }\n                    lastJumpAttempt = Date.now();\n                }\n            }\n            \n            // Gravity\n            player.vy += gravity;\n            player.vy = Math.min(18, player.vy);\n            \n            // Update positions\n            player.x += player.vx;\n            player.y += player.vy;\n            \n            // Collision\n            player.onGround = false;\n            platforms.forEach(p => {\n                if (p.layer === currentLayer) {\n                    if (player.x < p.x + p.w && player.x + player.w > p.x && \n                        player.y + player.h > p.y && player.y + player.h < p.y + p.h) {\n                        if (player.vy > 0) {\n                            player.y = p.y - player.h;\n                            player.vy = 0;\n                            player.onGround = true;\n                            lastGroundedTime = Date.now();\n                        }\n                    }\n                }\n            });\n            \n            // Enemy collision\n            enemies.forEach(e => {\n                if (e.layer === currentLayer) {\n                    if (player.x < e.x + e.w && player.x + player.w > e.x && \n                        player.y < e.y + e.h && player.y + player.h > e.y) {\n                        if (player.vy > 0 && player.y + player.h <= e.y + 10) {\n                            player.vy = jumpForce * 0.5;\n                            score += 100;\n                            collectSound();\n                        } else {\n                            endGame();\n                        }\n                    }\n                }\n            });\n            \n            // Enemy movement\n            enemies.forEach(e => {\n                if (e.layer === currentLayer) {\n                    e.x += e.vx;\n                    if (e.x < 50 || e.x > 1870) e.vx *= -1;\n                }\n            });\n            \n            // Exit\n            if (player.x < exit.x + exit.w && player.x + player.w > exit.x && \n                player.y < exit.y + exit.h && player.y + player.h > exit.y) {\n                completeLevel();\n            }\n            \n            // Update particles\n            particles = particles.filter(p => p.life > 0);\n            particles.forEach(p => {\n                p.x += p.vx;\n                p.y += p.vy;\n                p.vy += gravity * 0.3;\n                p.life--;\n            });\n            \n            // Update score\n            score = Math.floor(elapsedTime / 100) + Math.floor(player.x / 10);\n            if (score > highScore) {\n                highScore = score;\n                localStorage.setItem('layerShiftHighScore', highScore);\n            }\n        }\n        \n        function render() {\n            ctx.clearRect(0, 0, width, height);\n            ctx.scale(scale, scale);\n            \n            // Background layer\n            ctx.fillStyle = '#0a0a1a';\n            ctx.fillRect(0, 0, 1920, 1080);\n            \n            // Parallax background elements\n            ctx.fillStyle = 'rgba(110, 180, 255, 0.1)';\n            for (let i = 0; i < 5; i++) {\n                ctx.beginPath();\n                ctx.arc(100 + i * 300, 200, 50 + i * 20, 0, Math.PI * 2);\n                ctx.fill();\n            }\n            \n            // Platforms\n            platforms.forEach(p => {\n                if (p.layer === 'background') {\n                    ctx.fillStyle = 'rgba(100, 100, 255, 0.7)';\n                    ctx.fillRect(p.x, p.y, p.w, p.h);\n                } else if (p.layer === 'main') {\n                    ctx.fillStyle = 'rgba(255, 200, 100, 0.8)';\n                    ctx.fillRect(p.x, p.y, p.w, p.h);\n                } else if (p.layer === 'foreground') {\n                    ctx.fillStyle = 'rgba(255, 100, 100, 0.8)';\n                    ctx.fillRect(p.x, p.y, p.w, p.h);\n                }\n            });\n            \n            // Enemies\n            enemies.forEach(e => {\n                if (e.layer === currentLayer) {\n                    ctx.fillStyle = '#ff4757';\n                    ctx.fillRect(e.x, e.y, e.w, e.h);\n                    ctx.fillStyle = '#ff6b81';\n                    ctx.fillRect(e.x + 8, e.y + 8, e.w - 16, e.h - 16);\n                }\n            });\n            \n            // Exit\n            ctx.fillStyle = exit.color;\n            ctx.fillRect(exit.x, exit.y, exit.w, exit.h);\n            ctx.fillStyle = '#ff6b6b';\n            ctx.fillRect(exit.x + 10, exit.y + 10, exit.w - 20, exit.h - 20);\n            \n            // Player\n            ctx.fillStyle = player.color;\n            ctx.fillRect(player.x, player.y, player.w, player.h);\n            ctx.fillStyle = '#2ed573';\n            ctx.fillRect(player.x + 8, player.y + 8, player.w - 16, player.h - 16);\n            \n            // Layer indicators\n            if (currentLayer === 'foreground') {\n                ctx.strokeStyle = '#ff6b6b';\n                ctx.lineWidth = 3;\n                ctx.strokeRect(player.x, player.y, player.w, player.h);\n            }\n            \n            // Particles\n            particles.forEach(p => {\n                ctx.fillStyle = p.color;\n                ctx.globalAlpha = p.life / 30;\n                ctx.fillRect(p.x, p.y, 4, 4);\n                ctx.globalAlpha = 1;\n            });\n        }\n        \n        function endGame() {\n            gameState = 'gameover';\n            document.getElementById('gameOver').style.display = 'flex';\n            document.getElementById('finalScore').textContent = `Final Score: ${score} | High Score: ${highScore} | Time: ${(elapsedTime/1000).toFixed(1)}s`;\n        }\n        \n        function completeLevel() {\n            gameState = 'gameover';\n            document.getElementById('gameOver').style.display = 'flex';\n            document.getElementById('finalScore').innerHTML = `<h2 style="font-size:30px;margin-bottom:20px;color:#2ed573;">🎉 Level Complete!</h2><p>Final Score: ${score} | High Score: ${highScore} | Time: ${(elapsedTime/1000).toFixed(1)}s</p>`; \n        }\n        \n        // HUD Update\n        setInterval(() => {\n            if (gameState === 'playing') {\n                const minutes = Math.floor(elapsedTime / 60000);\n                const seconds = Math.floor((elapsedTime % 60000) / 1000);\n                document.getElementById('timer').textContent = `Time: ${minutes}:${seconds.toString().padStart(3, '0')}`;\n                document.getElementById('score').textContent = `Score: ${score}`; \n            }\n        }, 100);\n        \n        // Start\n        document.getElementById('gameOver').innerHTML = '<h2 style="font-size:40px;margin-bottom:20px;color:#ff6b6b;">Game Over</h2><p id="finalScore" style="font-size:20px;margin-bottom:30px;"></p><button onclick="restartGame()">Restart</button><button onclick="mainMenu()">Main Menu</button>';\n    </script>\n</body>\n</html>"}{"index.html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>LayerShift</title>\n    <link rel=\"icon\" href=\"data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ctext y='0.7em' font-size='80'%3E🎮%3C/text%3E%3C/svg%3E\">\n    <style>\n        * { margin: 0; padding: 0; box-sizing: border-box; }\n        body { background: #0a0a1a; overflow: hidden; font-family: 'Courier New', monospace; }\n        #gameCanvas { display: block; background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%); }\n        #ui { position: absolute; top: 0; left: 0; right: 0; bottom: 0; pointer-events: none; }\n        .hud { position: absolute; top: 10px; width: 100%; display: flex; justify-content: space-between; padding: 0 20px; box-sizing: border-box; }\n        .health, .score, .timer { background: rgba(0,0,0,0.5); padding: 10px 15px; border-radius: 8px; font-size: 18px; color: white; }\n        .layer-indicator { background: rgba(0,0,0,0.5); padding: 10px; border-radius: 8px; position: relative; }\n        .layer-icon { font-size: 24px; cursor: pointer; }\n        .cooldown { position: absolute; top: -5px; left: -5px; right: -5px; bottom: -5px; border-radius: 50%; border: 2px solid cyan; animation: pulse 0.3s infinite; }\n        @keyframes pulse { 0%, 100% { opacity: 0.5; } 50% { opacity: 1; } }\n        #startScreen, #gameOver { position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.8); display: flex; flex-direction: column; justify-content: center; align-items: center; color: white; font-size: 24px; }\n        button { padding: 15px 30px; margin: 10px; font-size: 20px; cursor: pointer; border: none; border-radius: 8px; background: linear-gradient(45deg, #ff6b6b, #ee5a5a); color: white; }\n        button:hover { transform: scale(1.05); }\n    </style>\n</head>\n<body>\n    <canvas id=\"gameCanvas\"></canvas>\n    <div id=\"ui\">\n        <div class=\"hud\">\n            <div class=\"health\" id=\"health\">♥♥♥♥♥</div>\n            <div class=\"layer-indicator\"><div class=\"layer-icon\" id=\"layerIcon\">🔵</div><div class=\"cooldown\" id=\"cooldown\" style=\"display:none\"></div></div>\n            <div class=\"score\" id=\"score\">Score: 0</div>\n            <div class=\"timer\" id=\"timer\">Time: 00:00</div>\n        </div>\n    </div>\n    <div id=\"startScreen\">\n        <h1 style=\"font-size:60px; margin-bottom:30px; color:#4ecdc4;\">🎮 LayerShift</h1>\n        <p style=\"font-size:24px; margin-bottom:30px;\">Switch between layers to navigate!</p>\n        <button onclick=\"startGame()\">Start Game</button>\n        <button onclick=\"showInstructions()\">Instructions</button>\n    </div>\n    <div id=\"gameOver\" style=\"display:none\">\n        <h1 style=\"font-size:60px; margin-bottom:30px; color:#ff6b6b;\">Game Over</h1>\n        <p id=\"finalScore\" style=\"font-size:24px; margin-bottom:30px;\"></p>\n        <button onclick=\"restartGame()\">Restart</button>\n        <button onclick=\"mainMenu()\">Main Menu</button>\n    </div>\n    <div id=\"instructions\" style=\"position:absolute; top:0; left:0; right:0; bottom:0; background:rgba(0,0,0,0.9); display:none; flex-direction:column; justify-content:center; align-items:center; color:white; padding:40px; text-align:center;\">\n        <h2 style=\"font-size:40px; margin-bottom:20px; color:#4ecdc4;\">How to Play</h2>\n        <p style=\"font-size:20px; max-width:600px; margin-bottom:20px;\">Use <strong>SPACEBAR</strong> or <strong>CLICK</strong> to switch between foreground (🔴) and background (🔵) layers. Navigate platforms, avoid enemies, and reach the exit!</p>\n        <p style=\"font-size:20px; max-width:600px; margin-bottom:30px;\">Press <strong>R</strong> to restart, <strong>ESC</strong> to pause.</p>\n        <button onclick=\"hideInstructions()\">Back to Menu</button>\n    </div>\n    <script>\n        const canvas = document.getElementById('gameCanvas');\n        const ctx = canvas.getContext('2d');\n        let width, height, scale;\n        \n        function resizeCanvas() {\n            const maxWidth = window.innerWidth;\n            const maxHeight = window.innerHeight;\n            const aspect = 1920 / 1080;\n            \n            if (maxWidth / maxHeight > aspect) {\n                height = maxHeight;\n                width = height * aspect;\n            } else {\n                width = maxWidth;\n                height = width / aspect;\n            }\n            \n            scale = width / 1920;\n            canvas.width = width;\n            canvas.height = height;\n            canvas.style.width = width + 'px';\n            canvas.style.height = height + 'px';\n        }\n        \n        window.addEventListener('resize', resizeCanvas);\n        resizeCanvas();\n        \n        // Game State\n        let gameState = 'menu';\n        let currentLayer = 'background';\n        let lastSwitchTime = 0;\n        let switchCooldown = 300;\n        let gameStartTime = 0;\n        let elapsedTime = 0;\n        let score = 0;\n        let highScore = localStorage.getItem('layerShiftHighScore') || 0;\n        let player = { x: 100, y: 500, w: 32, h: 48, vx: 0, vy: 0, onGround: false, color: '#4ecdc4' };\n        let gravity = 0.6;\n        let jumpForce = -12;\n        let speed = 4.5;\n        let acceleration = 0.4;\n        let friction = 0.85;\n        let coyoteTime = 100; // ms\n        let lastGroundedTime = 0;\n        let jumpBufferTime = 150; // ms\n        let lastJumpAttempt = 0;\n        let keys = {};\n        let particles = [];\n        let enemies = [];\n        let platforms = [];\n        let exit = null;\n        \n        // Audio\n        let audioCtx;\n        function initAudio() {\n            if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();\n        }\n        \n        function playSound(frequency, duration, type) {\n            if (!audioCtx) initAudio();\n            const osc = audioCtx.createOscillator();\n            const gain = audioCtx.createGain();\n            osc.connect(gain);\n            osc.frequency.value = frequency;\n            osc.type = type || 'sine';\n            gain.connect(osc.destination);\n            gain.gain.setValueAtTime(0.3, audioCtx.currentTime);\n            gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + duration);\n            osc.start();\n            osc.stop(audioCtx.currentTime + duration);\n        }\n        \n        function layerSwitchSound() {\n            playSound(440, 0.1, 'square');\n            setTimeout(() => playSound(880, 0.1, 'square'), 50);\n        }\n        \n        function jumpSound() { playSound(330, 0.1, 'sine'); }\n        function landSound() { playSound(220, 0.15, 'sine'); }\n        function collectSound() { playSound(660, 0.1, 'square'); }\n        \n        // Particles\n        function createParticles(x, y, color, count = 12) {\n            for (let i = 0; i < count; i++) {\n                particles.push({\n                    x, y,\n                    vx: (Math.random() - 0.5) * 6,\n                    vy: (Math.random() - 0.5) * 6,\n                    life: 30,\n                    color\n                });\n            }\n        }\n        \n        // Level Data\n        function initLevel() {\n            platforms = [\n                { x: 0, y: 650, w: 1920, h: 30, layer: 'background' },\n                { x: 200, y: 550, w: 200, h: 20, layer: 'background' },\n                { x: 500, y: 450, w: 200, h: 20, layer: 'background' },\n                { x: 800, y: 400, w: 200, h: 20, layer: 'background' },\n                { x: 1100, y: 500, w: 200, h: 20, layer: 'background' },\n                { x: 1400, y: 400, w: 200, h: 20, layer: 'background' },\n                { x: 1700, y: 500, w: 200, h: 20, layer: 'background' },\n                { x: 0, y: 750, w: 1920, h: 30, layer: 'main' },\n                { x: 150, y: 650, w: 150, h: 20, layer: 'main' },\n                { x: 350, y: 580, w: 150, h: 20, layer: 'main' },\n                { x: 550, y: 520, w: 150, h: 20, layer: 'main' },\n                { x: 750, y: 480, w: 150, h: 20, layer: 'main' },\n                { x: 950, y: 550, w: 150, h: 20, layer: 'main' },\n                { x: 1150, y: 480, w: 150, h: 20, layer: 'main' },\n                { x: 1350, y: 550, w: 150, h: 20, layer: 'main' },\n                { x: 1550, y: 480, w: 150, h: 20, layer: 'main' },\n                { x: 100, y: 380, w: 100, h: 20, layer: 'foreground' },\n                { x: 300, y: 350, w: 100, h: 20, layer: 'foreground' },\n                { x: 500, y: 320, w: 100, h: 20, layer: 'foreground' },\n                { x: 700, y: 280, w: 100, h: 20, layer: 'foreground' },\n                { x: 900, y: 350, w: 100, h: 20, layer: 'foreground' },\n                { x: 1100, y: 280, w: 100, h: 20, layer: 'foreground' },\n                { x: 1300, y: 350, w: 100, h: 20, layer: 'foreground' },\n                { x: 1500, y: 280, w: 100, h: 20, layer: 'foreground' },\n                { x: 1700, y: 350, w: 100, h: 20, layer: 'foreground' },\n            ];\n            \n            enemies = [\n                { x: 400, y: 530, w: 32, h: 32, vx: 1.5, layer: 'main', type: 'patrol' },\n                { x: 1000, y: 450, w: 32, h: 32, vx: -1.5, layer: 'main', type: 'patrol' },\n                { x: 1400, y: 450, w: 32, h: 32, vx: 1.5, layer: 'main', type: 'patrol' },\n            ];\n            \n            exit = { x: 1850, y: 300, w: 50, h: 50, color: '#ff6b6b' };\n            \n            player.x = 100;\n            player.y = 600;\n            player.vx = 0;\n            player.vy = 0;\n            player.onGround = false;\n            score = 0;\n            elapsedTime = 0;\n            gameStartTime = 0;\n            particles = [];\n        }\n        \n        // Input\n        window.addEventListener('keydown', e => {\n            keys[e.code] = true;\n            if (e.code === 'Space') e.preventDefault();\n            if (e.code === 'KeyR' && gameState === 'playing') restartLevel();\n            if (e.code === 'Escape') togglePause();\n        });\n        \n        window.addEventListener('keyup', e => keys[e.code] = false);\n                \n        canvas.addEventListener('click', e => {\n            if (gameState === 'playing') switchLayer();\n        });\n        \n        function switchLayer() {\n            const now = Date.now();\n            if (now - lastSwitchTime < switchCooldown) return;\n            \n            currentLayer = currentLayer === 'background' ? 'foreground' : 'background';\n            lastSwitchTime = now;\n            layerSwitchSound();\n            createParticles(player.x, player.y, currentLayer === 'foreground' ? '#ff6b6b' : '#4ecdc4');\n            document.getElementById('layerIcon').textContent = currentLayer === 'foreground' ? '🔴' : '🔵';\n            document.getElementById('cooldown').style.display = 'block';\n            setTimeout(() => document.getElementById('cooldown').style.display = 'none', switchCooldown);\n        }\n        \n        function togglePause() {\n            if (gameState === 'paused') resumeGame();\n            else if (gameState === 'playing') pauseGame();\n        }\n        \n        function startGame() {\n            gameState = 'playing';\n            document.getElementById('startScreen').style.display = 'none';\n            document.getElementById('instructions').style.display = 'none';\n            initLevel();\n            gameStartTime = Date.now();\n            requestAnimationFrame(gameLoop);\n        }\n        \n        function pauseGame() {\n            gameState = 'paused';\n            const pauseOverlay = document.createElement('div');\n            pauseOverlay.style.cssText = 'position:absolute;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,0.7);display:flex;flex-direction:column;justify-content:center;align-items:center;color:white;font-size:24px;z-index:10;';\n            pauseOverlay.innerHTML = '<h2 style=\"margin-bottom:20px;\">Paused</h2><button onclick=\"resumeGame()\">Resume</button><button onclick=\"restartLevel()\">Restart</button>';\n            document.body.appendChild(pauseOverlay);\n        }\n        \n        function resumeGame() {\n            gameState = 'playing';\n            document.querySelectorAll('div[style*=\"position:absolute\"]').forEach(el => {\n                if (el.style.zIndex === '10') el.remove();\n            });\n            gameStartTime = Date.now() - elapsedTime;\n            requestAnimationFrame(gameLoop);\n        }\n        \n        function restartLevel() {\n            gameState = 'playing';\n            initLevel();\n            gameStartTime = Date.now();\n            requestAnimationFrame(gameLoop);\n        }\n        \n        function restartGame() {\n            document.getElementById('gameOver').style.display = 'none';\n            startGame();\n        }\n        \n        function mainMenu() {\n            gameState = 'menu';\n            document.getElementById('startScreen').style.display = 'flex';\n            document.getElementById('gameOver').style.display = 'none';\n        }\n        \n        function showInstructions() {\n            document.getElementById('startScreen').style.display = 'none';\n            document.getElementById('instructions').style.display = 'flex';\n        }\n        \n        function hideInstructions() {\n            document.getElementById('instructions').style.display = 'none';\n            document.getElementById('startScreen').style.display = 'flex';\n        }\n        \n        // Game Loop\n        function gameLoop(timestamp) {\n            if (gameState !== 'playing') return;\n            \n            if (!gameStartTime) gameStartTime = timestamp;\n            elapsedTime = timestamp - gameStartTime;\n            \n            update();\n            render();\n            \n            requestAnimationFrame(gameLoop);\n        }\n        \n        function update() {\n            // Movement\n            if (keys['ArrowLeft'] || keys['KeyA']) player.vx -= acceleration;\n            if (keys['ArrowRight'] || keys['KeyD']) player.vx += acceleration;\n            player.vx *= friction;\n            player.vx = Math.max(-speed, Math.min(speed, player.vx));\n            \n            // Jumping\n            if (keys['Space'] || keys['ArrowUp'] || keys['KeyW']) {\n                if (lastJumpAttempt < Date.now() - jumpBufferTime) {\n                    if (player.onGround || (Date.now() - lastGroundedTime < coyoteTime)) {\n                        player.vy = jumpForce;\n                        jumpSound();\n                        lastGroundedTime = 0;\n                    }\n                    lastJumpAttempt = Date.now();\n                }\n            }\n            \n            // Gravity\n            player.vy += gravity;\n            player.vy = Math.min(18, player.vy);\n            \n            // Update positions\n            player.x += player.vx;\n            player.y += player.vy;\n            \n            // Collision\n            player.onGround = false;\n            platforms.forEach(p => {\n                if (p.layer === currentLayer) {\n                    if (player.x < p.x + p.w && player.x + player.w > p.x && \n                        player.y + player.h > p.y && player.y + player.h < p.y + p.h) {\n                        if (player.vy > 0) {\n                            player.y = p.y - player.h;\n                            player.vy = 0;\n                            player.onGround = true;\n                            lastGroundedTime = Date.now();\n                        }\n                    }\n                }\n            });\n            \n            // Enemy collision\n            enemies.forEach(e => {\n                if (e.layer === currentLayer) {\n                    if (player.x < e.x + e.w && player.x + player.w > e.x && \n                        player.y < e.y + e.h && player.y + player.h > e.y) {\n                        if (player.vy > 0 && player.y + player.h <= e.y + 10) {\n                            player.vy = jumpForce * 0.5;\n                            score += 100;\n                            collectSound();\n                        } else {\n                            endGame();\n                        }\n                    }\n                }\n            });\n            \n            // Enemy movement\n            enemies.forEach(e => {\n                if (e.layer === currentLayer) {\n                    e.x += e.vx;\n                    if (e.x < 50 || e.x > 1870) e.vx *= -1;\n                }\n            });\n            \n            // Exit\n            if (player.x < exit.x + exit.w && player.x + player.w > exit.x && \n                player.y < exit.y + exit.h && player.y + player.h > exit.y) {\n                completeLevel();\n            }\n            \n            // Update particles\n            particles = particles.filter(p => p.life > 0);\n            particles.forEach(p => {\n                p.x += p.vx;\n                p.y += p.vy;\n                p.vy += gravity * 0.3;\n                p.life--;\n            });\n            \n            // Update score\n            score = Math.floor(elapsedTime / 100) + Math.floor(player.x / 10);\n            if (score > highScore) {\n                highScore = score;\n                localStorage.setItem('layerShiftHighScore', highScore);\n            }\n        }\n        \n        function render() {\n            ctx.clearRect(0, 0, width, height);\n            ctx.scale(scale, scale);\n            \n            // Background layer\n            ctx.fillStyle = '#0a0a1a';\n            ctx.fillRect(0, 0, 1920, 1080);\n            \n            // Parallax background elements\n            ctx.fillStyle = 'rgba(110, 180, 255, 0.1)';\n            for (let i = 0; i < 5; i++) {\n                ctx.beginPath();\n                ctx.arc(100 + i * 300, 200, 50 + i * 20, 0, Math.PI * 2);\n                ctx.fill();\n            }\n            \n            // Platforms\n            platforms.forEach(p => {\n                if (p.layer === 'background') {\n                    ctx.fillStyle = 'rgba(100, 100, 255, 0.7)';\n                    ctx.fillRect(p.x, p.y, p.w, p.h);\n                } else if (p.layer === 'main') {\n                    ctx.fillStyle = 'rgba(255, 200, 100, 0.8)';\n                    ctx.fillRect(p.x, p.y, p.w, p.h);\n                } else if (p.layer === 'foreground') {\n                    ctx.fillStyle = 'rgba(255, 100, 100, 0.8)';\n                    ctx.fillRect(p.x, p.y, p.w, p.h);\n                }\n            });\n            \n            // Enemies\n            enemies.forEach(e => {\n                if (e.layer === currentLayer) {\n                    ctx.fillStyle = '#ff4757';\n                    ctx.fillRect(e.x, e.y, e.w, e.h);\n                    ctx.fillStyle = '#ff6b81';\n                    ctx.fillRect(e.x + 8, e.y + 8, e.w - 16, e.h - 16);\n                }\n            });\n            \n            // Exit\n            ctx.fillStyle = exit.color;\n            ctx.fillRect(exit.x, exit.y, exit.w, exit.h);\n            ctx.fillStyle = '#ff6b6b';\n            ctx.fillRect(exit.x + 10, exit.y + 10, exit.w - 20, exit.h - 20);\n            \n            // Player\n            ctx.fillStyle = player.color;\n            ctx.fillRect(player.x, player.y, player.w, player.h);\n            ctx.fillStyle = '#2ed573';\n            ctx.fillRect(player.x + 8, player.y + 8, player.w - 16, player.h - 16);\n            \n            // Layer indicators\n            if (currentLayer === 'foreground') {\n                ctx.strokeStyle = '#ff6b6b';\n                ctx.lineWidth = 3;\n                ctx.strokeRect(player.x, player.y, player.w, player.h);\n            }\n            \n            // Particles\n            particles.forEach(p => {\n                ctx.fillStyle = p.color;\n                ctx.globalAlpha = p.life / 30;\n                ctx.fillRect(p.x, p.y, 4, 4);\n                ctx.globalAlpha = 1;\n            });\n        }\n        \n        function endGame() {\n            gameState = 'gameover';\n            document.getElementById('gameOver').style.display = 'flex';\n            document.getElementById('finalScore').textContent = `Final Score: ${score} | High Score: ${highScore} | Time: ${(elapsedTime/1000).toFixed(1)}s`;\n        }\n        \n        function completeLevel() {\n            gameState = 'gameover';\n            document.getElementById('gameOver').style.display = 'flex';\n            document.getElementById('finalScore').innerHTML = `<h2 style=\"font-size:30px;margin-bottom:20px;color:#2ed573;\">🎉 Level Complete!</h2><p>Final Score: ${score} | High Score: ${highScore} | Time: ${(elapsedTime/1000).toFixed(1)}s</p>`;\n        }\n        \n        // HUD Update\n        setInterval(() => {\n            if (gameState === 'playing') {\n                const minutes = Math.floor(elapsedTime / 60000);\n                const seconds = Math.floor((elapsedTime % 60000) / 1000);\n                document.getElementById('timer').textContent = `Time: ${minutes}:${seconds.toString().padStart(3, '0')}`;\n                document.getElementById('score').textContent = `Score: ${score}`;\n            }\n        }, 100);\n    </script>\n</body>\n</html>"}