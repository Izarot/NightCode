laying) {\n        musicTimer += 1/60;\n        if (musicTimer >= musicDuration) {\n            stopMusic();\n        }\n    }\n    \n    // Player input\n    if (keys['ArrowLeft'] || keys['a']) {\n        player.vx = -moveSpeed;\n    } else if (keys['ArrowRight'] || keys['d']) {\n        player.vx = moveSpeed;\n    } else {\n        player.vx *= friction;\n        if (Math.abs(player.vx) < 0.1) player.vx = 0;\n    }\n    \n    // Jumping\n    if (jumpPressed && musicPlaying && player.onGround) {\n        player.vy = -Math.sqrt(2 * gravity * jumpHeight);\n        player.onGround = false;\n        playJumpSound();\n        jumpPressed = false;\n        player.jumpCooldown = 0;\n    }\n    \n    // Dash\n    if (keys[' '] && musicPlaying && player.onGround) {\n        if (!player.isDashing) {\n            player.isDashing = true;\n            player.dashTimer = 15;\n            player.vx = keys['ArrowLeft'] || keys['a'] ? -dashSpeed : (keys['ArrowRight'] || keys['d'] ? dashSpeed : 0);\n            playDashSound();\n        }\n    }\n    \n    // Double jump\n    if (keys[' '] && musicPlaying && !player.onGround && player.canDoubleJump && !player.doubleJumpUsed) {\n        player.vy = -Math.sqrt(2 * gravity * jumpHeight * 1.2);\n        player.doubleJumpUsed = true;\n        playJumpSound();\n    }\n    \n    // Apply gravity\n    if (!player.onGround) {\n        player.vy += gravity;\n    }\n    \n    // Update position\n    player.x += player.vx;\n    player.y += player.vy;\n    \n    // Update dash timer\n    if (player.isDashing) {\n        player.dashTimer--;\n        if (player.dashTimer <= 0) {\n            player.isDashing = false;\n            player.vx = 0;\n        }\n    }\n    \n    // Update jump cooldown\n    if (player.jumpCooldown > 0) player.jumpCooldown--;\n    \n    // Check silence zones\n    let inSilenceZone = false;\n    for (const zone of silenceZones) {\n        if (player.x + player.width > zone.x && player.x < zone.x + zone.width &&\n       