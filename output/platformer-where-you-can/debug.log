function completeLevel() {
    score += level * 100;
    level++;
    if (level > 8) {
        endGame('victory');
    } else {
        createLevel(level);
        player.x = 100;
        player.y = 300;
        player.vx = 0;
        player.vy = 0;
        document.getElementById('levelNum').textContent = level;
        stopMusic();
    }
}

function endGame(result) {
    gameState = 'gameOver';
    if (score > highScore) {
        highScore = score;
        localStorage.setItem('symphonicHighScore', highScore);
    }
    
    if (result === 'gameOver') {
        document.getElementById('finalScore').textContent = score;
        document.getElementById('gameOverHighScore').textContent = highScore;
        document.getElementById('gameOverScreen').classList.remove('hidden');
    } else {
        playVictorySound();
        document.getElementById('victoryScore').textContent = score;
        document.getElementById('victoryHighScore').textContent = highScore;
        document.getElementById('victoryScreen').classList.remove('hidden');
    }
}

function startGame() {
    gameState = 'playing';
    document.getElementById('startScreen').classList.add('hidden');
    speedrunStartTime = Date.now();
    createLevel(level);
}

function restartGame() {
    gameState = 'playing';
    level = 1;
    initGame();
    createLevel(1);
    document.getElementById('gameOverScreen').classList.add('hidden');
    document.getElementById('victoryScreen').classList.add('hidden');
    speedrunStartTime = Date.now();
}

// Drawing Functions
function draw() {
    // Clear canvas
    ctx.fillStyle = '#0a0a2a';
    ctx.fillRect(0, 0, canvas.width, canvas.height);
    
    if (gameState === 'playing') {
        // Draw platforms
        for (const platform of platforms) {
            if (platform.type === 'moving') {
                platform.offset += platform.moveSpeed * 0.02;
                platform.x = platform.x + Math.sin(platform.offset) * 2;
            }
            
            if (platform.type === 'ground') {
                platform.pulse = Math.sin(musicTimer * 2) * 0.5 + 0.5;
            }
            
            ctx.fillStyle = platform.color;
            ctx.globalAlpha = 0.8 + platform.pulse * 0.2;
            ctx.fillRect(platform.x * scale + offsetX, platform.y * scale + offsetY, 
                        platform.width * scale, platform.height * scale);
            ctx.globalAlpha = 1;
        }
        
        // Draw enemies
        for (const enemy of enemies) {
            if (enemy.type === 'patrol') {
                enemy.x += enemy.vx;
                if (enemy.x < 100 || enemy.x > 2300) enemy.vx *= -1;
            } else if (enemy.type === 'boss') {
                enemy.phase = (enemy.phase + 0.05) % (Math.PI * 2);
                enemy.x = 2800 + Math.cos(enemy.phase) * 50;
            }
            
            ctx.fillStyle = enemy.color;
            ctx.fillRect(enemy.x * scale + offsetX, enemy.y * scale + offsetY,
                        enemy.width * scale, enemy.height * scale);
        }
        
        // Draw hazards
        for (const hazard of hazards) {
            ctx.fillStyle = '#ff0000';
            ctx.fillRect(hazard.x * scale + offsetX, hazard.y * scale + offsetY,
                        hazard.width * scale, hazard.height * scale);
        }
        
        // Draw sound emitters
        for (const emitter of soundEmitters) {
            ctx.beginPath();
            ctx.arc(emitter.x * scale + offsetX, emitter.y * scale + offsetY, 
                   emitter.radius * scale, 0, Math.PI * 2);
            ctx.fillStyle = emitter.active ? '#00ff88' : '#4a00e5';
            ctx.globalAlpha = 0.5;
            ctx.fill();
            ctx.globalAlpha = 1;
        }
        
        // Draw silence zones
        for (const zone of silenceZones) {
            ctx.fillStyle = 'rgba(255, 0, 0, 0.3)';
            ctx.fillRect(zone.x * scale + offsetX, zone.y * scale + offsetY,
                        zone.width * scale, zone.height * scale);
        }
        
        // Draw power-ups
        for (const pu of powerUps) {
            ctx.fillStyle = pu.color;
            ctx.fillRect(pu.x * scale + offsetX, pu.y * scale + offsetY,
                        pu.width * scale, pu.height * scale);
        }
        
        // Draw player
        ctx.fillStyle = player.color;
        ctx.fillRect(player.x * scale + offsetX, player.y * scale + offsetY,
                    player.width * scale, player.height * scale);
        
        // Draw particles
        for (const p of particles) {
            ctx.fillStyle = p.color;
            ctx.globalAlpha = p.life / 60;
            ctx.fillRect(p.x * scale + offsetX, p.y * scale + offsetY,
                        p.size * scale, p.size * scale);
            ctx.globalAlpha = 1;
        }
    }
}

// Input Handling
document.addEventListener('keydown', (e) => {
    keys[e.key] = true;
    if (e.key === ' ') {
        jumpPressed = true;
    }
});

document.addEventListener('keyup', (e) => {
    keys[e.key] = false;
});

// Start the game
initGame();
gameLoop();
"
}
