Raw: {
  "index.html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Resonance Clash</title>\n<link rel=\"icon\" href=\"data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ctext y='50%' font-size='80' text-anchor='middle' fill='%23ff6b6b'%3E🔊%3C/text%3E%3C/svg%3E\">\n<style>\n* { margin: 0; padding: 0; box-sizing: border-box; }\nhtml, body { width: 100%; height: 100%; overflow: hidden; background: linear-gradient(135deg, #0a0a2a, #1a0a3a); }\n#gameContainer { position: relative; width: 100%; height: 100%; }\n#gameCanvas, #uiCanvas { position: absolute; top: 0; left: 0; width: 100%; height: 100%; display: block; }\n#uiCanvas { pointer-events: none; }\n#speedrunTimer { position: absolute; top: 15px; right: 15px; font-family: 'Orbitron', monospace; font-size: 24px; color: #00ffaa; background: rgba(0,0,0,0.5); padding: 8px 16px; border-radius: 8px; border: 2px solid #00ffaa; }\n</style>\n</head>\n<body>\n<div id=\"gameContainer\">\n<canvas id=\"gameCanvas\"></canvas>\n<canvas id=\"uiCanvas\"></canvas>\n</div>\n<div id=\"speedrunTimer\">00:00.00</div>\n<script src=\"src/core/engine.js\"></script>\n<script src=\"src/core/input.js\"></script>\n<script src=\"src/core/physics.js\"></script>\n<script src=\"src/core/audio.js\"></script>\n<script src=\"src/core/renderer.js\"></script>\n<script src=\"src/gameplay/player.js\"></script>\n<script src=\"src/gameplay/abilities.js\"></script>\n<script src=\"src/gameplay/projectiles.js\"></script>\n<script src=\"src/gameplay/gameLogic.js\"></script>\n<script src=\"src/gameplay/hud.js\"></script>\n<script src=\"src/levels/arena.js\"></script>\n<script src=\"src/main.js\"></script>\n</body>\n</html>",
  "src/main.js": "class Game {\n  constructor() {\n    this.canvas = document.getElementById('gameCanvas');\n    this.uiCanvas = document.getElementById('uiCanvas');\n    this.ctx = this.canvas.getContext('2d');\n    this.uiCtx = this.uiCanvas.getContext('2d');\n    this.engine = new Engine(this.canvas, this.ctx);\n    this.input = new InputManager();\n    this.audio = new AudioManager();\n    this.physics = new PhysicsEngine();\n    this.renderer = new Renderer(this.ctx);\n    this.arena = new Arena();\n    this.players = [];\n    this.projectiles = [];\n    this.particles = [];\n    this.lastTime = 0;\n    this.running = false;\n    this.startTime = 0;\n    this.elapsedTime = 0;\n    this.highScore = this.loadHighScore();\n    this.init();\n  }\n\n  init() {\n    this.resizeCanvas();\n    window.addEventListener('resize', () => this.resizeCanvas());\n    this.createPlayers();\n    this.start();\n  }\n\n  resizeCanvas() {\n    const container = document.getElementById('gameContainer');\n    const width = container.clientWidth;\n    const height = container.clientHeight;\n    const scale = Math.min(width / 1024, height / 768);\n    this.canvas.width = 1024;\n    this.canvas.height = 768;\n    this.uiCanvas.width = 1024;\n    this.uiCanvas.height = 768;\n    this.engine.setScale(scale);\n    this.updateTimerDisplay();\n  }\n\n  createPlayers() {\n    const p1 = new Player(1, { x: 200, y: 200 }, this.input, this.audio);\n    const p2 = new Player(2, { x: 824, y: 568 }, null, this.audio);\n    this.players = [p1, p2];\n  }\n\n  start() {\n    this.running = true;\n    this.startTime = performance.now();\n    this.lastTime = performance.now();\n    this.gameLoop();\n  }\n\n  gameLoop = (timestamp = 0) => {\n    if (!this.running) return;\n    const delta = (timestamp - this.lastTime) / 1000;\n    this.lastTime = timestamp;\n    this.elapsedTime = timestamp - this.startTime;\n    this.update(delta);\n    this.render();\n    this.updateTimerDisplay();\n    requestAnimationFrame(this.gameLoop);\n  }\n\n  update(delta) {\n    this.input.update();\n    this.players.forEach(p => p.update(delta, this.input));\n    this.physics.update(delta, this.players, this.arena);\n    this.projectiles.forEach(p => p.update(delta));\n    this.checkCollisions();\n    this.updateParticles(delta);\n    this.checkWinCondition();\n  }\n\n  render() {\n    this.ctx.clearRect(0, 0, this.canvas.width, this.canvas.height);\n    this.arena.render(this.ctx);\n    this.projectiles.forEach(p => p.render(this.ctx));\n    this.particles.forEach(p => p.render(this.ctx));\n    this.players.forEach(p => p.render(this.ctx));\n    this.renderUI();\n  }\n\n  renderUI() {\n    this.uiCtx.clearRect(0, 0, this.uiCanvas.width, this.uiCanvas.height);\n    this.players.forEach(p => p.renderHUD(this.uiCtx));\n    this.renderTimer();\n  }\n\n  updateParticles(delta) {\n    for (let i = this.particles.length - 1; i >= 0; i--) {\n      this.particles[i].update(delta);\n      if (this.particles[i].life <= 0) this.particles.splice(i, 1);\n    }\n  }\n\n  checkCollisions() {\n    this.projectiles.forEach((proj, pi) => {\n      this.players.forEach((player, pi2) => {\n        if (proj.ownerId !== player.id && proj.checkCollision(player)) {\n          player.takeDamage(proj.damage);\n          proj.owner?.playSound('hit');\n          this.createImpactParticles(player.x, player.y, proj.frequency);\n          proj.markForRemoval();\n        }\n      });\n      if (proj.markedForRemoval) {\n        this.projectiles.splice(pi, 1);\n      }\n    });\n  }\n\n  createImpactParticles(x, y, frequency) {\n    const hue = Math.floor(frequency / 100);\n    for (let i = 0; i < 8; i++) {\n      this.particles.push(new Particle(x, y, hue));\n    }\n  }\n\n  checkWinCondition() {\n    const alive = this.players.filter(p => p.health > 0);\n    if (alive.length === 1) {\n      this.endGame(alive[0].id);\n    } else if (this.elapsedTime > 90000) {\n      const winner = this.players.reduce((a, b) => a.health > b.health ? a : b);\n      this.endGame(winner.id);\n    }\n  }\n\n  endGame(winnerId) {\n    this.running = false;\n    const timeSec = this.elapsedTime / 1000;\n    if (timeSec < this.highScore) {\n      this.highScore = timeSec;\n      this.saveHighScore(this.highScore);\n    }\n    alert(winnerId === 1 ? 'Player 1 Wins!' : 'Player 2 Wins!');\n  }\n\n  updateTimerDisplay() {\n    const timerEl = document.getElementById('speedrunTimer');\n    const time = this.elapsedTime / 1000;\n    const mins = Math.floor(time / 60);\n    const secs = Math.floor(time % 60);\n    const ms = Math.floor((time % 1) * 100);\n    timerEl.textContent = `${mins.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}.${ms.toString().padStart(2, '0')}`;\n  }\n\n  renderTimer() {\n    const time = this.elapsedTime / 1000;\n    const mins = Math.floor(time / 60);\n    const secs = Math.floor(time % 60);\n    const ms = Math.floor((time % 1) * 100);\n    const text = `${mins.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}.${ms.toString().padStart(2, '0')}`;\n    this.uiCtx.font = '24px Orbitron, monospace';\n    this.uiCtx.fillStyle = '#00ffaa';\n    this.uiCtx.textAlign = 'right';\n    this.uiCtx.fillText(text, this.uiCanvas.width - 15, 25);\n  }\n\n  loadHighScore() {\n    const saved = localStorage.getItem('resonanceClashHighScore');\n    return saved ? parseFloat(saved) : Infinity;\n  }\n\n  saveHighScore(score) {\n    localStorage.setItem('resonanceClashHighScore', score.toString());\n  }\n}\n\nconst game = new Game();",
  "src/core/engine.js": "class Engine {\n  constructor(canvas, ctx) {\n    this.canvas = canvas;\n    this.ctx = ctx;\n    this.scale = 1;\n    this.backgroundColor = '#0a0a2a';\n    this.palette = {\n      primary: '#00ffff',\n      secondary: '#ff00ff',\n      accent: '#00ff00',\n      danger: '#ff4444',\n      warning: '#ffaa00',\n      info: '#00aaff'\n    };\n  }\n\n  setScale(scale) {\n    this.scale = scale;\n  }\n\n  clear() {\n    this.ctx.save();\n    this.ctx.scale(this.scale, this.scale);\n    this.ctx.clearRect(0, 0, this.canvas.width / this.scale, this.canvas.height / this.scale);\n    this.ctx.restore();\n  }\n\n  applyGlow(color) {\n    this.ctx.shadowColor = color;\n    this.ctx.shadowBlur = 20 * this.scale;\n  }\n\n  resetGlow() {\n    this.ctx.shadowColor = 'transparent';\n    this.ctx.shadowBlur = 0;\n  }\n}",
  "src/core/input.js": "class InputManager {\n  constructor() {\n    this.keys = {};\n    this.mouse = { x: 0, y: 0, left: false, right: false };\n    this.touchStart = { x: 0, y: 0 };\n    this.init();\n  }\n\n  init() {\n    window.addEventListener('keydown', e => { this.keys[e.key.toLowerCase()] = true; });\n    window.addEventListener('keyup', e => { this.keys[e.key.toLowerCase()] = false; });\n    window.addEventListener('mousemove', e => {\n      const rect = e.target.getBoundingClientRect();\n      this.mouse.x = e.clientX - rect.left;\n      this.mouse.y = e.clientY - rect.top;\n    });\n    window.addEventListener('mousedown', e => {\n      if (e.button === 0) this.mouse.left = true;\n      if (e.button === 2) this.mouse.right = true;\n    });\n    window.addEventListener('mouseup', e => {\n      if (e.button === 0) this.mouse.left = false;\n      if (e.button === 2) this.mouse.right = false;\n    });\n    window.addEventListener('touchstart', e => {\n      if (e.touches.length === 1) {\n        this.touchStart.x = e.touches[0].clientX;\n        this.touchStart.y = e.touches[0].clientY;\n      }\n    });\n  }\n\n  update() {\n    // Touch fallback for mobile\n  }\n\n  isPressed(key) {\n    return this.keys[key] || false;\n  }\n\n  isKeyDown(key) {\n    return this.keys[key] || false;\n  }\n}",
  "src/core/physics.js": "class PhysicsEngine {\n  constructor() {\n    this.gravity = 0;\n  }\n\n  update(delta, players, arena) {\n    players.forEach(player => {\n      if (player.airDashCooldown > 0) player.airDashCooldown -= delta;\n      if (player.burstCooldown > 0) player.burstCooldown -= delta;\n      if (player.echoShieldCooldown > 0) player.echoShieldCooldown -= delta;\n      if (player.echoLeapCooldown > 0) player.echoLeapCooldown -= delta;\n      if (player.sprintTimer > 0) player.sprintTimer -= delta;\n      if (player.pulseStepCooldown > 0) player.pulseStepCooldown -= delta;\n    });\n  }\n\n  checkAABBCollision(a, b) {\n    return a.x < b.x + b.width && a.x + a.width > b.x && a.y < b.y + b.height && a.y + a.height > b.y;\n  }\n}\n\nclass Vector2 {\n  constructor(x = 0, y = 0) {\n    this.x = x;\n    this.y = y;\n  }\n\n  add(v) { return new Vector2(this.x + v.x, this.y + v.y); }\n  sub(v) { return new Vector2(this.x - v.x, this.y - v.y); }\n  mul(s) { return new Vector2(this.x * s, this.y * s); }\n  length() { return Math.sqrt(this.x * this.x + this.y * this.y); }\n  normalize() { const len = this.length(); return len > 0 ? new Vector2(this.x / len, this.y / len) : new Vector2(); }\n}",
  "src/core/audio.js": "class AudioManager {\n  constructor() {\n    this.audioContext = new (window.AudioContext || window.webkitAudioContext)();\n    this.masterGain = this.audioContext.createGain();\n    this.masterGain.gain.value = 0.5;\n    this.masterGain.connect(this.audioContext.destination);\n    this.activeSounds = new Set();\n  }\n\n  playTone(frequency, duration = 0.2, type = 'sine') {\n    const oscillator = this.audioContext.createOscillator();\n    const gain = this.audioContext.createGain();\n    oscillator.type = type;\n    oscillator.frequency.value = frequency;\n    oscillator.connect(gain);\n    gain.connect(this.masterGain);\n    gain.gain.setValueAtTime(0.3, this.audioContext.currentTime);\n    gain.gain.exponentialRampToValueAtTime(0.001, this.audioContext.currentTime + duration);\n    oscillator.start();\n    oscillator.stop(this.audioContext.currentTime + duration);\n  }\n\n  playPulse() { this.playTone(220, 0.15, 'sawtooth'); }\n  playBeam() { this.playTone(440, 0.25, 'square'); }\n  playHit() { this.playTone(110, 0.1, 'triangle'); }\n  playBurst() { this.playTone(110, 0.4, 'sine'); }\n  playShield() { this.playTone(330, 0.3, 'sawtooth'); }\n  playEchoLeap() { this.playTone(550, 0.2, 'square'); }\n}\n\nclass SoundEffect {\n  constructor(audioManager, frequency, duration = 0.2) {\n    this.audioManager = audioManager;\n    this.frequency = frequency;\n    this.duration = duration;\n  }\n\n  play() {\n    this.audioManager.playTone(this.frequency, this.duration);\n  }\n}",
  "src/core/renderer.js": "class Renderer {\n  constructor(ctx) {\n    this.ctx = ctx;\n    this.palette = {\n      primary: '#00ffff',\n      secondary: '#ff00ff',\n      accent: '#00ff00',\n      danger: '#ff4444',\n      warning: '#ffaa00',\n      info: '#00aaff',\n      player1: '#00ffaa',\n      player2: '#ff5500'\n    };\n  }\n\n  drawCircle(x, y, radius, color, fill = true) {\n    this.ctx.save();\n    this.ctx.fillStyle = fill ? color : 'transparent';\n    this.ctx.strokeStyle = color;\n    this.ctx.lineWidth = 2;\n    this.ctx.beginPath();\n    this.ctx.arc(x, y, radius, 0, Math.PI * 2);\n    if (fill) this.ctx.fill();\n    this.ctx.stroke();\n    this.ctx.restore();\n  }\n\n  drawRect(x, y, w, h, color, fill = true) {\n    this.ctx.save();\n    this.ctx.fillStyle = fill ? color : 'transparent';\n    this.ctx.strokeStyle = color;\n    this.ctx.lineWidth = 2;\n    this.ctx.fillRect(x, y, w, h);\n    this.ctx.strokeRect(x, y, w, h);\n    this.ctx.restore();\n  }\n\n  drawGradientCircle(x, y, radius, colors) {\n    const gradient = this.ctx.createRadialGradient(x, y, 0, x, y, radius);\n    colors.forEach((c, i) => gradient.addColorStop(i / (colors.length - 1), c));\n    this.ctx.fillStyle = gradient;\n    this.ctx.beginPath();\n    this.ctx.arc(x, y, radius, 0, Math.PI * 2);\n    this.ctx.fill();\n  }\n}",
  "src/gameplay/player.js": "class Player {\n  constructor(id, startPos, input, audio) {\n    this.id = id;\n    this.x = startPos.x;\n    this.y = startPos.y;\n    this.width = 32;\n    this.height = 32;\n    this.health = 100;\n    this.maxHealth = 100;\n    this.speed = 400;\n    this.sprintSpeed = 550;\n  \n  this.velocity = { x: 0, y: 0 };\n    this.acceleration = 0.1;\n    this.friction = 0.8;\n    this.facing = { x: 1, y: 0 };\n    this.input = input;\n    this.audio = audio;\n    \n    this.airDashCooldown = 0;\n    this.burstCooldown = 8;\n    this.echoShieldCooldown = 5;\n    this.echoLeapCooldown = 6;\n    this.sprintTimer = 0;\n    this.pulseStepCooldown = 0;\n    \n    this.activeShield = null;\n    this.abilities = {\n      burst: { ready: true, cooldown: 8 },\n      shield: { ready: true, cooldown: 5 },\n      echoLeap: { ready: true, cooldown: 6 }\n    };\n    \n    this.pulseLines = [];\n    this.lastPulseTime = 0;\n    \n    this.energy = 100;\n    this.energyRegenRate = 10;\n    this.energyRegenCooldown = 0;\n    \n    this.color = id === 1 ? '#00ffaa' : '#ff5500';\n    this.frequency = id === 1 ? 220 : 440;\n  }\n\n  update(delta, input) {\n    if (!this.input) return; // AI or inactive\n    \n    this.handleMovement(delta, input);\n    this.handleAbilities(delta, input);\n    this.regenEnergy(delta);\n    this.updatePulseLines(delta);\n  }\n\n  handleMovement(delta, input) {\n    let moveX = 0, moveY = 0;\n    \n    if (input.isKeyDown('w')) moveY -= 1;\n    if (input.isKeyDown('s')) moveY += 1;\n    if (input.isKeyDown('a')) moveX -= 1;\n    if (input.isKeyDown('d')) moveX += 1;\n    \n    if (moveX !== 0 || moveY !== 0) {\n      this.facing.x = moveX;\n      this.facing.y = moveY;\n    }\n    \n    const speed = input.isKeyDown('shift') && this.sprintTimer > 0 ? this.sprintSpeed : this.speed;\n    const targetVel = { x: moveX * speed, y: moveY * speed };\n    \n    this.velocity.x = this.lerp(this.velocity.x, targetVel.x, this.acceleration);\n    this.velocity.y = this.lerp(this.velocity.y, targetVel.y, this.acceleration);\n    \n    if (input.isKeyDown('shift') && this.sprintTimer <= 0) {\n      this.sprintTimer = 2;\n    }\n    \n    if (input.isKeyDown('space') && this.airDashCooldown <= 0) {\n      this.velocity.y -= 300;\n      this.airDashCooldown = 1.5;\n      this.playSound('airDash');\n    }\n    \n    if (input.isKeyDown('e') && this.pulseStepCooldown <= 0) {\n      this.velocity.x += this.facing.x * 150;\n      this.velocity.y += this.facing.y * 150;\n      this.pulseStepCooldown = 0.8;\n      this.createPulseTrail();\n      this.playSound('pulse');\n    }\n    \n    this.x += this.velocity.x * delta;\n    this.y += this.velocity.y * delta;\n    \n    this.velocity.x *= this.friction;\n    this.velocity.y *= this.friction;\n  }\n\n  lerp(a, b, t) { return a + (b - a) * t; }\n\n  handleAbilities(delta, input) {\n    if (input.isMouseButtonDown(0)) {\n      if (input.isKeyDown('shift')) {\n        this.fireChargedBeam(input);\n      } else {\n        this.firePulse(input);\n      }\n    }\n    \n    if (input.isMouseButtonDown(2)) {\n      this.activateShield();\n    }\n    \n    if (input.isKeyDown('q') && this.abilities.burst.ready && this.health < this.maxHealth * 0.3) {\n      this.activateBurst();\n    }\n    \n    if (input.isKeyDown('f')) {\n      this.echoLeap();\n    }\n  }\n\n  firePulse(input) {\n    if (this.energy < 20) return;\n    this.energy -= 20;\n    this.energyRegenCooldown = 1;\n    this.playSound('pulse');\n    const proj = new SoundProjectile(\n      this.x, this.y,\n      this.facing.x * 600, this.facing.y * 600,\n      80, 15, this.frequency, this.id\n    );\n    game.projectiles.push(proj);\n  }\n\n  fireChargedBeam(input) {\n    if (this.energy < 45) return;\n    this.energy -= 45;\n    this.playSound('beam');\n    const angle = Math.atan2(this.facing.y, this.facing.x);\n    const length = 300;\n    const proj = new SoundProjectile(\n      this.x, this.y,\n      Math.cos(angle) * 600, Math.sin(angle) * 600,\n      length, 45, this.frequency + 200, this.id, true\n    );\n    game.projectiles.push(proj);\n  }\n\n  activateShield() {\n    if (!this.abilities.shield.ready || this.energy < 30) return;\n    this.energy -= 30;\n    this.abilities.shield.ready = false;\n    this.activeShield = new EchoShield(this.x, this.y, 120, 1.2);\n    this.playSound('shield');\n    setTimeout(() => {\n      this.abilities.shield.ready = true;\n    }, 1200);\n  }\n\n  activateBurst() {\n    if (!this.abilities.burst.ready) return;\n    this.abilities.burst.ready = false;\n    this.playSound('burst');\n    const burst = new ResonanceBurst(this.x, this.y, 200, 30);\n    game.projectiles.push(burst);\n    setTimeout(() => {\n      this.abilities.burst.ready = true;\n    }, 8000);\n  }\n\n  echoLeap() {\n    if (!this.abilities.echoLeap.ready || this.energy < 25) return;\n    this.energy -= 25;\n    this.abilities.echoLeap.ready = false;\n    this.playSound('echoLeap');\n    const platform = new EchoPlatform(\n      this.x + this.facing.x * 50, this.y + this.facing.y * 50,\n      150, 30\n    );\n    game.projectiles.push(platform);\n    setTimeout(() => {\n      this.abilities.echoLeap.ready = true;\n    }, 6000);\n  }\n\n  regenEnergy(delta) {\n    if (this.energyRegenCooldown > 0) this.energyRegenCooldown -= delta;\n    else if (this.energy < this.maxHealth) {\n      this.energy = Math.min(100, this.energy + this.energyRegenRate * delta);\n    }\n  }\n\n  createPulseTrail() {\n    this.pulseLines.push({\n      x: this.x,\n      y: this.y,\n      radius: 0,\n      maxRadius: 50,\n      life: 0.8,\n      frequency: this.frequency\n    });\n  }\n\n  updatePulseLines(delta) {\n    for (let i = this.pulseLines.length - 1; i >= 0; i--) {\n      const line = this.pulseLines[i];\n      line.radius += 100 * delta;\n      line.life -= delta;\n      if (line.life <= 0) this.pulseLines.splice(i, 1);\n    }\n  }\n\n  takeDamage(amount) {\n    this.health = Math.max(0, this.health - amount);\n    this.playSound('hit');\n  }\n\n  playSound(type) {\n    if (!this.audio) return;\n    switch(type) {\n      case 'pulse': this.audio.playPulse(); break;\n      case 'beam': this.audio.playBeam(); break;\n      case 'hit': this.audio.playHit(); break;\n      case 'burst': this.audio.playBurst(); break;\n      case 'shield': this.audio.playShield(); break;\n      case 'echoLeap': this.audio.playEchoLeap(); break;\n      case 'airDash': this.audio.playTone(150, 0.1); break;\n    }\n  }\n\n  render(ctx) {\n    ctx.save();\n    ctx.translate(this.x, this.y);\n    ctx.rotate(Math.atan2(this.facing.y, this.facing.x));\n    \n    ctx.fillStyle = this.color;\n    ctx.strokeStyle = this.color;\n    ctx.lineWidth = 2;\n    ctx.shadowColor = this.color;\n    ctx.shadowBlur = 15;\n    \n    ctx.beginPath();\n    ctx.moveTo(-16, 0);\n    ctx.lineTo(16, -12);\n    ctx.lineTo(16, 12);\n    ctx.closePath();\n    ctx.fill();\n    \n    ctx.strokeStyle = '#ffffff';\n    ctx.lineWidth = 1;\n    ctx.stroke();\n    \n    this.pulseLines.forEach(line => {\n      ctx.save();\n      ctx.strokeStyle = `hsl(${Math.floor(line.frequency / 10)} 100% 50%)`;\n      ctx.lineWidth = 2;\n      ctx.beginPath();\n      ctx.arc(0, 0, line.radius, 0, Math.PI * 2);\n      ctx.stroke();\n      ctx.restore();\n    });\n    \n    ctx.restore();\n  }\n\n  renderHUD(ctx) {\n    const x = this.id === 1 ? 20 : ctx.canvas.width - 140;\n    const y = 20;\n    \n    // Health bar\n    ctx.fillStyle = '#333';\n    ctx.fillRect(x, y, 100, 15);\n    ctx.strokeStyle = '#fff';\n    ctx.strokeRect(x, y, 100, 15);\n    \n    const healthPercent = this.health / this.maxHealth;\n    const healthColor = healthPercent > 0.6 ? '#00ff00' : healthPercent > 0.3 ? '#ffaa00' : '#ff4444';\n    ctx.fillStyle = healthColor;\n    ctx.fillRect(x, y, 100 * healthPercent, 15);\n    \n    // Energy gauge\n    const angle = (this.energy / 100) * Math.PI * 2;\n    ctx.beginPath();\n    ctx.arc(x + 50, y + 35, 20, 0, angle);\n    ctx.strokeStyle = '#00ffff';\n    ctx.lineWidth = 3;\n    ctx.stroke();\n    \n    // Ability icons\n    const iconY = y + 60;\n    const cooldownAlpha = this.abilities.burst.ready ? 0.3 : 0.7;\n    ctx.fillStyle = `rgba(255, 255, 255, ${cooldownAlpha})`;\n    ctx.fillRect(x, iconY, 20, 20);\n    ctx.fillRect(x + 30, iconY, 20, 20);\n    ctx.fillRect(x + 60, iconY, 20, 20);\n  }\n}",
  "src/gameplay/abilities.js": "class EchoShield {\n  constructor(x, y, radius, duration) {\n    this.x = x;\n    this.y = y;\n    this.radius = radius;\n    this.duration = duration;\n    this.elapsed = 0;\n    this.active = true;\n  }\n\n  update(delta) {\n    this.elapsed += delta;\n    if (this.elapsed >= this.duration) {\n      this.active = false;\n    }\n  }\n\n  checkHit(projectile) {\n    const dx = projectile.x - this.x;\n    const dy = projectile.y - this.y;\n    const dist = Math.sqrt(dx * dx + dy * dy);\n    return dist < this.radius + projectile.radius;\n  }\n\n  reflect(projectile) {\n    const angle = Math.atan2(projectile.vy, projectile.vx);\n    projectile.vx = -Math.cos(angle) * projectile.speed * 0.5;\n    projectile.vy = -Math.sin(angle) * projectile.speed * 0.5;\n    projectile.ownerId = null;\n  }\n\n  render(ctx) {\n    if (!this.active) return;\n    const alpha = 1 - (this.elapsed / this.duration);\n    ctx.save();\n    ctx.globalAlpha = alpha * 0.3;\n    ctx.strokeStyle = '#00ffff';\n    ctx.lineWidth = 2;\n    ctx.beginPath();\n    ctx.arc(this.x, this.y, this.radius, 0, Math.PI * 2);\n    ctx.stroke();\n    ctx.restore();\n  }\n}\n\nclass ResonanceBurst {\n  constructor(x, y, radius, damage) {\n    this.x = x;\n    this.y = y;\n    this.radius = radius;\n    this.damage = damage;\n    this.elapsed = 0;\n    this.duration = 0.1;\n    this.stunDuration = 0.5;\n    this.completed = false;\n  }\n\n  update(delta) {\n    this.elapsed += delta;\n    if (this.elapsed >= this.duration) {\n      this.completed = true;\n    }\n  }\n\n  checkCollision(player) {\n    if (this.completed) {\n      const dx = player.x - this.x;\n      const dy = player.y - this.y;\n      const dist = Math.sqrt(dx * dx + dy * dy);\n      return dist < this.radius + player.width / 2;\n    }\n    return false;\n  }\n\n  render(ctx) {\n    const alpha = Math.sin(this.elapsed * Math.PI * 4) * 0.5 + 0.5;\n    ctx.save();\n    ctx.globalAlpha = alpha;\n    ctx.fillStyle = 'rgba(255, 255, 255, 0.2)';\n    ctx.beginPath();\n    ctx.arc(this.x, this.y, this.radius, 0, Math.PI * 2);\n    ctx.fill();\n    ctx.restore();\n  }\n}\n\nclass EchoPlatform {\n  constructor(x, y, width, height) {\n    this.x = x;\n    this.y = y;\n    this.width = width;\n    this.height = height;\n    this.duration = 2;\n    this.elapsed = 0;\n    this.active = true;\n  }\n\n  update(delta) {\n    this.elapsed += delta;\n    if (this.elapsed >= this.duration) {\n      this.active = false;\n    }\n  }\n\n  checkCollision(player) {\n    if (!this.active) return false;\n    return player.x > this.x && player.x < this.x + this.width &&\n           player.y + player.height > this.y && player.y < this.y + this.height;\n  }\n\n  render(ctx) {\n    if (!this.active) return;\n    const alpha = 1- (this.elapsed / this.duration);
    ctx.save();
    ctx.globalAlpha = alpha * 0.5;
    ctx.fillStyle = '#00ffff';
    ctx.fillRect(this.x, this.y, this.width, this.height);
    ctx.strokeStyle = '#ffffff';
    ctx.lineWidth = 1;
    ctx.strokeRect(this.x, this.y, this.width, this.height);
    ctx.restore();
  }
}",
  "src/gameplay/projectiles.js": "class SoundProjectile {\n  constructor(x, y, vx, vy, length, radius, frequency, ownerId, isBeam = false) {\n    this.x = x;\n    this.y = y;\n    this.vx = vx;\n    this.vy = vy;\n    this.length = length;\n    this.radius = radius;\n    this.frequency = frequency;\n    this.ownerId = ownerId;\n    this.isBeam = isBeam;\n    this.speed = Math.sqrt(vx * vx + vy * vy);\n    this.markedForRemoval = false;\n    this.trail = [];\n  }\n\n  update(delta) {\n    this.x += this.vx * delta;\n    this.y += this.vy * delta;\n    this.trail.push({ x: this.x, y: this.y });\n    if (this.trail.length > 10) this.trail.shift();\n    if (this.x < 0 || this.x > 1024 || this.y < 0 || this.y > 768) {\n      this.markForRemoval();\n    }\n  }\n\n  checkCollision(player) {\n    const dx = player.x - this.x;\n    const dy = player.y - this.y;\n    const dist = Math.sqrt(dx * dx + dy * dy);\n    return dist < this.radius + player.width / 2;\n  }\n\n  markForRemoval() {\n    this.markedForRemoval = true;\n  }\n\n  render(ctx) {\n    ctx.save();\n    ctx.strokeStyle = `hsl(${Math.floor(this.frequency / 10)} 100% 50%)`;\n    ctx.lineWidth = this.radius * 2;\n    ctx.lineCap = 'round';\n    ctx.shadowColor = `hsl(${Math.floor(this.frequency / 10)} 100% 50%)`;\n    ctx.shadowBlur = 15;\n    \n    const angle = Math.atan2(this.vy, this.vx);\n    const endX = this.x + Math.cos(angle) * this.length;\n    const endY = this.y + Math.sin(angle) * this.length;\n    \n    ctx.beginPath();\n    ctx.moveTo(this.x, this.y);\n    ctx.lineTo(endX, endY);\n    ctx.stroke();\n    \n    this.trail.forEach((point, i) => {\n      const alpha = i / this.trail.length;\n      ctx.strokeStyle = `hsla(${Math.floor(this.frequency / 10)}, 100%, 50%, ${alpha})`;\n      ctx.lineWidth = this.radius;\n      ctx.beginPath();\n      ctx.moveTo(point.x, point.y);\n      ctx.lineTo(this.x, this.y);\n      ctx.stroke();\n    });\n    \n    ctx.restore();\n  }\n}\n\nclass Particle {\n  constructor(x, y, hue) {\n    this.x = x;\n    this.y = y;\n    this.vx = (Math.random() - 0.5) * 200;\n    this.vy = (Math.random() - 0.5) * 200;\n    this.radius = Math.random() * 5 + 2;\n    this.life = 1;\n    this.hue = hue;\n  }\n\n  update(delta) {\n    this.x += this.vx * delta;\n    this.y += this.vy * delta;\n    this.life -= delta;\n    this.vx *= 0.95;\n    this.vy *= 0.95;\n  }\n\n  render(ctx) {\n    ctx.save();
    ctx.globalAlpha = this.life;
    ctx.fillStyle = `hsl(${this.hue}, 100%, 50%)`;
    ctx.beginPath();
    ctx.arc(this.x, this.y, this.radius, 0, Math.PI * 2);
    ctx.fill();
    ctx.restore();
  }
}",
  "src/gameplay/gameLogic.js": "class GameLogic {\n  constructor() {\n    this.score = 0;\n    this.round = 1;\n    this.gameState = 'playing';\n  }\n\n  update(delta) {\n    // Game logic updates\n  }\n\n  checkWinCondition(players) {\n    const alive = players.filter(p => p.health > 0);\n    if (alive.length === 1) {\n      return { winner: alive[0].id, type: 'elimination' };\n    } else if (alive.length === 0) {\n      return { winner: null, type: 'draw' };\n    }\n    return null;\n  }\n}\n\n// Global game instance reference\nvar game = null;\n\nfunction setGameInstance(g) {\n  game = g;\n}",
  "src/gameplay/hud.js": "class HUD {\n  constructor(ctx) {\n    this.ctx = ctx;\n    this.font = '16px Orbitron, monospace';\n  }\n\n  render(ctx) {\n    ctx.save();
    ctx.font = this.font;
    ctx.fillStyle = '#00ffaa';
    ctx.textAlign = 'left';
    ctx.fillText('Health:', 20, 30);
    ctx.fillText('Energy:', 20, 50);
    ctx.restore();
  }\n}\n\n// Extend Player with missing methods\nPlayer.prototype.isMouseButtonDown = function(button) {\n  if (!this.input) return false;\n  if (button === 0) return this.input.mouse.left;\n  if (button === 2) return this.input.mouse.right;\n  return false;\n};\n\nPlayer.prototype.getOwner = function() {\n  return game.players.find(p => p.id === this.id);\n};",
  "src/levels/arena.js": "class Arena {\n  constructor() {\n    this.width = 1024;\n    this.height = 768;\n    this.walls = [\n      { x: 0, y: 0, width: 20, height: 768 },\n      { x: 1004, y: 0, width: 20, height: 768 },\n      { x: 0, y: 0, width: 1024, height: 20 },\n      { x: 0, y: 748, width: 1024, height: 20 }\n    ];\n    this.obstacles = [\n      { x: 300, y: 200, width: 100, height: 50 },\n      { x: 600, y: 400, width: 100, height: 50 },\n      { x: 450, y: 600, width: 150, height: 50 }\n    ];\n  }\n\n  render(ctx) {\n    ctx.save();
    // Background gradient
    const gradient = ctx.createLinearGradient(0, 0, 0, 768);
    gradient.addColorStop(0, '#0a0a2a');
    gradient.addColorStop(1, '#1a0a3a');
    ctx.fillStyle = gradient;
    ctx.fillRect(0, 0, this.width, this.height);
    \n    // Grid lines\n    ctx.strokeStyle = 'rgba(0, 255, 170, 0.1)';
    ctx.lineWidth = 1;\n    for (let x = 0; x < this.width; x += 40) {\n      ctx.beginPath();
      ctx.moveTo(x, 0);
      ctx.lineTo(x, this.height);
      ctx.stroke();
    }\n    for (let y = 0; y < this.height; y += 40) {\n      ctx.beginPath();
      ctx.moveTo(0, y);
      ctx.lineTo(this.width, y);
      ctx.stroke();
    }\n    \n    // Walls\n    ctx.fillStyle = '#333';
    ctx.strokeStyle = '#00ffaa';
    ctx.lineWidth = 2;\n    this.walls.forEach(wall => {\n      ctx.fillRect(wall.x, wall.y, wall.width, wall.height);\n      ctx.strokeRect(wall.x, wall.y, wall.width, wall.height);\n    });\n    \n    // Obstacles\n    ctx.fillStyle = '#555';
    ctx.strokeStyle = '#ff00ff';\n    this.obstacles.forEach(obs => {\n      ctx.fillRect(obs.x, obs.y, obs.width, obs.height);\n      ctx.strokeRect(obs.x, obs.y, obs.width, obs.height);\n    });\n    \n    ctx.restore();
  }\n}\n\n// Initialize game instance\nwindow.addEventListener('load', () => {\n  window.game = new Game();\n});"
}