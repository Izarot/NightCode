')]<|tool_call_end|><|tool_call_start|>[write(filePath='/resizer.js', content='// ============================================
// Canvas Resizer - Device Pixel Ratio Support
// ============================================\n\nconst Resizer = {\n    /**\n     * Resize canvases based on device pixel ratio and screen constraints.\n     * \n     * @param {HTMLCanvasElement} gameCanvas - The main game canvas\n     * @param {HTMLCanvasElement} hudCanvas - The HUD overlay canvas\n     */\n    resize(canvasId) {\n        const canvas = document.getElementById(canvasId);\n        if (!canvas) return;\n\n        const dpr = window.devicePixelRatio || 1;\n        const maxWidth = window.innerWidth - 40;\n        const maxHeight = window.innerHeight - 160;\n\n        // Calculate target size in logical pixels (CSS pixels)\n        const targetWidth = Math.min(maxWidth, 1400);\n        const targetHeight = Math.min(maxHeight, 900);\n\n        // Apply scaling factor considering DPR\n        const scaleFactor = Math.min(\n            targetWidth / canvas.width,\n            targetHeight / canvas.height,\n            dpr\n        );\n\n        // Clamp to reasonable maximums\n        const clampedScale = Math.min(scaleFactor, 2.5);\n\n        canvas.width = Math.floor(canvas.width * clampedScale);\n        canvas.height = Math.floor(canvas.height * clampedScale);\n\n        // Restore original unit values via CSS\n        const cssWidth = canvas.width;\n        const cssHeight = canvas.height;\n        canvas.style.width = `${cssWidth}px`;\n        canvas.style.height = `${cssHeight}px`;\n    }\n\n    /**\n     * Resize both game and HUD canvases simultaneously.\n     * Called when window is resized or page loads.\n     */\n    resizeAll() {\n        this.resize(\'game-canvas\');\n        this.resize(\'hud-canvas\');\n    }\n\n    /**\n     * Update canvas sizes based on current window dimensions.\n     * Should be called on window resize events.\n     */\n    update() {\n        const gameCanvas = document.getElementById(\'game-canvas\');\n        const hudCanvas = document.getElementById(\'hud-canvas\');\n        \n        if (!gameCanvas || !hudCanvas) return;\n\n        const dpr = window.devicePixelRatio || 1;\n        const maxWidth = window.innerWidth - 40;\n        const maxHeight = window.innerHeight - 160;\n\n        const targetWidth = Math.min(maxWidth, 1400);\n        const targetHeight = Math.min(maxHeight, 900);\n\n        const scaleFactor = Math.min(\n            targetWidth / gameCanvas.width,\n            targetHeight / gameCanvas.height,\n            dpr\n        );\n\n        const clampedScale = Math.min(scaleFactor, 2.5);\n\n        gameCanvas.width = Math.floor(gameCanvas.width * clampedScale);\n        gameCanvas.height = Math.floor(gameCanvas.height * clampedScale);\n        gameCanvas.style.width = `${gameCanvas.width}px`;\n        gameCanvas.style.height = `${gameCanvas.height}px`;\n\n        hudCanvas.width = Math.floor(hudCanvas.width * clampedScale);\n        hudCanvas.height = Math.floor(hudCanvas.height * clampedScale);\n        hudCanvas.style.width = `${hudCanvas.width}px`;\n        hudCanvas.style.height = `${hudCanvas.height}px`;\n    }\n};\n\n// Initialize on load\nwindow.addEventListener(\'load\', () => {\n    Resizer.update();\n});\n\n// Listen for window resize\nwindow.addEventListener(\'resize\', () => {\n    Resizer.update();\n});\n\nexport default Resizer;\n')]<|tool_call_end|>