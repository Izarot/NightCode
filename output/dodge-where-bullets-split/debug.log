        gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.1);
        osc.connect(gain);
        gain.connect(ctx.destination);
        osc.start(ctx.currentTime);
        osc.stop(ctx.currentTime + 0.1);
        return osc;
    }

    generatePulseFire() {
        const osc = this.createOscillator();
        const gain = this.createGain();
        osc.type = 'sawtooth';
        osc.frequency.setValueAtTime(220, ctx.currentTime);
        osc.frequency.exponentialRampToValueAtTime(110, ctx.currentTime + 0.4);
        gain.gain.setValueAtTime(0.15, ctx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.4);
        osc.connect(gain);
        gain.connect(ctx.destination);
        osc.start(ctx.currentTime);
        osc.stop(ctx.currentTime + 0.4);
        return osc;
    }

    generateGraze() {
        const osc = this.createOscillator();
        const gain = this.createGain();
        osc.type = 'square';
        osc.frequency.setValueAtTime(1500, ctx.currentTime);
        osc.frequency.exponentialRampToValueAtTime(800, ctx.currentTime + 0.02);
        gain.gain.setValueAtTime(0.1, ctx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.02);
        osc.connect(gain);
        gain.connect(ctx.destination);
        osc.start(ctx.currentTime);
        osc.stop(ctx.currentTime + 0.02);
        return osc;
    }

    createOscillator() {
        const osc = this.audioContext.createOscillator();
        osc.type = 'triangle';
        osc.frequency.setValueAtTime(800, this.audioContext.currentTime);
        osc.connect(this.audioContext.destination);
        return osc;
    }

    createGain() {
        const g = this.audioContext.createGain();
        g.gain.value = 0.3;
        return g;
    }

    createNoiseBuffer(duration) {
        const sampleRate = this.audioContext.sampleRate;
        const length = duration * sampleRate;
        const buffer = this.audioContext.createBuffer(1, sampleRate * 4, length);
        const data = buffer.getChannelData(0);
        
        for (let i = 0; i < length; i++) {
            data[i] = (Math.random() * 2 - 1) * 0.5;
        }
        
        return buffer;
    }

    playSound(type) {
        if (!this.audioContext) return;
        switch (type) {
            case 'click':
                playSound('click');
                break;
            case 'thwip':
                playSound('thwip');
                break;
            case 'fracture':
                playSound('fracture');
                break;
            case 'shard':
                playSound('shard');
                break;
            case 'pulse':
                playSound('pulse');
                break;
            case 'graze':
                playSound('graze');
                break;
            default:
                // Fallback: ambient drone
                this.playAmbient();
        }
    }

    playAmbient() {
        const osc = this.createOscillator();
        const gain = this.createGain();
        osc.type = 'sine';
        osc.frequency.setValueAtTime(55, this.audioContext.currentTime);
        gain.gain.setValueAtTime(0.02, this.audioContext.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.001, this.audioContext.currentTime + 0.5);
        osc.connect(gain);
        gain.connect(this.audioContext.destination);
        osc.start(this.audioContext.currentTime);
        osc.stop(this.audioContext.currentTime + 0.5);
    }

    // Schedule a sound to play after a delay
    scheduleSound(name, callback, delayMs) {
        const source = this.generateClick();
        setTimeout(() => {
            this.schedules.set(delayMs, source);
            source.onEnd = () => this.schedules.delete(delayMs);
        }, delayMs);
    }
}

export { AudioSystem };
