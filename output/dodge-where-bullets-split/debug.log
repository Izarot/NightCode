class AudioSystem {
    constructor() {
        this.audioContext = null;
        this.sources = new Map(); // name -> AudioSource
        this.scheduled = new Map(); // delay -> AudioSource
    }

    async initialize() {
        if (this.audioContext) return;
        const ctx = new (window.AudioContext || window.webkitAudioContext)();
        this.audioContext = ctx;
        // Enable analytics stream for Web Audio
        ctx.destination.volume.value = 0.7;
    }

    // Generate short SFX using oscillators (no external assets needed)
    generateClick() {
        const osc = this.createOscillator();
        const gain = this.createGain();
        osc.connect(gain);
        gain.connect(ctx.destination);
        osc.frequency.setValueAtTime(1200, ctx.currentTime);
        osc.frequency.exponentialRampToValueAtTime(2000, ctx.currentTime + 0.03);
        gain.gain.setValueAtTime(0.15, ctx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.03);
        osc.start(ctx.currentTime);
        osc.stop(ctx.currentTime + 0.03);
        return osc;
    }

    generateThwip() {
        const osc = this.createOscillator();
        const gain = this.createGain();
        osc.type = 'square';
        osc.frequency.setValueAtTime(1200, ctx.currentTime);
        osc.frequency.exponentialRampToValueAtTime(300, ctx.currentTime + 0.05);
        gain.gain.setValueAtTime(0.12, ctx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.05);
        osc.connect(gain);
        gain.connect(ctx.destination);
        osc.start(ctx.currentTime);
        osc.stop(ctx.currentTime + 0.05);
        return osc;
    }

    generateFracture() {
        // Glass break effect: noise burst + descending tones
        const noise = this.createNoiseBuffer(0.05);
        const osc = this.createOscillator();
        const gain = this.createGain();
        osc.connect(gain);
        gain.connect(ctx.destination);
        
        // Noise burst
        noise.start(ctx.currentTime);
        noise.stop(ctx.currentTime + 0.05);
        
        // Descending tone
        osc.type = 'triangle';
        osc.frequency.setValueAtTime(800, ctx.currentTime);
        osc.frequency.exponentialRampToValueAtTime(200, ctx.currentTime + 0.3);
        gain.gain.setValueAtTime(0.2, ctx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.3);
        osc.connect(gain);
        gain.connect(ctx.destination);
        osc.start(ctx.currentTime);
        osc.stop(ctx.currentTime + 0.3);
        return noise;
    }

    generateShardSpawn() {
