00%;background:radial-gradient(circle at 30% 20%,#22262e,#1A1D23);border-radius:12px;box-shadow:0 10px 30px rgba(0,0,0,.4)}\n#player-panel{\ngrid-row:1;grid-column:2;background:rgba(42,47,56,.85);backdrop-filter:blur(12px);\nborder:1px solid rgba(244,241,222,.1);border-radius:12px;padding:14px;overflow-y:auto;\n}\n#player-panel .p-card{\ndisplay:flex;flex-direction:column;gap:6px;padding:10px;margin-bottom:10px;\nborder-radius:10px;background:rgba(255,255,255,.03);transition:all .3s ease;\nborder:1px solid transparent;\n}\n#player-panel .p-card.active{border-color:rgba(244,241,222,.4);box-shadow:0 0 20px rgba(244,241,222,.08)}\n.p-head{display:flex;align-items:center;gap:8px;font-weight:600}\n.p-head .dot{width:14px;height:14px;border-radius:50%}\n.p-pos{font-size:12px;color:var(--text2);font-family:'Space Mono',monospace}\n.p-bar{height:6px;background:var(--tile);border-radius:3px;overflow:hidden}\n.p-bar .fill{height:100%;background:var(--p1);transition:width .4s cubic-bezier(.4,0,.2,1);box-shadow:0 0 8px currentColor}\n.skip-badge{font-size:10px;color:var(--danger);font-weight:700;letter-spacing:1px}\n#dice-panel{\ngrid-row:2;grid-column:2;display:flex;align-items:center;gap:14px;\nbackground:rgba(42,47,56,.85);backdrop-filter:blur(12px);\npadding:12px;border-radius:12px;border:1px solid rgba(244,241,222,.1);\n}\n#dice{background:var(--surface);border-radius:10px;box-shadow:inset 0 2px 6px rgba(0,0,0,.4)}\n#roll-btn{\nflex:1;height:56px;border:none;border-radius:12px;\nbackground:var(--accent);color:var(--bg);font-family:'Outfit',sans-serif;\nfont-weight:700;font-size:15px;letter-spacing:1.5px;cursor:pointer;\ntransition:all .2s cubic-bezier(.4,0,.2,1);\nbox-shadow:0 4px 6px rgba(0,0,0,.1),0 10px 20px rgba(0,0,0,.15);\n}\n#roll-btn:hover{transform:translateY(-2px);box-shadow:0 6px 12px rgba(0,0,0,.2),0 14px 26px rgba(0,0,0,.25)}\n#roll-btn:active{transform:translateY(1px) scale(.98)}\n#roll-btn:disabled{opacity:.5;cursor:not-allowed;transform:none}\n#roll-btn.pulse{animation:pulse 1.6s ease-in-out infinite}\n@keyframes pulse{0%,100%{box-shadow:0 4px 6px rgba(0,0,0,.1),0 0 0 0 rgba(244,241,222,.5)}50%{box-shadow:0 4px 6px rgba(0,0,0,.1),0 0 0 12px rgba(244,241,222,0)}}\n#roll-btn .hint{font-family:'Space Mono',monospace;font-size:11px;opacity:.6;margin-left:8px}\n#log-panel{\nposition:absolute;right:12px;bottom:90px;width:280px;height:220px;\nbackground:rgba(42,47,56,.85);backdrop-filter:blur(12px);\nborder:1px solid rgba(244,241,222,.1);border-radius:12px;padding:10px;\noverflow:hidden;display:none;\n}\n#log-panel h3{font-family:'Outfit',sans-serif;font-size:14px;margin-bottom:8px;color:var(--accent);letter-spacing:1px}\n#log{list-style:none;height:calc(100% - 24px);overflow-y:auto;font-size:12px}\n#log li{padding:4px 6px;border-radius:6px;margin-bottom:3px;background:rgba(255,255,255,.03);font-family:'Space Mono',monospace}\n#log li::before{content:'› ';color:var(--text2)}\n#modal,#setup-modal{\nposition:fixed;inset:0;background:rgba(0,0,0,.75);backdrop-filter:blur(8px);\ndisplay:flex;align-items:center;justify-content:center;z-index:50;transition:opacity .3s;\n}\n#modal.hidden{opacity:0;pointer-events:none}\n.modal-box{\nposition:relative;background:var(--surface);padding:30px;border-radius:16px;\ntext-align:center;min-width:320px;max-width:90vw;\nbox-shadow:0 20px 60px rgba(0,0,0,.5);\nanimation:modalIn .4s cubic-bezier(.34,1.56,.64,1);\n}\n@keyframes modalIn{from{transform:scale(.8);opacity:0}to{transform:scale(1);opacity:1}}\n#confetti{position:absolute;inset:0;width:100%;height:100%;pointer-events:none;border-radius:16px}\n.modal-box h2{font-family:'Outfit',sans-serif;font-size:32px;margin-bottom:14px;color:var(--accent)}\n.modal-box ol{list-style:decimal inside;margin:14px 0;text-align:left}\n.modal-box li{padding:6px 10px;margin:4px 0;background:rgba(255,255,255,.05);border-radius:8px;display:flex;align-items:center;gap:8px}\n.modal-box .actions{display:flex;gap:10px;justify-content:center;margin-top:14px}\n.modal-box button{\npadding:10px 20px;border:none;border-radius:10px;cursor:pointer;\nfont-family:'Outfit',sans-serif;font-weight:700;letter-spacing:1px;\nbackground:var(--accent);color:var(--bg);transition:transform .2s;\n}\n.modal-box button:hover{transform:scale(1.05)}\n#setup-modal label{display:block;margin:14px 0;text-align:left}\n#setup-modal select,#setup-modal input{\nwidth:100%;padding:8px;margin-top:6px;background:var(--tile);\nborder:1px solid var(--tile-hi);border-radius:8px;color:var(--accent);font-family:inherit;\n}\n#name-inputs{margin:14px 0}\n#name-inputs input{margin-bottom:8px}\n@media (max-width:900px){\n#game-container{grid-template-columns:1fr;grid-template-rows:1fr auto auto}\n#board{grid-row:1;grid-column:1}\n#player-panel{grid-row:2;grid-column:1;max-height:140px}\n#dice-panel{grid-row:3;grid-column:1}\n#log-panel{display:none}\n}\n@media (max-width:600px){\n.title{font-size:16px}\n#turn-indicator{font-size:12px}\n.modal-box{padding:18px}\n.modal-box h2{font-size:22px}\n}\n", "js/state.js": "const COLORS=['#E07A5F','#81B29A','#F2CC8F','#3D405B'];\nconst EVENT={STATE:'_s'};\nconst emitter={\n  cbs:{},\n  on(ev,fn){(this.cbs[ev]||(this.cbs[ev]=[])).push(fn)},\n  emit(ev,data){(this.cbs[ev]||[]).forEach(fn=>fn(data))}\n};\nconst State={\n  phase:'SETUP',\n  players:[],\n  currentPlayerIndex:0,\n  currentRoll:null,\n  winner:null,\n  moveQueue:[],\n  log:[],\n  startTime:0,\n  elapsed:0,\n  highScore:parseInt(localStorage.getItem('pathroll_hi')||'0',10),\n  init(num,names){\n    this.players=Array.from({length:num},(_,i)=>({\n      id:i,name:names[i]||('Player '+(i+1)),color:COLORS[i],\n      position:0,isActive:i===0,isFinished:false,skipNextTurn:false,turns:0\n    }));\n    this.currentPlayerIndex=0;this.currentRoll=null;this.winner=null;\n    this.moveQueue=[];this.log=[];this.phase='ROLLING';\n    this.startTime=Date.now();this.elapsed=0;\n    this.logEvent('Game started with '+num+' players');\n    emitter.emit(EVENT.STATE,this);\n  },\n  logEvent(msg){\n    this.log.unshift({msg,t:Date.now()});\n    if(this.log.length>50)this.log.length=50;\n  },\n  setPhase(p){this.phase=p;emitter.emit(EVENT.STATE,this)},\n  currentPlayer(){return this.players[this.currentPlayerIndex]},\n  saveHigh(){\n    if(this.elapsed>this.highScore){\n      this.highScore=this.elapsed;\n      localStorage.setItem('pathroll_hi',String(this.elapsed));\n    }\n  }\n};\n", "js/board.js": "const PATH_LEN=20;\nconst TILE=64,GAP=4,STRIDE=TILE+GAP;\nconst TILES=[];\nfunction buildPath(){\n  TILES.length=0;\n  const layout=[\n    {c:1,r:0},{c:2,r:0},{c:3,r:0},{c:4,r:0},{c:5,r:0},\n    {c:5,r:1},{c:4,r:1},{c:3,r:1},{c:2,r:1},{c:1,r:1},\n    {c:1,r:2},{c:2,r:2},{c:3,r:2},{c:4,r:2},{c:5,r:2},\n    {c:5,r:3},{c:4,r:3},{c:3,r:3},{c:2,r:3},{c:1,r:3}\n  ];\n  layout.forEach((p,i)=>{\n    TILES.push({\n      idx:i,x:p.c*STRIDE+TILE/2,y:p.r*STRIDE+TILE/2,\n      type: i===0?'start':i===PATH_LEN-1?'finish':([5,12].includes(i)?'bonus':([8,16].includes(i)?'penalty':'normal'))\n    });\n  });\n}\nfunction getPathBounds(){\n  let minX=Infinity,minY=Infinity,maxX=-Infinity,maxY=-Infinity;\n  TILES.forEach(t=>{minX=Math.min(minX,t.x);minY=Math.min(minY,t.y);maxX=Math.max(maxX,t.x);maxY=Math.max(maxY,t.y)});\n  return {minX,minY,maxX,maxY,w:maxX-minX+TILE,h:maxY-minY+TILE};\n}\nfunction drawBoard(ctx,w,h,t){\n  const b=getPathBounds();\n  const scale=Math.min((w-100)/b.w,(h-100)/b.h,1.4);\n  const offX=(w-b.w*scale)/2-b.minX*scale;\n  const offY=(h-b.h*scale)/2-b.minY*scale;\n  ctx.save();ctx.translate(offX,offY);ctx.scale(scale,scale);\n  TILES.forEach(tile=>drawTile(ctx,tile,t));\n  ctx.restore();\n  return{offX,offY,scale};\n}\nfunction drawTile(ctx,tile,t){\n  const x=tile.x-TILE/2,y=tile.y-TILE/2;\n  let fill='#3D4450';\n  if(tile.type==='start')fill='#2a4a3a';\n  if(tile.type==='finish'){\n    ctx.save();\n    for(let i=0;i<4;i++){ctx.fillStyle=i%2===0?'#F2CC8F':'#3D4450';ctx.fillRect(x+i%2*TILE/2,y+Math.floor(i/2)*TILE/2,TILE/2,TILE/2)}\n    ctx.restore();\n  }\n  if(tile.type==='bonus')fill='#2a3a5a';\n  if(tile.type==='penalty')fill='#5a2a3a';\n  if(fill!=='#3D4450'&&tile.type!=='finish'){ctx.fillStyle=fill;roundRect(ctx,x,y,TILE,TILE,8);ctx.fill()}\n  if(tile.type==='start'){\n    const pulse=.5+.5*Math.sin(t/400);\n    ctx.strokeStyle=`rgba(46,204,113,${.5+pulse*.5})`;ctx.lineWidth=3;\n    roundRect(ctx,x,y,TILE,TILE,8);ctx.stroke();\n    ctx.fillStyle='#2ECC71';ctx.font='bold 9px Space Mono';ctx.textAlign='center';\n    ctx.fillText('START',tile.x,tile.y+3);\n  }else if(tile.type==='finish'){\n    ctx.fillStyle='#F4F1DE';ctx.font='bold 9px Space Mono';ctx.textAlign='center';\n    ctx.fillText('FINISH',tile.x,tile.y+3);\n  }else if(tile.type==='bonus'){\n    ctx.fillStyle='#4A90E2';ctx.font='14px serif';ctx.textAlign='center';\n    ctx.fillText('⚡',tile.x,tile.y+5);\n  }else if(tile.type==='penalty'){\n    ctx.fillStyle='#E63946';ctx.font='14px serif';ctx.textAlign='center';\n    ctx.fillText('⏸',tile.x,tile.y+5);\n  }\n  ctx.fillStyle='rgba(244,241,222,.4)';ctx.font='8px Space Mono';ctx.textAlign='left';\n  ctx.fillText(String(tile.idx+1).padStart(2,'0'),x+5,y+11);\n}\nfunction roundRect(ctx,x,y,w,h,r){\n  ctx.beginPath();\n  ctx.moveTo(x+r,y);ctx.lineTo(x+w-r,y);ctx.quadraticCurveTo(x+w,y,x+w,y+r);\n  ctx.lineTo(x+w,y+h-r);ctx.quadraticCurveTo(x+w,y+h,x+w-r,y+h);\n  ctx.lineTo(x+r,y+h);ctx.quadraticCurveTo(x,y+h,x,y+h-r);\n  ctx.lineTo(x,y+r);ctx.quadraticCurveTo(x,y,x+r,y);ctx.closePath();\n}\nfunction getTileAt(idx){return TILES[idx]}\nfunction init(){buildPath()}\n", "js/dice.js": "const Dice={\n  value:1,rolling:false,t:0,final:1,offsetX:0,offsetY:0,rot:0,scale:1,\n  ctx:null,\n  init(ctx){this.ctx=ctx;this.draw(1)},\n  roll(final){\n    if(this.rolling)return;\n    this.rolling=true;this.t=0;this.final=final;\n    State.setPhase('ROLLING');\n    playSound('roll');\n  },\n  update(dt){\n    if(!this.rolling)return;\n    this.t+=dt;\n    if(this.t<400){\n      this.value=1+Math.floor(Math.random()*6);\n      this.offsetX=(Math.random()-.5)*20;this.offsetY=(Math.random()-.5)*20;\n      this.rot=(Math.random()-.5)*360;this.scale=1;\n    }else if(this.t<700){\n      const p=(this.t-400)/300;this.offsetX*=.7;this.offsetY*=.7;this.rot*=.7;this.scale=1+.15*Math.sin(p*Math.PI);\n    }else if(this.t<800){\n      this.offsetX=0;this.offsetY=0;this.rot=Math.round(this.rot/90)*90;this.value=this.final;\n      const p=(this.t-700)/100;this.scale=1+.15*Math.sin(p*Math.PI);\n    }else{\n      this.rolling=false;this.offsetX=0;this.offsetY=0;this.rot=0;this.scale=1;\n      State.setPhase('MOVING');\n      startMove(this.final);\n    }\n  },\n  draw(v){\n    if(!this.ctx)return;\n    const c=this.ctx;c.clearRect(0,0,100,100);\n    c.save();\n    c.translate(50+this.offsetX,50+this.offsetY);c.rotate(this.rot*Math.PI/180);c.scale(this.scale,this.scale);\n    c.shadowColor='rgba(0,0,0,.4)';c.shadowBlur=10;c.shadowOffsetY=4;\n    const g=c.createLinearGradient(-30,-30,30,30);\n    g.addColorStop(0,'#FFFFFF');g.addColorStop(1,'#E5E0CC');\n    c.fillStyle=g;roundRectC(c,-30,-30,60,60,10);c.fill();\n    c.shadowColor='transparent';\n    c.strokeStyle='rgba(0,0,0,.15)';c.lineWidth=1;roundRectC(c,-30,-30,60,60,10);c.stroke();\n    drawPips(c,this.value||v);\n    c.restore();\n  },\n  drawFace(v){this.value=v;this.draw(v)}\n};\nfunction drawPips(c,v){\n  c.fillStyle='#1A1D23';\n  const dots={\n    1:[[0,0]],2:[[-12,-12],[12,12]],3:[[-12,-12],[0,0],[12,12]],\n    4:[[-12,-12],[12,-12],[-12,12],[12,12]],5:[[-12,-12],[12,-12],[0,0],[-12,12],[12,12]],\n    6:[[-12,-12],[12,-12],[-12,0],[12,0],[-12,12],[12,12]]\n  }[v]||[[0,0]];\n  dots.forEach(d=>{c.beginPath();c.arc(d[0],d[1],4,0,Math.PI*2);c.fill()});\n}\nfunction roundRectC(c,x,y,w,h,r){\n  c.beginPath();c.moveTo(x+r,y);c.lineTo(x+w-r,y);c.quadraticCurveTo(x+w,y,x+w,y+r);\n  c.lineTo(x+w,y+h-r);c.quadraticCurveTo(x+w,y+h,x+w-r,y+h);\n  c.lineTo(x+r,y+h);c.quadraticCurveTo(x,y+h,x,y+h-r);\n  c.lineTo(x,y+r);c.quadraticCurveTo(x,y,x+r,y);c.closePath();\n}\n", "js/player.js": "const Player={\n  anims:[],\n  init(){},\n  drawAll(ctx,view,t){\n    const stackMap={};\n    State.players.forEach(p=>{\n      const t=TILES[p.position];\n      if(!stackMap[p.position])stackMap[p.position]=[];\n      stackMap[p.position].push(p);\n    });\n    Object.keys(stackMap).forEach(idx=>{\n      const list=stackMap[idx];const t=TILES[idx];\n      list.forEach((p,i)=>this.drawToken(ctx,view,p,t,i,list.length));\n    });\n  },\n  drawToken(ctx,v,p,tile,idx,total){\n    const angle=(idx/total)*Math.PI*2;\n    const ox=total>1?Math.cos(angle)*8:0;\n    const oy=total>1?Math.sin(angle)*8:0;\n    let tx=tile.x+ox,ty=tile.y+oy;\n    const a=this.anims.find(x=>x.pid===p.id);\n    if(a){\n      const p1=TILES[a.from],p2=TILES[a.to];\n      tx=p1.x+(p2.x-p1.x)*a.t+ox;\n      ty=p1.y+(p2.y-p1.y)*a.t+oy;\n    }\n    const px=tx*v.scale+v.offX,py=ty*v.scale+v.offY;\n    ctx.save();\n    if(p.isActive&&!p.isFinished){\n      const pulse=1+.08*Math.sin(Date.now()/250);\n      ctx.shadowColor=p.color;ctx.shadowBlur=20*pulse;\n    }\n    ctx.fillStyle=p.color;ctx.beginPath();ctx.arc(px,py,20,0,Math.PI*2);ctx.fill();\n    const g=ctx.createRadialGradient(px-6,py-6,2,px,py,20);\n    g.addColorStop(0,'rgba(255,255,255,.45)');g.addColorStop(1,'rgba(255,255,255,0)');\n    ctx.fillStyle=g;ctx.beginPath();ctx.arc(px,py,20,0,Math.PI*2);ctx.fill();\n    ctx.fillStyle='#F4F1DE';ctx.font='bold 11px Outfit';ctx.textAlign='center';ctx.textBaseline='middle';\n    ctx.fillText(p.name.charAt(0),px,py);\n    ctx.restore();\n  },\n  startMove(pid,steps){\n    this.anims=this.anims.filter(a=>a.pid!==pid);\n    const p=State.players.find(x=>x.id===pid);\n    this.anims.push({pid,from:p.position,to:p.position,steps:steps,step:0,t:0,onStep:null,onDone:null});\n  }\n};\nfunction startMove(steps){\n  const cp=State.currentPlayer();\n  if(cp.skipNextTurn){cp.skipNextTurn=false;State.logEvent(cp.name+' skips a turn');endTurn();return}\n  Player.startMove(cp.id,steps);\n  State.setPhase('ANIMATING');\n  stepMove();\n}\nfunction stepMove(){\n  const a=Player.anims[0];if(!a){return}\n  const p=State.players.find(x=>x.id===a.pid);\n  if(a.step>=a.steps){finishMove(p);return}\n  a.step++;a.from=p.position;a.to=Math.min(p.position+1,TILES.length-1);a.t=0;\n  p.position=a.to;\n  State.logEvent(p.name+' → tile '+(p.position+1));\n  emitter.emit(EVENT.STATE,State);\n  playSound('step');\n}\nfunction finishMove(p){\n  const t=TILES[p.position];\n  effects.spawnRing(t.x,t.y,p.color);\n  if(t.type==='finish'){\n    p.isFinished=true;p.turns++;\n    State.winner=p;State.setPhase('GAME_OVER');\n    State.saveHigh();\n    State.logEvent('🏆 '+p.name+' WINS!');\n    emitter.emit(EVENT.STATE,State);\n    setTimeout(()=>UI.showWinner(),600);\n    return;\n  }\n  if(t.type==='bonus'){\n    p.turns++;\n    State.logEvent('⚡ '+p.name+' gets bonus roll!');\n    effects.spawnBurst(t.x,t.y,'#4A90E2');\n    State.setPhase('ROLLING');\n    emitter.emit(EVENT.STATE,State);\n    return;\n  }\n  if(t.type==='penalty'){\n    p.turns++;p.skipNextTurn=true;\n    State.logEvent('⏸ '+p.name+' will skip next turn!');\n    effects.spawnBurst(t.x,t.y,'#E63946');\n    endTurn();return;\n  }\n  p.turns++;endTurn();\n}\nfunction endTurn(){\n  const cp=State.currentPlayer();cp.isActive=false;\n  State.currentPlayerIndex=(State.currentPlayerIndex+1)%State.players.length;\n  const np=State.currentPlayer();np.isActive=true;\n  State.setPhase('ROLLING');\n  emitter.emit(EVENT.STATE,State);\n}\n", "js/turn.js": "function init(){}\n", "js/ui.js": "const UI={\n  init(){\n    this.renderPlayers();\n    this.renderLog();\n    emitter.on(EVENT.STATE,()=>{this.renderPlayers();this.renderLog();this.updateTurn()});\n    document.getElementById('roll-btn').addEventListener('click',this.roll);\n    document.getElementById('play-again').addEventListener('click',this.playAgain);\n    document.getElementById('share-result').addEventListener('click',this.share);\n    document.getElementById('settings-btn').addEventListener('click',()=>{\n      if(confirm('Restart game?'))location.reload();\n    });\n    document.addEventListener('keydown',e=>{\n      if(e.code==='Space'&&State.phase==='ROLLING'&&!Dice.rolling){e.preventDefault();this.roll()}\n    });\n    this.buildSetup();\n  },\n  buildSetup(){\n    const sel=document.getElementById('num-players');\n    const wrap=document.getElementById('name-inputs');\n    const update=()=>{\n      const n=parseInt(sel.value,10);wrap.innerHTML='';\n      for(let i=0;i<n;i++){\n        const inp=document.createElement('input');\n        inp.value='Player '+(i+1);inp.placeholder='Player '+(i+1)+' name';\n        wrap.appendChild(inp);\n      }\n    };\n    sel.addEventListener('change',update);update();\n    document.getElementById('start-btn').addEventListener('click',()=>{\n      const n=parseInt(sel.value,10);\n      const names=Array.from(wrap.querySelectorAll('input')).map(i=>i.value||i.placeholder);\n      document.getElementById('setup-modal').style.display='none';\n      document.getElementById('log-panel').style.display='block';\n      State.init(n,names);\n    });\n  },\n  roll(){\n    if(State.phase!=='ROLLING'||Dice.rolling)return;\n    const v=1+Math.floor(Math.random()*6);\n    Dice.roll(v);State.currentRoll=v;\n    State.logEvent(State.currentPlayer().name+' rolled a '+v);\n    emitter.emit(EVENT.STATE,State);\n  },\n  renderPlayers(){\n    const c=State.currentPlayer();\n    const panel=document.getElementById('player-panel');\n    panel.innerHTML=State.players.map(p=>{\n      const active=p===c?'active':'';\n      const pct=((p.position)/(TILES.length-1))*100;\n      return `<div class=\"p-card ${active}\" style=\"--p:${p.color}\">\n        <div class=\"p-head\"><span class=\"dot\" style=\"background:${p.color};box-shadow:0 0 10px ${p.color}\"></span>${p.name}${p.isFinished?' 🏆':''}</div>\n        <div class=\"p-pos\">Tile ${p.position+1} / ${TILES.length} • Turn ${p.turns}${p.skipNextTurn?' • <span class=\"skip-badge\">SKIP</span>':''}</div>\n        <div class=\"p-bar\"><div class=\"fill\" style=\"width:${pct}%;background:${p.color}\"></div></div>\n      </div>`;\n    }).join('');\n  },\n  renderLog(){\n    document.getElementById('log').innerHTML=State.log.map(l=>`<li>${l.msg}</li>`).join('');\n  },\n  updateTurn(){\n    const c=State.currentPlayer();\n    const ind=document.getElementById('turn-indicator');\n    ind.querySelector('.dot').style.background=c.color;\n    ind.querySelector('.dot').style.color=c.color;\n    ind.querySelector('.name').textContent=c.name+(State.phase==='GAME_OVER'?' (Game Over)':'');
    const btn=document.getElementById('roll-btn');
    btn.disabled=State.phase!=='ROLLING'||Dice.rolling;
    btn.classList.toggle('pulse',State.phase==='ROLLING'&&!Dice.rolling);
  },
  tickTimer(){
    if(State.phase==='GAME_OVER')return;
    if(State.startTime&&State.phase!=='SETUP'){
      State.elapsed=Math.floor((Date.now()-State.startTime)/1000);
    }
    const m=String(Math.floor(State.elapsed/60)).padStart(2,'0');
    const s=String(State.elapsed%60).padStart(2,'0');
    document.getElementById('timer-val').textContent=m+':'+s;
  },
  showWinner(){
    const m=document.getElementById('modal');m.classList.remove('hidden');
    document.getElementById('winner-text').textContent='🏆 '+(State.winner?State.winner.name:'')+' Wins!';
    const sorted=[...State.players].sort((a,b)=>b.position-a.position||a.turns-b.turns);
    document.getElementById('standings').innerHTML=sorted.map(p=>
      `<li><span class=\"dot\" style=\"display:inline-block;width:12px;height:12px;border-radius:50%;background:${p.color}\"></span>${p.name} — Tile ${p.position+1}, ${p.turns} turns</li>`
    ).join('');
    startConfetti();
  },
  playAgain(){location.reload()},
  share(){
    const t=document.getElementById('timer-val').textContent;
    const txt=`🎲 Path & Roll — ${State.winner?State.winner.name:'Game'} in ${t}!`;
    if(navigator.share){navigator.share({title:'Path & Roll',text:txt}).catch(()=>{})}
    else{navigator.clipboard.writeText(txt);alert('Copied to clipboard!')}
  }
};
", "js/effects.js": "const effects={\n  rings:[],bursts:[],confetti:[],\n  spawnRing(x,y,color){\n    this.rings.push({x,y,color,r:10,maxR:80,alpha:1});\n  },\n  spawnBurst(x,y,color){\n    for(let i=0;i<18;i++){\n      const a=(i/18)*Math.PI*2,sp=1+Math.random()*3;\n      this.bursts.push({x,y,color,vx:Math.cos(a)*sp,vy:Math.sin(a)*sp,life:1});\n    }\n  },\n  startConfetti(){\n    const c=document.getElementById('confetti');if(!c)return;\n    const ctx=c.getContext('2d');c.width=c.offsetWidth;c.height=c.offsetHeight;\n    this.confetti=[];\n    for(let i=0;i<120;i++){\n      this.confetti.push({\n        x:Math.random()*c.width,y:-20-Math.random()*200,\n        vx:(Math.random()-.5)*2,vy:2+Math.random()*3,\n        w:6+Math.random()*6,h:8+Math.random()*8,\n        c:COLORS[Math.floor(Math.random()*COLORS.length)],\n        rot:Math.random()*360,vr:(Math.random()-.5)*10\n      });\n    }\n    const tick=()=>{\n      if(!this.confetti.length)return;\n      ctx.clearRect(0,0,c.width,c.height);\n      this.confetti.forEach(p=>{\n        p.x+=p.vx;p.y+=p.vy;p.rot+=p.vr;\n        ctx.save();ctx.translate(p.x,p.y);ctx.rotate(p.rot*Math.PI/180);\n        ctx.fillStyle=p.c;ctx.fillRect(-p.w/2,-p.h/2,p.w,p.h);\n        ctx.restore();\n      });\n      this.confetti=this.confetti.filter(p=>p.y<c.height+30);\n      requestAnimationFrame(tick);\n    };\n    tick();\n  },\n  update(){\n    this.rings=this.rings.filter(r=>{r.r+=2;r.alpha-=.02;return r.alpha>0});\n    this.bursts=this.bursts.filter(b=>{b.x+=b.vx;b.y+=b.vy;b.vy+=.1;b.life-=.03;return b.life>0});\n  },\n  draw(ctx,view){\n    this.rings.forEach(r=>{\n      ctx.save();\n      ctx.strokeStyle=`rgba(${hexToRgb(r.color)},${r.alpha})`;\n      ctx.lineWidth=3;ctx.beginPath();\n      const x=r.x*view.scale+view.offX,y=r.y*view.scale+view.offY;\n      ctx.arc(x,y,r.r*view.scale,0,Math.PI*2);ctx.stroke();\n      ctx.restore();\n    });\n    this.bursts.forEach(b=>{\n      ctx.save();\n      ctx.fillStyle=`rgba(${hexToRgb(b.color)},${b.life})`;\n      const x=b.x*view.scale+view.offX,y=b.y*view.scale+view.offY;\n      ctx.beginPath();ctx.arc(x,y,3*view.scale,0,Math.PI*2);ctx.fill();\n      ctx.restore();\n    });\n  }\n};\nfunction hexToRgb(h){h=h.replace('#','');const n=parseInt(h,16);return[(n>>16)&255,(n>>8)&255,n&255].join(',')}\n", "js/main.js": "let last=0;\nfunction loop(ts){\n  const dt=last?(ts-last):16;last=ts;\n  if(State.phase!=='SETUP'){\n    const c=document.getElementById('board');const ctx=c.getContext('2d');\n    const w=c.width,h=c.height;\n    ctx.clearRect(0,0,w,h);\n    const view=drawBoard(ctx,w,h,ts);\n    Player.drawAll(ctx,view,ts);\n    effects.draw(ctx,view);\n    // animate player movement\n    if(Player.anims.length){\n      const a=Player.anims[0];\n      a.t+=dt/400;if(a.t>=1){a.t=1;stepMove()}\n    }\n  }\n  Dice.update(dt);\n  const dc=document.getElementById('dice');if(dc){\n    const dctx=dc.getContext('2d');\n    dctx.clearRect(0,0,100,100);\n    Dice.ctx=dctx;Dice.draw();\n  }\n  effects.update();\n  UI.tickTimer();\n  requestAnimationFrame(loop);\n}\nfunction playSound(type){\n  try{\n    const ctx=window.__actx||(window.__actx=new (window.AudioContext||window.webkitAudioContext)());\n    const o=ctx.createOscillator(),g=ctx.createGain();\n    o.connect(g);g.connect(ctx.destination);\n    const now=ctx.currentTime;\n    if(type==='roll'){o.frequency.setValueAtTime(200,now);o.frequency.exponentialRampToValueAtTime(600,now+.2);g.gain.setValueAtTime(.1,now);g.gain.exponentialRampToValueAtTime(.001,now+.2)}\n    if(type==='step'){o.frequency.setValueAtTime(440,now);g.gain.setValueAtTime(.05,now);g.gain.exponentialRampToValueAtTime(.001,now+.08)}\n    o.start(now);o.stop(now+.3);\n  }catch(e){}\n}\nwindow.addEventListener('load',()=>{\n  buildPath();Dice.init(document.getElementById('dice').getContext('2d'));UI.init();\n  requestAnimationFrame(loop);\n});\n"}