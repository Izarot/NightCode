src/audio.js{
  "// Web Audio API Sound Effects"
  "class AudioManager {"
  "  constructor() {"
  "    this.audioContext = null;"
  "    this.isInitialized = false;"
  "  }"
  "  "
  "  init() {"
  "    try {"
  "      this.audioContext = new (window.AudioContext || window.webkitAudioContext)();"
  "      this.isInitialized = true;"
  "    } catch (e) {"
  "      console.warn('Web Audio API not available');"
  "    }"
  "  }"
  "  "
  "  playSound(type) {"
  "    if (!this.isInitialized) return;"
  "    "
  "    const oscillator = this.audioContext.createOscillator();"
  "    const gainNode = this.audioContext.createGain();"
  "    "
  "    oscillator.connect(gainNode);"
  "    gainNode.connect(this.audioContext.destination);"
  "    "
  "    gainNode.gain.setValueAtTime(0.3, this.audioContext.currentTime);"
  "    gainNode.gain.exponentialRampToValueAtTime(0.001, this.audioContext.currentTime + 0.2);"
  "    "
  "    switch (type) {"
  "      case 'correct':"
  "        oscillator.frequency.setValueAtTime(523.25, this.audioContext.currentTime); // C5"
  "        oscillator.type = 'sine';"
  "        break;"
  "      case 'wrong':"
  "        oscillator.frequency.setValueAtTime(146.83, this.audioContext.currentTime); // F3"
  "        oscillator.type = 'square';"
  "        break;"
  "      case 'start':"
  "        oscillator.frequency.setValueAtTime(329.63, this.audioContext.currentTime); // E5"
  "        oscillator.type = 'triangle';"
  "        break;"
  "    }"
  "    "
  "    oscillator.start();"
  "    oscillator.stop(this.audioContext.currentTime + 0.2);"
  "  }"
  "}"
  ""
  "export const audioManager = new AudioManager();"
}

src/score.js{
  "// High Score Management with LocalStorage"
  "class ScoreManager {"
  "  constructor() {"
  "    this.highScoreKey = 'reactionMasterHighScore';"
  "  }"
  "  "
  "  getHighScore() {"
  "    try {"
  "      const score = localStorage.getItem(this.highScoreKey);"
  "      return score ? parseInt(score, 10) : 0;"
  "    } catch (e) {"
  "      console.warn('Could not read high score from localStorage');"
  "      return 0;"
  "    }"
  "  }"
  "  "
  "  saveHighScore(score) {"
  "    try {"
  "      localStorage.setItem(this.highScoreKey, score.toString());"
  "    } catch (e) {"
  "      console.warn('Could not save high score to localStorage');"
  "    }"
  "  }"
  "  "
  "  updateHighScore(newScore) {"
  "    const currentHigh = this.getHighScore();"
  "    if (newScore > currentHigh) {"
  "      this.saveHighScore(newScore);"
  "      return newScore;"
  "    }"
  "    return currentHigh;"
  "  }"
  "}"
  ""
  "export const scoreManager = new ScoreManager();"
}

src/ui.js{
  "// UI Rendering Functions"
  "export class UIManager {"
  "  constructor(canvas, ctx) {"
  "    this.canvas = canvas;"
  "    this.ctx = ctx;"
  "    this.radius = 150;"
  "  }"
  "  "
  "  drawCircle(state) {"
  "    const centerX = this.canvas.width / 2;"
  "    const centerY = this.canvas.height / 2;"
  "    "
  "    this.ctx.clearRect(0, 0, this.canvas.width, this.canvas.height);"
  "    "
  "    // Draw gradient circle"
  "    const gradient = this.ctx.createRadialGradient("
  "      centerX, centerY, 0,"
  "      centerX, centerY, this.radius"
  "    );"
  "    "
  "    switch (state) {"
  "      case 'waiting':"
  "        gradient.addColorStop(0, '#4299e1');"
  "        gradient.addColorStop(1, '#2c5282');"
  "        break;"
  "      case 'ready':"
  "        gradient.addColorStop(0, '#48bb78');"
  "        gradient.addColorStop(1, '#276749');"
  "        break;"
  "      case 'danger':"
  "        gradient.addColorStop(0, '#f56565');"
  "        gradient.addColorStop(1, '#c53030');"
  "        break;"
  "    }"
  "    "
  "    this.ctx.fillStyle = gradient;"
  "    this.ctx.beginPath();"
  "    this.ctx.arc(centerX, centerY, this.radius, 0, Math.PI * 2);"
  "    this.ctx.fill();"
  "    "
  "    // Add glow effect"
  "    this.ctx.shadowBlur = 30;"
  "    this.ctx.shadowColor = gradient;"
  "    this.ctx.beginPath();"
  "    this.ctx.arc(centerX, centerY, this.radius * 0.7, 0, Math.PI * 2);"
  "    this.ctx.fill();"
  "    this.ctx.shadowBlur = 0;"
  "  }"
  "  "
  "  drawText(text, size, color, x, y) {"
  "    this.ctx.fillStyle = color;"
  "    this.ctx.font = `${size}px 'Segoe UI', sans-serif`;"
  "    this.ctx.textAlign = 'center';"
  "    this.ctx.fillText(text, x, y);"
  "  }"
  "  "
  "  resizeCanvas() {"
  "    const container = this.canvas.parentElement;"
  "    const size = Math.min(container.clientWidth, container.clientHeight);"
  "    this.canvas.width = size;"
  "    this.canvas.height = size;"
  "    this.radius = size * 0.35;"
  "  }"
  "}"
}

src/game.js{
  "// Main Game Logic"
  "import { SETTINGS } from '../config/settings.js';"
  "import { audioManager } from './audio.js';"
  "import { scoreManager } from './score.js';"
  "import { UIManager } from './ui.js';"
  ""
  "export class Game {"
  "  constructor() {"
  "    this.canvas = null;"
  "    this.ctx = null;"
  "    this.uiManager = null;"
  "    this.state = 'waiting';"
  "    this.score = 0;"
  "    this.highScore = 0;"
  "    this.startTime = 0;"
  "    this.currentRoundTime = 0;"
  "    this.timerInterval = null;"
  "    this.gameActive = false;"
  "  }"
  "  "
  "  init() {"
  "    this.canvas = document.getElementById('gameCanvas');"
  "    this.ctx = this.canvas.getContext('2d');"
  "    this.uiManager = new UIManager(this.canvas, this.ctx);"
  "    "
  "    // Initialize audio"
  "    audioManager.init();"
  "    "
  "    // Load high score"
  "    this.highScore = scoreManager.getHighScore();"
  "    this.updateHighScoreDisplay();"
  "    "
  "    // Setup responsive canvas"
  "    this.setupResponsiveCanvas();"
  "    "
  "    // Setup click handler"
  "    this.canvas.addEventListener('click', () => this.handleClick());"
  "    "
  "    // Start game"
  "    this.startRound();"
  "  }"
  "  "
  "  setupResponsiveCanvas() {"
  "    this.uiManager.resizeCanvas();"
  "    window.addEventListener('resize', () => this.uiManager.resizeCanvas());"
  "  }"
  "  "
  "  startRound() {"
  "    this.state = 'waiting';"
  "    this.gameActive = true;"
  "    this.uiManager.drawCircle('waiting');"
  "    "
  "    audioManager.playSound('start');"
  "    "
  "    // Random wait time"
  "    const waitTime = Math.random() * (SETTINGS.maxWait - SETTINGS.minWait) + SETTINGS.minWait;"
  "    "
  "    setTimeout(() => {"
  "      if (this.gameActive) {"
  "        this.state = 'ready';"
  "        this.startTime = performance.now();"
  "        this.startTimer();"
  "        this.uiManager.drawCircle('ready');"
  "        "
  "        setTimeout(() => {"
  "          if (this.state === 'ready') {"
  "            this.state = 'danger';"
  "            this.uiManager.drawCircle('danger');"
  "            audioManager.playSound('wrong');"
  "          }"
  "        }, SETTINGS.readyDuration);"
  "      }"
  "    }, waitTime);"
  "  }"
  "  "
  "  startTimer() {"
  "    this.timerInterval = setInterval(() => {"
  "      const elapsed = (performance.now() - this.startTime) / 1000;"
  "      document.getElementById('timer').textContent = elapsed.toFixed(2);"
  "    }, 100);"
  "  }"
  "  "
  "  stopTimer() {"
  "    if (this.timerInterval) {"
  "      clearInterval(this.timerInterval);"
  "      this.timerInterval = null;"
  "    }"
  "    document.getElementById('timer').textContent = '0.00';"
  "  }"
  "  "
  "  handleClick() {"
  "    if (!this.gameActive) return;"
  "    "
  "    if (this.state === 'ready') {"
  "      const reactionTime = (performance.now() - this.startTime) / 1000;"
  "      const points = SETTINGS.correctClick - Math.round(reactionTime * 10);"
  "      this.score += points;"
  "      "
  "      audioManager.playSound('correct');"
  "      this.showMessage('Correct! ' + reactionTime.toFixed(3) + 's', '#48bb78');"
  "      "
  "      this.highScore = scoreManager.updateHighScore(this.score);"
  "      this.updateHighScoreDisplay();"
  "      "
  "      setTimeout(() => this.startRound(), 1000);"
  "    } else if (this.state === 'waiting') {"
  "      this.score += SETTINGS.wrongClick;"
  "      audioManager.playSound('wrong');"
  "      this.showMessage('Too early!', '#f56565');"
  "      "
  "      setTimeout(() => this.startRound(), 1500);"
  "    } else if (this.state === 'danger') {"
  "      this.score += SETTINGS.wrongClick;"
  "      audioManager.playSound('wrong');"
  "      this.showMessage('Too slow!', '#f56565');"
  "      "
  "      setTimeout(() => this.startRound(), 1500);"
  "    }"
  "  }"
  "  "
  "  showMessage(text, color) {"
  "    const messageEl = document.getElementById('message');"
  "    messageEl.textContent = text;"
  "    messageEl.style.color = color;"
  "    messageEl.style.textShadow = '0 0 20px ' + color + '80';"
  "  }"
  "  "
  "  updateHighScoreDisplay() {"
  "    document.getElementById('highscore').textContent = this.highScore;"
  "  }"
  "}"
}

