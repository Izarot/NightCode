  "index.html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, user-scalable=no\">\n  <title>Centipede Reimagined</title>\n  <link rel=\"icon\" href=\"data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🐛</text></svg>\">\n  <link rel=\"stylesheet\" href=\"styles.css\">\n</head>\n<body>\n  <div id=\"game-container\">\n    <canvas id=\"game-canvas\"></canvas>\n    <div id=\"ui-overlay\"></div>\n  </div>\n  <script src=\"config.json\"></script>\n  <script src=\"src/utils/assetLoader.js\"></script>\n  <script src=\"src/utils/collision.js\"></script>\n  <script src=\"src/utils/input.js\"></script>\n  <script src=\"src/audio.js\"></script>\n  <script src=\"src/persistence.js\"></script>\n  <script src=\"src/entities/cannon.js\"></script>\n  <script src=\"src/entities/projectile.js\"></script>\n  <script src=\"src/entities/centipede.js\"></script>\n  <script src=\"src/entities/particle.js\"></script>\n  <script src=\"src/ui/hud.js\"></script>\n  <script src=\"src/ui/gameover.js\"></script>\n  <script src=\"src/game.js\"></script>\n</body>\n</html>",
  "styles.css": "* { margin: 0; padding: 0; box-sizing: border-box; }\nbody { background: #0a0a0a; overflow: hidden; font-family: 'Segoe UI', sans-serif; }\n#game-container { position: relative; width: 100vw; height: 100vh; display: flex; justify-content: center; align-items: center; }\n#game-canvas { display: block; max-width: 100%; max-height: 100%; image-rendering: pixelated; }\n#ui-overlay { position: absolute; top: 0; left: 0; width: 100%; height: 100%; pointer-events: none; }\n.hud { position: absolute; color: #fff; text-shadow: 2px 2px 4px #000; pointer-events: auto; font-size: 1.2rem; }\n#score { top: 1rem; left: 1rem; }\n#lives { top: 1rem; right: 1rem; display: flex; gap: 0.5rem; }\n#timer { top: 1rem; left: 50%; transform: translateX(-50%); font-family: monospace; font-size: 1.5rem; }\n#speed-meter { top: 4rem; left: 50%; transform: translateX(-50%); width: 200px; height: 8px; background: #333; border-radius: 4px; overflow: hidden; }\n#speed-meter-fill { height: 100%; background: linear-gradient(90deg, #00ff88, #00ccff); width: 0%; transition: width 0.3s; }\n#pause-btn { top: 1rem; left: 50%; transform: translateX(-50%) translateY(-100%); background: rgba(0,0,0,0.7); border: none; color: #fff; padding: 0.5rem 1rem; border-radius: 4px; cursor: pointer; }\n.modal { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.85); display: flex; flex-direction: column; justify-content: center; align-items: center; gap: 1rem; z-index: 100; opacity: 0; visibility: hidden; transition: all 0.3s; }\n.modal.visible { opacity: 1; visibility: visible; }\n.modal h1 { font-size: 3rem; color: #ff3366; text-shadow: 0 0 20px #ff3366; }\n.modal p { font-size: 1.5rem; color: #fff; }\n.modal button { background: linear-gradient(135deg, #00ff88, #00ccff); border: none; color: #000; padding: 1rem 2rem; font-size: 1.2rem; border-radius: 8px; cursor: pointer; font-weight: bold; transition: transform 0.1s; }\n.modal button:active { transform: scale(0.95); }\n.heart { width: 30px; height: 30px; background: url('data:image/svg+xml,<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\"><path fill=\"%23ff3366\" d=\"M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z\"/></svg>') center/contain no-repeat; }\n.heart.lost { animation: pulse 0.5s 3; }\n@keyframes pulse { 0%,100% { transform: scale(1); } 50% { transform: scale(1.3); } }\n@media (max-width: 600px) { .hud { font-size: 0.9rem; } #speed-meter { width: 150px; } .heart { width: 24px; height: 24px; } }",
  "config.json": "{\n  \"canvasWidth\": 800,\n  \"canvasHeight\": 600,\n  \"cannon\": { \"width\": 60, \"height\": 20, \"speed\": 600, \"accelTime\": 0.2, \"fireCooldown\": 0.5 },\n  \"projectile\": { \"width\": 6, \"height\": 6, \"speed\": 400, \"lifetime\": 2.5 },\n  \"centipede\": { \"segmentWidth\": 30, \"segmentHeight\": 10, \"initialSegments\": 10, \"baseSpeed\": 120, \"amplitude\": 30, \"frequency\": 0.02, \"speedIncreaseInterval\": 30, \"speedIncreaseFactor\": 1.05, \"regenDelay\": 2 },\n  \"colors\": { \"bgTop\": \"#0a0a0a\", \"bgBottom\": \"#001122\", \"cannonGrad\": [\"#1a1a2e\", \"#16213e\"], \"projectile\": \"#00ffff\", \"head\": \"#ff3366\", \"body\": \"#00ff88\", \"dead\": \"#333333\", \"particle\": [\"#ff3366\", \"#00ff88\", \"#00ccff\", \"#ffff00\"] },\n  \"ui\": { \"font\": \"24px 'Segoe UI', sans-serif\", \"scoreColor\": \"#ffffff\", \"timerColor\": \"#00ffff\" }\n}",
  "src/game.js": "import { AssetLoader } from './utils/assetLoader.js';\nimport { InputHandler } from './utils/input.js';\nimport { CollisionManager } from './utils/collision.js';\nimport { AudioManager } from './audio.js';\nimport { Persistence } from './persistence.js';\nimport { Cannon } from './entities/cannon.js';\nimport { ProjectileManager } from './entities/projectile.js';\nimport { Centipede } from './entities/centipede.js';\nimport { ParticleManager } from './entities/particle.js';\nimport { HUD } from './ui/hud.js';\nimport { GameOverScreen } from './ui/gameover.js';\nimport CONFIG from '../config.json';\n\nclass Game {\n  constructor() {\n    this.canvas = document.getElementById('game-canvas');\n    this.ctx = this.canvas.getContext('2d');\n    this.uiOverlay = document.getElementById('ui-overlay');\n    this.config = CONFIG;\n    this.running = false;\n    this.paused = false;\n    this.lastTime = 0;\n    this.accumulator = 0;\n    this.fixedTimeStep = 1/60; // 60Hz physics\n    this.screenShake = { intensity: 0, duration: 0 };\n    this.speedrunStart = 0;\n    this.speedrunTime = 0;\n    \n    this.assetLoader = new AssetLoader();\n    this.input = new InputHandler(this.canvas);\n    this.collision = new CollisionManager(this.config.canvasWidth, this.config.canvasHeight);\n    this.audio = new AudioManager();\n    this.persistence = new Persistence();\n    \n    this.cannon = null;\n    this.projectiles = null;\n    this.centipede = null;\n    this.particles = null;\n    this.hud = null;\n    this.gameOverScreen = null;\n    \n    this.init();\n  }\n  \n  async init() {\n    await this.assetLoader.loadAll();\n    this.resize();\n    window.addEventListener('resize', () => this.resize());\n    \n    this.cannon = new Cannon(this.config);\n    this.projectiles = new ProjectileManager(this.config);\n    this.centipede = new Centipede(this.config);\n    this.particles = new ParticleManager(this.config);\n    this.hud = new HUD(this.uiOverlay, this.config, this.persistence);\n    this.gameOverScreen = new GameOverScreen(this.uiOverlay, () => this.restart());\n    \n    this.input.on('move', (x) => this.cannon.setTargetX(x));\n    this.input.on('fire', () => this.tryFire());\n    this.input.on('pause', () => this.togglePause());\n    \n    this.hud.setHighScore(this.persistence.getHighScore());\n    this.running = true;\n    this.speedrunStart = performance.now();\n    requestAnimationFrame((t) => this.gameLoop(t));\n  }\n  \n  resize() {\n    const container = document.getElementById('game-container');\n    const scale = Math.min(\n      container.clientWidth / this.config.canvasWidth,\n      container.clientHeight / this.config.canvasHeight\n    );\n    this.canvas.width = this.config.canvasWidth * window.devicePixelRatio;\n    this.canvas.height = this.config.canvasHeight * window.devicePixelRatio;\n    this.canvas.style.width = `${this.config.canvasWidth * scale}px`;\n    this.canvas.style.height = `${this.config.canvasHeight * scale}px`;\n    this.ctx.setTransform(window.devicePixelRatio, 0, 0, window.devicePixelRatio, 0, 0);\n  }\n  \n  tryFire() {\n    if (this.paused || this.gameOverScreen.visible) return;\n    const proj = this.cannon.fire();\n    if (proj) {\n      this.projectiles.add(proj);\n      this.audio.play('shoot');\n    }\n  }\n  \n  togglePause() {\n    if (this.gameOverScreen.visible) return;\n    this.paused = !this.paused;\n    this.hud.setPaused(this.paused);\n    if (!this.paused) {\n      this.lastTime = performance.now();\n      requestAnimationFrame((t) => this.gameLoop(t));\n    }\n  }\n  \n  gameLoop(time) {\n    if (!this.running) return;\n    if (this.paused) return;\n    \n    const delta = (time - this.lastTime) / 1000;\n    this.lastTime = time;\n    this.accumulator += delta;\n    \n    // Speedrun timer\n    this.speedrunTime = (time - this.speedrunStart) / 1000;\n    \n    // Fixed step physics\n    while (this.accumulator >= this.fixedTimeStep) {\n      this.updatePhysics(this.fixedTimeStep);\n      this.accumulator -= this.fixedTimeStep;\n    }\n    \n    this.render(delta);\n    requestAnimationFrame((t) => this.gameLoop(t));\n  }\n  \n  updatePhysics(dt) {\n    this.cannon.update(dt);\n    this.projectiles.update(dt);\n    this.centipede.update(dt);\n    this.particles.update(dt);\n    \n    // Collision: projectiles vs centipede segments\n    const hits = this.collision.checkProjectileCentipede(this.projectiles.getAll(), this.centipede.getSegments());\n    hits.forEach(({ projectile, segment, segmentIndex }) => {\n      this.projectiles.remove(projectile);\n      const points = this.centipede.hitSegment(segmentIndex);\n      this.hud.addScore(points);\n      this.particles.burst(segment.x + segment.width/2, segment.y + segment.height/2, this.config.colors.particle);\n      this.audio.play('hit');\n      if (points >= 50) { // head kill\n        this.screenShake = { intensity: 2, duration: 0.05 };\n        this.audio.play('headkill');\n      }\n    });\n    \n    // Check centipede reaching bottom\n    if (this.centipede.reachedBottom()) {\n      this.gameOver();\n    }\n    \n    // Screen shake decay\n    if (this.screenShake.duration > 0) {\n      this.screenShake.duration -= dt;\n      if (this.screenShake.duration <= 0) this.screenShake.intensity = 0;\n    }\n  }\n  \n  render(dt) {\n    const ctx = this.ctx;\n    const w = this.config.canvasWidth;\n    const h = this.config.canvasHeight;\n    \n    // Screen shake offset\n    let shakeX = 0, shakeY = 0;\n    if (this.screenShake.intensity > 0) {\n      shakeX = (Math.random() - 0.5) * this.screenShake.intensity;\n      shakeY = (Math.random() - 0.5) * this.screenShake.intensity;\n    }\n    ctx.save();\n    ctx.translate(shakeX, shakeY);\n    \n    // Background gradient\n    const grad = ctx.createLinearGradient(0, 0, 0, h);\n    grad.addColorStop(0, this.config.colors.bgTop);\n    grad.addColorStop(1, this.config.colors.bgBottom);\n    ctx.fillStyle = grad;\n    ctx.fillRect(0, 0, w, h);\n    \n    // Starfield (simple)\n    ctx.fillStyle = 'rgba(255,255,255,0.3)';\n    for (let i = 0; i < 50; i++) {\n      const x = (i * 127 + time * 0.5) % w;\n      const y = (i * 311 + time * 0.2) % h;\n      ctx.fillRect(x, y, 1, 1);\n    }\n    \n    this.centipede.render(ctx);\n    this.projectiles.render(ctx);\n    this.particles.render(ctx);\n    this.cannon.render(ctx);\n    \n    ctx.restore();\n    \n    // HUD updates\n    this.hud.updateLives(this.cannon.lives);\n    this.hud.updateTimer(this.speedrunTime);\n    this.hud.updateSpeedMeter(this.centipede.getSpeedMultiplier());\n  }\n  \n  gameOver() {\n    this.running = false;\n    this.audio.play('gameover');\n    const finalScore = this.hud.getScore();\n    this.persistence.saveHighScore(finalScore);\n    this.gameOverScreen.show(finalScore, this.persistence.getHighScore());\n  }\n  \n  restart() {\n    this.cannon.reset();\n    this.projectiles.clear();\n    this.centipede.reset();\n    this.particles.clear();\n    this.hud.reset();\n    this.gameOverScreen.hide();\n    this.running = true;\n    this.paused = false;\n    this.speedrunStart = performance.now();\n    this.lastTime = performance.now();\n    this.accumulator = 0;\n    requestAnimationFrame((t) => this.gameLoop(t));\n  }\n}\n\n// Start game when DOM ready\ndocument.addEventListener('DOMContentLoaded', () => {\n  window.game = new Game();\n});",
  "src/entities/cannon.js": "export class Cannon {\n  constructor(config) {\n    this.config = config;\n    this.width = config.cannon.width;\n    this.height = config.cannon.height;\n    this.x = (config.canvasWidth - this.width) / 2;\n    this.targetX = this.x;\n    this.y = config.canvasHeight - this.height - 10;\n    this.speed = config.cannon.speed;\n    this.accelTime = config.cannon.accelTime;\n    this.currentSpeed = 0;\n    this.fireCooldown = config.cannon.fireCooldown;\n    this.lastFire = -this.fireCooldown;\n    this.lives = 3;\n    this.maxLives = 3;\n  }\n  \n  setTargetX(x) {\n    // Clamp to canvas\n    this.targetX = Math.max(0, Math.min(this.config.canvasWidth - this.width, x - this.width/2));\n  }\n  \n  update(dt) {\n    // Smooth movement with acceleration/deceleration\n    const dx = this.targetX - this.x;\n    const direction = Math.sign(dx);\n    const targetSpeed = Math.abs(dx) > 1 ? this.speed : 0;\n    \n    // Accelerate/decelerate\n    const accel = this.speed / this.accelTime;\n    if (targetSpeed > this.currentSpeed) {\n      this.currentSpeed = Math.min(targetSpeed, this.currentSpeed + accel * dt);\n    } else {\n      this.currentSpeed = Math.max(targetSpeed, this.currentSpeed - accel * dt);\n    }\n    \n    this.x += direction * this.currentSpeed * dt;\n    \n    // Clamp\n    this.x = Math.max(0, Math.min(this.config.canvasWidth - this.width, this.x));\n    \n    // Snap to target if very close\n    if (Math.abs(this.targetX - this.x) < 0.5) this.x = this.targetX;\n  }\n  \n  fire() {\n    const now = performance.now() / 1000;\n    if (now - this.lastFire >= this.fireCooldown) {\n      this.lastFire = now;\n      return {\n        x: this.x + this.width/2 - this.config.projectile.width/2,\n        y: this.y,\n        width: this.config.projectile.width,\n        height: this.config.projectile.height,\n        speed: this.config.projectile.speed,\n        lifetime: this.config.projectile.lifetime,\n        age: 0\n      };\n    }\n    return null;\n  }\n  \n  render(ctx) {\n    const grad = ctx.createLinearGradient(this.x, this.y, this.x, this.y + this.height);\n    grad.addColorStop(0, this.config.colors.cannonGrad[0]);\n    grad.addColorStop(1, this.config.colors.cannonGrad[1]);\n    ctx.fillStyle = grad;\n    ctx.beginPath();\n    const r = 8;\n    ctx.roundRect(this.x, this.y, this.width, this.height, r);\n    ctx.fill();\n    \n    // Barrel flash (if just fired)\n    const now = performance.now() / 1000;\n    if (now - this.lastFire < 0.05) {\n      ctx.fillStyle = 'rgba(0,255,255,0.8)';\n      ctx.beginPath();\n      ctx.arc(this.x + this.width/2, this.y, 8, 0, Math.PI*2);\n      ctx.fill();\n    }\n  }\n  \n  reset() {\n    this.x = (this.config.canvasWidth - this.width) / 2;\n    this.targetX = this.x;\n    this.currentSpeed = 0;\n    this.lives = this.maxLives;\n    this.lastFire = -this.fireCooldown;\n  }\n\n  getAABB() {\n    return { x: this.x, y: this.y, width: this.width, height: this.height };\n  }\n}",
  "src/entities/projectile.js": "export class ProjectileManager {\n  constructor(config) {\n    this.config = config;\n    this.projectiles = [];\n    this.pool = [];\n  }\n  \n  add(proj) {\n    this.projectiles.push({ ...proj, active: true });\n  }\n  \n  remove(proj) {\n    proj.active = false;\n  }\n  \n  clear() {\n    this.projectiles = [];\n  }\n  \n  getAll() {\n    return this.projectiles.filter(p => p.active);\n  }\n  \n  update(dt) {\n    for (const p of this.projectiles) {\n      if (!p.active) continue;\n      p.y -= p.speed * dt;\n      p.age += dt;\n      if (p.age >= p.lifetime || p.y + p.height < 0) {\n        p.active = false;\n      }\n    }\n    // Clean up\n    this.projectiles = this.projectiles.filter(p => p.active);\n  }\n  \n  render(ctx) {\n    ctx.fillStyle = this.config.colors.projectile;\n    for (const p of this.projectiles) {\n      if (!p.active) continue;\n      // Motion blur trail\n      for (let i = 0; i < 3; i++) {\n        const alpha = 0.3 - i * 0.1;\n        const trailY = p.y + i * 4;\n        ctx.globalAlpha = alpha;\n        ctx.beginPath();\n        ctx.arc(p.x + p.width/2, trailY + p.height/2, p.width/2, 0, Math.PI*2);\n        ctx.fill();\n      }\n      ctx.globalAlpha = 1;\n      ctx.beginPath();\n      ctx.arc(p.x + p.width/2, p.y + p.height/2, p.width/2, 0, Math.PI*2);\n      ctx.fill();\n    }\n  }\n}",
  "src/entities/centipede.js": "export class Centipede {\n  constructor(config) {\n    this.config = config;\n    this.segments = [];\n    this.phase = 0;\n    this.speed = config.centipede.baseSpeed;\n    this.speedMultiplier = 1;\n    this.lastSpeedIncrease = 0;\n    this.direction = 1; // 1 right, -1 left\n    this.initSegments();\n  }\n  \n  initSegments() {\n    this.segments = [];\n    const startX = this.config.canvasWidth / 2;\n    const startY = -this.config.centipede.segmentHeight * this.config.centipede.initialSegments;\n    for (let i = 0; i < this.config.centipede.initialSegments; i++) {\n      this.segments.push({\n        x: startX,\n        y: startY + i * this.config.centipede.segmentHeight,\n        width: this.config.centipede.segmentWidth,\n        height: this.config.centipede.segmentHeight,\n        isHead: i === 0,\n        dead: false,\n        regenTimer: 0,\n        index: i\n      });\n    }\n  }\n  \n  update(dt) {\n    this.phase += dt * 2;\n    \n    // Speed increase over time\n    const now = performance.now() / 1000;\n    if (now - this.lastSpeedIncrease >= this.config.centipede.speedIncreaseInterval) {\n      this.speedMultiplier *= this.config.centipede.speedIncreaseFactor;\n      this.lastSpeedIncrease = now;\n    }\n    \n    const currentSpeed = this.speed * this.speedMultiplier;\n    \n    for (let i = 0; i < this.segments.length; i++) {\n      const seg = this.segments[i];\n      if (seg.dead) {\n        seg.regenTimer -= dt;\n        if (seg.regenTimer <= 0) {\n          this.regenerateSegment(i);\n        }\n        continue;\n      }\n      \n      // Vertical movement\n      seg.y += currentSpeed * dt;\n      \n      // Horizontal wiggle\n      const offset = this.config.centipede.amplitude * Math.sin(this.phase + seg.index * this.config.centipede.frequency);\n      seg.x = this.config.canvasWidth/2 + offset * this.direction;\n      \n      // Bounce off walls\n      if (seg.x <= 0 || seg.x + seg.width >= this.config.canvasWidth) {\n        this.direction *= -1;\n        // Move all segments down a bit when bouncing\n        for (const s of this.segments) {\n          if (!s.dead) s.y += 10;\n        }\n        break;\n      }\n    }\n    \n    // Remove dead segments that are offscreen or expired\n    this.segments = this.segments.filter(seg => !seg.dead || seg.regenTimer > 0);\n    \n    // Re-index\n    this.segments.forEach((seg, i) => seg.index = i);\n  }\n  \n  hitSegment(index) {\n    if (index < 0 || index >= this.segments.length) return 0;\n    const seg = this.segments[index];\n    if (seg.dead) return 0;\n    \n    seg.dead = true;\n    seg.regenTimer = this.config.centipede.regenDelay;\n    \n    // If head is hit, spawn new head at previous segment (if exists)\n    if (seg.isHead) {\n      // Find next alive segment to become head\n      for (let i = index + 1; i < this.segments.length; i++) {\n        if (!this.segments[i].dead) {\n          this.segments[i].isHead = true;\n          this.direction *= -1; // Reverse direction\n          return 50; // Head kill bonus\n        }\n      }\n      // No alive segments left -> centipede destroyed\n      return 50;\n    }\n    \n    return 10; // Body segment\n  }\n  \n  regenerateSegment(index) {\n    // Append new segment at tail\n    const tail = this.segments[this.segments.length - 1];\n    if (!tail) return;\n    this.segments.push({\n      x: tail.x,\n      y: tail.y + this.config.centipede.segmentHeight,\n      width: this.config.centipede.segmentWidth,\n      height: this.config.centipede.segmentHeight,\n      isHead: false,\n      dead: false,\n      regenTimer: 0,\n      index: this.segments.length\n    });\n  }\n  \n  reachedBottom() {\n    return this.segments.some(seg => !seg.dead && seg.y + seg.height >= this.config.canvasHeight - 10);\n  }\n  \n  getSegments() {\n    return this.segments.filter(seg => !seg.dead);\n  }\n  \n  getSpeedMultiplier() {\n    return this.speedMultiplier;\n  }\n  \n  render(ctx) {\n    for (const seg of this.segments) {\n      if (seg.dead) {\n        // Flicker effect\n        if (Math.floor(performance.now() / 100) % 2 === 0) continue;\n        ctx.fillStyle = this.config.colors.dead;\n      } else if (seg.isHead) {\n        ctx.fillStyle = this.config.colors.head;\n      } else {\n        ctx.fillStyle = this.config.colors.body;\n      }\n      \n      ctx.beginPath();\n      ctx.roundRect(seg.x, seg.y, seg.width, seg.height, 4);\n      ctx.fill();\n      \n      // Head eyes\n      if (seg.isHead && !seg.dead) {\n        ctx.fillStyle = '#fff';\n        ctx.beginPath();\n        ctx.arc(seg.x + 6, seg.y + 4, 2, 0, Math.PI*2);\n        ctx.arc(seg.x + seg.width - 6, seg.y + 4, 2, 0, Math.PI*2);\n        ctx.fill();\n      }\n      \n      // Body pattern\n      if (!seg.isHead && !seg.dead) {\n        ctx.fillStyle = 'rgba(0,0,0,0.1)';\n        ctx.fillRect(seg.x + 2, seg.y + 2, seg.width - 4, seg.height - 4);\n      }\n    }\n  }\n  \n  reset() {\n    this.phase = 0;\n    this.speedMultiplier = 1;\n    this.lastSpeedIncrease = performance.now() / 1000;\n    this.direction = 1;\n    this.initSegments();\n  }\n}",
  "src/entities/particle.js": "export class ParticleManager {\n  constructor(config) {\n    this.config = config;\n    this.particles = [];\n  }\n  \n  burst(x, y, colors) {\n    for (let iconstructor(config) {\n    this.config = config;\n    this.particles = [];\n  }\n  \n  burst(x, y, colors) {\n    for (let i = 0; i < 12; i++) {\n      const angle = (Math.PI * 2 / 12) * i + Math.random() * 0.5;\n      const speed = 50 + Math.random() * 100;\n      this.particles.push({\n        x,\n        y,\n        vx: Math.cos(angle) * speed,\n        vy: Math.sin(angle) * speed,\n        radius: 2 + Math.random() * 3,\n        color: colors[Math.floor(Math.random() * colors.length)],\n        life: 0.5 + Math.random() * 0.5,\n        age: 0\n      });\n    }\n  }\n  \n  clear() {\n    this.particles = [];\n  }\n  \n  update(dt) {\n    for (const p of this.particles) {\n      p.x += p.vx * dt;\n      p.y += p.vy * dt;\n      p.vy += 200 * dt; // gravity\n      p.age += dt;\n    }\n    this.particles = this.particles.filter(p => p.age < p.life);\n  }\n  \n  render(ctx) {\n    for (const p of this.particles) {\n      const alpha = 1 - p.age / p.life;\n      ctx.globalAlpha = alpha;\n      ctx.fillStyle = p.color;\n      ctx.beginPath();\n      ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);\n      ctx.fill();\n    }\n    ctx.globalAlpha = 1;\n  }\n}",
  "src/utils/assetLoader.js": "export class AssetLoader {\n  constructor() {\n    this.assets = {};\n  }\n  \n  async loadAll() {\n    // No external assets needed - all graphics are procedural\n    // This is a placeholder for future asset loading\n    return Promise.resolve();\n  }\n  \n  get(key) {\n    return this.assets[key];\n  }\n}",
  "src/utils/collision.js": "export class CollisionManager {\n  constructor(canvasWidth, canvasHeight) {\n    this.canvasWidth = canvasWidth;\n    this.canvasHeight = canvasHeight;\n  }\n  \n  checkAABB(a, b) {\n    return a.x < b.x + b.width &&\n           a.x + a.width > b.x &&\n           a.y < b.y + b.height &&\n           a.y + a.height > b.y;\n  }\n  \n  checkProjectileCentipede(projectiles, segments) {\n    const hits = [];\n    for (const proj of projectiles) {\n      for (let i = 0; i < segments.length; i++) {\n        const seg = segments[i];\n        if (this.checkAABB(proj, seg)) {\n          hits.push({ projectile: proj, segment: seg, segmentIndex: i });\n          break; // One projectile hits one segment\n        }\n      }\n    }\n    return hits;\n  }\n}",
  "src/utils/input.js": "export class InputHandler {\n  constructor(canvas) {\n    this.canvas = canvas;\n    this.listeners = {};\n    this.keys = {};\n    this.touchX = null;\n    \n    window.addEventListener('keydown', (e) => this.onKeyDown(e));\n    window.addEventListener('keyup', (e) => this.onKeyUp(e));\n    canvas.addEventListener('mousemove', (e) => this.onMouseMove(e));\n    canvas.addEventListener('click', (e) => this.onClick(e));\n    canvas.addEventListener('touchstart', (e) => this.onTouch(e), { passive: false });\n    canvas.addEventListener('touchmove', (e) => this.onTouch(e), { passive: false });\n    canvas.addEventListener('touchend', (e) => this.onTouchEnd(e));\n  }\n  \n  on(event, callback) {\n    if (!this.listeners[event]) this.listeners[event] = [];\n    this.listeners[event].push(callback);\n  }\n  \n  emit(event, data) {\n    if (this.listeners[event]) {\n      this.listeners[event].forEach(cb => cb(data));\n    }\n  }\n  \n  onKeyDown(e) {\n    this.keys[e.code] = true;\n    if (e.code === 'Space') {\n      e.preventDefault();\n      this.emit('fire');\n    } else if (e.code === 'Escape' || e.code === 'KeyP') {\n      this.emit('pause');\n    }\n  }\n  \n  onKeyUp(e) {\n    this.keys[e.code] = false;\n  }\n  \n  onMouseMove(e) {\n    const rect = this.canvas.getBoundingClientRect();\n    const x = e.clientX - rect.left;\n    this.emit('move', x);\n  }\n  \n  onClick(e) {\n    this.emit('fire');\n  }\n  \n  onTouch(e) {\n    e.preventDefault();\n    const rect = this.canvas.getBoundingClientRect();\n    const touch = e.touches[0];\n    if (touch) {\n      const x = touch.clientX - rect.left;\n      this.emit('move', x);\n    }\n  }\n  \n  onTouchEnd(e) {\n    this.emit('fire');\n  }\n  \n  update() {\n    // Continuous movement for held keys\n    if (this.keys['ArrowLeft'] || this.keys['KeyA']) {\n      this.emit('move', -1); // Special value for left\n    } else if (this.keys['ArrowRight'] || this.keys['KeyD']) {\n      this.emit('move', -2); // Special value for right\n    }\n  }\n}",
  "src/audio.js": "export class AudioManager {\n  constructor() {\n    this.ctx = null;\n    this.sounds = {};\n    this.enabled = true;\n    this.initAudioContext();\n    this.createSounds();\n  }\n  \n  initAudioContext() {\n    try {\n      this.ctx = new (window.AudioContext || window.webkitAudioContext)();\n    } catch (e) {\n      console.warn('Web Audio API not supported');\n    }\n  }\n  \n  createSounds() {\n    if (!this.ctx) return;\n    \n    // Shoot sound\n    this.sounds.shoot = () => this.playTone(880, 0.1, 'square', 0.1);\n    \n    // Hit sound\n    this.sounds.hit = () => this.playTone(440, 0.15, 'sawtooth', 0.15);\n    \n    // Head kill sound\n    this.sounds.headkill = () => {\n      this.playTone(660, 0.1, 'triangle', 0.2);\n      setTimeout(() => this.playTone(880, 0.1, 'triangle', 0.2), 50);\n      setTimeout(() => this.playTone(1320, 0.2, 'triangle', 0.2), 100);\n    };\n    \n    // Game over sound\n    this.sounds.gameover = () => {\n      const notes = [330, 294, 262, 247];\n      notes.forEach((freq, i) => setTimeout(() => this.playTone(freq, 0.3, 'sine', 0.15), i * 150));\n    };\n  }\n  \n  playTone(frequency, duration, type = 'sine', volume = 0.1) {\n    if (!this.ctx || !this.enabled) return;\n    \n    if (this.ctx.state === 'suspended') {\n      this.ctx.resume();\n    }\n    \n    const osc = this.ctx.createOscillator();\n    const gain = this.ctx.createGain();\n    \n    osc.type = type;\n    osc.frequency.value = frequency;\n    \n    gain.gain.setValueAtTime(volume, this.ctx.currentTime);\n    gain.gain.exponentialRampToValueAtTime(0.001, this.ctx.currentTime + duration);\n    \n    osc.connect(gain);\n    gain.connect(this.ctx.destination);\n    \n    osc.start();\n    osc.stop(this.ctx.currentTime + duration);\n  }\n  \n  play(name) {\n    if (this.sounds[name]) {\n      this.sounds[name]();\n    }\n  }\n  \n  toggle() {\n    this.enabled = !this.enabled;\n  }\n}",
  "src/persistence.js": "export class Persistence {\n  constructor() {\n    this.storageKey = 'centipede_highscore';\n  }\n  \n  getHighScore() {\n    try {\n      return parseInt(localStorage.getItem(this.storageKey)) || 0;\n    } catch (e) {\n      return 0;\n    }\n  }\n  \n  saveHighScore(score) {\n    try {\n      const current = this.getHighScore();\n      if (score > current) {\n        localStorage.setItem(this.storageKey, score.toString());\n        return true;\n      }\n    } catch (e) {\n      console.warn('Could not save high score');\n    }\n    return false;\n  }\n}",
  "src/ui/hud.js": "export class HUD {\n  constructor(uiOverlay, config, persistence) {\n    this.uiOverlay = uiOverlay;\n    this.config = config;\n    this.persistence = persistence;\n    this.score = 0;\n    \n    this.createElements();\n  }\n  \n  createElements() {\n    // Score\n    this.scoreEl = document.createElement('div');\n    this.scoreEl.id = 'score';\n    this.scoreEl.className = 'hud';\n    this.scoreEl.textContent = 'SCORE: 0';\n    this.uiOverlay.appendChild(this.scoreEl);\n    \n    // Lives\n    this.livesEl = document.createElement('div');\n    this.livesEl.id = 'lives';\n    this.livesEl.className = 'hud';\n    this.uiOverlay.appendChild(this.livesEl);\n    \n    // Timer\n    this.timerEl = document.createElement('div');\n    this.timerEl.id = 'timer';\n    this.timerEl.className = 'hud';\n    this.timerEl.textContent = '00:00.00';\n    this.uiOverlay.appendChild(this.timerEl);\n    \n    // Speed meter\n    this.speedMeterEl = document.createElement('div');\n    this.speedMeterEl.id = 'speed-meter';\n    this.speedMeterEl.className = 'hud';\n    this.speedMeterEl.innerHTML = '<div id=\"speed-meter-fill\"></div>';\n    this.uiOverlay.appendChild(this.speedMeterEl);\n    \n    // Pause button\n    this.pauseBtn = document.createElement('button');\n    this.pauseBtn.id = 'pause-btn';\n    this.pauseBtn.className = 'hud';\n    this.pauseBtn.textContent = '⏸';\n    this.pauseBtn.addEventListener('click', () => window.dispatchEvent(new CustomEvent('pause')));\n    this.uiOverlay.appendChild(this.pauseBtn);\n    \n    this.updateLives(3);\n  }\n  \n  addScore(points) {\n    this.score += points;\n    this.scoreEl.textContent = `SCORE: ${this.score}`;\n  }\n  \n  getScore() {\n    return this.score;\n  }\n  \n  updateLives(lives) {\n    this.livesEl.innerHTML = '';\n    for (let i = 0; i < 3; i++) {\n      const heart = document.createElement('div');\n      heart.className = 'heart' + (i >= lives ? ' lost' : '');\n      this.livesEl.appendChild(heart);\n    }\n  }\n  \n  updateTimer(time) {\n    const mins = Math.floor(time / 60).toString().padStart(2, '0');\n    const secs = Math.floor(time % 60).toString().padStart(2, '0');\n    const ms = Math.floor((time % 1) * 100).toString().padStart(2, '0');\n    this.timerEl.textContent = `${mins}:${secs}.${ms}`;\n  }\n  \n  updateSpeedMeter(multiplier) {\n    const fill = document.getElementById('speed-meter-fill');\n    if (fill) {\n      const percent = Math.min(100, (multiplier - 1) * 100 + 20);\n      fill.style.width = `${percent}%`;\n    }\n  }\n  \n  setHighScore(highScore) {\n    // Could add high score display if needed\n  }\n  \n  setPaused(paused) {\n    this.pauseBtn.textContent = paused ? '▶' : '⏸';\n  }\n  \n  reset() {\n    this.score = 0;\n    this.scoreEl.textContent = 'SCORE: 0';\n    this.updateLives(3);\n    this.timerEl.textContent = '00:00.00';\n    const fill = document.getElementById('speed-meter-fill');\n    if (fill) fill.style.width = '0%';\n  }\n}",
  "src/ui/gameover.js": "export class GameOverScreen {\n  constructor(uiOverlay, onRestart) {\n    this.uiOverlay = uiOverlay;\n    this.onRestart = onRestart;\n    this.visible = false;\n    this.createElements();\n  }\n  \n  createElements() {\n    this.modal = document.createElement('div');\n    this.modal.className = 'modal';\n    this.modal.innerHTML = `\n      <h1>GAME OVER</h1>\n      <p id=\"final-score\">Score: 0</p>\n      <p id=\"high-score\">High Score: 0</p>\n      <button id=\"restart-btn\">PLAY AGAIN</button>\n    `;\n    this.uiOverlay.appendChild(this.modal);\n    \n    this.modal.querySelector('#restart-btn').addEventListener('click', () => {\n      this.hide();\n      this.onRestart();\n    });\n  }\n  \n  show(finalScore, highScore) {\n    this.modal.querySelector('#final-score').textContent = `Score: ${finalScore}`;\n    this.modal.querySelector('#high-score').textContent = `High Score: ${highScore}`;\n    if (finalScore >= highScore && finalScore > 0) {\n      this.modal.querySelector('#high-score').textContent = `NEW HIGH SCORE: ${finalScore}!`;\n      this.modal.querySelector('#high-score').style.color = '#00ff88';\n    }\n    this.modal.classList.add('visible');\n    this.visible = true;\n  }\n  \n  hide() {\n    this.modal.classList.remove('visible');\n    this.visible = false;\n  }\n}"\n}