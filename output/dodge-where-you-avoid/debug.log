    // Update wind particles
    for (const p of windParticles) {
        p.update();
    }
    
    // Check collisions
    checkCollisions();
    
    // Screen flash decay
    if (screenFlash > 0) {
        screenFlash -= dt;
    }
}

function draw() {
    // Clear
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    
    // Draw background
    drawBackground();
    
    // Draw rain (behind everything)
    for (const drop of raindrops) {
        drop.draw();
    }
    
    // Draw wind particles
    for (const p of windParticles) {
        p.draw();
    }
    
    // Draw leaves
    for (const leaf of leaves) {
        leaf.draw();
    }
    
    // Draw player
    player.draw();
    
    // Screen flash effect
    if (screenFlash > 0) {
        ctx.fillStyle = `rgba(255, 0, 0, ${screenFlash * 3})`;
        ctx.fillRect(0, 0, canvas.width, canvas.height);
    }
    
    // Draw HUD
    drawHUD();
}

function gameLoop(timestamp) {
    const dt = Math.min((timestamp - lastTime) / 1000, 0.1);
    lastTime = timestamp;
    
    if (gameState === 'start') {
        drawStartScreen();
    } else if (gameState === 'playing') {
        update(dt);
        draw();
    } else if (gameState === 'paused') {
        draw();
        drawPauseScreen();
    } else if (gameState === 'gameOver') {
        draw();
        drawGameOverScreen();
    }
    
    requestAnimationFrame(gameLoop);
}

// Start the game loop
initGame();
requestAnimationFrame(gameLoop);
    </script>
</body>
</html>"}