tx.translate(p.x+p.w/2,p.y+p.h/2);ctx.fillStyle=C.COLORS.P;ctx.beginPath();ctx.moveTo(0,-15);ctx.lineTo(-12,10);ctx.lineTo(-6,10);ctx.lineTo(-6,15);ctx.lineTo(6,15);ctx.lineTo(6,10);ctx.lineTo(12,10);ctx.closePath();ctx.fill();if(p.shield>0){ctx.strokeStyle=C.COLORS.SH;ctx.lineWidth=2;ctx.globalAlpha=0.5+Math.sin(C.FRAME*0.2)*0.3;ctx.beginPath();ctx.arc(0,0,22,0,Math.PI*2);ctx.stroke();ctx.globalAlpha=1}ctx.restore()}function drawProjectiles(){const ctx=C.CTX;for(const pool of ['player','enemy']){const arr=C.POOL[pool]||[];ctx.fillStyle=pool==='player'?C.COLORS.WP:C.COLORS.EP;for(const pr of arr){if(!pr.active)continue;if(pr.laser){ctx.fillRect(pr.x,pr.y,pr.w,pr.h)}else{ctx.fillRect(pr.x,pr.y,pr.w,pr.h)}}} }function drawInvaders(){if(!C.INVADERS)return;const ctx=C.CTX;for(const inv of C.INVADERS){if(!inv.alive)continue;ctx.fillStyle=C.COLORS[inv.type];ctx.save();ctx.translate(inv.x+inv.w/2,inv.y+inv.h/2);const s=Math.sin(inv.frame)*0.1+1;ctx.scale(s,s);drawInvaderShape(ctx,inv.type);ctx.restore()}}function drawInvaderShape(ctx,type){ctx.beginPath();if(type==='I1'){ctx.moveTo(0,-15);ctx.lineTo(-15,-5);ctx.lineTo(-15,10);ctx.lineTo(-5,10);ctx.lineTo(-5,15);ctx.lineTo(5,15);ctx.lineTo(5,10);ctx.lineTo(15,10);ctx.lineTo(15,-5);ctx.closePath()}else if(type==='I2'){ctx.arc(0,0,15,0,Math.PI*2);ctx.moveTo(-10,-5);ctx.lineTo(-5,5);ctx.lineTo(0,-5);ctx.lineTo(5,5);ctx.lineTo(10,-5)}else{ctx.moveTo(-12,-12);ctx.lineTo(12,12);ctx.moveTo(12,-12);ctx.lineTo(-12,12);ctx.moveTo(0,-15);ctx.lineTo(0,15);ctx.moveTo(-15,0);ctx.lineTo(15,0)}ctx.fill()}function drawBoss(){if(!C.BOSS)return;const ctx=C.CTX,b=C.BOSS;ctx.fillStyle=C.COLORS.B;ctx.save();ctx.translate(b.x+b.w/2,b.y+b.h/2);ctx.beginPath();ctx.ellipse(0,0,b.w/2,b.h/2,0,0,Math.PI*2);ctx.fill();ctx.fillStyle='#fff';for(let i=0;i<3;i++){ctx.beginPath();ctx.arc(-60+i*60,0,15,0,Math.PI*2);ctx.fill()}ctx.restore();drawBossHP()}function drawBossHP(){const ctx=C.CTX,b=C.BOSS;const w=400,h=20,x=C.W/2-200,y=40;ctx.fillStyle='#333';ctx.fillRect(x,y,w,h);ctx.fillStyle=C.COLORS.B;ctx.fillRect(x,y,w*Math.max(0,b.hp/C.BOSSMAX),h);ctx.strokeStyle='#fff';ctx.lineWidth=2;ctx.strokeRect(x,y,w,h);ctx.fillStyle='#ff0';ctx.font='16px VT323';ctx.textAlign='center';ctx.fillText(`BOSS HP: ${b.hp}/${C.BOSSMAX}`,C.W/2,y-5)}function drawBossIntro(){const ctx=C.CTX;ctx.fillStyle='rgba(0,0,0,0.8)';ctx.fillRect(0,0,C.W,C.H);ctx.fillStyle='#f00';ctx.font='48px VT323';ctx.textAlign='center';ctx.fillText(`STAGE ${C.STAGE}: BOSS INCOMING`,C.W/2,C.H/2);ctx.fillStyle='#ff0';ctx.font='24px VT323';ctx.fillText(['THE SENTINEL','THE WEAVER','THE HIVE','THE HOLLOW MOTHER'][C.STAGE/5-1],C.W/2,C.H/2+50)}function drawParticles(){const ctx=C.CTX;for(const p of C.PARTICLES){ctx.globalAlpha=p.alpha;ctx.fillStyle=p.color;ctx.fillRect(p.x-p.size/2,p.y-p.size/2,p.size,p.size)}ctx.globalAlpha=1}function drawPowerups(){const ctx=C.CTX,arr=C.POOL.powerup||[];for(const pu of arr){ctx.save();ctx.translate(pu.x+pu.w/2,pu.y+pu.h/2);ctx.rotate(pu.rot);ctx.strokeStyle=C.COLORS.SH;ctx.lineWidth=2;ctx.beginPath();for(let i=0;i<6;i++){const a=i*Math.PI/3;ctx.lineTo(Math.cos(a)*12,Math.sin(a)*12)}ctx.closePath();ctx.stroke();ctx.restore()}}function drawHUD(){const ctx=C.CTX;ctx.fillStyle=C.COLORS.P;ctx.font='20px VT323';ctx.textAlign='left';ctx.fillText(`SCORE: ${C.SCORE}`,20,30);ctx.fillText(`HI: ${C.HI}`,20,55);for(let i=0;i<C.LIVES;i++){ctx.save();ctx.translate(20+i*30,85);ctx.scale(0.5,0.5);drawPlayerIcon(ctx);ctx.restore()}ctx.fillStyle=C.COLORS.I2;ctx.textAlign='center';ctx.font='18px VT323';ctx.fillText(`STAGE ${C.STAGE} / 20`,C.W/2,30);const mins=Math.floor(C.TIMER/60),secs=Math.floor(C.TIMER%60);ctx.fillText(`${mins}:${secs.toString().padStart(2,'0')}`,C.W-100,30)}function drawPlayerIcon(ctx){ctx.fillStyle=C.COLORS.P;ctx.beginPath();ctx.moveTo(0,-15);ctx.lineTo(-12,10);ctx.lineTo(-6,10);ctx.lineTo(-6,15);ctx.lineTo(6,15);ctx.lineTo(6,10);ctx.lineTo(12,10);ctx.closePath();ctx.fill()}function drawPause(){const ctx=C.CTX;ctx.fillStyle='rgba(0,0,0,0.7)';ctx.fillRect(0,0,C.W,C.H);ctx.fillStyle='#0ff';ctx.font='48px VT323';ctx.textAlign='center';ctx.fillText('PAUSED',C.W/2,C.H/2);ctx.font='24px VT323';ctx.fillText('PRESS ESC TO RESUME',C.W/2,C.H/2+50)}function drawTitle(){const ctx=C.CTX;ctx.fillStyle=C.COLORS.P;ctx.font='64px VT323';ctx.textAlign='center';const glitch=Math.sin(C.FRAME*0.1)*2;ctx.fillText('VOIDBREAKER',C.W/2+glitch,C.H/2-50);ctx.fillStyle='#f0f';ctx.fillText('VOIDBREAKER',C.W/2-glitch,C.H/2-50);ctx.fillStyle='#ff0';ctx.font='24px VT323';ctx.fillText('INVASION PROTOCOL',C.W/2,C.H/2+10);ctx.fillStyle='#0f0';ctx.font='18px VT323';ctx.fillText('PRESS ENTER / TAP / CLICK TO START',C.W/2,C.H/2+60);ctx.fillStyle='#fff';ctx.font='14px VT323';ctx.fillText(`HIGH SCORE: ${C.HI}`,C.W/2,C.H/2+100)}function drawGameOver(){const ctx=C.CTX;ctx.fillStyle='rgba(0,0,0,0.9)';ctx.fillRect(0,0,C.W,C.H);ctx.fillStyle='#f00';ctx.font='64px VT323';ctx.textAlign='center';ctx.fillText('GAME OVER',C.W/2,C.H/2-50);ctx.fillStyle='#0ff';ctx.font='24px VT323';ctx.fillText(`FINAL SCORE: ${C.SCORE}`,C.W/2,C.H/2+10);ctx.fillText(`HIGH SCORE: ${C.HI}`,C.W/2,C.H/2+40);ctx.fillStyle='#ff0';ctx.font='18px VT323';ctx.fillText('PRESS ENTER / TAP TO RETRY',C.W/2,C.H/2+90)}function drawVictory(){const ctx=C.CTX;ctx.fillStyle='rgba(0,0,0,0.9)';ctx.fillRect(0,0,C.W,C.H);ctx.fillStyle='#fff';ctx.font='48px VT323';ctx.textAlign='center';ctx.fillText('HUMANITY PREVAILS',C.W/2,C.H/2-80);ctx.fillStyle='#0ff';ctx.font='24px VT323';ctx.fillText(`FINAL SCORE: ${C.SCORE}`,C.W/2,C.H/2-20);const acc=C.ACCURACY.shots?Math.round(C.ACCURACY.hits/C.ACCURACY.shots*100):0;const mins=Math.floor(C.TIMER/60),secs=Math.floor(C.TIMER%60);ctx.fillText(`ACCURACY: ${acc}%  TIME: ${mins}:${secs.toString().padStart(2,'0')}`,C.W/2,C.H/2+20);ctx.fillStyle='#ff0';ctx.font='18px VT323';ctx.fillText('PRESS ENTER / TAP TO PLAY AGAIN',C.W/2,C.H/2+80)}function getPool(name){if(!C.POOL[name])C.POOL[name]=[];const arr=C.POOL[name];for(const obj of arr)if(!obj.active)return obj;const obj={active:false};arr.push(obj);return obj}init();"}{"index.html":"<!DOCTYPE html><html lang=\"en\"><head><meta charset=\"UTF-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, user-scalable=no\"><title>VOIDBREAKER: INVASION PROTOCOL</title><link rel=\"icon\" href=\"data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🚀</text></svg>\"><style>*{margin:0;padding:0;box-sizing:border-box}body{background:#000;overflow:hidden;touch-action:none;font-family:'VT323',monospace}#gameCanvas{display