Raw: {"index.html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no\" />\n  <title>EGGSTRAVAGANZA: The Bizarre Hatchery</title>\n  <link rel=\"icon\" href=\"data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ctext y='.9em' font-size='90'%3E🥚%3C/text%3E%3C/svg%3E\" />\n  <link rel=\"stylesheet\" href=\"styles.css\" />\n</head>\n<body>\n  <div id=\"app\">\n    <!-- Top Bar -->\n    <header id=\"topbar\">\n      <div class=\"currency\">\n        <span class=\"bell-icon\">🔔</span>\n        <span id=\"bellsDisplay\">0</span>\n      </div>\n      <div class=\"topbar-buttons\">\n        <div id=\"timer\" class=\"timer\" title=\"Speedrun Timer\">00:00.00</div>\n        <button id=\"highScoreBadge\" class=\"icon-btn\" title=\"High Score\">⭐ <span id=\"highScore\">0</span></button>\n        <button id=\"settingsBtn\" class=\"icon-btn\" title=\"Settings\">⚙️</button>\n        <button id=\"statsBtn\" class=\"icon-btn\" title=\"Stats\">📊</button>\n      </div>\n    </header>\n\n    <!-- Main Game Canvas -->\n    <main id=\"gameArea\">\n      <canvas id=\"gameCanvas\"></canvas>\n      <div id=\"floatingTexts\"></div>\n    </main>\n\n    <!-- Bottom Navigation -->\n    <nav id=\"bottomnav\">\n      <button class=\"nav-btn active\" data-panel=\"shopPanel\">🛒<span>Shop</span></button>\n      <button class=\"nav-btn\" data-panel=\"creaturesPanel\">🐣<span>Creatures</span></button>\n      <button class=\"nav-btn\" data-panel=\"achievementsPanel\">🏆<span>Achievements</span></button>\n    </nav>\n\n    <!-- Panels -->\n    <div id=\"shopPanel\" class=\"panel active\">\n      <div class=\"panel-header\">\n        <h2>Upgrade Shop</h2>\n        <button class=\"close-btn\" data-close>✕</button>\n      </div>\n      <div id=\"shopList\" class=\"panel-content\"></div>\n    </div>\n\n    <div id=\"creaturesPanel\" class=\"panel\">\n      <div class=\"panel-header\">\n        <h2>Menagerie</h2>\n        <button class=\"close-btn\" data-close>✕</button>\n      </div>\n      <div id=\"creaturesGrid\" class=\"panel-content grid-4\"></div>\n    </div>\n\n    <div id=\"achievementsPanel\" class=\"panel\">\n      <div class=\"panel-header\">\n        <h2>Achievements</h2>\n        <button class=\"close-btn\" data-close>✕</button>\n      </div>\n      <div id=\"achievementsList\" class=\"panel-content\"></div>\n    </div>\n\n    <!-- Settings Modal -->\n    <div id=\"settingsModal\" class=\"modal\">\n      <div class=\"modal-content\">\n        <h2>Settings</h2>\n        <label><input type=\"checkbox\" id=\"soundToggle\" checked /> Sound Effects</label>\n        <label><input type=\"checkbox\" id=\"particlesToggle\" checked /> Particles</label>\n        <button id=\"saveBtn\">💾 Manual Save</button>\n        <button id=\"exportBtn\">📤 Export Save</button>\n        <button id=\"importBtn\">📥 Import Save</button>\n        <button id=\"resetBtn\" class=\"danger\">🗑️ Reset Game</button>\n        <button class=\"close-btn\" data-close>Close</button>\n      </div>\n    </div>\n\n    <!-- Stats Modal -->\n    <div id=\"statsModal\" class=\"modal\">\n      <div class=\"modal-content\">\n        <h2>Statistics</h2>\n        <div id=\"statsContent\"></div>\n        <button class=\"close-btn\" data-close>Close</button>\n      </div>\n    </div>\n\n    <!-- Toasts -->\n    <div id=\"toasts\"></div>\n  </div>\n\n  <script src=\"js/audio.js\"></script>\n  <script src=\"js/state.js\"></script>\n  <script src=\"js/eggs.js\"></script>\n  <script src=\"js/creatures.js\"></script>\n  <script src=\"js/shop.js\"></script>\n  <script src=\"js/ui.js\"></script>\n  <script src=\"js/renderer.js\"></script>\n  <script src=\"js/main.js\"></script>\n</body>\n</html>\n","styles.css": ":root {\n  --primary: #1a0a2e;\n  --secondary: #16213e;\n  --accent: #e94560;\n  --navy: #0f3460;\n  --gold: #ffd700;\n  --success: #00ff88;\n  --bg-grad-1: #2d0a4e;\n  --bg-grad-2: #0a0a1e;\n}\n\n* { box-sizing: border-box; margin: 0; padding: 0; }\n\nhtml, body {\n  width: 100%; height: 100%;\n  background: linear-gradient(135deg, var(--bg-grad-1), var(--bg-grad-2));\n  font-family: 'Segoe UI', 'Comic Sans MS', sans-serif;\n  color: #fff;\n  overflow: hidden;\n  user-select: none;\n  -webkit-tap-highlight-color: transparent;\n}\n\n#app {\n  display: flex; flex-direction: column;\n  width: 100vw; height: 100vh; height: 100dvh;\n  position: relative;\n}\n\n/* === Top Bar === */\n#topbar {\n  display: flex; justify-content: space-between; align-items: center;\n  padding: 10px 16px;\n  background: rgba(22, 33, 62, 0.9);\n  border-bottom: 2px solid var(--accent);\n  z-index: 10;\n}\n.currency {\n  font-size: clamp(16px, 2.5vw, 24px);\n  font-weight: bold;\n  color: var(--gold);\n  text-shadow: 0 0 10px var(--gold);\n  display: flex; align-items: center; gap: 8px;\n}\n.bell-icon { animation: bellWiggle 1s infinite; display: inline-block; }\n@keyframes bellWiggle {\n  0%, 100% { transform: rotate(0deg); }\n  25% { transform: rotate(-15deg); }\n  75% { transform: rotate(15deg); }\n}\n.topbar-buttons { display: flex; gap: 8px; align-items: center; }\n.timer {\n  font-family: monospace;\n  background: rgba(0,0,0,0.4);\n  padding: 4px 10px;\n  border-radius: 8px;\n  border: 1px solid var(--success);\n  color: var(--success);\n  font-size: 14px;\n  text-shadow: 0 0 6px var(--success);\n}\n.icon-btn {\n  background: rgba(255,255,255,0.1);\n  border: 1px solid var(--accent);\n  color: #fff;\n  padding: 6px 10px;\n  border-radius: 8px;\n  cursor: pointer;\n  font-size: 14px;\n  transition: all 0.2s;\n}\n.icon-btn:hover { background: var(--accent); transform: scale(1.05); }\n.icon-btn:active { transform: scale(0.95); }\n\n/* === Game Area === */\n#gameArea {\n  flex: 1;\n  position: relative;\n  overflow: hidden;\n  min-height: 0;\n}\n#gameCanvas {\n  display: block;\n  width: 100%; height: 100%;\n  cursor: pointer;\n}\n#floatingTexts {\n  position: absolute; inset: 0;\n  pointer-events: none;\n  overflow: hidden;\n}\n.float-text {\n  position: absolute;\n  font-weight: bold;\n  font-size: 20px;\n  pointer-events: none;\n  animation: floatUp 1.2s ease-out forwards;\n  text-shadow: 0 0 8px currentColor;\n}\n.float-text.crit {\n  font-size: 32px;\n  color: var(--gold);\n}\n@keyframes floatUp {\n  0% { transform: translateY(0) scale(0.5); opacity: 0; }\n  20% { opacity: 1; transform: translateY(-10px) scale(1.2); }\n  100% { transform: translateY(-80px) scale(1); opacity: 0; }\n}\n\n/* === Bottom Nav === */\n#bottomnav {\n  display: flex;\n  background: rgba(22, 33, 62, 0.95);\n  border-top: 2px solid var(--accent);\n  padding: 6px 4px;\n  z-index: 10;\n}\n.nav-btn {\n  flex: 1;\n  background: transparent;\n  border: 2px solid transparent;\n  color: #ccc;\n  padding: 8px;\n  border-radius: 8px;\n  cursor: pointer;\n  display: flex; flex-direction: column; align-items: center; gap: 2px;\n  font-size: 12px;\n  transition: all 0.2s;\n}\n.nav-btn span { font-size: 11px; }\n.nav-btn.active {\n  border-color: var(--accent);\n  color: #fff;\n  transform: scale(1.05);\n  background: rgba(233, 69, 96, 0.2);\n  box-shadow: 0 0 12px var(--accent);\n}\n\n/* === Panels === */\n.panel {\n  position: absolute;\n  bottom: 0; left: 0; right: 0;\n  height: 60%;\n  background: linear-gradient(180deg, rgba(22,33,62,0.98), rgba(10,10,30,0.98));\n  border-top: 3px solid var(--accent);\n  border-radius: 18px 18px 0 0;\n  transform: translateY(100%);\n  transition: transform 0.25s ease;\n  z-index: 20;\n  display: flex; flex-direction: column;\n}\n.panel.active { transform: translateY(0); }\n.panel-header {\n  display: flex; justify-content: space-between; align-items: center;\n  padding: 12px 18px;\n  border-bottom: 1px solid var(--accent);\n}\n.panel-header h2 {\n  color: var(--gold);\n  text-shadow: 0 0 10px var(--gold);\n  font-size: 20px;\n}\n.close-btn {\n  background: transparent;\n  border: 1px solid var(--accent);\n  color: #fff;\n  width: 32px; height: 32px;\n  border-radius: 50%;\n  cursor: pointer;\n  font-size: 14px;\n}\n.close-btn:hover { background: var(--accent); }\n.panel-content {\n  flex: 1;\n  overflow-y: auto;\n  padding: 12px;\n}\n\n/* === Shop === */\n.shop-item {\n  display: flex; align-items: center; gap: 12px;\n  background: rgba(255,255,255,0.05);\n  border: 1px solid var(--navy);\n  border-radius: 10px;\n  padding: 12px;\n  margin-bottom: 10px;\n}\n.shop-item.affordable { border-color: var(--success); }\n.shop-item.locked { opacity: 0.4; }\n.shop-icon { font-size: 32px; }\n.shop-info { flex: 1; }\n.shop-name { font-weight: bold; color: var(--gold); }\n.shop-desc { font-size: 12px; color: #ccc; margin-top: 4px; }\n.shop-cost { color: var(--accent); font-weight: bold; font-size: 14px; }\n.shop-level { font-size: 12px; color: var(--success); }\n.buy-btn {\n  background: var(--accent);\n  border: none;\n  color: #fff;\n  padding: 8px 14px;\n  border-radius: 8px;\n  cursor: pointer;\n  font-weight: bold;\n}\n.buy-btn:disabled { background: #444; cursor: not-allowed; }\n\n/* === Creatures Grid === */\n.grid-4 {\n  display: grid;\n  grid-template-columns: repeat(auto-fill, minmax(90px, 1fr));\n  gap: 10px;\n}\n.creature-card {\n  background: rgba(255,255,255,0.05);\n  border: 2px solid var(--navy);\n  border-radius: 10px;\n  padding: 8px;\n  text-align: center;\n  position: relative;\n  transition: all 0.2s;\n}\n.creature-card.discovered { border-color: var(--accent); }\n.creature-card:hover { transform: translateY(-2px); box-shadow: 0 0 12px var(--accent); }\n.creature-emoji { font-size: 36px; display: block; }\n.creature-name { font-size: 11px; margin-top: 4px; color: #fff; }\n.creature-count { font-size: 10px; color: var(--gold); margin-top: 2px; }\n.creature-card.locked .creature-emoji { filter: brightness(0.2); }\n\n/* === Achievements === */\n.achievement {\n  display: flex; align-items: center; gap: 10px;\n  background: rgba(255,255,255,0.05);\n  border: 1px solid var(--navy);\n  border-radius: 8px;\n  padding: 10px;\n  margin-bottom: 8px;\n}\n.achievement.unlocked { border-color: var(--gold); box-shadow: 0 0 8px var(--gold); }\n.achievement.locked { opacity: 0.5; }\n.achievement-icon { font-size: 28px; }\n.achievement-name { font-weight: bold; color: var(--gold); }\n.achievement-desc { font-size: 11px; color: #ccc; }\n\n/* === Modal === */\n.modal {\n  position: fixed; inset: 0;\n  background: rgba(0,0,0,0.8);\n  display: none;\n  align-items: center; justify-content: center;\n  z-index: 100;\n}\n.modal.active { display: flex; }\n.modal-content {\n  background: linear-gradient(180deg, var(--secondary), var(--primary));\n  border: 2px solid var(--accent);\n  border-radius: 14px;\n  padding: 20px;\n  max-width: 90%;\n  width: 360px;\n  display: flex; flex-direction: column; gap: 10px;\n}\n.modal-content h2 { color: var(--gold); text-align: center; }\n.modal-content label { display: flex; gap: 8px; align-items: center; }\n.modal-content button {\n  background: var(--accent);\n  border: none;\n  color: #fff;\n  padding: 10px;\n  border-radius: 8px;\n  cursor: pointer;\n  font-weight: bold;\n}\n.modal-content button.danger { background: #8b0000; }\n\n/* === Toasts === */\n#toasts {\n  position: fixed; top: 70px; right: 12px;\n  display: flex; flex-direction: column; gap: 8px;\n  z-index: 200;\n  pointer-events: none;\n}\n.toast {\n  background: rgba(22,33,62,0.95);\n  border: 2px solid var(--gold);\n  border-radius: 10px;\n  padding: 10px 14px;\n  min-width: 200px;\n  animation: slideIn 0.3s ease, slideOut 0.3s ease 2.7s forwards;\n  box-shadow: 0 0 14px var(--gold);\n}\n.toast-icon { font-size: 24px; margin-right: 8px; }\n.toast-title { font-weight: bold; color: var(--gold); }\n.toast-desc { font-size: 12px; color: #fff; }\n@keyframes slideIn {\n  from { transform: translateX(120%); opacity: 0; }\n  to { transform: translateX(0); opacity: 1; }\n}\n@keyframes slideOut {\n  to { transform: translateX(120%); opacity: 0; }\n}\n\n/* === Screen Shake === */\n.shake { animation: shake 0.1s; }\n@keyframes shake {\n  0%,100% { transform: translate(0,0); }\n  25% { transform: translate(-2px, 1px); }\n  75% { transform: translate(2px, -1px); }\n}\n\n/* === Responsive === */\n@media (max-width: 480px) {\n  .panel { height: 70%; }\n  .grid-4 { grid-template-columns: repeat(auto-fill, minmax(80px, 1fr)); }\n  #topbar { padding: 6px 10px; }\n}\n@media (min-width: 1024px) {\n  .panel { height: 55%; max-width: 700px; left: 50%; transform: translate(-50%, 100%); }\n  .panel.active { transform: translate(-50%, 0); }\n  .grid-4 { grid-template-columns: repeat(4, 1fr); }\n}\n","js/audio.js": "// Audio engine using Web Audio API oscillators\nconst Audio = (() => {\n  let ctx = null;\n  let enabled = true;\n\n  function ensure() {\n    if (!ctx) {\n      try { ctx = new (window.AudioContext || window.webkitAudioContext)(); }\n      catch(e) { console.warn('No AudioContext'); }\n    }\n    if (ctx && ctx.state === 'suspended') ctx.resume();\n  }\n\n  function tone(freq, dur, type='sine', vol=0.15, slide=0) {\n    if (!enabled) return;\n    ensure();\n    if (!ctx) return;\n    const o = ctx.createOscillator();\n    const g = ctx.createGain();\n    o.type = type;\n    o.frequency.setValueAtTime(freq, ctx.currentTime);\n    if (slide) o.frequency.exponentialRampToValueAtTime(freq + slide, ctx.currentTime + dur);\n    g.gain.setValueAtTime(vol, ctx.currentTime);\n    g.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + dur);\n    o.connect(g); g.connect(ctx.destination);\n    o.start();\n    o.stop(ctx.currentTime + dur);\n  }\n\n  function noise(dur, vol=0.05) {\n    if (!enabled) return;\n    ensure();\n    if (!ctx) return;\n    const buf = ctx.createBuffer(1, ctx.sampleRate * dur, ctx.sampleRate);\n    const data = buf.getChannelData(0);\n    for (let i = 0; i < data.length; i++) data[i] = (Math.random() * 2 - 1) * vol;\n    const src = ctx.createBufferSource();\n    src.buffer = buf;\n    const g = ctx.createGain();\n    g.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + dur);\n    src.connect(g); g.connect(ctx.destination);\n    src.start();\n  }\n\n  return {\n    click() { tone(800, 0.05, 'square', 0.08, -200); },\n    crack() { noise(0.1, 0.1); tone(200, 0.08, 'sawtooth', 0.08, -50); },\n    hatch() {\n      tone(523, 0.1, 'triangle', 0.15);\n      setTimeout(() => tone(659, 0.1, 'triangle', 0.15), 80);\n      setTimeout(() => tone(784, 0.2, 'triangle', 0.15), 160);\n    },\n    purchase() { tone(1200, 0.1, 'sine', 0.1); setTimeout(() => tone(1500, 0.15, 'sine', 0.1), 60); },\n    achievement() {\n      [523, 659, 784, 1047].forEach((f, i) => setTimeout(() => tone(f, 0.15, 'triangle', 0.15), i*100));\n    },\n    newCreature() { tone(440 + Math.random()*400, 0.2, 'sine', 0.12); },\n    setEnabled(v) { enabled = v; },\n    isEnabled() { return enabled; }\n  };\n})();\n","js/state.js": "// Game state and persistence\nconst State = (() => {\n  const STORAGE_KEY = 'eggstravaganza_save';\n  const HIGHSCORE_KEY = 'eggstravaganza_highscore';\n\n  const defaults = {\n    bells: 0,\n    totalBellsEarned: 0,\n    creaturesCollected: 0,\n    currentEggTier: 1,\n    eggProgress: 0,\n    clicksThisEgg: 0,\n    clickPower: 1,\n    critChance: 0.05,\n    hatchSpeed: 1,\n    upgrades: {},\n    collection: {},\n    achievements: [],\n    creaturesDiscovered: [],\n    stats: { totalClicks: 0, totalHatches: 0, crits: 0 },\n    settings: { sound: true, particles: true },\n    startTime: Date.now(),\n    bestTime: null\n  };\n\n  let state = JSON.parse(JSON.stringify(defaults));\n\n  function load() {\n    try {\n      const raw = localStorage.getItem(STORAGE_KEY);\n      if (raw) {\n        const saved = JSON.parse(raw);\n        state = Object.assign(JSON.parse(JSON.stringify(defaults)), saved);\n      }\n    } catch(e) { console.warn('Save load failed', e); }\n  }\n\n  function save() {\n    try {\n      localStorage.setItem(STORAGE_KEY, JSON.stringify(state));\n      // Update high score\n      const currentHS = parseInt(localStorage.getItem(HIGHSCORE_KEY) || '0', 10);\n      if (state.totalBellsEarned > currentHS) {\n        localStorage.setItem(HIGHSCORE_KEY, state.totalBellsEarned.toString());\n      }\n    } catch(e) { console.warn('Save failed', e); }\n  }\n\n  function getHighScore() {\n    return parseInt(localStorage.getItem(HIGHSCORE_KEY) || '0', 10);\n  }\n\n  function reset() {\n    localStorage.removeItem(STORAGE_KEY);\n    state = JSON.parse(JSON.stringify(defaults));\n    save();\n  }\n\n  function export() {\n    return btoa(unescape(encodeURIComponent(JSON.stringify(state))));\n  }\n\n  function import(str) {\n    try {\n      state = JSON.parse(decodeURIComponent(escape(atob(str))));\n      save();\n      return true;\n    } catch(e) { return false; }\n  }\n\n  function get() { return state; }\n\n  function mutate(fn) {\n    fn(state);\n    save();\n  }\n\n  // Auto save every 30s\n  setInterval(save, 30000);\n\n  return { load, save, reset, export, import, get, mutate, getHighScore };\n})();\n","js/eggs.js": "// Egg tiers and progression\nconst Eggs = (() => {\n  const tiers = [\n    { id: 1, name: 'Plain Egg', unlockAt: 0, clicksRequired: 10, baseValue: 1, color: '#f5f5dc', accent: '#888', emoji: '🥚' },\n    { id: 2, name: 'Spotted Egg', unlockAt: 10, clicksRequired: 25, baseValue: 5, color: '#fff8dc', accent: '#e94560', emoji: '🥚' },\n    { id: 3, name: 'Glowing Egg', unlockAt: 50, clicksRequired: 50, baseValue: 25, color: '#7fffd4', accent: '#00ff88', emoji: '✨🥚' },\n    { id: 4, name: 'Tentacled Egg', unlockAt: 150, clicksRequired: 100, baseValue: 100, color: '#9370db', accent: '#4b0082', emoji: '🐙🥚' },\n    { id: 5, name: 'Cosmic Egg', unlockAt: 400, clicksRequired: 200, baseValue: 500, color: '#1e90ff', accent: '#ffd700', emoji: '🌌🥚' },\n    { id: 6, name: 'Quantum Egg', unlockAt: 1000, clicksRequired: 350, baseValue: 2500, color: '#ff1493', accent: '#00ffff', emoji: '⚛️🥚' },\n    { id: 7, name: 'Paradox Egg', unlockAt: 2500, clicksRequired: 500, baseValue: 12500, color: '#fff', accent: '#000', emoji: '🌀🥚' },\n    { id: 8, name: 'Existential Crisis Egg', unlockAt: 6000, clicksRequired: 750, baseValue: 75000, color: '#2c2c54', accent: '#ff6b6b', emoji: '😵🥚' },\n    { id: 9, name: 'The Final Egg', unlockAt: 15000, clicksRequired: 1000, baseValue: 500000, color: '#000', accent: '#ffd700', emoji: '🌟🥚' }\n  ];\n\n  function getTier(id) { return tiers[id - 1]; }\n\n  function getCurrentTier() {\n    const s = State.get();\n    let t = 1;\n    for (const tier of tiers) {\n      if (s.creaturesCollected >= tier.unlockAt) t = tier.id;\n    }\n    return getTier(t);\n  }\n\n  function effectiveClicksRequired() {\n    const s = State.get();\n    const tier = getCurrentTier();\n    const hastyLevel = s.upgrades['hastyHands'] || 0;\n    const reduction = Math.min(0.8, hastyLevel * 0.05);\n    return Math.max(1, Math.floor(tier.clicksRequired * (1 - reduction)));\n  }\n\n  function calculateValue() {\n    const s = State.get();\n    const tier = getCurrentTier();\n    const goldenLevel = s.upgrades['goldenTouch'] || 0;\n    const multiplier = 1 + goldenLevel * 0.1;\n    return Math.floor(tier.baseValue * multiplier);\n  }\n\n  return { tiers, getTier, getCurrentTier, effectiveClicksRequired, calculateValue };\n})();\n","js/creatures.js": "// Creature definitions per tier\nconst Creatures = (() => {\n  const data = {\n    1: [\n      { id: 'chick', name: 'Basic Chick', emoji: '🐤' },\n      { id: 'potato', name: 'Grumpy Potato', emoji: '🥔' },\n      { id: 'sock', name: 'Single Sock', emoji: '🧦' }\n    ],\n    2: [\n      { id: 'duck3', name: 'Three-Eyed Duck', emoji: '🦆' },\n      { id: 'cactus', name: 'Confused Cactus', emoji: '🌵' },\n      { id: 'toaster', name: 'Talking Toaster', emoji: '🍞' }\n    ],\n    3: [\n      { id: 'llama', name: 'Laser Llama', emoji: '🦙' },\n      { id: 'worm', name: 'Disco Worm', emoji: '🪱' },\n      { id: 'hamster', name: 'Ninja Hamster', emoji: '🐹' }\n    ],\n    4: [\n      { id: 'corn', name: 'Eldritch Corn', emoji: '🌽' },\n      { id: 'pudding', name: 'Sentient Pudding', emoji: '🍮' },\n      { id: 'calc', name: 'Cursed Calculator', emoji: '🧮' }\n    ],\n    5: [\n      { id: 'voidcat', name: 'Void Cat', emoji: '🐈‍⬛' },\n      { id: 'goat', name: 'Dimension Goat', emoji: '🐐' },\n      { id: 'fish', name: 'Reality Fish', emoji: '🐟' }\n    ],\n    6: [\n      { id: 'parrot', name: 'Paradox Parrot', emoji: '🦜' },\n      { id: 'turtle', name: 'Time-Loop Turtle', emoji: '🐢' },\n      { id: 'cloud', name: 'Clone Cloud', emoji: '☁️' }\n    ],\n    7: [\n      { id: 'whale', name: 'Universe Whale', emoji: '🐋' },\n      { id: 'squirrel', name: 'Singularity Squirrel', emoji: '🐿️' },\n      { id: 'mole', name: 'Multiverse Mole', emoji: '🦔' }\n    ],\n    8: [\n      { id: 'chaos', name: 'Chaos Chicken', emoji: '🐔' },\n      { id: 'elk', name: 'Entropy Elk', emoji: '🦌' },\n      { id: 'insect', name: 'Infinity Insect', emoji: '🦋' }\n    ],\n    9: [\n      { id: 'keeper', name: 'The Keeper', emoji: '👁️' },\n      { id: 'other', name: 'The Other', emoji: '🌀' },\n      { id: 'original', name: 'The Original', emoji: '🌟' }\n    ]\n  };\n\n  function rollForTier(tierId) {\n    const list = data[tierId];\n    return list[Math.floor(Math.random() * list.length)];\n  }\n\n  function getAll() { return data; }\n\n  return { data, rollForTier, getAll };\n})();\n","js/shop.js": "// Shop upgrades and purchase logic\nconst Shop = (() => {\n  const upgrades = [\n    { id: 'sharperClick', name: 'Sharper Click', icon: '👆', desc: '+1 Click Power', baseCost: 50, costMult: 1.5, repeatable: true, max: 999, effect: (s, lvl) => { s.clickPower = 1 + lvl; } },\n    { id: 'doubleTap', name: 'Double Tap', icon: '✌️', desc: '+1% Crit Chance', baseCost: 500, costMult: 1.8, repeatable: true, max: 50, effect: (s, lvl) => { s.critChance = 0.05 + lvl * 0.01; } },\n    { id: 'autoHatch1', name: 'Auto-Hatch I', icon: '🤖', desc: 'Auto progress 1 egg/10s', baseCost: 1000, repeatable: false, effect: (s) => { s.hatchSpeed = Math.max(s.hatchSpeed, 1); } },\n    { id: 'autoHatch2', name: 'Auto-Hatch II', icon: '⚡', desc: 'Auto progress 1 egg/5s', baseCost: 10000, repeatable: false, prereq: 'autoHatch1', effect: (s) => { s.hatchSpeed = Math.max(s.hatchSpeed, 2); } },\n    { id: 'hastyHands', name: 'Hasty Hands', icon: '⏩', desc: '-5% clicks required', baseCost: 5000, costMult: 2.0, repeatable: true, max: 16, effect: () => {} },\n    { id: 'goldenTouch', name: 'Golden Touch', icon: '✨', desc: '+10% creature value', baseCost: 50000, costMult: 2.5, repeatable: true, max: 10, effect: () => {} },\n    { id: 'instaHatch', name: 'Insta-Hatch',", icon: '💥', desc: '10% chance eggs hatch instantly', baseCost: 500000, repeatable: false, effect: () => {} }\n    { id: 'quantumLuck', name: 'Quantum Luck', icon: '🎲', desc: '+2% rare tier chance', baseCost: 5000000, repeatable: false, effect: () => {} }\n  ];\n\n  function getCost(item) {\n    const s = State.get();\n    const level = s.upgrades[item.id] || 0;\n    if (!item.repeatable) return item.baseCost;\n    return Math.floor(item.baseCost * Math.pow(item.costMult, level));\n  }\n\n  function canAfford(item) {\n    return State.get().bells >= getCost(item);\n  }\n\n  function isPurchasable(item) {\n    const s = State.get();\n    if (item.prereq && !(s.upgrades[item.prereq])) return false;\n    const level = s.upgrades[item.id] || 0;\n    if (item.max && level >= item.max) return false;\n    return true;\n  }\n\n  function purchase(itemId) {\n    const item = upgrades.find(u => u.id === itemId);\n    if (!item) return false;\n    if (!isPurchasable(item)) return false;\n    const cost = getCost(item);\n    if (!canAfford(item)) return false;\n    State.mutate(s => {\n      s.bells -= cost;\n      s.upgrades[item.id] = (s.upgrades[item.id] || 0) + 1;\n      item.effect(s, s.upgrades[item.id]);\n    });\n    return true;\n  }\n\n  function getAll() { return upgrades; }\n\n  return { upgrades, getCost, canAfford, isPurchasable, purchase, getAll };\n})();\n","js/ui.js": "// UI rendering and panel management\nconst UI = (() => {\n  function $(sel) { return document.querySelector(sel); }\n  function $$(sel) { return document.querySelectorAll(sel); }\n\n  let activePanel = null;\n\n  function openPanel(panelId) {\n    $$('.panel').forEach(p => p.classList.remove('active'));\n    $$('.nav-btn').forEach(b => b.classList.remove('active'));\n    const panel = $('#' + panelId);\n    if (panel) panel.classList.add('active');\n    const btn = document.querySelector(`.nav-btn[data-panel=\"${panelId}\"]`);\n    if (btn) btn.classList.add('active');\n    activePanel = panelId;\n    if (panelId === 'shopPanel') renderShop();\n    if (panelId === 'creaturesPanel') renderCreatures();\n    if (panelId === 'achievementsPanel') renderAchievements();\n  }\n\n  function closePanels() {\n    $$('.panel').forEach(p => p.classList.remove('active'));\n    $$('.nav-btn').forEach(b => b.classList.remove('active'));\n    activePanel = null;\n  }\n\n  function updateBells() {\n    $('#bellsDisplay').textContent = formatNumber(State.get().bells);\n    $('#highScore').textContent = formatNumber(State.getHighScore());\n  }\n\n  function formatNumber(n) {\n    if (n < 1000) return Math.floor(n).toString();\n    if (n < 1e6) return (n/1000).toFixed(2) + 'K';\n    if (n < 1e9) return (n/1e6).toFixed(2) + 'M';\n    if (n < 1e12) return (n/1e9).toFixed(2) + 'B';\n    if (n < 1e15) return (n/1e12).toFixed(2) + 'T';\n    return n.toExponential(2);\n  }\n\n  function renderShop() {\n    const list = $('#shopList');\n    list.innerHTML = '';\n    Shop.getAll().forEach(item => {\n      const cost = Shop.getCost(item);\n      const s = State.get();\n      const level = s.upgrades[item.id] || 0;\n      const affordable = Shop.canAfford(item);\n      const purchasable = Shop.isPurchasable(item);\n      const div = document.createElement('div');\n      div.className = 'shop-item' + (affordable && purchasable ? ' affordable' : '') + (!purchasable ? ' locked' : '');\n      const levelText = item.max ? ` (${level}/${item.max})` : (level > 0 ? ' ✓' : '');\n      div.innerHTML = `\n        <div class=\"shop-icon\">${item.icon}</div>\n        <div class=\"shop-info\">\n          <div class=\"shop-name\">${item.name}${levelText}</div>\n          <div class=\"shop-desc\">${item.desc}</div>\n          <div class=\"shop-cost\">🔔 ${formatNumber(cost)}</div>\n        </div>\n        <button class=\"buy-btn\" ${(!affordable || !purchasable) ? 'disabled' : ''}>Buy</button>\n      `;\n      div.querySelector('.buy-btn').addEventListener('click', () => {\n        if (Shop.purchase(item.id)) {\n          Audio.purchase();\n          renderShop();\n          updateBells();\n          toast('🛒', 'Purchased!', item.name);\n        }\n      });\n      list.appendChild(div);\n    });\n  }\n\n  function renderCreatures() {\n    const grid = $('#creaturesGrid');\n    grid.innerHTML = '';\n    const all = Creatures.getAll();\n    const discovered = new Set(State.get().creaturesDiscovered || []);\n    Object.keys(all).forEach(tierId => {\n      all[tierId].forEach(c => {\n        const card = document.createElement('div');\n        const isDiscovered = discovered.has(c.id);\n        const count = (State.get().collection && State.get().collection[c.id]) || 0;\n        card.className = 'creature-card' + (isDiscovered ? ' discovered' : ' locked');\n        card.innerHTML = `\n          <span class=\"creature-emoji\">${isDiscovered ? c.emoji : '❓'}</span>\n          <div class=\"creature-name\">${isDiscovered ? c.name : '???'}</div>\n          <div class=\"creature-count\">${isDiscovered ? 'x' + count : ''}</div>\n        `;\n        grid.appendChild(card);\n      });\n    });\n  }\n\n  const achievements = [\n    { id: 'firstHatch', name: 'First Steps', desc: 'Hatch your first egg', icon: '🥚', check: s => s.stats.totalHatches >= 1 },\n    { id: 'tenHatch', name: 'Getting the Hang', desc: 'Hatch 10 eggs', icon: '👐', check: s => s.stats.totalHatches >= 10 },\n    { id: 'hundredHatch', name: 'Eggspert', desc: 'Hatch 100 eggs', icon: '💯', check: s => s.stats.totalHatches >= 100 },\n    { id: 'tier2', name: 'Spotted!', desc: 'Unlock tier 2 eggs', icon: '👁️', check: s => s.creaturesCollected >= 10 },\n    { id: 'tier3', name: 'Glowing Up', desc: 'Unlock tier 3 eggs', icon: '✨', check: s => s.creaturesCollected >= 50 },\n    { id: 'tier5', name: 'Cosmic', desc: 'Unlock tier 5 eggs', icon: '🌌', check: s => s.creaturesCollected >= 400 },\n    { id: 'tier9', name: 'Final Frontier', desc: 'Unlock the final egg', icon: '🌟', check: s => s.creaturesCollected >= 15000 },\n    { id: 'bells1k', name: 'Rich', desc: 'Earn 1,000 bells total', icon: '💰', check: s => s.totalBellsEarned >= 1000 },\n    { id: 'bells100k', name: 'Wealthy', desc: 'Earn 100,000 bells total', icon: '🤑', check: s => s.totalBellsEarned >= 100000 },\n    { id: 'bells10m', name: 'Bellionaire', desc: 'Earn 10M bells total', icon: '🤑', check: s => s.totalBellsEarned >= 10000000 },\n    { id: 'allCreatures', name: 'Completionist', desc: 'Discover 27 creatures', icon: '🏆', check: s => (s.creaturesDiscovered || []).length >= 27 },\n    { id: 'crit10', name: 'Critter', desc: 'Get 10 critical clicks', icon: '💥', check: s => s.stats.crits >= 10 },\n    { id: 'clicks1000', name: 'Tap Master', desc: 'Click 1,000 times', icon: '👆', check: s => s.stats.totalClicks >= 1000 }\n  ];\n\n  function renderAchievements() {\n    const list = $('#achievementsList');\n    list.innerHTML = '';\n    const s = State.get();\n    const unlocked = new Set(s.achievements || []);\n    achievements.forEach(a => {\n      const isUnlocked = unlocked.has(a.id);\n      const div = document.createElement('div');\n      div.className = 'achievement ' + (isUnlocked ? 'unlocked' : 'locked');\n      div.innerHTML = `\n        <div class=\"achievement-icon\">${a.icon}</div>\n        <div>\n          <div class=\"achievement-name\">${a.name}</div>\n          <div class=\"achievement-desc\">${a.desc}</div>\n        </div>\n      `;\n      list.appendChild(div);\n    });\n  }\n\n  function checkAchievements() {\n    const s = State.get();\n    if (!s.achievements) s.achievements = [];\n    let newAch = [];\n    achievements.forEach(a => {\n      if (!s.achievements.includes(a.id) && a.check(s)) {\n        s.achievements.push(a.id);\n        newAch.push(a);\n      }\n    });\n    if (newAch.length) {\n      State.save();\n      newAch.forEach(a => {\n        toast(a.icon, 'Achievement!', a.name);\n        Audio.achievement();\n      });\n    }\n  }\n\n  function updateTimer(ms) {\n    const totalSec = Math.floor(ms / 1000);\n    const min = Math.floor(totalSec / 60);\n    const sec = totalSec % 60;\n    const cs = Math.floor((ms % 1000) / 10);\n    $('#timer').textContent =\n      String(min).padStart(2, '0') + ':' +\n      String(sec).padStart(2, '0') + '.' +\n      String(cs).padStart(2, '0');\n  }\n\n  function toast(icon, title, desc) {\n    const el = document.createElement('div');\n    el.className = 'toast';\n    el.innerHTML = `<span class=\"toast-icon\">${icon}</span><span class=\"toast-title\">${title}</span><div class=\"toast-desc\">${desc}</div>`;\n    $('#toasts').appendChild(el);\n    setTimeout(() => el.remove(), 3000);\n  }\n\n  function floatText(x, y, text, crit=false) {\n    const el = document.createElement('div');\n    el.className = 'float-text' + (crit ? ' crit' : '');\n    el.textContent = text;\n    el.style.left = x + 'px';\n    el.style.top = y + 'px';\n    if (!crit) el.style.color = '#fff';\n    $('#floatingTexts').appendChild(el);\n    setTimeout(() => el.remove(), 1200);\n  }\n\n  function renderStats() {\n    const s = State.get();\n    $('#statsContent').innerHTML = `\n      <div>Bells: ${formatNumber(s.bells)}</div>\n      <div>Total Earned: ${formatNumber(s.totalBellsEarned)}</div>\n      <div>Creatures: ${s.creaturesCollected}</div>\n      <div>Discovered: ${(s.creaturesDiscovered || []).length}/27</div>\n      <div>Total Clicks: ${s.stats.totalClicks}</div>\n      <div>Total Hatches: ${s.stats.totalHatches}</div>\n      <div>Crits: ${s.stats.crits}</div>\n      <div>Current Egg: ${Eggs.getCurrentTier().name}</div>\n      <div>Achievements: ${(s.achievements || []).length}/${achievements.length}</div>\n    `;\n  }\n\n  function init() {\n    $$('.nav-btn').forEach(btn => {\n      btn.addEventListener('click', () => openPanel(btn.dataset.panel));\n    });\n    $$('[data-close]').forEach(btn => {\n      btn.addEventListener('click', e => {\n        const modal = btn.closest('.modal');\n        if (modal) modal.classList.remove('active');\n        else closePanels();\n      });\n    });\n    $('#settingsBtn').addEventListener('click', () => $('#settingsModal').classList.add('active'));\n    $('#statsBtn').addEventListener('click', () => { renderStats(); $('#statsModal').classList.add('active'); });\n    $('#highScoreBadge').addEventListener('click', () => { renderStats(); $('#statsModal').classList.add('active'); });\n\n    $('#soundToggle').addEventListener('change', e => {\n      State.mutate(s => { s.settings.sound = e.target.checked; });\n      Audio.setEnabled(e.target.checked);\n    });\n    $('#particlesToggle').addEventListener('change', e => {\n      State.mutate(s => { s.settings.particles = e.target.checked; });\n    });\n\n    $('#saveBtn').addEventListener('click', () => { State.save(); toast('💾', 'Saved!', 'Game state saved'); });\n    $('#exportBtn').addEventListener('click', () => {\n      const data = State.export();\n      navigator.clipboard.writeText(data).then(() => toast('📤', 'Copied!', 'Save data copied to clipboard')).catch(() => prompt('Copy this:', data));\n    });\n    $('#importBtn').addEventListener('click', () => {\n      const str = prompt('Paste save data:');\n      if (str && State.import(str)) {\n        toast('📥', 'Imported!', 'Save loaded successfully');\n        location.reload();\n      } else {\n        toast('❌', 'Failed', 'Invalid save data');\n      }\n    });\n    $('#resetBtn').addEventListener('click', () => {\n      if (confirm('Reset everything? This cannot be undone!')) {\n        State.reset();\n        location.reload();\n      }\n    });\n\n    updateBells();\n    renderShop();\n  }\n\n  return { init, openPanel, closePanels, updateBells, renderShop, renderCreatures, renderAchievements, checkAchievements, updateTimer, toast, floatText, formatNumber, renderStats };\n})();\n","js/renderer.js": "// Canvas renderer for eggs, creatures, particles\nconst Renderer = (() => {\n  let canvas, ctx;\n  let particles = [];\n  let shakeTime = 0;\n  let currentEggScale = 1;\n  let lastEggTier = 1;\n\n  function init() {\n    canvas = document.getElementById('gameCanvas');\n    ctx = canvas.getContext('2d');\n    resize();\n    window.addEventListener('resize', resize);\n  }\n\n  function resize() {\n    const parent = canvas.parentElement;\n    canvas.width = parent.clientWidth * devicePixelRatio;\n    canvas.height = parent.clientHeight * devicePixelRatio;\n    canvas.style.width = parent.clientWidth + 'px';\n    canvas.style.height = parent.clientHeight + 'px';\n    ctx.scale(devicePixelRatio, devicePixelRatio);\n  }\n\n  function spawnParticles(x, y, color, count=8) {\n    if (!State.get().settings.particles) return;\n    for (let i = 0; i < count; i++) {\n      const angle = Math.random() * Math.PI * 2;\n      const speed = 1 + Math.random() * 3;\n      particles.push({\n        x, y,\n        vx: Math.cos(angle) * speed,\n        vy: Math.sin(angle) * speed,\n        life: 1,\n        size: 2 + Math.random() * 3,\n        color\n      });\n    }\n  }\n\n  function update() {\n    for (let i = particles.length - 1; i >= 0; i--) {\n      const p = particles[i];\n      p.x += p.vx;\n      p.y += p.vy;\n      p.vy += 0.1;\n      p.life -= 0.02;\n      if (p.life <= 0) particles.splice(i, 1);\n    }\n    if (shakeTime > 0) shakeTime--;\n  }\n\n  function draw() {\n    const w = canvas.width / devicePixelRatio;\n    const h = canvas.height / devicePixelRatio;\n    ctx.clearRect(0, 0, w, h);\n\n    ctx.save();\n    if (shakeTime > 0) {\n      const s = shakeTime * 0.5;\n      ctx.translate((Math.random() - 0.5) * s, (Math.random() - 0.5) * s);\n    }\n\n    // Background stars\n    ctx.fillStyle = 'rgba(255,255,255,0.3)';\n    for (let i = 0; i < 50; i++) {\n      const x = (i * 73 + Date.now() * 0.01) % w;\n      const y = (i * 131) % h;\n      ctx.fillRect(x, y, 1, 1);\n    }\n\n    // Egg\n    const tier = Eggs.getCurrentTier();\n    const cx = w / 2;\n    const cy = h / 2;\n    const baseR = Math.min(w, h) * 0.15;\n    const r = baseR * currentEggScale;\n\n    // Glow\n    const grad = ctx.createRadialGradient(cx, cy, r * 0.5, cx, cy, r * 1.5);\n    grad.addColorStop(0, tier.color + 'cc');\n    grad.addColorStop(1, 'transparent');\n    ctx.fillStyle = grad;\n    ctx.beginPath();\n    ctx.arc(cx, cy, r * 1.5, 0, Math.PI * 2);\n    ctx.fill();\n\n    // Egg body\n    ctx.fillStyle = tier.color;\n    ctx.beginPath();\n    ctx.ellipse(cx, cy, r, r * 1.25, 0, 0, Math.PI * 2);\n    ctx.fill();\n\n    // Egg accent stripes/spots\n    ctx.fillStyle = tier.accent;\n    ctx.beginPath();\n    ctx.ellipse(cx, cy - r * 0.3, r * 0.3, r * 0.15, 0, 0, Math.PI * 2);\n    ctx.fill();\n    ctx.beginPath();\n    ctx.ellipse(cx - r * 0.4, cy + r * 0.2, r * 0.15, r * 0.1, 0, 0, Math.PI * 2);\n    ctx.fill();\n    ctx.beginPath();\n    ctx.ellipse(cx + r * 0.4, cy + r * 0.3, r * 0.2, r * 0.12, 0, 0, Math.PI * 2);\n    ctx.fill();\n\n    // Progress ring\n    const s = State.get();\n    const req = Eggs.effectiveClicksRequired();\n    const progress = Math.min(1, s.eggProgress / req);\n    ctx.strokeStyle = 'rgba(255,215,0,0.3)';\n    ctx.lineWidth = 6;\n    ctx.beginPath();\n    ctx.arc(cx, cy + r * 1.4, r * 0.5, 0, Math.PI * 2);\n    ctx.stroke();\n    ctx.strokeStyle = '#ffd700';\n    ctx.beginPath();\n    ctx.arc(cx, cy + r * 1.4, r * 0.5, -Math.PI / 2, -Math.PI / 2 + Math.PI * 2 * progress);\n    ctx.stroke();\n\n    // Tier name\n    ctx.fillStyle = '#fff';\n    ctx.font = 'bold 14px sans-serif';\n    ctx.textAlign = 'center';\n    ctx.fillText(tier.name, cx, cy + r * 1.9);\n    ctx.font = '11px sans-serif';\n    ctx.fillText(`${s.eggProgress} / ${req}`, cx, cy + r * 2.15);\n\n    // Particles\n    particles.forEach(p => {\n      ctx.fillStyle = p.color + Math.floor(p.life * 255).toString(16).padStart(2, '0');\n      ctx.beginPath();\n      ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);\n      ctx.fill();\n    });\n\n    ctx.restore();\n  }\n\n  function pulse() {\n    currentEggScale = 0.85;\n    const start = performance.now();\n    function anim() {\n      const t = (performance.now() - start) / 200;\n      if (t >= 1) { currentEggScale = 1; return; }\n      currentEggScale = 0.85 + 0.15 * (1 - Math.pow(1 - t, 3));\n      requestAnimationFrame(anim);\n    }\n    anim();\n  }\n\n  function shake() { shakeTime = 6; }\n\n  return { init, update, draw, spawnParticles, pulse, shake, getCanvas: () => canvas };\n})();\n","js/main.js": "// Main game loop and click handling\nconst Game = (() => {\n  let lastAutoTick = 0;\n  let lastTimeUpdate = 0;\n  let gameStartTime = Date.now();\n\n  function clickEgg(e) {\n    const s = State.get();\n    const rect = Renderer.getCanvas().getBoundingClientRect();\n    const x = (e.clientX || e.touches?.[0]?.clientX || 0) - rect.left;\n    const y = (e.clientY || e.touches?.[0]?.clientY || 0) - rect.top;\n\n    const isCrit = Math.random() < s.critChance;\n    const power = isCrit ? s.clickPower * 5 : s.clickPower;\n\n    State.mutate(st => {\n      st.stats.totalClicks++;\n      st.clicksThisEgg++;\n      if (isCrit) st.stats.crits++;\n      st.eggProgress += power;\n    });\n\n    const tier = Eggs.getCurrentTier();\n    Renderer.spawnParticles(x, y, tier.color, isCrit ? 16 : 8);\n    Renderer.pulse();\n    Audio.click();\n\n    UI.floatText(x, y, '+' + power + (isCrit ? ' CRIT!' : ''), isCrit);\n\n    checkHatch();\n    UI.checkAchievements();\n    UI.updateBells();\n  }\n\n  function checkHatch() {\n    const s = State.get();\n    const req = Eggs.effectiveClicksRequired();\n    if (s.eggProgress < req) return;\n\n    // Insta-hatch chance\n    if (!s._lastHatchCheck) {\n      // Always allow\n    }\n\n    const tier = Eggs.getCurrentTier();\n    const creature = Creatures.rollForTier(tier.id);\n    const value = Eggs.calculateValue();\n\n    State.mutate(st => {\n      st.eggProgress = 0;\n      st.clicksThisEgg = 0;\n      st.creaturesCollected++;\n      st.bells += value;\n      st.totalBellsEarned += value;\n      st.stats.totalHatches++;\n      if (!st.collection) st.collection = {};\n      st.collection[creature.id] = (st.collection[creature.id] || 0) + 1;\n      if (!st.creaturesDiscovered) st.creaturesDiscovered = [];\n      if (!st.creaturesDiscovered.includes(creature.id)) {\n        st.creaturesDiscovered.push(creature.id);\n        // Show new creature toast\n        setTimeout(() => {\n          Audio.newCreature();\n          UI.toast('🎉', 'New Creature!', creature.name);\n        }, 100);\n      }\n    });\n\n    Renderer.shake();\n    Renderer.spawnParticles(\n      Renderer.getCanvas().width / devicePixelRatio / 2,\n      Renderer.getCanvas().height / devicePixelRatio / 2,\n      '#ffd700', 30\n    );\n    Audio.hatch();\n    Audio.crack();\n\n    UI.toast('🥚', 'Hatched!', `${creature.emoji} ${creature.name} (+🔔${UI.formatNumber(value)})`);\n    UI.checkAchievements();\n  }\n\n  function autoHatchTick() {\n    const s = State.get();\n    if (!s.hatchSpeed) return;\n    State.mutate(st => {\n      st.eggProgress += s.hatchSpeed;\n    });\n    checkHatch();\n  }\n\n  function loop(now) {\n    if (!lastAutoTick) lastAutoTick = now;\n    if (!lastTimeUpdate) lastTimeUpdate = now;\n\n    if (now - lastAutoTick >= (s => s.hatchSpeed >= 2 ? 5000 : 10000)(State.get())) {\n      autoHatchTick();\n      lastAutoTick = now;\n    }\n\n    if (now - lastTimeUpdate >= 100) {\n      UI.updateTimer(Date.now() - gameStartTime);\n      lastTimeUpdate = now;\n    }\n\n    Renderer.update();\n    Renderer.draw();\n    requestAnimationFrame(loop);\n  }\n\n  function init() {\n    State.load();\n    const s = State.get();\n    Audio.setEnabled(s.settings.sound !== false);\n    document.getElementById('soundToggle').checked = s.settings.sound !== false;\n    document.getElementById('particlesToggle').checked = s.settings.particles !== false;\n    gameStartTime = s.startTime || Date.now();\n\n    UI.init();\n    Renderer.init();\n\n    const canvas = Renderer.getCanvas();\n    canvas.addEventListener('click', clickEgg);\n    canvas.addEventListener('touchstart', e => { e.preventDefault(); clickEgg(e); }, { passive: false });\n\n    requestAnimationFrame(loop);\n  }\n\n  return { init };\n})();\n\nwindow.addEventListener('DOMContentLoaded', Game.init);\n"}