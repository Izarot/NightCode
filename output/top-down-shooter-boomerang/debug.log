        this.game.score += 5000;
        this.game.particles.emit(this.x, this.y, 50, COLORS.boss, 200, 0.8, 8);
        this.game.audio.explosionSound();
        this.game.screenShake = 15;
        this.game.scorePopups.push({ x: this.x, y: this.y, text: '+5000', life: 2, color: COLORS.boss });
        this.game.scorePopups.push({ x: this.x, y: this.y - 40, text: 'BOSS DEFEATED!', life: 3, color: COLORS.player });
        this.game.victory = true;
        this.game.victoryTimer = 3;
    }
    draw(ctx) {
        if (!this.active || this.dead) return;
        ctx.save();
        ctx.translate(this.x, this.y);
        ctx.rotate(this.rotation);
        ctx.fillStyle = COLORS.boss;
        ctx.strokeStyle = COLORS.white;
        ctx.lineWidth = 3;
        ctx.beginPath();
        for (let i = 0; i < 6; i++) {
            const angle = (i / 6) * Math.PI * 2;
            const r = this.radius;
            if (i === 0) ctx.moveTo(Math.cos(angle) * r, Math.sin(angle) * r);
            else ctx.lineTo(Math.cos(angle) * r, Math.sin(angle) * r);
        }
        ctx.closePath();
        ctx.fill();
        ctx.stroke();
        ctx.fillStyle = '#000';
        ctx.beginPath();
        ctx.arc(-15, -10, 8, 0, Math.PI * 2);
        ctx.arc(15, -10, 8, 0, Math.PI * 2);
        ctx.fill();
        ctx.fillStyle = COLORS.danger;
        ctx.beginPath();
        ctx.arc(-15, -10, 4, 0, Math.PI * 2);
        ctx.arc(15, -10, 4, 0, Math.PI * 2);
        ctx.fill();
        ctx.restore();
    }
}

class Projectile {
    constructor(x, y, angle, speed, damage) {
        this.x = x; this.y = y;
        this.vx = Math.cos(angle) * speed;
        this.vy = Math.sin(angle) * speed;
        this.radius = 6;
        this.damage = damage;
        this.active = true;
    }
    update(dt) {
        this.x += this.vx * dt;
        this.y += this.vy * dt;
        if (this.x < 0 || this.x > GAME_WIDTH || this.y < 0 || this.y > GAME_HEIGHT) this.active = false;
        const dx = this.x - this.game.player.x;
        const dy = this.y - this.game.player.y;
        if (Math.sqrt(dx * dx + dy * dy) < this.radius + this.game.player.radius) {
            this.game.player.takeDamage(this.damage);
            this.active = false;
            this.game.particles.emit(this.x, this.y, 5, COLORS.danger, 80, 0.3, 3);
        }
    }
    draw(ctx) {
        ctx.fillStyle = COLORS.danger;
        ctx.beginPath();
        ctx.arc(this.x, this.y, this.radius, 0, Math.PI * 2);
        ctx.fill();
    }
}

class Pickup {
    constructor(game, x, y) {
        this.game = game;
        this.x = x; this.y = y;
        this.type = ['hp', 'rapid', 'split', 'homing', 'explosive'][Math.floor(Math.random() * 5)];
        this.radius = 10;
        this.bobTimer = 0;
        this.active = true;
    }
    update(dt) {
        this.bobTimer += dt;
        const dx = this.game.player.x - this.x;
        const dy = this.game.player.y - this.y;
        if (Math.sqrt(dx * dx + dy * dy) < this.radius + this.game.player.radius) {
            this.active = false;
            switch (this.type) {
                case 'hp':
                    this.game.player.hp = Math.min(this.game.player.maxHp, this.game.player.hp + 30);
                    this.game.scorePopups.push({ x: this.x, y: this.y, text: '+30 HP', life: 1, color: COLORS.player });
                    break;
                case 'rapid': this.game.boomerang.enhancement = 'rapid'; this.game.boomerang.enhancementTimer = 10; break;
                case 'split': this.game.boomerang.enhancement = 'split'; this.game.boomerang.enhancementTimer = 10; break;
                case 'homing': this.game.boomerang.enhancement = 'homing'; this.game.boomerang.enhancementTimer = 10; break;
                case 'explosive': this.game.boomerang.enhancement = 'explosive'; this.game.boomerang.enhancementTimer = 10; break;
            }
            this.game.audio.pickupSound();
            this.game.particles.emit(this.x, this.y, 8, COLORS.player, 100, 0.4, 3);
        }
    }
    draw(ctx) {
        const bob = Math.sin(this.bobTimer * 5) * 3;
        ctx.save();
        ctx.translate(this.x, this.y + bob);
        ctx.fillStyle = { hp: COLORS.player, rapid: COLORS.boomerang, split: COLORS.dasher, homing: COLORS.shooter, explosive: '#ff6600' }[this.type];
        ctx.strokeStyle = COLORS.white;
        ctx.lineWidth = 2;
        ctx.beginPath();
        ctx.arc(0, 0, this.radius, 0, Math.PI * 2);
        ctx.fill();
        ctx.stroke();
        ctx.fillStyle = '#000';
        ctx.font = 'bold 10px Orbitron';
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        ctx.fillText({ hp: '+', rapid: 'R', split: 'S', homing: 'H', explosive: 'E' }[this.type], 0, 0);
        ctx.restore();
    }
}

class UI {
    constructor(game) { this.game = game; }
    draw(ctx) {
        ctx.fillStyle = COLORS.ui;
        ctx.font = '16px Orbitron';
        ctx.textAlign = 'left';
        ctx.fillText('SCORE: ' + this.game.score, 20, 30);
        ctx.fillText('ENEMIES: ' + this.game.enemiesKilled, 20, 55);
        ctx.fillStyle = COLORS.white;
        ctx.fillText('WAVE: ' + this.game.wave, 20, 80);
        const hpBarW = 200, hpBarH = 20;
        ctx.fillStyle = '#333';
        ctx.fillRect(GAME_WIDTH - hpBarW - 20, 20, hpBarW, hpBarH);
        ctx.fillStyle = this.game.player.hp > 30 ? COLORS.player : COLORS.danger;
        ctx.fillRect(GAME_WIDTH - hpBarW - 20, 20, hpBarW * (this.game.player.hp / this.game.player.maxHp), hpBarH);
        ctx.strokeStyle = COLORS.white;
        ctx.lineWidth = 2;
        ctx.strokeRect(GAME_WIDTH - hpBarW - 20, 20, hpBarW, hpBarH);
        ctx.fillStyle = COLORS.white;
        ctx.textAlign = 'center';
        ctx.fillText('HP: ' + this.game.player.hp, GAME_WIDTH - hpBarW / 2 - 20, 35);
        ctx.textAlign = 'right';
        ctx.fillStyle = COLORS.player;
        ctx.fillText('LIVES: ' + '♥'.repeat(this.game.player.lives), GAME_WIDTH - 20, 30);
        ctx.textAlign = 'left';
        if (this.game.boomerang.enhancement) {
            ctx.fillStyle = COLORS.boomerang;
            ctx.fillText('ENHANCED: ' + this.game.boomerang.enhancement.toUpperCase() + ' (' + Math.ceil(this.game.boomerang.enhancementTimer) + 's)', 20, GAME_HEIGHT - 20);
        }
        if (this.game.player.dashUnlocked) {
            ctx.fillStyle = this.game.player.dashCooldown > 0 ? '#666' : COLORS.player;
            ctx.textAlign = 'right';
            ctx.fillText('DASH [SPACE]: ' + (this.game.player.dashCooldown > 0 ? Math.ceil(this.game.player.dashCooldown) + 's' : 'READY'), GAME_WIDTH - 20, GAME_HEIGHT - 20);
        }
        if (this.game.boss && this.game.boss.active && !this.game.boss.dead) {
            ctx.fillStyle = COLORS.danger;
            ctx.font = 'bold 20px Orbitron';
            ctx.textAlign = 'center';
            ctx.fillText('⚠ BOSS ⚠', GAME_WIDTH / 2, 60);
            const bw = 400;
            ctx.fillStyle = '#333';
            ctx.fillRect(GAME_WIDTH / 2 - bw / 2, 70, bw, 15);
            ctx.fillStyle = COLORS.boss;
            ctx.fillRect(GAME_WIDTH / 2 - bw / 2, 70, bw * (this.game.boss.hp / this.game.boss.maxHp), 15);
            ctx.strokeStyle = COLORS.white;
            ctx.lineWidth = 2;
            ctx.strokeRect(GAME_WIDTH / 2 - bw / 2, 70, bw, 15);
        }
        if (this.game.showHelp) {
            ctx.fillStyle = 'rgba(0,0,0,0.7)';
            ctx.fillRect(GAME_WIDTH / 2 - 200, GAME_HEIGHT / 2 - 150, 400, 300);
            ctx.strokeStyle = COLORS.ui;
            ctx.lineWidth = 2;
            ctx.strokeRect(GAME_WIDTH / 2 - 200, GAME_HEIGHT / 2 - 150, 400, 300);
            ctx.fillStyle = COLORS.ui;
            ctx.font = 'bold 20px Orbitron';
            ctx.textAlign = 'center';
            ctx.fillText('CONTROLS', GAME_WIDTH / 2, GAME_HEIGHT / 2 - 120);
            ctx.font = '14px Orbitron';
            ctx.textAlign = 'left';
            const help = ['WASD/Arrows: Move', 'Mouse: Aim', 'Click: Throw Boomerang', 'Space/Shift: Dash', '', 'Press H to close'];
            help.forEach((line, i) => ctx.fillText(line, GAME_WIDTH / 2 - 170, GAME_HEIGHT / 2 - 80 + i * 25));
        }
    }
}

class Game {
    constructor() {
        this.canvas = document.getElementById('gameCanvas');
        this.ctx = this.canvas.getContext('2d');
        this.canvas.width = GAME_WIDTH;
        this.canvas.height = GAME_HEIGHT;
        this.input = new Input(this.canvas);
        this.audio = new AudioEngine();
        this.particles = new ParticlePool(300);
        this.ui = new UI(this);
        this.player = new Player(this);
        this.boomerang = new Boomerang(this);
        this.enemies = [];
        this.projectiles = [];
        this.pickups = [];
        this.damageNumbers = [];
        this.scorePopups = [];
        this.extraBoomerang = false;
        this.screenShake = 0;
        this.score = 0;
        this.enemiesKilled = 0;
        this.wave = 1;
        this.waveTimer = 0;
        this.bossSpawned = false;
        this.boss = null;
        this.victory = false;
        this.gameOverFlag = false;
        this.showHelp = true;
        this.boomerangThrown = false;
        this.lastTime = 0;
        this.running = true;
        this.victoryTimer = 0;
        this.init();
    }
    init() {
        const overlay = document.getElementById('loadingOverlay');
        if (overlay) overlay.style.display = 'none';
        window.addEventListener('keydown', e => {
            if (e.code === 'KeyH') this.showHelp = !this.showHelp;
            if (e.code === 'Enter' && this.gameOverFlag) this.restart();
            if (e.code === 'Enter' && this.victory) this.restart();
        });
        this.audio.init();
        this.canvas.addEventListener('click', () => this.audio.init());
        this.canvas.addEventListener('touchstart', () => this.audio.init());
        this.lastTime = performance.now();
        requestAnimationFrame(t => this.loop(t));
    }
    restart() {
        this.score = 0; this.enemiesKilled = 0; this.wave = 1; this.waveTimer = 0;
        this.bossSpawned = false; this.boss = null; this.victory = false; this.gameOverFlag = false;
        this.enemies = []; this.projectiles = []; this.pickups = [];
        this.damageNumbers = []; this.scorePopups = [];
        this.player = new Player(this); this.boomerang = new Boomerang(this);
        this.extraBoomerang = false; this.boomerangThrown = false;
    }
    loop(timestamp) {
        if (!this.running) return;
        const dt = Math.min((timestamp - this.lastTime) / 1000, 0.05);
        this.lastTime = timestamp;
        this.update(dt);
        this.draw();
        requestAnimationFrame(t => this.loop(t));
    }
    update(dt) {
        if (this.gameOverFlag || this.victory) {
            if (this.victoryTimer > 0) this.victoryTimer -= dt;
            this.particles.update(dt);
            return;
        }
        this.input.update();
        this.player.update(dt);
        this.boomerang.update(dt);
        this.enemies.forEach(e => e.update(dt));
        this.projectiles.forEach(p => p.update(dt));
        this.pickups.forEach(p => p.update(dt));
        this.particles.update(dt);
        this.enemies = this.enemies.filter(e => !e.dead);
        this.projectiles = this.projectiles.filter(p => p.active);
        this.pickups = this.pickups.filter(p => p.active);
        if (this.boomerang.active) {
            this.enemies.forEach(e => {
                if (!this.boomerang.hitEnemies.has(e)) {
                    const dx = e.x - this.boomerang.x, dy = e.y - this.boomerang.y;
                    if (Math.sqrt(dx * dx + dy * dy) < e.radius + 15) {
                        this.boomerang.hitEnemies.add(e);
                        if (this.boomerang.enhancement === 'explosive') {
                            this.particles.emit(e.x, e.y, 20, '#ff6600', 150, 0.4, 5);
                            this.audio.explosionSound();
                            this.enemies.forEach(other => {
                                const odx = other.x - e.x, ody = other.y - e.y;
                                if (Math.sqrt(odx * odx + ody * ody) < 80) other.takeDamage(30);
                            });
                        }
                        e.takeDamage(25);
                    }
                }
            });
        }
        this.damageNumbers.forEach(d => { d.y -= 30 * dt; d.life -= dt; });
        this.damageNumbers = this.damageNumbers.filter(d => d.life > 0);
        this.scorePopups.forEach(s => { s.y -= 40 * dt; s.life -= dt; });
        this.scorePopups = this.scorePopups.filter(s => s.life > 0);
        if (this.boomerang.enhancementTimer > 0) this.boomerang.enhancementTimer -= dt;
        if (this.boomerang.enhancementTimer <= 0) this.boomerang.enhancement = null;
        this.waveTimer += dt;
        if (this.wave === 1 && this.waveTimer > 30) this.wave = 2;
        if (this.wave === 2 && this.waveTimer > 60) this.wave = 3;
        if (this.wave === 3 && this.waveTimer > 90) this.wave = 4;
        if (this.wave === 4 && this.waveTimer > 120 && !this.bossSpawned) {
            this.bossSpawned = true;
            this.boss = new Boss(this);
            this.audio.bossAlertSound();
            this.scorePopups.push({ x: GAME_WIDTH / 2, y: GAME_HEIGHT / 2, text: '⚠ BOSS INCOMING ⚠', life: 3, color: COLORS.danger });
        }
        if (this.boss && this.boss.active && !this.boss.dead) this.boss.update(dt);
        if (this.boss && this.boss.dead && !this.victory) this.victory = true;
        const spawnRate = { 1: 2, 2: 1.5, 3: 1, 4: 0.5 }[this.wave];
        if (Math.random() < dt / spawnRate) this.spawnEnemy();
        this.screenShake *= 0.9;
        if (this.screenShake < 0.1) this.screenShake = 0;
    }
    spawnEnemy() {
        const types = ['grunt'];
        if (this.wave >= 2) types.push('shooter');
        if (this.wave >= 3) types.push('dasher');
        if (this.wave >= 4) types.push('shielded');
        const type = types[Math.floor(Math.random() * types.length)];
        let x, y;
        const side = Math.floor(Math.random() * 4);
        switch (side) {
            case 0: x = Math.random() * GAME_WIDTH; y = -30; break;
            case 1: x = GAME_WIDTH + 30; y = Math.random() * GAME_HEIGHT; break;
            case 2: x = Math.random() * GAME_WIDTH; y = GAME_HEIGHT + 30; break;
            case 3: x = -30; y = Math.random() * GAME_HEIGHT; break;
        }
        this.enemies.push(new Enemy(this, type, x, y));
    }
    throwBoomerang() {
        const angle = this.player.angle;
        this.boomerang.throw(this.player.x, this.player.y, angle);
        this.boomerangThrown = true;
    }
    spawnExtraBoomerang(x, y, angle, enhancement) {
        const extra = new Boomerang(this);
        extra.enhancement = enhancement;
        extra.throw(x, y, angle);
        this.extraBoomerang = true;
        setTimeout(() => { extra.active = false; this.extraBoomerang = false; }, 2000);
    }
    gameOver() { this.gameOverFlag = true; Storage.save('highScore', Math.max(Storage.load('highScore', 0), this.score)); }
    draw() {
        const shake = this.screenShake;
        this.ctx.save();
        if (shake > 0) this.ctx.translate((Math.random() - 0.5) * shake * 2, (Math.random() - 0.5) * shake * 2);
        this.ctx.fillStyle = COLORS.bg;
        this.ctx.fillRect(0, 0, GAME_WIDTH, GAME_HEIGHT);
        this.ctx.strokeStyle = COLORS.grid;
        this.ctx.lineWidth = 1;
        for (let x = 0; x < GAME_WIDTH; x += 40) { this.ctx.beginPath(); this.ctx.moveTo(x, 0); this.ctx.lineTo(x, GAME_HEIGHT); this.ctx.stroke(); }
        for (let y = 0; y < GAME_HEIGHT; y += 40) { this.ctx.beginPath(); this.ctx.moveTo(0, y); this.ctx.lineTo(GAME_WIDTH, y); this.ctx.stroke(); }
        this.particles.draw(this.ctx);
        this.pickups.forEach(p => p.draw(this.ctx));
        this.enemies.forEach(e => e.draw(this.ctx));
        if (this.boss && this.boss.active) this.boss.draw(this.ctx);
        this.projectiles.forEach(p => p.draw(this.ctx));
        this.boomerang.draw(this.ctx);
        this.player.draw(this.ctx);
        this.ctx.fillStyle = COLORS.ui;
        this.ctx.font = '12px Orbitron';
        this.ctx.textAlign = 'center';
        this.damageNumbers.forEach(d => {
            this.ctx.fillStyle = COLORS.danger;
            this.ctx.globalAlpha = d.life;
            this.ctx.fillText('-' + d.value, d.x, d.y);
        });
        this.ctx.globalAlpha = 1;
        this.scorePopups.forEach(s => {
            this.ctx.fillStyle = s.color || COLORS.player;
            this.ctx.globalAlpha = Math.min(1, s.life);
            this.ctx.font = s.text.length > 10 ? 'bold 16px Orbitron' : '14px Orbitron';
            this.ctx.fillText(s.text, s.x, s.y);
        });
        this.ctx.globalAlpha = 1;
        this.ui.draw(this.ctx);
        if (this.gameOverFlag) {
            this.ctx.fillStyle = 'rgba(0,0,0,0.8)';
            this.ctx.fillRect(0, 0, GAME_WIDTH, GAME_HEIGHT);
            this.ctx.fillStyle = COLORS.danger;
            this.ctx.font = 'bold 48px Orbitron';
            this.ctx.textAlign = 'center';
            this.ctx.fillText('GAME OVER', GAME_WIDTH / 2, GAME_HEIGHT / 2 - 40);
            this.ctx.fillStyle = COLORS.white;
            this.ctx.font = '24px Orbitron';
            this.ctx.fillText('Score: ' + this.score, GAME_WIDTH / 2, GAME_HEIGHT / 2 + 10);
            this.ctx.fillText('High Score: ' + Storage.load('highScore', 0), GAME_WIDTH / 2, GAME_HEIGHT / 2 + 50);
            this.ctx.fillStyle = COLORS.ui;
            this.ctx.font = '18px Orbitron';
            this.ctx.fillText('Press ENTER to restart', GAME_WIDTH / 2, GAME_HEIGHT / 2 + 100);
        }
        if (this.victory) {
            this.ctx.fillStyle = 'rgba(0,0,0,0.8)';
            this.ctx.fillRect(0, 0, GAME_WIDTH, GAME_HEIGHT);
            this.ctx.fillStyle = COLORS.player;
            this.ctx.font = 'bold 48px Orbitron';
            this.ctx.textAlign = 'center';
            this.ctx.fillText('VICTORY!', GAME_WIDTH / 2, GAME_HEIGHT / 2 - 40);
            this.ctx.fillStyle = COLORS.white;
            this.ctx.font = '24px Orbitron';
            this.ctx.fillText('Final Score: ' + this.score, GAME_WIDTH / 2, GAME_HEIGHT / 2 + 10);
            this.ctx.fillStyle = COLORS.ui;
            this.ctx.font = '18px Orbitron';
            this.ctx.fillText('Press ENTER to play again', GAME_WIDTH / 2, GAME_HEIGHT / 2 + 100);
        }
        this.ctx.restore();
    }
}

const game = new Game();}