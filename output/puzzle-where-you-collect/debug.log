  "index.html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, user-scalable=no\">\n<title>MOSAIC — The Fragment Keeper</title>\n<link rel=\"icon\" href=\"data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🖼️</text></svg>\">\n<style>\n  * { margin: 0; padding: 0; box-sizing: border-box; -webkit-tap-highlight-color: transparent; }\n  body { background: #050812; overflow: hidden; font-family: 'Segoe UI', system-ui, sans-serif; color: #e0e0e0; touch-action: none; }\n  #gameCanvas { display: block; width: 100vw; height: 100vh; object-fit: contain; background: #0A0E1A; image-rendering: pixelated; image-rendering: crisp-edges; }\n  #uiOverlay { position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; pointer-events: none; z-index: 10; }\n  .hud { position: absolute; pointer-events: auto; }\n  #hudTop { top: 16px; left: 16px; right: 16px; display: flex; justify-content: space-between; align-items: flex-start; }\n  #timer { font-size: 1.4rem; font-weight: 700; letter-spacing: 2px; font-variant-numeric: tabular-nums; text-shadow: 0 0 8px #ffd700, 0 2px 4px #000; color: #fff; background: linear-gradient(90deg, transparent, rgba(10,14,26,0.8)); padding: 4px 12px; border-radius: 6px; border: 1px solid rgba(255,215,0,0.3); }\n  #levelName { font-size: 1rem; opacity: 0.7; text-align: right; padding: 4px 12px; }\n  #hudBottom { bottom: 16px; left: 50%; transform: translateX(-50%); display: flex; gap: 8px; }\n  .fragmentSlot { width: 48px; height: 48px; border: 2px solid rgba(255,215,0,0.4); border-radius: 6px; background: rgba(10,14,26,0.6); display: flex; align-items: center; justify-content: center; position: relative; box-shadow: 0 0 12px rgba(0,0,0,0.5), inset 0 0 8px rgba(255,215,0,0.1); transition: transform 0.1s, box-shadow 0.1s; }\n  .fragmentSlot.filled { border-color: #ffd700; box-shadow: 0 0 16px rgba(255,215,0,0.4), inset 0 0 12px rgba(255,215,0,0.2); }\n  .fragmentSlot.pulse { animation: pulse 1.5s infinite; }\n  @keyframes pulse { 0%,100% { box-shadow: 0 0 16px rgba(255,215,0,0.4); } 50% { box-shadow: 0 0 28px rgba(255,215,0,0.8), 0 0 40px rgba(255,100,200,0.3); } }\n  .fragmentSlot .fragIcon { width: 36px; height: 36px; border-radius: 4px; image-rendering: pixelated; }\n  #dashCooldown { position: absolute; bottom: 0; left: 0; right: 0; height: 3px; background: rgba(255,215,0,0.3); border-radius: 0 0 6px 6px; overflow: hidden; }\n  #dashCooldown::after { content: ''; display: block; height: 100%; width: 100%; background: linear-gradient(90deg, #ffd700, #ff66c4); transform: scaleX(1); transform-origin: left; transition: transform 0.1s linear; }\n  #dashCooldown.cooldown::after { transform: scaleX(0); }\n\n  #restorationFrame { position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%) scale(0.9); width: 90vw; max-width: 960px; height: 85vh; max-height: 720px; background: linear-gradient(135deg, #0d1220 0%, #0a0e1a 100%); border: 2px solid #ffd700; border-radius: 12px; box-shadow: 0 0 60px rgba(255,215,0,0.2), 0 20px 40px rgba(0,0,0,0.8); z-index: 100; display: none; flex-direction: column; opacity: 0; transition: opacity 0.3s, transform 0.3s; pointer-events: auto; overflow: hidden; }\n  #restorationFrame.open { display: flex; opacity: 1; transform: translate(-50%, -50%) scale(1); }\n  .frameHeader { padding: 16px 24px; border-bottom: 1px solid rgba(255,215,0,0.3); display: flex; justify-content: space-between; align-items: center; background: rgba(0,0,0,0.3); }\n  .frameHeader h2 { font-size: 1.5rem; font-weight: 600; background: linear-gradient(90deg, #ffd700, #ff66c4, #00ffff); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }\n  .frameHeader .closeBtn { background: none; border: 1px solid rgba(255,215,0,0.5); color: #ffd700; padding: 6px 14px; border-radius: 4px; cursor: pointer; font-size: 0.9rem; transition: 0.2s; }\n  .frameHeader .closeBtn:hover { background: rgba(255,215,0,0.2); box-shadow: 0 0 12px rgba(255,215,0,0.3); }\n  .frameContent { flex: 1; display: flex; overflow: hidden; position: relative; }\n  #mosaicGrid { flex: 1; display: grid; gap: 4px; padding: 20px; align-content: center; justify-content: center; overflow: auto; background: radial-gradient(ellipse at center, rgba(255,215,0,0.03) 0%, transparent 70%); }\n  .mosaicCell { aspect-ratio: 1; border: 2px dashed rgba(255,215,0,0.2); border-radius: 4px; background: rgba(0,0,0,0.4); position: relative; transition: border-color 0.2s, box-shadow 0.2s; }\n  .mosaicCell.correct { border-style: solid; border-color: #ffd700; box-shadow: inset 0 0 20px rgba(255,215,0,0.1); }\n  .mosaicCell.placed { border: none; overflow: hidden; }\n  .mosaicCell .cellImg { width: 100%; height: 100%; object-fit: cover; opacity: 0; transition: opacity 0.5s ease-out; }\n  .mosaicCell.placed .cellImg { opacity: 1; }\n  .mosaicCell.hint::after { content: attr(data-num); position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); font-size: 1.5rem; color: rgba(255,215,0,0.15); pointer-events: none; font-weight: bold; }\n  #fragmentTray { width: 200px; border-left: 1px solid rgba(255,215,0,0.2); padding: 20px 12px; display: flex; flex-direction: column; gap: 10px; align-items: center; overflow-y: auto; background: rgba(0,0,0,0.2); }\n  .trayFragment { width: 160px; height: 160px; border: 3px solid rgba(255,215,0,0.4); border-radius: 8px; cursor: grab; position: relative; background: rgba(0,0,0,0.5); box-shadow: 0 0 20px rgba(0,0,0,0.5); transition: 0.2s; image-rendering: pixelated; }\n  .trayFragment:hover { border-color: #ffd700; box-shadow: 0 0 30px rgba(255,215,0,0.3), 0 0 60px rgba(255,100,200,0.1); transform: scale(1.02); }\n  .trayFragment.held { cursor: grabbing; border-color: #00ffff; box-shadow: 0 0 30px rgba(0,255,255,0.5), 0 0 60px rgba(255,100,200,0.2); transform: scale(1.05) rotate(-2deg); z-index: 10; }\n  .trayFragment.placed { opacity: 0.4; pointer-events: none; border-color: rgba(255,215,0,0.2); transform: scale(0.95); }\n  .trayFragment .fragNum { position: absolute; bottom: 6px; right: 8px; font-size: 0.8rem; color: rgba(255,215,0,0.7); background: rgba(0,0,0,0.7); padding: 2px 6px; border-radius: 3px; }\n\n  #levelComplete { position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: rgba(5,8,18,0.95); z-index: 200; display: none; flex-direction: column; align-items: center; justify-content: center; gap: 24px; opacity: 0; transition: opacity 0.5s; pointer-events: auto; }\n  #levelComplete.show { display: flex; opacity: 1; }\n  #levelComplete .paintingReveal { width: 80vw; max-width: 640px; aspect-ratio: 16/9; border: 3px solid #ffd700; border-radius: 8px; overflow: hidden; box-shadow: 0 0 60px rgba(255,215,0,0.3), 0 0 120px rgba(255,100,200,0.1); position: relative; }\n  #levelComplete .paintingReveal img { width: 100%; height: 100%; object-fit: cover; transform: scale(1.1); opacity: 0; transition: opacity 1.5s ease-out, transform 1.5s ease-out; }\n  #levelComplete .paintingReveal img.revealed { opacity: 1; transform: scale(1); }\n  #levelComplete .caption { font-size: 1.8rem; font-style: italic; color: #ffd700; text-align: center; max-width: 90%; text-shadow: 0 0 20px rgba(255,215,0,0.5); opacity: 0; transform: translateY(20px); transition: opacity 0.8s 0.5s, transform 0.8s 0.5s; }\n  #levelComplete.show .caption { opacity: 1; transform: translateY(0); }\n  #levelComplete .btn { background: linear-gradient(135deg, #1a1f3a, #0d1220); border: 2px solid #ffd700; color: #ffd700; padding: 14px 40px; font-size: 1.1rem; border-radius: 6px; cursor: pointer; transition: 0.2s; text-transform: uppercase; letter-spacing: 2px; opacity: 0; transform: translateY(20px); transition: opacity 0.5s 1s, transform 0.5s 1s, box-shadow 0.2s, background 0.2s; }\n  #levelComplete.show .btn { opacity: 1; transform: translateY(0); }\n  #levelComplete .btn:hover { box-shadow: 0 0 30px rgba(255,215,0,0.4); background: linear-gradient(135deg, #2a2f4a, #1d223a); }\n\n  #titleScreen { position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: radial-gradient(ellipse at center, #0d1220 0%, #050812 100%); z-index: 300; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 32px; pointer-events: auto; transition: opacity 0.5s; }\n  #titleScreen.hidden { opacity: 0; pointer-events: none; }\n  #titleScreen h1 { font-size: clamp(3rem, 12vw, 6rem); font-weight: 200; letter-spacing: 0.3em; background: linear-gradient(90deg, #ffd700, #ff66c4, #00ffff, #ffd700); background-size: 300%; -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; animation: shimmer 4s linear infinite; text-shadow: none; }\n  @keyframes shimmer { 0% { background-position: 0%; } 100% { background-position: 300%; } }\n  #titleScreen .subtitle { font-size: 1.2rem; color: rgba(255,215,0,0.6); letter-spacing: 4px; text-transform: uppercase; }\n  #titleScreen .highscore { font-size: 1rem; color: rgba(255,255,255,0.4); margin-top: -16px; }\n  #titleScreen .startBtn { padding: 18px 60px; font-size: 1.3rem; }\n\n  @media (max-width: 768px) {\n    #timer { font-size: 1rem; padding: 4px 8px; }\n    #levelName { font-size: 0.8rem; }\n    .fragmentSlot { width: 40px; height: 40px; }\n    .fragmentSlot .fragIcon { width: 30px; height: 30px; }\n    #restorationFrame { width: 98vw; height: 92vh; }\n    #fragmentTray { width: 140px; }\n    .trayFragment { width: 110px; height: 110px; }\n    #titleScreen h1 { letter-spacing: 0.15em; }\n  }\n</style>\n</head>\n<body>\n  <canvas id=\"gameCanvas\"></canvas>\n  <div id=\"uiOverlay\">\n    <div id=\"hudTop\" class=\"hud\">\n      <div id=\"timer\">00:00.000</div>\n      <div id=\"levelName\">LEVEL 1 — FIRST LIGHT</div>\n    </div>\n    <div id=\"hudBottom\" class=\"hud\">\n      <div id=\"fragmentTrayHUD\"></div>\n    </div>\n\n    <div id=\"restorationFrame\">\n      <div class=\"frameHeader\">\n        <h2>RESTORATION FRAME</h2>\n        <button class=\"closeBtn\" id=\"closeFrame\">TAB to Close</button>\n      </div>\n      <div class=\"frameContent\">\n        <div id=\"mosaicGrid\"></div>\n        <div id=\"fragmentTray\"></div>\n      </div>\n    </div>\n\n    <div id=\"levelComplete\">\n      <div class=\"paintingReveal\"><img id=\"revealImg\" src=\"\"></div>\n      <div class=\"caption\" id=\"levelCaption\"></div>\n      <button class=\"btn\" id=\"nextLevelBtn\">Continue</button>\n    </div>\n\n    <div id=\"titleScreen\">\n      <h1>MOSAIC</h1>\n      <div class=\"subtitle\">The Fragment Keeper</div>\n      <div class=\"highscore\" id=\"highscoreDisplay\"></div>\n      <button class=\"btn startBtn\" id=\"startBtn\">Begin Restoration</button>\n    </div>\n  </div>\n\n<script>\n// ==========================================\n// CONFIG & LEVEL DATA\n// ==========================================\nconst CONFIG = {\n  TILE_SIZE: 32,\n  VIEWPORT_W: 1280,\n  VIEWPORT_H: 720,\n  PLAYER_RADIUS: 11,\n  MAX_SPEED: 230,\n  ACCEL: 1500,\n  FRICTION: 2000,\n  DASH_SPEED: 620,\n  DASH_DURATION: 0.14,\n  DASH_COOLDOWN: 1.1,\n  GRAVITY: 0,\n  LEVELS: [\n    { // Level 1: First Light (3x3 = 9 fragments)\n      name: \"FIRST LIGHT\",\n      cols: 44, rows: 26,\n      palette: { bg: '#0A0E1A', wall: '#1A1F3A', accent: '#FF6B35', accent2: '#FFD700' },\n      fragments: 9, grid: { cols: 3, rows: 3 },\n      caption: \"Light returns to the hollow halls.\"\n    },\n    { // Level 2: The Quiet City (4x4 = 16 fragments)\n      name: \"THE QUIET CITY\",\n      cols: 56, rows: 32,\n      palette: { bg: '#0A0E1A', wall: '#1A1F3A', accent: '#00D4FF', accent2: '#7CFFD4' },\n      fragments: 16, grid: { cols: 4, rows: 4 },\n      caption: \"The city remembers what we forgot.\"\n    },\n    { // Level 3: Bloom (5x5 = 25 fragments)\n      name: \"BLOOM\",\n      cols: 64, rows: 40,\n      palette: { bg: '#0A0E1A', wall: '#1A1F3A', accent: '#FF2D95', accent2: '#FFD700' },\n      fragments: 25, grid: { cols: 5, rows: 5 },\n      caption: \"From fragments, a garden grows.\"\n    }\n  ]\n};\n\n// Tile Types\nconst TILE = { EMPTY: 0, WALL: 1, GATE: 2, PLATE: 3, CRATE: 4, PEDESTAL: 5, VOID: 6 };\n\n// ==========================================\n// PROCEDURAL LEVEL GENERATION\n// ==========================================\nfunction generateLevel(levelIndex) {\n  const def = CONFIG.LEVELS[levelIndex];\n  const { cols, rows } = def;\n  const tiles = new Uint8Array(cols * rows);\n  const objects = []; // { type, x, y, props... }\n  const fragments = [];\n\n  // 1. Border Walls\n  for (let x = 0; x < cols; x++) { tiles[x] = TILE.WALL; tiles[(rows-1)*cols + x] = TILE.WALL; }\n  for (let y = 0; y < rows; y++) { tiles[y*cols] = TILE.WALL; tiles[y*cols + (cols-1)] = TILE.WALL; }\n\n  // 2. Internal Structure (Rooms & Corridors)\n  const roomCount = 3 + levelIndex * 2;\n  for (let i = 0; i < roomCount; i++) {\n    const rw = 6 + Math.random() * 8 | 0;\n    const rh = 5 + Math.random() * 6 | 0;\n    const rx = 2 + Math.random() * (cols - rw - 4) | 0;\n    const ry = 2 + Math.random() * (rows - rh - 4) | 0;\n    for (let y = ry; y < ry + rh; y++) {\n      for (let x = rx; x < rx + rw; x++) {\n        if (y === ry || y === ry+rh-1 || x === rx || x === rx+rw-1) tiles[y*cols+x] = TILE.WALL;\n        else tiles[y*cols+x] = TILE.EMPTY;\n      }\n    }\n    // Doorway\n    const side = Math.random() * 4 | 0;\n    let dx, dy;\n    if (side === 0) { dx = rx + (rw/2|0); dy = ry; }\n    else if (side === 1) { dx = rx + rw - 1; dy = ry + (rh/2|0); }\n    else if (side === 2) { dx = rx + (rw/2|0); dy = ry + rh - 1; }\n    else { dx = rx; dy = ry + (rh/2|0); }\n    tiles[dy*cols+dx] = TILE.EMPTY;\n  }\n\n  // 3. Connect Rooms (Corridors) - Simple MST-ish\n  // For simplicity, just carve some random paths\n  for (let i = 0; i < cols * rows * 0.05; i++) {\n    const x = 1 + Math.random() * (cols-2) | 0;\n    const y = 1 + Math.random() * (rows-2) | 0;\n    if (tiles[y*cols+x] === TILE.WALL && Math.random() < 0.3) tiles[y*cols+x] = TILE.EMPTY;\n  }\n\n  // 4. Puzzles & Fragments Placement\n  const fragCount = def.fragments;\n  const gridCols = def.grid.cols;\n  const gridRows = def.grid.rows;\n  const placedFrags = new Set();\n\n  // Helper to find empty floor\n  const findEmpty = (margin=3) => {\n    for (let attempt=0; attempt<100; attempt++) {\n      const x = margin + Math.random() * (cols - 2*margin) | 0;\n      const y = margin + Math.random() * (rows - 2*margin) | 0;\n      if (tiles[y*cols+x] === TILE.EMPTY) return {x, y};\n    }\n    return {x: cols/2|0, y: rows/2|0};\n  };\n\n  // Place Fragments\n  for (let i = 0; i < fragCount; i++) {\n    const pos = findEmpty(4);\n    const cellX = i % gridCols;\n    const cellY = (i / gridCols) | 0;\n    fragments.push({ id: i, cellX, cellY, wx: pos.x * CONFIG.TILE_SIZE + CONFIG.TILE_SIZE/2, wy: pos.y * CONFIG.TILE_SIZE + CONFIG.TILE_SIZE/2, state: 'AVAILABLE', bobPhase: Math.random() * Math.PI * 2, glowColor: '' });\n    placedFrags.add(`${pos.x},${pos.y}`);\n  }\n\n  // Add Gates/Plates (Level 2+)\n  if (levelIndex >= 1) {\n    for (let g = 0; g < 2 + levelIndex; g++) {\n      const pos = findEmpty(5);\n      tiles[pos.y*cols+pos.x] = TILE.GATE;\n      objects.push({ type: 'gate', x: pos.x, y: pos.y, open: false, linkedPlates: [] });\n      // Plate nearby\n      const pPos = findEmpty(5);\n      tiles[pPos.y*cols+pPos.x] = TILE.PLATE;\n      objects.push({ type: 'plate', x: pPos.x, y: pPos.y, pressed: false, gateId: objects.length-1 });\n      objects[objects.length-2].linkedPlates.push(objects.length-1);\n    }\n  }\n\n  // Add Crates (Level 3)\n  if (levelIndex >= 2) {\n    for (let c = 0; c < 4; c++) {\n      const pos = findEmpty(5);\n      tiles[pos.y*cols+pos.x] = TILE.CRATE;\n      objects.push({ type: 'crate', x: pos.x, y: pos.y, vx: 0, vy: 0 });\n    }\n  }\n\n  // Player Start\n  const start = findEmpty(5);\n  \n  return { tiles, cols, rows, objects, fragments, playerStart: start, def };\n}\n\n// ==========================================\n// PAINTING GENERATION (Procedural Art)\n// ==========================================\nfunction generatePainting(levelIndex) {\n  const def = CONFIG.LEVELS[levelIndex];\n  const { cols: gridCols, rows: gridRows } = def.grid;\n  const cellSize = 128; // High res for fragments\n  const w = gridCols * cellSize;\n  const h = gridRows * cellSize;\n  const canvas = document.createElement('canvas');\n  canvas.width = w; canvas.height = h;\n  const ctx = canvas.getContext('2d');\n\n  // Base Gradient\n  const g = ctx.createLinearGradient(0,0,w,h);\n  const p = def.palette;\n  g.addColorStop(0, p.accent);\n  g.addColorStop(0.5, p.accent2);\n  g.addColorStop(1, p.accent);\n  ctx.fillStyle = g;\n  ctx.fillRect(0,0,w,h);\n\n  // Abstract Shapes\n  ctx.globalCompositeOperation = 'overlay';\n  for (let i=0; i<20+levelIndex*10; i++) {\n    ctx.beginPath();\n    const x = Math.random()*w, y = Math.random()*h, r = 30+Math.random()*100;\n    ctx.arc(x,y,r,0,Math.PI*2);\n    ctx.fillStyle = `hsla(${Math.random()*60 + (levelIndex*120)}, 80%, 60%, 0.3)`;\n    ctx.fill();\n  }\n  ctx.globalCompositeOperation = 'source-over';\n  \n  // Lines/Structure\n  ctx.strokeStyle = 'rgba(255,255,255,0.15)';\n  ctx.lineWidth = 2;\n  for(let i=0;i<gridCols+1;i++) { ctx.beginPath(); ctx.moveTo(i{ ctx.lineTo(i*cellSize, h); ctx.stroke(); }\n  for(let i=0;i<gridRows+1;i++) { ctx.beginPath(); ctx.moveTo(0, i*cellSize); ctx.lineTo(w, i*cellSize); ctx.stroke(); }\n\n  // Extract fragment images\n  const fragmentImages = [];\n  for (let cy = 0; cy < gridRows; cy++) {\n    for (let cx = 0; cx < gridCols; cx++) {\n      const fragCanvas = document.createElement('canvas');\n      fragCanvas.width = cellSize;\n      fragCanvas.height = cellSize;\n      const fctx = fragCanvas.getContext('2d');\n      fctx.drawImage(canvas, cx*cellSize, cy*cellSize, cellSize, cellSize, 0, 0, cellSize, cellSize);\n      fragmentImages.push(fragCanvas.toDataURL('image/png'));\n    }\n  }\n\n  // Full painting for reveal\n  const fullPainting = canvas.toDataURL('image/png');\n  \n  return { fragmentImages, fullPainting, gridCols, gridRows, cellSize };\n}\n\n// ==========================================\n// GAME STATE\n// ==========================================\nlet currentLevel = 0;\nlet levelData = null;\nlet paintingData = null;\nlet player = { x: 0, y: 0, vx: 0, vy: 0, radius: CONFIG.PLAYER_RADIUS };\nlet dashCooldown = 0;\nlet dashTime = 0;\nlet dashDir = { x: 0, y: 0 };\nlet collectedFragments = 0;\nlet totalFragments = 0;\nlet levelStartTime = 0;\nlet levelTime = 0;\nlet gameRunning = false;\nlet showRestoration = false;\nlet draggedFragment = null;\nlet dragOffset = { x: 0, y: 0 };\nlet hoverCell = null;\nlet keys = {};\nlet lastTimestamp = 0;\nlet animationId = 0;\n\n// Canvas setup\nconst canvas = document.getElementById('gameCanvas');\nconst ctx = canvas.getContext('2d');\nlet camera = { x: 0, y: 0 };\n\n// ==========================================\n// INITIALIZATION\n// ==========================================\nfunction initLevel(levelIndex) {\n  currentLevel = levelIndex;\n  levelData = generateLevel(levelIndex);\n  paintingData = generatePainting(levelIndex);\n  \n  player.x = levelData.playerStart.x * CONFIG.TILE_SIZE + CONFIG.TILE_SIZE/2;\n  player.y = levelData.playerStart.y * CONFIG.TILE_SIZE + CONFIG.TILE_SIZE/2;\n  player.vx = 0; player.vy = 0;\n  \n  dashCooldown = 0;\n  dashTime = 0;\n  collectedFragments = 0;\n  totalFragments = levelData.fragments.length;\n  levelStartTime = performance.now();\n  levelTime = 0;\n  \n  // Assign fragment images\n  levelData.fragments.forEach((f, i) => {\n    f.imgSrc = paintingData.fragmentImages[i];\n    f.glowColor = levelData.def.palette.accent;\n  });\n  \n  updateHUD();\n  buildRestorationUI();\n  gameRunning = true;\n}\n\nfunction buildRestorationUI() {\n  const grid = document.getElementById('mosaicGrid');\n  const tray = document.getElementById('fragmentTray');\n  grid.innerHTML = '';\n  tray.innerHTML = '';\n  \n  const { gridCols, gridRows } = paintingData;\n  grid.style.gridTemplateColumns = `repeat(${gridCols}, 1fr)`;\n  grid.style.gridTemplateRows = `repeat(${gridRows}, 1fr)`;\n  \n  // Grid cells\n  for (let y = 0; y < gridRows; y++) {\n    for (let x = 0; x < gridCols; x++) {\n      const idx = y * gridCols + x;\n      const cell = document.createElement('div');\n      cell.className = 'mosaicCell';\n      cell.dataset.idx = idx;\n      cell.dataset.x = x;\n      cell.dataset.y = y;\n      \n      const img = document.createElement('img');\n      img.className = 'cellImg';\n      img.src = paintingData.fragmentImages[idx];\n      img.draggable = false;\n      cell.appendChild(img);\n      \n      // Check if fragment placed\n      const frag = levelData.fragments.find(f => f.cellX === x && f.cellY === y);\n      if (frag && frag.state === 'PLACED') {\n        cell.classList.add('placed');\n      } else {\n        cell.classList.add('hint');\n        cell.dataset.num = idx + 1;\n      }\n      \n      cell.addEventListener('dragover', e => { e.preventDefault(); cell.classList.add('correct'); });\n      cell.addEventListener('dragleave', () => cell.classList.remove('correct'));\n      cell.addEventListener('drop', e => { e.preventDefault(); cell.classList.remove('correct'); onFragmentDrop(idx, e); });\n      cell.addEventListener('click', () => onCellClick(idx));\n      grid.appendChild(cell);\n    }\n  }\n  \n  // Tray fragments\n  levelData.fragments.forEach((f, i) => {\n    const div = document.createElement('div');\n    div.className = 'trayFragment';\n    div.dataset.fragId = i;\n    div.style.backgroundImage = `url(${f.imgSrc})`;\n    div.style.backgroundSize = 'cover';\n    div.style.backgroundPosition = 'center';\n    div.draggable = true;\n    \n    const num = document.createElement('span');\n    num.className = 'fragNum';\n    num.textContent = `${f.cellY * paintingData.gridCols + f.cellX + 1}`;\n    div.appendChild(num);\n    \n    if (f.state === 'PLACED') div.classList.add('placed');\n    \n    div.addEventListener('dragstart', e => onDragStart(e, i));\n    div.addEventListener('dragend', onDragEnd);\n    div.addEventListener('click', () => onTrayClick(i));\n    tray.appendChild(div);\n  });\n}\n\nfunction updateHUD() {\n  document.getElementById('timer').textContent = formatTime(levelTime);\n  document.getElementById('levelName').textContent = `LEVEL ${currentLevel+1} — ${levelData.def.name}`;\n  \n  const trayHUD = document.getElementById('fragmentTrayHUD');\n  trayHUD.innerHTML = '';\n  levelData.fragments.forEach((f, i) => {\n    const slot = document.createElement('div');\n    slot.className = 'fragmentSlot';\n    if (f.state === 'PLACED') slot.classList.add('filled');\n    if (f.state === 'HELD') slot.classList.add('pulse');\n    \n    const img = document.createElement('img');\n    img.className = 'fragIcon';\n    img.src = f.imgSrc;\n    img.draggable = false;\n    slot.appendChild(img);\n    \n    const dash = document.createElement('div');\n    dash.id = 'dashCooldown';\n    if (dashCooldown > 0) dash.classList.add('cooldown');\n    slot.appendChild(dash);\n    \n    trayHUD.appendChild(slot);\n  });\n  \n  // Update dash cooldown bar\n  const dashBar = document.getElementById('dashCooldown');\n  if (dashBar) {\n    if (dashCooldown > 0) dashBar.classList.add('cooldown');\n    else dashBar.classList.remove('cooldown');\n  }\n}\n\nfunction formatTime(ms) {\n  const total = ms / 1000;\n  const m = (total / 60) | 0;\n  const s = (total % 60) | 0;\n  const ms3 = ((total % 1) * 1000) | 0;\n  return `${m.toString().padStart(2,'0')}:${s.toString().padStart(2,'0')}.${ms3.toString().padStart(3,'0')}`;\n}\n\n// ==========================================\n// RESTORATION FRAME INTERACTIONS\n// ==========================================\nfunction onDragStart(e, fragId) {\n  draggedFragment = fragId;\n  const frag = levelData.fragments[fragId];\n  if (frag.state === 'PLACED') { e.preventDefault(); return; }\n  frag.state = 'HELD';\n  e.dataTransfer.setData('text/plain', fragId);\n  e.dataTransfer.effectAllowed = 'move';\n  buildRestorationUI();\n}\n\nfunction onDragEnd(e) {\n  if (draggedFragment !== null) {\n    const frag = levelData.fragments[draggedFragment];\n    if (frag.state === 'HELD') frag.state = 'AVAILABLE';\n    draggedFragment = null;\n    buildRestorationUI();\n  }\n}\n\nfunction onFragmentDrop(cellIdx, e) {\n  if (draggedFragment === null) return;\n  const frag = levelData.fragments[draggedFragment];\n  const gridCols = paintingData.gridCols;\n  const targetX = cellIdx % gridCols;\n  const targetY = (cellIdx / gridCols) | 0;\n  \n  if (frag.cellX === targetX && frag.cellY === targetY) {\n    frag.state = 'PLACED';\n    collectedFragments++;\n    checkLevelComplete();\n  } else {\n    frag.state = 'AVAILABLE';\n  }\n  draggedFragment = null;\n  buildRestorationUI();\n  updateHUD();\n}\n\nfunction onTrayClick(fragId) {\n  if (showRestoration) {\n    const frag = levelData.fragments[fragId];\n    if (frag.state === 'AVAILABLE') {\n      // Find its correct cell\n      const cellIdx = frag.cellY * paintingData.gridCols + frag.cellX;\n      const cell = document.querySelector(`.mosaicCell[data-idx=\"${cellIdx}\"]`);\n      if (cell) {\n        cell.classList.add('correct');\n        setTimeout(() => cell.classList.remove('correct'), 500);\n      }\n    }\n  }\n}\n\nfunction onCellClick(cellIdx) {\n  const gridCols = paintingData.gridCols;\n  const x = cellIdx % gridCols;\n  const y = (cellIdx / gridCols) | 0;\n  const frag = levelData.fragments.find(f => f.cellX === x && f.cellY === y);\n  if (frag && frag.state === 'PLACED') {\n    frag.state = 'AVAILABLE';\n    collectedFragments--;\n    buildRestorationUI();\n    updateHUD();\n  }\n}\n\nfunction checkLevelComplete() {\n  if (collectedFragments >= totalFragments) {\n    gameRunning = false;\n    showLevelComplete();\n  }\n}\n\nfunction showLevelComplete() {\n  const overlay = document.getElementById('levelComplete');\n  const img = document.getElementById('revealImg');\n  const caption = document.getElementById('levelCaption');\n  \n  img.src = paintingData.fullPainting;\n  caption.textContent = `\"${levelData.def.caption}\"`;\n  \n  overlay.classList.add('show');\n  setTimeout(() => img.classList.add('revealed'), 100);\n  \n  // Save best time\n  const key = `mosaic_level_${currentLevel}_best`;\n  const best = parseFloat(localStorage.getItem(key) || 'Infinity');\n  if (levelTime < best) {\n    localStorage.setItem(key, levelTime.toString());\n    updateHighscoreDisplay();\n  }\n}\n\nfunction nextLevel() {\n  document.getElementById('levelComplete').classList.remove('show');\n  document.getElementById('revealImg').classList.remove('revealed');\n  \n  if (currentLevel < CONFIG.LEVELS.length - 1) {\n    initLevel(currentLevel + 1);\n  } else {\n    // Game complete - back to title\n    showTitleScreen();\n  }\n}\n\nfunction showTitleScreen() {\n  gameRunning = false;\n  document.getElementById('titleScreen').classList.remove('hidden');\n  updateHighscoreDisplay();\n}\n\nfunction updateHighscoreDisplay() {\n  const display = document.getElementById('highscoreDisplay');\n  let html = 'Best Times: ';\n  CONFIG.LEVELS.forEach((_, i) => {\n    const key = `mosaic_level_${i}_best`;\n    const best = parseFloat(localStorage.getItem(key) || 'Infinity');\n    if (best !== Infinity) {\n      html += `L${i+1}: ${formatTime(best)}  `;\n    }\n  });\n  display.innerHTML = html === 'Best Times: ' ? '' : html;\n}\n\nfunction startGame() {\n  document.getElementById('titleScreen').classList.add('hidden');\n  initLevel(0);\n}\n\nfunction toggleRestoration() {\n  showRestoration = !showRestoration;\n  const frame = document.getElementById('restorationFrame');\n  if (showRestoration) {\n    frame.classList.add('open');\n    buildRestorationUI();\n  } else {\n    frame.classList.remove('open');\n  }\n}\n\nfunction closeRestoration() {\n  showRestoration = false;\n  document.getElementById('restorationFrame').classList.remove('open');\n}\n\n// ==========================================\n// PHYSICS & COLLISION\n// ==========================================\nfunction getTile(x, y) {\n  if (x < 0 || x >= levelData.cols || y < 0 || y >= levelData.rows) return TILE.WALL;\n  return levelData.tiles[y * levelData.cols + x];\n}\n\nfunction setTile(x, y, type) {\n  if (x >= 0 && x < levelData.cols && y >= 0 && y < levelData.rows) {\n    levelData.tiles[y * levelData.cols + x] = type;\n  }\n}\n\nfunction checkCollision(px, py, radius) {\n  const left = (px - radius) / CONFIG.TILE_SIZE | 0;\n  const right = (px + radius) / CONFIG.TILE_SIZE | 0;\n  const top = (py - radius) / CONFIG.TILE_SIZE | 0;\n  const bottom = (py + radius) / CONFIG.TILE_SIZE | 0;\n  \n  for (let y = top; y <= bottom; y++) {\n    for (let x = left; x <= right; x++) {\n      const tile = getTile(x, y);\n      if (tile === TILE.WALL || tile === TILE.GATE || tile === TILE.CRATE) {\n        const tx = x * CONFIG.TILE_SIZE + CONFIG.TILE_SIZE/2;\n        const ty = y * CONFIG.TILE_SIZE + CONFIG.TILE_SIZE/2;\n        const dx = px - tx;\n        const dy = py - ty;\n        const dist = Math.hypot(dx, dy);\n        const overlap = radius + CONFIG.TILE_SIZE/2 - dist;\n        if (overlap > 0) {\n          const nx = dist > 0.001 ? dx / dist : (Math.random()-0.5);\n          const ny = dist > 0.001 ? dy / dist : (Math.random()-0.5);\n          return { x: nx * overlap, y: ny * overlap, tile, tx, ty };\n        }\n      }\n    }\n  }\n  return null;\n}\n\nfunction pushCrates(px, py, radius, dt) {\n  const left = (px - radius) / CONFIG.TILE_SIZE | 0;\n  const right = (px + radius) / CONFIG.TILE_SIZE | 0;\n  const top = (py - radius) / CONFIG.TILE_SIZE | 0;\n  const bottom = (py + radius) / CONFIG.TILE_SIZE | 0;\n  \n  for (let y = top; y <= bottom; y++) {\n    for (let x = left; x <= right; x++) {\n      if (getTile(x, y) === TILE.CRATE) {\n        const obj = levelData.objects.find(o => o.type === 'crate' && o.x === x && o.y === y);\n        if (obj) {\n          const cx = x * CONFIG.TILE_SIZE + CONFIG.TILE_SIZE/2;\n          const cy = y * CONFIG.TILE_SIZE + CONFIG.TILE_SIZE/2;\n          const dx = cx - px;\n          const dy = cy - py;\n          const dist = Math.hypot(dx, dy);\n          const overlap = radius + CONFIG.TILE_SIZE/2 - dist;\n          if (overlap > 0 && dist > 0.001) {\n            const nx = dx / dist;\n            const ny = dy / dist;\n            const newCx = cx + nx * overlap * 1.01;\n            const newCy = cy + ny * overlap * 1.01;\n            const newTileX = (newCx / CONFIG.TILE_SIZE) | 0;\n            const newTileY = (newCy / CONFIG.TILE_SIZE) | 0;\n            if (getTile(newTileX, newTileY) === TILE.EMPTY) {\n              setTile(x, y, TILE.EMPTY);\n              setTile(newTileX, newTileY, TILE.CRATE);\n              obj.x = newTileX;\n              obj.y = newTileY;\n            }\n          }\n        }\n      }\n    }\n  }\n}\n\nfunction checkPlates() {\n  const px = player.x / CONFIG.TILE_SIZE | 0;\n  const py = player.y / CONFIG.TILE_SIZE | 0;\n  \n  levelData.objects.forEach(obj => {\n    if (obj.type === 'plate') {\n      const pressed = (obj.x === px && obj.y === py);\n      if (pressed !== obj.pressed) {\n        obj.pressed = pressed;\n        obj.linkedPlates.forEach(gateId => {\n          const gate = levelData.objects[gateId];\n          if (gate && gate.type === 'gate') {\n            gate.open = pressed;\n            setTile(gate.x, gate.y, pressed ? TILE.EMPTY : TILE.GATE);\n          }\n        });\n      }\n    }\n  });\n}\n\nfunction checkFragmentPickup() {\n  levelData.fragments.forEach(frag => {\n    if (frag.state === 'AVAILABLE') {\n      const dx = frag.wx - player.x;\n      const dy = frag.wy - player.y;\n      if (Math.hypot(dx, dy) < CONFIG.TILE_SIZE * 0.7) {\n        frag.state = 'HELD';\n        updateHUD();\n      }\n    }\n  });\n}\n\n// ==========================================\n// UPDATE LOOP\n// ==========================================\nfunction update(dt) {\n  if (!gameRunning) return;\n  \n  levelTime = performance.now() - levelStartTime;\n  \n  // Dash cooldown\n  if (dashCooldown > 0) {\n    dashCooldown -= dt;\n    if (dashCooldown < 0) dashCooldown = 0;\n  }\n  \n  // Dash active\n  if (dashTime > 0) {\n    dashTime -= dt;\n    player.vx = dashDir.x * CONFIG.DASH_SPEED;\n    player.vy = dashDir.y * CONFIG.DASH_SPEED;\n    if (dashTime <= 0) {\n      dashTime = 0;\n      player.vx *= 0.3;\n      player.vy *= 0.3;\n    }\n  } else {\n    // Normal movement\n    let ax = 0, ay = 0;\n    if (keys['KeyW'] || keys['ArrowUp']) ay -= 1;\n    if (keys['KeyS'] || keys['ArrowDown']) ay += 1;\n    if (keys['KeyA'] || keys['ArrowLeft']) ax -= 1;\n    if (keys['KeyD'] || keys['ArrowRight']) ax += 1;\n    \n    if (ax !== 0 || ay !== 0) {\n      const len = Math.hypot(ax, ay);\n      ax /= len; ay /= len;\n      player.vx += ax * CONFIG.ACCEL * dt;\n      player.vy += ay * CONFIG.ACCEL * dt;\n      const speed = Math.hypot(player.vx, player.vy);\n      if (speed > CONFIG.MAX_SPEED) {\n        player.vx = (player.vx / speed) * CONFIG.MAX_SPEED;\n        player.vy = (player.vy / speed) * CONFIG.MAX_SPEED;\n      }\n    } else {\n      const speed = Math.hypot(player.vx, player.vy);\n      if (speed > 0) {\n        const friction = Math.min(CONFIG.FRICTION * dt, speed);\n        player.vx -= (player.vx / speed) * friction;\n        player.vy -= (player.vy / speed) * friction;\n      }\n    }\n  }\n  \n  // Apply velocity\n  const newX = player.x + player.vx * dt;\n  const newY = player.y + player.vy * dt;\n  \n  // X collision\n  let collision = checkCollision(newX, player.y, player.radius);\n  if (collision) {\n    player.x += collision.x;\n    player.vx = 0;\n  } else {\n    player.x = newX;\n  }\n  \n  // Y collision\n  collision = checkCollision(player.x, newY, player.radius);\n  if (collision) {\n    player.y += collision.y;\n    player.vy = 0;\n  } else {\n    player.y = newY;\n  }\n  \n  // Push crates\n  pushCrates(player.x, player.y, player.radius, dt);\n  \n  // Check plates\n  checkPlates();\n  \n  // Check fragment pickup\n  checkFragmentPickup();\n  \n  // Camera follow\n  camera.x = player.x - CONFIG.VIEWPORT_W / 2;\n  camera.y = player.y - CONFIG.VIEWPORT_H / 2;\n  camera.x = Math.max(0, Math.min(camera.x, levelData.cols * CONFIG.TILE_SIZE - CONFIG.VIEWPORT_W));\n  camera.y = Math.max(0, Math.min(camera.y, levelData.rows * CONFIG.TILE_SIZE - CONFIG.VIEWPORT_H));\n  \n  updateHUD();\n}\n\n// ==========================================\n// RENDERING\n// ==========================================\nfunction render() {\n  // Resize canvas\n  const rect = canvas.getBoundingClientRect();\n  const dpr = window.devicePixelRatio || 1;\n  if (canvas.width !== rect.width * dpr || canvas.height !== rect.height * dpr) {\n    canvas.width = rect.width * dpr;\n    canvas.height = rect.height * dpr;\n    ctx.scale(dpr, dpr);\n  }\n  \n  const viewW = rect.width;\n  const viewH = rect.height;\n  \n  // Clear\n  ctx.fillStyle = levelData.def.palette.bg;\n  ctx.fillRect(0, 0, viewW, viewH);\n  \n  // Translate for camera\n  ctx.save();\n  ctx.translate(-camera.x, -camera.y);\n  \n  // Draw tiles\n  const startCol = (camera.x / CONFIG.TILE_SIZE) | 0;\  const endCol = Math.min(levelData.cols, ((camera.x + viewW) / CONFIG.TILE_SIZE) | 0 + 1);\n  const startRow = (camera.y / CONFIG.TILE_SIZE) | 0;\n  const endRow = Math.min(levelData.rows, ((camera.y + viewH) / CONFIG.TILE_SIZE) | 0 + 1);\n  \n  // Background grid pattern\n  ctx.fillStyle = levelData.def.palette.wall;\n  for (let y = startRow; y < endRow; y++) {\n    for (let x = startCol; x < endCol; x++) {\n      const tile = getTile(x, y);\n      const tx = x * CONFIG.TILE_SIZE;\n      const ty = y * CONFIG.TILE_SIZE;\n      \n      if (tile === TILE.WALL) {\n        ctx.fillRect(tx, ty, CONFIG.TILE_SIZE, CONFIG.TILE_SIZE);\n        // Subtle pattern\n        ctx.fillStyle = 'rgba(255,255,255,0.02)';\n        ctx.fillRect(tx + 4, ty + 4, CONFIG.TILE_SIZE - 8, CONFIG.TILE_SIZE - 8);\n        ctx.fillStyle = levelData.def.palette.wall;\n      } else if (tile === TILE.GATE) {\n        ctx.fillStyle = levelData.def.palette.accent;\n        ctx.globalAlpha = 0.6;\n        ctx.fillRect(tx + 2, ty + 2, CONFIG.TILE_SIZE - 4, CONFIG.TILE_SIZE - 4);\n        ctx.globalAlpha = 1;\n        ctx.fillStyle = levelData.def.palette.wall;\n      } else if (tile === TILE.PLATE) {\n        ctx.fillStyle = levelData.def.palette.accent2;\n        ctx.beginPath();\n        ctx.arc(tx + CONFIG.TILE_SIZE/2, ty + CONFIG.TILE_SIZE/2, CONFIG.TILE_SIZE/3, 0, Math.PI*2);\n        ctx.fill();\n        ctx.fillStyle = levelData.def.palette.wall;\n      } else if (tile === TILE.CRATE) {\n        ctx.fillStyle = '#3A3F5A';\n        ctx.fillRect(tx + 4, ty + 4, CONFIG.TILE_SIZE - 8, CONFIG.TILE_SIZE - 8);\n        ctx.strokeStyle = '#5A5F7A';\n        ctx.lineWidth = 2;\n        ctx.strokeRect(tx + 6, ty + 6, CONFIG.TILE_SIZE - 12, CONFIG.TILE_SIZE - 12);\n        ctx.fillStyle = levelData.def.palette.wall;\n      } else if (tile === TILE.PEDESTAL) {\n        ctx.fillStyle = levelData.def.palette.accent2;\n        ctx.fillRect(tx + 6, ty + 6, CONFIG.TILE_SIZE - 12, CONFIG.TILE_SIZE - 12);\n        ctx.fillStyle = levelData.def.palette.wall;\n      }\n    }\n  }\n  \n  // Draw fragments (world)\n  levelData.fragments.forEach(frag => {\n    if (frag.state === 'AVAILABLE') {\n      frag.bobPhase += 0.003;\n      const bob = Math.sin(frag.bobPhase) * 4;\n      ctx.save();\n      ctx.translate(frag.wx, frag.wy + bob);\n      ctx.rotate(frag.bobPhase * 0.1);\n      \n      // Glow\n      const grad = ctx.createRadialGradient(0, 0, 0, 0, 0, 24);\n      grad.addColorStop(0, frag.glowColor + '80');\n      grad.addColorStop(1, frag.glowColor + '00');\n      ctx.fillStyle = grad;\n      ctx.beginPath();\n      ctx.arc(0, 0, 24, 0, Math.PI*2);\n      ctx.fill();\n      \n      // Fragment image\n      const img = new Image();\n      img.src = frag.imgSrc;\n      if (img.complete) {\n        ctx.drawImage(img, -16, -16, 32, 32);\n      }\n      ctx.restore();\n    }\n  });\n  \n  // Draw player\n  ctx.save();\n  ctx.translate(player.x, player.y);\n  \n  // Dash trail\n  if (dashTime > 0) {\n    for (let i = 0; i < 5; i++) {\n      ctx.globalAlpha = 0.15 * (1 - i/5);\n      ctx.fillStyle = levelData.def.palette.accent2;\n      ctx.beginPath();\n      ctx.arc(-dashDir.x * i * 8, -dashDir.y * i * 8, player.radius * (1 - i/5), 0, Math.PI*2);\n      ctx.fill();\n    }\n    ctx.globalAlpha = 1;\n  }\n  \n  // Player body\n  const grad = ctx.createRadialGradient(-4, -4, 0, 0, 0, player.radius);\n  grad.addColorStop(0, '#ffffff');\n  grad.addColorStop(0.5, levelData.def.palette.accent);\n  grad.addColorStop(1, levelData.def.palette.accent2);\n  ctx.fillStyle = grad;\n  ctx.beginPath();\n  ctx.arc(0, 0, player.radius, 0, Math.PI*2);\n  ctx.fill();\n  \n  // Core\n  ctx.fillStyle = 'rgba(255,255,255,0.9)';\n  ctx.beginPath();\n  ctx.arc(-2, -2, player.radius * 0.3, 0, Math.PI*2);\n  ctx.fill();\n  \n  ctx.restore();\n  \n  ctx.restore(); // camera\n  \n  // Screen shake on dash\n  if (dashTime > 0.1) {\n    ctx.save();\n    ctx.translate((Math.random()-0.5)*4, (Math.random()-0.5)*4);\n    ctx.restore();\n  }\n}\n\n// ==========================================\n// MAIN LOOP\n// ==========================================\nfunction gameLoop(timestamp) {\n  if (!lastTimestamp) lastTimestamp = timestamp;\n  const dt = Math.min((timestamp - lastTimestamp) / 1000, 0.05);\n  lastTimestamp = timestamp;\n  \n  update(dt);\n  render();\n  \n  animationId = requestAnimationFrame(gameLoop);\n}\n\n// ==========================================\n// INPUT HANDLING\n// ==========================================\nwindow.addEventListener('keydown', e => {\n  keys[e.code] = true;\n  \n  if (e.code === 'Space' && dashCooldown <= 0 && dashTime <= 0 && gameRunning) {\n    // Dash in movement direction or facing direction\n    let dx = 0, dy = 0;\n    if (keys['KeyW'] || keys['ArrowUp']) dy -= 1;\n    if (keys['KeyS'] || keys['ArrowDown']) dy += 1;\n    if (keys['KeyA'] || keys['ArrowLeft']) dx -= 1;\n    if (keys['KeyD'] || keys['ArrowRight']) dx += 1;\n    \n    if (dx === 0 && dy === 0) {\n      // Dash in last movement direction\n      const speed = Math.hypot(player.vx, player.vy);\n      if (speed > 10) { dx = player.vx / speed; dy = player.vy / speed; }\n      else { dx = 1; dy = 0; }\n    } else {\n      const len = Math.hypot(dx, dy);\n      dx /= len; dy /= len;\n    }\n    \n    dashDir = { x: dx, y: dy };\n    dashTime = CONFIG.DASH_DURATION;\n    dashCooldown = CONFIG.DASH_COOLDOWN;\n    updateHUD();\n  }\n  \n  if (e.code === 'Tab') {\n    e.preventDefault();\n    toggleRestoration();\n  }\n  \n  if (e.code === 'Escape') {\n    if (showRestoration) closeRestoration();\n    else if (gameRunning) showTitleScreen();\n  }\n});\n\nwindow.addEventListener('keyup', e => {\n  keys[e.code] = false;\n});\n\n// Touch controls for mobile\nlet touchStart = null;\ncanvas.addEventListener('