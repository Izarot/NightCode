  "src/index.js": "import { Game } from './game.js';\nimport { initAudio } from './audio.js';\nimport { loadHighScore } from './storage.js';\nimport { saveHighScore } from './storage.js';\nimport { updateTimer } from './timer.js';\n\n// Initialize audio context (must be done before any sound)\ninitAudio();\n\n// Create and start the game\nconst game = new Game({\n    canvasId: 'gameCanvas',\n    width: window.innerWidth,\n    height: window.innerHeight\n});\n\nwindow.addEventListener('resize', () => {\n    const canvas = document.getElementById('gameCanvas');\n    canvas.width = window.innerWidth;\n    canvas.height = window.innerHeight;\n    game.resize(canvas.width, canvas.height);\n});\n\ngame.start();",
  "src/game.js": "import { AppState } from './state.js';\nimport { GridManager } from './grid.js';\nimport { SnakeController } from './snake.js';\nimport { AppleManager } from './apple.js';\nimport { ParticleSystem } from './particles.js';\nimport { UIDrawer } from './ui.js';\nimport { SpeedrunTimer } from './timer.js';\n\nclass Game {\n    constructor(options) {\n        this.canvas = options.canvas;\n        this.state = new AppState();\n        this.grid = new GridManager(this.canvas);\n        this.snake = new SnakeController(this.grid);\n        this.apples = new AppleManager(this.grid);\n        this.particles = new ParticleSystem();\n        this.ui = new UIDrawer();\n        this.timer = new SpeedrunTimer();\n        this.speedrunTimer = new SpeedrunTimer();\n        this.loadHighScore();\n    }\n\n    async start() {\n        // Load high score on startup\n        const savedScore = await loadHighScore();\n        this.state.highScore = savedScore || 0;\n        this.ui.updateHighScore(savedScore);\n\n        this.state.mode = 'MENU';\n        this.ui.showMenu();\n        \n        // Start the main game loop\n        this.gameLoop();\n    }\n\n    gameLoop() {\n        requestAnimationFrame(() => {\n            this.update();\n            this.render();\n        });\n    }\n\n    update() {\n        // Accumulate delta time\n        const dt = this.timer.getDeltaTime();\n        \n        // Update game state based on delta time\n        this.state.update(dt);\n        \n        // Update timer display\n        this.speedrunTimer.update(dt);\n        this.ui.updateTimer();\n        \n        // Check for game over conditions\n        if (this.state.isGameOver()) {\n            this.handleGameOver();\n        }\n    }\n\n    render() {\n        const ctx = this.canvas.getContext('2d');\n        ctx.clearRect(0, 0, this.canvas.width, this.canvas.height);\n        \n        // Render background and grid\n        this.grid.draw(ctx);\n        \n        // Render apples\n        this.apples.render(ctx);\n        \n        // Render particles\n        this.particles.update();\n        this.particles.draw(ctx);\n        \n        // Render snake\n        this.snake.draw(ctx);\n        \n        // Render speedrun timer\n        this.speedrunTimer.draw(ctx);\n        \n        // Render UI elements\n        this.ui.draw(ctx);\n    }\n\n    handleGameOver() {\n        this.state.mode = 'GAMEOVER';\n        this.ui.showGameOverScreen();\n        this.saveHighScore();\n    }\n}\n\nexport default Game;",
  "src/state.js": "export class AppState {\n    constructor() {\n        this.mode = 'MENU'; // MENU | PLAYING | PAUSED | GAMEOVER\n        this.score = 0;\n        this.length = 3;\n        this.hunger = 10; // 0-100\n        this.highScore = 0;\n        this.isRunning = false;\n        this.lastTick = 0;\n        this.inputBuffer = [];\n        this.maxBufferSize = 2;\n        this.previousDirection = null;\n    }\n\n    setMode(mode) {\n        this.mode = mode;\n        this.isRunning = mode === 'PLAYING';\n        if (mode === 'PAUSED') {\n            this.paused = true;\n        }\n    }\n\n    getMode() {\n        return this.mode;\n    }\n\n    update(deltaTime) {\n        if (!this.isRunning || this.mode !== 'PLAYING') return;\n        \n        // Process input buffer\n        this.processInputBuffer(deltaTime);\n        \n        // Move snake based on current direction\n        if (this.snake && this.snake.head) {\n            const dir = this.snake.direction;\n            this.snake.move(dir);\n        }\n        \n        // Update hunger\n        this.updateHunger(deltaTime);\n        \n        // Spawn apples\n        this.spawnApple(deltaTime);\n        \n        // Check for collisions\n        this.checkCollisions();\n        \n        // Update timer\n        this.timer.update(deltaTime);\n    }\n\n    processInputBuffer(deltaTime) {\n        // Apply buffered inputs\n        for (let i = 0; i < this.inputBuffer.length; i++) {\n            const move = this.inputBuffer[i];\n            if (move.valid && !this.isBlocked(move)) {\n                this.snake.setDirection(move);\n            }\n            // Remove processed input\n            this.inputBuffer.shift();\n        }\n        \n        // Cap buffer size\n        if (this.inputBuffer.length > this.maxBufferSize) {\n            this.inputBuffer.shift();\n        }\n    }\n\n    checkCollisions() {\n        const head = this.snake?.head;\n        if (!head) return;\n        \n        // Wall collision\n        if (this.grid.isWallAt(head.x, head.y)) {\n            this.endGame();\n            return;\n        }\n        \n        // Self collision\n        if (this.snake) {\n            for (const seg of this.snake.segments) {\n                if (seg.x === head.x && seg.y === head.y) {\n                    this.endGame();\n                    return;\n                }\n            }\n        }\n    }\n\n    updateHunger(deltaTime) {\n        // Hunger decays every 4 seconds (15 ticks)\n        if (deltaTime >= 4) {\n            this.hunger += 1;\n            this.updateHungerVisual();\n        }\n        \n        // Starvation damage\n        if (this.hunger >= 100) {\n            this.hp -= 1;\n            if (this.hp <= 0) {\n                this.endGame();\n                return;\n            }\n        }\n    }\n\n    spawnApple(deltaTime) {\n        // Check if we can spawn an apple\n        if (this.apples.isEmpty() && !this.isAppleStarved()) {\n            const apple = this.apples.createRandom();\n            if (apple) {\n                this.apples.add(apple);\n            }\n        }\n    }\n\n    isAppleStarved() {\n        // Check if it's been more than 60 seconds since last apple\n        if (this.lastAppleTime === null) return false;\n        return Date.now() - this.lastAppleTime > 60000;\n    }\n\n    updateHungerVisual() {\n        // Update color based on hunger level\n        const progress = Math.min(this.hunger / 100, 1);\n        let color = '#00ff88'; // Neon green\n        if (progress > 0.5) color = '#ff3366'; // Pink (starving)\n        else if (progress > 0.2) color = '#ffaa00'; // Orange (low)\n        \n        // Update the hunger bar width\n        this.ui.hungerBar.style.width = `${progress * 100}%`;\n        \n        // Update hunger level label\n        const levels = ['Level 1', 'Level 2', 'Level 3'];\n        this.ui.hungerLevel.textContent = levels[Math.min(this.hunger / 50, 2)];\n    }\n\n    endGame() {\n        this.isRunning = false;\n        this.state.mode = 'GAMEOVER';\n        this.saveHighScore();\n    }\n\n    showGameOverScreen() {\n        this.ui.showGameOverScreen();\n    }\n\n    showMenu() {\n        this.ui.showMenu();\n    }\n\n    showPauseScreen() {\n        this.ui.showPauseScreen();\n    }\n\n    updateTimer() {\n        this.speedrunTimer.update();\n    }\n}\n\nexport default AppState;",
  "src/grid.js": "export class GridManager {\n    constructor(canvas) {\n        this.canvas = canvas;\n        this.tiles = 40;\n        this.cellSize = 24;\n        this.grid = Array.from({ length: this.tiles }, () => Array(this.tiles).fill(null));\n        this.walls = [];\n        this.initGrid();\n    }\n\n    initGrid() {\n        // Initialize empty grid\n        for (let x = 0; x < this.tiles; x++) {\n            for (let y = 0; y < this.tiles; y++) {\n                this.grid[x][y] = null;\n            }\n        }\n        \n        // Place static walls (15% of grid cells)\n        const totalCells = this.tiles * this.tiles;\n        const wallCount = Math.floor(totalCells * 0.15);\n        for (let i = 0; i < wallCount; i++) {\n            const tx = Math.floor(i * this.tiles / wallCount);\n            const ty = Math.floor(i * this.tiles / wallCount);\n            this.placeWall(tx, ty);\n        }\n    }\n\n    placeWall(x, y) {\n        if (x < 0 || x >= this.tiles || y < 0 || y >= this.tiles) return;\n        if (this.grid[x][y] || this.walls.includes(`${x},${y}`)) return;\n        \n        this.grid[x][y] = true;\n        this.walls.push({ x, y });\n    }\n\n    isWallAt(x, y) {\n        if (x < 0 || x >= this.tiles || y < 0 || y >= this.tiles) return true;\n        return this.grid[x][y] || this.walls.some(w => w.x === x && w.y === y);\n    }\n\n    getCell(x, y) {\n        if (x < 0 || x >= this.tiles || y < 0 || y >= this.tiles) return null;\n        return this.grid[x][y];\n    }\n\n    getEmptyCells() {\n        const cells = [];\n        for (let x = 0; x < this.tiles; x++) {\n            for (let y = 0; y < this.tiles; y++) {\n                if (!this.grid[x][y] && !this.isWallAt(x, y)) {\n                    cells.push({ x, y });\n                }\n            }\n        }\n        return cells;\n    }\n\n    getRandomEmptyCell() {\n        const cells = this.getEmptyCells();\n        if (cells.length === 0) return null;\n        return cells[Math.floor(Math.random() * cells.length)];\n    }\n}", 
  "src/snake.js": "export class SnakeController {\n    constructor(grid) {\n        this.grid = grid;\n        this.length = 3;\n        this.direction = { x: 1, y: 0 }; // Starting direction: right\n        this.segments = []; // Array of {x, y} positions\n        this.headIndex = 0;\n        this.nextSegmentIndex = 0;\n        this.grow = false;\n    }\n\n    setDirection(dir) {\n        // Prevent 180-degree turns\n        if (dir.x === -this.direction.x && dir.y === -this.direction.y) return;\n        this.direction = { ...dir };\n        \n        // If already moving in same direction, keep it\n        if (this.direction.x === dir.x && this.direction.y === dir.y) return;\n    }\n\n    addSegment() {\n        // Add new head segment\n        const head = { x: this.segments[this.headIndex].x + this.direction.x, \n                      y: this.segments[this.headIndex].y + this.direction.y };\n        this.segments.push(head);\n    }\n\n    removeTail() {\n        if (this.segments.length > 1) {\n            this.segments.pop();\n        }\n    }\n\n    move(newDir) {\n        // Validate input\n        if (newDir.x === -this.direction.x && newDir.y === -this.direction.y) return;\n        \n        // If growing, don't remove tail yet\n        if (this.grow) {\n            this.addSegment();\n        } else {\n            this.removeTail();\n        }\n        \n        // Set new direction\n        this.setDirection(newDir);\n        this.headIndex = 0; // Point to new head\n    }\n\n    grow() {\n        this.grow = true;\n    }\n\n    update() {\n        // If we're growing, we don't need to remove tail immediately\n        // This will happen naturally when adding new segments\n    }\n\n    getPosition(index) {\n        return this.segments[index];\n    }\n\n    getLength() {\n        return this.segments.length;\n    }\n}", 
  "src/apple.js": "export class AppleManager {\n    constructor(grid) {\n        this.grid = grid;\n        this.apples = [];\n        this.lastAppleTime = null;\n        this.activeApple = null;\n    }\n\n    createRandom() {\n        const cells = this.grid.getEmptyCells();\n        if (cells.length === 0) return null;\n        \n        const cell = cells[Math.floor(Math.random() * cells.length)];\n        const [x, y] = cell;\n        \n        // Check if cell is not a wall\n        if (this.grid.getCell(x, y)) return null;\n        \n        // Create apple\n        const appleType = this.determineAppleType();\n        const apple = {\n            x, y,\n            type: appleType,\n            createdAt: Date.now()\n        };\n        \n        this.apples.push(apple);\n        this.activeApple = apple;\n        return apple;\n    }\n\n    determineAppleType() {\n        // Normal apple (green)\n        if (this.snake.length === 0) return 'normal';\n        \n        // Golden apple (rare) - only if no apple has been eaten recently\n        if (this.lastAppleTime === null) return 'golden';\n        \n        // Check if there's been less than 60 seconds since last apple\n        const elapsed = Date.now() - this.lastAppleTime;\n        if (elapsed < 60000) return 'normal';\n        \n        // Desperation mode - higher chance of golden apple\n        if (this.snake.length > 10) return 'golden';\n        \n        return 'normal';\n    }\n\n    isAppleStarved() {\n        if (this.lastAppleTime === null) return false;\n        return Date.now() - this.lastAppleTime > 60000;\n    }\n\n    spawnApple(deltaTime) {\n        // Only spawn if no apple is currently active\n        if (this.activeApple) return false;\n        \n        const apple = this.createRandom();\n        if (apple) {\n            this.activeApple = apple;\n            return apple;\n        }\n        return null;\n    }\n\n    update() {\n        if (this.activeApple) {\n            // Update apple position (simulated movement)\n            // In this version, apples stay stationary until eaten\n            // But we could add slight drift for variety\n        }\n    }\n}", 
  "src/particles.js": "export class ParticleSystem {\n    constructor() {\n        this.particles = [];\n        this.maxParticles = 50;\n    }\n\n    createParticle(x, y, color, velocity, lifetime, rotation) {\n        const particle = {\n            x,\n            y,\n            vx: velocity.x,\n            vy: velocity.y,\n            life: lifetime,\n            maxLife: lifetime,\n            color,\n            size: 3 + Math.random() * 2,\n            rotation: rotation || Math.random() * Math.PI * 2\n        };\n        this.particles.push(particle);\n        return particle;\n    }\n\n    update() {\n        for (let i = this.particles.length - 1; i >= 0; i--) {\n            const p = this.particles[i];\n            \n            // Apply physics\n            p.vx += p.vy * 0.05; // Gravity-like pull\n            p.vy += p.vx * 0.03; // Curve away\n            \n            p.x += p.vx;\n            p.y += p.vy;\n            \n            // Friction\n            p.vx *= 0.95;\n            p.vy *= 0.95;\n            \n            // Decrease life\n            p.life--;\n            \n            // Remove dead particles\n            if (p.life <= 0) {\n                this.particles.splice(i, 1);\n                continue;\n            }\n        }\n    }\n\n    draw(ctx) {\n        for (const p of this.particles) {\n            if (p.life > 0) {\n                const alpha = p.life / p.maxLife;\n                ctx.fillStyle = p.color;\n                ctx.globalAlpha = alpha;\n                ctx.beginPath();\n                ctx.arc(p.x, p.y, p.size * (alpha * 0.8), 0, Math.PI * 2);\n                ctx.fill();\n                ctx.globalAlpha = 1;\n            }\n        }\n    }\n}", 
  "src/ui.js": "export class UIDrawer {\n    constructor() {\n        this.canvas = document.querySelector('#gameCanvas');\n        this.resetHUD();\n    }\n\n    resetHUD() {\n        this.scoreEl = document.getElementById('score');\n        this.highScoreEl = document.getElementById('high-score');\n        this.hungerBar = document.getElementById('hunger-bar');\n        this.hungerLevel = document.getElementById('hunger-level');\n        this.lengthEl = document.getElementById('length');\n        this.heartIndicator = document.getElementById('heart-indicator');\n        \n        this.updateScore();\n        this.updateHighScore();\n    }\n\n    updateScore() {\n        this.scoreEl.textContent = this.state.score;\n    }\n\n    updateHighScore() {\n        this.highScoreEl.textContent = this.state.highScore;\n    }\n\n    updateHungerBar() {\n        const progress = Math.min(this.state.hunger / 100, 1);\n        this.hungerBar.style.width = `${progress * 100}%`;\n        \n        // Heart indicator for low HP\n        if (this.state.hp < 50) {\n            this.heartIndicator.style.display = 'block';\n        } else {\n            this.heartIndicator.style.display = 'none';\n        }\n    }\n\n    showScore() {\n        this.scoreEl.textContent = this.state.score;\n    }\n\n    showHighScore() {\n        this.highScoreEl.textContent = this.state.highScore;\n    }\n\n    showGameOverScreen() {\n        this.showHUD();\n        document.getElementById('final-score').textContent = this.state.score;\n        document.getElementById('survival-time').textContent = this.state.time;\n    }\n\n    showPauseScreen() {\n        this.showHUD();\n        document.getElementById('final-score').textContent = this.state.score;\n        document.getElementById('survival-time').textContent = this.state.time;\n    }\n\n    showMenu() {\n        this.showHUD();\n    }\n\n    showHUD() {\n        this.scoreEl.textContent = this.state.score;\n        this.highScoreEl.textContent = this.state.highScore;\n        this.hungerBar.style.width = `${Math.min(this.state.hunger / 100, 1) * 100}%`;\n        this.hungerLevel.textContent = `Level ${Math.min(Math.floor(this.state.hunger / 50) + 1)}`;\n        this.lengthEl.textContent = this.state.length;\n        \n        // Heart animation when low HP\n        if (this.state.hp < 50) {\n            this.heartIndicator.style.animation = 'pulse 1s infinite';\n        } else {\n            this.heartIndicator.style.animation = 'none';\n        }\n    }\n\n    draw(ctx) {\n        // Clear canvas\n        ctx.fillStyle = '#121212';\n        ctx.fillRect(0, 0, this.canvas.width, this.canvas.height);\n        \n        // Draw grid lines\n        this.drawGridLines(ctx);\n        \n        // Draw speedrun timer in top left\n        this.drawSpeedrunTimer(ctx);\n    }\n\n    drawGridLines(ctx) {\n        const cellSize = this.canvas.width / this.state.tiles;\n        const gap = 1;\n        \n        for (let x = 0; x <= this.state.tiles; x++) {\n            ctx.beginPath();\n            ctx.moveTo(x * cellSize + gap, 0);\n            ctx.lineTo(x * cellSize + gap, this.canvas.height);\n            ctx.strokeStyle = '#1e1e1e';\n            ctx.lineWidth = 1;\n            ctx.stroke();\n        }\n        \n        for (let y = 0; y <= this.state.tiles; y++) {\n            ctx.beginPath();\n            ctx.moveTo(0, y * cellSize + gap);\n            ctx.lineTo(this.canvas.width, y * cellSize + gap);\n            ctx.strokeStyle = '#1e1e1e';\n            ctx.lineWidth = 1;\n            ctx.stroke();\n        }\n    }\n\n    drawSpeedrunTimer(ctx) {\n        // Simple timer display\n        const timeStr = this.speedrunTimer.formatTime();\n        ctx.font = 'bold 14px monospace';\n        ctx.fillStyle = '#ffffff';\n        ctx.textAlign = 'left';\n        ctx.fillText(timeStr, 10, 20);\n    }\n}"\n, "src/audio.js": "export function initAudio() {\n    // Create audio context only once\n    if (!Window.AudioContext) {\n        window.AudioContext = new (window.AudioContext || window.webkitAudioContext);\n    }\n    \n    // Ensure audio context is resumed (required for autoplay policies)\n    const audioCtx = Window.AudioContext;\n    if (audioCtx.state === 'suspended') {\n        audioCtx.resume();\n    }\n}\n\nexport function playSound(type) {\n    const audioCtx = Window.AudioContext;\n    if (!audioCtx) return;\n    \n    const osc = audioCtx.createOscillator();\n    const gainNode = audioCtx.createGain();\n    \n    osc.connect(gainNode);\n    gainNode.connect(audioCtx.destination);\n    \n    switch (type) {\n        case 'eat':\n            // High sine ping\n            osc.type = 'sine';\n            osc.frequency.setValueAtTime(2000, audioCtx.currentTime);\n            osc.frequency.exponentialRampToValueAtTime(4000, audioCtx.currentTime + 0.1);\n            gainNode.gain.setValueAtTime(0.1, audioCtx.currentTime);\n            gainNode.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.1);\n            osc.start();\n            osc.stop(audioCtx.currentTime + 0.1);\n            break;\n            \n        case 'golden-eat':\n            // Chord: 2000Hz + 3000Hz\n            const osc1 = audioCtx.createOscillator();\n            const osc2 = audioCtx.createOscillator();\n            osc1.type = 'sine';\n            osc2.type = 'sine';\n            osc1.frequency.value = 2000;\n            osc2.frequency.value = 3000;\n            osc1.gain.setValueAtTime(0.15, audioCtx.currentTime);\n            osc2.gain.setValueAtTime(0.15, audioCtx.currentTime);\n            osc1.start();\n            osc2.start();\n            osc1.stop(audioCtx.currentTime + 0.3);\n            osc2.stop(audioCtx.currentTime + 0.3);\n            break;\n            \n        case 'hunger-warning':\n            // Low pulse\n            osc.type = 'triangle';\n            osc.frequency.setValueAtTime(100, audioCtx.currentTime);\n            gainNode.gain.setValueAtTime(0.05, audioCtx.currentTime);\n            gainNode.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 0.5);\n            osc.start();\n            osc.stop(audioCtx.currentTime + 0.5);\n            break;\n            \n        case 'death':\n            // Low saw-wave crash\n            osc.type = 'sawtooth';\n            osc.frequency.setValueAtTime(100, audioCtx.currentTime);\n            gainNode.gain.setValueAtTime(0.2, audioCtx.currentTime);\n            gainNode.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.3);\n            osc.start();\n            osc.stop(audioCtx.currentTime + 0.3);\n            break;\n    }\n}\n\nexport function playSoundEffect(type) {\n    if (audioCtx) {\n        playSound(type);\n    }\n}"\n, "src/timer.js": "export class SpeedrunTimer {\n    constructor() {\n        this.startTime = 0;\n        this.currentTime = 0;\n        this.totalTime = 0;\n    }\n\n    formatTime() {\n        const minutes = Math.floor(this.currentTime / 60000);\n        const seconds = Math.floor((this.currentTime % 60000) / 1000);\n        const hms = minutes > 0 ? `${minutes.toString().padStart(2, '0')}:` : '';\n        return `${hms}${seconds.toString().padStart(2, '0')}`;\n    }\n\n    start() {\n        this.startTime = performance.now();\n    }\n\n    stop() {\n        this.currentTime = performance.now();\n    }\n\n    update(deltaTime) {\n        this.currentTime += deltaTime;\n    }\n\n    getDuration() {\n        return this.currentTime - this.startTime;\n    }\n}"\n}\n", "dist/index.js": "// Minified/dist version - would be built from src/\n// For development, use src/index.js directly\n// This is a placeholder for production distribution\nconsole.log('HUNGER GRID ready - game initialized');\n""}"version": "1.0.0"
