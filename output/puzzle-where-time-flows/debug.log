// src/time.js
class RoomClock {
  constructor() {
    this.value = 0;
    this.timeScale = 1;
  }
  update(dt) {
    if (this.timeScale > 0) {
      this.value += dt * this.timeScale;
      if (this.value >= 1) this.value -= Math.floor(this.value);
    } else {
      // rewind - value decreases
      this.value -= dt * Math.abs(this.timeScale);
      if (this.value < 0) this.value += 1;
    }
  }
  cycleTimeScale() {
    const scales = [1, 2, 0.5, -1];
    const idx = scales.indexOf(this.timeScale);
    this.timeScale = scales[(idx + 1) % scales.length];
    return this.timeScale;
  }
  get displayLabel() {
    if (this.timeScale === 1) return '1x';
    if (this.timeScale === 2) return '2x';
    if (this.timeScale === 0.5) return '0.5x';
    if (this.timeScale === -1) return 'Rewind';
    return '';
  }
}


