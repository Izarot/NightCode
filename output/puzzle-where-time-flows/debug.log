```javascript
class RoomClock {
  constructor() {
    this.value = 0;
    this.timeScale = 1;
  }
  update(dt) {
    const s = this.timeScale;
    if (s > 0) {
      this.value += dt * s;
      while (this.value >= 1) this.value -= 1;
    } else if (s < 0) {
      this.value -= dt * Math.abs(s);
      while (this.value < 0) this.value += 1;
    }
  }
  cycleTimeScale() {
    const seq = [1, 2, 0.5, -1];
    const idx = seq.indexOf(this.timeScale);
    this.timeScale = seq[(idx + 1) % seq.length];
    return this.timeScale;
  }
  get displayLabel() {
    if (this.timeScale === 1) return '1x';
    if (this.timeScale === 2) return '2x';
    if (this.timeScale === 0.5) return '0.5x';
    if (this.timeScale === -1) return 'Rewind';
    return '';
  }
}
```

src/input.js:
```javascript
const Input = {
  keys: {},
  mouseX: 0,
  mouseY: 0,
  mouseDown: false,
  mouseClicked: false,
  init(canvas) {
    window.addEventListener('keydown', e => {
      this.keys[e.code] = true;
      if (e.code === 'ShiftLeft' || e.code === 'ShiftRight') {
        e.preventDefault();
      }
    });
    window.addEventListener('keyup', e => {
      this.keys[e.code] = false;
    });
    canvas.addEventListener('mousemove', e => {
      const rect = canvas.getBoundingClientRect();
      this.mouseX = (e.clientX - rect.left) * (canvas.width / rect.width);
      this.mouseY = (e.clientY - rect.top) * (canvas.height / rect.height);
    });
    canvas.addEventListener('mousedown', e => {
      this.mouseDown = true;
      this.mouseClicked = true;
    });
    canvas.addEventListener('mouseup', () => {
      this.mouseDown = false;
    });
    canvas.addEventListener('touchstart', e => {
      e.preventDefault();
      const t = e.touches[0];
      const rect = canvas.getBoundingClientRect();
      this.mouseX = (t.clientX - rect.left) * (canvas.width / rect.width);
      this.mouseY = (t.clientY - rect.top) * (canvas.height / rect.height);
      this.mouseDown = true;
      this.mouseClicked = true;
    }, { passive: false });
    canvas.addEventListener('touchmove', e => {
      e.preventDefault();
      const t = e.touches[0];
      const rect = canvas.getBoundingClientRect();
      this.mouseX = (t.clientX - rect.left) * (canvas.width / rect.width);
      this.mouseY = (t.clientY - rect.top) * (canvas.height / rect.height);
    }, { passive: false });
    canvas.addEventListener('touchend', e => {
      e.preventDefault();
      this.mouseDown = false;
    }, { passive: false });
  },
  consumeClick() {
    const c = this.mouseClicked;
    this.mouseClicked = false;
    return c;
  },
  isDown(code) { return !!this.keys[code]; }
};
```

src/physics.js:
```javascript
const Physics = {
  ACCEL: 1200,
  FRICTION: 1800,
  MAX_SPEED: 280,
  updatePlayer(player, input, room, dt) {
    const ts = room.clock.timeScale;
    const accel = Physics.ACCEL * Math.abs(ts);
    const maxSpeed = Physics.MAX_SPEED * Math.sqrt(Math.abs(ts));
    let ax = 0, ay = 0;
    if (input.isDown('KeyW') || input.isDown('ArrowUp')) ay -= 1;
    if (input.isDown('KeyS') || input.isDown('ArrowDown')) ay += 1;
    if (input.isDown('KeyA') || input.isDown('ArrowLeft')) ax -= 1;
    if (input.isDown('KeyD') || input.isDown('ArrowRight')) ax += 1;
    if (ax !== 0 && ay !== 0) { ax *= 0.707; ay *= 0.707; }
    player.vx += ax * accel * dt;
    player.vy += ay * accel * dt;
    const sp = Math.sqrt(player.vx * player.vx + player.vy * player.vy);
    if (sp > maxSpeed) {
      player.vx = (player.vx / sp) * maxSpeed;
      player.vy = (player.vy / sp) * maxSpeed;
    }
    if (ax === 0 && ay === 0) {
      const f = Physics.FRICTION;
      player.vx *= Math.exp(-f * dt);
      player.vy *= Math.exp(-f * dt);
      if (Math.abs(player.vx) < 1 && Math.abs(player.vy) < 1) {
        player.vx = 0; player.vy = 0;
      }
    }
    player.x += player.vx * dt;
    player.y += player.vy * dt;
    // collision with walls
    const r = room.bounds;
    if (player.x < r.x + player.w) player.x = r.x + player.w;
    if (player.x > r.x + r.w - player.h) player.x = r.x + r.w - player.h;
    if (player.y < r.y + player.h) player.y = r.y + player.h;
    if (player.y > r.y + r.h - player.w) player.y = r.y + r.h - player.h;
  },
  checkAABB(a, b) {
    return a.x < b.x + b.w && a.x + a.w > b.x &&
           a.y < b.y + b.h && a.y + a.h > b.y;
  }
};
```

