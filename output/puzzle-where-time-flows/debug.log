class Particle {
  constructor(x, y, vx, vy, life, color) {
    this.x = x; this.y = y;
    this.vx = vx; this.vy = vy;
    this.life = life; this.maxLife = life;
    this.color = color;
    this.clockOffset = 0; // offset from room clock
  }
  update(dt, timeScale) {
    const ts = timeScale || 1;
    this.life -= dt * Math.abs(ts);
    this.x += this.vx * dt * Math.sign(ts || 1);
    this.y += this.vy * dt * Math.sign(ts || 1);
    if (this.life <= 0) return false;
    return true;
  }
}
```

