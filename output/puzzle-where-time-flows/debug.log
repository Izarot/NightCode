Let me write the entity update functions:

```javascript
function updateEntity(e, room, dt) {
  const clock = room.clock;
  switch(e.type) {
    case 'door':
      // door opens when latch hasn't been dropped yet
      // latch drops based on clock value crossing threshold
      if (clock.value > 0.5 && e.latchDropped) {
        e.open = true;
      }
      break;
    case 'platform':
      // oscillates based on clock
      const t = clock.value;
      e.x = e.baseX + Math.sin(t * Math.PI * 2 * e.speed) * e.range;
      break;
    case 'hazard':
      // spikes rise/fall based on clock
      const ht = clock.value;
      e.visible = ht < 0.3 || ht > 0.7;
      break;
    case 'switch':
      // toggles when clock passes threshold
      if (clock.value > 0.5) {
        e.flipped = !e.flipped;
      }
      break;
    case 'portal':
      // active when clock in certain range
      e.active = clock.value > 0.2 && clock.value < 0.8;
      break;
  }
}
```

