update(dt, timeScale) {
  const dir = Math.sign(timeScale);
  const speedFactor = Math.abs(timeScale);
  this.life -= dt * speedFactor;
  this.x += this.vx * dt * dir;
  this.y += this.vy * dt * dir;
  if (this.life <= 0) return false;
  return true;
}
```

