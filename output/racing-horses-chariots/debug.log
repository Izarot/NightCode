  "index.html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\">\n<meta name=\"theme-color\" content=\"#192e3a\">\n<title>Chariot Rush</title>\n<link rel=\"icon\" href=\"data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ctext y='.9em' font-size='90'%3E🏇%3C/text%3E%3C/svg%3E\">\n<link rel=\"stylesheet\" href=\"styles.css\">\n</head>\n<body>\n<main id=\"game\" aria-label=\"Chariot Rush racing game\">\n<canvas id=\"world\" tabindex=\"0\" aria-label=\"Race view. W accelerate, S brake, A and D steer, Space urge, Shift rein, R recover, Escape pause.\"></canvas>\n<section id=\"hud\" hidden aria-label=\"Race information\">\n<div class=\"panel standings\"><strong id=\"position\">1 / 6</strong><div id=\"standingList\"></div></div>\n<div class=\"panel lap\"><strong id=\"lap\">LAP 1 / 3</strong><span id=\"raceTime\">0:00.00</span><small id=\"venue\"></small></div>\n<div class=\"topRight\"><div class=\"panel run\">SPEEDRUN <b id=\"runTime\">0:00.00</b></div><button id=\"pauseButton\" aria-label=\"Pause race\">Ⅱ</button><canvas id=\"minimap\" width=\"240\" height=\"156\" aria-label=\"Track minimap\"></canvas></div>\n<div class=\"panel telemetry\"><div><strong id=\"speed\">0</strong> <span>units/s</span><span id=\"boostStatus\">URGE READY</span></div><div class=\"meter\" role=\"progressbar\" aria-label=\"Horse stamina\" aria-valuemin=\"0\" aria-valuemax=\"100\" id=\"staminaMeter\"><i id=\"staminaFill\"></i></div><small id=\"staminaText\">STAMINA 100%</small></div>\n<div id=\"callout\" aria-live=\"polite\"></div><div id=\"warning\" aria-live=\"polite\"></div>\n</section>\n<section id=\"overlay\" aria-label=\"Game menus\"></section>\n<div id=\"touch\" hidden>\n<div id=\"steerPad\" aria-label=\"Analog steering pad\"><span>◀ STEER ▶</span><i id=\"steerKnob\"></i></div>\n<div class=\"pedals\"><button data-control=\"brake\">BRAKE</button>