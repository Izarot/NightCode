  "styles.css": ":root{color-scheme:dark;--ink:#142b37;--panel:rgba(15,32,42,.91);--ivory:#fff3d6;--gold:#ffca60;--mint:#54e5c0;--pink:#ff6384}*{box-sizing:border-box}html,body{margin:0;width:100%;height:100%;overflow:hidden;background:var(--ink);color:var(--ivory);font:16px system-ui,sans-serif}button,input,select{font:inherit}button{min-height:48px;border:1px solid #73818a;background:#253e4b;color:var(--ivory);border-radius:10px;padding:11px 20px;cursor:pointer;font-weight:750;transition:background .15s,transform .15s}button:hover{background:#365764}button:active{transform:translateY(1px)}button:disabled{opacity:.45;cursor:default}button.primary{background:var(--gold);border-color:var(--gold);color:#192e3a}button:focus-visible,input:focus-visible,select:focus-visible,canvas:focus-visible{outline:3px solid var(--mint);outline-offset:3px}#game{position:relative;width:100%;height:100%;isolation:isolate}#world{display:block;width:100%;height:100%;outline:none;touch-action:none}#overlay{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;padding:22px;background:linear-gradient(90deg,rgba(13,30,40,.82),rgba(13,30,40,.24));overflow:auto}#overlay:empty{display:none}.menu{width:min(850px,100%);padding:30px;border:1px solid #70818b66;border-radius:20px;background:rgba(16,35,46,.96);box-shadow:0 20px 100px #08192377;max-height:100%;overflow:auto}.menu.home{width:min(630px,100%);margin-right:25%;background:rgba(16,35,46,.9)}h1{font-size:clamp(40px,6vw,76px);line-height:.95;letter-spacing:-3px;margin:12px 0 20px}h1 span{color:var(--gold)}h2{margin:0 0 18px;font-size:30px}h3{margin:12px 0}.eyebrow{color:var(--mint);letter-spacing:3px;font-weight:800;font-size:13px}.muted,small{color:#c4d2d4}p{line-height:1.55}.actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:22px}.home .actions{display:grid;grid-template-columns:1fr 1fr}.record{border-top:1px solid #56717c;padding-top:17px;margin-top:24px;color:var(--gold)}.teams{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.team{padding:15px;text-align:left;min-height:205px;font-weight:400}.team strong{display:block;font-size:20px;margin-bottom:8px}.team small{display:block;line-height:1.4;min-height:60px}.team[aria-pressed=true]{border:2px solid var(--gold);background:#37525a}.compare{font-size:12px;margin-top:9px}.compare i{display:block;height:5px;background:#142b37;margin-top:3px}.compare b{height:100%;display:block;background:var(--mint)}.settingsGrid{display:grid;grid-template-columns:1fr 1fr;gap:22px;margin-top:22px}label{display:flex;flex-direction:column;gap:9px}select{min-height:48px;padding:8px;border-radius:8px;background:#233f4d;color:var(--ivory);border:1px solid #71828a}input[type=range]{width:100%;accent-color:var(--gold);height:32px}input[type=checkbox]{width:23px;height:23px;accent-color:var(--mint)}.check{flex-direction:row;align-items:center}.colors{display:flex;gap:8px}.colors button{padding:0;width:48px;background:var(--swatch);color:#142b37;text-shadow:0 1px #fff7;border:2px solid transparent}.colors button[aria-pressed=true]{border:3px solid white}.panel{background:var(--panel);border:1px solid #81929755;backdrop-filter:blur(8px);border-radius:12px;padding:12px 16px}#hud{position:absolute;inset:0;pointer-events:none}#hud button{pointer-events:auto}.standings{position:absolute;left:20px;top:20px;min-width:164px}.standings>strong{font-size:30px;color:var(--gold)}#standingList{margin-top:8px;font-size:16px;line-height:1.6}#standingList .you{color:var(--gold);font-weight:800}.lap{position:absolute;top:20px;left:50%;transform:translateX(-50%);text-align:center;min-width:180px}.lap strong{font-size:23px;display:block}.lap span{font-variant-numeric:tabular-nums;display:block;font-size:22px;margin:3px}.lap small{display:block}.topRight{position:absolute;right:20px;top:20px;display:grid;grid-template-columns:1fr 50px;gap:8px;align-items:start}.run{font-size:12px;letter-spacing:1px;padding:8px 12px}.run b{display:block;font-size:18px;letter-s