round:#142b37cf;min-height:52px}.pedals .accelerate{background:#ffca60e8;color:#142b37;grid-column:2;grid-row:1 / 4;font-size:22px}.pedals button.held{background:#54e5c0;color:#142b37}#touchRecover{position:absolute;bottom:138px;left:35px;font-size:13px;padding:8px;display:none}table{width:100%;border-collapse:collapse;font-variant-numeric:tabular-nums}th,td{text-align:left;padding:9px 7px;border-bottom:1px solid #45606c}th{color:var(--mint);font-size:13px;letter-spacing:1px}.youRow{color:var(--gold);font-weight:750}.resultHero{display:flex;gap:24px;flex-wrap:wrap;padding:15px 0}.resultHero strong{font-size:30px;display:block;color:var(--gold)}.helpGrid{display:grid;grid-template-columns:1fr 1fr;gap:20px}kbd{background:#385562;padding:2px 6px;border-radius:4px}.contrast .panel{background:#051019;border:2px solid white}.contrast small{color:white}.contrast .meter{outline:1px solid white}[hidden]{display:none!important}@media(pointer:coarse){#touch:not([hidden]){display:block}.telemetry{bottom:20px;width:260px}}@media(max-width:850px){.menu{padding:20px}.menu.home{margin-right:0}.standings{left:10px;top:10px;padding:8px 12px;min-width:120px}#standingList{font-size:13px}.lap{top:10px;padding:8px;min-width:135px}.lap strong{font-size:19px}.lap span{font-size:18px}.lap small{font-size:12px}.topRight{right:10px;top:10px;gap:5px;grid-template-columns:105px 48px}.run{padding:6px;font-size:10px}#minimap{width:145px;height:94px}.telemetry{width:240px;padding:8px 12px}.telemetry strong{font-size:23px}#boostStatus{font-size:11px;padding-top:8px}.teams{gap:7px}.team{padding:10px}.team small{min-height:70px}.settingsGrid{gap:15px}#steerPad{left:12px;bottom:15px;width:145px;height:84px}.pedals{right:12px;bottom:15px;gap:5px;grid-template-columns:54px 62px}.pedals button{min-height:48px}.telemetry small{font-size:12px}#toast{bottom:125px}}@media(max-height:520px){.menu{padding:18px;max-height:100%}.home h1{font-size:46px;margin:8px 0}.home p{margin:8px 0}.home .record{margin-top:12px;padding-top:10px}.actions{margin-top:14px}.standings #standingList{display:none}#minimap{width:132px;height:86px}.telemetry{bottom:10px}.team{min-height:155px}.team small{min-height:45px}.settingsGrid{margin-top:14px}.compare{margin-top:4px}.lap small{display:none}#warning{top:64%;font-size:14px}}@media(max-width:560px) and (orientation:portrait){.teams{grid-template-columns:1fr}.team{min-height:0}.team small{min-height:0}.compare{display:inline-block;width:30%;margin-right:3%}.settingsGrid,.helpGrid{grid-template-columns:1fr}.lap{top:85px}.standings #standingList{display:none}.telemetry{bottom:145px}.menu h2{font-size:25px}.topRight{grid-template-columns:100px 48px}.run{font-size:10px}.resultHero strong{font-size:24px}}",
  "js/config/constants.js": "export const WORLD={w:3400,h:2200};\nexport const LENGTH=2800+1100*Math.PI;\nexport const DT=1/60;\nexport const COLORS=['#54e5c0','#ff6384','#9f91ff','#ffca60','#58bfff','#ff9858'];\nexport const TEAMS={Balanced:{speed:1,accel:1,grip:1,impact:1,description:'Reliable pace and sure-footed handling. Recommended for your first race.',bars:[76,78,80]},Swift:{speed:1.08,accel:1.05,grip:.85,impact:1.2,description:'Fast on the straights. Lighter grip and greater contact losses.',bars:[95,68,60]},Heavy:{speed:.95,accel:.92,grip:1.15,impact:.7,description:'Stable cornering and sturdy contact. Trades top speed for control.',bars:[68,94,98]}};\nexport const VENUES=[{name:'Sunlit Arena',sand:3,debris:6,sky:'#ddbc7c',track:'#dcaf70',island:'#708c79'},{name:'Dust Circuit',sand:5,debris:8,sky:'#c99973',track:'#c89361',island:'#7e8970'},{name:'Twilight Final',sand:4,debris:10,sky:'#746e99',track:'#b49a87',island:'#4e7c83'}];\nexport const POINTS=[10,7,5,3,2,1];\nexport const NAMES=['You','Cassia','Aurelius','Dione','Flavius','Neria'];\nexport const CIRCLES=[{offset:38,r:29},{offset:0,r:32},{offset:-40,r:33}];",
  "js/utils/math.js": "export const clamp=(v,a,b)=>Math.max(a,Math.min(b,v));\nexport const mod=(v,n)=>(v%n+n)%n;\nexport const angle=a=>Math.atan2(Math.sin(a),Math.cos(a));\nexport const mix=(a,b,t)=>a+(b-a)*t;\nexport function rng(seed){let s=seed>>>0;return()=>{s+=0x6D2B79F5;let t=s;t=Math.imul(t^t>>>15,t|1);t^=t+Math.imul(t^t>>>7,t|61);return((t^t>>>14)>>>0)/4294967296;};}\nexport function timeText(t){if(!Number.isFinite(t))return '—';t=Math.max(0,t);return `${Math.floor(t/60)}:${(t%60).toFixed(2).padStart(5,'0')}`;}\nexport function ordinal(n){return `${n}${n===1?'st':n===2?'nd':n===3?'rd':'th'}`;}",
  "js/SaveManager.js": "const defaults=()=>({version:1,settings:{master:.65,music:.22,effects:.8,reducedMotion:false,contrast:false},unlocked:['Novice'],records:{},highScore:0});\nexport class SaveManager{\n constructor(storage){this.storage=storage;this.data=defaults();try{if(!storage)this.storage=window.localStorage;const raw=JSON.parse(this.storage.getItem('chariot-rush-v1'));if(raw?.version===1){this.data.settings={...this.data.settings,...raw.settings};this.data.unlocked=Array.isArray(raw.unlocked)?raw.unlocked.filter(x=>['Novice','Veteran','Champion'].includes(x)):['Novice'];if(!this.data.unlocked.includes('Novice'))this.data.unlocked.unshift('Novice');this.data.records=raw.records&&typeof raw.records==='object'?raw.records:{};this.data.highScore=Number(raw.highScore)||0;}}catch{}for(const k of ['master','music','effects'])this.data.settings[k]=Math.max(0,Math.min(1,Number(this.data.settings[k])||0));}\n write(){try{this.storage?.setItem('chariot-rush-v1',JSON.stringify(this.data));}catch{}}\n record(key,time,bestLap,score){const old=this.data.records[key];const pb=!old||time<old.time;this.data.records[key]={time:Math.min(old?.time??Infinity,time),lap:Math.min(old?.lap??Infinity,bestLap)};this.data.highScore=Math.max(this.data.highScore,score);this.write();return pb;}\n unlock(difficulty){if(!this.data.unlocked.includes(difficulty)){this.data.unlocked.push(difficulty);this.write();return true;}return false;}\n}",
  "js/Track.js": "import {LENGTH,VENUES} from './config/constants.js';\nimport {mod,clamp,rng} from './utils/math.js';\nexport class Track{\n constructor(stage=0,seed=83){this.length=LENGTH;this.stage=stage;this.style=VENUES[stage];this.seed=seed;this.sand=[];this.debris=[];const random=rng(seed);for(let i=0;i<this.style.sand;i++){const s=500+(i+.2+random()*.5)*(LENGTH-950)/this.style.sand;this.sand.push({s,lane:(random()<.5?-1:1)*(60+random()*25),length:150,width:90});}for(let i=0;i<this.style.debris;i++){const s=450+(i+random()*.5)*(LENGTH-900)/this.style.debris;const lane=(random()<.5?-1:1)*(62+random()*28);const p=this.at(s,lane);this.debris.push({...p,s,lane,alive:true,r:13+random()*5});}}\n at(s,lane=0){const q=mod(s+700,LENGTH),arc=550*Math.PI;let x,y,tx,ty,curve=false;if(q<1400){x=1000+q;y=550;tx=1;ty=0;}else if(q<1400+arc){const a=-Math.PI/2+(q-1400)/550;x=2400+550*Math.cos(a);y=1100+550*Math.sin(a);tx=-Math.sin(a);ty=Math.cos(a);curve=true;}else if(q<2800+arc){x=2400-(q-1400-arc);y=1650;tx=-1;ty=0;}else{const a=Math.PI/2+(q-2800-arc)/550;x=1000+550*Math.cos(a);y=1100+550*Math.sin(a);tx=-Math.sin(a);ty=Math.cos(a);curve=true;}const nx=-ty,ny=tx;return{x:x+nx*lane,y:y+ny*lane,tx,ty,nx,ny,s:mod(s,LENGTH),heading:Math.atan2(ty,tx),curve};}\n nearest(x,y){let q,cx,cy,tx,ty,curve=false;if(x>=1000&&x<=2400){if(y<1100){cx=x;cy=550;tx=1;ty=0;q=x-1000;}else{cx=x;cy=1650;tx=-1;ty=0;q=1400+550*Math.PI+2400-x;}}else if(x>2400){const a=clamp(Math.atan2(y-1100,x-2400),-Math.PI/2,Math.PI/2);cx=2400+550*Math.cos(a);cy=1100+550*Math.sin(a);tx=-Math.sin(a);ty=Math.cos(a);q=1400+(a+Math.PI/2)*550;curve=true;}else{let a=Math.atan2(y-1100,x-1000);if(a<Math.PI/2)a+=2*Math.PI;a=clamp(a,Math.PI/2,3*Math.PI/2);cx=1000+550*Math.cos(a);cy=1100+550*Math.sin(a);tx=-Math.sin(a);ty=Math.cos(a);q=2800+550*Math.PI+(a-Math.PI/2)*550;curve=true;}const nx=-ty,ny=tx;return{x:cx,y:cy,tx,ty,nx,ny,lateral:(x-cx)*nx+(y-cy)*ny,s:mod(q-700,LENGTH),heading:Math.atan2(ty,tx),curve};}\n delta(a,b){return mod(a-b+LENGTH/2,LENGTH)-LENGTH/2;}\n terrain(n){for(const p of this.sand){const ds=this.delta(n.s,p.s)/75,dl=(n.lateral-p.lane)/45;if(ds*ds+dl*dl<1)return true;}return false;}\n path(ctx){ctx.moveTo(1000,550);ctx.lineTo(2400,550);ctx.arc(2400,1100,550,-Math.PI/2,Math.PI/2);ctx.lineTo(1000,1650);ctx.arc(1000,1100,550,Math.PI/2,Math.PI*1.5);ctx.closePath();}\n}",
  "js/InputManager.js": "const bindings={KeyW:'accel',ArrowUp:'accel',KeyS:'brake',ArrowDown:'brake',KeyA:'left',ArrowLeft:'left',KeyD:'right',ArrowRight:'right',Space:'boost',ShiftLeft:'rein',ShiftRight:'rein',KeyR:'recover'};\nexport class InputManager{\n constructor(game){this.game=game;this.keys=new Set();this.pointers=new Map();this.analog=0;this.padPointer=null;this.coarse=matchMedia('(pointer:coarse)').matches||navigator.maxTouchPoints>0;const canvas=document.getElementById('world');window.addEventListener('keydown',e=>{const active=game.state==='race'&&document.activeElement===canvas;if((e.code==='Escape'||e.code==='KeyP')&&!e.repeat&&(active||game.state==='paused')){e.preventDefault();game.togglePause();return;}if(active&&bindings[e.code]){e.preventDefault();this.keys.add(e.code);}});window.addEventListener('keyup',e=>this.keys.delete(e.code));window.addEventListener('blur',()=>{this.clear();if(game.state==='race')game.pause();});canvas.addEventListener('blur',()=>this.clear());document.addEventListener('visibilitychange',()=>{if(document.hidden){this.clear();if(game.state==='race')game.pause();}});canvas.addEventListener('pointerdown',()=>canvas.focus({preventScroll:true}));for(const button of document.querySelectorAll('[data-control]')){button.addEventListener('pointerdown',e=>{if(game.state!=='race')return;e.preventDefault();button.setPointerCapture(e.pointerId);this.pointers.set(e.pointerId,button.dataset.control);button.classList.add('held');canvas.focus({preventScroll:true});});const end=e=>{this.pointers.delete(e.pointerId);button.classList.remove('held');};button.addEventListener('pointerup',end);button.addEventListener('pointercancel',end);button.addEventListener('lostpointercapture',end);}const pad=document.getElementById('steerPad');const move=e=>{if(this.padPointer!==e.pointerId)return;const r=pad.getBoundingClientRect();this.analog=Math.max(-1,Math.min(1,(e.clientX-r.left-r.width/2)/(r.width*.34)));document.getElementById('steerKnob').style.transform=`translateX(${this.analog*r.width*.28}px)`;};pad.addEventListener('pointerdown',e=>{if(game.state!=='race'||this.padPointer!==null)return;e.preventDefault();this.padPointer=e.pointerId;pad.setPointerCapture(e.pointerId);canvas.focus({preventScroll:true});move(e);});pad.addEventListener('pointermove',move);const release=e=>{if(e.pointerId===this.padPointer){this.padPointer=null;this.analog=0;document.getElementById('steerKnob').style.transform='';}};pad.addEventListener('pointerup',release);pad.addEventListener('pointercancel',release);pad.addEventListener('lostpointercapture',release);}\n held(control){for(const key of this.keys)if(bindings[key]===control)return true;for(const v of this.pointers.values())if(v===control)return true;return false;}\n read(){return{steer:this.analog||(Number(this.held('right'))-Number(this.held('left'))),accel:this.held('accel'),brake:this.held('brake'),boost:this.held('boost'),rein:this.held('rein'),recover:this.held('recover')};}\n clear(){this.keys.clear();this.pointers.clear();this.analog=0;this.padPointer=null;document.querySelectorAll('.held').forEach(b=>b.classList.remove('held'));document.getElementById('steerKnob').style.transform='';}\n}",
  "js/Renderer.js": "import {WORLD,COLORS} from './config/constants.js';\nexport class Renderer{\n constructor(canvas){this.canvas=canvas;this.ctx=canvas.getContext('2d');this.map=document.getElementById('minimap');this.mx=this.map.getContext('2d');this.camera={x:1700,y:1100};this.resize();window.addEventListener('resize',()=>this.resize());}\n resize(){this.w=this.canvas.clientWidth;this.h=this.canvas.clientHeight;this.dpr=Math.min(devicePixelRatio||1,2);this.canvas.width=Math.round(this.w*this.dpr);this.canvas.height=Math.round(this.h*this.dpr);}\n draw(g,dt){const c=this.ctx,t=g.track,p=g.racers[0];const active=['race','paused','results'].includes(g.state);let z=active?Math.min(this.w/970,this.h/700):Math.min(this.w/WORLD.w,this.h/WORLD.h)*.96;z=Math.max(z,.15);const target=active?{x:p.x+Math.cos(p.heading)*120,y:p.y+Math.sin(p.heading)*120}:{x:1700,y:1100};const a=g.save.data.settings.reducedMotion?1:1-Math.exp(-dt*5);this.camera.x+=(target.x-this.camera.x)*a;this.camera.y+=(target.y-this.camera.y)*a;c.setTransform(this.dpr,0,0,this.dpr,0,0);c.fillStyle=t.style.sky;c.fillRect(0,0,this.w,this.h);c.translate(this.w/2,this.h/2);c.scale(z,z);c.translate(-this.camera.x,-this.camera.y);\n c.fillStyle=t.style.island;c.beginPath();c.roundRect(310,330,2780,1540,600);c.fill();c.beginPath();t.path(c);c.strokeStyle='#536665';c.lineWidth=362;c.stroke();c.strokeStyle='#f6ddb0';c.lineWidth=326;c.stroke();c.strokeStyle=t.style.track;c.lineWidth=302;c.stroke();c.setLineDash([22,18]);c.strokeStyle='#f7ddb263';c.lineWidth=3;c.stroke();c.setLineDash([]);\n for(let s=0;s<t.length;s+=95){for(const lane of [-173,173]){const v=t.at(s,lane);c.fillStyle='#273e48';c.beginPath();c.arc(v.x,v.y,7,0,Math.PI*2);c.fill();}}\n for(const sand of t.sand){const v=t.at(sand.s,sand.lane);c.save();c.translate(v.x,v.y);c.rotate(v.heading);c.fillStyle='#efd09399';c.beginPath();c.ellipse(0,0,75,45,0,0,Math.PI*2);c.fill();c.fillStyle='#94774566';for(let i=0;i<12;i++){c.beginPath();c.arc(Math.sin(i*8)*58,Math.cos(i*5)*30,2.5,0,Math.PI*2);c.fill();}c.restore();}\n for(const d of t.debris){if(!d.alive)continue;c.save();c.translate(d.x,d.y);c.rotate(d.s);c.fillStyle='#72513b';c.fillRect(-d.r,-6,d.r*2,12);c.fillStyle='#c69763';c.fillRect(-6,-d.r,12,d.r*2);c.restore();}\n const start=t.at(0);c.save();c.translate(start.x,start.y);c.rotate(start.heading);for(let row=0;row<2;row++)for(let i=0;i<12;i++){c.fillStyle=(i+row)%2?'#20343b':'#fff3d6';c.fillRect(row*13-13,i*25-150,13,25);}c.restore();\n c.textAlign='center';c.fillStyle='#fff3d6';c.font='900 94px system-ui';c.fillText('CHARIOT RUSH',1700,1090);c.font='700 28px system-ui';c.fillStyle='#e7dbb3';c.fillText(t.style.name.toUpperCase(),1700,1145);\n for(let i=0;i<8;i++){const x=1100+i*175;c.fillStyle=i%2?'#ffca60':'#ff6384';c.beginPath();c.moveTo(x,890);c.lineTo(x+48,907);c.lineTo(x,924);c.fill();c.strokeStyle='#364e54';c.lineWidth=5;c.beginPath();c.moveTo(x,884);c.lineTo(x,947);c.stroke();}\n for(const r of [...g.racers].sort((a,b)=>a.y-b.y))this.chariot(c,r,g.clock,g.save.data.settings.reducedMotion);\n c.setTransform(this.dpr,0,0,this.dpr,0,0);if(active){const grad=c.createLinearGradient(0,0,0,this.h);grad.addColorStop(0,'#102d3940');grad.addColorStop(.4,'#102d3900');grad.addColorStop(1,'#102d3940');c.fillStyle=grad;c.fillRect(0,0,this.w,this.h);}this.minimap(g);\n }\n chariot(c,r,time,reduced){c.save();c.translate(r.x,r.y);c.rotate(r.heading);c.fillStyle='#152c3844';c.beginPath();c.ellipse(-4,9,77,34,0,0,Math.PI*2);c.fill();if(r.boosting){c.fillStyle='#ffca6088';c.beginPath();c.moveTo(-45,-19);c.lineTo(-100,0);c.lineTo(-45,19);c.fill();}c.strokeStyle='#493c31';c.lineWidth=4;for(const y of [-15,15]){c.beginPath();c.moveTo(-29,y);c.lineTo(37,y);c.stroke();}for(const y of [-19,19]){const stride=reduced?0:Math.sin(time*(r.speed*.05+3)+y)*7;c.strokeStyle='#392f2c';c.lineWidth=5;for(const x of [22,51]){c.beginPath();c.moveTo(x,y-6);c.lineTo(x+stride,y-14);c.moveTo(x,y+6);c.lineTo(x-stride,y+14);c.stroke();}c.fillStyle=r.id%2?'#704b37':'#be9467';c.beginPath();c.ellipse(36,y,24,10,0,0,Math.PI*2);c.fill();c.fillStyle='#342f2a';c.fillRect(48,y-5,15,5);c.fillStyle='#e1bd8b';c.beginPath();c.ellipse(62,y-1,10,6,0,0,Math.PI*2);c.fill();c.fillStyle=r.color;c.fillRect(25,y-9,13,18);}\n c.fillStyle='#23333a';c.fillRect(-48,-31,26,8);c.fillRect(-48,23,26,8);c.fillStyle='#d8ac68';c.fillRect(-52,-24,35,48);c.fillStyle=r.color;c.fillRect(-49,-21,30,42);c.strokeStyle='#ffe3aa';c.lineWidth=3;c.strokeRect(-49,-21,30,42);c.fillStyle='#203541';c.beginPath();c.ellipse(-26,0,12,13,0,0,Math.PI*2);c.fill();c.fillStyle='#edbc91';c.beginPath();c.arc(-20,0,7,0,Math.PI*2);c.fill();c.restore();if(r.id===0){c.fillStyle=r.color;c.beginPath();c.moveTo(r.x,r.y-61);c.lineTo(r.x-9,r.y-76);c.lineTo(r.x+9,r.y-76);c.fill();}}\n minimap(g){const c=this.mx;c.clearRect(0,0,240,156);c.save();c.scale(240/WORLD.w,156/WORLD.h);c.lineWidth=220;c.strokeStyle='#d5b885';c.beginPath();g.track.path(c);c.stroke();for(const r of [...g.racers].reverse()){c.fillStyle=r.color;c.beginPath();c.arc(r.x,r.y,r.id===0?65:42,0,Math.PI*2);c.fill();if(r.id===0){c.strokeStyle='#fff';c.lineWidth=18;c.stroke();}}c.restore();}\n}",
  "js/Race.js": "import {TEAMS,COLORS,NAMES,LENGTH} from './config/constants.js';\nimport {clamp,angle} from './utils/math.js';\nexport function makeRacers(track,team,color){return NAMES.map((name,id)=>{const s=-110-Math.floor(id/2)*135,lane=(id%2?1:-1)*55,p=track.at(s,lane);return{id,name,color:id===0?color:COLORS[id],team:id===0?team:['Balanced','Swift','Heavy'][id%3],x:p.x,y:p.y,heading:p.heading,speed:0,stamina:100,progress:s,lastS:p.s,lap:0,lapStart:0,bestLap:Infinity,finish:null,boosting:false,exhausted:false,impact:0,stuck:0,recoverCooldown:0,penalty:0};});}\nexport function updateRace(g,dt){const track=g.track,difficulty={Novice:.82,Veteran:.94,Champion:1.02}[g.difficulty];g.raceTime+=dt;g.runTime+=dt;for(const r of g.racers){r.impact=Math.max(0,r.impact-dt);r.recoverCooldown=Math.max(0,r.recoverCooldown-dt);const n=track.nearest(r.x,r.y);let input;if(r.id===0&&r.finish===null)input=g.input.read();else{let lane=(r.id%2?1:-1)*(20+r.id*5);for(const d of track.debris)if(d.alive&&track.delta(d.s,n.s)>0&&track.delta(d.s,n.s)<310&&Math.abs(d.lane-lane)<50)lane=-Math.sign(d.lane||1)*30;const ahead=track.at(n.s+150+Math.max(r.speed,0)*.22,lane),turn=angle(Math.atan2(ahead.y-r.y,ahead.x-r.x)-r.heading);input={accel:true,brake:false,steer:clamp(turn*2.7,-1,1),rein:Math.abs(turn)>.55,boost:!n.curve&&r.stamina>45,recover:false};}\n const stats=TEAMS[r.team],sand=track.terrain(n);r.sand=sand;r.boosting=input.boost&&!input.rein&&!r.exhausted&&r.stamina>2&&input.accel;r.stamina=clamp(r.stamina+(r.boosting?-25:input.rein?20:11)*dt,0,100);if(r.stamina<=2)r.exhausted=true;if(r.stamina>=30)r.exhausted=false;\n let max=410*stats.speed*(r.id?difficulty:1)*(sand?.7:1)*(input.rein?.77:1)*(r.boosting?1.23:1);if(input.accel)r.speed+=155*stats.accel*dt;else r.speed-=58*dt;if(input.brake)r.speed-=310*dt;r.speed=clamp(r.speed,0,max+(Math.max(0,r.speed-max)*Math.exp(-dt*4)));\n const grip=stats.grip*(input.rein?1.3:1)*(sand?.85:1);r.heading=angle(r.heading+input.steer*(.3+1.25*clamp(r.speed/240,0,1))*grip*dt);r.x+=Math.cos(r.heading)*r.speed*dt;r.y+=Math.sin(r.heading)*r.speed*dt;let near=track.nearest(r.x,r.y);const extent=35+Math.abs(Math.sin(angle(r.heading-near.heading)))*35;const limit=150-extent;if(Math.abs(near.lateral)>limit){const sign=Math.sign(near.lateral),push=Math.abs(near.lateral)-limit;r.x-=near.nx*sign*push;r.y-=near.ny*sign*push;r.speed*=Math.max(.7,1-dt*2.5*stats.impact);if(r.impact<=0&&r.id===0&&r.speed>80){g.sound(95,.08);r.impact=.5;}near=track.nearest(r.x,r.y);}\n for(const d of track.debris){if(!d.alive)continue;const hx=r.x+Math.cos(r.heading)*25,hy=r.y+Math.sin(r.heading)*25;if(Math.hypot(hx-d.x,hy-d.y)<d.r+33){d.alive=false;r.speed*=1-.23*stats.impact;r.stamina=Math.max(0,r.stamina-7);if(!r.id){g.toast('Debris hit — watch your line');g.sound(70,.13);}}}\n const delta=track.delta(near.s,r.lastS);r.lastS=near.s;if(Math.abs(delta)<100)r.progress+=delta;const lapNow=Math.max(0,Math.floor(r.progress/LENGTH));if(lapNow>r.lap&&r.finish===null){r.bestLap=Math.min(r.bestLap,g.raceTime-r.lapStart);r.lapStart=g.raceTime;r.lap=lapNow;if(!r.id){g.sound(620,.16);g.flash(lapNow===2?'FINAL LAP':'LAP '+(lapNow+1),1.5);}if(lapNow>=3){r.finish=g.raceTime+r.penalty;if(!r.id)g.finishPending=true;}}\n r.stuck=r.speed<25?r.stuck+dt:0;if((input.recover||r.id&&r.stuck>4)&&r.recoverCooldown===0&&r.finish===null){const pos=track.at(r.progress,0);r.x=pos.x;r.y=pos.y;r.heading=pos.heading;r.lastS=pos.s;r.speed=30;r.stuck=0;r.recoverCooldown=3;if(!r.id){r.penalty+=3;g.toast('Recovered to track center • +3 seconds');}}\n }\n for(let i=0;i<g.racers.length;i++)for(let j=i+1;j<g.racers.length;j++){const a=g.racers[i],b=g.racers[j],dx=b.x-a.x,dy=b.y-a.y,d=Math.hypot(dx,dy);if(d<65&&d>.01){const overlap=(65-d)/2,nx=dx/d,ny=dy/d;a.x-=nx*overlap;a.y-=ny*overlap;b.x+=nx*overlap;b.y+=ny*overlap;if(a.impact<=0&&b.impact<=0){a.speed*=1-.1*TEAMS[a.team].impact;b.speed*=1-.1*TEAMS[b.team].impact;a.impact=b.impact=.5;if(i===0)g.sound(110,.08);}}}\n if(g.finishPending){g.finishPending=false;g.finishRace();}\n}\nexport function ranking(racers){return [...racers].sort((a,b)=>{if(a.finish!==null&&b.finish!==null)return a.finish-b.finish;if(a.finish!==null)return -1;if(b.finish!==null)return 1;return b.progress-a.progress;});}\n",
  "js/main.js": "import {DT,TEAMS,COLORS,POINTS,LENGTH} from './config/constants.js';\nimport {timeText,ordinal} from './utils/math.js';\nimport {SaveManager} from './SaveManager.js';\nimport {Track} from './Track.js';\nimport {InputManager} from './InputManager.js';\nimport {Renderer} from './Renderer.js';\nimport {makeRacers,updateRace,ranking} from './Race.js';\nconst $=id=>document.getElementById(id);\nclass Game{\n constructor(){this.save=new SaveManager();this.state='home';this.team='Balanced';this.color=COLORS[0];this.difficulty='Novice';this.mode='single';this.stage=0;this.clock=0;this.track=new Track();this.racers=makeRacers(this.track,this.team,this.color);this.renderer=new Renderer($('world'));this.input=new InputManager(this);this.raceTime=0;this.runTime=0;this.countdown=0;this.flashTime=0;this.toastTime=0;this.points=Array(6).fill(0);this.audio=null;this.applySettings();$('pauseButton').onclick=()=>this.pause();this.home();let previous=performance.now(),accumulator=0;const frame=now=>{const elapsed=Math.min((now-previous)/1000,.1);previous=now;accumulator+=elapsed;while(accumulator>=DT){this.tick(DT);accumulator-=DT;}this.renderer.draw(this,elapsed);requestAnimationFrame(frame);};requestAnimationFrame(frame);}\n sound(frequency=440,duration=.1){try{if(!this.audio)this.audio=new (window.AudioContext||window.webkitAudioContext)();if(this.audio.state==='suspended')this.audio.resume().catch(()=>{});const s=this.save.data.settings,v=s.master*s.effects;if(!v)return;const o=this.audio.createOscillator(),gain=this.audio.createGain(),now=this.audio.currentTime;o.type='triangle';o.frequency.setValueAtTime(frequency,now);o.frequency.exponentialRampToValueAtTime(Math.max(25,frequency*.8),now+duration);gain.gain.setValueAtTime(v*.15,now);gain.gain.exponentialRampToValueAtTime(.001,now+duration);o.connect(gain);gain.connect(this.audio.destination);o.start();o.stop(now+duration);}catch{}}\n applySettings(){document.body.classList.toggle('contrast',!!this.save.data.settings.contrast);}\n toast(text){$('toast').textContent=text;this.toastTime=3;}\n flash(text,seconds){$('callout').textContent=text;this.flashTime=seconds;}\n show(html){$('overlay').innerHTML='<div class=\"menu'+(this.state==='home'?' home':'')+'\">'+html+'</div>';const focus=$('overlay').querySelector('button,select,input');focus?.focus({preventScroll:true});$('touch').hidden=true;this.input.clear();}\n bind(id,fn){$(id).onclick=fn;}\n home(){this.state='home';$('hud').hidden=true;$('touch').hidden=true;$('callout').textContent='';$('warning').textContent='';const record=this.save.data.records['single-Novice'];this.show('<div class=\"eyebrow\">SIX TEAMS. THREE LAPS. ONE VICTOR.</div><h1>CHARIOT<br><span>RUSH</span></h1><p>Find your line. Manage your horses. Own the arena.<br>A fast, top-down chariot racer with no downloads or sign-in.</p><div class=\"actions\"><button id=\"single\" class=\"primary\">Quick Race</button><button id=\"cup\">Championship</button><button id=\"help\">How to Play</button><button id=\"settings\">Settings</button></div><div class=\"record\">Novice best: '+timeText(record?.time)+' · High score: '+this.save.data.highScore+'</div>');this.bind('single',()=>{this.mode='single';this.setup();});this.bind('cup',()=>{this.mode='cup';this.setup();});this.bind('help',()=>this.help());this.bind('settings',()=>this.settings('home'));}\n setup(){this.state='setup';const teams=Object.entries(TEAMS).map(([name,t])=>'<button class=\"team\" data-team=\"'+name+'\" aria-pressed=\"'+(name===this.team)+'\"><strong>'+name+'</strong><small>'+t.description+'</small>'+['Speed','Grip','Armor'].map((label,i)=>'<div class=\"compare\">'+label+'<i><b style=\"width:'+t.bars[i]+'%\"></b></i></div>').join('')+'</button>').join('');this.show('<div class=\"eyebrow\">'+(this.mode==='cup'?'THREE-RACE CHAMPIONSHIP':'SINGLE RACE')+'</div><h2>Choose your team</h2><div class=\"teams\">'+teams+'</div><div class=\"settingsGrid\"><label>Difficulty<select id=\"difficulty\">'+['Novice','Veteran','Champion'].map(d=>'<option '+(d===this.difficulty?'selected ':'')+(!this.save.data.unlocked.includes(d)?'disabled ':'')+'value=\"'+d+'\">'+d+(!this.save.data.unlocked.includes(d)?' · locked':'')+'</option>').join('')+'</select></label><div><p style=\"margin-top:0\">Chariot color</p><div class=\"colors\">'+COLORS.map((color,i)=>'<button data-color=\"'+color+'\" aria-label=\"Color '+(i+1)+'\" aria-pressed=\"'+(color===this.color)+'\" style=\"--swatch:'+color+'\">'+(color===this.color?'✓':'')+'</button>').join('')+'</div></div></div><p class=\"muted\">'+(this.mode==='cup'?'Race through Sunlit Arena, Dust Circuit and Twilight Final. Points: 10 / 7 / 5 / 3 / 2 / 1.':'Three laps around Sunlit Arena. Your best finish and lap times are saved locally.')+' Win a race to unlock the next difficulty.</p><div class=\"actions\"><button id=\"start\" class=\"primary\">Race!</button><button id=\"back\">Back</button></div>');document.querySelectorAll('[data-team]').forEach(b=>b.onclick=()=>{this.difficulty=$('difficulty').value;this.team=b.dataset.team;this.setup();});document.querySelectorAll('[data-color]').forEach(b=>b.onclick=()=>{this.difficulty=$('difficulty').value;this.color=b.dataset.color;this.setup();});this.bind('start',()=>{this.difficulty=$('difficulty').value;this.stage=0;this.runTime=0;this.points.fill(0);this.cupBest=Infinity;this.cupPenalty=0;this.startRace();});this.bind('back',()=>this.home());}\n startRace(){this.track=new Track(this.stage,83+this.stage*107);this.racers=makeRacers(this.track,this.team,this.color);this.raceTime=0;this.countdown=3;this.countNumber=3;this.flashTime=0;this.state='race';this.input.clear();$('overlay').innerHTML='';$('hud').hidden=false;$('touch').hidden=!this.input.coarse;$('world').focus({preventScroll:true});this.renderer.camera.x=this.racers[0].x;this.renderer.camera.y=this.racers[0].y;this.sound(420,.15);this.flash('3',1);this.updateHUD();}\n tick(dt){this.clock+=dt;if(this.toastTime>0){this.toastTime-=dt;if(this.toastTime<=0)$('toast').textContent='';}if(this.state!=='race')return;if(this.flashTime>0){this.flashTime-=dt;if(this.flashTime<=0)$('callout').textContent='';}if(this.countdown>0){this.countdown-=dt;const n=Math.ceil(this.countdown);if(n!==this.countNumber){this.countNumber=n;this.flash(n>0?String(n):'GO!',n>0?1:.8);this.sound(n>0?420:840,.15);}this.updateHUD();return;}updateRace(this,dt);if(this.state==='race')this.updateHUD();}\n updateHUD(){const p=this.racers[0],order=ranking(this.racers);$('position').textContent=(order.indexOf(p)+1)+' / 6';$('standingList').innerHTML=order.map((r,i)=>'<div class=\"'+(!r.id?'you':'')+'\">'+(i+1)+'. '+r.name+'</div>').join('');$('lap').textContent='LAP '+Math.min(3,p.lap+1)+' / 3';$('raceTime').textContent=timeText(this.raceTime+p.penalty);$('runTime').textContent=timeText(this.runTime+(this.cupPenalty||0)+p.penalty);$('venue').textContent=this.track.style.name;$('speed').textContent=Math.round(p.speed);$('staminaFill').style.width=p.stamina+'%';$('staminaFill').style.background=p.stamina<30?'var(--pink)':'var(--mint)';$('staminaMeter').setAttribute('aria-valuenow',Math.round(p.stamina));$('staminaText').textContent='STAMINA '+Math.round(p.stamina)+'%';$('boostStatus').textContent=p.boosting?'URGING!':p.exhausted?'RECOVERING':this.input.held('rein')?'REINING':'URGE READY';const n=this.track.nearest(p.x,p.y),wrong=Math.cos(p.heading-n.heading)<-.2;$('warning').textContent=wrong?'Wrong way — turn around':p.stuck>2?'Stuck? Press R to recover (+3s)':p.sand?'Deep sand — reduced grip and speed':p.exhausted?'Let your horses recover — hold Shift to rein':'';$('touchRecover').style.display=p.stuck>2||wrong?'block':'none';}\n pause(){if(this.state!=='race')return;this.state='paused';this.pauseMenu();}\n togglePause(){if(this.state==='race')this.pause();else if(this.state==='paused')this.resume();}\n pauseMenu(){this.show('<div class=\"eyebrow\">TAKE A BREATHER</div><h2>Race paused</h2><p>The clock is stopped. Your horses are waiting.</p><div class=\"actions\"><button id=\"resume\" class=\"primary\">Resume</button><button id=\"restart\">Restart '+(this.mode==='cup'?'Championship':'Race')+'</button><button id=\"settings\">Settings</button><button id=\"quit\">Quit to Menu</button></div>');this.bind('resume',()=>this.resume());this.bind('restart',()=>this.confirm('Restart and discard this run?',()=>{this.stage=0;this.runTime=0;this.cupPenalty=0;this.cupBest=Infinity;this.points.fill(0);this.startRace();}));this.bind('settings',()=>this.settings('paused'));this.bind('quit',()=>this.confirm('Quit? This unfinished run will not be saved.',()=>this.home()));}\n confirm(text,yes){this.show('<h2>Are you sure?</h2><p>'+text+'</p><div class=\"actions\"><button id=\"yes\">Yes, continue</button><button id=\"no\" class=\"primary\">Keep racing</button></div>');this.bind('yes',yes);this.bind('no',()=>this.pauseMenu());}\n resume(){this.state='race';$('overlay').innerHTML='';$('touch').hidden=!this.input.coarse;this.input.clear();$('world').focus({preventScroll:true});}\n help(){this.state='help';this.show('<div class=\"eyebrow\">THE DRIVER’S HANDBOOK</div><h2>Win the line, not the collision</h2><div class=\"helpGrid\"><div><h3>Controls</h3><p><kbd>W</kbd> / <kbd>↑</kbd> Accelerate<br><kbd>S</kbd> / <kbd>↓</kbd> Brake<br><kbd>A</kbd> <kbd>D</kbd> / <kbd>←</kbd> <kbd>→</kbd> Steer<br><kbd>Space</kbd> Urge horses<br><kbd>Shift</kbd> Rein for grip and recovery<br><kbd>R</kbd> Recover (+3 second penalty)<br><kbd>Esc</kbd> / <kbd>P</kbd> Pause</p><p>Touch: slide the steering pad and hold GO. Use URGE, REIN and BRAKE as needed.</p></div><div><h3>Racecraft</h3><p>Drive clockwise for three laps. Brake before a turn, then accelerate out. Reining increases grip and restores stamina faster.</p><p>Urge on the straights. Empty stamina needs to recover to 30% before you can urge again. Pale sand slows you; wooden debris and contact cost speed.</p><p>Finish times include recovery penalties. Unfinished rivals are ordered by distance at your finish. Best times are saved per mode and difficulty on this browser.</p></div></div><div class=\"actions\"><button id=\"back\" class=\"primary\">Got it</button></div>');this.bind('back',()=>this.home());}\n settings(returnState){this.state='settings';const s=this.save.data.settings;this.show('<h2>Settings</h2><div class=\"settingsGrid\">'+[['master','Master volume'],['effects','Effects volume']].map(([key,label])=>'<label>'+label+' <output id=\"'+key+'Value\">'+Math.round(s[key]*100)+'%</output><input id=\"'+key+'\" type=\"range\" min=\"0\" max=\"100\" value=\"'+Math.round(s[key]*100)+'\"></label>').join('')+'<label class=\"check\"><input type=\"checkbox\" id=\"reducedMotion\" '+(s.reducedMotion?'checked':'')+'> Reduced motion</label><label class=\"check\"><input type=\"checkbox\" id=\"contrast\" '+(s.contrast?'checked':'')+'> High contrast HUD</label></div><p class=\"muted\">Settings and records are stored locally. Private browsing or blocked storage may prevent saving. No network connection is required after loading.</p><div class=\"actions\"><button id=\"back\" class=\"primary\">Done</button><button id=\"testSound\">Test sound</button></div>');for(const key of ['master','effects'])$(key).oninput=()=>{s[key]=Number($(key).value)/100;$(key+'Value').textContent=$(key).value+'%';this.save.write();};for(const key of ['reducedMotion','contrast'])$(key).onchange=()=>{s[key]=$(key).checked;this.applySettings();this.save.write();};this.bind('testSound',()=>this.sound(520,.2));this.bind('back',()=>{if(returnState==='paused'){this.state='paused';this.pauseMenu();}else this.home();});}\n finishRace(){this.state='results';this.input.clear();const p=this.racers[0],order=ranking(this.racers),place=order.indexOf(p)+1;this.resultOrder=order;this.cupBest=Math.min(this.cupBest??Infinity,p.bestLap);this.cupPenalty=(this.cupPenalty||0)+p.penalty;order.forEach((r,i)=>this.points[r.id]+=POINTS[i]);const score=Math.max(0,Math.round((7-place)*1000+Math.max(0,1000-p.finish)*10));let unlocked='';if(place===1){const next={Novice:'Veteran',Veteran:'Champion'}[this.difficulty];if(next&&this.save.unlock(next))unlocked=next+' difficulty unlocked!';}const complete=this.mode==='single'||this.stage===2;const total=this.mode==='cup'?this.runTime+this.cupPenalty:p.finish;let pb=false;if(complete)pb=this.save.record(this.mode+'-'+this.difficulty,total,this.cupBest,this.mode==='cup'?score+this.points[0]*100:score);this.updateHUD();this.sound(place===1?900:550,.35);const rows=order.map((r,i)=>'<tr class=\"'+(r.id===0?'youRow':'')+'\"><td>'+ordinal(i+1)+'</td><td>'+r.name+'</td><td>'+ (r.finish!==null?timeText(r.finish):'+'+Math.max(0,Math.round(3*LENGTH-r.progress))+' units')+'</td><td>'+POINTS[i]+'</td></tr>').join('');const cupOrder=[...this.racers].sort((a,b)=>this.points[b.id]-this.points[a.id]||order.indexOf(a)-order.indexOf(b));this.show('<div class=\"eyebrow\">'+this.track.style.name.toUpperCase()+' · '+this.difficulty.toUpperCase()+'</div><h2>'+ordinal(place)+' place'+(place===1?' — Victory!':' — Race complete')+'</h2><div class=\"resultHero\"><div><small>FINISH TIME</small><strong>'+timeText(p.finish)+'</strong></div><div><small>BEST LAP</small><strong>'+timeText(p.bestLap)+'</strong></div><div><small>'+ (this.mode==='cup'?'RUN TIME':'SCORE')+'</small><strong>'+(this.mode==='cup'?timeText(total):score)+'</strong></div></div>'+(pb?'<p style=\"color:var(--mint)\">New personal best!</p>':'')+(unlocked?'<p style=\"color:var(--gold)\">'+unlocked+'</p>':'')+'<table><thead><tr><th>Place</th><th>Driver</th><th>Time / Remaining</th><th>Points</th></tr></thead><tbody>'+rows+'</tbody></table>'+(this.mode==='cup'?'<h3>Championship standings</h3><p>'+cupOrder.map((r,i)=>(i+1)+'. '+r.name+' '+this.points[r.id]+' pts').join(' · ')+'</p>'+(complete?'<p>Champion: <strong>'+cupOrder[0].name+'</strong>. Ties are broken by final-race position.</p>':''):'')+'<p class=\"muted\">'+(p.penalty?'Includes '+p.penalty+'s in recovery penalties. ':'')+'Rivals still racing are ranked by distance; their remaining distance is shown above.</p><div class=\"actions\"><button id=\"next\" class=\"primary\">'+(!complete?'Next Race':'Race Again')+'</button><button id=\"menu\">Main Menu</button></div>');this.bind('next',()=>{if(!complete)this.stage++;else{this.stage=0;this.runTime=0;this.points.fill(0);this.cupPenalty=0;this.cupBest=Infinity;}this.startRace();});this.bind('menu',()=>this.home());}\n}\nnew Game();",
  "README.md": "# Chariot Rush\n\nA dependency-free Canvas 2D racing game. Serve this directory with a static HTTP server, then open index.html. For example, with Python installed, run `python3 -m http.server 8080` and visit `http://localhost:8080`. JavaScript modules require HTTP rather than a file:// URL.\n\n## Controls\n\n- W / Up: accelerate\n- S / Down: brake\n- A, D / Left, Right: steer\n- Space: urge horses using stamina\n- Shift: rein for more grip and faster stamina recovery\n- R: recover to the track center; adds a three-second finish-time penalty\n- Escape / P: pause\n- Touch: steering pad and labeled pedals\n\nClick the race view if keyboard controls lose focus. Losing window focus or hiding the tab automatically pauses a race.\n\n## Modes and scoring\n\nQuick Race is three laps around Sunlit Arena. Championship consists of three three-lap races with different hazard layouts. Points are 10, 7,