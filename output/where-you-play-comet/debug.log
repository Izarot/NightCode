window.addEventListener('keydown', (e) => {
  if (e.code === 'Space') {
    if (!game.running) startGame();
  } else if (e.code === 'KeyW' || e.code === 'ArrowUp') {
    game.thrust.active = true;
    const angle = Math.atan2(game.comet.y - height / 2, game.comet.x - width / 2);
    game.thrust.direction = angle;
  } else if (e.code === 'KeyS' || e.code === 'ArrowDown') {
    game.thrust.active = true;
    const angle = Math.atan2(game.comet.y - height / 2, game.comet.x - width / 2) + Math.PI;
    game.thrust.direction = angle;
  } else if (e.code === 'KeyA' || e.code === 'ArrowLeft') {
    // strafe left
    const angle = Math.atan2(game.comet.y - height / 2, game.comet.x - width / 2);
    game.thrust.direction = angle + Math.PI / 2;
  } else if (e.code === 'KeyD' || e.code === 'ArrowRight') {
    // strafe right
    const angle = Math.atan2(game.comet.y - height / 2, game.comet.x - width / 2);
    game.thrust.direction = angle - Math.PI / 2;
  }
});

window.addEventListener('keyup', (e) => {
  if (e.code === 'KeyW' || e.code === 'ArrowUp' || e.code === 'KeyS' || e.code === 'ArrowDown' || e.code === 'KeyA' || e.code === 'ArrowLeft' || e.code === 'KeyD' || e.code === 'ArrowRight') {
    game.thrust.active = false;
  }
});

