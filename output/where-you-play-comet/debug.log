const canvas = document.getElementById('gameCanvas');
const ctx = canvas.getContext('2d');
let width, height;
function resize() {
  const dpr = window.devicePixelRatio || 1;
  width = window.innerWidth * dpr;
  height = window.innerHeight * dpr;
  canvas.width = width;
  canvas.height = height;
  ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
}
window.addEventListener('resize', resize);
resize();

const COLORS = {
  background: '#000',
  star: '#ff0',
  cometCore: '#0ff',
  tailHot: '#0ff',
  tailCold: '#5a0',
  massGaugeGreen: '#0f0',
  massGaugeRed: '#f00',
  thrustColor: '#ff0',
  collectionColor: '#0f0',
  collisionColor: '#f00',
  backgroundStar: '#ff0',
};

Now define game state:

let game = {
  running: false,
  startTime: 0,
  elapsedTime: 0,
  score: 0,
  highScore: 0,
  comet: {
    x: 0,
    y: 0,
    vx: 0,
    vy: 0,
    mass: 1,
    ice: 1,
    radius: 20,
    colorCore: COLORS.cometCore,
    colorTail: COLORS.tailHot,
    tail: [],
    speed: 0,
  },
  thrust: {
    active: false,
    direction: 0, // radians
    strength: 0.05,
  },
  camera: {
    offsetX: 0,
    offsetY: 0,
  },
  particles: [],
  stars: [],
  asteroids: [],
  solarFlare: {
    active: false,
    radius: 0,
    maxRadius: 300,
    growthRate: 5,
  },
  // other state...
};

Define max mass and ice for scaling:

const MAX_MASS = 500;
const MAX_ICE = 100;

Define functions:

function initGame() {
  game.running = true;
  game.startTime = performance.now();
  game.elapsedTime = 0;
  game.score = 0;
  game.highScore = parseInt(localStorage.getItem('stellarDriftHighScore')) || 0;
  // reset comet
  game.comet.x = width / 2;
  game.comet.y = height / 2;
  game.comet.vx = 0;
  game.comet.vy = 0;
  game.comet.mass = 1;
  game.comet.ice = 1;
  game.comet.radius = 20;
  game.comet.tail = [];
  game.comet.speed = 0;
  // reset particles, stars, asteroids
  game.particles = [];
  game.stars = [];
  game.asteroids = [];
  // create initial stars
  for (let i = 0; i < 200; i++) {
    game.stars.push({
      x: Math.random() * width,
      y: Math.random() * height,
      radius: Math.random() * 1.5 + 0.5,
      brightness: Math.random() * 0.5 + 0.5,
    });
  }
  // create initial asteroids
  for (let i = 0; i < 10; i++) {
    const size = Math.random() * 30 + 10;
    game.asteroids.push({
      x: Math.random() * width,
      y: Math.random() * height,
      vx: (Math.random() - 0.5) * 2,
      vy: (Math.random() - 0.5) * 2,
      radius: size,
      mass: size / 10,
    });
  }
  // reset solar flare
  game.solarFlare.active = false;
  game.solarFlare.radius = 0;
}

function update(deltaTime) {
  if (!game.running) return;

  // update timer
  game.elapsedTime = performance.now() - game.startTime;
  game.score = Math.floor(game.elapsedTime / 10); // simple score based on time

  // input handling
  const thrustKeys = { w: true, a: true, s: false, d: false, ArrowUp: true, ArrowLeft: false, ArrowDown: false, ArrowRight: false };
  // Actually we need to map keys: W/A/S/D and arrow keys.
  // We'll handle in input handling section.

  // apply thrust
  if (game.thrust.active) {
    const angle = game.thrust.direction;
    const ax = Math.cos(angle) * game.thrust.strength;
    const ay = Math.sin(angle) * game.thrust.strength;
    game.comet.vx += ax;
    game.comet.vy += ay;
  }

  // apply gravity towards star (center)
  const gravity = 0.001;
  const gx = -game.comet.x * gravity;
  const gy = -game.comet.y * gravity;
  game.comet.vx += gx;
  game.comet.vy += gy;

  // update comet position
  game.comet.x += game.comet.vx;
  game.comet.y += game.comet.vy;

  // update tail particles
  // add new tail particles based on speed and proximity to star
  const speed = Math.hypot(game.comet.vx, game.comet.vy);
  const distanceToStar = Math.hypot(game.comet.x, game.comet.y);
  const tailRate = Math.min(5, speed / 5);
  for (let i = 0; i < tailRate; i++) {
    const angle = Math.atan2(game.comet.y, game.comet.x);
    const particle = {
      x: game.comet.x,
      y: game.comet.y,
      vx: Math.cos(angle) * speed * 0.1,
      vy: Math.sin(angle) * speed * 0.1,
      life: Math.random() * 30 + 10,
      size: Math.random() * 4 + 2,
      color: distanceToStar < 150 ? COLORS.tailHot : COLORS.tailCold,
    };
    game.particles.push(particle);
  }

  // update particles
  for (let i = game.particles.length - 1; i >= 0; i--) {
    const p = game.particles[i];
    p.x += p.vx;
    p.y += p.vy;
    p.life--;
    if (p.life <= 0) {
      game.particles.splice(i, 1);
    }
  }

  // update solar flare
  if (game.solarFlare.active) {
    game.solarFlare.radius += game.solarFlare.growthRate * deltaTime;
    if (game.solarFlare.radius > game.solarFlare.maxRadius) {
      game.solarFlare.active = false;
    }
  }

  // check collisions with asteroids
  for (let i = game.asteroids.length - 1; i >= 0; i--) {
    const a = game.asteroids[i];
    const dx = game.comet.x - a.x;
    const dy = game.comet.y - a.y;
    const dist = Math.hypot(dx, dy);
    const radiiSum = game.comet.radius + a.radius;
    if (dist < radiiSum) {
      // collision: increase mass and ice
      const massGain = a.mass * 10;
      const iceGain = a.mass * 5;
      game.comet.mass = Math.min(MAX_MASS, game.comet.mass + massGain);
      game.comet.ice = Math.min(MAX_ICE, game.comet.ice + iceGain);
      // remove asteroid
      game.asteroids.splice(i, 1);
      // play collision sound
      playSound('collision');
    }
  }

  // check solar flare collision
  if (game.solarFlare.active) {
    const flareDist = Math.hypot(game.comet.x, game.comet.y);
    if (flareDist < game.solarFlare.radius) {
      // reduce mass and ice
      const massLoss = 20;
      const iceLoss = 10;
      game.comet.mass = Math.max(1, game.comet.mass - massLoss);
      game.comet.ice = Math.max(0, game.comet.ice - iceLoss);
      // play sound
      playSound('solar');
    }
  }

  // update camera offset to follow comet
  game.camera.offsetX = game.comet.x - width / 2;
  game.camera.offsetY = game.comet.y - height / 2;

  // keep comet within bounds (wrap)
  if (game.comet.x < 0) game.comet.x = width;
  if (game.comet.x > width) game.comet.x = 0;
  if (game.comet.y < 0) game.comet.y = height;
  if (game.comet.y > height) game.comet.y = 0;

  // update speed for speedrun timer
  game.comet.speed = speed;

  // update HUD (we'll draw later)
}

function draw() {
  // clear background
  ctx.fillStyle = COLORS.background;
  ctx.fillRect(0, 0, width, height);

  // draw stars
  ctx.fillStyle = COLORS.star;
  for (const star of game.stars) {
    ctx.beginPath();
    ctx.arc(star.x, star.y, star.radius, 0, Math.PI * 2);
    ctx.fill();
  }

  // draw solar flare if active
  if (game.solarFlare.active) {
    const gradient = ctx.createRadialGradient(
      width / 2, height / 2, 0,
      width / 2, height / 2, game.solarFlare.radius
    );
    gradient.addColorStop(0, 'rgba(255,255,0,0.5)');
    gradient.addColorStop(1, 'rgba(255,255,0,0)');
    ctx.fillStyle = gradient;
    ctx.beginPath();
    ctx.arc(width / 2, height / 2, game.solarFlare.radius, 0, Math.PI * 2);
    ctx.fill();
  }

  // draw comet
  const comet = game.comet;
  ctx.save();
  ctx.translate(-game.camera.offsetX, -game.camera.offsetY);

  // draw tail particles
  for (const p of comet.tail) {
    ctx.beginPath();
    ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
    ctx.fillStyle = p.color;
    ctx.fill();
  }

  // draw comet core
  ctx.beginPath();
  ctx.arc(comet.x, comet.y, comet.radius, 0, Math.PI * 2);
  ctx.fillStyle = comet.colorCore;
  ctx.fill();

  // draw comet tail (gradient)
  const gradient = ctx.createLinearGradient(
    comet.x, comet.y, comet.x + comet.radius * Math.cos(comet.angle),
    comet.y + comet.radius * Math.sin(comet.angle), comet.x, comet.y
  );
  gradient.addColorStop(0, comet.colorCore);
  gradient.addColorStop(1, comet.colorTail);
  ctx.fillStyle = gradient;
  ctx.beginPath();
  ctx.arc(comet.x, comet.y, comet.radius, 0, Math.PI * 2);
  ctx.fill();

  ctx.restore();

  // draw HUD elements (mass gauge, ice bar, telemetry, timer)
  drawHUD();

  // draw speedrun timer in top right corner
  ctx.save();
  ctx.translate(-game.camera.offsetX, -game.camera.offsetY);
  ctx.fillStyle = COLORS.thrustColor;
  ctx.font = '20px monospace';
  ctx.textAlign = 'right';
  ctx.fillText(`Time: ${Math.floor(game.elapsedTime / 1000)}s`, width - 20, 30);
  ctx.restore();

  // draw event log
  // we can use a separate div for event log, but for simplicity draw on canvas
  // not implemented here
}

function drawHUD() {
  const hudX = 20;
  const hudY = 20;
  const gaugeRadius = 50;
  const massLevel = Math.min(1, game.comet.mass / MAX_MASS);
  const iceLevel = Math.min(1, game.comet.ice / MAX_ICE);

  // mass gauge (circular)
  ctx.save();
  ctx.translate(hudX + gaugeRadius + 10, hudY + gaugeRadius + 10);
  ctx.rotate(-Math.PI / 2); // start at top
  ctx.beginPath();
  ctx.arc(0, 0, gaugeRadius, 0, Math.PI * 2 * massLevel, false);
  ctx.strokeStyle = massLevel > 0.5 ? COLORS.massGaugeRed : COLORS.massGaugeGreen;
  ctx.lineWidth = 8;
  ctx.stroke();
  ctx.restore();

  // ice bar (horizontal)
  const barWidth = 100;
  const barHeight = 10;
  const barX = hudX;
  const barY = hudY + gaugeRadius * 2 + 20;
  ctx.fillStyle = '#0f0';
  ctx.fillRect(barX, barY, barWidth * iceLevel, barHeight);

  // telemetry text
  ctx.fillStyle = COLORS.thrustColor;
  ctx.font = '14px monospace';
  ctx.fillText(`Mass: ${Math.round(game.comet.mass)}`, hudX, hudY + 30);
  ctx.fillText(`Ice: ${Math.round(game.comet.ice)}`, hudX, hudY + 50);
  ctx.fillText(`Speed: ${Math.round(game.comet.speed)}`, hudX, hudY + 70);
}

function playSound(type) {
  if (!window.AudioContext) return;
  const ctx = window.audioCtx;
  let osc, gain;
  switch (type) {
    case 'thrust':
      osc = ctx.createOscillator();
      osc.type = 'sine';
      osc.frequency.value = 200;
      gain = ctx.createGain();
      gain.gain.value = 0.2;
      break;
    case 'collection':
      osc = ctx.createOscillator();
      osc.type = 'sine';
      osc.frequency.value = 800;
      gain = ctx.createGain();
      gain.gain.value = 0.3;
      break;
    case 'collision':
      osc = ctx.createOscillator();
      osc.type = 'sine';
      osc.frequency.value = 100;
      gain = ctx.createGain();
      gain.gain.value = 0.5;
      break;
    case 'solar':
      osc = ctx.createOscillator();
      osc.type = 'sawtooth';
      osc.frequency.value = 150;
      gain = ctx.createGain();
      gain.gain.value = 0.4;
      break;
    default:
      return;
  }
  osc.connect(gain).connect(ctx.destination);
  osc.start();
  osc.stop(ctx.currentTime + 0.5);
}

function startGame() {
  initGame();
  document.getElementById('startScreen').style.display = 'none';
  document.getElementById('deathScreen').style.display = 'none';
  game.running = true;
  game.startTime = performance.now();
  // start the animation loop
  requestAnimationFrame(gameLoop);
}

function gameLoop(timestamp) {
  const deltaTime = timestamp - (game.lastTime || timestamp);
  game.lastTime = timestamp;

  if (game.running) {
    update(deltaTime);
    draw();
  }

  requestAnimationFrame(gameLoop);
}

function endGame() {
  game.running = false;
  const finalTime = Math.floor(game.elapsedTime / 1000);
  document.getElementById('finalScore').textContent = finalTime;
  document.getElementById('deathScreen').style.display = 'flex';

  // update high score
  if (finalTime > game.highScore) {
    game.highScore = finalTime;
    localStorage.setItem('stellarDriftHighScore', game.highScore);
  }
}

function restartGame() {
  document.getElementById('deathScreen').style.display = 'none';
  startGame();
}

