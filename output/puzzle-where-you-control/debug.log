                if (char.vx > 0) {
                    char.x = p.x - char.width;
                } else if (char.vx < 0) {
                    char.x = p.x + p.w;
                }
                char.vx = 0;
            }
        }

        // Move Y
        char.y += char.vy * 60 * 0.016;

        // Collision Y
        for (const p of platforms) {
            if (rectCollision(char.x, char.y, char.width, char.height, p.x, p.y, p.w, p.h)) {
                if (char.vy > 0) {
                    char.y = p.y - char.height;
                    char.grounded = true;
                    if (!isPrime) char.doubleJump = true;
                    if (!char.wasGrounded && Math.abs(char.vy) > 2) {
                        audio.play('land');
                        spawnParticles(char.x + char.width/2, char.y + char.height, char.color, 5);
                    }
                } else if (char.vy < 0) {
                    char.y = p.y + p.h;
                }
                char.vy = 0;
            }
        }

        // Boundary check
        if (char.x < 0) char.x = 0;
        if (char.x + char.width > LOGICAL_WIDTH) char.x = LOGICAL_WIDTH - char.width;
        if (char.y < 0) char.y = 0;
        if (char.y > LOGICAL_HEIGHT) {
            handleDeath();
        }

        // Trail
        if (Math.abs(char.vx) > 0.5 || Math.abs(char.vy) > 0.5) {
            char.trail.push({
                x: char.x + char.width/2,
                y: char.y + char.height/2,
                age: 0
            });
        }

        // Age trail
        char.trail = char.trail.filter(t => {
            t.age += 0.016;
            return t.age < 0.3;
        });
    }

    function handleDeath() {
        deaths++;
        deathCounterEl.textContent = `DEATHS: ${deaths}`;
        audio.play('death');
        spawnParticles(prime.x + prime.width/2, prime.y + prime.height/2, COLORS.hazard, 30);
        spawnParticles(echo.x + echo.width/2, echo.y + echo.height/2, COLORS.hazard, 30);
        resetLevel();
    }

    function checkHazards() {
        for (const h of hazards) {
            if (rectCollision(prime.x, prime.y, prime.width, prime.height, h.x, h.y, h.w, h.h) ||
                rectCollision(echo.x, echo.y, echo.width, echo.height, h.x, h.y, h.w, h.h)) {
                handleDeath();
                return;
            }
        }
    }

    function checkGoals() {
        // Left goal (Prime)
        if (rectCollision(prime.x, prime.y, prime.width, prime.height, goals[0].x, goals[0].y, goals[0].w, goals[0].h)) {
            goalTimers.left += 0.016;
        } else {
            goalTimers.left = Math.max(0, goalTimers.left - 0.05);
        }

        // Right goal (Echo)
        if (rectCollision(echo.x, echo.y, echo.width, echo.height, goals[1].x, goals[1].y, goals[1].w, goals[1].h)) {
            goalTimers.right += 0.016;
        } else {
            goalTimers.right = Math.max(0, goalTimers.right - 0.05);
        }

        // Check completion
        if (goalTimers.left >= 2 && goalTimers.right >= 2 && !levelComplete) {
            levelComplete = true;
            gameState = 'complete';
            audio.play('goal');
            
            if (!bestTime || gameTime < bestTime) {
                bestTime = gameTime;
                localStorage.setItem('duality_best_time', bestTime);
                highScoreEl.textContent = `BEST: ${formatTime(bestTime)}`;
                showMessage('NEW RECORD!', '#FFD700');
            } else {
                showMessage('LEVEL COMPLETE!', '#00FF88');
            }

            setTimeout(() => {
                overlay.style.display = 'flex';
                overlay.querySelector('h1').textContent = 'COMPLETE';
                overlay.querySelector('p').textContent = `Time: ${formatTime(gameTime)}`;
                startBtn.textContent = 'PLAY AGAIN';
                gameState = 'menu';
            }, 2000);
        }
    }

    function update(dt) {
        if (gameState !== 'playing') return;

        gameTime += dt * 1000;
        timerEl.textContent = formatTime(gameTime);

        swapCooldown = Math.max(0, swapCooldown - dt);
        tetherFillEl.style.width = `${Math.max(0, (1 - swapCooldown / 1.5) * 100)}%`;
        swapIndicatorEl.textContent = swapCooldown > 0 ? `COOLDOWN ${swapCooldown.toFixed(1)}` : 'SWAP READY';
        swapIndicatorEl.style.color = swapCooldown > 0 ? '#FF6B6B' : '#fff';

        handleCharacter(prime, true);
        handleCharacter(echo, false);

        checkHazards();
        checkGoals();

        // Update particles
        for (let i = particles.length - 1; i >= 0; i--) {
            particles[i].update(dt);
            if (particles[i].life <= 0) {
                particles.splice(i, 1);
            }
        }

        // Reset key
        if (keys['KeyR']) {
            resetLevel();
            gameTime = 0;
        }
    }

    function drawTrail(ctx, trail, color) {
        for (const t of trail) {
            const alpha = 1 - t.age / 0.3;
            ctx.globalAlpha = alpha * 0.5;
            ctx.fillStyle = color;
            ctx.beginPath();
            ctx.arc(t.x * scale, t.y * scale, 8 * scale * alpha, 0, Math.PI * 2);
            ctx.fill();
        }
        ctx.globalAlpha = 1;
    }

    function drawCharacter(ctx, char, isPrime) {
        const x = char.x * scale;
        const y = char.y * scale;
        const w = char.width * scale;
        const h = char.height * scale;

        // Glow
        ctx.shadowColor = char.color;
        ctx.shadowBlur = 20;

        // Body
        ctx.fillStyle = char.color;
        ctx.beginPath();
        ctx.roundRect(x, y, w, h, 8 * scale);
        ctx.fill();

        // Inner
        ctx.fillStyle = char.colorLight;
        ctx.beginPath();
        ctx.roundRect(x + 4*scale, y + 4*scale, w - 8*scale, h - 8*scale, 4 * scale);
        ctx.fill();

        // Eyes
        const eyeY = y + 15 * scale;
        const eyeSize = 6 * scale;
        
        ctx.shadowBlur = 10;
        ctx.fillStyle = '#0a0a1a';
        ctx.beginPath();
        ctx.arc(x + w/2 - 8*scale, eyeY, eyeSize, 0, Math.PI * 2);
        ctx.arc(x + w/2 + 8*scale, eyeY, eyeSize, 0, Math.PI * 2);
        ctx.fill();

        ctx.fillStyle = '#fff';
        ctx.beginPath();
        ctx.arc(x + w/2 - 8*scale + 2*scale, eyeY - 1*scale, eyeSize/2, 0, Math.PI * 2);
        ctx.arc(x + w/2 + 8*scale + 2*scale, eyeY - 1*scale, eyeSize/2, 0, Math.PI * 2);
        ctx.fill();

        // Label
        ctx.shadowBlur = 0;
        ctx.fillStyle = '#fff';
        ctx.font = `${10 * scale}px 'JetBrains Mono', monospace`;
        ctx.textAlign = 'center';
        ctx.fillText(char.name, x + w/2, y + h - 8*scale);

        ctx.shadowBlur = 0;
    }

    function drawPlatform(ctx, p) {
        const x = p.x * scale;
        const y = p.y * scale;
        const w = p.w * scale;
        const h = p.h * scale;

        ctx.fillStyle = p.color;
        ctx.beginPath();
        ctx.roundRect(x, y, w, h, 4 * scale);
        ctx.fill();

        // Top highlight
        ctx.fillStyle = 'rgba(255,255,255,0.1)';
        ctx.fillRect(x + 2*scale, y, w - 4*scale, 2*scale);
    }

    function drawHazard(ctx, h) {
        const x = h.x * scale;
        const y = h.y * scale;
        const w = h.w * scale;
        const h2 = h.h * scale;

        // Glow
        ctx.shadowColor = h.color;
        ctx.shadowBlur = 15;

        ctx.fillStyle = h.color;
        
        // Spikes
        const spikeCount = Math.floor(w / (12 * scale));
        const spikeWidth = w / spikeCount;
        
        ctx.beginPath();
        for (let i = 0; i < spikeCount; i++) {
            const sx = x + i * spikeWidth;
            ctx.moveTo(sx, y + h2);
            ctx.lineTo(sx + spikeWidth/2, y);
            ctx.lineTo(sx + spikeWidth, y + h2);
        }
        ctx.fill();

        ctx.shadowBlur = 0;
    }

    function drawGoal(ctx, goal, index) {
        const x = goal.x * scale;
        const y = goal.y * scale;
        const w = goal.w * scale;
        const h = goal.h * scale;

        const timer = index === 0 ? goalTimers.left : goalTimers.right;
        const pulse = Math.sin(Date.now() / 200) * 0.3 + 0.7;
        const progress = timer / 2;

        // Glow
        ctx.shadowColor = goal.color;
        ctx.shadowBlur = 20 + progress * 30;

        // Outer ring
        ctx.strokeStyle = goal.color;
        ctx.lineWidth = 3 * scale;
        ctx.globalAlpha = pulse;
        ctx.beginPath();
        ctx.arc(x + w/2, y + h/2, Math.max(w, h)/2 + 10*scale, 0, Math.PI * 2);
        ctx.stroke();

        // Fill based on progress
        ctx.globalAlpha = 0.3 + progress * 0.5;
        ctx.fillStyle = goal.color;
        ctx.beginPath();
        ctx.arc(x + w/2, y + h/2, Math.max(w, h)/2, 0, Math.PI * 2 * progress);
        ctx.lineTo(x + w/2, y + h/2);
        ctx.fill();

        // Inner
        ctx.globalAlpha = 1;
        ctx.fillStyle = goal.color;
        ctx.font = `${14 * scale}px 'Orbitron', sans-serif`;
        ctx.textAlign = 'center';
        ctx.fillText(index === 0 ? 'P' : 'E', x + w/2, y + h/2 + 5*scale);

        ctx.shadowBlur = 0;
        ctx.globalAlpha = 1;
    }

    function drawTether(ctx) {
        const px = (prime.x + prime.width/2) * scale;
        const py = (prime.y + prime.height/2) * scale;
        const ex = (echo.x + echo.width/2) * scale;
        const ey = (echo.y + echo.height/2) * scale;

        const dist = Math.sqrt((ex-px)**2 + (ey-py)**2);
        const snapped = dist > TETHER_SNAP_DIST;

        // Tether line
        const gradient = ctx.createLinearGradient(px, py, ex, ey);
        gradient.addColorStop(0, COLORS.prime);
        gradient.addColorStop(1, COLORS.echo);

        ctx.strokeStyle = snapped ? COLORS.hazard : gradient;
        ctx.lineWidth = snapped ? 4 * scale : 3 * scale;
        ctx.globalAlpha = 0.6;
        ctx.setLineDash(snapped ? [10, 10] : [5, 5]);
        ctx.beginPath();
        ctx.moveTo(px, py);
        ctx.lineTo(ex, ey);
        ctx.stroke();
        ctx.setLineDash([]);
        ctx.globalAlpha = 1;

        // Distance indicator
        const midX = (px + ex) / 2;
        const midY = (py + ey) / 2;
        ctx.fillStyle = snapped ? COLORS.hazard : '#fff';
        ctx.font = `${10 * scale}px 'JetBrains Mono', monospace`;
        ctx.textAlign = 'center';
        ctx.globalAlpha = 0.8;
        ctx.fillText(`${Math.round(dist)}px`, midX, midY - 10*scale);
        ctx.globalAlpha = 1;

        // Snap warning
        if (snapped) {
            ctx.fillStyle = COLORS.hazard;
            ctx.font = `${12 * scale}px 'Orbitron', sans-serif`;
            ctx.fillText('TETHER SNAPPING!', midX, midY + 20*scale);
        }
    }

    function drawSwapPreview(ctx) {
        if (!swapPreview || swapCooldown > 0) return;

        const newPX = echo.x * scale;
        const newPY = echo.y * scale;
        const newEX = prime.x * scale;
        const newEY = prime.y * scale;

        ctx.globalAlpha = 0.4;
        ctx.strokeStyle = COLORS.prime;
        ctx.lineWidth = 2;
        ctx.setLineDash([5, 5]);
        ctx.strokeRect(newPX, newPY, prime.width * scale, prime.height * scale);
        
        ctx.strokeStyle = COLORS.echo;
        ctx.strokeRect(newEX, newEY, echo.width * scale, echo.height * scale);
        ctx.setLineDash([]);
        ctx.globalAlpha = 1;
    }

    function draw() {
        ctx.fillStyle = COLORS.bg;
        ctx.fillRect(0, 0, canvas.width, canvas.height);

        // Grid background
        ctx.strokeStyle = 'rgba(42, 42, 94, 0.3)';
        ctx.lineWidth = 1;
        const gridSize = 50 * scale;
        for (let x = 0; x < canvas.width; x += gridSize) {
            ctx.beginPath();
            ctx.moveTo(x, 0);
            ctx.lineTo(x, canvas.height);
            ctx.stroke();
        }
        for (let y = 0; y < canvas.height; y += gridSize) {
            ctx.beginPath();
            ctx.moveTo(0, y);
            ctx.lineTo(canvas.width, y);
            ctx.stroke();
        }

        // Platforms
        for (const p of platforms) {
            drawPlatform(ctx, p);
        }

        // Hazards
        for (const h of hazards) {
            drawHazard(ctx, h);
        }

        // Goals
        for (let i = 0; i < goals.length; i++) {
            drawGoal(ctx, goals[i], i);
        }

        // Tether
        drawTether(ctx);

        // Trails
        drawTrail(ctx, prime.trail, COLORS.prime);
        drawTrail(ctx, echo.trail, COLORS.echo);

        // Swap preview
        drawSwapPreview(ctx);

        // Characters
        drawCharacter(ctx, prime, true);
        drawCharacter(ctx, echo, false);

        // Particles
        for (const p of particles) {
            p.draw(ctx);
        }
    }

    function gameLoop(timestamp) {
        const dt = Math.min((timestamp - lastTime) / 1000, 0.1);
        lastTime = timestamp;

        update(dt);
        draw();

        requestAnimationFrame(gameLoop);
    }

    init();
    </script>
</body>
</html>