 isPrime ? 28 : 35;\n        const maxSpeed = MAX_HORIZONTAL_SPEED;\n        const decel = isPrime ? 60 : 5;\n\n        if (moveLeft) {\n            char.vx += (char.grounded ? accel : airAccel) * 0.016;\n        } else if (moveRight) {\n            char.vx -= (char.grounded ? accel : airAccel) * 0.016;\n        } else {\n            // Deceleration\n            if (char.grounded) {\n                if (Math.abs(char.vx) < decel * 0.016) {\n                    char.vx = 0;\n                } else {\n                    char.vx -= Math.sign(char.vx) * decel * 0.016;\n                }\n            } else if (isPrime) {\n                // Prime momentum conservation\n                char.vx *= 0.995;\n            }\n        }\n\n        // Inertia inversion for Echo\n        if (!isPrime && (moveLeft || moveRight)) {\n            const inputDir = moveLeft ? 1 : -1;\n            if (Math.sign(inputDir) !== Math.sign(char.vx) && Math.abs(char.vx) > 1.0) {\n                char.vx = -char.vx * 0.8;\n            }\n        }\n\n        // Clamp horizontal speed\n        char.vx = Math.max(-maxSpeed, Math.min(maxSpeed, char.vx));\n\n        // Coyote time\n        if (char.grounded) {\n            char.coyoteTime = 0.08;\n        } else {\n            char.coyoteTime -= 0.016;\n        }\n\n        // Jump buffer\n        if (jumpKey) {\n            char.jumpBuffer = 0.12;\n        } else {\n            char.jumpBuffer -= 0.016;\n        }\n\n        // Jump\n        if (char.jumpBuffer > 0 && char.coyoteTime > 0) {\n            char.vy = JUMP_IMPULSE;\n            char.grounded = false;\n            char.coyoteTime = 0;\n            char.jumpBuffer = 0;\n            audio.play('jump');\n            spawnParticles(char.x + char.width/2, char.y + char.height, char.color, 8);\n        }\n\n        // Echo double jump\n        if (!isPrime && !char.grounded && char.coyoteTime <= 0 && jumpKey && char.doubleJump) {\n            char.vy= JUMP_IMPULSE;
