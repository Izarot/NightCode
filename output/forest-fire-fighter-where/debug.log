  "index.html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Forest Fire Fighter</title>\n    <link rel=\"icon\" href=\"data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🚒</text></svg>\">\n    <style>\n        * { margin: 0; padding: 0; box-sizing: border-box; }\n        body { background: #111; color: #fff; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; overflow: hidden; }\n        #gameContainer { position: relative; width: 100vw; height: 100vh; }\n        #gameCanvas { display: block; margin: 0 auto; background: linear-gradient(to bottom, #87CEEB, #E0F7FF); }\n        #hud { position: absolute; top: 10px; left: 10px; color: #fff; text-shadow: 0 0 5px rgba(0,0,0,0.7); }\n        #fuelBar, #waterBar { height: 20px; width: 200px; background: rgba(0,0,0,0.5); border-radius: 10px; overflow: hidden; margin: 5px 0; }\n        #fuelFill { height: 100%; background: linear-gradient(to right, #00ff00, #ffff00, #ff0000); transition: width 0.2s; }\n        #waterFill { height: 100%; background: #00bfff; transition: width 0.2s; }\n        #score { font-size: 24px; font-weight: bold; margin: 10px 0; }\n        #timer { font-size: 18px; margin: 10px 0; }\n        #highScore { font-size: 16px; opacity: 0.8; margin-top: 5px; }\n        #windIndicator { position: absolute; top: 10px; right: 10px; width: 60px; height: 60px; }\n        #windArrow { position: absolute; top: 50%; left: 50%; width: 0; height: 0; border-left: 10px solid transparent; border-right: 10px solid transparent; border-bottom: 15px solid #00bfff; transform: translate(-50%, -50%) rotate(0deg); transition: transform 0.3s; }\n        #windSpeed { position: absolute; bottom: -20px; left: 50%; transform: translateX(-50%); font-size: 12px; }\n        #threatLevel { position: absolute; bottom: 10px; left: 50%; transform: translateX(-50%); padding: 5px 15px; border-radius: 20px; font-weight: bold; text-transform: uppercase; letter-spacing: 1px; }\n        .threat-low { background: rgba(0,255,0,0.3); color: #0f0; }\n        .threat-medium { background: rgba(255,165,0,0.3); color: #ff0; }\n        .threat-high { background: rgba(255,0,0,0.3); color: #f00; }\n        #dropPreview { position: absolute; pointer-events: none; border: 2px dashed rgba(0,191,255,0.5); border-radius: 50%; transform: translate(-50%, -50%); }\n        .mobile-controls { display: none; position: absolute; bottom: 20px; left: 50%; transform: translateX(-50%); }\n        .joystick { width: 100px; height: 100px; background: rgba(255,255,255,0.1); border-radius: 50%; position: relative; }\n        .joystick-stick { width: 40px; height: 40px; background: rgba(0,191,255,0.7); border-radius: 50%; position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); }\n        .drop-button { width: 80px; height: 80px; background: rgba(0,191,255,0.5); border-radius: 50%; position: absolute; right: -40px; top: 50%; transform: translateY(-50%); }\n        @media (max-width: 768px) {\n            .mobile-controls { display: block; }\n            #hud { left: 50%; transform: translateX(-50%); text-align: center; width: 100%; }\n            #fuelBar, #waterBar { width: 150px; }\n            #windIndicator { top: auto; bottom: 10px; }\n        }\n    </style>\n</head>\n<body>\n    <div id=\"gameContainer\">\n        <canvas id=\"gameCanvas\"></canvas>\n        <div id=\"hud\">\n            <div>Fuel: <div id=\"fuelBar\"><div id=\"fuelFill\"></div></div></div>\n            <div>Water: <div id=\"waterBar\"><div id=\"waterFill\"></div></div></div>\n            <div id=\"score\">Score: 0</div>\n            <div id=\"timer\">Time: 0s</div>\n            <div id=\"highScore\">High Score: 0</div>\n        </div>\n        <div id=\"windIndicator\">\n            <div id=\"windArrow\"></div>\n            <div id=\"windSpeed\">Wind: --</div>\n        </div>\n        <div id=\"threatLevel\">SAFE</div>\n        <div id=\"dropPreview\"></div>\n        <div class=\"mobile-controls\">\n            <div class=\"joystick\">\n                <div class=\"joystick-stick\"></div>\n            </div>\n            <div class=\"drop-button\" id=\"dropBtn\">💧</div>\n        </div>\n    </div>\n    <script type=\"module\" src=\"/src/main.js\"></script>\n</body>\n</html>",
  "src/main.js": "import { Game } from './core/Game.js';\n\nconst canvas = document.getElementById('gameCanvas');\nconst game = new Game(canvas);\ngame.start();",
  "src/core/Game.js": "import { Renderer } from './Renderer.js';\nimport { InputManager } from './InputManager.js';\nimport { Aircraft } from '../entities/Aircraft.js';\nimport { FireSystem } from '../entities/FireSystem.js';\nimport { Terrain } from '../entities/Terrain.js';\nimport { HUD } from '../ui/HUD.js';\nimport { TacticalOverlay } from '../ui/TacticalOverlay.js';\nimport { MissionTimer } from '../ui/MissionTimer.js';\nimport { WindSystem } from '../systems/WindSystem.js';\nimport { Constants } from '../utils/Constants.js';\n\nexport class Game {\n    constructor(canvas) {\n        this.canvas = canvas;\n        this.renderer = new Renderer(canvas);\n        this.input = new InputManager();\n        this.terrain = new Terrain();\n        this.fireSystem = new FireSystem(this.terrain);\n        this.windSystem = new WindSystem();\n        this.aircraft = new Aircraft(this.input, this.terrain);\n        this.hud = new HUD();\n        this.tacticalOverlay = new TacticalOverlay();\n        this.missionTimer = new MissionTimer();\n        this.lastTime = 0;\n        this.score = 0;\n        this.highScore = parseInt(localStorage.getItem('firefighterHighScore')) || 0;\n        this.isGameOver = false;\n        this.waterDropCooldown = 0;\n        this.setupEventListeners();\n        this.updateHighScoreDisplay();\n    }\n\n    setupEventListeners() {\n        window.addEventListener('resize', () => this.renderer.onResize());\n        document.getElementById('dropBtn').addEventListener('click', () => this.aircraft.dropWater());\n        this.canvas.addEventListener('pointerdown', (e) => this.input.onPointerDown(e));\n        this.canvas.addEventListener('pointermove', (e) => this.input.onPointerMove(e));\n        this.canvas.addEventListener('pointerup', (e) => this.input.onPointerUp(e));\n    }\n\n    update(deltaTime) {\n        if (this.isGameOver) return;\n\n        this.windSystem.update(deltaTime);\n        this.aircraft.update(deltaTime);\n        this.fireSystem.update(deltaTime, this.windSystem.getWindVector());\n        this.waterDropCooldown = Math.max(0, this.waterDropCooldown - deltaTime);\n\n        // Check for water drop\n        if (this.input.isDropRequested && this.waterDropCooldown <= 0 && this.aircraft.waterCapacity > 0) {\n            this.aircraft.dropWater();\n            this.waterDropCooldown = 2.0; // 2 seconds cooldown\n            this.playSound('drop');\n        }\n\n        // Update score based on fire extinguished\n        const extinguished = this.fireSystem.getExtinguishedCount();\n        this.score += extinguished * 10;\n        if (this.score > this.highScore) {\n            this.highScore = this.score;\n            localStorage.setItem('firefighterHighScore', this.highScore.toString());\n            this.updateHighScoreDisplay();\n        }\n\n        // Check game over conditions\n        if (this.aircraft.fuel <= 0 || this.fireSystem.isOutOfControl()) {\n            this.isGameOver = true;\n            this.playSound('gameover');\n        }\n\n        this.hud.update(this.aircraft, this.score);\n        this.tacticalOverlay.update(this.windSystem, this.fireSystem.getThreatLevel(), this.aircraft.getDropPreviewRadius());\n        this.missionTimer.update(deltaTime);\n    }\n\n    render() {\n        this.renderer.clear();\n        this.renderer.renderBackground();\n        this.renderer.renderTerrain(this.terrain);\n        this.renderer.renderFireSystem(this.fireSystem);\n        this.renderer.renderAircraft(this.aircraft);\n        this.renderer.renderWaterDrops(this.aircraft.getRecentDrops());\n        this.renderer.renderUI(this.hud, this.tacticalOverlay, this.missionTimer);\n        this.renderer.renderDropPreview(this.input.getDropPosition(), this.aircraft.getDropPreviewRadius());\n    }\n\n    loop(timestamp) {\n        const deltaTime = (timestamp - this.lastTime) / 1000;\n        this.lastTime = timestamp;\n        this.update(deltaTime);\n        this.render();\n        if (!this.isGameOver) {\n            requestAnimationFrame(this.loop.bind(this));\n        }\n    }\n\n    start() {\n        this.lastTime = performance.now();\n        requestAnimationFrame(this.loop.bind(this));\n    }\n\n    playSound(type) {\n        const audioContext = new (window.AudioContext || window.webkitAudioContext)();\n        const oscillator = audioContext.createOscillator();\n        const gainNode = audioContext.createGain();\n        \n        oscillator.connect(gainNode);\n        gainNode.connect(audioContext.destination);\n        \n        if (type === 'drop') {\n            oscillator.type = 'noise';\n            oscillator.frequency.setValueAtTime(200, audioContext.currentTime);\n            oscillator.frequency.exponentialRampToValueAtTime(0.01, audioContext.currentTime + 0.1);\n            gainNode.gain.setValueAtTime(0.3, audioContext.currentTime);\n            gainNode.gain.exponentialRampToValueAtTime(0.01, audioContext.currentTime + 0.1);\n        } else if (type === 'gameover') {\n            oscillator.type = 'sawtooth';\n            oscillator.frequency.setValueAtTime(100, audioContext.currentTime);\n            oscillator.frequency.exponentialRampToValueAtTime(0.01, audioContext.currentTime + 0.5);\n            gainNode.gain.setValueAtTime(0.5, audioContext.currentTime);\n            gainNode.gain.exponentialRampToValueAtTime(0.01, audioContext.currentTime + 0.5);\n        }\n        \n        oscillator.start();\n        oscillator.stop(audioContext.context.currentTime + 0.2);\n    }\n\n    updateHighScoreDisplay() {\n        document.getElementById('highScore').textContent = `High Score: ${this.highScore}`;\n    }\n}\n",
  "src/core/Renderer.js": "export class Renderer {\n    constructor(canvas) {\n        this.canvas = canvas;\n        this.ctx = canvas.getContext('2d');\n        this.onResize();\n    }\n\n    onResize() {\n        this.canvas.width = window.innerWidth;\n        this.canvas.height = window.innerHeight;\n        this.scale = Math.min(this.canvas.width / Constants.GAME_WIDTH, this.canvas.height / Constants.GAME_HEIGHT);\n        this.offsetX = (this.canvas.width - Constants.GAME_WIDTH * this.scale) / 2;\n        this.offsetY = (this.canvas.height - Constants.GAME_HEIGHT * this.scale) / 2;\n        this.ctx.save();\n        this.ctx.translate(this.offsetX, this.offsetY);\n        this.ctx.scale(this.scale, this.scale);\n    }\n\n    clear() {\n        this.ctx.restore();\n        this.ctx.save();\n        this.ctx.translate(this.offsetX, this.offsetY);\n        this.ctx.scale(this.scale, this.scale);\n        this.ctx.clearRect(0, 0, Constants.GAME_WIDTH, Constants.GAME_HEIGHT);\n    }\n\n    renderBackground() {\n        const gradient = this.ctx.createLinearGradient(0, 0, 0, Constants.GAME_HEIGHT);\n        gradient.addColorStop(0, '#87CEEB');\n        gradient.addColorStop(1, '#E0F7FF');\n        this.ctx.fillStyle = gradient;\n        this.ctx.fillRect(0, 0, Constants.GAME_WIDTH, Constants.GAME_HEIGHT);\n    }\n\n    renderTerrain(terrain) {\n        for (let y = 0; y < terrain.height; y++) {\n            for (let x = 0; x < terrain.width; x++) {\n                const type = terrain.getTile(x, y);\n                let color;\n                switch (type) {\n                    case Constants.TERRAIN.TREE: color = '#228B22'; break;\n                    case Constants.TERRAIN.GRASS: color = '#006400'; break;\n                    case Constants.TERRAIN.ROCK: color = '#8B8B83'; break;\n                    case Constants.TERRAIN.WATER: color = '#1E90FF'; break;\n                    default: color = '#000';\n                }\n                this.ctx.fillStyle = color;\n                this.ctx.fillRect(x * Constants.TILE_SIZE, y * Constants.TILE_SIZE, Constants.TILE_SIZE, Constants.TILE_SIZE);\n            }\n        }\n    }\n\n    renderFireSystem(fireSystem) {\n        const fireData = fireSystem.getFireData();\n        for (let y = 0; y < fireData.height; y++) {\n            for (let x = 0; x < fireData.width; x++) {\n                const intensity = fireData.getIntensity(x, y);\n                if (intensity > 0) {\n                    const size = Constants.TILE_SIZE * 0.8;\n                    const offset = (Constants.TILE_SIZE - size) / 2;\n                    const gradient = this.ctx.createRadialGradient(\n                        x * Constants.TILE_SIZE + offset + size/2,\n                        y * Constants.TILE_SIZE + offset + size/2,\n                        0,\n                        x * Constants.TILE_SIZE + offset + size/2,\n                        y * Constants.TILE_SIZE + offset + size/2,\n                        size/2\n                    );\n                    if (intensity < 0.3) gradient.addColorStop(0, '#FF4500').addColorStop(1, '#FFA500');\n                    else if (intensity < 0.7) gradient.addColorStop(0, '#FFA500').addColorStop(1, '#FFFF00');\n                    else gradient.addColorStop(0, '#FFFF00').addColorStop(1, '#FF0000');\n                    this.ctx.fillStyle = gradient;\n                    this.ctx.beginPath();\n                    this.ctx.arc(x * Constants.TILE_SIZE + offset + size/2, y * Constants.TILE_SIZE + offset + size/2, size/2, 0, Math.PI * 2);\n                    this.ctx.fill();\n                }\n            }\n        }\n    }\n\n    renderAircraft(aircraft) {\n        const { x, y, angle } = aircraft.getState();\n        this.ctx.save();\n        this.ctx.translate(x, y);\n        this.ctx.rotate(angle);\n        this.ctx.fillStyle = '#FF8C00';\n        this.ctx.beginPath();\n        this.ctx.moveTo(-20, -10);\n        this.ctx.lineTo(20, 0);\n        this.ctx.lineTo(-20, 10);\n        this.ctx.lineTo(-15, 0);\n        this.ctx.closePath();\n        this.ctx.fill();\n        this.ctx.restore();\n    }\n\n    renderWaterDrops(drops) {\n        drops.forEach(drop => {\n            const { x, y, radius, alpha } = drop;\n            this.ctx.save();\n            this.ctx.globalAlpha = alpha;\n            this.ctx.fillStyle = 'rgba(30,144,255,0.3)';\n            this.ctx.beginPath();\n            this.ctx.arc(x, y, radius, 0, Math.PI * 2);\n            this.ctx.fill();\n            this.ctx.strokeStyle = 'rgba(30,144,255,0.7)';\n            this.ctx.lineWidth = 2;\n            this.ctx.stroke();\n            this.ctx.restore();\n        });\n    }\n\n    renderUI(hud, tacticalOverlay, missionTimer) {\n        this.ctx.restore();\n        hud.render(this.ctx);\n        tacticalOverlay.render(this.ctx);\n        missionTimer.render(this.ctx);\n        this.ctx.save();\n        this.ctx.translate(this.offsetX, this.offsetY);\n        this.ctx.scale(this.scale, this.scale);\n    }\n\n    renderDropPreview(position, radius) {\n        if (!position) return;\n        this.ctx.save();\n        this.ctx.globalAlpha = 0.3;\n        this.ctx.strokeStyle = '#00BFFF';\n        this.ctx.lineWidth = 2;\n        this.ctx.setLineDash([5, 5]);\n        this.ctx.beginPath();\n        this.ctx.arc(position.x, position.y, radius, 0, Math.PI * 2);\n        this.ctx.stroke();\n        this.ctx.restore();\n    }\n}\n",
  "src/core/InputManager.js": "export class InputManager {\n    constructor() {\n        this.keys = {};\n        this.pointerPos = { x: 0, y: 0 }; \n        this.isDropRequested = false;\n        this.joystick = { active: false, pos: { x: 0, y: 0 } };\n        this.setupListeners();\n    }\n\n    setupListeners() {\n        window.addEventListener('keydown', (e) => { this.keys[e.code] = true; });\n        window.addEventListener('keyup', (e) => { this.keys[e.code] = false; });\n        \n        window.addEventListener('touchstart', (e) => this.handleTouchStart(e), { passive: false });\n        window.addEventListener('touchmove', (e) => this.handleTouchMove(e), { passive: false });\n        window.addEventListener('touchend', (e) => this.handleTouchEnd(e), { passive: false });\n        \n        window.addEventListener('mousedown', (e) => this.handleMouseDown(e));\n        window.addEventListener('mousemove', (e) => this.handleMouseMove(e));\n        window.addEventListener('mouseup', (e) => this.handleMouseUp(e));\n    }\n\n    handleTouchStart(e) {\n        e.preventDefault();\n        const touch = e.touches[0];\n        this.processInput(touch.clientX, touch.clientY);\n        if (this.isDropButton(touch.clientX, touch.clientY)) {\n            this.isDropRequested = true;\n        }\n        if (this.isInJoystick(touch.clientX, touch.clientY)) {\n            this.joystick.active = true;\n            this.updateJoystick(touch.clientX, touch.clientY);\n        }\n    }\n\n    handleTouchMove(e) {\n        e.preventDefault();\n        if (e.touches.length === 0) return;\n        const touch = e.touches[0];\n        this.processInput(touch.clientX, touch.clientY);\n        if (this.joystick.active) {\n            this.updateJoystick(touch.clientX, touch.clientY);\n        }\n    }\n\n    handleTouchEnd(e) {\n        e.preventDefault();\n        this.isDropRequested = false;\n        this.joystick.active = false;\n        this.joystick.pos = { x: 0, y: 0 };\n    }\n\n    handleMouseDown(e) {\n        this.processInput(e.clientX, e.clientY);\n        if (this.isDropButton(e.clientX, e.clientY)) {\n            this.isDropRequested = true;\n        }\n        if (this.isInJoystick(e.clientX, e.clientY)) {\n            this.joystick.active = true;\n            this.updateJoystick(e.clientX, e.clientY);\n        }\n    }\n\n    handleMouseMove(e) {\n        this.processInput(e.clientX, e.clientY);\n        if (this.joystick.active) {\n            this.updateJoystick(e.clientX, e.clientY);\n        }\n    }\n\n    handleMouseUp(e) {\n        this.isDropRequested = false;\n        this.joystick.active = false;\n        this.joystick.pos = { x: 0, y: 0 };\n    }\n\n    processInput(clientX, clientY) {\n        const canvas = document.getElementById('gameCanvas');\n        const rect = canvas.getBoundingClientRect();\n        const scaleX = canvas.width / rect.width;\n        const scaleY = canvas.height / rect.height;\n        this.pointerPos.x = (clientX - rect.left) * scaleX;\n        this.pointerPos.y = (clientY - rect.top) * scaleY;\n    }\n\n    isDropButton(clientX, clientY) {\n        const canvas = document.getElementById('gameCanvas');\n        const rect = canvas.getBoundingClientRect();\n        const dropBtn = document.getElementById('dropBtn');\n        const btnRect = dropBtn.getBoundingClientRect();\n        return clientX >= btnRect.left && clientX <= btnRect.right &&\n               clientY >= btnRect.top && clientY <= btnRect.bottom;\n    }\n\n    isInJoystick(clientX, clientY) {\n        const canvas = document.getElementById('gameCanvas');\n        const rect = canvas.getBoundingClientRect();\n        const joystickSize = 100;\n        const joystickX = rect.left + 20;\n        const joystickY = rect.bottom - joystickSize - 20;\n        const dx = clientX - (joystickX + joystickSize/2);\n        const dy = clientY - (joystickY + joystickSize/2);\n        return Math.sqrt(dx*dx + dy*dy) <= joystickSize/2;\n    }\n\n    updateJoystick(clientX, clientY) {\n        const canvas = document.getElementById('gameCanvas');\n        const rect = canvas.getBoundingClientRect();\n        const joystickSize = 100;\n        const centerX = rect.left + 20 + joystickSize/2;\n        const centerY = rect.bottom - joystickSize/2 - 20;\n\n        const dx = clientX - centerX;\n        const dy = clientY - centerY;\n        const distance = Math.sqrt(dx*dx + dy*dy);\n        const maxDistance = joystickSize/2;\n        if (distance > maxDistance) {\n            const angle = Math.atan2(dy, dx);\n            this.joystick.pos.x = Math.cos(angle) * maxDistance;\n            this.joystick.pos.y = Math.sin(angle) * maxDistance;\n        } else {\n            this.joystick.pos.x = dx;\n            this.joystick.pos.y = dy;\n        }\n    }\n\n    getJoystickDirection() {\n        if (!this.joystick.active) return { x: 0, y: 0 };\n        const max = 50; // half of joystickSize\n        return {\n            x: this.joystick.pos.x / max,\n            y: this.joystick.pos.y / max\n        };\n    }\n\n    isDropRequested() {\n        return this.isDropRequested;\n    }\n\n    getDropPosition() {\n        return { x: this.pointerPos.x, y: this.pointerPos.y };\n    }\n}\",\"src/entities/Aircraft.js\":\"export class Aircraft {\\n    constructor(input, terrain) {\\n        this.input = input;\\n        this.terrain = terrain;\\n        this.x = Constants.GAME_WIDTH * 0.5;\\n        this.y = Constants.GAME_HEIGHT * 0.2;\\n        this.angle = 0;\\n        this.speed = 150;\\n        this.fuel = 100;\\n        this.waterCapacity = 100;\\n        this.maxFuel = 100;\\n        this.maxWater = 100;\\n        this.recentDrops = [];\\n        this.dropCooldown = 0;\\n    }\\n\\n    update(deltaTime) {\\n        const dir = this.input.getJoystickDirection();\\n        const moveX = dir.x * this.speed * deltaTime;\\n        const moveY = dir.y * this.speed * deltaTime;\\n        this.x += moveX;\\n        this.y += moveY;\\n        // keep within bounds\\n        this.x = Math.max(0, Math.min(Constants.GAME_WIDTH, this.x));\\n        this.y = Math.max(0, Math.min(Constants.GAME_HEIGHT, this.y));\\n        // update angle based on movement\\n        if (dir.x !== 0 || dir.y !== 0) {\\n            this.angle = Math.atan2(dir.y, dir.x);\\n        }\\n        // fuel consumption\\n        this.fuel = Math.max(0, this.fuel - deltaTime * 10);\\n        this.dropCooldown = Math.max(0, this.dropCooldown - deltaTime);\\n    }\\n\\n    dropWater() {\\n        if (this.waterCapacity <= 0) return;\\n        const dropAmount = 20;\\n        const actual = Math.min(dropAmount, this.waterCapacity);\\n        this.waterCapacity -= actual;\\n        this.recentDrops.push({\\n            x: this.x,\\n            y: this.y,\\n            radius: 30,\\n            alpha: 1.0\\n        });\\n        // keep only recent drops\\n        if (this.recentDrops.length > 5) this.recentDrops.shift();\\n    }\\n\\n    getState() {\\n        return { x: this.x, y: this.y, angle: this.angle };\\n    }\\n\\n    getRecentDrops() {\\n        return this.recentDrops.map(d => ({ ...d, alpha: d.alpha * 0.8 })); // fade\\n    }\\n\\n    getDropPreviewRadius() {\\n        return 40;\\n    }\\n}\",\"src/entities/FireSystem.js\":\"export class FireSystem {\\n    constructor(terrain) {\\n        this.terrain = terrain;\\n        this.width = Math.floor(Constants.GAME_WIDTH / Constants.TILE_SIZE);\\n        this.height = Math.floor(Constants.GAME_HEIGHT / Constants.TILE_SIZE);\\n        this.intensity = new Array(this.width * this.height).fill(0);\\n        this.igniteRandom();\\n    }\\n\\n    igniteRandom() {\\n        for (let i = 0; i < 5; i++) {\\n            const x = Math.floor(Math.random() * this.width);\\n            const y = Math.floor(Math.random() * this.height);\\n            this.setIntensity(x, y, 1.0);\\n        }\\n    }\\n\\n    setIntensity(x, y, value) {\\n        if (x < 0 || x >= this.width || y < 0 || y >= this.height) return;\\n        this.intensity[y * this.width + x] = Math.min(1, Math.max(0, value));\\n    }\\n\\n    getIntensity(x, y) {\\n        if (x < 0 || x >= this.width || y < 0 || y >= this.height) return 0;\\n        return this.intensity[y * this.width + x];\\n    }\\n\\n    update(deltaTime, windVector) {\\n        // spread fire\\n        const spreadRate = 0.3 * deltaTime;\\n        const newIntensity = this.intensity.slice();\\n        for (let y = 0; y < this.height; y++) {\\n            for (let x = 0; x < this.width; x++) {\\n                const idx = y * this.width + x;\\n                let val = this.intensity[idx];\\n                if (val <= 0) continue;\\n                // spread to neighbors\\n                const dirs = [[-1,0],[1,0],[0,-1],[0,1]];\\n                for (const [dx, dy] of dirs) {\\n                    const nx = x + dx;\\n                    const ny = y + dy;\\n                    if (nx < 0 || nx >= this.width || ny < 0 || ny >= this.height) continue;\\n                    const nIdx = ny * this.width + nx;\\n                    const windFactor = 1 + (windVector.x * dx + windVector.y * dy) * 0.5;\\n                    const add = val * spreadRate * Math.max(0, windFactor);\\n                    newIntensity[nIdx] = Math.min(1, this.intensity[nIdx] + add);\\n                }\\n                // natural decay\\n                newIntensity[idx] = Math.max(0, val - 0.1 * deltaTime);\\n            }\\n        }\\n        this.intensity = newIntensity;\\n    }\\n\\n    extinguishAt(x, y, radius) {\\n        const r2 = radius * radius;\\n        for (let dy = -radius; dy <= radius; dy++) {\\n            for (let dx = -dx; dx <= radius; dx++) {\\n                if (dx*dx + dy*dy > r2) continue;\\n                const nx = x + dx;\\n                const ny = y + dy;\\n                if (nx < 0 || nx >= this.width || ny < 0 || ny >= this.height) continue;\\n                this.setIntensity(nx, ny, this.getIntensity(nx, ny) * 0.3);\\n            }\\n        }\\n    }\\n\\n    getExtinguishedCount() {\\n        let count = 0;\\n        for (let i = 0; i < this.intensity.length; i++) {\\n            if (this.intensity[i] === 0) count++;\\n        }\\n        return count;\\n    }\\n\\n    isOutOfControl() {\\n        const total = this.intensity.reduce((a,b)=>a+b,0);\\n        return total > this.width * this.height * 0.5;\\n    }\\n\\n    getThreatLevel() {\\n        const total = this.intensity.reduce((a,b)=>a+b,0);\\n        const ratio = total / (this.width * this.height);\\n        if (ratio < 0.2) return 'low';\\n        if (ratio < 0.5) return 'medium';\\n        return 'high';\\n    }\\n\\n    getFireData() {\\n        return { width: this.width, height: this.height, getIntensity: (x,y)=>this.getIntensity(x,y) };\\n    }\\n}\",\"src/entities/Terrain.js\":\"export class Terrain {\\n    constructor() {\\n        this.width = Math.floor(Constants.GAME_WIDTH / Constants.TILE_SIZE);\\n        this.height = Math.floor(Constants.GAME_HEIGHT / Constants.TILE_SIZE);\\n        this.tiles = new Array(this.width * this.height);\\n        this.generate();\\n    }\\n\\n    generate() {\\n        for (let y = 0; y < this.height; y++) {\\n            for (let x = 0; x < this.width; x++) {\\n                const noise = Math.random();\\n                if (noise < 0.1) this.setTile(x, y, Constants.TERRAIN.ROCK);\\n                else if (noise < 0.3) this.setTile(x, y, Constants.TERRAIN.WATER);\\n                else if (noise < 0.6) this.setTile(x, y, Constants.TERRAIN.TREE);\\n                else this.setTile(x, y, Constants.TERRAIN.GRASS);\\n            }\\n        }\\n    }\\n\\n    setTile(x, y, type) {\\n        if (x < 0 || x >= this.width || y < 0 || y >= this.height) return;\\n        this.tiles[y * this.width + x] = type;\\n    }\\n\\n    getTile(x, y) {\\n        if (x < 0 || x >= this.width || y < 0 || y >= this.height) return Constants.TERRAIN.GRASS;\\n        return this.tiles[y * this.width + x];\\n    }\\n}\",\"src/ui/HUD.js\":\"export class HUD {\\n    constructor() {\\n        this.fuelElement = document.getElementById('fuelFill');\\n        this.waterElement = document.getElementById('waterFill');\\n        this.scoreElement = document.getElementById('score');\\n    }\\n\\n    update(aircraft, score) {\\n        const fuelPercent = (aircraft.fuel / aircraft.maxFuel) * 100;\\n        this.fuelElement.style.width = fuelPercent + '%';\\n        const waterPercent = (aircraft.waterCapacity / aircraft.maxWater) * 100;\\n        this.waterElement.style.width = waterPercent + '%';\\n        this.scoreElement.textContent = `Score: ${score}`;\\n    }\\n\\n    render(ctx) {\\n        // HUD is DOM-based, nothing to render on canvas\\n    }\\n}\",\"src/ui/TacticalOverlay.js\":\"export class TacticalOverlay {\\n    constructor() {\\n        this.windIndicator = document.getElementById('windArrow');\\n        this.windSpeed = document.getElementById('windSpeed');\\n        this.threatLevel = document.getElementById('threatLevel');\\n    }\\n\\n    update(windSystem, threatLevel, previewRadius) {\\n        const vec = windSystem.getWindVector();\\n        const angle = Math.atan2(vec.y, vec.x);\\n        this.windIndicator.style.transform = `translate(-50%, -50%) rotate(${angle}rad)`;\\n        const speed = Math.sqrt(vec.x*vec.x + vec.y*vec.y);\\n        this.windSpeed.textContent = `Wind: ${speed.toFixed(1)} m/s`;\\n        this.threatLevel.textContent = threatLevel.toUpperCase();\\n        this.threatLevel.className = `threat-${threatLevel}`;\\n        // preview radius could be used to adjust drop preview size\\n    }\\n\\n    render(ctx) {\\n        // overlay is DOM-based\\n    }\\n}\",\"src/ui/MissionTimer.js\":\"export class MissionTimer {\\n    constructor() {\\n        this.element = document.getElementById('timer');\\n        this.elapsed = 0;\\n    }\\n\\n    update(deltaTime) {\\n        this.elapsed += deltaTime;\\n        const secs = Math.floor(this.elapsed);\\n        this.element.textContent = `Time: ${secs}s`;\\n    }\\n\\n    render(ctx) {\\n        // timer is DOM-based\\n    }\\n}\",\"src/systems/WindSystem.js\":\"export class WindSystem {\\n    constructor() {\\n        this.angle = 0;\\n        this.speed = 2;\\n        this.changeTimer = 0;\\n    }\\n\\n    update(deltaTime) {\\n        this.changeTimer += deltaTime;\\n        if (this.changeTimer > 5) {\\n            this.changeTimer = 0;\\n            // random wind change\\n            this.angle += (Math.random() - 0.5) * 0.5;\\n            this.speed = Math.max(0.5, Math.min(5, this.speed + (Math.random() - 0.5)));\\n        }\\n    }\\n\\n    getWindVector() {\\n        return {\\n            x: Math.cos(this.angle) * this.speed,\\n            y: Math.sin(this.angle) * this.speed\\n        };\\n    }\\n}\",\"src/utils/Constants.js\":\"export const Constants = {\\n    GAME_WIDTH: 800,\\n    GAME_HEIGHT: 600,\\n    TILE_SIZE: 40,\\n    TERRAIN: {\\n        GRASS: 0,\\n        TREE: 1,\\n        ROCK: 2,\\n        WATER: 3\\n    }\\n};\"}\n"}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}