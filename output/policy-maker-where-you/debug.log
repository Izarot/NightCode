Raw: {"index.html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\" />\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, user-scalable=no\" />\n<title>🏛️ Industry Regulator</title>\n<link rel=\"icon\" href=\"data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🏛️</text></svg>\" />\n<link rel=\"stylesheet\" href=\"css/main.css\" />\n</head>\n<body>\n<canvas id=\"gameCanvas\"></canvas>\n<div id=\"ui-root\">\n  <header id=\"hud\">\n    <div class=\"hud-title\">INDUSTRY REGULATOR v1.0</div>\n    <div class=\"hud-stats\">\n      <div class=\"hud-stat\"><span class=\"label\">Quarter</span><span id=\"quarterLabel\">Q1</span></div>\n      <div class=\"hud-stat\"><span class=\"label\">Budget</span><span id=\"budgetLabel\">$10,000M</span></div>\n      <div class=\"hud-stat\"><span class=\"label\">Approval</span><span id=\"approvalLabel\">70%</span></div>\n      <div class=\"hud-stat\"><span class=\"label\">Speedrun</span><span id=\"speedrunTimer\">00:00</span></div>\n    </div>\n    <div class=\"hud-metrics\">\n      <div class=\"metric\"><span>Economy</span><div class=\"bar\"><div id=\"bar-economy\" class=\"fill economy\"></div></div><span id=\"val-economy\">60</span></div>\n      <div class=\"metric\"><span>Workers</span><div class=\"bar\"><div id=\"bar-workers\" class=\"fill workers\"></div></div><span id=\"val-workers\">60</span></div>\n      <div class=\"metric\"><span>Environment</span><div class=\"bar\"><div id=\"bar-environment\" class=\"fill env\"></div></div><span id=\"val-environment\">60</span></div>\n      <div class=\"metric\"><span>Politics</span><div class=\"bar\"><div id=\"bar-politics\" class=\"fill politics\"></div></div><span id=\"val-politics\">60</span></div>\n    </div>\n  </header>\n  <aside id=\"policyPanel\" class=\"panel\">\n    <h2>Policy Tools</h2>\n    <div class=\"policy\" data-policy=\"emissions\">\n      <h3>Emissions Cap</h3>\n      <label>Threshold (ppm): <span class=\"val\" id=\"v-emissions-th\">500</span></label>\n      <input type=\"range\" min=\"100\" max=\"1000\" step=\"50\" value=\"500\" id=\"s-emissions-th\" />\n      <label>Penalty ($): <span class=\"val\" id=\"v-emissions-pen\">500</span></label>\n      <input type=\"range\" min=\"100\" max=\"5000\" step=\"100\" value=\"500\" id=\"s-emissions-pen\" />\n      <button class=\"toggle\" data-policy=\"emissions\">Activate</button>\n    </div>\n    <div class=\"policy\" data-policy=\"worker\">\n      <h3>Worker Safety</h3>\n      <label>Max Hours: <span class=\"val\" id=\"v-worker-hr\">40</span></label>\n      <input type=\"range\" min=\"20\" max=\"60\" step=\"2\" value=\"40\" id=\"s-worker-hr\" />\n      <label>Break (min): <span class=\"val\" id=\"v-worker-br\">30</span></label>\n      <input type=\"range\" min=\"0\" max=\"60\" step=\"5\" value=\"30\" id=\"s-worker-br\" />\n      <button class=\"toggle\" data-policy=\"worker\">Activate</button>\n    </div>\n    <div class=\"policy\" data-policy=\"tax\">\n      <h3>Corporate Tax</h3>\n      <label>Rate (%): <span class=\"val\" id=\"v-tax-rate\">15</span></label>\n      <input type=\"range\" min=\"0\" max=\"50\" step=\"1\" value=\"15\" id=\"s-tax-rate\" />\n      <button class=\"toggle\" data-policy=\"tax\">Activate</button>\n    </div>\n    <div class=\"policy\" data-policy=\"antitrust\">\n      <h3>Antitrust</h3>\n      <label>Threshold: <span class=\"val\" id=\"v-anti-th\">50</span></label>\n      <input type=\"range\" min=\"20\" max=\"80\" step=\"5\" value=\"50\" id=\"s-anti-th\" />\n      <button class=\"toggle\" data-policy=\"antitrust\">Activate</button>\n    </div>\n    <div class=\"policy\" data-policy=\"inspection\">\n      <h3>Inspection Rate</h3>\n      <label>Visits/qtr: <span class=\"val\" id=\"v-insp-r\">3</span></label>\n      <input type=\"range\" min=\"0\" max=\"10\" step=\"1\" value=\"3\" id=\"s-insp-r\" />\n      <button class=\"toggle\" data-policy=\"inspection\">Activate</button>\n    </div>\n    <div class=\"quick-actions\">\n      <button id=\"runQuarter\">▶ Run Quarter</button>\n      <button id=\"pauseBtn\">⏸ Pause</button>\n      <button id=\"resetBtn\">↺ Reset</button>\n    </div>\n  </aside>\n  <footer id=\"eventLog\"></footer>\n  <div id=\"modalRoot\"></div>\n</div>\n<script src=\"js/main.js\" defer></script>\n</body>\n</html>\n", "css/main.css": ":root{\n  --bg:#0f1822;\n  --primary:#1a2634;\n  --secondary:#2d4a3e;\n  --accent:#f4a261;\n  --warning:#e63946;\n  --success:#2a9d8f;\n  --text:#e8f1f5;\n  --muted:#8aa1b1;\n}\n*{box-sizing:border-box;font-family:'Segoe UI',system-ui,sans-serif;}\nhtml,body{margin:0;padding:0;height:100%;width:100%;background:var(--bg);color:var(--text);overflow:hidden;touch-action:manipulation;}\n#gameCanvas{position:fixed;inset:0;width:100vw;height:100vh;display:block;z-index:0;}\n#ui-root{position:relative;z-index:1;height:100vh;display:flex;flex-direction:column;}\n#hud{\n  background:linear-gradient(180deg,rgba(26,38,52,.95),rgba(26,38,52,.75));\n  border-bottom:2px solid var(--accent);\n  padding:8px 14px;\n  display:flex;\n  flex-wrap:wrap;\n  gap:10px;\n  align-items:center;\n  font-size:13px;\n  backdrop-filter:blur(6px);\n}\n.hud-title{font-weight:700;color:var(--accent);letter-spacing:1px;font-size:14px;margin-right:auto;}\n.hud-stats{display:flex;gap:14px;flex-wrap:wrap;}\n.hud-stat{display:flex;flex-direction:column;align-items:center;background:rgba(45,74,62,.4);padding:4px 10px;border-radius:6px;border:1px solid rgba(244,162,97,.3);}\n.hud-stat .label{font-size:10px;color:var(--muted);text-transform:uppercase;}\n.hud-stat span:last-child{font-weight:700;color:var(--accent);font-size:14px;}\n.hud-metrics{display:flex;gap:8px;width:100%;margin-top:4px;}\n.metric{flex:1;display:flex;flex-direction:column;gap:2px;font-size:10px;}\n.metric span:first-child{color:var(--muted);}\n.metric span:last-child{color:var(--accent);font-weight:700;text-align:right;}\n.bar{height:8px;background:rgba(255,255,255,.08);border-radius:4px;overflow:hidden;border:1px solid rgba(255,255,255,.05);}\n.fill{height:100%;transition:width .6s ease;}\n.fill.economy{background:linear-gradient(90deg,#2a9d8f,#f4a261);}\n.fill.workers{background:linear-gradient(90deg,#f4a261,#e63946);}\n.fill.env{background:linear-gradient(90deg,#2d4a3e,#2a9d8f);}\n.fill.politics{background:linear-gradient(90deg,#1a2634,#f4a261);}\n#policyPanel{\n  position:fixed;\n  right:0;top:0;bottom:0;\n  width:min(340px,90vw);\n  background:rgba(26,38,52,.96);\n  border-left:2px solid var(--accent);\n  padding:14px;\n  overflow-y:auto;\n  transform:translateX(100%);\n  transition:transform .35s ease;\n  z-index:10;\n  backdrop-filter:blur(8px);\n}\n#policyPanel.open{transform:translateX(0);}\n#policyPanel h2{color:var(--accent);margin:0 0 10px;font-size:16px;letter-spacing:1px;}\n.policy{background:rgba(45,74,62,.3);border:1px solid rgba(244,162,97,.2);border-radius:8px;padding:10px;margin-bottom:10px;}\n.policy h3{margin:0 0 8px;color:var(--success);font-size:13px;}\n.policy label{display:flex;justify-content:space-between;font-size:11px;color:var(--muted);margin-top:6px;}\n.policy label .val{color:var(--accent);font-weight:700;}\n.policy input[type=range]{width:100%;accent-color:var(--accent);margin-top:4px;}\n.policy .toggle{\n  margin-top:8px;width:100%;\n  background:var(--secondary);color:var(--text);\n  border:1px solid var(--accent);border-radius:6px;\n  padding:6px;font-size:11px;cursor:pointer;font-weight:700;\n}\n.policy .toggle.active{background:var(--accent);color:var(--primary);}\n.quick-actions{display:flex;gap:6px;margin-top:12px;}\n.quick-actions button{\n  flex:1;background:var(--secondary);color:var(--text);\n  border:1px solid var(--accent);border-radius:6px;\n  padding:8px;font-size:11px;cursor:pointer;font-weight:700;\n}\n.quick-actions button:hover{background:var(--accent);color:var(--primary);}\n#eventLog{\n  position:fixed;left:0;right:0;bottom:0;\n  background:rgba(15,24,34,.92);\n  border-top:1px solid var(--accent);\n  padding:6px 14px;font-size:11px;\n  height:60px;overflow:hidden;z-index:5;\n  display:flex;flex-direction:column-reverse;\n  backdrop-filter:blur(4px);\n}\n#eventLog .event{padding:2px 0;color:var(--muted);animation:fadeIn .4s;}\n#eventLog .event.good{color:var(--success);}\n#eventLog .event.bad{color:var(--warning);}\n#eventLog .event.warn{color:var(--accent);}\n@keyframes fadeIn{from{opacity:0;transform:translateY(8px);}to{opacity:1;transform:none;}}\n#panelToggle{\n  position:fixed;right:10px;top:90px;z-index:11;\n  background:var(--accent);color:var(--primary);\n  border:none;border-radius:50%;\n  width:46px;height:46px;font-size:20px;cursor:pointer;\n  box-shadow:0 4px 12px rgba(0,0,0,.4);\n}\n#modalRoot{position:fixed;inset:0;display:flex;align-items:center;justify-content:center;z-index:20;pointer-events:none;}\n.modal{\n  pointer-events:auto;\n  background:rgba(26,38,52,.97);\n  border:2px solid var(--accent);\n  border-radius:12px;padding:20px;\n  max-width:min(420px,90vw);\n  box-shadow:0 8px 30px rgba(0,0,0,.6);\n  animation:pop .3s ease;\n}\n@keyframes pop{from{transform:scale(.8);opacity:0;}to{transform:none;opacity:1;}}\n.modal h3{color:var(--accent);margin:0 0 10px;}\n.modal p{color:var(--text);font-size:13px;line-height:1.5;}\n.modal button{\n  background:var(--accent);color:var(--primary);\n  border:none;padding:8px 16px;border-radius:6px;\n  font-weight:700;cursor:pointer;margin-top:10px;\n}\n@media (max-width:600px){\n  .hud-title{font-size:11px;}\n  .hud-metrics{flex-wrap:wrap;}\n  .metric{min-width:48%;}\n  #policyPanel{width:90vw;}\n}\n", "js/main.js": "// Entry point: orchestrates state machine and bootstraps modules\nimport { State } from \"./core/state.js\";\nimport { Simulation } from \"./core/simulation.js\";\nimport { Events } from \"./core/events.js\";\nimport { initDashboard } from \"./ui/dashboard.js\";\nimport { initPolicyPanel } from \"./ui/policyPanel.js\";\nimport { initIndustryView } from \"./ui/industryView.js\";\nimport { showModal, logEvent } from \"./ui/modals.js\";\nimport { Audio } from \"./utils/audio.js\";\nimport { SaveSystem } from \"./utils/saveSystem.js\";\n\nconst PHASES = { MENU:\"MENU\", BRIEFING:\"BRIEFING\", DRAFTING:\"DRAFTING\", SIMULATION:\"SIMULATION\", REVIEW:\"REVIEW\" };\n\nclass Game{\n  constructor(){\n    this.state = new State();\n    this.simulation = new Simulation(this.state);\n    this.events = new Events(this.state, this.simulation);\n    this.audio = new Audio();\n    this.save = new SaveSystem();\n    this.phase = PHASES.MENU;\n    this.paused = false;\n    this.startTime = Date.now();\n    this.quarterStart = 0;\n    this.simProgress = 0;\n    this.simDuration = 4500; // ms\n    this.highScore = this.save.loadHighScore();\n\n    this.canvas = document.getElementById(\"gameCanvas\");\n    this.ctx = this.canvas.getContext(\"2d\");\n\n    this.state.highScore = this.highScore;\n    this.resize();\n    window.addEventListener(\"resize\", ()=>this.resize());\n\n    initDashboard(this);\n    initPolicyPanel(this);\n    initIndustryView(this);\n    this.setupKeyboard();\n\n    this.start();\n    requestAnimationFrame(t=>this.loop(t));\n  }\n  resize(){\n    const dpr = window.devicePixelRatio || 1;\n    this.canvas.width = window.innerWidth * dpr;\n    this.canvas.height = window.innerHeight * dpr;\n    this.canvas.style.width = window.innerWidth + \"px\";\n    this.canvas.style.height = window.innerHeight + \"px\";\n    this.ctx.setTransform(dpr,0,0,dpr,0,0);\n    this.W = window.innerWidth;\n    this.H = window.innerHeight;\n  }\n  setupKeyboard(){\n    document.addEventListener(\"keydown\", e=>{\n      if(e.key===\" \"){e.preventDefault();this.togglePause();}\n      if(e.key===\"Enter\"){this.endQuarterEarly();}\n      if(e.key===\"Tab\"){e.preventDefault();this.simulation.cycleSector();}\n      if([\"1\",\"2\",\"3\",\"4\",\"5\"].includes(e.key)){\n        const order = [\"emissions\",\"worker\",\"tax\",\"antitrust\",\"inspection\"];\n        const id = order[parseInt(e.key)-1];\n        document.querySelector(`[data-policy=\"${id}\"] .toggle`)?.click();\n        this.audio.click();\n      }\n    });\n  }\n  start(){\n    this.state.reset();\n    this.state.highScore = this.highScore;\n    this.phase = PHASES.BRIEFING;\n    this.audio.init();\n    showModal({\n      title:\"Welcome, Director\",\n      body:`You lead the National Regulatory Agency.<br/>Draft policies, then watch industries react.<br/><br/>🏆 High Score: <strong>${this.highScore}</strong><br/><br/>Press <strong>1-5</strong> for policies, <strong>Space</strong> to pause, <strong>Enter</strong> to end quarter early.`,\n      button:\"Begin Term\"\n    });\n    logEvent(\"🟢 Your term as Director begins. Tabs on the right for policy tools.\",\"good\");\n    setTimeout(()=>this.phase = PHASES.DRAFTING, 100);\n  }\n  runQuarter(){\n    if(this.phase!==PHASES.DRAFTING && this.phase!==PHASES.REVIEW) return;\n    this.audio.drum();\n    this.phase = PHASES.SIMULATION;\n    this.quarterStart = Date.now();\n    this.simProgress = 0;\n    logEvent(`▶ Quarter ${this.state.quarter} simulation running...`,\"warn\");\n  }\n  endQuarterEarly(){\n    if(this.phase===PHASES.SIMULATION){\n      this.simProgress = 1;\n    }\n  }\n  togglePause(){\n    this.paused = !this.paused;\n    document.getElementById(\"pauseBtn\").textContent = this.paused?\"▶ Resume\":\"⏸ Pause\";\n    logEvent(this.paused?\"⏸ Paused\":\"▶ Resumed\",\"warn\");\n  }\n  completeSimulation(){\n    this.events.runQuarterEvents();\n    this.simulation.applyQuarter();\n    this.events.maybeRandomEvent();\n    this.state.advanceQuarter();\n    this.phase = PHASES.REVIEW;\n    this.evaluateOutcome();\n  }\n  evaluateOutcome(){\n    const s = this.state.metrics;\n    const elapsed = Math.floor((Date.now()-this.startTime)/1000);\n    this.audio.triumph(s.economy + s.workers + s.environment + s.politics);\n    if(s.approval < 20){\n      this.gameOver(\"Your approval collapsed. You have been fired.\");\n      return;\n    }\n    if(s.economy<10 && s.workers<10 && s.environment<10){\n      this.gameOver(\"Total systemic collapse. Mandatory policy reversal.\");\n      return;\n    }\n    if(s.debt > 50000){\n      logEvent(\"💸 National debt critical! Political crisis looming.\",\"bad\");\n    }\n    // win check\n    const balanced = this.state.history.length >= 8 && this.state.history.slice(-8).every(h=>h.economy>40 && h.workers>40 && h.environment>40 && h.politics>40);\n    const reformChamp = s.environment >= 90 && s.workers >= 80;\n    const bizFriend = s.economy >= 90 && s.workers >= 40 && s.environment >= 40;\n    const speedRun = elapsed < 180 && this.state.quarter <= 3 && Math.min(s.economy,s.workers,s.environment,s.politics) >= 50;\n    if(balanced || reformChamp || bizFriend || speedRun){\n      let title = balanced?\"Balanced Term\":reformChamp?\"Reform Champion\":bizFriend?\"Business Friend\":\"Speed Runner\";\n      const score = Math.floor((s.economy+s.workers+s.environment+s.politics) * (balanced?2:1) - elapsed + (speedRun?500:0));\n      if(score > this.highScore){\n        this.highScore = score;\n        this.save.saveHighScore(score);\n        this.state.highScore = score;\n      }\n      showModal({\n        title:`🏆 Victory: ${title}`,\n        body:`Final Score: <strong>${score}</strong><br/>High Score: <strong>${this.highScore}</strong><br/>Time: ${elapsed}s<br/><br/>You regulated wisely!`,\n        button:\"Play Again\",\n        onClose:()=>this.start()\n      });\n      logEvent(`🏆 VICTORY - ${title}! Score: ${score}`,\"good\");\n      return;\n    }\n    showModal({\n      title:`Q${this.state.quarter} Review`,\n      body:`Economy ${Math.round(s.economy)} | Workers ${Math.round(s.workers)} | Environment ${Math.round(s.environment)} | Politics ${Math.round(s.politics)}<br/>Approval: ${Math.round(s.approval)}%<br/>Budget: $${Math.round(s.budget)}M<br/>Debt: $${Math.round(s.debt)}M<br/><br/>Adjust your policies and run the next quarter.`,\n      button:\"Continue\",\n      onClose:()=>{ this.phase = PHASES.DRAFTING; }\n    });\n  }\n  gameOver(reason){\n    this.audio.alarm();\n    showModal({\n      title:\"💼 GAME OVER\",\n      body:`${reason}<br/><br/>High Score: <strong>${this.highScore}</strong>`,\n      button:\"New Term\",\n      onClose:()=>this.start()\n    });\n    logEvent(\"💼 GAME OVER: \"+reason,\"bad\");\n  }\n  loop(t){\n    if(!this.paused && this.phase===PHASES.SIMULATION){\n      this.simProgress = Math.min(1, (Date.now()-this.quarterStart)/this.simDuration);\n      this.simulation.tick(this.simProgress);\n      if(this.simProgress >= 1) this.completeSimulation();\n    }\n    // speedrun timer\n    if(!this.paused){\n      const e = Math.floor((Date.now()-this.startTime)/1000);\n      const m = String(Math.floor(e/60)).padStart(2,\"0\");\n      const sec = String(e%60).padStart(2,\"0\");\n      document.getElementById(\"speedrunTimer\").textContent = `${m}:${sec}`;\n    }\n    this.draw();\n    requestAnimationFrame(ts=>this.loop(ts));\n  }\n  draw(){\n    const ctx = this.ctx;\n    const W=this.W, H=this.H;\n    ctx.clearRect(0,0,W,H);\n    this.drawBackground(ctx,W,H);\n    this.drawIndustry(ctx,W,H);\n    if(this.phase===PHASES.SIMULATION){\n      ctx.fillStyle=\"rgba(244,162,97,.85)\";\n      ctx.fillRect(20, H-90, 200, 8);\n      ctx.fillStyle=\"#e63946\";\n      ctx.fillRect(20, H-90, 200*this.simProgress, 8);\n      ctx.fillStyle=\"#e8f1f5\";\n      ctx.font=\"11px monospace\";\n      ctx.fillText(`Simulating... ${Math.round(this.simProgress*100)}%`, 22, H-75);\n    }\n  }\n  drawBackground(ctx,W,H){\n    const grd = ctx.createLinearGradient(0,0,0,H);\n    grd.addColorStop(0,\"#0a1219\");\n    grd.addColorStop(0.5,\"#1a2634\");\n    grd.addColorStop(1,\"#2d4a3e\");\n    ctx.fillStyle=grd;ctx.fillRect(0,0,W,H);\n    // sun/moon\n    ctx.fillStyle=\"rgba(244,162,97,.25)\";\n    ctx.beginPath();ctx.arc(W*0.85, H*0.25, 50, 0, Math.PI*2);ctx.fill();\n    // skyline\n    ctx.fillStyle=\"rgba(0,0,0,.4)\";\n    for(let i=0;i<10;i++){\n      const x = (W/10)*i;\n      const h = 30 + Math.sin(i*1.3)*20;\n      ctx.fillRect(x, H*0.55-h, W/10-4, h);\n    }\n  }\n  drawIndustry(ctx,W,H){\n    const groundY = H*0.65;\n    ctx.fillStyle=\"#2d4a3e\";\n    ctx.fillRect(0, groundY, W, H-groundY);\n    ctx.fillStyle=\"rgba(0,0,0,.3)\";\n    ctx.fillRect(0, groundY, W, 4);\n    // factories\n    const s = this.state;\n    const compliances = this.simulation.sectorCompliances;\n    const colors = [\"#2a9d8f\",\"#f4a261\",\"#e63946\",\"#8aa1b1\"];\n    for(let i=0;i<4;i++){\n      const x = W*0.15 + i*(W*0.2);\n      const y = groundY - 60;\n      const c = compliances[i] ?? 0.6;\n      const fillColor = c>0.7?colors[0]:c>0.4?colors[1]:colors[2];\n      ctx.fillStyle=fillColor;\n      ctx.fillRect(x,y,90,60);\n      ctx.fillStyle=\"#1a2634\";\n      ctx.fillRect(x+10,y+15,15,15);\n      ctx.fillRect(x+35,y+15,15,15);\n      ctx.fillRect(x+60,y+15,15,15);\n      // chimney\n      ctx.fillStyle=\"#1a2634\";\n      ctx.fillRect(x+70,y-30,12,30);\n      // smoke (pollution particles)\n      if(this.phase===PHASES.SIMULATION){\n        const smokeCount = Math.floor((1-c)*6 + 2);\n        for(let p=0;p<smokeCount;p++){\n          const sx = x+76 + Math.sin(Date.now()/300 + p)*4;\n          const sy = y-30 - ((Date.now()/4 + p*30)%100);\n          ctx.fillStyle=`rgba(138,161,177,${0.4-c*0.3})`;\n          ctx.beginPath();ctx.arc(sx,sy,6+p*0.3,0,Math.PI*2);ctx.fill();\n        }\n      }\n      // workers (stick figures)\n      const workerCount = Math.floor(c*4)+1;\n      for(let w=0;w<workerCount;w++){\n        const wx = x+5 + w*18;\n        const wy = groundY - 14;\n        ctx.strokeStyle=\"#f4a261\";\n        ctx.lineWidth=1.5;\n        ctx.beginPath();\n        ctx.arc(wx,wy,3,0,Math.PI*2);\n        ctx.moveTo(wx,wy+3);ctx.lineTo(wx,wy+10);\n        ctx.moveTo(wx-4,wy+6);ctx.lineTo(wx+4,wy+6);\n        ctx.moveTo(wx,wy+10);ctx.lineTo(wx-3,wy+16);\n        ctx.moveTo(wx,wy+10);ctx.lineTo(wx+3,wy+16);\n        ctx.stroke();\n      }\n      // label\n      ctx.fillStyle=\"#e8f1f5\";\n      ctx.font=\"10px monospace\";\n      ctx.textAlign=\"center\";\n      ctx.fillText(this.simulation.sectorNames[i], x+45, groundY+20);\n      ctx.fillText(`${Math.round(c*100)}%`, x+45, groundY+34);\n    }\n    // river\n    ctx.fillStyle=\"rgba(42,157,143,.5)\";\n    ctx.fillRect(0, H-40, W, 12);\n    ctx.fillStyle=\"rgba(244,162,97,.3)\";\n    for(let i=0;i<5;i++){\n      const rx = (Date.now()/20 + i*200) % (W+100) - 50;\n      ctx.fillRect(rx, H-38, 20, 2);\n    }\n  }\n}\n\nwindow.addEventListener(\"DOMContentLoaded\", ()=>{\n  window.game = new Game();\n});\n", "js/core/state.js": "// Central game state: metrics, policies, persistence hooks\nexport class State{\n  constructor(){\n    this.quarter = 1;\n    this.metrics = {\n      economy: 60,\n      workers: 60,\n      environment: 60,\n      politics: 60,\n      approval: 70,\n      budget: 10000, // millions\n      debt: 0\n    };\n    this.policies = {\n      emissions: { active:false, threshold:500, penalty:500 },\n      worker: { active:false, maxHours:40, breakMin:30 },\n      tax: { active:false, rate:15 },\n      antitrust: { active:false, threshold:50 },\n      inspection: { active:false, visits:3 }\n    };\n    this.history = [];\n    this.highScore = 0;\n  }\n  reset(){\n    this.quarter = 1;\n    this.metrics = {\n      economy: 60, workers: 60, environment: 60, politics: 60,\n      approval: 70, budget: 10000, debt: 0\n    };\n    Object.keys(this.policies).forEach(k=>{\n      const p = this.policies[k];\n      p.active = false;\n    });\n    this.history = [];\n  }\n  advanceQuarter(){\n    this.history.push({...this.metrics});\n    this.quarter++;\n    if(this.history.length > 16) this.history.shift();\n  }\n  updatePolicy(key, partial){\n    if(this.policies[key]) Object.assign(this.policies[key], partial);\n  }\n}\n", "js/core/simulation.js": "// Industry AI behaviors + economic model + adaptation matrix\nimport { logEvent } from \"../ui/modals.js\";\n\nexport class Simulation{\n  constructor(state){\n    this.state = state;\n    this.sectorNames = [\"Energy\",\"Manufacturing\",\"Tech\",\"Finance\"];\n    this.sectorCompliances = [0.6, 0.6, 0.6, 0.6];\n    this.sectorProfits = [100, 120, 80, 90];\n    this.lobbyingStrength = [0.3, 0.4, 0.2, 0.5];\n    this.behaviors = [\"comply\",\"lobby\",\"loophole\",\"defy\",\"innovate\"];\n    this.cycleSector(); // pick a starting sector to highlight\n    this.eventCooldowns = {};\n  }\n  cycleSector(){\n    if(!this._sectorIdx) this._sectorIdx = 0;\n    else this._sectorIdx = (this._sectorIdx+1) % 4;\n  }\n  tick(progress){\n    // animate adaptation over simulation window\n    for(let i=0;i<4;i++){\n      const target = this.computeCompliance(i);\n      this.sectorCompliances[i] += (target - this.sectorCompliances[i]) * 0.04;\n    }\n  }\n  computeCompliance(i){\n    const p = this.state.policies;\n    const activeCount = Object.values(p).filter(x=>x.active).length;\n    if(activeCount === 0) return 0.5;\n    let pressure = 0;\n    let costBurden = 0;\n    // emissions impact\n    if(p.emissions.active){\n      const str = (1000-p.emissions.threshold)/1000;\n      pressure += str * 0.3 * this.lobbyingStrength[i];\n      costBurden += str * (i===0?1.5:0.8);\n    }\n    // worker safety\n    if(p.worker.active){\n      const hrPressure = (60-p.worker.maxHours)/60;\n      pressure += hrPressure * 0.25 * (i===1?1.3:1);\n      costBurden += hrPressure * (i===1?1.4:0.7);\n    }\n    // tax\n    if(p.tax.active){\n      pressure += (p.tax.rate/100) * 0.2 * this.lobbyingStrength[i];\n      costBurden += (p.tax.rate/100) * (i===3?1.5:0.9);\n    }\n    // antitrust\n    if(p.antitrust.active){\n      pressure += (p.antitrust.threshold/100) * 0.15 * (i===3?1.4:0.9);\n    }\n    // inspection\n    if(p.inspection.active){\n      pressure += (p.inspection.visits/10) * 0.3 * (1-this.lobbyingStrength[i]);\n    }\n    // adaptation behaviors per sector\n    const r = Math.random();\n    let compliance = 0.4 + pressure * 0.6;\\    if(r < 0.3) compliance += 0.15; // innovate
    else if(r < 0.5) compliance -= 0.1; // loophole
    else if(r < 0.7) compliance -= 0.2; // defy
    return Math.max(0, Math.min(1, compliance));
  }
  applyQuarter(){
    const s = this.state;
    const p = s.policies;
    // revenue from taxes and fines
    let revenue = 0;
    if(p.tax.active){
      const totalProfits = this.sectorProfits.reduce((a,b)=>a+b,0);
      revenue += totalProfits * (p.tax.rate/100) * 0.5;
    }
    if(p.emissions.active){
      this.sectorCompliances.forEach((c,i)=>{
        if(c < 0.5) revenue += p.emissions.penalty * (1-c);
      });
    }
    // inspection fines
    if(p.inspection.active){
      this.sectorCompliances.forEach((c,i)=>{
        if(c < 0.4) revenue += 200 * p.inspection.visits * (1-c);
      });
    }
    // update metrics
    const avgCompliance = this.sectorCompliances.reduce((a,b)=>a+b,0)/4;
    s.metrics.environment += (avgCompliance * 20) - 10;
    s.metrics.workers += (p.worker.active ? 5 : -3) + (avgCompliance * 10);
    s.metrics.economy += (1-avgCompliance) * 5 + (p.tax.active ? -2 : 2);
    s.metrics.politics += (p.antitrust.active ? 3 : -2) + (Math.random()-0.5)*4;
    // approval derived
    s.metrics.approval = Math.max(10, Math.min(95,
      (s.metrics.economy + s.metrics.workers + s.metrics.environment + s.metrics.politics)/4 - 10
    ));
    // budget
    s.metrics.budget += revenue;
    s.metrics.debt = Math.max(0, s.metrics.debt - revenue*0.1);
    // clamp
    ["economy","workers","environment","politics"].forEach(k=>{
      s.metrics[k] = Math.max(0, Math.min(100, s.metrics[k]));
    });
  }
}
