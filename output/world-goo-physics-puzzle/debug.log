ript type=\"module\" src=\"/main.js\"></script>\n</body>\n</html>",
  "main.js": "import { Game } from './src/game.js';\nimport { SoundManager } from './src/audio/soundManager.js';\n\nconst canvas = document.getElementById('game-canvas');\nconst ctx = canvas.getContext('2d');\n\n// Initialize game\nconst game = new Game(canvas, ctx);\nconst soundManager = new SoundManager();\n\n// Resize handler\nfunction resizeCanvas() {\n    canvas.width = window.innerWidth;\n    canvas.height = window.innerHeight;\n    game.onResize();\n}\n\nwindow.addEventListener('resize', resizeCanvas);\nresizeCanvas();\n\n// Input handling\nconst inputHandler = new InputHandler(canvas, game);\n\n// Game loop\nlet lastTime = performance.now();\nfunction gameLoop(currentTime) {\n    const deltaTime = (currentTime - lastTime) / 1000; // seconds\n    lastTime = currentTime;\n    \n    game.update(deltaTime);\n    game.render();\n    \n    requestAnimationFrame(gameLoop);\n}\n\nrequestAnimationFrame(gameLoop);\n\n// UI Elements\nconst placeTool = document.getElementById('place-tool');\nconst connectTool = document.getElementById('connect-tool');\nconst deleteTool = document.getElementById('delete-tool');\nconst moveTool = document.getElementById('move-tool');\nconst undoTool = document.getElementById('undo-tool');\nconst redoTool = document.getElementById('redo-tool');\nconst resetBtn = document.getElementById('reset-btn');\nconst timerDisplay = document.getElementById('timer');\nconst highScoreDisplay = document.getElementById('high-score');\nconst levelNameDisplay = document.getElementById('level-name');\nconst stabilityFill = document.getElementById('stability-fill');\nconst goalIndicator = document.getElementById('goal-indicator');\nconst successModal = document.getElementById('success-modal');\nconst failureModal = document.getElementById('failure-modal');\nconst successMessage = document.getElementById('success-message');\nconst finalTimeDisplay = document.getElementById('final-time');\nconst nextLevelBtn = document.getElementById('next-level-btn');\nconst retryBtn = document.getElementById('retry-btn');\nconst retryFailureBtn = document.getElementById('retry-failure-btn');\n\nlet activeTool = 'place';\n\nfunction setActiveTool(tool) {\n    activeTool = tool;\n    [placeTool, connectTool, deleteTool, moveTool].forEach(btn => btn.classList.remove('active'));\n    document.getElementById(`${tool}-tool`).classList.add('active');\n    inputHandler.setTool(tool);\n}\n\nplaceTool.addEventListener('click', () => setActiveTool('place'));\nconnectTool.addEventListener('click', () => setActiveTool('connect'));\ndeleteTool.addEventListener('click', () => setActiveTool('delete'));\nmoveTool.addEventListener('click', () => setActiveTool('move'));\n\nundoTool.addEventListener('click', () => {\n    game.undo();\n    soundManager.play('click');\n});\n\nredoTool.addEventListener('click', () => {\n    game.redo();\n    soundManager.play('click');\n});\n\nresetBtn.addEventListener('click', () => {\n    game.resetLevel();\n    soundManager.play('click');\n});\n\nnextLevelBtn.addEventListener('click', () => {\n    game.nextLevel();\n    successModal.style.display = 'none';\n    soundManager.play('click');\n});\n\nretryBtn.addEventListener('click', () => {\n    game.resetLevel();\n    successModal.style.display = 'none';\n    soundManager.play('click');\n});\n\nretryFailureBtn.addEventListener('click', () => {\n    game.resetLevel();\n    failureModal.style.display = 'none';\n    soundManager.play('click');\n});\n\n// Update HUD\nfunction updateHUD() {\n    const stats = game.getStats();\n    document.getElementById('ball-count').textContent = stats.balls;\n    document.getElementById('connection-count').textContent = stats.connections;\n    timerDisplay.textContent = game.getFormattedTime();\n    highScoreDisplay.textContent = `High Score: ${game.getHighScoreFormatted()}`;\n    levelNameDisplay.textContent = game.getLevelName();\n    stabilityFill.style.width = `${stats.stability * 100}%`;\n    goalIndicator.textContent = `Goal: ${stats.distanceToGoal.toFixed(0)}px`;\n    \n    // Update stability color\n    if (stats.stability > 0.7) stabilityFill.style.background = 'linear-gradient(to right, #4CAF50, #8BC34A)';\n    else if (stats.stability > 0.3) stabilityFill.style.background = 'linear-gradient(to right, #FFC107, #FFEB3B)';\n    else stabilityFill.style.background = 'linear-gradient(to right, #F44336, #E53935)';\n}\n\n// Game event listeners\ngame.on('levelComplete', (time) => {\n    successMessage.textContent = `You built a successful bridge in ${time}!`;\n    finalTimeDisplay.textContent = time;\n    successModal.style.display = 'flex';\n    soundManager.play('success');\n    \n    // Trigger celebration particles\n    game.triggerCelebration();\n});\n\ngame.on('bridgeFailed', () => {\n    failureModal.style.display = 'flex';\n    soundManager.play('failure');\n    game.triggerShake();\n});\n\ngame.on('statsUpdate', updateHUD);\n\n// Initial update\nupdateHUD();\n\n// Sound initialization\nsoundManager.init();\n",
  "src/config.js": "export const CONFIG = {\n    PHYSICS: {\n        GRAVITY: 9.8,\n        AIR_RESISTANCE: 0.01,\n        GOO_BALL_MASS: 1.0,\n        GOO_BOUNCE: 0.3,\n        GOO_FRICTION: 0.1,\n        MAX_STRETCH_RATIO: 3.0,\n        SPRING_CONSTANT: 750,\n        DAMPING_COEFFICIENT: 25\n    },\n    RENDER: {\n        GOO_BALL_RADIUS: 10,\n        CONNECTION_WIDTH: 3,\n        GRADIENT_CENTER: '#90EE90',\n        GRADIENT_EDGE: '#006400',\n        OVERSTRETCH_COLOR: '#FF0000',\n        BROKEN_PARTICLE_COUNT: 20\n    },\n    GAME: {\n        LEVELS: [\n            {\n                name: 'Level 1: The Gap',\n                startPlatform: { x: 100, y: 400, width: 200, height: 20 },\n                endPlatform: { x: 500, y: 400, width: 200, height: 20 },\n                goalThreshold: 50\n            },\n            {\n                name: 'Level 2: Double Gap',\n                startPlatform: { x: 100, y: 400, width: 150, height: 20 },\n                midPlatform: { x: 350, y: 300, width: 150, height: 20 },\n                endPlatform: { x: 600, y: 400, width: 150, height: 20 },\n                goalThreshold: 50\n            }\n        ],\n        MAX_UNDO_STACK: 50\n    },\n    AUDIO: {\n        VOLUME: 0.5,\n        SOUNDS: {\n            place: { frequency: 440, duration: 0.1, type: 'sine' },\n            connect: { frequency: 220, duration: 0.2, type: 'sine' },\n            break: { frequency: 110, duration: 0.3, type: 'sine' },\n            success: [ { frequency: 523, duration: 0.1 }, { frequency: 659, duration: 0.1 }, { frequency: 784, duration: 0.2 } ],\n            failure: [ { frequency: 200, duration: 0.2 }, { frequency: 150, duration: 0.2 } ],\n            click: { frequency: 330, duration: 0.05, type: 'sine' }\n        }\n    }\n};",
  "src/core/gooBall.js": "import { CONFIG } from '../config.js';\nimport { Utils } from '../utils.js';\n\nexport class GooBall {\n    constructor(x, y, mass = CONFIG.PHYSICS.GOO_BALL_MASS) {\n        this.id = Utils.generateId();\n        this.originalPosition = { x, y };\n        this.position = { x, y };\n        this.previousPosition = { x, y };\n        this.velocity = { x: 0, y: 0 };\n        this.force = { x: 0, y: 0 };\n        this.mass = mass;\n        this.radius = CONFIG.RENDER.GOO_BALL_RADIUS;\n        this.isFixed = false;\n        this.isDragging = false;\n        this.connections = new Set();\n        this.stretchRatio = 1.0;\n        this.isBroken = false;\n        this.overstretched = false;\n    }\n\n    applyForce(force) {\n        this.force.x += force.x;\n        this.force.y += force.y;\n    }\n\n    update(deltaTime) {\n        if (this.isFixed || this.isDragging) return;\n        \n        // Verlet integration\n        const tempX = this.position.x;\n        const tempY = this.position.y;\n        \n        this.position.x += (this.position.x - this.previousPosition.x) * (1 - CONFIG.PHYSICS.AIR_RESISTANCE) + this.force.x / this.mass * deltaTime * deltaTime;\n        this.position.y += (this.position.y - this.previousPosition.y) * (1 - CONFIG.PHYSICS.AIR_RESISTANCE) + (this.force.y / this.mass + CONFIG.PHYSICS.GRAVITY) * deltaTime * deltaTime;\n        \n        this.previousPosition.x = tempX;\n        this.previousPosition.y = tempY;\n        \n        // Reset force\n        this.force = { x: 0, y: 0 };\n        \n        // Update stretch ratio based on connections\n        this.updateStretchRatio();\n    }\n\n    updateStretchRatio() {\n        let maxStretch = 0;\n        this.connections.forEach(conn => {\n            if (!conn.isBroken) {\n                const distance = Utils.distance(this.position, conn.otherBall(this).position);\n                const originalLength = conn.originalLength;\n                const stretch = distance / originalLength;\n                if (stretch > maxStretch) maxStretch = stretch;\n            }\n        });\n        this.stretchRatio = maxStretch;\n        this.overstretched = this.stretchRatio > CONFIG.PHYSICS.MAX_STRETCH_RATIO;\n    }\n\n    checkBreak() {\n        if (this.overstretched && !this.isBroken) {\n            this.isBroken = true;\n            this.connections.forEach(conn => {\n                if (!conn.isBroken) conn.break();\n            });\n            return true;\n        }\n        return false;\n    }\n\n    render(ctx) {\n        if (this.isBroken) return;\n        \n        // Draw glow effect for fixed balls\n        if (this.isFixed) {\n            ctx.save();\n            ctx.shadowColor = '#00FF00';\n            ctx.shadowBlur = 15;\n            ctx.beginPath();\n            ctx.arc(this.position.x, this.position.y, this.radius + 5, 0, Math.PI * 2);\n            ctx.fillStyle = 'rgba(0,255,0,0.2)';\n            ctx.fill();\n            ctx.restore();\n        }\n        \n        // Draw goo ball with gradient\n        const gradient = ctx.createRadialGradient(\n            this.position.x, this.position.y, 0,\n            this.position.x, this.position.y, this.radius\n        );\n        \n        let centerColor = CONFIG.RENDER.GRADIENT_CENTER;\n        let edgeColor = CONFIG.RENDER.GRADIENT_EDGE;\n        \n        if (this.overstretched) {\n            centerColor = CONFIG.RENDER.OVERSTRETCH_COLOR;\n            edgeColor = '#8B0000';\n        }\n        \n        gradient.addColorStop(0, centerColor);\n        gradient.addColorStop(1, edgeColor);\n        \n        ctx.beginPath();\n        ctx.arc(this.position.x, this.position.y, this.radius, 0, Math.PI * 2);\n        ctx.fillStyle = gradient;\n        ctx.fill();\n        \n        // Add subtle noise texture\n        ctx.save();\n        ctx.globalCompositeOperation = 'overlay';\n        ctx.fillStyle = 'rgba(0,0,0,0.05)';\n        ctx.beginPath();\n        ctx.arc(this.position.x, this.position.y, this.radius, 0, Math.PI * 2);\n        ctx.fill();\n        ctx.restore();\n        \n        // Draw connection points\n        ctx.beginPath();\n        ctx.arc(this.position.x, this.position.y, 2, 0, Math.PI * 2);\n        ctx.fillStyle = this.isFixed ? '#FFFF00' : '#FFFFFF';\n        ctx.fill();\n    }\n}\n",
  "src/core/connection.js": "import { CONFIG } from '../config.js';\nimport { Utils } from '../utils.js';\n\nexport class Connection {\n    constructor(ball1, ball2) {\n        this.id = Utils.generateId();\n        this.ball1 = ball1;\n        this.ball2 = ball2;\n        this.originalLength = Utils.distance(ball1.position, ball2.position);\n        this.isBroken = false;\n        this.stress = 0; // 0-1\n        \n        // Add to balls' connection sets\n        ball1.connections.add(this);\n        ball2.connections.add(this);\n    }\n\n    otherBall(ball) {\n        return ball === this.ball1 ? this.ball2 : this.ball1;\n    }\n\n    update(deltaTime) {\n        if (this.isBroken) return;\n        \n        const distance = Utils.distance(this.ball1.position, this.ball2.position);\n        this.stress = Math.min(1, (distance - this.originalLength) / (this.originalLength * (CONFIG.PHYSICS.MAX_STRETCH_RATIO - 1)));\n        \n        // Spring force (Hooke's law)\n        const forceMagnitude = CONFIG.PHYSICS.SPRING_CONSTANT * (distance - this.originalLength);\n        const dampingForce = CONFIG.PHYSICS.DAMPING_COEFFICIENT * Utils.dotProduct(\n            Utils.subtract(this.ball2.velocity, this.ball1.velocity),\n            Utils.normalize(Utils.subtract(this.ball2.position, this.ball1.position))\n        );\n        \n        const totalForce = forceMagnitude + dampingForce;\n        const direction = Utils.normalize(Utils.subtract(this.ball2.position, this.ball1.position));\n        \n        const force = {\n            x: direction.x * totalForce,\n            y: direction.y * totalForce\n        };\n        \n        if (!this.ball1.isFixed && !this.ball1.isDragging) this.ball1.applyForce(force);\n        if (!this.ball2.isFixed && !this.ball2.isDragging) this.ball2.applyForce({ x: -force.x, y: -force.y });\n    }\n\n    break() {\n        this.isBroken = true;\n        this.ball1.connections.delete(this);\n        this.ball2.connections.delete(this);\n        \n        // Create break particles\n        const midpoint = {\n            x: (this.ball1.position.x + this.ball2.position.x) / 2,\n            y: (this.ball1.position.y + this.ball2.position.y) / 2\n        };\n        this.ball1.game.createBreakParticles(midpoint, 5);\n    }\n\n    render(ctx) {\n        if (this.isBroken) return;\n        \n        // Color based on stress\n        let r, g, b;\n        if (this.stress < 0.3) {\n            r = Math.floor(50 + 205 * (this.stress / 0.3));\n            g = 205;\n            b = 50;\n        } else if (this.stress < 0.7) {\n            r = 255;\n            g = Math.floor(255 - 105 * ((this.stress - 0.3) / 0.4));\n            b = 50;\n        } else {\n            r = 255;\n            g = Math.floor(150 - 150 * ((this.stress - 0.7) / 0.3));\n            b = 50;\n        }\n        \n        ctx.save();\n        ctx.beginPath();\n        ctx.moveTo(this.ball1.position.x, this.ball1.position.y);\n        ctx.lineTo(this.ball2.position.x, this.ball2.position.y);\n        ctx.strokeStyle = `rgb(${r},${g},${b})`;\n        ctx.lineWidth = CONFIG.RENDER.CONNECTION_WIDTH *We are at the point where the JSON string for "src/core/connection.js" is cut off.
