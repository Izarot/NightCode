Raw: {"index.html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1.0\">\n<title>Ink Cleanse</title>\n<link href=\"https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700&display=swap\" rel=\"stylesheet\">\n<style>\n*{margin:0;padding:0;box-sizing:border-box}\nbody{background:#0a0a0f;display:flex;justify-content:center;align-items:center;min-height:100vh;overflow:hidden;font-family:'Orbitron',sans-serif}\ncanvas{display:block;image-rendering:crisp-edges}\n</style>\n</head>\n<body>\n<canvas id=\"gc\"></canvas>\n<script>\nconst C=document.getElementById('gc'),X=C.getContext('2d');\nconst W=1280,H=720;\nC.width=W;C.height=H;\n\n// Vibrant palette\nconst P={bg:'#0a0a0f',player:'#00f5d4',solvent:'#ff2d90',ink:'#212121',ui:'#e0e0e0',accent:'#7b2ff7',energy:'#00f5d4',warning:'#ff6b35',boss:'#ff2d90'};\n\nlet scale=1,offsetX=0,offsetY=0;\nfunction resize(){\n  const ar=W/H,ww=window.innerWidth,wh=window.innerHeight,war=ww/wh;\n  if(war>ar){scale=wh/H;offsetX=(ww-H*ar*scale)/2;offsetY=0;}else{scale=ww/W;offsetX=0;offsetY=(wh-W/ar*scale)/2;}\n  C.style.width=W*scale+'px';C.style.height=H*scale+'px';C.style.marginLeft=offsetX+'px';C.style.marginTop=offsetY+'px';\n}\nwindow.addEventListener('resize',resize);resize();\n\n// Favicon\nconst fc=document.createElement('canvas');fc.width=32;fc.height=32;\nconst fcx=fc.getContext('2d');fcx.fillStyle='#ff2d90';fcx.beginPath();fcx.arc(16,16,14,0,Math.PI*2);fcx.fill();\nfcx.fillStyle='#00f5d4';fcx.beginPath();fcx.arc(16,16,6,0,Math.PI*2);fcx.fill();\ndocument.querySelector('head').appendChild(Object.assign(document.createElement('link'),{rel:'icon',type:'image/png',href:fc.toDataURL()}));\n\n// Audio\nlet ac;\nfunction initAudio(){if(!ac)ac=new(window.AudioContext||window.webkitAudioContext)();}\nfunction snd(f,t,d,v){if(!ac)return;const o=ac.createOscillator(),g=ac.createGain();o.type=t;o.frequency.value=f;g.gain.value=v;g.gain.exponentialRampToValueAtTime(0.001,ac.currentTime+d);o.connect(g);g.connect(ac.destination);o.start();o.stop(ac.currentTime+d);}\n\n// State\nlet state='menu',score=0,hs=parseInt(localStorage.getItem('inkcleanse_hs')||'0'),wave=1,waveTimer=0,speedrunTime=0,speedrunStart=0,inkFloor=0,totalInk=0,cleanEnergy=100,difficulty=1;\nlet player={x:W/2,y:H/2,vx:0,vy:0,angle:0,ink:0,dashCD:0,dashTimer:0,invTimer:0,footfalls:0};\nlet enemies=[],projectiles=[],particles=[],puddles=[],powerups=[];\nlet poolE=[],poolP=[],poolPt=[],poolPu=[];\nlet mouse={x:W/2,y:0,down:false};\nlet keys={};\nlet shakeX=0,shakeY=0,shakeT=0;\nlet hudAlpha=1,dissolveTimer=0;\nlet lastTime=0,dt=0;\n\n// Input\nwindow.addEventListener('keydown',e=>{keys[e.key.toLowerCase()]=true;if(e.key==='Escape'){if(state==='playing')state='paused';else if(state==='paused')state='playing';}if(e.key===' '){e.preventDefault();dash();}});\nwindow.addEventListener('keyup',e=>keys[e.key.toLowerCase()]=false);\nC.addEventListener('mousemove',e=>{const r=C.getBoundingClientRect();mouse.x=(e.clientX-r.left-offsetX)/scale;mouse.y=(e.clientY-r.top-offsetY)/scale;});\nC.addEventListener('mousedown',e=>{initAudio();mouse.down=true;if(e.button===0)fire();if(e.button===2)cleanBurst();});\nC.addEventListener('mouseup',e=>mouse.down=false);\nC.addEventListener('contextmenu',e=>e.preventDefault());\n\nfunction fire(){\n  if(dissolveTimer>0)return;\n  const a=Math.atan2(mouse.y-player.y,mouse.x-player.x);\n  const sp=poolP.pop()||{};\n  sp.x=player.x+Math.cos(a)*20;sp.y=player.y+Math.sin(a)*20;\n  sp.vx=Math.cos(a)*500;sp.vy=Math.sin(a)*500;sp.life=1.2;sp.maxLife=1.2;sp.r=6;sp.active=true;\n  projectiles.push(sp);poolP.push(sp);\n  snd(800+'','square',0.1,0.1);\n}\n\nfunction cleanBurst(){\n  if(cleanEnergy<20||dissolveTimer>0)return;\n  cleanEnergy-=20;\n  for(let i=puddles.length-1;i>=0;i--){\n    const p=puddles[i];\n    if(Math.hypot(p.x-player.x,p.y-player.y)<200){dissolvePuddle(p);puddles.splice(i,1);inkFloor-=p.alpha*0.6;}\n  }\n  for(let i=0;i<30;i++){const a=Math.random()*Math.PI*2,s=Math.random()*200;const pt=poolPt.pop()||{};pt.x=player.x;pt.y=player.y;pt.vx=Math.cos(a)*s;pt.vy=Math.sin(a)*s;pt.life=0.8;pt.maxLife=0.8;pt.r=Math.random()*4+2;pt.color=P.solvent;pt.active=true;particles.push(pt);poolPt.push(pt);}\n  snd(200,'sine',0.3,0.15);\n}\n\nfunction dash(){\n  if(player.dashCD>0||dissolveTimer>0)return;\n  player.dashTimer=0.2;player.dashCD=0.4;player.invTimer=0.2;\n  const a=Math.atan2(mouse.y-player.y,mouse.x-player.x);\n  player.vx=Math.cos(a)*375;player.vy=Math.sin(a)*375;\n  for(let i=0;i<10;i++){const a2=Math.random()*Math.PI*2,s=Math.random()*150;const pt=poolPt.pop()||{};pt.x=player.x;pt.y=player.y;pt.vx=Math.cos(a2)*s;pt.vy=Math.sin(a2)*s;pt.life=0.4;pt.maxLife=0.4;pt.r=Math.random()*3+1;pt.color=P.player;pt.active=true;particles.push(pt);poolPt.push(pt);}\n  snd(400,'sine',0.15,0.1);\n}\n\nfunction spawnEnemy(type,x,y){\n  const e=poolE.pop()||{};\n  e.type=type;e.x=x!==undefined?x:Math.random()<0.5?(Math.random()<0.5?0:W):Math.random()*W;e.y=y!==undefined?y:Math.random()<0.5?(Math.random()<0.5?0:H):Math.random()*H;\n  e.hp=type==='drip'?1:type==='splash'?2:5;e.maxHp=e.hp;\n  e.vx=0;e.vy=0;e.life=type==='drip'?2:999;e.alpha=1;e.dissolving=false;e.dissolveAlpha=0;e.active=true;\n  if(type==='splash'){e.speed=40+wave*5;e.phase=Math.random()*Math.PI*2;}\n  if(type==='blob'){e.speed=80+wave*10;e.trail=[];}\n  enemies.push(e);poolE.push(e);\n  if(type!=='drip')totalInk+=10;\n}\n\nfunction dissolveEnemy(e){\n  e.dissolving=true;e.dissolveAlpha=0;\n  dissolveTimer=0.8;hudAlpha=0.3;\n  for(let i=0;i<12;i++){const a=Math.random()*Math.PI*2,s=Math.random()*150+50;const pt=poolPt.pop()||{};pt.x=e.x;pt.y=e.y;pt.vx=Math.cos(a)*s;pt.vy=Math.sin(a)*s;pt.life=0.6;pt.maxLife=0.6;pt.r=Math.random()*3+1;pt.color=e.type==='blob'?P.boss:P.solvent;pt.active=true;particles.push(pt);poolPt.push(pt);}\n  snd(600+e.hp*100,'sine',0.2,0.12);\n  score+=e.type==='drip'?10:e.type==='splash'?25:50;\n  inkFloor+=e.type==='blob'?0.3:0.1;\n  if(e.type==='blob'){for(let i=0;i<6;i++){const p=poolPu.pop()||{};p.x=e.x+(Math.random()-0.5)*60;p.y=e.y+(Math.random()-0.5)*60;p.type='energy';p.life=5;p.active=true;powerups.push(p);poolPu.push(p);}}\n}\n\nfunction dissolvePuddle(p){\n  for(let i=0;i<8;i++){const a=Math.random()*Math.PI*2,s=Math.random()*100;const pt=poolPt.pop()||{};pt.x=p.x;pt.y=p.y;pt.vx=Math.cos(a)*s;pt.vy=Math.sin(a)*s;pt.life=0.4;pt.maxLife=0.4;pt.r=Math.random()*3+1;pt.color=P.solvent;pt.active=true;particles.push(pt);poolPt.push(pt);}\n}\n\nfunction spawnWave(){\n  const n=3+Math.floor(wave*0.8);const types=['drip','drip','splash'];\n  if(wave>=3)types.push('blob');\n  for(let i=0;i<n;i++){const t=types[Math.floor(Math.random()*types.length)];spawnEnemy(t);}\n  if(wave%5===0){spawnEnemy('blob',W/2,H/2);for(let i=0;i<6;i++)spawnEnemy('splash');}\n}\n\nfunction updatePlayer(dt){\n  let ax=0,ay=0;\n  if(keys['w']||keys['arrowup'])ay=-1;if(keys['s']||keys['arrowdown'])ay=1;\n  if(keys['a']||keys['arrowleft'])ax=-1;if(keys['d']||keys['arrowright'])ax=1;\n  const len=Math.hypot(ax,ay);if(len>0){ax/=len;ay/=len;player.footfalls++;if(player.footfalls>=3){player.footfalls=0;inkFloor=Math.min(inkFloor+0.05,5);}}\n  const accel=30*dt*60;player.vx+=ax*accel;player.vy+=ay*accel;\n  const friction=Math.pow(1-0.12,dt*60);player.vx*=friction;player.vy*=friction;\n  const spd=Math.hypot(player.vx,player.vy);if(spd>250){player.vx=player.vx/spd*250;player.vy=player.vy/spd*250;}\n  player.x+=player.vx*dt;player.y+=player.vy*dt;\n  player.x=Math.max(20,Math.min(W-20,player.x));player.y=Math.max(20,Math.min(H-20,player.y));\n  player.angle=Math.atan2(mouse.y-player.y,mouse.x-player.x);\n  player.dashCD=Math.max(0,player.dashCD-dt);player.dashTimer=Math.max(0,player.dashTimer-dt);\n  player.invTimer=Math.max(0,player.invTimer-dt);\n  cleanEnergy=Math.min(100,cleanEnergy+dt*8);\n  if(player.footfalls>0)player.footfalls=Math.max(0,player.footfalls-dt*2);\n}\n\nfunction updateEnemies(dt){\n  for(let i=enemies.length-1;i>=0;i--){\n    const e=enemies[i];\n    if(e.dissolving){e.dissolveAlpha+=dt*1.25;if(e.dissolveAlpha>=1){enemies.splice(i,1);continue;}}\n    e.life-=dt;if(e.life<=0&&e.type==='drip'){enemies.splice(i,1);continue;}\n    if(e.type==='splash'){\n      const dx=player.x-e.x,dy=player.y-e.y;const d=Math.hypot(dx,dy);if(d>1){e.vx+=(dx/d)*e.speed*dt;e.vy+=(dy/d)*e.speed*dt;}\n      e.x+=e.vx*dt;e.y+=e.vy*dt;e.x=Math.max(15,Math.min(W-15,e.x));e.y=Math.max(15,Math.min(H-15,e.y));\n      if(e.hp<=0){dissolveEnemy(e);enemies.splice(i,1);for(let j=0;j<2;j++)spawnEnemy('drip',e.x+(Math.random()-0.5)*30,e.y+(Math.random()-0.5)*30);}\n    }else if(e.type==='blob'){\n      const dx=player.x-e.x,dy=player.y-e.y;const d=Math.hypot(dx,dy);if(d>1){e.vx+=(dx/d)*e.speed*dt;e.vy+=(dy/d)*e.speed*dt;}\n      e.x+=e.vx*dt;e.y+=e.vy*dt;e.trail.push({x:e.x,y:e.y,a:1});if(e.trail.length>10)e.trail.shift();\n      e.trail.forEach(t=>t.a-=dt*2);\n      if(e.hp<=0){dissolveEnemy(e);enemies.splice(i,1);for(let j=0;j<3;j++){const p=poolPu.pop()||{};p.x=e.x;p.y=e.y;p.type='energy';p.life=5;p.active=true;powerups.push(p);poolPu.push(p);}for(let j=0;j<4;j++)spawnEnemy('splash');}\n    }else{\n      e.alpha-=dt*0.5;if(e.alpha<=0)enemies.splice(i,1);\n    }\n  }\n}\n\nfunction updateProjectiles(dt){\n  for(let i=projectiles.length-1;i>=0;i--){\n    const p=projectiles[i];p.x+=p.vx*dt;p.y+=p.vy*dt;p.life-=dt;\n    if(p.life<=0){projectiles.splice(i,1);continue;}\n    let hit=false;\n    for(let j=enemies.length-1;j>=0;j--){\n      const e=enemies[j];if(e.dissolving)continue;\n      if(Math.hypot(p.x-e.x,p.y-e.y)<18){e.hp--;if(e.hp<=0&&!e.dissolving)dissolveEnemy(e);else if(!e.dissolving){e.dissolving=true;e.dissolveAlpha=0;snd(400,'square',0.1,0.08);}projectiles.splice(i,1);hit=true;break;}\n    }\n    if(hit)continue;\n    for(let j=puddles.length-1;j>=0;j--){\n      if(Math.hypot(p.x-puddles[j].x,p.y-puddles[j].y)<puddles[j].r+6){dissolvePuddle(puddles[j]);puddles.splice(j,1);projectiles.splice(i,1);hit=true;break;}\n    }\n    if(hit)continue;\n    if(p.x<0||p.x>W||p.y<0||p.y>H){const pt=poolPt.pop()||{};pt.x=p.x;pt.y=p.y;pt.vx=0;pt.vy=0;pt.life=0.3;pt.maxLife=0.3;pt.r=4;pt.color=P.ink;pt.active=true;particles.push(pt);poolPt.push(pt);projectiles.splice(i,1);}\n  }\n}\n\nfunction updateParticles(dt){\n  for(let i=particles.length-1;i>=0;i--){particles[i].life-=dt;particles[i].x+=particles[i].vx*dt;particles[i].y+=particles[i].vy*dt;particles[i].vx*=0.95;particles[i].vy*=0.95;if(particles[i].life<=0)particles.splice(i,1);}\n}\n\nfunction updatePuddles(dt){\n  for(let i=puddles.length-1;i>=0;i--){puddles[i].alpha-=dt*0.05;if(puddles[i].alpha<=0)puddles.splice(i,1);}\n}\n\nfunction updatePowerups(dt){\n  for(let i=powerups.length-1;i>=0;i--){powerups[i].life-=dt;if(powerups[i].life<=0){powerups.splice(i,1);continue;}if(Math.hypot(powerups[i].x-player.x,powerups[i].y-player.y)<25){cleanEnergy=Math.min(100,cleanEnergy+30);powerups.splice(i,1);}}\n}\n\nfunction update(dt){\n  if(state!=='playing')return;\n  speedrunTime+=dt;\n  waveTimer+=dt;if(waveTimer>=45){waveTimer=0;wave++;spawnWave();}\n  difficulty=1+wave*0.15;\n  updatePlayer(dt);\n  updateEnemies(dt);\n  updateProjectiles(dt);\n  updateParticles(dt);\n  updatePuddles(dt);\n  updatePowerups(dt);\n  player.dashCD=Math.max(0,player.dashCD-dt);\n  if(player.dashTimer>0){player.vx*=0.3;player.vy*=0.3;}\n  // Enemy collision with player\n  if(player.invTimer<=0){\n    for(const e of enemies){if(e.dissolving)continue;if(Math.hypot(e.x-player.x,e.y-player.y)<20){player.ink+=15;shakeT=0.3;if(player.ink>=100){gameOver();}break;}}\n  }\n  // Ink puddle collision\n  for(const p of puddles){if(Math.hypot(p.x-player.x,p.y-player.y)<p.r+12){player.ink+=dt*5;}}\n  player.ink=Math.max(0,player.ink-dt*2);\n  if(shakeT>0){shakeT-=dt;shakeX=(Math.random()-0.5)*4;shakeY=(Math.random()-0.5)*4;}else{shakeX=0;shakeY=0;}\n  if(dissolveTimer>0){dissolveTimer-=dt;if(dissolveTimer<=0)hudAlpha=1;}\n  // Ambient puddle spawning\n  if(Math.random()<dt*0.3*wave){const p=poolPu.pop()||{};p.x=Math.random()*W;p.y=Math.random()*H;p.type='ink';p.life=4;p.active=true;powerups.push(p);poolPu.push(p);}\n}\n\nfunction gameOver(){\n  state='gameover';if(score>hs){hs=score;localStorage.setItem('inkcleanse_hs',hs.toString());}speedrunTime=0;\n}\n\nfunction render(){\n  X.save();\n  X.translate(shakeX,shakeY);\n  // Background\n  X.fillStyle=P.bg;X.fillRect(0,0,W,H);\n  // Ambient noise\n  const t=performance.now()/1000;\n  X.globalAlpha=0.03;for(let i=0;i<200;i++){const x=(Math.sin(i*7.3+t*0.001)*0.5+0.5)*W;const y=(Math.cos(i*13.1+t*0.001)*0.5+0.5)*H;X.fillStyle=i%2?'#00f5d4':'#ff2d90';X.fillRect(x,y,2,2);}X.globalAlpha=1;\n  // Puddles\n  for(const p of puddles){X.fillStyle=P.ink;X.globalAlpha=p.alpha*0.6;X.beginPath();X.arc(p.x,p.y,p.r,0,Math.PI*2);X.fill();}X.globalAlpha=1;\n  // Powerups\n  for(const pw of powerups){X.fillStyle=pw.type==='energy'?'#00f5d4':'#ff6b35';X.globalAlpha=0.5+Math.sin(t*4)*0.3;X.beginPath();X.arc(pw.x,pw.y,8,0,Math.PI*2);X.fill();}X.globalAlpha=1;\n  // Enemies\n  for(const e of enemies){\n    if(e.dissolving){X.globalAlpha=1-e.dissolveAlpha;const g=X.createRadialGradient(e.x,e.y,0,e.x,e.y,20);g.addColorStop(0,'#212121');g.addColorStop(1,'#0a0a0f');X.fillStyle=g;X.beginPath();X.arc(e.x,e.y,20*(1-e.dissolveAlpha),0,Math.PI*2);X.fill();continue;}\n    let col=e.type==='drip'?'#ff6b35':e.type==='splash'?'#7b2ff7':P.boss;\n    X.fillStyle=col;X.globalAlpha=e.alpha||1;\n    if(e.type==='drip'){X.beginPath();X.arc(e.x,e.y,8,0,Math.PI*2);X.fill();}\n    else if(e.type==='splash'){X.beginPath();X.arc(e.x,e.y,14,0,Math.PI*2);X.fill();X.strokeStyle=col;X.lineWidth=2;X.stroke();}\n    else{X.beginPath();X.arc(e.x,e.y,22,0,Math.PI*2);X.fill();X.strokeStyle='#fff';X.lineWidth=1;X.stroke();}\n    X.globalAlpha=1;\n  }\n  // Projectiles\n  for(const p of projectiles){X.fillStyle=P.solvent;X.globalAlpha=p.life/p.maxLife;X.beginPath();X.arc(p.x,p.y,p.r,0,Math.PI*2);X.fill();X.globalAlpha=1;}\n  // Player\n  if(player.invTimer<=0||Math.floor(player.invTimer*10)%2===0){\n    X.fillStyle=P.player;X.globalAlpha=player.dashTimer>0?0.3:1;\n    X.beginPath();X.arc(player.x,player.y,14,0,Math.PI*2);X.fill();\n    X.fillStyle='#fff';X.beginPath();X.arc(player.x+Math.cos(player.angle)*8,player.y+Math.sin(player.angle)*8,4,0,Math.PI*2);X.fill();\n    X.globalAlpha=1;\n  }\n  // Particles\n  for(const pt of particles){X.fillStyle=pt.color;X.globalAlpha=pt.life/pt.maxLife;X.beginPath();X.arc(pt.x,pt.y,pt.r,0,Math.PI*2);X.fill();}X.globalAlpha=1;\n  X.restore();\n  // HUD\n  renderHUD();\n}\n\nfunction renderHUD(){\n  X.save();\n  X.globalAlpha=hudAlpha;\n  // Score\n  X.fillStyle=P.ui;X.font='700 32px Orbitron,sans-serif';X.textAlign='center';X.textBaseline='top';\n  X.shadowColor='rgba(0,0,0,0.5)';X.shadowBlur=4;X.shadowOffsetX=2;X.shadowOffsetY=2;\n  X.fillText(score.toString(),W/2,16);\n  X.shadowColor='transparent';\n  // Wave\n  X.fillStyle=P.accent;X.font='400 14px Orbitron,sans-serif';X.textAlign='right';\n  X.fillText('Wave '+wave,W-20,20);\n  // Speedrun timer\n  X.fillStyle=P.warning;X.font='400 12px Orbitron,sans-serif';X.textAlign='right';\n  X.fillText('Time: '+speedrunTime.toFixed(1)+'s',W-20,38);\n  // Ink meter\n  X.fillStyle='rgba(17,17,17,0.8)';roundRect(X,20,16,200,12,4);X.fill();\n  const inkW=Math.max(0,200*(1-player.ink/100));\n  X.fillStyle=P.solvent;roundRect(X,20,16,inkW,12,4);X.fill();\n  // Energy bar\n  X.fillStyle='rgba(17,17,17,0.8)';roundRect(X,20,34,200,8,4);X.fill();\n  X.fillStyle=P.energy;roundRect(X,20,34,200*(cleanEnergy/100),8,4);X.fill();\n  // Energy icon\n  X.fillStyle=cleanEnergy<30?'#ff2d90':P.energy;X.beginPath();X.arc(16,38,6,0,Math.PI*2);X.fill();\n  if(cleanEnergy<30){X.globalAlpha=0.5+Math.sin(t*6)*0.5;X.beginPath();X.arc(16,38,10,0,Math.PI*2);X.strokeStyle=P.energy;X.lineWidth=2;X.stroke();X.globalAlpha=1;}\n  // High score\n  X.fillStyle=P.ui;X.font='400 12px Orbitron,sans-serif';X.textAlign='left';X.fillText('HS: '+hs,20,54);X.restore();}
function loop(t){dt=(t-lastTime)/1000;lastTime=t;if(state==='playing'){update(dt);}render();requestAnimationFrame(loop);}
