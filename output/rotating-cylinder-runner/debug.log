            ctx.fill();
        }
        
        // Glow
        ctx.beginPath();
        ctx.arc(player.x, player.y, player.radius + 8, 0, Math.PI * 2);
        const glowGrad = ctx.createRadialGradient(player.x, player.y, player.radius, player.x, player.y, player.radius + 15);
        glowGrad.addColorStop(0, 'rgba(0,255,255,0.4)');
        glowGrad.addColorStop(1, 'rgba(0,255,255,0)');
        ctx.fillStyle = glowGrad;
        ctx.fill();
        
        // Body
        ctx.beginPath();
        ctx.arc(player.x, player.y, player.radius, 0, Math.PI * 2);
        const bodyGrad = ctx.createRadialGradient(player.x - 5, player.y - 5, 0, player.x, player.y, player.radius);
        bodyGrad.addColorStop(0, '#88FFFF');
        bodyGrad.addColorStop(1, '#00CCCC');
        ctx.fillStyle = bodyGrad;
        ctx.fill();
        
        // Face
        ctx.fillStyle = '#003333';
        ctx.beginPath();
        ctx.arc(player.x - 5, player.y - 3, 3, 0, Math.PI * 2);
        ctx.arc(player.x + 5, player.y - 3, 3, 0, Math.PI * 2);
        ctx.fill();
        
        // Mouth
        ctx.beginPath();
        ctx.arc(player.x, player.y + 3, 6, 0, Math.PI);
        ctx.strokeStyle = '#003333';
        ctx.lineWidth = 2;
        ctx.stroke();
    }
    
    function drawObstacle(obs) {
        ctx.save();
        ctx.translate(obs.x, obs.y);
        
        if (obs.type === 'barrier') {
            // Base
            ctx.fillStyle = obs.color;
            ctx.fillRect(-obs.w/2, -obs.h/2, obs.w, obs.h);
            
            // Highlight
            ctx.fillStyle = 'rgba(255,255,255,0.3)';
            ctx.fillRect(-obs.w/2, -obs.h/2, obs.w, 8);
            
            // Stripes
            ctx.fillStyle = '#AA0000';
            for (let i = 0; i < 3; i++) {
                ctx.fillRect(-obs.w/2 + 5 + i * 18, -obs.h/2 + 10, 8, obs.h - 15);
            }
            
            // Glow
            ctx.shadowColor = obs.color;
            ctx.shadowBlur = 15;
            ctx.strokeStyle = '#FF6666';
            ctx.lineWidth = 2;
            ctx.strokeRect(-obs.w/2, -obs.h/2, obs.w, obs.h);
        }
        else if (obs.type === 'spike') {
            ctx.fillStyle = obs.color;
            ctx.beginPath();
            ctx.moveTo(0, -obs.h/2);
            ctx.lineTo(obs.w/2, obs.h/2);
            ctx.lineTo(-obs.w/2, obs.h/2);
            ctx.closePath();
            ctx.fill();
            
            ctx.shadowColor = obs.color;
            ctx.shadowBlur = 10;
            ctx.strokeStyle = '#FFCC88';
            ctx.lineWidth = 2;
            ctx.stroke();
        }
        else if (obs.type === 'moving') {
            const rot = Date.now() * 0.005;
            ctx.rotate(rot);
            
            ctx.fillStyle = obs.color;
            ctx.fillRect(-obs.w/2, -obs.h/2, obs.w, obs.h);
            
            ctx.fillStyle = '#DD66FF';
            ctx.fillRect(-obs.w/2 + 5, -obs.h/2 + 5, obs.w - 10, obs.h - 10);
            
            ctx.shadowColor = obs.color;
            ctx.shadowBlur = 20;
            ctx.strokeStyle = '#FF88FF';
            ctx.lineWidth = 2;
            ctx.strokeRect(-obs.w/2, -obs.h/2, obs.w, obs.h);
        }
        else if (obs.type === 'beam') {
            const pulse = Math.sin(Date.now() * 0.02) * 0.3 + 0.7;
            ctx.globalAlpha = pulse;
            
            ctx.fillStyle = obs.color;
            ctx.fillRect(-obs.w/2, -obs.h/2, obs.w, obs.h);
            
            ctx.shadowColor = obs.color;
            ctx.shadowBlur = 30;
            ctx.fillStyle = '#FFFF88';
            ctx.fillRect(-obs.w/2, -obs.h/2 + obs.h/2 - 5, obs.w, 10);
            
            ctx.globalAlpha = 1;
        }
        else if (obs.type === 'wall') {
            ctx.fillStyle = obs.color;
            ctx.fillRect(-obs.w/2, -obs.h/2, obs.w, obs.h);
            
            ctx.strokeStyle = '#888888';
            ctx.lineWidth = 3;
            ctx.strokeRect(-obs.w/2, -obs.h/2, obs.w, obs.h);
            
            // Brick pattern
            ctx.strokeStyle = '#555555';
            ctx.lineWidth = 1;
            for (let y = -obs.h/2 + 20; y < obs.h/2; y += 20) {
                ctx.beginPath();
                ctx.moveTo(-obs.w/2, y);
                ctx.lineTo(obs.w/2, y);
                ctx.stroke();
            }
        }
        
        ctx.restore();
    }
    
    function drawCoin(coin) {
        ctx.save();
        ctx.translate(coin.x, coin.y + Math.sin(coin.floatOffset) * 5);
        
        // Glow
        ctx.beginPath();
        ctx.arc(0, 0, coin.radius + 6, 0, Math.PI * 2);
        const glowGrad = ctx.createRadialGradient(0, 0, coin.radius, 0, 0, coin.radius + 10);
        glowGrad.addColorStop(0, 'rgba(255,215,0,0.5)');
        glowGrad.addColorStop(1, 'rgba(255,215,0,0)');
        ctx.fillStyle = glowGrad;
        ctx.fill();
        
        // Coin body
        ctx.rotate(coin.rotation);
        ctx.beginPath();
        ctx.arc(0, 0, coin.radius, 0, Math.PI * 2);
        const coinGrad = ctx.createRadialGradient(-3, -3, 0, 0, 0, coin.radius);
        coinGrad.addColorStop(0, '#FFEE88');
        coinGrad.addColorStop(0.5, COLORS.coin);
        coinGrad.addColorStop(1, '#CC9900');
        ctx.fillStyle = coinGrad;
        ctx.fill();
        
        // Inner detail
        ctx.beginPath();
        ctx.arc(0, 0, coin.radius * 0.6, 0, Math.PI * 2);
        ctx.strokeStyle = '#CC9900';
        ctx.lineWidth = 2;
        ctx.stroke();
        
        // $ symbol
        ctx.fillStyle = '#CC9900';
        ctx.font = 'bold 12px Arial';
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        ctx.fillText('$', 0, 1);
        
        ctx.restore();
    }
    
    function drawPowerup(pu) {
        ctx.save();
        ctx.translate(pu.x, pu.y);
        ctx.rotate(pu.rotation);
        
        const colors = {
            shield: { main: COLORS.powerShield, light: '#66AAFF' },
            magnet: { main: COLORS.powerMagnet, light: '#FF66CC' },
            double: { main: COLORS.power2x, light: '#FFFFAA' },
            slow: { main: COLORS.powerSlow, light: '#CC88FF' }
        };
        
        const color = colors[pu.type] || colors.shield;
        
        // Outer glow
        ctx.beginPath();
        ctx.arc(0, 0, pu.radius + 8, 0, Math.PI * 2);
        const glowGrad = ctx.createRadialGradient(0, 0, pu.radius, 0, 0, pu.radius + 12);
        glowGrad.addColorStop(0, color.main);
        glowGrad.addColorStop(1, 'rgba(0,0,0,0)');
        ctx.fillStyle = glowGrad;
        ctx.globalAlpha = 0.5;
        ctx.fill();
        ctx.globalAlpha = 1;
        
        // Main circle
        ctx.beginPath();
        ctx.arc(0, 0, pu.radius, 0, Math.PI * 2);
        const bodyGrad = ctx.createRadialGradient(-5, -5, 0, 0, 0, pu.radius);
        bodyGrad.addColorStop(0, color.light);
        bodyGrad.addColorStop(1, color.main);
        ctx.fillStyle = bodyGrad;
        ctx.fill();
        
        // Border
        ctx.strokeStyle = 'rgba(255,255,255,0.6)';
        ctx.lineWidth = 3;
        ctx.stroke();
        
        // Icon
        ctx.fillStyle = 'white';
        ctx.strokeStyle = 'white';
        ctx.lineWidth = 2;
        
        if (pu.type === 'shield') {
            ctx.beginPath();
            ctx.moveTo(0, -10);
            ctx.lineTo(10, -5);
            ctx.lineTo(10, 5);
            ctx.lineTo(0, 12);
            ctx.lineTo(-10, 5);
            ctx.lineTo(-10, -5);
            ctx.closePath();
            ctx.stroke();
        }
        else if (pu.type === 'magnet') {
            ctx.beginPath();
            ctx.arc(0, 0, 8, Math.PI, 0, false);
            ctx.stroke();
            ctx.fillRect(-10, -2, 5, 10);
            ctx.fillRect(5, -2, 5, 10);
        }
        else if (pu.type === 'double') {
            ctx.font = 'bold 14px Arial';
            ctx.textAlign = 'center';
            ctx.textBaseline = 'middle';
            ctx.fillText('2X', 0, 1);
        }
        else if (pu.type === 'slow') {
            ctx.beginPath();
            ctx.moveTo(0, -8);
            ctx.lineTo(6, 4);
            ctx.lineTo(-6, 4);
            ctx.closePath();
            ctx.fill();
        }
        
        ctx.restore();
    }
    
    function drawHUD() {
        // Score
        ctx.fillStyle = COLORS.text;
        ctx.font = 'bold 24px "Segoe UI", Arial';
        ctx.textAlign = 'left';
        ctx.fillText(`Score: ${Math.floor(score)}`, 15, 35);
        
        // High score
        ctx.font = '14px "Segoe UI", Arial';
        ctx.fillStyle = COLORS.textDim;
        ctx.fillText(`Best: ${highScore}`, 15, 55);
        
        // Coins
        ctx.fillStyle = COLORS.coin;
        ctx.font = 'bold 18px "Segoe UI", Arial';
        ctx.textAlign = 'right';
        ctx.fillText(`${coins}`, canvas.width - 45, 30);
        
        ctx.font = '28px Arial';
        ctx.fillText('$', canvas.width - 15, 32);
        
        // Combo
        if (combo > 1) {
            const pulse = Math.sin(Date.now() * 0.01) * 0.2 + 0.8;
            ctx.fillStyle = `rgba(255,100,100,${pulse})`;
            ctx.font = 'bold 20px "Segoe UI", Arial';
            ctx.textAlign = 'center';
            ctx.fillText(`${combo}x COMBO!`, canvas.width / 2, 35);
        }
        
        // Power-ups
        let puY = 70;
        Object.keys(powerups).forEach(k => {
            if (powerups[k].active) {
                const pct = powerups[k].timer / powerups[k].duration;
                const colors = {
                    shield: COLORS.powerShield,
                    magnet: COLORS.powerMagnet,
                    double: COLORS.power2x,
                    slow: COLORS.powerSlow
                };
                
                ctx.fillStyle = colors[k];
                ctx.fillRect(canvas.width - 120, puY, 100 * pct, 8);
                ctx.strokeStyle = colors[k];
                ctx.lineWidth = 1;
                ctx.strokeRect(canvas.width - 120, puY, 100, 8);
                
                ctx.font = '10px "Segoe UI", Arial';
                ctx.fillStyle = colors[k];
                ctx.textAlign = 'right';
                ctx.fillText(k.toUpperCase(), canvas.width - 125, puY + 8);
                
                puY += 15;
            }
        });
        
        // Pause hint
        ctx.fillStyle = COLORS.textDim;
        ctx.font = '12px "Segoe UI", Arial';
        ctx.textAlign = 'center';
        ctx.fillText('P to pause', canvas.width / 2, canvas.height - 15);
    }
    
    function drawMenu() {
        // Overlay
        ctx.fillStyle = 'rgba(13,27,42,0.85)';
        ctx.fillRect(0, 0, canvas.width, canvas.height);
        
        // Title
        ctx.fillStyle = COLORS.player;
        ctx.font = 'bold 48px "Segoe UI", Arial';
        ctx.textAlign = 'center';
        ctx.fillText('CYLINDER RUSH', canvas.width / 2, canvas.height * 0.2);
        
        // Subtitle
        ctx.fillStyle = COLORS.textDim;
        ctx.font = '18px "Segoe UI", Arial';
        ctx.fillText('Navigate the cylinder!', canvas.width / 2, canvas.height * 0.28);
        
        // High score
        if (highScore > 0) {
            ctx.fillStyle = COLORS.coin;
            ctx.font = '20px "Segoe UI", Arial';
            ctx.fillText(`High Score: ${highScore}`, canvas.width / 2, canvas.height * 0.35);
        }
        
        // Play button
        const btnY = canvas.height * 0.45;
        const btnW = 180;
        const btnH = 50;
        
        ctx.fillStyle = COLORS.player;
        ctx.beginPath();
        ctx.roundRect(canvas.width/2 - btnW/2, btnY, btnW, btnH, 10);
        ctx.fill();
        
        ctx.fillStyle = '#003333';
        ctx.font = 'bold 22px "Segoe UI", Arial';
        ctx.fillText('PLAY', canvas.width / 2, btnY + 33);
        
        // Instructions
        ctx.fillStyle = COLORS.textDim;
        ctx.font = '14px "Segoe UI", Arial';
        ctx.fillText('← → or A D to move', canvas.width / 2, canvas.height * 0.6);
        ctx.fillText('Space or ↑ or W to jump', canvas.width / 2, canvas.height * 0.65);
        ctx.fillText('Swipe on mobile', canvas.width / 2, canvas.height * 0.7);
    }
    
    function drawGameOver() {
        // Overlay
        ctx.fillStyle = 'rgba(13,27,42,0.9)';
        ctx.fillRect(0, 0, canvas.width, canvas.height);
        
        // Game Over text
        ctx.fillStyle = COLORS.obstacle;
        ctx.font = 'bold 42px "Segoe UI", Arial';
        ctx.textAlign = 'center';
        ctx.fillText('GAME OVER', canvas.width / 2, canvas.height * 0.2);
        
        // New high score
        if (newHighScore) {
            const pulse = Math.sin(Date.now() * 0.008) * 0.3 + 0.7;
            ctx.fillStyle = `rgba(255,215,0,${pulse})`;
            ctx.font = 'bold 24px "Segoe UI", Arial';
            ctx.fillText('NEW HIGH SCORE!', canvas.width / 2, canvas.height * 0.3);
        }
        
        // Score
        ctx.fillStyle = COLORS.text;
        ctx.font = '28px "Segoe UI", Arial';
        ctx.fillText(`Score: ${Math.floor(score)}`, canvas.width / 2, canvas.height * 0.4);
        
        ctx.fillStyle = COLORS.coin;
        ctx.font = '22px "Segoe UI", Arial';
        ctx.fillText(`Coins: ${coins}`, canvas.width / 2, canvas.height * 0.47);
        
        // Restart button
        const btn1Y = canvas.height * 0.55;
        const btnW = 180;
        const btnH = 45;
        
        ctx.fillStyle = COLORS.player;
        ctx.beginPath();
        ctx.roundRect(canvas.width/2 - btnW/2, btn1Y, btnW, btnH, 10);
        ctx.fill();
        
        ctx.fillStyle = '#003333';
        ctx.font = 'bold 18px "Segoe UI", Arial';
        ctx.fillText('PLAY AGAIN', canvas.width / 2, btn1Y + 29);
        
        // Menu button
        const btn2Y = canvas.height * 0.7;
        
        ctx.fillStyle = COLORS.textDim;
        ctx.beginPath();
        ctx.roundRect(canvas.width/2 - btnW/2, btn2Y, btnW, btnH, 10);
        ctx.fill();
        
        ctx.fillStyle = '#222';
        ctx.fillText('MENU', canvas.width / 2, btn2Y + 29);
    }
    
    function drawPause() {
        // Overlay
        ctx.fillStyle = 'rgba(13,27,42,0.7)';
        ctx.fillRect(0, 0, canvas.width, canvas.height);
        
        // Paused text
        ctx.fillStyle = COLORS.text;
        ctx.font = 'bold 36px "Segoe UI", Arial';
        ctx.textAlign = 'center';
        ctx.fillText('PAUSED', canvas.width / 2, canvas.height * 0.4);
        
        ctx.fillStyle = COLORS.textDim;
        ctx.font = '18px "Segoe UI", Arial';
        ctx.fillText('Press P or Escape to resume', canvas.width / 2, canvas.height * 0.5);
    }
    
    // === GAME LOOP ===
    let lastTime = 0;
    
    function gameLoop(timestamp) {
        const dt = Math.min((timestamp - lastTime) / 1000, 0.05);
        lastTime = timestamp;
        
        update(dt);
        render();
        
        requestAnimationFrame(gameLoop);
    }
    
    // === INIT ===
    updateLanes();
    initStars();
    Input.init();
    requestAnimationFrame(gameLoop);
})();
</script>
</body>
</html>"}