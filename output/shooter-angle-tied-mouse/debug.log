  "game.js": "// Game constants\nconst GAME_WIDTH = 1280;\nconst GAME_HEIGHT = 720;\nconst COLORS = {\n  bg: '#0a0a1a',\n  player: '#00ffff',\n  playerAccent: '#ff00ff',\n  bullet: '#ffff00',\n  enemy1: '#ff4444',\n  enemy2: '#44ff44',\n  enemy3: '#ffaa00',\n  particle: '#ff8800',\n  ui: '#ffffff',\n  uiAccent: '#00ff00'\n};\n\n// Audio context\nlet audioCtx = null;\nfunction initAudio() {\n  if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();\n  if (audioCtx.state === 'suspended') audioCtx.resume();\n}\nfunction playTone(freq, duration, type='square', volume=0.1) {\n  if (!audioCtx) return;\n  const osc = audioCtx.createOscillator();\n  const gain = audioCtx.createGain();\n  osc.type = type;\n  osc.frequency.value = freq;\n  gain.gain.value = volume;\n  osc.connect(gain).connect(audioCtx.destination);\n  osc.start();\n  gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + duration);\n  osc.stop(audioCtx.currentTime + duration);\n}\nfunction playShoot() { playTone(800, 0.05, 'square', 0.08); }\nfunction playHit() { playTone(200, 0.1, 'sawtooth', 0.1); }\nfunction playExplosion() { playTone(100, 0.3, 'sawtooth', 0.15); }\nfunction playPowerup() { playTone(600, 0.2, 'triangle', 0.1); }\n\n// Utility\nfunction lerp(a, b, t) { return a + (b - a) * t; }\nfunction lerpAngle(a, b, t) {\n  let diff = b - a;\n  while (diff > Math.PI) diff -= 2 * Math.PI;\n  while (diff < -Math.PI) diff += 2 * Math.PI;\n  return a + diff * t;\n}\nfunction dist(x1, y1, x2, y2) { return Math.hypot(x2 - x1, y2 - y1); }\nfunction clamp(v, min, max) { return Math.max(min, Math.min(max, v)); }\nfunction randomRange(min, max) { return Math.random() * (max - min) + min; }\n\n// Particle system\nclass Particle {\n  constructor(x, y, color, size, life, vx, vy) {\n    this.x = x; this.y = y; this.color = color; this.size = size;\n    this.life = life; this.maxLife = life; this.vx = vx; this.vy = vy;\n  }\n  update(dt) { this.x += this.vx * dt; this.y += this.vy * dt; this.life -= dt; }\n  draw(ctx) {\n    const alpha = this.life / this.maxLife;\n    ctx.globalAlpha = alpha;\n    ctx.fillStyle = this.color;\n    ctx.beginPath();\n    ctx.arc(this.x, this.y, this.size * alpha, 0, Math.PI * 2);\n    ctx.fill();\n    ctx.globalAlpha = 1;\n  }\n}\nconst particles = [];\nfunction spawnExplosion(x, y, color, count = 12) {\n  for (let i = 0; i < count; i++) {\n    const angle = randomRange(0, Math.PI * 2);\n    const speed = randomRange(50, 200);\n    particles.push(new Particle(x, y, color, randomRange(3, 6), randomRange(0.3, 0.6),\n      Math.cos(angle) * speed, Math.sin(angle) * speed));\n  }\n}\nfunction updateParticles(dt) {\n  for (let i = particles.length - 1; i >= 0; i--) {\n    particles[i].update(dt);\n    if (particles[i].life <= 0) particles.splice(i, 1);\n  }\n}\nfunction drawParticles(ctx) { particles.forEach(p => p.draw(ctx)); }\n\n// Player\nclass Player {\n  constructor() {\n    this.x = GAME_WIDTH / 2;\n    this.y = GAME_HEIGHT / 2;\n    this.vx = 0; this.vy = 0;\n    this.angle = 0;\n    this.maxSpeed = 600;\n    this.accel = 1200;\n    this.friction = 800;\n    this.rotSpeed = 4;\n    this.rotAccel = 8;\n    this.radius = 12;\n    this.health = 100;\n    this.maxHealth = 100;\n    this.shootCooldown = 0;\n    this.shootRate = 0.15;\n    this.recoil = 80;\n    this.invuln = 0;\n    this.score = 0;\n    this.ammo = Infinity;\n    this.clipSize = 30;\n    this.clip = 30;\n    this.reloading = false;\n    this.reloadTime = 2;\n    this.reloadTimer = 0;\n  }\n  update(dt, input, mouseAngle) {\n    // Rotation towards mouse\n    this.angle = lerpAngle(this.angle, mouseAngle, this.rotSpeed * dt);\n    \n    // Thrust\n    let thrustX = 0, thrustY = 0;\n    if (input.up) { thrustX = Math.cos(this.angle); thrustY = Math.sin(this.angle); }\n    if (input.down) { thrustX -= Math.cos(this.angle); thrustY -= Math.sin(this.angle); }\n    if (input.left) this.angle -= this.rotSpeed * dt;\n    if (input.right) this.angle += this.rotSpeed * dt;\n    \n    if (thrustX !== 0 || thrustY !== 0) {\n      const len = Math.hypot(thrustX, thrustY);\n      thrustX /= len; thrustY /= len;\n      this.vx += thrustX * this.accel * dt;\n      this.vy += thrustY * this.accel * dt;\n    } else {\n      // Friction\n      const speed = Math.hypot(this.vx, this.vy);\n      if (speed > 0) {\n        const decel = Math.min(this.friction * dt, speed);\n        this.vx -= (this.vx / speed) * decel;\n        this.vy -= (this.vy / speed) * decel;\n      }\n    }\n    // Clamp speed\n    const speed = Math.hypot(this.vx, this.vy);\n    if (speed > this.maxSpeed) {\n      this.vx = (this.vx / speed) * this.maxSpeed;\n      this.vy = (this.vy / speed) * this.maxSpeed;\n    }\n    // Move\n    this.x += this.vx * dt;\n    this.y += this.vy * dt;\n    // Wrap around\n    if (this.x < -this.radius) this.x = GAME_WIDTH + this.radius;\n    if (this.x > GAME_WIDTH + this.radius) this.x = -this.radius;\n    if (this.y < -this.radius) this.y = GAME_HEIGHT + this.radius;\n    if (this.y > GAME_HEIGHT + this.radius) this.y = -this.radius;\n    \n    // Shoot cooldown\n    if (this.shootCooldown > 0) this.shootCooldown -= dt;\n    // Reload\n    if (this.reloading) {\n      this.reloadTimer -= dt;\n      if (this.reloadTimer <= 0) { this.clip = this.clipSize; this.reloading = false; }\n    }\n    // Invulnerability\n    if (this.invuln > 0) this.invuln -= dt;\n  }\n  shoot() {\n    if (this.shootCooldown <= 0 && !this.reloading && this.clip > 0) {\n      this.shootCooldown = this.shootRate;\n      this.clip--;\n      if (this.clip <= 0) { this.reloading = true; this.reloadTimer = this.reloadTime; }\n      // Recoil\n      this.vx -= Math.cos(this.angle) * this.recoil;\n      this.vy -= Math.sin(this.angle) * this.recoil;\n      playShoot();\n      return true;\n    }\n    return false;\n  }\n  takeDamage(amount) {\n    if (this.invuln > 0) return false;\n    this.health -= amount;\n    this.invuln = 0.5;\n    playHit()