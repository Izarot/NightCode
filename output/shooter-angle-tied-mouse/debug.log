// Update function
function update(dt) {
  if (paused || gameOver) return;
  gameTime += dt;
  player.update(dt, input, mouseAngle);
  
  // Shooting
  if (input.shoot) {
    if (player.shoot()) {
      const bulletX = player.x + Math.cos(player.angle) * 20;
      const bulletY = player.y + Math.sin(player.angle) * 20;
      bullets.push(new Bullet(bulletX, bulletY, player.angle, true));
    }
  }
  
  // Update bullets
  for (let i = bullets.length - 1; i >= 0; i--) {
    bullets[i].update(dt);
    if (bullets[i].life <= 0) bullets.splice(i, 1);
  }
  
  // Update enemies and handle enemy shooting
  for (const e of enemies) {
    const shot = e.update(dt, player);
    if (shot) {
      bullets.push(new Bullet(shot.x, shot.y, shot.angle, false));
    }
  }
  
  updateWave(dt);
  checkCollisions();
  updateParticles(dt);
  updateUI();
}

// Draw function
function draw() {
  // Clear
  ctx.fillStyle = COLORS.bg;
  ctx.fillRect(0, 0, GAME_WIDTH, GAME_HEIGHT);
  
  // Grid background
  ctx.strokeStyle = '#1a1a2e';
  ctx.lineWidth = 1;
  const gridSize = 50;
  for (let x = 0; x <= GAME_WIDTH; x += gridSize) {
    ctx.beginPath();
    ctx.moveTo(x, 0);
    ctx.lineTo(x, GAME_HEIGHT);
    ctx.stroke();
  }
  for (let y = 0; y <= GAME_HEIGHT; y += gridSize) {
    ctx.beginPath();
    ctx.moveTo(0, y);
    ctx.lineTo(GAME_WIDTH, y);
    ctx.stroke();
  }
  
  // Draw entities
  player.draw(ctx);
  bullets.forEach(b => b.draw(ctx));
  enemies.forEach(e => e.draw(ctx));
  drawParticles(ctx);
  
  // Draw crosshair on canvas (optional, we have HTML crosshair)
  ctx.beginPath();
  ctx.arc(mouseX, mouseY, 12, 0, Math.PI * 2);
  ctx.strokeStyle = '#fff';
  ctx.lineWidth = 1;
  ctx.stroke();
  ctx.beginPath();
  ctx.moveTo(mouseX, mouseY - 18);
  ctx.lineTo(mouseX, mouseY - 8);
  ctx.moveTo(mouseX, mouseY + 8);
  ctx.lineTo(mouseX, mouseY + 18);
  ctx.moveTo(mouseX - 18, mouseY);
  ctx.lineTo(mouseX - 8, mouseY);
  ctx.moveTo(mouseX + 8, mouseY);
  ctx.lineTo(mouseX + 18, mouseY);
  ctx.stroke();
}

// Game over check
function checkGameOver() {
  if (gameOver) {
    if (player.score > highScore) {
      highScore = player.score;
      localStorage.setItem('highScore', highScore);
    }
    finalScoreEl.textContent = player.score;
    finalTimeEl.textContent = gameTime.toFixed(2) + 's';
    gameOverEl.style.display = 'block';
  }
}

// Game loop
function gameLoop(timestamp) {
  const dt = Math.min((timestamp - lastTime) / 1000, 0.1);
  lastTime = timestamp;
  update(dt);
  checkGameOver();
  draw();
  requestAnimationFrame(gameLoop);
}
let lastTime = 0;
requestAnimationFrame(gameLoop);

// Input handling
window.addEventListener('keydown', e => {
  if (e.code === 'KeyW' || e.code === 'ArrowUp') input.up = true;
  if (e.code === 'KeyS' || e.code === 'ArrowDown') input.down = true;
  if (e.code === 'KeyA' || e.code === 'ArrowLeft') input.left = true;
  if (e.code === 'KeyD' || e.code === 'ArrowRight') input.right = true;
  if (e.code === 'Space') input.shoot = true;
  if (e.code === 'Escape') togglePause();
  if (e.code === 'KeyR' && player.reloading === false && player.clip < player.clipSize) {
    player.reloading = true;
    player.reloadTimer = player.reloadTime;
  }
});
window.addEventListener('keyup', e => {
  if (e.code === 'KeyW' || e.code === 'ArrowUp') input.up = false;
  if (e.code === 'KeyS' || e.code === 'ArrowDown') input.down = false;
  if (e.code === 'KeyA' || e.code === 'ArrowLeft') input.left = false;
  if (e.code === 'KeyD' || e.code === 'ArrowRight') input.right = false;
  if (e.code === 'Space') input.shoot = false;
});

canvas.addEventListener('mousemove', e => {
  const rect = canvas.getBoundingClientRect();
  mouseX = (e.clientX - rect.left) * (GAME_WIDTH / rect.width);
  mouseY = (e.clientY - rect.top) * (GAME_HEIGHT / rect.height);
  mouseAngle = Math.atan2(mouseY - player.y, mouseX - player.x);
});

canvas.addEventListener('mousedown', e => {
  if (e.button === 0) input.shoot = true;
  initAudio();
});
canvas.addEventListener('mouseup', e => {
  if (e.button === 0) input.shoot = false;
});

// Prevent context menu
canvas.addEventListener('contextmenu', e => e.preventDefault());

// Pause/Resume
function togglePause() {
  if (gameOver) return;
  paused = !paused;
  pauseMenu.style.display = paused ? 'block' : 'none';
  if (!paused) initAudio();
}

document.getElementById('resumeBtn').addEventListener('click', togglePause);
document.getElementById('restartBtn').addEventListener('click', resetGame);
document.getElementById('retryBtn').addEventListener('click', resetGame);

function resetGame() {
  player = new Player();
  bullets = [];
  enemies = [];
  wave = 1;
  waveTimer = 0;
  spawnInterval = 3;
  gameTime = 0;
  paused = false;
  gameOver = false;
  pauseMenu.style.display = 'none';
  gameOverEl.style.display = 'none';
  initAudio();
}

// Initialize audio on first interaction
document.addEventListener('click', initAudio, { once: true });
document.addEventListener('keydown', initAudio, { once: true });

// End of game.js
