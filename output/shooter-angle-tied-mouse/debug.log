\n    this.shootCooldown = 0;\n    this.radius = 18;\n    this.pathIndex = 0;\n    this.patrolPoints = [];\n    this.setType(type);\n  }\n  setType(type) {\n    this.type = type;\n    switch (type) {\n      case 'drone':\n        this.maxSpeed = 300;\n        this.health = 3;\n        this.maxHealth = 3;\n        this.shootRate = 0.5;\n        this.color = COLORS.enemy1;\n        this.scoreValue = 10;\n        break;\n      case 'seeker':\n        this.maxSpeed = 250;\n        this.health = 5;\n        this.maxHealth = 5;\n        this.shootRate = 0.2;\n        this.color = COLORS.enemy2;\n        this.scoreValue = 20;\n        break;\n      case 'patroller':\n        this.maxSpeed = 200;\n        this.health = 7;\n        this.maxHealth = 7;\n        this.shootRate = 1.0;\n        this.color = COLORS.enemy3;\n        this.scoreValue = 30;\n        // Generate patrol points\n        for (let i = 0; i < 4; i++) {\n          this.patrolPoints.push({\n            x: randomRange(100, GAME_WIDTH - 100),\n            y: randomRange(100, GAME_HEIGHT - 100)\n          });\n        }\n        break;\n    }\n  }\n  update(dt, player) {\n    if (this.shootCooldown > 0) this.shootCooldown -= dt;\n    \n    let targetX = player.x, targetY = player.y;\n    if (this.type === 'patroller') {\n      const target = this.patrolPoints[this.pathIndex];\n      targetX = target.x; targetY = target.y;\n      if (dist(this.x, this.y, targetX, targetY) < 50) {\n        this.pathIndex = (this.pathIndex + 1) % this.patrolPoints.length;\n      }\n    }\n    \n    const dx = targetX - this.x;\n    const dy = targetY - this.y;\n    const distance = Math.hypot(dx, dy);\n    if (distance > 0) {\n      const dirX = dx / distance;\n      const dirY = dy / distance;\n      this.vx += dirX * this.maxSpeed * dt * 2; // acceleration factor\n      this.vy += dirY * this.maxSpeed * dt * 2;\n      this.angle = Math.atan2(dirY, dirX);\n    }\n    // Clamp speed\n    const speed = Math.hypot(this.vx, this.vy);\n    if (speed > this.maxSpeed) {\n      this.vx = (this.vx / speed) * this.maxSpeed;\n      this.vy = (this.vy / speed) * this.maxSpeed;\n    }\n    // Move\n    this.x += this.vx * dt;\n    this.y += this.vy * dt;\n    // Wrap\n    if (this.x < -this.radius) this.x = GAME_WIDTH + this.radius;\n    if (this.x > GAME_WIDTH + this.radius) this.x = -this.radius;\n    if (this.y < -this.radius) this.y = GAME_HEIGHT + this.radius;\n    if (this.y > GAME_HEIGHT + this.radius) this.y = -this.radius;\n    \n    // Shoot at player if in range and cooldown ready\n    if (this.type !== 'patroller' || randomRange(0,1) < 0.02) {\n      if (distance < 600 && this.shootCooldown <= 0) {\n        this.shootCooldown = this.shootRate;\n        return { x: this.x, y: this.y, angle: Math.atan2(player.y - this.y, player.x - this.x) };\n      }\n    }\n    return null;\n  }\n  takeDamage(amount) {\n    this.health -= amount;\n    playHit();\n    return this.health <= 0;\n  }\n  draw(ctx) {\n    ctx.save();\n    ctx.translate(this.x, this.y);\n    ctx.rotate(this.angle);\n    // Body\n    ctx.beginPath();\n    if (this.type === 'drone') {\n      ctx.moveTo(18, 0);\n      ctx.lineTo(-12, -12);\n      ctx.lineTo(-12, 12);\n    } else if (this.type === 'seeker') {\n      ctx.moveTo(20, 0);\n      ctx.lineTo(-10, -15);\n      ctx.lineTo(-5, 0);\n      ctx.lineTo(-10, 15);\n    } else {\n      ctx.moveTo(22, 0);\n      ctx.lineTo(-15, -18);\n      ctx.lineTo(-10, 0);\n      ctx.lineTo(-15, 18);\n    }\n    ctx.closePath();\n    ctx.fillStyle = this.color;\n    ctx.fill();\n    ctx.strokeStyle = '#fff';\n    ctx.lineWidth = 1;\n    ctx.stroke();\n    // Health bar\n    if (this.health < this.maxHealth) {\n      ctx.fillStyle = '#333';\n      ctx.fillRect(-20, -25, 40, 4);\n      ctx.fillStyle = '#0f0';\n      ctx.fillRect(-20, -25, 40 * (this.health / this.maxHealth), 4);\n    }\n    ctx.restore();\n  }\n}\n\n// Game state\nconst canvas = document.getElementById('gameCanvas');\nconst ctx = canvas.getContext('2d');\nlet player = new Player();\nlet bullets = [];\nlet enemies = [];\nlet input = { up: false, down: false, left: false, right: false, shoot: false };\nlet mouseAngle = 0;\nlet mouseX = 0, mouseY = 0;\nlet wave = 1;\nlet waveTimer = 0;\nlet spawnInterval = 3;\nlet gameTime = 0;\nlet paused = false;\nlet gameOver = false;\nlet highScore = parseInt(localStorage.getItem('highScore')) || 0;\n\n// UI elements\nconst healthFill = document.getElementById('healthFill');\nconst scoreEl = document.getElementById('score');\nconst waveEl = document.getElementById('waveTimer');\nconst timerEl = document.getElementById('timer');\nconst ammoEl = document.getElementById('ammo');\nconst highScoreEl = document.getElementById('highScore');\nconst crosshair = document.getElementById('crosshair');\nconst pauseMenu = document.getElementById('pauseMenu');\nconst gameOverEl = document.getElementById('gameOver');\nconst finalScoreEl = document.getElementById('finalScore');\nconst finalTimeEl = document.getElementById('finalTime');\n\nfunction updateUI() {\n  healthFill.style.width = (player.health / player.maxHealth * 100) + '%';\n  scoreEl.textContent = 'Score: ' + player.score;\n  waveEl.textContent = 'Wave: ' + wave;\n  timerEl.textContent = 'Time: ' + gameTime.toFixed(2) + 's';\n  ammoEl.textContent = player.clipSize === Infinity ? 'Ammo: ∞' : 'Ammo: ' + player.clip + (player.reloading ? ' (reloading)' : '');\n  highScoreEl.textContent = 'Best: ' + highScore;\n  // Crosshair follows mouse\n  crosshair.style.left = mouseX + 'px';\n  crosshair.style.top = mouseY + 'px';\n}\n\nfunction spawnEnemy() {\n  const side = Math.floor(randomRange(0, 4));\n  let x, y;\n  switch (side) {\n    case 0: x = randomRange(0, GAME_WIDTH); y = -50; break;\n    case 1: x = GAME_WIDTH + 50; y = randomRange(0, GAME_HEIGHT); break;\n    case 2: x = randomRange(0, GAME_WIDTH); y = GAME_HEIGHT + 50; break;\n    case 3: x = -50; y = randomRange(0, GAME_HEIGHT); break;\n  }\n  let type;\n  const rand = Math.random();\n  if (wave < 3) type = 'drone';\n  else if (wave < 6) type = rand < 0.7 ? 'drone' : 'seeker';\n  else type = rand < 0.5 ? 'drone' : (rand < 0.8 ? 'seeker' : 'patroller');\n  enemies.push(new Enemy(x, y, type));\n}\n\nfunction updateWave(dt) {\n  waveTimer += dt;\n  if (waveTimer >= spawnInterval) {\n    waveTimer = 0;\n    spawnEnemy();\n    // Increase difficulty\n    if (enemies.length < 50) {\n      spawnInterval = Math.max(0.5, spawnInterval - 0.02);\n    }\n  }\n  // Wave progression based on kills? We'll use time for simplicity.\n  if (gameTime > wave * 30) {\n    wave++;\n    spawnInterval = Math.max(0.5, 3 - wave * 0.2);\n  }\n}\n\nfunction checkCollisions() {\n  // Player bullets vs enemies\n  for (let i = bullets.length - 1; i >= 0; i--) {\n    const b = bullets[i];\n    if (!b.friendly) continue;\n    for (let j = enemies.length - 1; j >= 0; j--) {\n      const e = enemies[j];\n      if (dist(b.x, b.y, e.x, e.y) < b.radius + e.radius) {\n        if (e.takeDamage(b.damage)) {\n          player.score += e.scoreValue;\n          spawnExplosion(e.x, e.y, e.color, 15);\n          playExplosion();\n          enemies.splice(j, 1);\n        }\n        bullets.splice(i, 1);\n        break;\n      }\n    }\n  }\n  // Enemy bullets vs player\n  for (let i = bullets.length - 1; i >= 0; i--) {\n    const b = bullets[i];\n    if (b.friendly) continue;\n    if (dist(b.x, b.y, player.x, player.y) < b.radius + player.radius) {\n      if (player.takeDamage(b.damage)) {\n        gameOver = true;\n        spawnExplosion(player.x, player.y, COLORS.player, 30);\n        playExplosion();\n      }\n      bullets.splice(i, 1);\n    }\n  }\n  // Enemy vs player collision\n  for (const e of enemies) {\n    if (dist(e.x, e.y, player.x, player.y) < e.radius + player.radius) {\n      if (player.takeDamage(10)) {\n        gameOver = true;\n        spawnExplosion(player.x, player.y, COLORS.player, 30);\n        playExplosion();\n      }\n      // Push player away\n      const angle = Math.atan2(playery - e.y, player.x - e.x);\n      player.vx += Math.cos(angle) * 200;\n      player.vy += Math.sin(angle) * 200;\n    }\n  }\n}\n\nfunction update(dt) {\n  if (paused || gameOver) return;\n  gameTime += dt;\n  player.update(dt, input, mouseAngle);\n  \n  // Shooting\n  if (input.shoot) {\n    if (player.shoot()) {\n      const bulletX = player.x + Math.cos(player.angle) * 20;\n      const bulletY = player.y + Math.sin(player.angle) * 20;\n      bullets.push(new Bullet(bulletX, bulletY, player.angle, true));\n    }\n  }\n  \n  // Update bullets\n  for (let i = bullets.length - 1; i >= 0; i--) {\n    bullets[i].update(dt);\n    if (bullets[i].life <= 0) bullets.splice(i, 1);\n  }\n  \n  // Update enemies and handle enemy shooting\n  for (const e of enemies) {\n    const shot = e.update(dt, player);\n    if (shot) {\n      bullets.push(new Bullet(shot.x, shot.y, shot.angle, false));\n    }\n  }\n  \n  updateWave(dt);\n  checkCollisions();\n  updateParticles(dt);\n  updateUI();\n}\n\nfunction draw() {\n  // Clear\n  ctx.fillStyle = COLORS.bg;\n  ctx.fillRect(0, 0, GAME_WIDTH, GAME_HEIGHT);\n  \n  // Grid background\n  ctx.strokeStyle = '#1a1a2e';\n  ctx.lineWidth = 1;\n  const gridSize = 50;\n  for (let x = 0; x <= GAME_WIDTH; x += gridSize) {\n    ctx.beginPath();\n    ctx.moveTo(x, 0);\n    ctx.lineTo(x, GAME_HEIGHT);\n    ctx.stroke();\n  }\n  for (let y = 0; y <= GAME_HEIGHT; y += gridSize) {\n    ctx.beginPath();\n    ctx.moveTo(0, y);\n    ctx.lineTo(GAME_WIDTH, y);\n    ctx.stroke();\n  }\n  \n  // Draw entities\n  player.draw(ctx);\n  bullets.forEach(b => b.draw(ctx));\n  enemies.forEach(e => e.draw(ctx));\n  drawParticles(ctx);\n  \n  // Draw crosshair on canvas (optional, we have HTML crosshair)\n  ctx.beginPath();\n  ctx.arc(mouseX, mouseY, 12, 0, Math.PI * 2);\n  ctx.strokeStyle = '#fff';\n  ctx.lineWidth = 1;\n  ctx.stroke();\n  ctx.beginPath();\n  ctx.moveTo(mouseX, mouseY - 18);\n  ctx.lineTo(mouseX, mouseY - 8);\n  ct