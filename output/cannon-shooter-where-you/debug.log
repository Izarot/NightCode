<body>
<canvas id="gameCanvas"></canvas>
<div id="hud">
<div id="topHud">
<div id="leftHud">
<div class="hud-panel" id="scorePanel">SCORE: <span id="score">0</span></div>
<div class="hud-panel" id="wavePanel">WAVE <span id="waveInfo">1</span></div>
<div class="hud-panel" id="ammoPanel">AMMO: <span id="ammoDisplay">5</span></div>
</div>
<div id="centerHud">
<div class="hud-panel" id="comboPanel">COMBO x<span id="comboDisplay">0</span></div>
</div>
<div id="rightHud">
<div class="hud-panel" id="powerPanel">POWER: <span id="powerDisplay">0</span>%</div>
<div class="hud-panel" id="anglePanel">ANGLE: <span id="angleDisplay">45</span>°</div>
</div>
</div>
