                  this.input.update();\n                    if (this.input.consumeClick()) {\n                        this.start();\n                    }\n                    if (this.input.keys['KeyM']) {\n                        this.input.keys['KeyM'] = false;\n                        this.audio.toggleMute();\n                    }\n                    return;\n                }\n                \n                if (this.state === GameState.GAME_OVER) {\n                    this.gameOverShake = Math.max(0, this.gameOverShake - dt * 2);\n                    if (this.input.keys['KeyR'] || this.input.consumeClick()) {\n                        this.input.keys['KeyR'] = false;\n                        this.start();\n                    }\n                    return;\n                }\n                \n                if (this.state === GameState.PAUSED) {\n                    if (this.input.keys['Space'] || this.input.keys['Escape']) {\n                        this.input.keys['Space'] = false;\n                        this.input.keys['Escape'] = false;\n                        this.state = GameState.PLAYING;\n                    }\n                    if (this.input.keys['KeyM']) {\n                        this.input.keys['KeyM'] = false;\n                        this.audio.toggleMute();\n                    }\n                    return;\n                }\n                \n                if (this.input.keys['Space'] || this.input.keys['Escape']) {\n                    this.input.keys['Space'] = false;\n                    this.input.keys['Escape'] = false;\n                    this.state = GameState.PAUSED;\n                    return;\n                }\n                \n                if (this.input.keys['KeyM']) {\n                    this.input.keys['KeyM'] = false;\n                    this.audio.toggleMute();\n                }\n                \n                this.runTime = Date.now() - this.startTime;\n                this.input.update();\n                \n                if (this.comboTimer > 0) {\n                    this.comboTimer -= dt;\n                    if (this.comboTimer <= 0) {\n                        this.combo = 0;\n                        this.comboMultiplier = 1;\n                    }\n                }\n                \n                const spawnInterval = Math.max(4 - this.level * 0.5, 1.5);\n                if (this.time - this.lastPuddleSpawn > spawnInterval && this.puddles.length < 20) {\n                    this.spawnPuddle();\n                    this.lastPuddleSpawn = this.time;\n                }\n                \n                let totalArea = 0;\n                for (const puddle of this.puddles) {\n                    puddle.update(dt, this.time);\n                    if (puddle.state === 'active') {\n                        totalArea += puddle.getArea();\n                    }\n                }\n                \n                this.overflowArea = totalArea / (canvas.width * canvas.height);\n                \n                if (this.overflowArea > CONFIG.warningThreshold) {\n                    this.warningFlash += dt * 8;\n                    this.warningSoundCooldown -= dt;\n                    if (this.warningSoundCooldown <= 0) {\n                        this.audio.playWarning();\n                        this.warningSoundCooldown = 1.0;\n                    }\n                } else {\n                    this.warningSoundCooldown = 0;\n                }\n                \n                if (this.overflowArea > CONFIG.overflowThreshold) {\n                    this.state = GameState.GAME_OVER;\n                    this.gameOverShake = 1;\n                    if (this.score > this.highScore) {\n                        this.highScore = this.score;\n                        localStorage.setItem('solarEvapHighScore', this.highScore.toString());\n                    }\n                    return;\n                }\n                \n                if (this.puddlesEvaporated >= this.level * CONFIG.levelUpPuddles) {\n                    this.level++;\n                }\n                \n                const beamX = this.input.mouseX;\n                const groundY = canvas.height * 0.9;\n                const beamBlocked = this.clouds.some(c => c.blocksSunbeam(beamX, groundY));\n                const intensity = beamBlocked ? 0 : this.input.getIntensity();\n                \n                for (const puddle of this.puddles) {\n                    if (puddle.state === 'active' && puddle.containsPoint(beamX, groundY)) {\n                        const evapRate = CONFIG.baseEvaporationRate * intensity * puddle.evaporationMultiplier * dt;\n                        puddle.size -= evapRate;\n                        \n                        if (Math.random() < 0.3) {\n                            this.particles.push(new Particle(\n                                puddle.x + (Math.random() - 0.5) * puddle.size,\n                                puddle.y - puddle.size / 4,\n                                'steam'\n                            ));\n                        }\n                        \n                        if (puddle.size <= 0) {\n                            puddle.state = 'evaporated';\n                            \n                            let points = puddle.getPoints();\n                            \n                            const distFromCenter = Math.abs(puddle.x - beamX);\n                            if (distFromCenter < puddle.baseSize * 0.2) {\n                                points += 50;\n                            }\n                            \n                            this.combo++;\n                            this.comboTimer = 2;\n                            if (this.combo >= 5) {\n                                this.comboMultiplier = 3;\n                                this.audio.playCombo();\n                            } else if (this.combo >= 3) {\n                                this.comboMultiplier = 2;\n                                this.audio.playCombo();\n                            } else {\n                                this.audio.playScore();\n                            }\n                            \n                            points *= this.comboMultiplier;\n                            this.score += points;\n                            this.puddlesEvaporated++;\n                            \n                            this.audio.playEvaporate();\n                            \n                            const scoreParticle = new Particle(puddle.x, puddle.y, 'score');\n                            scoreParticle.text = '+' + points;\n                            this.particles.push(scoreParticle);\n                        }\n                    }\n                }\n                \n                if (Math.random() < 0.1 && !beamBlocked) {\n                    this.particles.push(new Particle(\n                        beamX + (Math.random() - 0.5) * 40,\n                        groundY - Math.random() * 100,\n                        'spark'\n                    ));\n                }\n                \n                this.puddles = this.puddles.filter(p => p.state !== 'evaporated');\n                \n                for (const particle of this.particles) {\n                    particle.update(dt);
                }\n                this.particles = this.particles.filter(p => p.life > 0);\n                \n                this.warningFlash = Math.max(0, this.warningFlash - dt);\n            }\n\n            drawTitleScreen() {\n                const cx = canvas.width / 2;\n                const cy = canvas.height / 2;\n                \n                ctx.fillStyle = 'rgba(26, 35, 126, 0.3)';\n                ctx.fillRect(0, 0, canvas.width, canvas.height);\n                \n                const pulse = Math.sin(this.titlePulse) * 0.1 + 1;\n                \n                ctx.save();\n                ctx.translate(cx, cy - 100);\n                ctx.scale(pulse, pulse);\n                \n                ctx.fillStyle = COLORS.sunbeamCore;\n                ctx.font = 'bold 72px \"Fredoka One\", sans-serif';\n                ctx.textAlign = 'center';\n                ctx.textBaseline = 'middle';\n                ctx.shadowColor = COLORS.sunbeamGlow;\n                ctx.shadowBlur = 30;\n                ctx.fillText('SOLAR', 0, -40);\n                ctx.fillText('EVAPORATION', 0, 40);\n                ctx.shadowBlur = 0;\n                ctx.restore();\n                \n                const instructionY = cy + 100;\n                const blink = Math.sin(this.titlePulse * 2) > 0;\n                if (blink) {\n                    ctx.fillStyle = '#FFFFFF';\n                    ctx.font = '28px \"Fredoka One\", sans-serif';\n                    ctx.textAlign = 'center';\n                    ctx.fillText('CLICK or TAP to START', cx, instructionY);\n                }\n                \n                ctx.fillStyle = '#E0E0E0';\n                ctx.font = '18px \"Fredoka One\", sans-serif';\n                ctx.textAlign = 'center';\n                ctx.fillText('Move mouse/finger to control the sunbeam', cx, instructionY + 50);\n                ctx.fillText('Hold still for more power!', cx, instructionY + 80);\n                ctx.fillText('Evaporate puddles before they overflow!', cx, instructionY + 110);\n                \n                ctx.fillStyle = COLORS.sunbeamGlow;\n                ctx.font = 'bold 22px \"Fredoka One\", sans-serif';\n                ctx.textAlign = 'center';\n                ctx.fillText('HIGH SCORE: ' + this.highScore, cx, instructionY + 160);\n                \n                ctx.fillStyle = '#BDBDBD';\n                ctx.font = '14px \"Fredoka One\", sans-serif';\n                ctx.fillText('Press [M] to Mute  |  [SPACE] to Pause', cx, canvas.height - 30);\n            }\n\n            drawGameOverScreen() {\n                const cx = canvas.width / 2;\n                const cy = canvas.height / 2;\n                \n                ctx.fillStyle = 'rgba(0, 0, 0, 0.7)';\n                ctx.fillRect(0, 0, canvas.width, canvas.height);\n                \n                const shakeX = (Math.random() - 0.5) * this.gameOverShake * 20;\n                const shakeY = (Math.random() - 0.5) * this.gameOverShake * 20;\n                \n                ctx.save();\n                ctx.translate(shakeX, shakeY);\n                \n                ctx.fillStyle = '#FF1744';\n                ctx.font = 'bold 80px \"Fredoka One\", sans-serif';\n                ctx.textAlign = 'center';\n                ctx.textBaseline = 'middle';\n                ctx.shadowColor = '#000000';\n                ctx.shadowBlur = 20;\n                ctx.fillText('OVERFLOW!', cx, cy - 100);\n                ctx.shadowBlur = 0;\n                \n                ctx.fillStyle = '#FFFFFF';\n                ctx.font = '36px \"Fredoka One\", sans-serif';\n                ctx.fillText('Final Score: ' + this.score, cx, cy);\n                \n                if (this.score >= this.highScore && this.score > 0) {\n                    ctx.fillStyle = COLORS.sunbeamCore;\n                    ctx.font = '28px \"Fredoka One\", sans-serif';\n                    ctx.fillText('NEW HIGH SCORE!', cx, cy + 50);\n                } else {\n                    ctx.fillStyle = '#BDBDBD';\n                    ctx.font = '24px \"Fredoka One\", sans-serif';\n                    ctx.fillText('High Score: ' + this.highScore, cx, cy + 50);\n                }\n                \n                ctx.fillStyle = '#E0E0E0';\n                ctx.font = '20px \"Fredoka One\", sans-serif';\n                ctx.fillText('Level Reached: ' + this.level, cx, cy + 100);\n                ctx.fillText('Time: ' + this.formatTime(this.runTime), cx, cy + 135);\n                \n                const blink = Math.sin(Date.now() / 300) > 0;\n                if (blink) {\n                    ctx.fillStyle = COLORS.sunbeamCore;\n                    ctx.font = '26px \"Fredoka One\", sans-serif';\n                    ctx.fillText('Click or [R] to RESTART', cx, cy + 200);\n                }\n                \n                ctx.restore();\n            }\n\n            drawPausedScreen() {\n                ctx.fillStyle = 'rgba(0, 0, 0, 0.6)';\n                ctx.fillRect(0, 0, canvas.width, canvas.height);\n                \n                const cx = canvas.width / 2;\n                const cy = canvas.height / 2;\n                \n                ctx.fillStyle = COLORS.sunbeamCore;\n                ctx.font = 'bold 72px \"Fredoka One\", sans-serif';\n                ctx.textAlign = 'center';\n                ctx.textBaseline = 'middle';\n                ctx.shadowColor = COLORS.sunbeamGlow;\n                ctx.shadowBlur = 20;\n                ctx.fillText('PAUSED', cx, cy);\n                ctx.shadowBlur = 0;\n                \n                ctx.fillStyle = '#FFFFFF';\n                ctx.font = '24px \"Fredoka One\", sans-serif';\n                ctx.fillText('Press [SPACE] or [ESC] to Resume', cx, cy + 60);\n            }\n\n            drawBackground() {\n                const skyGrad = ctx.createLinearGradient(0, 0, 0, canvas.height);\n                skyGrad.addColorStop(0, '#1A237E');\n                skyGrad.addColorStop(0.4, '#3949AB');\n                skyGrad.addColorStop(0.7, '#FF6D00');\n                skyGrad.addColorStop(1, '#FFB300');\n                ctx.fillStyle = skyGrad;\n                ctx.fillRect(0, 0, canvas.width, canvas.height);\n                \n                for (const cloud of this.clouds) {\n                    cloud.draw(ctx);\n                }\n                \n                const groundY = canvas.height * 0.9;\n                const groundGrad = ctx.createLinearGradient(0, groundY, 0, canvas.height);\n                groundGrad.addColorStop(0, COLORS.grassHighlights);\n                groundGrad.addColorStop(1, COLORS.grassBase);\n                ctx.fillStyle = groundGrad;\n                ctx.fillRect(0, groundY, canvas.width, canvas.height - groundY);\n                \n                ctx.fillStyle = 'rgba(0,0,0,0.15)';\n                for (let i = 0; i < 30; i++) {\n                    const x = (i * 53 + Math.floor(this.time * 5)) % canvas.width;\n                    const y = groundY + (i * 7) % (canvas.height - groundY);\n                    ctx.fillRect(x, y, 3, 1);\n                }\n            }\n\n            drawSunbeam(intensity, blocked) {\n                if (this.state !== GameState.PLAYING) return;\n                \n                const beamX = this.input.mouseX;\n                const groundY = canvas.height * 0.9;\n                const beamWidth = 60 + intensity * 30;\n                \n                if (blocked) {\n                    ctx.globalAlpha = 0.3;\n                } else {\n                    ctx.globalAlpha = 0.8 + intensity * 0.1;\n                }\n                \n                const grad = ctx.createLinearGradient(beamX, 0, beamX, groundY);\n                grad.addColorStop(0, 'rgba(255, 245, 204, 0)');\n                grad.addColorStop(0.3, COLORS.sunbeamCorona);\n                grad.addColorStop(0.7, COLORS.sunbeamCore);\n                grad.addColorStop(1, COLORS.sunbeamGlow);\n                \n                ctx.fillStyle = grad;\n                ctx.beginPath();\n                ctx.moveTo(beamX - 10, 0);\n                ctx.lineTo(beamX + 10, 0);\n                ctx.lineTo(beamX + beamWidth / 2, groundY);\n                ctx.lineTo(beamX - beamWidth / 2, groundY);\n                ctx.closePath();\n                ctx.fill();\n                \n                if (!blocked) {\n                    const glowGrad = ctx.createRadialGradient(\n                        beamX, 50, 0,\n                        beamX, 50, 100 + intensity * 50\n                    );\n                    glowGrad.addColorStop(0, 'rgba(255, 229, 102, 0.6)');\n                    glowGrad.addColorStop(1, 'rgba(255, 170, 0, 0)');\n                    ctx.fillStyle = glowGrad;\n                    ctx.beginPath();\n                    ctx.arc(beamX, 50, 100 + intensity * 50, 0, Math.PI * 2);\n                    ctx.fill();\n                    \n                    ctx.fillStyle = '#FFFFFF';\n                    ctx.globalAlpha = 0.5 + Math.sin(this.time * 10) * 0.3;\n                    ctx.beginPath();\n                    ctx.arc(beamX, 50, 15 + intensity * 5, 0, Math.PI * 2);\n                    ctx.fill();\n                }\n                \n                ctx.globalAlpha = 1;\n            }\n\n            drawHUD() {\n                if (this.state !== GameState.PLAYING && this.state !== GameState.PAUSED) return;\n                \n                const padding = 20;\n                \n                ctx.fillStyle = 'rgba(0, 0, 0, 0.5)';\n                ctx.fillRect(padding, padding, 220, 130);\n                \n                ctx.fillStyle = COLORS.sunbeamCore;\n                ctx.font = 'bold 32px \"Fredoka One\", sans-serif';\n                ctx.textAlign = 'left';\n                ctx.textBaseline = 'top';\n                ctx.fillText('SCORE: ' + this.score, padding + 15, padding + 10);\n                \n                ctx.fillStyle = '#FFFFFF';\n                ctx.font = '20px \"Fredoka One\", sans-serif';\n                ctx.fillText('Level: ' + this.level, padding + 15, padding + 50);\n                ctx.fillText('Time: ' + this.formatTime(this.runTime), padding + 15, padding + 80);\n                \n                if (this.combo > 1) {\n                    ctx.fillStyle = COLORS.sunbeamGlow;\n                    ctx.font = 'bold 22px \"Fredoka One\", sans-serif';\n                    ctx.fillText('COMBO x' + this.comboMultiplier + ' (' + this.combo + ')', padding + 15, padding + 110);\n                }\n                \n                if (this.overflowArea > CONFIG.warningThreshold) {\n                    const warningAlpha = 0.2 + Math.abs(Math.sin(this.warningFlash)) * 0.3;\n                    ctx.fillStyle = 'rgba(255, 23, 68, ' + warningAlpha + ')';\n                    ctx.fillRect(0, 0, canvas.width, canvas.height);\n                    \n                    ctx.fillStyle = '#FF1744';\n                    ctx.font = 'bold 28px \"Fredoka One\", sans-serif';\n                    ctx.textAlign = 'right';\n                    ctx.fillText('⚠ OVERFLOW WARNING!', canvas.width - padding, padding + 10);\n                }\n                \n                const barX = canvas.width - 220 - padding;\n                const barY = padding;\n                const barW = 200;\n                const barH = 25;\n                \n                ctx.fillStyle = 'rgba(0, 0, 0, 0.5)';\n                ctx.fillRect(barX - 5, barY - 5, barW + 10, barH + 10);\n                \n                ctx.fillStyle = '#333333';\n                ctx.fillRect(barX, barY, barW, barH);\n                \n                const fillRatio = Math.min(this.overflowArea / CONFIG.overflowThreshold, 1);\n                const barColor = fillRatio > 0.8 ? '#FF1744' : fillRatio > 0.5 ? '#FFAA00' : '#7CB342';\n                ctx.fillStyle = barColor;\n                ctx.fillRect(barX, barY, barW * fillRatio, barH);\n                \n                ctx.strokeStyle = '#FFFFFF';\n                ctx.lineWidth = 2;\n                ctx.strokeRect(barX, barY, barW, barH);\n                \n                ctx.fillStyle = '#FFFFFF';\n                ctx.font = '16px \"Fredoka One\", sans-serif';\n                ctx.textAlign = 'center';\n                ctx.fillText('OVERFLOW METER', barX + barW / 2, barY + barH + 20);\n                \n                const intensity = this.input.getIntensity();\n                const powerY = barY + barH + 40;\n                \n                ctx.fillStyle = 'rgba(0, 0, 0, 0.5)';\n                ctx.fillRect(barX - 5, powerY - 5, barW + 10, 20);\n                \n                ctx.fillStyle = '#333333';\n                ctx.fillRect(barX, powerY, barW, 12);\n                \n                ctx.fillStyle = COLORS.sunbeamCore;\n                ctx.fillRect(barX, powerY, barW * (intensity / CONFIG.maxIntensityMultiplier), 12);\n                \n                ctx.fillStyle = '#FFFFFF';\n                ctx.font = '14px \"Fredoka One\", sans-serif';\n                ctx.textAlign = 'center';\n                ctx.fillText('BEAM POWER', barX + barW / 2, powerY - 8);\n            }\n\n            draw() {\n                this.drawBackground();\n                \n                if (this.state === GameState.TITLE) {\n                    this.drawTitleScreen();\n                    return;\n                }\n                \n                const beamX = this.input.mouseX;\n                const groundY = canvas.height * 0.9;\n                const beamBlocked = this.clouds.some(c => c.blocksSunbeam(beamX, groundY));\n                const intensity = beamBlocked ? 0 : this.input.getIntensity();\n                \n                for (const puddle of this.puddles) {\n                    puddle.draw(ctx, this.time);\n                }\n                \n                for (const particle of this.particles) {\n                    particle.draw(ctx);\n                }\n                \n                this.drawSunbeam(intensity, beamBlocked);\n                this.drawHUD();\n                \n                if (this.state === GameState.PAUSED) {\n                    this.drawPausedScreen();\n                } else if (this.state === GameState.GAME_OVER) {\n                    this.drawGameOverScreen();\n                }\n            }\n\n            gameLoop(timestamp) {\n                const dt = Math.min((timestamp - this.lastTime) / 1000, 0.05);\n                this.lastTime = timestamp;\n                \n                this.update(dt);\n                this.draw();\n                \n                requestAnimationFrame((t) => this.gameLoop(t));\n            }\n\n            start() {\n                this.lastTime = performance.now();\n                requestAnimationFrame((t) => this.gameLoop(t));\n            }\n        }\n\n        const game = new Game();\n        game.start();\n    </script>\n</body>\n</html>"}