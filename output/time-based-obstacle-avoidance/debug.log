th - 1; i >= 0; i--) {\n    const pu = powerUps[i];\n    const dx = player.x - pu.x;\n    const dy = player.y - pu.y;\n    const dist = Math.hypot(dx, dy);\n    if (dist < player.radius + pu.radius) {\n      activatePowerUp(pu.type);\n      powerUps.splice(i, 1);\n      playSound('powerup');\n    }\n  }\n}\n\nfunction handleCollision() {\n  playSound('collision');\n  timer = Math.max(0, timer - 1);\n  flashTimer = FLASH_DURATION;\n  // brief screen shake could be added\n}\n\nfunction activatePowerUp(type) {\n  if (type === 'dilation') {\n    timeDilationActive = true;\n    timeDilationTimer = DILATION_DURATION;\n  } else if (type === 'extension') {\n    timer = Math.min(MAX_TIME, timer + 5);\n  }\n}\n\nfunction updateFlash(dt) {\n  if (flashTimer > 0) {\n    flashTimer -= dt;\n    if (flashTimer < 0) flashTimer = 0;\n  }\n}\n\nfunction updateDilation(dt) {\n  if (timeDilationActive) {\n    timeDilationTimer -= dt * 60; // frames\n    if (timeDilationTimer <= 0) {\n      timeDilationActive = false;\n      timeDilationTimer = 0;\n    }\n  }\n}\n\nfunction spawnObstacles(dt) {\n  obstacleSpawnTimer -= dt * 60;\n  if (obstacleSpawnTimer <= 0) {\n    spawnObstacle();\n    // Increase spawn rate as time passes\n    const elapsed = MAX_TIME - timer;\n    const factor = Math.max(0.2, 1 - elapsed / MAX_TIME * 0.6); // faster spawn later\n    obstacleSpawnTimer = OBSTACLE_SPAWN_BASE * factor;\n  }\n}\n\nfunction spawnPowerUps(dt) {\n  powerUpSpawnTimer -= dt * 60;\n  if (powerUpSpawnTimer <= 0) {\n    spawnPowerUp();\n    const elapsed = MAX_TIME - timer;\n    const factor = Math.max(0.3, 1 - elapsed / MAX_TIME * 0.5);\n    powerUpSpawnTimer = POWERUP_SPAWN_BASE * factor;\n  }\n}\n\nfunction renderBackground() {\n  ctx.fillStyle = '#0A0A1A';\n  ctx.fillRect(0, 0, width, height);\n}\n\nfunction renderPlayer() {\n  // Trail\n  for (let i = 0; i < player.trail.length; i++) {\n    const p = player.trail[i];\n    const alpha = (i + 1) / player.trail.length;\n    ctx.beginPath();\n    ctx.arc(p.x, p.y, player.radius * 0.5, 0, Math.PI * 2);\n    ctx.fillStyle = `rgba(0,255,255,${alpha * 0.3})`;\n    ctx.fill();\n  }\n  // Body\n  ctx.beginPath();\n  ctx.arc(player.x, player.y, player.radius, 0, Math.PI * 2);\n  ctx.fillStyle = player.color;\n  ctx.fill();\n  ctx.strokeStyle = '#0ff';\n  ctx.lineWidth = 2;\n  ctx.stroke();\n}\n\nfunction renderObstacles() {\n  for (const ob of obstacles) {\n    ctx.save();\n    ctx.translate(ob.x, ob.y);\n    ctx.rotate(ob.rotation);\n    switch (ob.type) {\n      case 'blade':\n        // Draw 3-5 blades\n        const bladeCount = 3 + Math.floor(Math.random() * 3);\n        for (let i = 0; i < bladeCount; i++) {\n          const angle = (i / bladeCount) * Math.PI * 2;\n          ctx.save();\n          ctx.rotate(angle);\n          ctx.fillStyle = '#ff00ff';\n          ctx.beginPath();\n          ctx.moveTo(0, 0);\n          ctx.lineTo(ob.radius, 0);\n          ctx.lineTo(ob.radius - 5, -8);\n          ctx.lineTo(ob.radius, 0);\n          ctx.lineTo(ob.radius - 5, 8);\n          ctx.fill();\n          ctx.restore();\n        }\n        break;\n      case 'barrier':\n        // Ring with gap\n        const gapSize = Math.PI / 3; // 60 deg gap\n        const gapStart = ob.rotation;\n        ctx.beginPath();\n        ctx.arc(0, 0, ob.radius, gapStart + gapSize, gapStart + Math.PI * 2 - gapSize);\n        ctx.strokeStyle = '#ff00ff';
