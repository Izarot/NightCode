  "script.js": "const canvas = document.getElementById('gameCanvas');\nconst ctx = canvas.getContext('2d');\nlet width, height;\nfunction resize() {\n  width = window.innerWidth;\n  height = window.innerHeight;\n  canvas.width = width;\n  canvas.height = height;\n}\nwindow.addEventListener('resize', resize);\nresize();\n\n// Game states\nconst STATE_MENU = 0;\nconst STATE_PLAYING = 1;\nconst STATE_PAUSED = 2;\nconst STATE_GAMEOVER = 3;\nconst STATE_VICTORY = 4;\nlet gameState = STATE_MENU;\n\n// Timer\nconst MAX_TIME = 60; // seconds\nlet timer = MAX_TIME;\nlet score = 0;\nlet highScore = parseInt(localStorage.getItem('chronoShiftHighScore')) || 0;\n\n// Player\nconst player = {\n  x: width / 2,\n  y: height / 2,\n  vx: 0,\n  vy: 0,\n  radius: 16,\n  color: '#0ff',\n  trail: [],\n  maxTrailLength: 10,\n  acceleration: 0.5,\n  friction: 0.95,\n  maxSpeed: 4,\n  dashSpeedMult: 2,\n  dashDuration: 60, // frames at 60fps = 1 sec\n  dashCooldown: 180, // 3 sec\n  dashTimer: 0,\n  dashCooldownTimer: 0\n};\n\n// Input\nconst keys = {\n  ArrowUp: false, ArrowDown: false, ArrowLeft: false, ArrowRight: false,\n  KeyW: false, KeyS: false, KeyA: false, KeyD: false,\n  Space: false\n};\nwindow.addEventListener('keydown', e => { if (e.code in keys) keys[e.code] = true; });\nwindow.addEventListener('keyup', e => { if (e.code in keys) keys[e.code] = false; });\n\n// Obstacles\nconst obstacles = [];\nconst obstacleTypes = ['blade', 'barrier', 'turret'];\nfunction spawnObstacle() {\n  const type = obstacleTypes[Math.floor(Math.random() * obstacleTypes.length)];\n  let radius, rotationSpeed, oscillation = false;\n  switch (type) {\n    case 'blade':\n      radius = 30 + Math.random() * 20;\n      rotationSpeed = (Math.random() * 2 + 1) * (Math.PI / 180); // 1-3 deg/s\n      break;\n    case 'barrier':\n      radius = 40 + Math.random() * 30;\n      rotationSpeed = (Math.random() * 1.5 + 0.5) * (Math.PI / 180);\n      break;\n    case 'turret':\n      radius = 35 + Math.random() * 25;\n      rotationSpeed = (Math.random() * 2 + 0.5) * (Math.PI / 180);\n      break;\n  }\n  // Ensure spawn inside play area with some margin\n  const x = radius + Math.random() * (width - 2 * radius);\n  const y = radius + Math.random() * (height - 2 * radius);\n  obstacles.push({ type, x, y, radius, rotation: 0, rotationSpeed, oscillation })\n}\nlet obstacleSpawnTimer = 0;\nconst OBSTACLE_SPAWN_BASE = 180; // 3 seconds at 60fps\n\n// Power-ups\nconst powerUps = [];\nconst powerUpTypes = ['dilation', 'extension'];\nfunction spawnPowerUp() {\n  const type = powerUpTypes[Math.floor(Math.random() * powerUpTypes.length)];\n  const radius = 20;\n  // Find a position not too close to obstacles\n  let x, y, valid = false;\n  for (let i = 0; i < 100; i++) {\n    x = radius + Math.random() * (width - 2 * radius);\n    y = radius + Math.random() * (height - 2 * radius);\n    valid = true;\n    for (const ob of obstacles) {\n      const dx = x - ob.x, dy = y - ob.y;\n      if (Math.hypot(dx, dy) < ob.radius + radius + 30) { valid = false; break; }\n    }\n    if (valid) break;\n  }\n  if (!valid) { x = width / 2; y = height / 2; }\n  powerUps.push({ type, x, y, radius, pulse: 0 })\n}\nlet powerUpSpawnTimer = 0;\nconst POWERUP_SPAWN_BASE = 600; // 10 seconds at 60fps\n\n// Power-up effects\nlet timeDilationActive = false;\nlet timeDilationTimer = 0;\nconst DILATION_FACTOR = 0.5;\nconst DILATION_DURATION = 300; // 5 seconds\n\n// Flash effect\nlet flashTimer = 0;\nconst FLASH_DURATION = 0.2; // seconds\n\n// Audio\nconst audioCtx = new (window.AudioContext || window.webkitAudioContext)();\nfunction playSound(type) {\n  const oscillator = audioCtx.createOscillator();\n  const gain = audioCtx.createGain();\n  oscillator.connect(gain);\n  gain.connect(audioCtx.destination);\n  gain.gain.setValueAtTime(0, audioCtx.currentTime);\n  gain.gain.linearRampToValueAtTime(0.5, audioCtx.currentTime + 0.01);\n  gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 0.2);\n  switch (type) {\n    case 'collision':\n      oscillator.frequency.setValueAtTime(120, audioCtx.currentTime);\n      break;\n    case 'powerup':\n      oscillator.frequency.setValueAtTime(800, audioCtx.currentTime);\n      break;\n    case 'dash':\n      oscillator.frequency.setValueAtTime(1500, audioCtx.currentTime);\n      break;\n  }\n  oscillator.start();\n  oscillator.stop(audioCtx.currentTime + 0.2);\n}\n\n// Game loop\nlet lastTime = 0;\nfunction gameLoop(timestamp) {\n  const deltaTime = (timestamp - lastTime) / 1000; // seconds\n  lastTime = timestamp;\n  ctx.clearRect(0, 0, width, height);\n\n  // Update based on state\n  if (gameState === STATE_PLAYING) {\n    updatePlayer(deltaTime);\n    updateObstacles(deltaTime);\n    updatePowerUps(deltaTime);\n    updateTimer(deltaTime);\n    updateScore(deltaTime);\n    checkCollisions();\n    spawnObstacles(deltaTime);\n    spawnPowerUps(deltaTime);\n    updateFlash(deltaTime);\n  }\n\n  // Render\n  renderBackground();\n  renderPlayer();\n  renderObstacles();\n  renderPowerUps();\n  renderHUD();\n  if (flashTimer > 0) renderFlash();\n\n  // State screens\n  if (gameState === STATE_MENU) renderMenu();\n  else if (gameState === STATE_GAMEOVER) renderGameOver();\n  else if (gameState === STATE_VICTORY) renderVictory();\n  else if (gameState === STATE_PAUSED) renderPause();\n\n  requestAnimationFrame(gameLoop);\n}\nrequestAnimationFrame(gameLoop);\n\nfunction updatePlayer(dt) {\n  // Determine direction\n  let ax = 0, ay = 0;\n  if (keys.ArrowUp || keys.KeyW) ay -= 1;\n  if (keys.ArrowDown || keys.KeyS) ay += 1;\n  if (keys.ArrowLeft || keys.KeyA) ax -= 1;\n  if (keys.ArrowRight || keys.KeyD) ax += 1;\n  const len = Math.hypot(ax, ay);\n  if (len > 0) { ax /= len; ay /= len; }\n\n  // Acceleration\n  player.vx += ax * player.acceleration;\n  player.vy += ay * player.acceleration;\n\n  // Dash\n  if (keys.Space && player.dashCooldownTimer === 0) {\n    player.dashTimer = player.dashDuration;\n    player.dashCooldownTimer =