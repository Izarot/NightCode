ontainer\">\n                <div id=\"time-elapsed\">TIME: <span>00:00</span></div>\n                <div id=\"par-time\">PAR: <span>02:00</span></div>\n            </div>\n        </div>\n        <div id=\"speedrun-timer\">00:00.000</div>\n        <div id=\"high-score\">HIGH: <span>0</span></div>\n        <div id=\"overlay-start\" class=\"overlay active\">\n            <div class=\"overlay-content\">\n                <h1>VIRAL<span>.exe</span></h1>\n                <p class=\"subtitle\">NETWORK INFILTRATION SIMULATOR</p>\n                <div class=\"controls-info\">\n                    <p><span class=\"key\">WASD</span> / <span class=\"key\">ARROWS</span> Move</p>\n                    <p><span class=\"key\">SPACE</span> Pulse Burst</p>\n                    <p><span class=\"key\">ESC</span> Pause</p>\n                    <p><span class=\"key\">R</span> Restart</p>\n                </div>\n                <button id=\"start-btn\" class=\"cyber-btn\">INITIATE INFECTION</button>\n                <p class=\"warning\">⚠ FIREWALLS WILL HUNT YOU DOWN</p>\n            </div>\n        </div>\n        <div id=\"overlay-pause\" class=\"overlay\">\n            <div class=\"overlay-content\">\n                <h2>SYSTEM PAUSED</h2>\n                <button id=\"resume-btn\" class=\"cyber-btn\">RESUME</button>\n                <button id=\"restart-btn\" class=\"cyber-btn\">RESTART</button>\n            </div>\n        </div>\n        <div id=\"overlay-gameover\" class=\"overlay\">\n            <div class=\"overlay-content\">\n                <h2>INFECTION PURGED</h2>\n                <div class=\"stats\">\n                    <p>SCORE: <span id=\"go-score\">0</span></p>\n                    <p>TIME: <span id=\"go-time\">00:00</span></p>\n                </div>\n                <button id=\"retry-btn\" class=\"cyber-btn\">RETRY</button>\n            </div>\n        </div>\n        <div id=\"overlay-victory\" class=\"overlay\">\n            <div class=\"overlay-content\">\n                <h2>SECTOR COMPROMISED</h2>\n                <div class=\"stats\">\n                    <p>NODES CAPTURED: <span id=\"vic-nodes\">0</span></p>\n                    <p>FIREWALLS NEUTRALIZED: <span id=\"vic-firewalls\">0</span></p>\n                    <p>PULSE BURSTS USED: <span id=\"vic-pulses\">0</span></p>\n                    <p>TIME: <span id=\"vic-time\">00:00</span></p>\n                    <p>SCORE: <span id=\"vic-score\">0</span></p>\n                </div>\n                <button id=\"nextlevel-btn\" class=\"cyber-btn\">NEXT SECTOR</button>\n            </div>\n        </div>\n        <div id=\"node-prompt\" class=\"hidden\">\n            <span>[E] HACK</span>\n        </div>\n        <div id=\"firewall-alert\" class=\"hidden\">\n            <span>⚠ FIREWALL INBOUND</span>\n        </div>\n        <div id=\"level-transition\" class=\"hidden\">\n            <span>SECTOR COMPROMISED</span>\n        </div>\n    </div>\n    <script type=\"module\" src=\"js/main.js\"></script>\n</body>\n</html>", "css/styles.css": "@import url('https://fonts.googleapis.com/css2?family=Share+Tech+Mono&display=swap');\n\n* {\n    margin: 0;\n    padding: 0;\n    box-sizing: border-box;\n}\n\nbody {\n    background: #0A0A0F;\n    font-family: 'Share Tech Mono', monospace;\n    color: #00FFFF;\n    overflow: hidden;\n    width: 100vw;\n    height: 100vh;\n}\n\n#game-container {\n    position: relative;\n    width: 100%;\n    height: 100%;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n}\n\n#gameCanvas {\n    display: block;\n    background: #0A0A0F;\n    image-rendering: pixelated;\n}\n\n#crt-overlay {\n    position: absolute;\n    top: 0;\n    left: 0;\n    width: 100%;\n    height: 100%;\n    pointer-events: none;\n    background: repeating-linear-gradient(\n        0deg,\n        rgba(0, 0, 0, 0.1) 0px,\n        rgba(0, 0, 0, 0.1) 1px,\n        transparent 1px,\n        transparent 3px\n    );\n    z-index: 100;\n}\n\n#crt-overlay::after {\n    content: '';\n    position: absolute;\n    top: 0;\n    left: 0;\n    width: 100%;\n    height: 100%;\n    background: radial-gradient(ellipse at center, transparent 0%, rgba(0, 0, 0, 0.3) 100%);\n}\n\n#hud-top {\n    position: absolute;\n    top: 10px;\n    left: 10px;\n    right: 10px;\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    padding: 10px 20px;\n    background: rgba(10, 10, 15, 0.8);\n    border: 1px solid #00FFFF33;\n    border-radius: 4px;\n    z-index: 50;\n    font-size: 14px;\n}\n\n#level-indicator {\n    color: #FF00FF;\n    text-shadow: 0 0 10px #FF00FF;\n}\n\n#progress-container {\n    display: flex;\n    align-items: center;\n    gap: 10px;\n}\n\n#progress-bar {\n    width: 200px;\n    height: 16px;\n    background: #111122;\n    border: 1px solid #00FFFF44;\n    border-radius: 2px;\n    overflow: hidden;\n}\n\n#progress-fill {\n    height: 100%;\n    width: 0%;\n    background: linear-gradient(90deg, #00FFFF, #FF00FF);\n    box-shadow: 0 0 10px #00FFFF;\n    transition: width 0.3s ease;\n}\n\n#progress-label, #progress-percent {\n    color: #00FF88;\n}\n\n#score-display {\n    color: #FFAA00;\n    text-shadow: 0 0 10px #FFAA00;\n}\n\n#hud-bottom {\n    position: absolute;\n    bottom: 10px;\n    left: 10px;\n    right: 10px;\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    z-index: 50;\n}\n\n#ability-container {\n    background: rgba(10, 10, 15, 0.8);\n    border: 1px solid #00FFFF33;\n    border-radius: 4px;\n    padding: 10px;\n}\n\n#pulse-cooldown {\n    position: relative;\n    width: 60px;\n    height: 60px;\n}\n\n#pulse-cooldown svg {\n    transform: rotate(-90deg);\n    width: 100%;\n    height: 100%;\n}\n\n.cooldown-bg {\n    fill: none;\n    stroke: #111122;\n    stroke-width: 8;\n}\n\n.cooldown-fill {\n    fill: none;\n    stroke: #FF00FF;\n    stroke-width: 8;\n    stroke-linecap: round;\n    stroke-dasharray: 283;\n    stroke-dashoffset: 0;\n    transition: stroke-dashoffset 0.1s linear;\n    filter: drop-shadow(0 0 5px #FF00FF);\n}\n\n#pulse-label {\n    position: absolute;\n    top: 50%;\n    left: 50%;\n    transform: translate(-50%, -50%);\n    font-size: 10px;\n    color: #FF00FF;\n}\n\n#minimap-container {\n    background: rgba(10, 10, 15, 0.8);\n    border: 1px solid #00FFFF33;\n    border-radius: 4px;\n    padding: 5px;\n}\n\n#minimap {\n    display: block;\n    border-radius: 2px;\n}\n\n#timer-container {\n    background: rgba(10, 10, 15, 0.8);\n    border: 1px solid #00FFFF33;\n    border-radius: 4px;\n    padding: 10px 15px;\n    text-align: right;\n}\n\n#time-elapsed {\n    color: #00FFFF;\n    font-size: 16px;\n}\n\n#par-time {\n    color: #666666;\n    font-size: 12px;\n    margin-top: 5px;\n}\n\n#speedrun-timer {\n    position: absolute;\n    top: 60px;\n    right: 20px;\n    font-size: 24px;\n    color: #FFAA00;\n    text-shadow: 0 0 15px #FFAA00;\n    z-index: 51;\n    font-variant-numeric: tabular-nums;\n}\n\n#high-score {\n    position: absolute;\n    top: 90px;\n    right: 20px;\n    font-size: 14px;\n    color: #00FF88;\n    text-shadow: 0 0 10px #00FF88;\n    z-index: 51;\n}\n\n.overlay {\n    position: absolute;\n    top: 0;\n    left: 0;\n    width: 100%;\n    height: 100%;\n    background: rgba(10, 10, 15, 0.95);\n    display: none;\n    align-items: center;\n    justify-content: center;\n    z-index: 200;\n}\n\n.overlay.active {\n    display: flex;\n}\n\n.overlay-content {\n    text-align: center;\n    animation: glitchIn 0.5s ease-out;\n}\n\n@keyframes glitchIn {\n    0% { opacity: 0; transform: scale(0.9) translateX(-20px); }\n    25% { transform: scale(1.02) translateX(10px); }\n    50% { transform: scale(0.98) translateX(-5px); }\n    100% { opacity: 1; transform: scale(1) translateX(0); }\n}\n\n.overlay h1 {\n    font-size: 72px;\n    color: #00FFFF;\n    text-shadow: 0 0 30px #00FFFF, 4px 4px 0 #FF00FF, -4px -4px 0 #00FF88;\n    margin-bottom: 10px;\n    letter-spacing: 10px;\n}\n\n.overlay h1 span {\n    color: #FF00FF;\n}\n\n.overlay h2 {\n    font-size: 48px;\n    color: #FF3366;\n    text-shadow: 0 0 20px #FF3366;\n    margin-bottom: 30px;\n}\n\n.subtitle {\n    font-size: 14px;\n    color: #666666;\n    letter-spacing: 5px;\n    margin-bottom: 40px;\n}\n\n.controls-info {\n    margin: 30px 0;\n}\n\n.controls-info p {\n    margin: 10px 0;\n    color: #888888;\n}\n\n.key {\n    display: inline-block;\n    padding: 5px 10px;\n    background: #111122;\n    border: 1px solid #00FFFF44;\n    border-radius: 3px;\n    color: #00FFFF;\n    margin: 0 5px;\n}\n\n.cyber-btn {\n    display: inline-block;\n    padding: 15px 40px;\n    background: transparent;\n    border: 2px solid #00FFFF;\n    color: #00FFFF;\n    font-family: 'Share Tech Mono', monospace;\n    font-size: 18px;\n    cursor: pointer;\n    text-transform: uppercase;\n    letter-spacing: 3px;\n    transition: all 0.3s ease;\n    margin: 10px;\n}\n\n.cyber-btn:hover {\n    background: #00FFFF22;\n    box-shadow: 0 0 30px #00FFFF55, inset 0 0 30px #00FFFF22;\n    transform: scale(1.05);\n}\n\n.cyber-btn:active {\n    transform: scale(0.98);\n}\n\n.warning {\n    color: #FF3366;\n    font-size: 12px;\n    margin-top: 30px;\n    animation: blink 1s infinite;\n}\n\n@keyframes blink {\n    0%, 50%, 100% { opacity: 1; }\n    25%, 75% { opacity: 0.5; }\n}\n\n.stats {\n    margin: 30px 0;\n}\n\n.stats p {\n    font-size: 18px;\n    margin: 10px 0;\n    color: #888888;\n}\n\n.stats span {\n    color: #FFAA00;\n}\n\n#node-prompt {\n    position: absolute;\n    padding: 5px 10px;\n    background: rgba(0, 255, 136, 0.2);\n    border: 1px solid #00FF88;\n    border-radius: 3px;\n    font-size: 12px;\n    color: #00FF88;\n    pointer-events: none;\n    z-index: 60;\n    display: none;\n}\n\n#node-prompt.visible {\n    display: block;\n    animation: promptPulse 0.5s infinite;\n}\n\n@keyframes promptPulse {\n    0%, 100% { box-shadow: 0 0 5px #00FF88; }\n    50% { box-shadow: 0 0 15px #00FF88; }\n}\n\n#firewall-alert {\n    position: absolute;\n    top: 50%;\n    left: 0;\n    right: 0;\n    text-align: center;\n    font-size: 24px;\n    color: #FF3366;\n    text-shadow: 0 0 20px #FF3366;\n    pointer-events: none;\n    z-index: 60;\n    display: none;\n    animation: alertFlash 0.3s infinite;\n}\n\n#firewall-alert.visible {\n    display: block;\n}\n\n@keyframes alertFlash {\n    0%, 100% { opacity: 1; }\n    50% { opacity: 0.3; }\n}\n\n#level-transition {\n    position: absolute;\n    top: 0;\n    left: 0;\n    width: 100%;\n    height: 100%;\n    background: #0A0A0F;\n    display: none;\n    align-items: center;\n    justify-content: center;\n    z-index: 250;\n}\n\n#level-transition.visible {\n    display: flex;\n    animation: glitchTransition 2s ease-out;\n}\n\n@keyframes glitchTransition {\n    0% { opacity: 0; }\n    10% { opacity: 1; transform: translateX(-10px); }\n    20% { transform: translateX(10px); }\n    30% { transform: translateX(-5px); }\n    100% { opacity: 1; transform: translateX(0); }\n}\n\n#level-transition span {\n    font-size: 64px;\n    color: #00FF88;\n    text-shadow: 0 0 30px #00FF88, 3px 3px 0 #FF00FF, -3px -3px 0 #00FFFF;\n    letter-spacing: 10px;\n}\n\n@media (max-width: 768px) {\n    .overlay h1 {\n        font-size: 36px;\n    }\n    \n    .overlay h2 {\n        font-size: 28px;\n    }\n    \n    #hud-top {\n        flex-wrap: wrap;\n        font-size: 11px;\n        padding: 8px 10px;\n    }\n    \n    #progress-bar {\n        width: 100px;\n    }\n    \n    #speedrun-timer {\n        font-size: 16px;\n    }\n    \n    .cyber-btn {\n        padding: 10px 20px;\n        font-size: 14px;\n    }\n}", "js/main.js": "import { Game } from './Game.js';\n\nconst canvas = document.getElementById('gameCanvas');\nconst minimapCanvas = document.getElementById('minimap');\n\nconst game = new Game(canvas, minimapCanvas);\n\ngame.init();\n\nwindow.addEventListener('resize', () => game.resize());\n\ndocument.getElementById('start-btn').addEventListener('click', () => game.start());\ndocument.getElementById('resume-btn').addEventListener('click', () => game.resume());\ndocument.getElementById('restart-btn').addEventListener('click', () => game.restart());\ndocument.getElementById('retry-btn').addEventListener('click', () => game.restart());\ndocument.getElementById('nextlevel-btn').addEventListener('click', () => game.nextLevel());\n\ndocument.addEventListener('keydown', (e) => {\n    if (e.code === 'Escape') {\n        if (game.state === 'playing') game.pause();\n        else if (game.state === 'paused') game.resume();\n    }\n    if (e.code === 'KeyR' && (game.state === 'playing' || game.state === 'paused')) {\n        game.restart();\n    }\n});\n\nexport { game };", "js/Game.js": "import { InputManager } from './systems/Input.js';\nimport { Physics } from './systems/Physics.js';\nimport { Collision } from './systems/Collision.js';\nimport { AudioManager } from './systems/Audio.js';\nimport { ParticlePool } from './systems/ParticlePool.js';\nimport { Renderer } from './systems/Render.js';\nimport { Player } from './entities/Player.js';\nimport { NodeFactory } from './entities/NodeFactory.js';\nimport { FirewallBeam } from './entities/FirewallBeam.js';\nimport { LevelData } from './levels/LevelData.js';\nimport { HUD } from './ui/HUD.js';\nimport { Minimap } from './ui/Minimap.js';\nimport { Overlays } from './ui/Overlays.js';\n\nexport class Game {\n    constructor(canvas, minimapCanvas) {\n        this.canvas = canvas;\n        this.ctx = canvas.getContext('2d');\n        this.minimapCanvas = minimapCanvas;\n        this.minimapCtx = minimapCanvas.getContext('2d');\n        \n        this.width = 1280;\n        this.height = 720;\n        this.scale = 1;\n        \n        this.state = 'start';\n        this.currentLevel = 1;\n        this.score = 0;\n        this.highScore = parseInt(localStorage.getItem('viralHighScore')) || 0;\n        this.timeElapsed = 0;\n        this.totalTime = 0;\n        this.pulsesUsed = 0;\n        this.nodesCaptured = 0;\n        this.firewallsNeutralized = 0;\n        \n        this.lastTime = 0;\n        this.deltaTime = 0;\n        \n        this.input = new InputManager();\n        this.physics = new Physics();\n        this.collision = new Collision();\n        this.audio = new AudioManager();\n        this.particles = new ParticlePool(200);\n        this.renderer = new Renderer(this.ctx, this.width, this.height);\n        \n        this.player = null;\n        this.nodes = [];\n        this.firewallBeams = [];\n        this.connectionLines = [];\n        \n        this.hud = new HUD(this);\n        this.minimap = new Minimap(this.minimapCtx, this.minimapCanvas);\n        this.overlays = new Overlays(this);\n        \n        this.resize();\n    }\n    \n    init() {\n        this.audio.init();\n        this.updateHighScoreDisplay();\n        this.overlays.show('start');\n    }\n    \n    resize() {\n        const container = this.canvas.parentElement;\n        const containerWidth = container.clientWidth;\n        const containerHeight = container.clientHeight;\n        \n        const aspectRatio = this.width / this.height;\n        let newWidth, newHeight;\n        \n        if (containerWidth / containerHeight > aspectRatio) {\n            newHeight = containerHeight;\n            newWidth = newHeight * aspectRatio;\n        } else {\n            newWidth = containerWidth;\n            newHeight = newWidth / aspectRatio;\n        }\n        \n        this.scale = newWidth / this.width;\n        this.canvas.style.width = newWidth + 'px';\n        this.canvas.style.height = newHeight + 'px';\n        this.canvas.width = this.width;\n        this.canvas.height = this.height;\n    }\n    \n    start() {\n        this.state = 'playing';\n        this.currentLevel = 1;\n        this.score = 0;\n        this.totalTime = 0;\n        this.loadLevel(this.currentLevel);\n        this.overlays.hide('start');\n        this.audio.playMusic();\n        this.lastTime = performance.now();\n        this.gameLoop();\n    }\n    \n    pause() {\n        if (this.state === 'playing') {\n            this.state = 'paused';\n            this.overlays.show('pause');\n        }\n    }\n    \n    resume() {\n        if (this.state === 'paused') {\n            this.state = 'playing';\n            this.overlays.hide('pause');\n            this.lastTime = performance.now();\n            this.gameLoop();\n        }\n    }\n    \n    restart() {\n        this.overlays.hide('pause');\n        this.overlays.hide('gameover');\n        this.state = 'playing';\n        this.score = 0;\n        this.timeElapsed = 0;\n        this.totalTime = 0;\n        this.pulsesUsed = 0;\n        this.nodesCaptured = 0;\n        this.firewallsNeutralized = 0;\n        this.loadLevel(this.currentLevel);\n        this.lastTime = performance.now();\n        this.gameLoop();\n    }\n    \n    nextLevel() {\n        this.overlays.hide('victory');\n        this.currentLevel++;\n        if (this.currentLevel > 5) {\n            this.showFinalVictory();\n        } else {\n            this.showLevelTransition(() => {\n                this.state = 'playing';\n                this.timeElapsed = 0;\n                this.pulsesUsed = 0;\n                this.nodesCaptured = 0;\n                this.firewallsNeutralized = 0;\n                this.loadLevel(this.currentLevel);\n                this.lastTime = performance.now();\n                this.gameLoop();\n            });\n        }\n    }\n    \n    showLevelTransition(callback) {\n        const transition = document.getElementById('level-transition');\n        transition.classList.add('visible');\n        setTimeout(() => {\n            transition.classList.remove('visible');\n            callback();\n        }, 2000);\n    }\n    \n    showFinalVictory() {\n        this.state = 'start';\n        this.overlays.show('start');\n        alert('ALL SECTORS COMPROMISED! YOU ARE THE VIRUS.');\n    }\n    \n    loadLevel(levelNum) {\n        const levelData = LevelData[levelNum];\n        if (!levelData) return;\n        \n        this.nodes = [];\n        this.firewallBeams = [];\n        this.particles.clear();\n        \n        this.player = new Player(this.width / 2, this.height / 2, this);\n        \n        for (const nodeData of levelData.nodes) {\n            const node = NodeFactory.create(nodeData.type, nodeData.x, nodeData.y, this);\n            node.id = nodeData.id;\n            this.nodes.push(node);\n        }\n        \n        this.connectionLines = levelData.connections.map(c => ({\n            from: this.nodes.find(n => n.id === c[0]),\n            to: this.nodes.find(n => n.id === c[1])\n        }));\n        \n        this.timeElapsed = 0;\n    }\n    \n    gameLoop(currentTime = performance.now()) {\n        if (this.state !== 'playing') return;\n        \n        this.deltaTime = Math.min((currentTime - this.lastTime) / 1000, 0.1);\n        this.lastTime = currentTime;\n        \n        this.timeElapsed += this.deltaTime;\n        this.totalTime += this.deltaTime;\n        \n        this.update(this.deltaTime);\n        this.render();\n        \n        requestAnimationFrame((t) => this.gameLoop(t));\n    }\n    \n    update(dt) {\n        this.input.update();\n        this.player.update(dt, this.input);\n        \n        for (const node of this.nodes) {\n            node.update(dt, this.player);\n        }\n        \n        for (let i = this.firewallBeams.length - 1; i >= 0; i--) {\n            this.firewallBeams[i].update(dt);\n            if (this.firewallBeams[i].isExpired()) {\n                this.firewallBeams.splice(i, 1);\n            }\n        }\n        \n        for (const node of this.nodes) {\n            if (node.type === 'firewall' && !node.compromised && node.canFire()) {\n                this.firewallBeams.push(node.fireBeam());\n            }\n        }\n        \n        this.collision.checkPlayerNodeCollisions(this.player, this.nodes, this);\n        this.collision.checkFirewallBeamCollisions(this.player, this.firewallBeams, this);\n        \n        this.particles.update(dt);\n        \n        this.checkWinCondition();\n        this.checkLoseCondition();\n    }\n    \n    checkWinCondition() {\n        const serverNode = this.nodes.find(n => n.type === 'server');\n        if (serverNode && serverNode.compromised) {\n            const allCaptured = this.nodes.every(n => n.compromised);\n            if (allCaptured) {\n                this.victory();\n            }\n        }\n    }\n    \n    checkLoseCondition() {\n        if (this.player.damageTime >= 1.5) {\n            this.gameOver();\n        }\n    }\n    \n    victory() {\n        this.state = 'victory';\n        this.audio.playVictory();\n        \n        if (this.score > this.highScore) {\n            this.highScore = this.score;\n            localStorage.setItem('viralHighScore', this.highScore);\n            this.updateHighScoreDisplay();\n        }\n        \n        this.overlays.showVictory({\n            nodes: this.nodesCaptured,\n            firewalls: this.firewallsNeutralized,\n            pulses: this.pulsesUsed,\n            time: this.formatTime(this.timeElapsed),\n            score: this.score\n        });\n    }\n    \n    gameOver() {\n        this.state = 'gameover';\n        this.audio.playGameOver();\n        \n        this.overlays.showGameOver({\n            score: this.score,\n            time: this.formatTime(this.timeElapsed)\n        });\n    }\n    \n    addScore(points) {\n        this.score += points;\n    }\n    \n    formatTime(seconds) {\n        const mins = Math.floor(seconds / 60);\n        const secs = Math.floor(seconds % 60);\n        return `${mins.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}`;\n    }\n    \n    updateHighScoreDisplay() {\n        document.querySelector('#high-score span').textContent = this.highScore;\n    }\n    \n    render() {\n        this.ctx.save();\n        this.ctx.scale(this.scale, this.scale);\n        \n        this.renderer.renderBackground();\n        this.renderer.renderGrid();\n        this.renderer.renderConnections(this.connectionLines);\n        \n        for (const node of this.nodes) {\n            this.renderer.renderNode(node);\n        }\n        \n        for (const beam of this.firewallBeams) {\n            this.renderer.renderFirewallBeam(beam);
        }
        
        this.renderer.renderPlayer(this.player);
        this.particles.render(this.ctx);
        this.renderer.renderForeground();
        
        this.ctx.restore();
        
        this.hud.update();
        this.minimap.render(this);
    }
}