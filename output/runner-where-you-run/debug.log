m: translateX(-50%); gap: 10px; z-index: 20; }\n    .mobile-btn {\n      width: 70px; height: 70px;\n      border-radius: 50%;\n      background: rgba(0, 51, 68, 0.9);\n      border: 2px solid #00ffcc;\n      color: #00ffcc;\n      font-size: 28px;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      touch-action: manipulation;\n      -webkit-tap-highlight-color: transparent;\n    }\n    .mobile-btn:active { background: rgba(0, 255, 204, 0.5); }\n    @media (max-width: 768px) {\n      #mobileControls { display: flex; }\n      #score { font-size: 20px; }\n      #timer { font-size: 16px; }\n      #multiplier { font-size: 14px; }\n      #menuTitle { font-size: 32px; }\n    }\n    @keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.5; } }\n    .blink { animation: pulse 1s infinite; }\n  </style>\n</head>\n<body>\n  <canvas id=\"gameCanvas\"></canvas>\n  <div id=\"ui\">\n    <div id=\"score\" class=\"hud-element\">0</div>\n    <div id=\"timer\" class=\"hud-element\">00:00.000</div>\n    <div id=\"multiplier\" class=\"hud-element\">×1</div>\n    <div id=\"distance\" class=\"hud-element\">0m</div>\n    <div id=\"speedGauge\" class=\"hud-element\"><div id=\"speedFill\"></div></div>\n    <div id=\"comboPopup\" class=\"hud-element\">COMBO ×1</div>\n    <div id=\"powerupTimers\" class=\"hud-element\"></div>\n  </div>\n  <div id=\"menuOverlay\">\n    <div id=\"menuTitle\">GIANT KEYBOARD RUNNER</div>\n    <div id=\"menuSubtitle\">Navigate the infinite mechanical keyboard</div>\n    <div id=\"highScoreDisplay\">High Score: 0</div>\n    <button class=\"menu-btn\" id=\"startBtn\">START RUN</button>\n    <div id=\"controlsHint\">\n      <div>← → / A D : Move</div>\n      <div>↑ / W / SPACE : Jump (Double Jump)</div>\n      <div>Touch: Use on-screen buttons</div>\n    </div>\n  </div>\n  <div id=\"mobileControls\">\n    <button class=\"mobile-btn\" id=\"btnLeft\" aria-label=\"Left\">←</button>\n    <button class=\"mobile-btn\" id=\"btnJump\" aria-label=\"Jump\">↑</button>\n    <button class=\"mobile-btn\" id=\"btnRight\" aria-label=\"Right\">→</button>\n  </div>\n  <script>\n// ===== GAME CONFIG =====\nconst CONFIG = {\n  BASE_WIDTH: 1920,\n  BASE_HEIGHT: 1080,\n  PLAYER_WIDTH: 32,\n  PLAYER_HEIGHT: 48,\n  BASE_SPEED: 200,\n  MAX_SPEED: 350,\n  ACCEL_TIME: 2,\n  JUMP_FORCE: 600,\n  DOUBLE_JUMP_MULT: 0.75,\n  GRAVITY: 1800,\n  COYOTE_TIME: 0.15,\n  JUMP_BUFFER: 0.1,\n  KEY_DEPRESS: 8,\n  KEY_SPRING_TIME: 0.3,\n  KEY_LIGHT_RANGE: 100,\n  KEY_FADE_TIME: 0.5,\n  STICKY_SLOW: 0.7,\n  STICKY_DURATION: 2,\n  COMBO_MAX: 5,\n  COMBO_TIMEOUT: 1.5,\n  POWERUP_DURATION: 5,\n  GHOST_DURATION: 3,\n  MAGNET_RANGE: 80\n};\n\n// ===== COLOR PALETTE =====\nconst COLORS = {\n  bgDark: '#0a0f1a',\n  bgMid: '#0d1826',\n  bgLight: '#122036',\n  keyDark: '#1a1f2e',\n  keyMid: '#242b3e',\n  keyLight: '#2d3652',\n  keyHighlight: '#00ffff',\n  keyPressed: '#ff00aa',\n  keyActive: '#00ff88',\n  keyBroken: '#ff3344',\n  keySticky: '#ffaa00',\n  keyOverheat: '#ff4400',\n  playerPrimary: '#ff6600',\n  playerSecondary: '#ffcc00',\n  playerGlow: '#ff3300',\n  circuitDark: '#003322',\n  circuitMid: '#005533',\n  circuitLight: '#00aa66',\n  gearDark: '#2a2a3a',\n  gearLight: '#4a4a6a',\n  uiPrimary: '#00ffcc',\n  uiSecondary: '#ff3366',\n  uiAccent: '#ffcc00',\n  uiSuccess: '#88ff88',\n  uiWarning: '#ffaa00',\n  uiDanger: '#ff3344',\n  noteC: '#ff4444',\n  noteD: '#ff8844',\n  noteE: '#ffcc44',\n  noteF: '#88ff44',\n  noteG: '#44ff88',\n  noteA: '#44ccff',\n  noteB: '#8888ff',\n  noteC2: '#aa44ff'\n};\n\nconst NOTE_COLORS = [COLORS.noteC, COLORS.noteD, COLORS.noteE, COLORS.noteF, COLORS.noteG, COLORS.noteA, COLORS.noteB, COLORS.noteC2];\nconst NOTE_FREQS = [261.63, 293.66, 329.63, 349.23, 392.00, 440.00, 493.88, 523.25];\n\n// ===== AUDIO SYSTEM =====\nclass AudioEngine {\n  constructor() {\n    this.ctx = null;\n    this.masterGain = null;\n    this.sfxGain = null;\n    this.musicGain = null;\n    this.enabled = true;\n    this.init();\n  }\n  init() {\n    try {\n      this.ctx = new (window.AudioContext || window.webkitAudioContext)();\n      this.masterGain = this.ctx.createGain();\n      this.masterGain.connect(this.ctx.destination);\n      this.masterGain.gain.value = 0.5;\n      this.sfxGain = this.ctx.createGain();\n      this.sfxGain.connect(this.masterGain);\n      this.sfxGain.gain.value = 0.7;\n      this.musicGain = this.ctx.createGain();\n      this.musicGain.connect(this.masterGain);\n      this.musicGain.gain.value = 0.3;\n    } catch (e) { this.enabled = false; }\n  }\n  resume() { if (this.ctx && this.ctx.state === 'suspended') this.ctx.resume(); }\n  playTone(freq, duration, type='sine', gain=0.3, startTime=0) {\n    if (!this.enabled || !this.ctx) return;\n    const osc = this.ctx.createOscillator();\n    const g = this.ctx.createGain();\n    osc.connect(g);\n    g.connect(this.sfxGain);\n    osc.type = type;\n    osc.frequency.value = freq;\n    const t = this.ctx.currentTime + startTime;\n    g.gain.setValueAtTime(0, t);\n    g.gain.linearRampToValueAtTime(gain, t + 0.01);\n    g.gain.exponentialRampToValueAtTime(0.001, t + duration);\n    osc.start(t);\n    osc.stop(t + duration);\n  }\n  playNote(noteIndex, velocity=1) {\n    if (!this.enabled) return;\n    const freq = NOTE_FREQS[noteIndex % NOTE_FREQS.length];\n    this.playTone(freq, 0.15, 'triangle', 0.2 * velocity);\n    this.playTone(freq * 2, 0.1, 'sine', 0.1 * velocity, 0.01);\n  }\n  playJump() {\n    if (!this.enabled) return;\n    this.playTone(200, 0.05, 'square', 0.15);\n    this.playTone(400, 0.1, 'sine', 0.1, 0.05);\n  }\n  playLand() {\n    if (!this.enabled) return;\n    this.playTone(150, 0.08, 'sawtooth', 0.1);\n    this.playTone(80, 0.15, 'triangle', 0.15, 0.05);\n  }\n  playPowerup() {\n    if (!this.enabled) return;\n    for (let i = 0; i < 5; i++) {\n      this.playTone(400 + i * 100, 0.08, 'sine', 0.15, i * 0.05);\n    }\n  }\n  playCombo(combo) {\n    if (!this.enabled) return;\n    const freq = 400 + Math.min(combo, 5) * 100;\n    this.playTone(freq, 0.1, 'square', 0.2);\n    this.playTone(freq * 1.5, 0.1, 'sine', 0.15, 0.05);\n  }\n  playHazard() {\n    if (!this.enabled) return;\n    this.playTone(100, 0.2, 'sawtooth', 0.2);\n    this.playTone(60, 0.3, 'square', 0.15, 0.1);\n  }\n  setMusicVolume(v) { if (this.musicGain) this.musicGain.gain.value = v; }\n  setSfxVolume(v) { if (this.sfxGain) this.sfxGain.gain.value = v; }\n}\n\n// ===== PARTICLE SYSTEM =====\nclass ParticleSystem {\n  constructor() { this.particles = []; }\n  add(x, y, type, color, count=1) {\n    for (let i = 0; i < count; i++) {\n      this.particles.push(new Particle(x, y, type, color));\n    }\n  }\n  update(dt) {\n    for (let i = this.particles.length - 1; i >= 0; i--) {\n      this.particles[i].update(dt);\n      if (this.particles[i].dead) this.particles.splice(i, 1);\n    }\n  }\n  draw(ctx) {\n    for (const p of this.particles) p.draw(ctx);\n  }\n}\n\nclass Particle {\n  constructor(x, y, type, color) {\n    this.x = x; this.y = y; this.type = type; this.color = color;\n    this.life = 1; this.maxLife = 1; this.dead = false;\n    switch(type) {\n      case 'dust':\n        this.vx = (Math.random() - 0.5) * 200;\n        this.vy = -Math.random() * 100 - 50;\n        this.size = Math.random() * 3 + 2;\n        this.maxLife = 0.5;\n        this.gravity = 200;\n        break;\n      case 'note':\n        this.vx = (Math.random() - 0.5) * 50;\n        this.vy = -Math.random() * 80 - 40;\n        this.size = Math.random() * 8 + 8;\n        this.maxLife = 1;\n        this.gravity = -20;\n        this.noteChar = ['♪','♫','♬','♩'][Math.floor(Math.random()*4)];\n        break;\n      case 'spark':\n        const ang = Math.random() * Math.PI * 2;\n        const spd = Math.random() * 200 + 100;\n        this.vx = Math.cos(ang) * spd;\n        this.vy = Math.sin(ang) * spd;\n        this.size = Math.random() * 2 + 1;\n        this.maxLife = 0.4;\n        this.gravity = 0;\n        break;\n      case 'smoke':\n        this.vx = (Math.random() - 0.5) * 30;\n        this.vy = -Math.random() * 20 - 10;\n        this.size = Math.random() * 10 + 5;\n        this.maxLife = 1.5;\n        this.gravity = -10;\n        break;\n      case 'combo':\n        this.vx = (Math.random() - 0.5) * 100;\n        this.vy = -Math.random() * 150 - 100;\n        this.size = Math.random() * 20 + 20;\n        this.maxLife = 0.8;\n        this.gravity = -50;\n        this.text = `×${Math.floor(Math.random()*5)+2}`;\n        break;\n    }\n  }\n  update(dt) {\n    this.life -= dt / this.maxLife;\n    if (this.life <= 0) { this.dead = true; return; }\n    this.vy += this.gravity * dt;\n    this.x += this.vx * dt;\n    this.y += this.vy * dt;\n  }\n  draw(ctx) {\n    const alpha = this.life;\n    ctx.globalAlpha = alpha;\n    ctx.fillStyle = this.color;\n    switch(this.type) {\n      case 'dust':\n      case 'spark':\n      case 'smoke':\n        ctx.beginPath();\n        ctx.arc(this.x, this.y, this.size * this.life, 0, Math.PI * 2);\n        ctx.fill();\n        break;\n      case 'note':\n        ctx.font = `${this.size}px Arial`;\n        ctx.textAlign = 'center';\n        ctx.fillText(this.noteChar, this.x, this.y);\n        break;\n      case 'combo':\n        ctx.font = `bold ${this.size}px Courier New`;\n        ctx.textAlign = 'center';\n        ctx.fillText(this.text, this.x, this.y);\n        ctx.strokeStyle = '#000';\n        ctx.lineWidth = 2;\n        ctx.strokeText(this.text, this.x, this.y);\n        break;\n    }\n    ctx.globalAlpha = 1;\n  }\n}\n\n// ===== ENTITIES =====\nclass Player {\n  constructor(x, y) {\n    this.x = x; this.y = y;\n    this.w = CONFIG.PLAYER_WIDTH;\n    this.h = CONFIG.PLAYER_HEIGHT;\n    this.vx = 0; this.vy = 0;\n    this.onGround = false;\n    this.canDoubleJump = false;\n    this.coyoteTimer = 0;\n    this.jumpBufferTimer = 0;\n    this.facing = 1;\n    this.animFrame = 0;\n    this.animTimer = 0;\n    this.state = 'idle';\n    this.stickyTimer = 0;\n    this.ghostTimer = 0;\n    this.magnetTimer = 0;\n    this.turboTimer = 0;\n    this.sustainedTimer = 0;\n    this.trail = [];\n    this.invulnTimer = 0;\n  }\n  update(dt, input, keys) {\n    // Timers\n    if (this.coyoteTimer > 0) this.coyoteTimer -= dt;\n    if (this.jumpBufferTimer > 0) this.jumpBufferTimer -= dt;\n    if (this.stickyTimer > 0) this.stickyTimer -= dt;\n    if (this.ghostTimer > 0) this.ghostTimer -= dt;\n    if (this.magnetTimer > 0) this.magnetTimer -= dt;\n    if (this.turboTimer > 0) this.turboTimer -= dt;\n    if (this.sustainedTimer > 0) this.sustainedTimer -= dt;\n    if (this.invulnTimer > 0) this.invulnTimer -= dt;\n    \n    // Target speed\n    let targetSpeed = CONFIG.BASE_SPEED;\n    if (this.turboTimer > 0) targetSpeed = CONFIG.MAX_SPEED;\n    if (this.stickyTimer > 0) targetSpeed *= CONFIG.STICKY_SLOW;\n    \n    // Acceleration\n    const accel = targetSpeed / CONFIG.ACCEL_TIME;\n    if (this.vx < targetSpeed) {\n      this.vx = Math.min(targetSpeed, this.vx + accel * dt);\n    } else if (this.vx > targetSpeed) {\n      this.vx = Math.max(targetSpeed, this.vx - accel * dt * 2);\n    }\n    \n    // Horizontal input\n    if (input.left) this.facing = -1;\n    if (input.right) this.facing = 1;\n    \n    // Jump buffering\n    if (input.jumpPressed) this.jumpBufferTimer = CONFIG.JUMP_BUFFER;\n    \n    // Coyote time\n    if (this.onGround) this.coyoteTimer = CONFIG.COYOTE_TIME;\n    \n    // Jump logic\n    const canJump = this.onGround || this.coyoteTimer > 0;\n    const canDoubleJump = !this.onGround && this.canDoubleJump;\n    \n    if (this.jumpBufferTimer > 0 && (canJump || canDoubleJump)) {\n      this.jumpBufferTimer = 0;\n      if (canJump) {\n        this.vy = -CONFIG.JUMP_FORCE;\n        this.canDoubleJump = true;\n        audio.playJump();\n      } else if (canDoubleJump) {\n        this.vy = -CONFIG.JUMP_FORCE * CONFIG.DOUBLE_JUMP_MULT;\n        this.canDoubleJump = false;\n        audio.playJump();\n        particles.add(this.x + this.w/2, this.y + this.h, 'spark', COLORS.playerSecondary, 8);\n      }\n      this.onGround = false;\n    }\n    \n    // Gravity\n    this.vy += CONFIG.GRAVITY * dt;\n    this.y += this.vy * dt;\n    \n    // Animation\n    this.animTimer += dt;\n    if (this.onGround) {\n      if (this.vx > 10) {\n        if (this.animTimer > 0.08) { this.animFrame = (this.animFrame + 1) % 8; this.animTimer = 0; }\n        this.state = 'run';\n      } else { this.state = 'idle'; this.animFrame = 0; }\n    } else {\n      this.state = this.vy < 0 ? 'jump' : 'fall';\n      this.animFrame = this.vy < 0 ? 0 : 4;\n    }\n    \n    // Trail for turbo\n    if (this.turboTimer > 0) {\n      this.trail.unshift({x: this.x + this.w/2, y: this.y + this.h/2, life: 0.3});\n      if (this.trail.length > 10) this.trail.pop();\n    }\n    for (let i = this.trail.length - 1; i >= 0; i--) {\n      this.trail[i].life -= dt;\n      if (this.trail[i].life <= 0) this.trail.splice(i, 1);\n    }\n  }\n  draw(ctx) {\n    // Trail\n    for (const t of this.trail) {\n      ctx.globalAlpha = t.life / 0.3 * 0.5;\n      ctx.fillStyle = COLORS.playerSecondary;\n      ctx.beginPath();\n      ctx.arc(t.x, t.y, 8 * (t.life / 0.3), 0, Math.PI * 2);\n      ctx.fill();\n    }\n    ctx.globalAlpha = 1;\n    \n    // Ghost effect\n    if (this.ghostTimer > 0) ctx.globalAlpha = 0.5;\n    if (this.invulnTimer > 0 && Math.floor(Date.now() / 100) % 2 === 0) ctx.globalAlpha = 0.3;\n    \n    // Body\n    const cx = this.x + this.w/2;\n    const cy = this.y + this.h/2;\n    \n    // Glow\n    ctx.shadowColor = COLORS.playerGlow;\n    ctx.shadowBlur = this.turboTimer > 0 ? 20 : 10;\n    \n    // Legs animation\n    const legOffset = this.state === 'run' ? Math.sin(this.animFrame * Math.PI / 4) * 4 : 0;\n    \n    // Body\n    ctx.fillStyle = COLORS.playerPrimary;\n    ctx.fillRect(this.x + 6, this.y + 4, 20, 32);\n    \n    // Head\n    ctx.fillStyle = COLORS.playerSecondary;\n    ctx.fillRect(this.x + 8, this.y, 16, 16);\n    \n    // Eyes\n    ctx.fillStyle = '#fff';\n    ctx.fillRect(this.x + 12 + this.facing * 2, this.y + 4, 4, 4);\n    ctx.fillRect(this.x + 18 + this.facing * 2, this.y + 4, 4, 4);\n    \n    // Legs\n    ctx.fillStyle = COLORS.playerPrimary;\n    ctx.fillRect(this.x + 8, this.y + 36 + legOffset, 6, 12);\n    ctx.fillRect(this.x + 18, this.y + 36 - legOffset, 6, 12);\n    \n    // Arms\n    ctx.fillRect(this.x + 2, this.y + 10 - legOffset, 6, 14);\n    ctx.fillRect(this.x + 24, this.y + 10 + legOffset, 6, 14);\n    \n    // Turbo indicator\n    if (this.turboTimer > 0) {\n      ctx.fillStyle = COLORS.uiAccent;\n      ctx.font = 'bold 12px Courier New';\n      ctx.textAlign = 'center';\n      ctx.fillText('TURBO', cx, this.y - 10);\n    }\n    \n    ctx.shadowBlur = 0;\n    ctx.globalAlpha = 1;\n  }\n  getBounds() { return { x: this.x, y: this.y, w: this.w, h: this.h }; }\n}\n\nclass Key {\n  constructor(x, y, w, h, noteIndex, type='normal') {\n    this.x = x; this.y = y; this.baseY = y;\n    this.w = w; this.h = h;\n    this.noteIndex = noteIndex;\n    this.type = type; // normal, sticky, broken, overheat, moving\n    this.depressed = 0;\n    this.depressTarget = 0;\n    this.lightIntensity = 0;\n    this.lightTarget = 0;\n    this.active = false;\n    this.broken = type === 'broken';\n    this.overheatTimer = 0;\n    this.movePhase = Math.random() * Math.PI * 2;\n    this.moveRange = type === 'moving' ? 60 : 0;\n    this.moveSpeed = type === 'moving' ? 1 + Math.random() : 0;\n    this.color = NOTE_COLORS[noteIndex % NOTE_COLORS.length];\n    this.hitThisRun = false;\n  }\n  update(dt, playerX) {\n    // Depression spring\n    this.depressed += (this.depressTarget - this.depressed) * (1 - Math.exp(-dt * 10));\n    if (this.depressTarget > 0) this.depressTarget = Math.max(0, this.depressTarget - dt / CONFIG.KEY_SPRING_TIME);\n    \this.depressTarget = Math.max(0, this.depressTarget - dt / CONFIG.KEY_SPRING_TIME);\n    \n    // Light intensity\n    this.lightIntensity += (this.lightTarget - this.lightIntensity) * (1 - Math.exp(-dt * 8));\n    if (this.lightTarget > 0) this.lightTarget = Math.max(0, this.lightTarget - dt / CONFIG.KEY_FADE_TIME);\n    \n    // Overheat\n    if (this.type === 'overheat' && this.overheatTimer > 0) {\n      this.overheatTimer -= dt;\n      if (this.overheatTimer <= 0) this.type = 'broken';\n    }\n    \n    // Moving keys\n    if (this.type === 'moving') {\n      this.movePhase += dt * this.moveSpeed;\n      this.x += Math.sin(this.movePhase) * 30 * dt;\n    }\n    \n    // Magnet attraction\n    if (game.player.magnetTimer > 0 && !this.hitThisRun) {\n      const dx = (playerX + game.player.w/2) - (this.x + this.w/2);\n      const dy = (game.player.y + game.player.h/2) - (this.y + this.h/2);\n      const dist = Math.sqrt(dx*dx + dy*dy);\n      if (dist < CONFIG.MAGNET_RANGE) {\n        this.lightTarget = Math.max(this.lightTarget, 0.5);\n      }\n    }\n  }\n  depress(force=1) {\n    this.depressTarget = Math.min(CONFIG.KEY_DEPRESS, this.depressTarget + force * 4);\n    this.lightTarget = 1;\n  }\n  draw(ctx) {\n    const drawY = this.y + this.depressed;\n    const isPressed = this.depressed > 1;\n    \n    // Key shadow\n    ctx.fillStyle = 'rgba(0,0,0,0.4)';\n    ctx.fillRect(this.x + 2, drawY + this.h + 2, this.w, 4);\n    \n    // Key base\n    let baseColor = this.color;\n    if (this.type === 'sticky') baseColor = COLORS.keySticky;\n    else if (this.type === 'broken') baseColor = COLORS.keyBroken;\n    else if (this.type === 'overheat') baseColor = COLORS.keyOverheat;\n    else if (this.type === 'moving') baseColor = COLORS.keyActive;\n    \n    // Dark base\n    ctx.fillStyle = COLORS.keyDark;\n    ctx.fillRect(this.x, drawY, this.w, this.h);\n    \n    // Key top\n    const grad = ctx.createLinearGradient(this.x, drawY, this.x, drawY + this.h);\n    grad.addColorStop(0, this.lightIntensity > 0.5 ? '#fff' : (isPressed ? COLORS.keyPressed : baseColor));\n    grad.addColorStop(0.5, this.lightIntensity > 0.3 ? baseColor : COLORS.keyMid);\n    grad.addColorStop(1, COLORS.keyDark);\n    ctx.fillStyle = grad;\n    ctx.fillRect(this.x + 1, drawY + 1, this.w - 2, this.h - 2);\n    \n    // Highlight edge\n    if (this.lightIntensity > 0) {\n      ctx.strokeStyle = `rgba(255,255,255,${this.lightIntensity * 0.8})`;\n      ctx.lineWidth = 2;\n      ctx.strokeRect(this.x + 1, drawY + 1, this.w - 2, this.h - 2);\n    }\n    \n    // Pressed indicator\n    if (isPressed) {\n      ctx.fillStyle = COLORS.keyPressed;\n      ctx.fillRect(this.x + 4, drawY + this.h - 6, this.w - 8, 4);\n    }\n    \n    // Type indicators\n    if (this.type === 'sticky') {\n      ctx.fillStyle = COLORS.keySticky;\n      ctx.font = '10px Courier New';\n      ctx.textAlign = 'center';\n      ctx.fillText('◆', this.x + this.w/2, drawY + 12);\n    } else if (this.type === 'broken') {\n      ctx.strokeStyle = COLORS.keyBroken;\n      ctx.lineWidth = 2;\n      ctx.beginPath();\n      ctx.moveTo(this.x + 4, drawY + 4);\n      ctx.lineTo(this.x + this.w - 4, drawY + this.h - 4);\n      ctx.moveTo(this.x + this.w - 4, drawY + 4);\n      ctx.lineTo(this.x + 4, drawY + this.h - 4);\n      ctx.stroke();\n    } else if (this.type === 'overheat') {\n      ctx.fillStyle = COLORS.keyOverheat;\n      ctx.font = '12px Courier New';\n      ctx.textAlign = 'center';\n      ctx.fillText('⚠', this.x + this.w/2, drawY + 14);\n    } else if (this.type === 'moving') {\n      ctx.strokeStyle = COLORS.keyActive;\n      ctx.lineWidth = 1;\n      ctx.setLineDash([4, 4]);\n      ctx.strokeRect(this.x, drawY, this.w, this.h);\n      ctx.setLineDash([]);\n    }\n    \n    // Note label\n    const noteNames = ['C','D','E','F','G','A','B','C'];\n    ctx.fillStyle = '#fff';\n    ctx.font = 'bold 11px Courier New';\n    ctx.textAlign = 'center';\n    ctx.fillText(noteNames[this.noteIndex % 8], this.x + this.w/2, drawY + this.h - 4);\n  }\n  getBounds() { return { x: this.x, y: this.y + this.depressed, w: this.w, h: this.h }; }\n}\n\nclass Powerup {\n  constructor(x, y, type) {\n    this.x = x; this.y = y;\n    this.w = 24; this.h = 24;\n    this.type = type; // turbo, ghost, magnet, sustained\n    this.collected = false;\n    this.bobPhase = Math.random() * Math.PI * 2;\n    this.color = type === 'turbo' ? COLORS.uiAccent : type === 'ghost' ? COLORS.uiSecondary : type === 'magnet' ? COLORS.uiSuccess : COLORS.uiWarning;\n    this.symbol = type === 'turbo' ? '⚡' : type === 'ghost' ? '👻' : type === 'magnet' ? '🧲' : '♪';\n  }\n  update(dt) {\n    this.bobPhase += dt * 3;\n    this.y += Math.sin(this.bobPhase) * 0.5;\n  }\n  draw(ctx) {\n    ctx.save();\n    ctx.translate(this.x + this.w/2, this.y + this.h/2);\n    ctx.rotate(this.bobPhase * 0.5);\n    \n    // Glow\n    ctx.shadowColor = this.color;\n    ctx.shadowBlur = 15;\n    \n    // Background\n    const grad = ctx.createRadialGradient(0, 0, 0, 0, 0, 14);\n    grad.addColorStop(0, this.color);\n    grad.addColorStop(1, 'transparent');\n    ctx.fillStyle = grad;\n    ctx.beginPath();\n    ctx.arc(0, 0, 14, 0, Math.PI * 2);\n    ctx.fill();\n    \n    // Symbol\n    ctx.font = '18px Arial';\n    ctx.textAlign = 'center';\n    ctx.textBaseline = 'middle';\n    ctx.fillStyle = '#fff';\n    ctx.fillText(this.symbol, 0, 0);\n    \n    ctx.restore();\n  }\n  getBounds() { return { x: this.x, y: this.y, w: this.w, h: this.h }; }\n}\n\n// ===== LEVEL GENERATION =====\nclass LevelGenerator {\n  constructor() {\n    this.keys = [];\n    this.powerups = [];\n    this.distance = 0;\n    this.lastKeyX = 0;\n    this.lastKeyY = 0;\n    this.section = 0;\n    this.difficulty = 1;\n    this.noteSequence = [];\n    this.generateInitial();\n  }\n  generateInitial() {\n    // Starting platform\n    for (let i = 0; i < 10; i++) {\n      this.addKey(i * 64, CONFIG.BASE_HEIGHT - 100, 'normal');\n    }\n    this.lastKeyX = 9 * 64;\n    this.lastKeyY = CONFIG.BASE_HEIGHT - 100;\n    this.generateSection();\n  }\n  generateSection() {\n    this.section++;\n    this.difficulty = Math.min(5, 1 + this.section * 0.3);\n    \n    const sectionLength = 30 + Math.floor(this.difficulty * 5);\n    let x = this.lastKeyX;\n    let y = this.lastKeyY;\n    \n    for (let i = 0; i < sectionLength; i++) {\n      const gap = 40 + Math.random() * 80 * this.difficulty;\n      x += gap;\n      \n      // Vertical variation\n      const maxJumpHeight = (CONFIG.JUMP_FORCE * CONFIG.JUMP_FORCE) / (2 * CONFIG.GRAVITY);\n      const maxDrop = maxJumpHeight * 1.5;\n      y += (Math.random() - 0.5) * 120 * this.difficulty;\n      y = Math.max(100, Math.min(CONFIG.BASE_HEIGHT - 100, y));\n      \n      // Key type based on difficulty\n      let type = 'normal';\n      const rand = Math.random();\n      if (rand < 0.05 * this.difficulty) type = 'sticky';\n      else if (rand < 0.08 * this.difficulty) type = 'broken';\n      else if (rand < 0.1 * this.difficulty) type = 'overheat';\n      else if (rand < 0.12 * this.difficulty) type = 'moving';\n      \n      this.addKey(x, y, type);\n      \n      // Powerup chance\n      if (Math.random() < 0.02 * this.difficulty) {\n        const types = ['turbo', 'ghost', 'magnet', 'sustained'];\n        this.powerups.push(new Powerup(x + 20, y - 40, types[Math.floor(Math.random() * types.length)]));\n      }\n    }\n    this.lastKeyX = x;\n    this.lastKeyY = y;\n  }\n  addKey(x, y, type) {\n    const noteIndex = Math.floor(Math.random() * 8);\n    const w = 52;\n    const h = 24;\n    this.keys.push(new Key(x, y, w, h, noteIndex, type));\n    this.noteSequence.push(noteIndex);\n    if (this.noteSequence.length > 100) this.noteSequence.shift();\n  }\n  update(dt, playerX) {\n    // Remove off-screen keys\n    const removeX = playerX - 200;\n    while (this.keys.length > 0 && this.keys[0].x + this.keys[0].w < removeX) {\n      this.keys.shift();\n    }\n    while (this.powerups.length > 0 && this.powerups[0].x + this.powerups[0].w < removeX) {\n      this.powerups.shift();\n    }\n    \n    // Update keys\n    for (const key of this.keys) key.update(dt, playerX);\n    for (const pu of this.powerups) pu.update(dt);\n    \n    // Generate more if needed\n    if (this.lastKeyX - playerX < CONFIG.BASE_WIDTH * 1.5) {\n      this.generateSection();\n    }\n  }\n  draw(ctx) {\n    for (const key of this.keys) key.draw(ctx);\n    for (const pu of this.powerups) pu.draw(ctx);\n  }\n  checkCollisions(player) {\n    const pBounds = player.getBounds();\n    let hitKey = null;\n    \n    for (const key of this.keys) {\n      if (key.broken) continue;\n      const kBounds = key.getBounds();\n      if (this.aabb(pBounds, kBounds)) {\n        // Landing on top\n        if (player.vy > 0 && pBounds.y + pBounds.h - player.vy * 0.016 <= kBounds.y + 5) {\n          player.y = kBounds.y - pBounds.h;\n          player.vy = 0;\n          player.onGround = true;\n          player.canDoubleJump = true;\n          \n          if (!key.hitThisRun) {\n            hitKey = key;\n            key.hitThisRun = true;\n            key.depress();\n          }\n          \n          // Sticky key effect\n          if (key.type === 'sticky' && player.stickyTimer <= 0) {\n            player.stickyTimer = CONFIG.STICKY_DURATION;\n            audio.playHazard();\n            particles.add(player.x + player.w/2, player.y, 'spark', COLORS.keySticky, 10);\n          }\n          \n          // Overheat key\n          if (key.type === 'overheat') {\n            key.overheatTimer = 3;\n          }\n          \n          // Broken key crumbles\n          if (key.type === 'broken') {\n            key.broken = true;\n            audio.playHazard();\n            particles.add(key.x + key.w/2, key.y, 'spark', COLORS.keyBroken, 15);\n            particles.add(key.x + key.w/2, key.y, 'smoke', '#888', 5);\n          }\n          \n          // Dust particles\n          particles.add(player.x + player.w/2, player.y + player.h, 'dust', COLORS.uiPrimary, 3);\n          audio.playLand();\n        }\n      }\n    }\n    \n    // Powerup collection\n    for (const pu of this.powerups) {\n      if (!pu.collected && this.aabb(pBounds, pu.getBounds())) {\n        pu.collected = true;\n        this.applyPowerup(player, pu.type);\n        audio.playPowerup();\n        particles.add(pu.x + pu.w/2, pu.y + pu.h/2, 'spark', pu.color, 12);\n        particles.add(pu.x + pu.w/2, pu.y + pu.h/2, 'note', pu.color, 5);\n      }\n    }\n    this.powerups = this.powerups.filter(pu => !pu.collected);\n    \n    return hitKey;\n  }\n  applyPowerup(player, type) {\n    switch(type) {\n      case 'turbo': player.turboTimer = CONFIG.POWERUP_DURATION; break;\n      case 'ghost': player.ghostTimer = CONFIG.GHOST_DURATION; break;\n      case 'magnet': player.magnetTimer = CONFIG.POWERUP_DURATION; break;\n      case 'sustained': player.sustainedTimer = CONFIG.POWERUP_DURATION; break;\n    }\n  }\n  aabb(a, b) {\n    return a.x < b.x + b.w && a.x + a.w > b.x && a.y < b.y + b.h && a.y + a.h > b.y;\n  }\n}\n\n// ===== BACKGROUND =====\nclass Background {\n  constructor() {\n    this.layers = [];\n    this.circuits = [];\n    this.gears = [];\n    this.time = 0;\n    this.init();\n  }\n  init() {\n    // Parallax layers\n    for (let i = 0; i < 4; i++) {\n      this.layers.push({ y: Math.random() * CONFIG.BASE_HEIGHT, speed: 20 + i * 30, offset: Math.random() * 1000 });\n    }\n    // Circuit lines\n    for (let i = 0; i < 30; i++) {\n      this.circuits.push({\n        x: Math.random() * CONFIG.BASE_WIDTH,\n        y: Math.random() * CONFIG.BASE_HEIGHT,\n        length: 50 + Math.random() * 200,\n        angle: Math.random() * Math.PI * 2,\n        speed: 10 + Math.random() * 20,\n        phase: Math.random() * Math.PI * 2,\n        color: [COLORS.circuitDark, COLORS.circuitMid, COLORS.circuitLight][Math.floor(Math.random() * 3)]\n      });\n    }\n    // Gears\n    for (let i = 0; i < 8; i++) {\n      this.gears.push({\n        x: Math.random() * CONFIG.BASE_WIDTH,\n        y: Math.random() * CONFIG.BASE_HEIGHT,\n        radius: 20 + Math.random() * 60,\n        speed: (Math.random() - 0.5) * 0.5,\n        teeth: 6 + Math.floor(Math.random() * 6),\n        phase: Math.random() * Math.PI * 2\n      });\n    }\n  }\n  update(dt, scrollX) {\n    this.time += dt;\n    for (const layer of this.layers) {\n      layer.y += layer.speed * dt;\n      if (layer.y > CONFIG.BASE_HEIGHT) layer.y -= CONFIG.BASE_HEIGHT;\n    }\n    for (const c of this.circuits) {\n      c.phase += dt * c.speed * 0.01;\n    }\n    for (const g of this.gears) {\n      g.phase += dt * g.speed;\n    }\n  }\n  draw(ctx, scrollX) {\n    // Base gradient\n    const grad = ctx.createLinearGradient(0, 0, 0, CONFIG.BASE_HEIGHT);\n    grad.addColorStop(0, COLORS.bgDark);\n    grad.addColorStop(0.5, COLORS.bgMid);\n    grad.addColorStop(1, COLORS.bgLight);\n    ctx.fillStyle = grad;\n    ctx.fillRect(0, 0, CONFIG.BASE_WIDTH, CONFIG.BASE_HEIGHT);\n    \n    // Parallax layers\n    for (const layer of this.layers) {\n      ctx.fillStyle = `rgba(0, 255, 204, ${0.02 + layer.speed * 0.0001})`;\n      for (let x = -layer.offset; x < CONFIG.BASE_WIDTH; x += 100) {\n        const ly = (layer.y + x * 0.1) % CONFIG.BASE_HEIGHT;\n        ctx.fillRect(x - scrollX * (layer.speed / 200), ly, 1, 1);\n        ctx.fillRect(x - scrollX * (layer.speed / 200), ly + CONFIG.BASE_HEIGHT, 1, 1);\n      }\n    }\n    \n    // Circuit lines\n    for (const c of this.circuits) {\n      const alpha = 0.1 + Math.sin(c.phase) * 0.05;\n      ctx.strokeStyle = c.color.replace(')', `, ${alpha})`).replace('rgb', 'rgba');\n      ctx.lineWidth = 1;\n      ctx.beginPath();\n      const cx = c.x - scrollX * 0.3;\n      const cy = c.y;\n      ctx.moveTo(cx, cy);\n      ctx.lineTo(cx + Math.cos(c.angle) * c.length, cy + Math.sin(c.angle) * c.length);\n      ctx.stroke();\n      \n      // Nodes\n      ctx.fillStyle = c.color.replace(')', `, ${alpha * 2})`).replace('rgb', 'rgba');\n      ctx.beginPath();\n      ctx.arc(cx, cy, 2, 0, Math.PI * 2);\n      ctx.fill();\n    }\n    \n    // Gears\n    for (const g of this.gears) {\n      const gx = g.x - scrollX * 0.5;\n      const gy = g.y;\n      ctx.strokeStyle = COLORS.gearDark;\n      ctx.lineWidth = 2;\n      ctx.beginPath();\n      ctx.arc(gx, gy, g.radius, 0, Math.PI * 2);\n      ctx.stroke();\n      \n      ctx.fillStyle = COLORS.gearLight;\n      for (let t = 0; t < g.teeth; t++) {\n        const ang = g.phase + (t / g.teeth) * Math.PI * 2;\n        const ix = gx + Math.cos(ang) * (g.radius - 5);\n        const iy = gy + Math.sin(ang) * (g.radius - 5);\n        const ox = gx + Math.cos(ang) * (g.radius + 5);\n        const oy = gy + Math.sin(ang) * (g.radius + 5);\n        ctx.beginPath();\n        ctx.moveTo(ix, iy);\n        ctx.lineTo(ox, oy);\n        ctx.stroke();\n      }\n      ctx.beginPath();\n      ctx.arc(gx, gy, 8, 0, Math.PI * 2);\n      ctx.fill();\n    }\n  }\n}\n\n// ===== MAIN GAME =====\nclass Game {\n  constructor() {\n    this.canvas = document.getElementById('gameCanvas');\n    this.ctx = this.canvas.getContext('2d');\n    this.running = false;\n    this.lastTime = 0;\n    this.scrollX = 0;\n    \n    this.player = new Player(100, CONFIG.BASE_HEIGHT - 200);\n    this.level = new LevelGenerator();\n    this.background = new Background();\n    \n    this.score = 0;\n    this.distance = 0;\n    this.combo = 1;\n    this.comboTimer = 0;\n    this.maxCombo = 1;\n    this.startTime = 0;\n    \n    this.input = { left: false, right: false, jumpPressed: false };\n    this.keysPressed = {};\n    \n    this.highScore = parseInt(localStorage.getItem('gkr_highscore') || '0');\n    \n    this.setupInput();\n    this.resize();\n    window.addEventListener('resize', () => this.resize());\n  }\n  setupInput() {\n    window.addEventListener('keydown', (e) => {\n      this.keysPressed[e.code] = true;\n      if (['ArrowLeft', 'KeyA'].includes(e.code)) this.input.left = true;\n      if (['ArrowRight', 'KeyD'].includes(e.code)) this.input.right = true;\n      if (['ArrowUp', 'KeyW', 'Space'].includes(e.code)) {\n        this.input.jumpPressed = true;\n        e.preventDefault();\n      }\n    });\n    window.addEventListener('keyup', (e) => {\n      this.keysPressed[e.code] = false;\n      if (['ArrowLeft', 'KeyA'].includes(e.code)) this.input.left = false;\n      if (['ArrowRight', 'KeyD'].includes(e.code)) this.input.right = false;\n      if (['ArrowUp', 'KeyW', 'Space'].includes(e.code)) this.input.jumpPressed = false;\n    });\n    \n    // Mobile buttons\n    const btnLeft = document.getElementById('btnLeft');\n    const btnRight = document.getElementById('btnRight');\n    const btnJump = document.getElementById('btnJump');\n    \n    const setTouch = (btn, prop, val) => {\n      btn.addEventListener('touchstart', e => { e.preventDefault(); this.input[prop] = val; }, { passive: false });\n      btn.addEventListener('touchend', e => { e.preventDefault(); this.input[prop] = false; }, { passive: false });\n      btn.addEventListener('mousedown', e => { e.preventDefault(); this.input[prop] = val; });\n      btn.addEventListener('mouseup', e => { this.input[prop] = false; });\n      btn.addEventListener('mouseleave', e => { this.input[prop] = false; });\n    };\n    setTouch(btnLeft, 'left', true);\n    setTouch(btnRight, 'right', true);\n    setTouch(btnJump, 'jumpPressed', true);\n    \n    // Menu button\n    document.getElementById('startBtn').addEventListener('click', () => this.start());\n  }\n  resize() {\n    const scale = Math.min(window.innerWidth / CONFIG.BASE_WIDTH, window.innerHeight / CONFIG.BASE_HEIGHT);\n    this.canvas.width = CONFIG.BASE_WIDTH * scale;\n    this.canvas.height = CONFIG.BASE_HEIGHT * scale;\n    this.canvas.style.width = `${CONFIG.BASE_WIDTH * scale}px`;\n    this.canvas.style.height = `${CONFIG.BASE_HEIGHT * scale}px`;\n    this.scale = scale;\n  }\n  start() {\n    this.running = true;\n    this.score = 0;\n    this.distance = 0;\n    this.combo = 1;\n    this.comboTimer = 0;\n    this.maxCombo = 1;\n    this.startTime = performance.now() / 1000;\n    this.scrollX = 0;\n    \n    this.player = new Player(100, CONFIG.BASE_HEIGHT - 200);\n    this.level = new LevelGenerator();\n    this.background = new Background();\n    particles.particles = [];\n    \n    document.getElementById('menuOverlay').classList.add('hidden');\n    document.getElementById('highScoreDisplay').textContent = `High Score: ${this.highScore}`;\n    audio.resume();\n    requestAnimationFrame(t => this.loop(t));\n  }\n  loop(time) {\n    if (!this.running) return;\n    const dt = Math.min((time - this.lastTime) / 1000, 0.1);\n    this.lastTime = time;\n    \n    this.update(dt);\n    this.draw();\n    \n    requestAnimationFrame(t => this.loop(t));\n  }\n  update(dt) {\n    // Update player\n    this.player.update(dt, this.input, this.keysPressed);\n    \n    // Scroll world\n    this.scrollX = this.player.x - CONFIG.BASE_WIDTH * 0.2;\n    \n    // Update level\n    this.level.update(dt, this.player.x);\n    \n    // Check collisions\n    const hitKey = this.level.checkCollisions(this.player);\n    \n    // Handle key hit\n    if (hitKey) {\n      this.handleKeyHit(hitKey);\n    }\n    \n    // Combo timeout\n    if (this.comboTimer > 0) {\n      this.comboTimer -= dt;\n      if (this.comboTimer <= 0) {\n        this.combo = 1;\n        document.getElementById('comboPopup').classList.remove('show');\n      }\n    }\n    \n    // Distance & score\n    this.distance = Math.max(this.distance, Math.floor(this.player.x / 10));\n    this.score += Math.floor(this.player.vx * dt * this.combo * 0.1);\n    \n    // Death check\n    if (this.player.y > CONFIG.BASE_HEIGHT + 100) {\n      this.gameOver();\n    }\n    \n    // Update background\n    this.background.update(dt, this.scrollX);\n    \n    // Update particles\n    particles.update(dt);\n    \n    // Update UI\n    this.updateUI();\n  }\n  handleKeyHit(key) {\n    // Score\n    const basePoints = 10;\n    const points = basePoints * this.combo;\n    this.score += points;\n    \n    // Combo\n    this.combo = Math.min(CONFIG.COMBO_MAX, this.combo + 1);\n    this.comboTimer = CONFIG.COMBO_TIMEOUT;\n    this.maxCombo = Math.max(this.maxCombo, this.combo);\n    \n    // Visual feedback\n    particles.add(key.x + key.w/2, key.y, 'note', key.color, 3);\n    particles.add(key.x + key.w/2, key.y, 'combo', COLORS.uiAccent, 1);\n    audio.playNote(key.noteIndex, 0.5 + this.combo * 0.1);\n    audio.playCombo(this.combo);\n    \n    // Show combo popup\n    if (this.combo > 1) {\n      const popup = document.getElementById('comboPopup');\n      popup.textContent = `COMBO ×${this.combo}`;\n      popup.classList.add('show');\n      setTimeout(() => popup.classList.remove('show'), 300);\n    }\n    \n    // Sustained powerup extends combo\n    if (this.player.sustainedTimer > 0) {\n      this.comboTimer = CONFIG.COMBO_TIMEOUT;\n    }\n  }\n  updateUI() {\n    document.getElementById('score').textContent = this.score.toLocaleString();\n    \n    const elapsed = performance.now() / 1000 - this.startTime;\n    const min = Math.floor(elapsed / 60).toString().padStart(2, '0');\n    const sec = Math.floor(elapsed % 60).toString().padStart(2, '0');\n    const ms = Math.floor((elapsed % 1) * 1000).toString().padStart(3, '0');\n    document.getElementById('timer').textContent = `${min}:${sec}.${ms}`;\n    \n    document.getElementById('multiplier').textContent = `×${this.combo}`;\n    document.getElementById('distance').textContent = `${this.distance}m`;\n    \n    const speedPct = (this.player.vx - CONFIG.BASE_SPEED) / (CONFIG.MAX_SPEED - CONFIG.BASE_SPEED);\n    document.getElementById('speedFill').style.width = `${Math.max(0, Math.min(100, speedPct * 100))}%`;\n    \n    // Powerup timers\n    const timersDiv = document.getElementById('powerupTimers');\n    timersDiv.innerHTML = '';\n    const powerups = [\n      { timer: this.player.turboTimer, color: COLORS.uiAccent, label: 'TURBO' },\n      { timer: this.player.ghostTimer, color: COLORS.uiSecondary, label: 'GHOST' },\n      { timer: this.player.magnetTimer, color: COLORS.uiSuccess, label: 'MAGNET' },\n      { timer: this.player.sustainedTimer, color: COLORS.uiWarning, label: 'SUSTAIN' }\n    ];\n    for (const p of powerups) {\n      if (p.timer > 0) {\n        const div = document.createElement('div');\n        div.className = 'powerup-bar';\n        div.innerHTML = `<span style="color:${p.color}">${p.label}</span><div class="bar"><div class="fill" style="width:${(p.timer/CONFIG.POWERUP_DURATION)*100}%;background:${p.color}"></div></div>`;\n        timersDiv.appendChild(div);\n      }\n    }\n  }\n  draw() {\n    const ctx = this.ctx;\n    ctx.setTransform(1, 0, 0, 1, 0, 0);\n    ctx.clearRect(0, 0, CONFIG.BASE_WIDTH, CONFIG.BASE_HEIGHT);\n    \n    // Draw background\n    this.background.draw(ctx, this.scrollX);\n    \n    // Translate for scrolling\n    ctx.translate(-this.scrollX, 0);\n    \n    // Draw level\n    this.level.draw(ctx);\n    \n    // Draw particles\n    particles.draw(ctx);\n    \n    // Draw player\n    this.player.draw(ctx);\n    \n    // Reset transform\n    ctx.setTransform(1, 0, 0, 1, 0, 0);\n  }\n  gameOver() {\n    this.running = false;\n    \n    if (this.score > this.highScore) {\n      this.highScore = this.score;\n      localStorage.setItem('gkr_highscore', this.highScore.toString());\n    }\n    \n    document.getElementById('highScoreDisplay').textContent = `High Score: ${this.highScore}`;\n    document.getElementById('menuTitle').textContent = 'RUN ENDED';\n    document.getElementById('menuSubtitle').textContent = `Score: ${this