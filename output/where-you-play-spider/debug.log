       z-index: 10;\n            transition: all 0.3s ease;\n        }\n        \n        #speedrun-timer.paused {\n            color: #ff6b6b;\n            animation: pulse 1s ease-in-out;\n        }\n        @keyframes pulse {\n            0%, 100% { opacity: 1; }\n            50% { opacity: 0.7; }\n        }\n        \n        /* HUD - Top Center */\n        #hud {\n            position: absolute;\n            top: 40px;\n            left: 50%;\n            transform: translateX(-50%);\n            display: flex;\n            gap: 30px;\n            z-index: 5;\n        }\n        \n        .hud-item {\n            display: flex;\n            flex-direction: column;\n            align-items: center;\n            gap: 4px;\n            background: rgba(0, 20, 40, 0.7);\n            padding: 12px 20px;\n            border-radius: 12px;\n            min-width: 80px;\n            backdrop-filter: blur(10px);\n        }\n        \n        .hud-label {\n            font-size: 12px;\n            text-transform: uppercase;\n            letter-spacing: 1px;\n            color: #aaa;\n        }\n        \n        .hud-value {\n            font-size: 28px;\n            font-weight: bold;\n            color: #fff;\n            transition: all 0.3s ease;\n        }\n        \n        .hud-value.high {\n            color: #ff6b6b;\n        }\n        \n        /* Floating particles / background layers */\n        .bg-layer {\n            position: absolute;\n            top: 0;\n            left: 0;\n            width: 100%;\n            height: 100%;\n            pointer-events: none;\n            z-index: 1;\n        }\n        \n        /* Controls info (bottom right) */\n        #controls-info {\n            position: absolute;\n            bottom: 20px;\n            right: 20px;\n            z-index: 5;\n            background: rgba(0, 20, 40, 0.8);\n            padding: 12px 20px;\n            border-radius: 12px;\n            font-size: 13px;\n            color: #ccc;\n            line-height: 1.6;\n        }\n        \n        #controls-info span {\n            color: #fff;\n            font-weight: bold;\n        }\n        \n        /* Responsive adjustments for small screens */\n        @media (max-width: 600px) {\n            #speedrun-timer {\n                font-size: 22px;\n                padding: 6px 14px;\n            }\n            #hud {\n                top: 30px;\n                gap: 20px;\n            }\n            .hud-value {\n                font-size: 24px;\n            }\n        }\n    </style>\n</head>\n<body>\n    <div id=\"game-container\">\n        <canvas id=\"gameCanvas\"></canvas>\n        \n        <!-- Speedrun Timer -->\n        <div id=\"speedrun-timer\">00:00</div>\n        \n        <!-- HUD -->\n        <div id=\"hud\">\n            <div class=\"hud-item\">\n                <span class=\"hud-label\">Altitude</span>\n                <span class=\"hud-value\" id=\"altitude-value\">0.0 km</span>\n            </div>\n            <div class=\"hud-item\">\n                <span class=\"hud-label\">Fuel</span>\n                <span class=\"hud-value\" id=\"fuel-value\">100%</span>\n            </div>\n            <div class=\"hud-item\">\n                <span class=\"hud-label\">Balloon Health</span>\n                <span class=\"hud-value\" id=\"health-value\">100%</span>\n            </div>\n            <div class=\"hud-item\">\n                <span class=\"hud-label\">Score</span>\n                <span class=\"hud-value\" id=\"score-value\">0</span>\n            </div>\n        </div>\n        \n        <!-- Controls info -->\n        <div id=\"controls-info\">\n            <strong>Controls:</strong> <span>↑ / ↓ - Pump / Ascend</span> <span>← / → - Swing</span> <span>Tap - Boost</span>\n        </div>\n    </div>\n    \n    <script src=\"main.js\"></script>\n    <script src=\"physics.js\"></script>\n</body>\n</html>\n"
