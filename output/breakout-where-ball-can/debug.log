export default class Ball {
  constructor(x, y, radius = 6, speed = 5, color = '#ff6b6b') {
    this.x = x;
    this.y = y;
    this.radius = radius;
    this.vx = speed * (Math.random() > 0.5 ? 1 : -1);
    this.vy = speed * (Math.random() > 0.5 ? 1 : -1);
    this.color = color;
    this.isSplit = false;
    this.splitCount = 0;
  }
  update() {
    this.x += this.vx;
    this.y += this.vy;
    // wall collisions
    if (this.x + this.radius > canvas.width || this.x - this.radius < 0) this.vx *= -1;
    if (this.y + this.radius > canvas.height || this.y - this.radius < 0) this.vy *= -1;
  }
  draw(ctx) {
    ctx.fillStyle = this.color;
    ctx.beginPath();
    ctx.arc(this.x, this.y, this.radius, 0, Math.PI * 2);
    ctx.fill();
  }
  split() {
    if (this.isSplit) return;
    this.isSplit = true;
    const count = 2 + Math.floor(Math.random() * 3); // 2-4
    for (let i = 0; i < count; i++) {
      const angle = (Math.random() * Math.PI / 3) - Math.PI / 6; // ±30°
      const newVx = this.vx + Math.cos(angle) * 1;
      const newVy = this.vy + Math.sin(angle) * 1;
      const newBall = new Ball(this.x, this.y, this.radius, Math.hypot(newVx, newVy), this.color);
      // limit active balls
      if (Game.activeBalls.length < 8) Game.activeBalls.push(newBall);
    }
  }
}
```

