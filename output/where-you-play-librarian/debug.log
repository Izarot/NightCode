 margin: 0 auto;\"></canvas>\n        </div>\n    </div>\n    \n    <div id=\"velocity-panel\" class=\"ui-overlay\">\n        <div>VELOCITY: <span id=\"velocity-value\">0.00</span></div>\n        <div style=\"margin-top: 5px;\">\n            <span id=\"velocity-arrow\">●</span>\n        </div>\n    </div>\n    \n    <div id=\"controls-hint\" class=\"ui-overlay\">\n        <div>[WASD/ARROWS] Move</div>\n        <div>[SHIFT] Boost</div>\n        <div>[SPACE] Scan</div>\n        <div>[TAB] Catalog</div>\n        <div>[ESC] Pause</div>\n    </div>\n    \n    <div id=\"catalog-overlay\">\n        <h2>✧ STELLAR ARCHIVE ✧</h2>\n        <div class=\"catalog-section\">\n            <h3>SPECTRAL INDEX</h3>\n            <div class=\"catalog-row\">\n                <span class=\"symbol\" style=\"color: #6eb5ff;\">◆</span>\n                <span class=\"name\">Class O</span>\n                <div class=\"progress-bar\">\n                    <div class=\"progress-bar-fill\" id=\"bar-o\" style=\"width: 0%\"></div>\n                </div>\n                <span class=\"count\" id=\"count-o\">0/10</span>\n            </div>\n            <div class=\"catalog-row\">\n                <span class=\"symbol\" style=\"color: #6eb5ff;\">◇</span>\n                <span class=\"name\">Class B</span>\n                <div class=\"progress-bar\">\n                    <div class=\"progress-bar-fill\" id=\"bar-b\" style=\"width: 0%\"></div>\n                </div>\n                <span class=\"count\" id=\"count-b\">0/25</span>\n            </div>\n            <div class=\"catalog-row\">\n                <span class=\"symbol\" style=\"color: #67e8f9;\">○</span>\n                <span class=\"name\">Class A</span>\n                <div class=\"progress-bar\">\n                    <div class=\"progress-bar-fill\" id=\"bar-a\" style=\"width: 0%\"></div>\n                </div>\n                <span class=\"count\" id=\"count-a\">0/50</span>\n            </div>\n            <div class=\"catalog-row\">\n                <span class=\"symbol\" style=\"color: #fcd34d;\">◐</span>\n                <span class=\"name\">Class F</span>\n                <div class=\"progress-bar\">\n                    <div class=\"progress-bar-fill\" id=\"bar-f\" style=\"width: 0%\"></div>\n                </div>\n                <span class=\"count\" id=\"count-f\">0/100</span>\n            </div>\n            <div class=\"catalog-row\">\n                <span class=\"symbol\" style=\"color: #fcd34d;\">◑</span>\n                <span class=\"name\">Class G</span>\n                <div class=\"progress-bar\">\n                    <div class=\"progress-bar-fill\" id=\"bar-g\" style=\"width: 0%\"></div>\n                </div>\n                <span class=\"count\" id=\"count-g\">0/150</span>\n            </div>\n            <div class=\"catalog-row\">\n                <span class=\"symbol\" style=\"color: #fb923c;\">●</span>\n                <span class=\"name\">Class K</span>\n                <div class=\"progress-bar\">\n                    <div class=\"progress-bar-fill\" id=\"bar-k\" style=\"width: 0%\"></div>\n                </div>\n                <span class=\"count\" id=\"count-k\">0/200</span>\n            </div>\n            <div class=\"catalog-row\">\n                <span class=\"symbol\" style=\"color: #ef4444;\">◉</span>\n                <span class=\"name\">Class M</span>\n                <div class=\"progress-bar\">\n                    <div class=\"progress-bar-fill\" id=\"bar-m\" style=\"width: 0%\"></div>\n                </div>\n                <span class=\"count\" id=\"count-m\">0/500</span>\n            </div>\n        </div>\n        <div class=\"catalog-section\">\n            <h3>SPECIAL ENTRIES</h3>\n            <div class=\"catalog-row\">\n                <span class=\"symbol\" style=\"color: #fcd34d;\">☆</span>\n                <span class=\"name\">Golden Stars</span>\n                <span class=\"count\" id=\"count-golden\">0</span>\n            </div>\n            <div class=\"catalog-row\">\n                <span class=\"symbol\" style=\"color: #67e8f9;\">◎</span>\n                <span class=\"name\">Binary Stars</span>\n                <span class=\"count\" id=\"count-binary\">0</span>\n            </div>\n            <div class=\"catalog-row\">\n                <span class=\"symbol\" style=\"color: #a78bfa;\">⊕</span>\n                <span class=\"name\">Pulsars</span>\n                <span class=\"count\" id=\"count-pulsar\">0</span>\n            </div>\n        </div>\n        <div id=\"catalog-total\">\n            <div class=\"total-count\" id=\"total-stars\">0 STARS</div>\n            <div class=\"score\">SCORE: <span id=\"total-score\">0</span></div>\n        </div>\n    </div>\n    \n    <div id=\"pause-overlay\">\n        <div id=\"pause-menu\">\n            <h2>✧ PAUSED ✧</h2>\n            <button id=\"resume-btn\">Resume</button>\n            <button id=\"restart-btn\">New Expedition</button>\n        </div>\n    </div>\n    \n    <div id=\"star-info\">\n        <div class=\"star-name\" id=\"star-name\">Blue Giant</div>\n        <div class=\"star-class\" id=\"star-class\">Class B</div>\n        <div class=\"star-details\" id=\"star-details\">Magnitude: 3.2<br>Distance: ~4,200 ly</div>\n        <div style=\"margin-top: 8px; color: #f472b6;\">[SPACE] to catalog</div>\n    </div>\n    \n    <div id=\"mobile-controls\">\n        <div class=\"dpad\">\n            <div class=\"dpad-btn up\" data-key=\"w\">▲</div>\n            <div class=\"dpad-btn down\" data-key=\"s\">▼</div>\n            <div class=\"dpad-btn left\" data-key=\"a\">◄</div>\n            <div class=\"dpad-btn right\" data-key=\"d\">►</div>\n        </div>\n        <div class=\"action-btns\">\n            <div class=\"action-btn\" data-key=\"scan\">SCAN</div>\n            <div class=\"action-btn\" data-key=\"catalog\">CAT</div>\n        </div>\n    </div>\n    \n    <script>\n        // ============================================\n        // CONFIGURATION & CONSTANTS\n        // ============================================\n        const CONFIG = {\n            // Physics\n            ACCELERATION: 0.15,\n            MAX_VELOCITY: 4.0,\n            FRICTION: 0.985,\n            MIN_VELOCITY: 0.01,\n            BOOST_MULTIPLIER: 2.0,\n            \n            // Scanning\n            SCAN_RANGE: 80,\n            SCAN_TIME: 1500,\n            \n            // Stars\n            INITIAL_STARS: 80,\n            BUFFER_ZONE: 200,\n            UNLOAD_DISTANCE: 1500,\n            SPAWN_BUFFER: 500,\n            \n            // Particles\n            AMBIENT_DUST: 200,\n            NEBULA_COUNT: 4,\n            \n            // World\n            WORLD_SIZE: 50000\n        };\n        \n        const COLORS = {\n            voidDeep: '#050510',\n            voidMid: '#0f0f1a',\n            voidLight: '#0a0a12',\n            starWhite: '#f0f4ff',\n            starBlue: '#6eb5ff',\n            starCyan: '#67e8f9',\n            starYellow: '#fcd34d',\n            starOrange: '#fb923c',\n            starRed: '#ef4444',\n            nebulaPink: '#f472b6',\n            nebulaPurple: '#a78bfa',\n            uiGold: '#d4af37',\n            uiCream: '#f5f0e6',\n            uiDark: '#1a1a2e'\n        };\n        \n        const STAR_CLASSES = {\n            'O': { color: '#6eb5ff', name: 'Blue Giant', temp: '>30,000K', symbol: '◆', points: 100, rarity: 0.02, max: 10 },\n            'B': { color: '#6eb5ff', name: 'Blue-White', temp: '10,000-30,000K', symbol: '◇', points: 50, rarity: 0.05, max: 25 },\n            'A': { color: '#67e8f9', name: 'White', temp: '7,500-10,000K', symbol: '○', points: 25, max: 50 },\n            'F': { color: '#fcd34d', name: 'Yellow-White', temp: '6,000-7,500K', symbol: '◐', points: 15, max: 100 },\n            'G': { color: '#fcd34d', name: 'Yellow (Sun-like)', temp: '5,200-6,000K', symbol: '◑', points: 10, max: 150 },\n            'K': { color: '#fb923c', name: 'Orange Dwarf', temp: '3,700-5,200K', symbol: '●', points: 5, max: 200 },\n            'M': { color: '#ef4444', name: 'Red Dwarf', temp: '2,400-3,700K', symbol: '◉', points: 1, max: 500 }\n        };\n        \n        const CLASS_WEIGHTS = {\n            'M': 35,\n            'K': 25,\n            'G': 15,\n            'F': 10,\n            'A': 8,\n            'B': 5,\n            'O': 2\n        };\n        \n        // ============================================\n        // AUDIO SYSTEM (Web Audio API)\n        // ============================================\n        class AudioSystem {\n            constructor() {\n                this.ctx = null;\n                this.initialized = false;\n            }\n            \n            init() {\n                if (this.initialized) return;\n                try {\n                    this.ctx = new (window.AudioContext || window.webkitAudioContext)();\n                    this.initialized = true;\n                } catch (e) {\n                    console.log('Audio not supported');\n                }\n            }\n            \n            playTone(frequency, duration, type = 'sine', volume = 0.1) {\n                if (!this.ctx) return;\n                const osc = this.ctx.createOscillator();\n                const gain = this.ctx.createGain();\n                osc.type = type;\n                osc.frequency.setValueAtTime(frequency, this.ctx.currentTime);\n                gain.gain.setValueAtTime(volume, this.ctx.currentTime);\n                gain.gain.exponentialRampToValueAtTime(0.001, this.ctx.currentTime + duration);\n                osc.connect(gain);\n                gain.connect(this.ctx.destination);\n                osc.start();\n                osc.stop(this.ctx.currentTime + duration);\n            }\n            \n            playScanComplete() {\n                this.playTone(880, 0.1, 'sine', 0.08);\n                setTimeout(() => this.playTone(1100, 0.15, 'sine', 0.06), 100);\n                setTimeout(() => this.playTone(1320, 0.2, 'sine', 0.04), 200);\n            }\n            \n            playRareStar() {\n                this.playTone(660, 0.1, 'triangle', 0.1);\n                setTimeout(() => this.playTone(880, 0.1, 'triangle', 0.1), 100);\n                setTimeout(() => this.playTone(1100, 0.15, 'triangle', 0.1), 200);\n                setTimeout(() => this.playTone(1320, 0.2, 'triangle', 0.08), 300);\n            }\n            \n            playBoost() {\n                this.playTone(200, 0.1, 'sawtooth', 0.03);\n            }\n            \n            playUIClick() {\n                this.playTone(600, 0.05, 'square', 0.03);\n            }\n        }\n        \n        const audio = new AudioSystem();\n        \n        // ============================================\n        // UTILITY FUNCTIONS\n        // ============================================\n        function randomRange(min, max) {\n            return Math.random() * (max - min) + min;\n        }\n        \n        function randomInt(min, max) {\n            return Math.floor(randomRange(min, max + 1));\n        }\n        \n        function distance(x1, y1, x2, y2) {\n            return Math.sqrt((x2 - x1) ** 2 + (y2 - y1) ** 2);\n        }\n        \n        function lerp(a, b, t) {\n            return a + (b - a) * t;\n        }\n        \n        function weightedRandom(weights) {\n            const total = Object.values(weights).reduce((a, b) => a + b, 0);\n            let random = Math.random() * total;\n            for (const [key, weight] of Object.entries(weights)) {\n                random -= weight;\n                if (random <= 0) return key;\n            }\n            return Object.keys(weights)[0];\n        }\n        \n        function formatTime(ms) {\n            const totalSeconds = Math.floor(ms / 1000);\n            const minutes = Math.floor(totalSeconds / 60);\n            const seconds = totalSeconds % 60;\n            const millis = ms % 1000;\n            return `${String(minutes).padStart(2, '0')}:${String(seconds).padStart(2, '0')}.${String(millis).padStart(3, '0')}`;\n        }\n        \n        // ============================================\n        // STAR CLASS\n        // ============================================\n        class Star {\n            constructor(x, y) {\n                this.x = x;\n                this.y = y;\n                this.classType = weightedRandom(CLASS_WEIGHTS);\n                this.magnitude = randomRange(1, 10);\n                this.pulseRate = randomRange(0.5, 2.0);\n                this.pulsePhase = randomRange(0, Math.PI * 2);\n                this.cataloged = false;\n                this.coreSize = this.calculateCoreSize();\n                this.glowRadius = this.coreSize * 3;\n                this.special = null;\n                this.beamAngle = 0;\n                \n                // Check for special stars\n                const specialRoll = Math.random();\n                if (specialRoll < 0.02) {\n                    this.special = 'golden';\n                } else if (specialRoll < 0.04) {\n                    this.special = 'binary';\n                    this.binaryOffset = randomRange(15, 25);\n                    this.binaryAngle = randomRange(0, Math.PI * 2);\n                } else if (specialRoll < 0.05) {\n                    this.special = 'pulsar';\n                    this.pulseTimer = 0;\n                }\n            }\n            \n            calculateCoreSize() {\n                const baseSize = lerp(2, 8, (10 - this.magnitude) / 9);\n                const classBonus = ['O', 'B', 'A'].includes(this.classType) ? 1.5 : 1;\n                return baseSize * classBonus;\n            }\n            \n            getColor() {\n                if (this.special === 'golden') return '#fcd34d';\n                return STAR_CLASSES[this.classType].color;\n            }\n            \n            getPoints() {\n                if (this.special === 'golden') return 50;\n                if (this.special === 'pulsar') return 100;\n                if (this.special === 'binary') return 30;\n                return STAR_CLASSES[this.classType].points;\n            }\n            \n            update(dt) {\n                this.pulsePhase += dt * this.pulseRate;\n                if (this.special === 'pulsar') {\n                    this.pulseTimer += dt;\\n                if (this.pulseTimer > 1.5) this.pulseTimer = 0;\n                this.beamAngle += dt * 3;\n                }\n            }\n        }\n        \n        // ============================================\n        // PARTICLE CLASS\n        // ============================================\n        class Particle {\n            constructor(x, y, options = {}) {\n                this.x = x;\n                this.y = y;\n                this.vx = options.vx || 0;\n                this.vy = options.vy || 0;\n                this.life = options.life || 1.0;\n                this.maxLife = this.life;\n                this.size = options.size || 2;\n                this.color = options.color || '#ffffff';\n                this.type = options.type || 'dust';\n                this.fade = options.fade !== false;\n            }\n            \n            update(dt) {\n                this.x += this.vx * dt;\n                this.y += this.vy * dt;\n                if (this.fade) {\n                    this.life -= dt * 0.5;\n                }\n                if (this.type === 'sparkle') {\n                    this.size = Math.max(0, this.size - dt * 0.5);\n                }\n            }\n            \n            isDead() {\n                return this.life <= 0 || this.size <= 0;\n            }\n        }\n        \n        // ============================================\n        // NEBULA CLASS\n        // ============================================\n        class Nebula {\n            constructor(x, y) {\n                this.x = x;\n                this.y = y;\n                this.size = randomRange(800, 1500);\n                this.color1 = Math.random() > 0.5 ? COLORS.nebulaPink : COLORS.nebulaPurple;\n                this.color2 = Math.random() > 0.5 ? '#4c1d95' : '#831843';\n                this.density = randomRange(0.2, 0.4);\n                this.offsetX = randomRange(-1000, 1000);\n                this.offsetY = randomRange(-1000, 1000);\n            }\n        }\n        \n        // ============================================\n        // MAIN GAME\n        // ============================================\n        class Game {\n            constructor() {\n                this.canvas = document.getElementById('gameCanvas');\n                this.ctx = this.canvas.getContext('2d');\n                this.resize();\n                window.addEventListener('resize', () => this.resize());\n                \n                // Game state\n                this.state = 'title'; // title, playing, paused, complete\n                this.startTime = 0;\n                this.elapsedTime = 0;\n                this.completionTime = null;\n                \n                // Player\n                this.player = {\n                    x: 0,\n                    y: 0,\n                    vx: 0,\n                    vy: 0,\n                    radius: 8\n                };\n                \n                // Camera\n                this.camera = { x: 0, y: 0, shake: 0, shakeTime: 0 };\n                \n                // World\n                this.stars = [];\n                this.particles = [];\n                this.nebulae = [];\n                this.ambientDust = [];\n                \n                // Catalog\n                this.catalog = {\n                    'O': 0, 'B': 0, 'A': 0, 'F': 0, 'G': 0, 'K': 0, 'M': 0,\n                    'golden': 0, 'binary': 0, 'pulsar': 0\n                };\n                this.totalStars = 0;\n                this.score = 0;\n                this.totalPossible = Object.values(STAR_CLASSES).reduce((sum, c) => sum + c.max, 0);\n                \n                // Scanning\n                this.nearestStar = null;\n                this.scanning = false;\n                this.scanStartTime = 0;\n                this.scanProgress = 0;\n                this.lastScannedStar = null;\n                this.scanComplete = false;\n                \n                // Input\n                this.keys = {};\n                this.setupInput();\n                \n                // Mobile\n                this.setupMobile();\n                \n                // UI\n                this.setupUI();\n                \n                // Load high score\n                this.highScore = parseInt(localStorage.getItem('stellarArchive_highScore') || '0');\n                this.updateHighScoreDisplay();\n                \n                // Initialize world\n                this.initWorld();\n                \n                // Start loop\n                this.lastTime = performance.now();\n                requestAnimationFrame((t) => this.loop(t));\n            }\n            \n            resize() {\n                this.canvas.width = window.innerWidth;\n                this.canvas.height = window.innerHeight;\n            }\n            \n            initWorld() {\n                // Create initial stars around player\n                for (let i = 0; i < CONFIG.INITIAL_STARS; i++) {\n                    const angle = Math.random() * Math.PI * 2;\n                    const dist = randomRange(50, 1500);\n                    const x = this.player.x + Math.cos(angle) * dist;\n                    const y = this.player.y + Math.sin(angle) * dist;\n                    this.stars.push(new Star(x, y));\n                }\n                \n                // Create nebulae\n                for (let i = 0; i < CONFIG.NEBULA_COUNT; i++) {\n                    const x = randomRange(-3000, 3000);\n                    const y = randomRange(-3000, 3000);\n                    this.nebulae.push(new Nebula(x, y));\n                }\n                \n                // Create ambient dust\n                for (let i = 0; i < CONFIG.AMBIENT_DUST; i++) {\n                    this.ambientDust.push({\n                        x: randomRange(-2000, 2000),\n                        y: randomRange(-2000, 2000),\n                        size: randomRange(0.5, 2),\n                        twinkle: randomRange(0, Math.PI * 2)\n                    });\n                }\n            }\n            \n            setupInput() {\n                window.addEventListener('keydown', (e) => {\n                    if (this.keys[e.key]) return;\n                    this.keys[e.key] = true;\n                    \n                    if (this.state === 'title' && (e.key === 'Enter' || e.key === ' ')) {\n                        audio.init();\n                        this.startGame();\n                        return;\n                    }\n                    \n                    if (this.state === 'complete' && (e.key === 'Enter' || e.key === ' ')) {\n                        this.restart();\n                        return;\n                    }\n                    \n                    if (e.key === 'Escape') {\n                        if (this.state === 'playing') this.pause();\n                        else if (this.state === 'paused') this.resume();\n                    }\n                    \n                    if (e.key === 'Tab') {\n                        e.preventDefault();\n                        this.toggleCatalog();\n                    }\n                    \n                    if (e.key === ' ' && this.state === 'playing') {\n                        this.startScan();\n                    }\n                });\n                \n                window.addEventListener('keyup', (e) => {\n                    this.keys[e.key] = false;\n                });\n            }\n            \n            setupMobile() {\n                const buttons = document.querySelectorAll('.dpad-btn, .action-btn');\n                buttons.forEach(btn => {\n                    const key = btn.dataset.key;\n                    \n                    btn.addEventListener('touchstart', (e) => {\n                        e.preventDefault();\n                        if (key === 'scan') {\n                            this.startScan();\n                        } else if (key === 'catalog') {\n                            this.toggleCatalog();\n                        } else {\n                            this.keys[key] = true;\n                        }\n                    });\n                    \n                    btn.addEventListener('touchend', (e) => {\n                        e.preventDefault();\n                        if (key !== 'scan' && key !== 'catalog') {\n                            this.keys[key] = false;\n                        }\n                    });\n                });\n            }\n            \n            setupUI() {\n                document.getElementById('resume-btn').addEventListener('click', () => {\n                    audio.init();\n                    audio.playUIClick();\n                    this.resume();\n                });\n                \n                document.getElementById('restart-btn').addEventListener('click', () => {\n                    audio.init();\n                    audio.playUIClick();\n                    this.restart();\n                });\n            }\n            \n            updateHighScoreDisplay() {\n                const el = document.getElementById('high-score-display');\n                if (this.highScore > 0) {\n                    el.textContent = `✧ Previous Best Score: ${this.highScore}`;\n                }\n            }\n            \n            startGame() {\n                this.state = 'playing';\n                document.getElementById('title-screen').classList.add('hidden');\n                this.startTime = performance.now();\n                audio.playTone(440, 0.1, 'sine', 0.08);\n                setTimeout(() => audio.playTone(660, 0.15, 'sine', 0.08), 100);\n            }\n            \n            pause() {\n                this.state = 'paused';\n                document.getElementById('pause-overlay').classList.add('visible');\n            }\n            \n            resume() {\n                this.state = 'playing';\n                document.getElementById('pause-overlay').classList.remove('visible');\n                this.lastTime = performance.now();\n            }\n            \n            restart() {\n                this.state = 'playing';\n                document.getElementById('pause-overlay').classList.remove('visible');\n                document.getElementById('title-screen').classList.add('hidden');\n                this.player.x = 0;\n                this.player.y = 0;\n                this.player.vx = 0;\n                this.player.vy = 0;\n                this.stars = [];\n                this.particles = [];\n                this.catalog = {\n                    'O': 0, 'B': 0, 'A': 0, 'F': 0, 'G': 0, 'K': 0, 'M': 0,\n                    'golden': 0, 'binary': 0, 'pulsar': 0\n                };\n                this.totalStars = 0;\n                this.score = 0;\n                this.completionTime = null;\n                this.startTime = performance.now();\n                this.elapsedTime = 0;\n                this.scanning = false;\n                this.scanComplete = false;\n                this.camera.shake = 0;\n                this.lastScannedStar = null;\n                document.getElementById('catalog-overlay').classList.remove('visible');\n                this.initWorld();\n            }\n            \n            toggleCatalog() {\n                const overlay = document.getElementById('catalog-overlay');\n                overlay.classList.toggle('visible');\n                audio.playUIClick();\n            }\n            \n            startScan() {\n                if (this.scanning) return;\n                if (this.scanComplete) {\n                    this.catalogStar();\n                    return;\n                }\n                \n                // Find nearest in-range star\n                let nearest = null;\n                let nearestDist = CONFIG.SCAN_RANGE;\n                \n                for (const star of this.stars) {\n                    if (star.cataloged) continue;\n                    const d = distance(this.player.x, this.player.y, star.x, star.y);\n                    if (d < nearestDist) {\n                        nearestDist = d;\n                        nearest = star;\n                    }\n                }\n                \n                if (!nearest) return;\n                \n                this.scanning = true;\n                this.scanStartTime = performance.now();\n                this.scanTarget = nearest;\n                audio.playTone(440, 0.05, 'sine', 0.05);\n            }\n            \n            catalogStar() {\n                if (!this.lastScannedStar || this.lastScannedStar.cataloged) return;\n                \n                const star = this.lastScannedStar;\n                star.cataloged = true;\n                \n                // Update catalog\n                if (star.special) {\n                    this.catalog[star.special]++;\n                } else {\n                    this.catalog[star.classType]++;\n                }\n                \n                this.totalStars++;\n                this.score += star.getPoints();\n                \n                // Particles\n                for (let i = 0; i < 20; i++) {\n                    const angle = (Math.PI * 2 / 20) * i;\n                    const speed = randomRange(1, 3);\n                    this.particles.push(new Particle(star.x, star.y, {\n                        vx: Math.cos(angle) * speed,\n                        vy: Math.sin(angle) * speed,\n                        life: 1.0,\n                        size: randomRange(2, 5),\n                        color: star.getColor(),\n                        type: 'sparkle'\n                    }));\n                }\n                \n                // Sound\n                if (star.special) {\n                    audio.playRareStar();\n                    this.camera.shake = 8;\n                    this.camera.shakeTime = 0.3;\n                } else {\n                    audio.playScanComplete();\n                }\n                \n                this.scanComplete = false;\n                this.scanning = false;\n                this.lastScannedStar = null;\n                \n                // Check completion\n                if (this.totalStars >= this.totalPossible && !this.completionTime) {\n                    this.completionTime = this.elapsedTime;\n                    this.state = 'complete';\n                    if (this.score > this.highScore) {\n                        this.highScore = this.score;\n                        localStorage.setItem('stellarArchive_highScore', this.highScore.toString());\n                        this.updateHighScoreDisplay();\n                    }\n                    setTimeout(() => this.showCompleteScreen(), 500);\n                }\n                \n                this.updateCatalogUI();\n            }\n            \n            showCompleteScreen() {\n                const pauseMenu = document.getElementById('pause-menu');\n                pauseMenu.innerHTML = `\n                    <h2>✧ ARCHIVE COMPLETE ✧</h2>\n                    <div style=\"color: #fcd34d; font-size: 18px; margin: 15px 0;\">\n                        ${this.totalStars} STARS CATALOGED\n                    </div>\n                    <div style=\"color: #d4af37; font-size: 16px; margin: 10px 0;\">\n                        SCORE: ${this.score}\n                    </div>\n                    <div style=\"color: #67e8f9; font-size: 14px; margin: 10px 0;\">\n                        TIME: ${formatTime(this.completionTime)}\n                    </div>\n                    <button onclick=\"location.reload()\">New Expedition</button>\n                `;\n                document.getElementById('pause-overlay').classList.add('visible');\n            }\n            \n            update(dt) {\n                if (this.state !== 'playing') return;\n                \n                // Update elapsed time\n                this.elapsedTime = performance.now() - this.startTime;\n                \n                // Player movement\n                let ax = 0;\n                let ay = 0;\n                \n                if (this.keys['w'] || this.keys['W'] || this.keys['ArrowUp']) ay -= 1;\n                if (this.keys['s'] || this.keys['S'] || this.keys['ArrowDown']) ay += 1;\n                if (this.keys['a'] || this.keys['A'] || this.keys['ArrowLeft']) ax -= 1;\n                if (this.keys['d'] || this.keys['D'] || this.keys['ArrowRight']) ax += 1;\n                \n                const boosting = this.keys['Shift'];\n                const accel = CONFIG.ACCELERATION * (boosting ? CONFIG.BOOST_MULTIPLIER : 1);\n                \n                if (ax !== 0 || ay !== 0) {\n                    const len = Math.sqrt(ax * ax + ay * ay);\n                    ax /= len;\n                    ay /= len;\n                    this.player.vx += ax * accel;\n                    this.player.vy += ay * accel;\n                    \n                    // Speed cap\n                    const speed = Math.sqrt(this.player.vx ** 2 + this.player.vy ** 2);\n                    const maxSpeed = CONFIG.MAX_VELOCITY * (boosting ? CONFIG.BOOST_MULTIPLIER : 1);\n                    if (speed > maxSpeed) {\n                        this.player.vx = (this.player.vx / speed) * maxSpeed;\n                        this.player.vy = (this.player.vy / speed) * maxSpeed;\n                    }\n                    \n                    if (boosting && Math.random() < 0.3) {\n                        this.particles.push(new Particle(\n                            this.player.x - this.player.vx * 2,\n                            this.player.y - this.player.vy * 2,\n                            {\n                                vx: -this.player.vx * 0.3 + randomRange(-0.5, 0.5),\n                                vy: -this.player.vy * 0.3 + randomRange(-0.5, 0.5),\n                                life: 0.8,\n                                size: randomRange(1, 3),\n                                color: COLORS.starBlue,\n                                type: 'trail'\n                            }\n                        ));\n                    }\n                }\n                \n                // Apply friction\n                this.player.vx *= CONFIG.FRICTION;\n                this.player.vy *= CONFIG.FRICTION;\n                \n                // Stop micro movements\n                if (Math.abs(this.player.vx) < CONFIG.MIN_VELOCITY) this.player.vx = 0;\n                if (Math.abs(this.player.vy) < CONFIG.MIN_VELOCITY) this.player.vy = 0;\n                \n                // Update position\n                this.player.x += this.player.vx;\n                this.player.y += this.player.vy;\n                \n                // Update camera\n                this.camera.x = this.player.x;\n                this.camera.y = this.player.y;\n                \n                if (this.camera.shake > 0) {\n                    this.camera.shakeTime -= dt;\n                    if (this.camera.shakeTime <= 0) {\n                        this.camera.shake = 0;\n                    }\n                }\n                \n                // Update stars\n                for (const star of this.stars) {\n                    star.update(dt);\n                }\n                \n                // Update particles\n                this.particles = this.particles.filter(p => {\n                    p.update(dt);\n                    return !p.isDead();\n                });\n                \n                // Update ambient dust\n                for (const dust of this.ambientDust) {\n                    dust.twinkle += dt * 2;\n                }\n                \n                // Manage stars - remove distant, spawn new\n                this.stars = this.stars.filter(star => {\n                    const d = distance(this.player.x, this.player.y, star.x, star.y);\n                    return d < CONFIG.UNLOAD_DISTANCE;\n                });\n                \n                // Spawn new stars ahead\n                while (this.stars.length < CONFIG.INITIAL_STARS) {\n                    const angle = Math.random() * Math.PI * 2;\n                    const dist = randomRange(800, CONFIG.SPAWN_BUFFER);\n                    const x = this.player.x + Math.cos(angle) * dist;\n                    const y = this.player.y + Math.sin(angle) * dist;\n                    this.stars.push(new Star(x, y));\n                }\n                \n                // Find nearest star\n                let nearest = null;\n                let nearestDist = CONFIG.SCAN_RANGE;\n                \n                for (const star of this.stars) {\n                    if (star.cataloged) continue;\n                    const d = distance(this.player.x, this.player.y, star.x, star.y);\n                    if (d < nearestDist) {\n                        nearestDist = d;\n                        nearest = star;\n                    }\n                }\n                \n                this.nearestStar = nearest;\n                \n                // Handle scan progress\n                if (this.scanning && this.scanTarget) {\n                    const elapsed = performance.now() - this.scanStartTime;\n                    this.scanProgress = elapsed / CONFIG.SCAN_TIME;\n                    \n                    if (this.scanProgress >= 1) {\n                        this.scanProgress = 1;\n                        this.scanning = false;\n                        this.scanComplete = true;\n                        this.lastScannedStar = this.scanTarget;\n                        audio.playScanComplete();\n                    }\n                }\n                \n                // Update UI\n                this.updateUI();\n            }\n            \n            updateUI() {\n                // Coords\n                document.getElementById('sector-x').textContent = (this.player.x / 100).toFixed(2);\n                document.getElementById('sector-y').textContent = (this.player.y / 100).toFixed(2);\n                \n                // Timer\n                if (this.completionTime) {\n                    document.getElementById('timer').textContent = formatTime(this.completionTime);\n                } else {\n                    document.getElementById('timer').textContent = formatTime(this.elapsedTime);\n                }\n                \n                // Velocity\n                const speed = Math.sqrt(this.player.vx ** 2 + this.player.vy ** 2);\n                document.getElementById('velocity-value').textContent = speed.toFixed(2);\n                \n                // Scan indicator\n                const scanIndicator = document.getElementById('scan-indicator');\n                if (this.nearestStar) {\n                    scanIndicator.classList.add('visible');\n                    if (this.scanning) {\n                        document.getElementById('scan-text').textContent = '◈ SCANNING... HOLD POSITION';\n                        document.getElementById('scan-progress').style.display = 'block';\n                        this.updateScanRing();\n                    } else if (this.scanComplete) {\n                        document.getElementById('scan-text').textContent = '◈ SCAN COMPLETE — [SPACE] TO CATALOG';\n                        document.getElementById('scan-progress').style.display = 'none';\n                    } else {\n                        document.getElementById('scan-text').textContent = '◈ STAR IN RANGE — [SPACE] TO SCAN';\n                        document.getElementById('scan-progress').style.display = 'none';\n                    }\n                } else {\n                    scanIndicator.classList.remove('visible');\n                }\n            }\n            \n            updateScanRing() {\n                const ringCanvas = document.getElementById('scan-ring');\n                const rctx = ringCanvas.getContext('2d');\n                rctx.clearRect(0, 0, 60, 60);\n                \n                rctx.strokeStyle = '#f472b6';\n                rctx.lineWidth = 3;\n                rctx.beginPath();\n                rctx.arc(30, 30, 25, -Math.PI / 2, -Math.PI / 2 + Math.PI * 2 * this.scanProgress);\n                rctx.stroke();\n                \n                rctx.fillStyle = '#f472b6';\n                rctx.font = '12px Courier New';\n                rctx.textAlign = 'center';\n                rctx.fillText(`${Math.floor(this.scanProgress * 100)}%`, 30, 35);\n            }\n            \n            updateCatalogUI() {\n                document.getElementById('catalog-count').textContent = this.totalStars;\n                const percent = Math.floor((this.totalStars / this.totalPossible) * 100);\n                document.getElementById('catalog-percent').textContent = percent;\n                document.getElementById('catalog-progress').style.width = `${percent}%`;\n                \n                for (const [cls, info] of Object.entries(STAR_CLASSES)) {\n                    const count = this.catalog[cls];\n                    const max = info.max;\n                    const pct = Math.min(100, (count / max) * 100);\n                    document.getElementById(`bar-${cls.toLowerCase()}`).style.width = `${pct}%`;\n                    document.getElementById(`count-${cls.toLowerCase()}`).textContent = `${count}/${max}`;\n                }\n                \n                document.getElementById('count-golden').textContent = this.catalog.golden;\n                document.getElementById('count-binary').textContent = this.catalog.binary;\n                document.getElementById('count-pulsar').textContent = this.catalog.pulsar;\n                \n                document.getElementById('total-stars').textContent = `${this.totalStars} STARS`;\n                document.getElementById('total-score').textContent = this.score;\n            }\n            \n            render() {\n                const ctx = this.ctx;\n                const w = this.canvas.width;\n                const h = this.canvas.height;\n                \n                // Clear with starfield background\n                ctx.fillStyle = COLORS.voidDeep;\n                ctx.fillRect(0, 0, w, h);\n                \n                // Apply camera shake\n                let shakeX = 0, shakeY = 0;\n                if (this.camera.shake > 0) {\n                    shakeX = randomRange(-this.camera.shake, this.camera.shake);\n                    shakeY = randomRange(-this.camera.shake, this.camera.shake);\n                }\n                \n                const camX = -this.camera.x + w / 2 + shakeX;\n                const camY = -this.camera.y + h / 2 + shakeY;\n                \n                // Draw nebulae\n                for (const nebula of this.nebulae) {\n                    this.drawNebula(nebula, camX, camY);\n                }\n                \n                // Draw ambient dust (parallax)\n                for (const dust of this.ambientDust) {\n                    const screenX = (dust.x - this.camera.x * 0.3) % 3000;\n                    const screenY = (dust.y - this.camera.y * 0.3) % 3000;\n                    const sx = (screenX + 3000) % 3000 - 1500 + w / 2;\n                    const sy = (screenY + 3000) % 3000 - 1500 + h / 2;\n                    \n                    if (sx < -10 || sx > w + 10 || sy < -10 || sy > h + 10) continue;\n                    \n                    const twinkle = (Math.sin(dust.twinkle) + 1) * 0.5;\n                    ctx.fillStyle = `rgba(245, 240, 230, ${0.2 + twinkle * 0.3})`;\n                    ctx.fillRect(sx, sy, dust.size, dust.size);\n                }\n                \n                // Draw stars\n                for (const star of this.stars) {\n                    this.drawStar(star, camX, camY);\n                }\n                \n                // Draw particles\n                for (const p of this.particles) {\n                    this.drawParticle(p, camX, camY);\n                }\n                \n                // Draw player\n                this.drawPlayer(camX, camY);\n                \n                // Draw scan ring around nearest star\n                if (this.nearestStar) {\n                    this.drawScanReticle(this.nearestStar, camX, camY);\n                }\n            }\n            \n            drawNebula(nebula, camX, camY) {\n                const x = nebula.x + camX + nebula.offsetX;\n                const y = nebula.y + camY + nebula.offsetY;\n                \n                if (x + nebula.size < -200 || x - nebula.size > this.canvas.width + 200 ||\n                    y + nebula.size < -200 || y - nebula.size > this.canvas.height + 200) return;\n                \n                const ctx = this.ctx;\n                const gradient = ctx.createRadialGradient(x, y, 0, x, y, nebula.size);\n                gradient.addColorStop(0, nebula.color1 + '40');\n                gradient.addColorStop(0.5, nebula.color2 + '20');\n                gradient.addColorStop(1, 'transparent');\n                \n                ctx.fillStyle = gradient;\n                ctx.beginPath();\n                ctx.arc(x, y, nebula.size, 0, Math.PI * 2);\n                ctx.fill();\n            }\n            \n            drawStar(star, camX, camY) {\n                const x = star.x + camX;\n                const y = star.y + camY;\n                \n                if (x < -50 || x > this.canvas.width + 50 ||\n                    y < -50 || y > this.canvas.height + 50) return;\n                \n                const ctx = this.ctx;\n                const pulse = (Math.sin(star.pulsePhase) + 1) * 0.5;\n                const size = star.coreSize + pulse * 0.5;\n                const glow = star.glowRadius + pulse * 2;\n                const alpha = star.cataloged ? 0.3 : 1.0;\n                \n                ctx.save();\n                ctx.globalAlpha = alpha;\n                \n                // Glow\n                const gradient = ctx.createRadialGradient(x, y, 0, x, y, glow);\n                gradient.addColorStop(0, star.getColor() + 'cc');\n                gradient.addColorStop(0.3, star.getColor() + '60');\n                gradient.addColorStop(1, 'transparent');\n                ctx.fillStyle = gradient;\n                ctx.beginPath();\n                ctx.arc(x, y, glow, 0, Math.PI * 2);\n                ctx.fill();\n                \n                // Core\n                ctx.fillStyle = star.getColor();\n                ctx.beginPath();\n                ctx.arc(x, y, size, 0, Math.PI * 2);\n                ctx.fill();\n                \n                // Bright center\n                ctx.fillStyle = '#ffffff';\n                ctx.beginPath();\n                ctx.arc(x, y, size * 0.4, 0, Math.PI * 2);\n                ctx.fill();\n                \n                // Special star effects\n                if (star.special === 'binary' && !star.cataloged) {\n                    const bx = x + Math.cos(star.binaryAngle) * star.binaryOffset;\n                    const by = y + Math.sin(star.binaryAngle) * star.binaryOffset;\n                    \n                    ctx.fillStyle = '#67e8f9';\n                    ctx.beginPath();\n                    ctx.arc(bx, by, size * 0.6, 0, Math.PI * 2);\n                    ctx.fill();\n                    \n                    ctx.fillStyle = '#ffffff';\n                    ctx.beginPath();\n                    ctx.arc(bx, by, size * 0.25, 0, Math.PI * 2);\n                    ctx.fill();\n                }\n                \n                if (star.special === 'pulsar' && !star.cataloged && star.pulseTimer < 0.3) {\n                    ctx.strokeStyle = '#a78bfa';\n                    ctx.lineWidth = 2;\n                    const beamLength = 100;\n                    ctx.beginPath();\n                    ctx.moveTo(x + Math.cos(star.beamAngle) * size, y + Math.sin(star.beamAngle) * size);\n                    ctx.lineTo(x + Math.cos(star.beamAngle) * beamLength, y + Math.sin(star.beamAngle) * beamLength);\n                    ctx.stroke();\n                    ctx.beginPath();\n                    ctx.moveTo(x + Math.cos(star.beamAngle + Math.PI) * size, y + Math.sin(star.beamAngle + Math.PI) * size);\n                    ctx.lineTo(x + Math.cos(star.beamAngle + Math.PI) * beamLength, y + Math.sin(star.beamAngle + Math.PI) * beamLength);\n                    ctx.stroke();\n                }\n                \n                if (star.special === 'golden' && !star.cataloged) {\n                    ctx.strokeStyle = '#fcd34d';\n                    ctx.lineWidth = 1;\n                    for (let i = 0; i < 8; i++) {\n                        const angle = (Math.PI * 2 / 8) * i + star.pulsePhase * 0.3;\n                        const rayLength = size * 3;\n                        ctx.beginPath();\n                        ctx.moveTo(x + Math.cos(angle) * size * 1.5, y + Math.sin(angle) * size * 1.5);\n                        ctx.lineTo(x + Math.cos(angle) * rayLength, y + Math.sin(angle) * rayLength);\n                        ctx.stroke();\n                    }\n                }\n                \n                ctx.restore();\n            }\n            \n            drawParticle(p, camX, camY) {\n                const x = p.x + camX;\n                const y = p.y + camY;\n                \n                if (x < -20 || x > this.canvas.width + 20 ||\n                    y < -20 || y > this.canvas.height + 20) return;\n                \n                const ctx = this.ctx;\n                ctx.fillStyle = p.color;\n                ctx.globalAlpha = p.fade ? p.life : 1;\n                ctx.beginPath();\n                ctx.arc(x, y, p.size, 0, Math.PI * 2);\n                ctx.fill();\n                ctx.globalAlpha = 1;\n            }\n            \n            drawPlayer(camX, camY) {\n                const x = this.player.x + camX;\n                const y = this.player.y + camY;\n                const ctx = this.ctx;\n                \n                // Ship glow\n                const gradient = ctx.createRadialGradient(x, y, 0, x, y, 30);\n                gradient.addColorStop(0, '#67e8f940');\n                gradient.addColorStop(1, 'transparent');\n                ctx.fillStyle = gradient;\n                ctx.beginPath();\n                ctx.arc(x, y, 30, 0, Math.PI * 2);\n                ctx.fill();\n                \n                // Ship body\n                ctx.save();\n                ctx.translate(x, y);\n                \n                const angle = Math.atan2(this.player.vy, this.player.vx);\n                if (Math.abs(this.player.vx) > 0.01 || Math.abs(this.player.vy) >