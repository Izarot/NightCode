  "index.html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, user-scalable=no\">\n    <title>Course Architect</title>\n    <link rel=\"icon\" href=\"data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🏗️</text></svg>\">\n    <style>\n        * { margin: 0; padding: 0; box-sizing: border-box; }\n        body { \n            background: #F8F9FA; \n            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; \n            overflow: hidden; \n            touch-action: none;\n            -webkit-tap-highlight-color: transparent;\n        }\n        #gameCanvas { \n            display: block; \n            position: fixed; \n            top: 0; left: 0; \n            width: 100vw; \n            height: 100vh; \n            background: #F8F9FA;\n        }\n        @media (max-width: 768px) {\n            #gameCanvas { touch-action: manipulation; }\n        }\n    </style>\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n    <link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap\" rel=\"stylesheet\">\n</head>\n<body>\n    <canvas id=\"gameCanvas\"></canvas>\n    <script type=\"module\" src=\"game.js\"></script>\n</body>\n</html>",
  "game.js": "import { Player } from './player.js';\nimport { AssetManager } from './assetManager.js';\nimport { CanvasRenderer } from './canvasRenderer.js';\nimport { UI } from './ui.js';\nimport { GameState } from './gameState.js';\nimport { AudioManager } from './audio.js';\nimport { Utils } from './utils.js';\n\nclass Game {\n    constructor() {\n        this.canvas = document.getElementById('gameCanvas');\n        this.ctx = this.canvas.getContext('2d');\n        \n        this.resize();\n        window.addEventListener('resize', () => this.resize());\n        \n        this.audio = new AudioManager();\n        this.utils = new Utils();\n        \n        this.player = new Player(this);\n        this.assetManager = new AssetManager(this);\n        this.renderer = new CanvasRenderer(this);\n        this.ui = new UI(this);\n        this.gameState = new GameState(this);\n        \n        this.keys = {};\n        this.mouse = { x: 0, y: 0, worldX: 0, worldY: 0, down: false, justClicked: false };\n        this.lastTime = 0;\n        this.running = true;\n        \n        this.setupInput();\n        this.gameState.init();\n        this.loop(0);\n    }\n    \n    resize() {\n        const dpr = window.devicePixelRatio || 1;\n        this.canvas.width = window.innerWidth * dpr;\n        this.canvas.height = window.innerHeight * dpr;\n        this.canvas.style.width = window.innerWidth + 'px';\n        this.canvas.style.height = window.innerHeight + 'px';\n        this.ctx.scale(dpr, dpr);\n        this.screenWidth = window.innerWidth;\n        this.screenHeight = window.innerHeight;\n        \n        if (this.renderer) this.renderer.onResize();\n        if (this.ui) this.ui.onResize();\n    }\n    \n    setupInput() {\n        window.addEventListener('keydown', (e) => {\n            this.keys[e.code] = true;\n            if (e.code === 'Space') e.preventDefault();\n            if (e.code === 'KeyE') this.gameState.handlePublish();\n        });\n        window.addEventListener('keyup', (e) => this.keys[e.code] = false);\n        \n        this.canvas.addEventListener('mousemove', (e) => this.updateMouse(e));\n        this.canvas.addEventListener('mousedown', (e) => { this.mouse.down = true; this.mouse.justClicked = true; });\n        this.canvas.addEventListener('mouseup', (e) => { this.mouse.down = false; });\n        \n        this.canvas.addEventListener('touchstart', (e) => {\n            e.preventDefault();\n            const touch = e.touches[0];\n            this.updateMouse({ clientX: touch.clientX, clientY: touch.clientY });\n            this.mouse.down = true;\n            this.mouse.justClicked = true;\n        }, { passive: false });\n        this.canvas.addEventListener('touchmove', (e) => {\n            e.preventDefault();\n            const touch = e.touches[0];\n            this.updateMouse({ clientX: touch.clientX, clientY: touch.clientY });\n        }, { passive: false });\n        this.canvas.addEventListener('touchend', (e) => {\n            e.preventDefault();\n            this.mouse.down = false;\n        }, { passive: false });\n        \n        window.addEventListener('blur', () => { this.keys = {}; this.mouse.down = false; });\n    }\n    \n    updateMouse(e) {\n        const rect = this.canvas.getBoundingClientRect();\n        this.mouse.x = e.clientX - rect.left;\n        this.mouse.y = e.clientY - rect.top;\n        this.mouse.worldX = this.mouse.x + this.renderer.camera.x;\n        this.mouse.worldY = this.mouse.y + this.renderer.camera.y;\n    }\n    \n    loop(time) {\n        if (!this.running) return;\n        const dt = Math.min((time - this.lastTime) / 1000, 0.1);\n        this.lastTime = time;\n        \n        this.update(dt);\n        this.render();\n        \n        this.mouse.justClicked = false;\n        requestAnimationFrame((t) => this.loop(t));\n    }\n    \n    update(dt) {\n        this.gameState.update(dt);\n        this.player.update(dt);\n        this.assetManager.update(dt);\n        this.renderer.updateCamera(dt);\n        this.ui.update(dt);\n    }\n    \n    render() {\n        this.ctx.setTransform(1, 0, 0, 1, 0, 0);\n        this.ctx.clearRect(0, 0, this.screenWidth, this.screenHeight);\n        \n        this.renderer.renderWorld();\n        this.assetManager.render(this.ctx);\n        this.player.render(this.ctx);\n        this.ui.render(this.ctx);\n    }\n}\n\nnew Game();",
  "player.js": "export class Player {\n    constructor(game) {\n        this.game = game;\n        this.x = 400;\n        this.y = 300;\n        this.width = 24;\n        this.height = 32;\n        \n        this.vx = 0;\n        this.vy = 0;\n        this.maxSpeed = 6;\n        this.acceleration = 0.5;\n        this.friction = 0.85;\n        \n        this.idleTime = 0;\n        this.breathPhase = 0;\n        this.color = '#0D9488';\n        this.outlineColor = '#065f56';\n        \n        this.collisionBoxes = [];\n    }\n    \n    update(dt) {\n        const frames = dt * 60;\n        \n        let ax = 0, ay = 0;\n        if (this.game.keys['KeyW'] || this.game.keys['ArrowUp']) ay -= 1;\n        if (this.game.keys['KeyS'] || this.game.keys['ArrowDown']) ay += 1;\n        if (this.game.keys['KeyA'] || this.game.keys['ArrowLeft']) ax -= 1;\n        if (this.game.keys['KeyD'] || this.game.keys['ArrowRight']) ax += 1;\n        \n        if (ax !== 0 || ay !== 0) {\n            const len = Math.hypot(ax, ay);\n            ax /= len; ay /= len;\n            this.vx += ax * this.acceleration * frames;\n            this.vy += ay * this.acceleration * frames;\n            this.idleTime = 0;\n        } else {\n            this.vx *= Math.pow(this.friction, frames);\n            this.vy *= Math.pow(this.friction, frames);\n            this.idleTime += dt;\n        }\n        \n        const speed = Math.hypot(this.vx, this.vy);\n        if (speed > this.maxSpeed) {\n            this.vx = (this.vx / speed) * this.maxSpeed;\n            this.vy = (this.vy / speed) * this.maxSpeed;\n        }\n        \n        const newX = this.x + this.vx * frames;\n        const newY = this.y + this.vy * frames;\n        \n        this.handleCollisions(newX, newY);\n        \n        this.breathPhase += dt * 3;\n    }\n    \n    handleCollisions(newX, newY) {\n        let finalX = this.x;\n        let finalY = this.y;\n        \n        const testRectX = { x: newX, y: this.y, width: this.width, height: this.height };\n        let collisionX = false;\n        for (const box of this.collisionBoxes) {\n            if (this.game.utils.aabb(testRectX, box)) {\n                collisionX = true;\n                break;\n            }\n        }\n        if (!collisionX) finalX = newX;\n        else this.vx = 0;\n        \n        const testRectY = { x: finalX, y: newY, width: this.width, height: this.height };\n        let collisionY = false;\n        for (const box of this.collisionBoxes) {\n            if (this.game.utils.aabb(testRectY, box)) {\n                collisionY = true;\n                break;\n            }\n        }\n        if (!collisionY) finalY = newY;\n        else this.vy = 0;\n        \n        this.x = finalX;\n        this.y = finalY;\n    }\n    \n    setCollisionBoxes(boxes) {\n        this.collisionBoxes = boxes;\n    }\n    \n    render(ctx) {\n        ctx.save();\n        ctx.translate(this.x + this.width/2, this.y + this.height/2);\n        \n        const breath = Math.sin(this.breathPhase) * 0.02;\n        const scale = 1 + breath;\n        ctx.scale(scale, scale);\n        \n        const dir = Math.atan2(this.vy, this.vx);\n        if (Math.hypot(this.vx, this.vy) > 0.1) {\n            ctx.rotate(dir + Math.PI/2);\n        }\n        \n        ctx.fillStyle = this.color;\n        ctx.beginPath();\n        ctx.ellipse(0, -4, 10, 12, 0, 0, Math.PI * 2);\n        ctx.fill();\n        \n        ctx.fillStyle = '#FFDBAC';\n        ctx.beginPath();\n        ctx.ellipse(0, -10, 8, 8, 0, 0, Math.PI * 2);\n        ctx.fill();\n        \n        ctx.fillStyle = '#1a1a2e';\n        ctx.beginPath();\n        ctx.ellipse(-3, -11, 1.5, 1.5, 0, 0, Math.PI * 2);\n        ctx.ellipse(3, -11, 1.5, 1.5, 0, 0, Math.PI * 2);\n        ctx.fill();\n        \n        ctx.fillStyle = this.color;\n        ctx.beginPath();\n        ctx.moveTo(-12, 8);\n        ctx.lineTo(0, 18);\n        ctx.lineTo(12, 8);\n        ctx.closePath();\n        ctx.fill();\n        \n        ctx.fillStyle = '#F59E0B';\n        ctx.fillRect(-10, -14, 20, 4);\n        \n        ctx.restore();\n    }\n    \n    getBounds() {\n        return { x: this.x, y: this.y, width: this.width, height: this.height };\n    }\n}",
  "assetManager.js": "export class AssetManager {\n    constructor(game) {\n        this.game = game;\n        this.assets = [];\n        this.draggedAsset = null;\n        this.dragOffset = { x: 0, y: 0 };\n        this.ghostAsset = null;\n        \n        this.assetTypes = [\n            { id: 'text', name: 'Text Block', color: '#10B981', icon: '📝', width: 120, height: 80, engagement: 10 },\n            { id: 'video', name: 'Video Lesson', color: '#3B82F6', icon: '🎥', width: 160, height: 100, engagement: 15 },\n            { id: 'quiz', name: 'Interactive Quiz', color: '#EF4444', icon: '❓', width: 100, height: 100, engagement: 25 },\n            { id: 'diagram', name: 'Clickable Diagram', color: '#8B5CF6', icon: '📊', width: 120, height: 120, engagement: 20 },\n            { id: 'audio', name: 'Audio Narration', color: '#F59E0B', icon: '🔊', width: 100, height: 60, engagement: 12 },\n            { id: 'assignment', name: 'Assignment', color: '#EC4899', icon: '📋', width: 140, height: 90, engagement: 30 }\n        ];\n        \n        this.zones = [\n            { x: 100, y: 100, width: 120, height: 100, type: 'text', name: 'Text Library' },\n            { x: 800, y: 100, width: 120, height: 100, type: 'video', name: 'Video Studio' },\n            { x: 100, y: 500, width: 120, height: 100, type: 'quiz', name: 'Widget Factory' },\n            { x: 800, y: 500, width: 120, height: 100, type: 'diagram', name: 'Diagram Lab' },\n            { x: 450, y: 100, width: 120, height: 100, type: 'audio', name: 'Audio Booth' },\n            { x: 450, y: 500, width: 120, height: 100, type: 'assignment', name: 'Assignment Hub' }\n        ];\n        \n        this.courseCanvas = { x: 300, y: 200, width: 400, height: 300, gridSize: 40 };\n        this.placedAssets = [];\n        \n        this.pickupCooldown = 0;\n    }\n    \n    update(dt) {\n        if (this.pickupCooldown > 0) this.pickupCooldown -= dt;\n        \n        if (this.game.gameState.phase === 'authoring') {\n            this.handleDragDrop();\n        } else {\n            this.handleZonePickup();\n        }\n    }\n    \n    handleZonePickup() {\n        if (this.draggedAsset || this.pickupCooldown > 0) return;\n        \n        const playerBounds = this.game.player.getBounds();\n        for (const zone of this.zones) {\n            if (this.game.utils.aabb(playerBounds, zone)) {\n                const assetType = this.assetTypes.find(t => t.id === zone.type);\n                if (assetType) {\n                    this.draggedAsset = { ...assetType, x: this.game.player.x, y: this.game.player.y - 50 };\n                    this.dragOffset = { x: this.draggedAsset.width/2, y: this.draggedAsset.height/2 };\n                    this.pickupCooldown = 0.3;\n                    this.game.audio.play('pickup');\n                    break;\n                }\n            }\n        }\n    }\n    \n    handleDragDrop() {\n        const mouse = this.game.mouse;\n        const canvas = this.courseCanvas;\n        \n        if (this.draggedAsset && !this.ghostAsset) {\n            this.ghostAsset = { ...this.draggedAsset };\n        }\n        \n        if (this.ghostAsset) {\n            const gridSize = canvas.gridSize;\n            let gx = mouse.worldX - this.dragOffset.x;\n            let gy = mouse.worldY - this.dragOffset.y;\n            \n            gx = Math.round(gx / gridSize) * gridSize;\n            gy = Math.round(gy / gridSize) * gridSize;\n            \n            gx = Math.max(canvas.x, Math.min(canvas.x + canvas.width - this.ghostAsset.width, gx));\n            gy = Math.max(canvas.y, Math.min(canvas.y + canvas.height - this.ghostAsset.height, gy));\n            \n            this.ghostAsset.x = gx;\n            this.ghostAsset.y = gy;\n            \n            this.ghostAsset.valid = this.isValidPlacement(this.ghostAsset);\n        }\n        \n        if (this.draggedAsset && !mouse.down) {\n            if (this.ghostAsset && this.ghostAsset.valid) {\n                const placed = { ...this.ghostAsset, placed: true };\n                this.placedAssets.push(placed);\n                this.game.gameState.addEngagement(placed.engagement);\n                this.game.audio.play('place');\n            } else if (this.draggedAsset) {\n                this.game.audio.play('error');\n            }\n            this.draggedAsset = null;\n            this.ghostAsset = null;\n        }\n    }\n    \n    isValidPlacement(asset) {\n        const canvas = this.courseCanvas;\n        if (asset.x < canvas.x || asset.y < canvas.y || \n            asset.x + asset.width > canvas.x + canvas.width ||\n            asset.y + asset.height > canvas.y + canvas.height) {\n            return false;\n        }\n        \n        for (const placed of this.placedAssets) {\n            if (this.game.utils.aabb(asset, placed)) return false;\n        }\n        return true;\n    }\n    \n    render(ctx) {\n        ctx.save();\n        \n        ctx.fillStyle = 'rgba(13, 148, 136, 0.1)';\n        this.zones.forEach(zone => {\n            ctx.fillRect(zone.x, zone.y, zone.width, zone.height);\n            ctx.strokeStyle = '#0D9488';\n            ctx.lineWidth = 2;\n            ctx.strokeRect(zone.x, zone.y, zone.width, zone.height);\n            \n            ctx.fillStyle = '#0D9488';\n            ctx.font = '14px Inter';\n            ctx.textAlign = 'center';\n            ctx.fillText(zone.name, zone.x + zone.width/2, zone.y - 10);\n            ctx.font = '32px Inter';\n            ctx.fillText(this.assetTypes.find(t => t.id === zone.type).icon, zone.x + zone.width/2, zone.y + zone.height/2 + 12);\n            ctx.fillStyle = 'rgba(13, 148, 136, 0.1)';\n        });\n        \n        const canvas = this.courseCanvas;\n        ctx.strokeStyle = '#0D9488';\n        ctx.lineWidth = 3;\n        ctx.setLineDash([10, 10]);\n        ctx.strokeRect(canvas.x, canvas.y, canvas.width, canvas.height);\n        ctx.setLineDash([]);\n        \n        ctx.fillStyle = 'rgba(13, 148, 136, 0.03)';\n        ctx.fillRect(canvas.x, canvas.y, canvas.width, canvas.height);\n        \n        ctx.strokeStyle = 'rgba(13, 148, 136, 0.1)';\n        ctx.lineWidth = 1;\n        for (let gx = canvas.x; gx <= canvas.x + canvas.width; gx += canvas.gridSize) {\n            ctx.beginPath();\n            ctx.moveTo(gx, canvas.y);\n            ctx.lineTo(gx, canvas.y + canvas.height);\n            ctx.stroke();\n        }\n        for (let gy = canvas.y; gy <= canvas.y + canvas.height; gy += canvas.gridSize) {\n            ctx.beginPath();\n            ctx.moveTo(canvas.x, gy);\n            ctx.lineTo(canvas.x + canvas.width, gy);\n            ctx.stroke();\n        }\n        \n        ctx.fillStyle = '#0D9488';\n        ctx.font = 'bold 16px Inter';\n        ctx.textAlign = 'center';\n        ctx.fillText('COURSE CANVAS', canvas.x + canvas.width/2, canvas.y - 15);\n        \n        this.placedAssets.forEach(asset => {\n            this.renderAsset(ctx, asset, 1);\n        });\n        \n        if (this.ghostAsset) {\n            this.renderAsset(ctx, this.ghostAsset, 0.5, this.ghostAsset.valid);\n        }\n        \n        if (this.draggedAsset && !this.ghostAsset) {\n            this.renderAsset(ctx, this.draggedAsset, 1);\n        }\n        \n        ctx.restore();\n    }\n    \n    renderAsset(ctx, asset, alpha, valid = true) {\n        ctx.save();\n        ctx.globalAlpha = alpha;\n        \n        const shadowOffset = alpha < 1 ? 8 : 0;\n        ctx.shadowColor = 'rgba(0,0,0,0.2)';\n        ctx.shadowBlur = 12;\n        ctx.shadowOffsetX = shadowOffset;\n        ctx.shadowOffsetY = shadowOffset;\n        \n        const bgColor = valid ? asset.color : '#EF4444';\n        \n        const radius = 12;\n        ctx.fillStyle = bgColor;\n        ctx.beginPath();\n        ctx.roundRect(asset.x, asset.y, asset.width, asset.height, radius);\n        ctx.fill();\n        \n        ctx.strokeStyle = valid ? 'rgba(255,255,255,0.3)' : 'rgba(255,255,255,0.5)';\n        ctx.lineWidth = 2;\n        ctx.stroke();\n        \n        ctx.fillStyle = 'white';\n        ctx.font = '28px Inter';\n        ctx.textAlign = 'center';\n        ctx.textBaseline = 'middle';\n        ctx.fillText(asset.icon, asset.x + asset.width/2, asset.y + asset.height/2 - 8);\n        \n        ctx.font = 'bold 11px Inter';\n        ctx.fillText(asset.name, asset.x + asset.width/2, asset.y + asset.height/2 + 18);\n        \n        if (asset.engagement) {\n            ctx.fillStyle = 'rgba(255,255,255,0.9)';\n            ctx.font = '10px Inter';\n            ctx.fillText(`+${asset.engagement} Engagement`, asset.x + asset.width/2, asset.y + asset.height - 8);\n        }\n        \n        ctx.restore();\n    }\n    \n    clearCourse() {\n        this.placedAssets = [];\n        this.draggedAsset = null;\n        this.ghostAsset = null;\n    }\n}",
  "canvasRenderer.js": "export class CanvasRenderer {\n    constructor(game) {\n        this.game = game;\n        this.camera = { x: 0, y: 0, targetX: 0, targetY: 0, lerp: 0.1 };\n        this.worldWidth = 1000;\n        this.worldHeight = 700;\n        \n        this.backgroundPattern = null;\n        this.createBackgroundPattern();\n    }\n    \n    createBackgroundPattern() {\n        const patternCanvas = document.createElement('canvas');\n        patternCanvas.width = 40;\n        patternCanvas.height = 40;\n        const pctx = patternCanvas.getContext('2d');\n        pctx.fillStyle = '#F8F9FA';\n        pctx.fillRect(0, 0, 40, 40);\n        pctx.fillStyle = 'rgba(13, 148, 136, 0.03)';\n        for (let i = 0; i < 40; i += 8) {\n            pctx.fillRect(i, 0, 1, 40);\n            pctx.fillRect(0, i, 40, 1);\n        }\n        this.backgroundPattern = this.game.ctx.createPattern(patternCanvas, 'repeat');\n    }\n    \n    onResize() {\n        this.updateCamera(0, true);\n    }\n    \n    updateCamera(dt, instant = false) {\n        const player = this.game.player;\n        const screenW = this.game.screenWidth;\n        const screenH = this.game.screenHeight;\n        \n        this.camera.targetX = player.x - screenW / 2 + player.width / 2;\n        this.camera.targetY = player.y - screenH / 2 + player.height / 2;\n        \n        this.camera.targetX = Math.max(0, Math.min(this.worldWidth - screenW, this.camera.targetX));\n        this.camera.targetY = Math.max(0, Math.min(this.worldHeight - screenH, this.camera.targetY));\n        \n        if (instant) {\n            this.camera.x = this.camera.targetX;\n            this.camera.y = this.camera.targetY;\n        } else {\n            const lerp = this.camera.lerp;\n            this.camera.x += (this.camera.targetX - this.camera.x) * lerp;\n            this.camera.y += (this.camera.targetY - this.camera.y) * lerp;\n        }\n    }\n    \n    renderWorld() {\n        const ctx = this.game.ctx;\n        ctx.save();\n        ctx.translate(-this.camera.x, -this.camera.y);\n        \n        ctx.fillStyle = this.backgroundPattern;\n        ctx.fillRect(this.camera.x, this.camera.y, this.game.screenWidth, this.game.screenHeight);\n        \n        ctx.fillStyle = '#E8ECEF';\n        ctx.fillRect(0, 0, this.worldWidth, this.worldHeight);\n        \n        ctx.fillStyle = this.backgroundPattern;\n        ctx.fillRect(0, 0, this.worldWidth, this.worldHeight);\n        \n        ctx.restore();\n    }\n}",
  "ui.js": "export class UI {\n    constructor(game) {\n        this.game = game;\n        this.highScore = parseInt(localStorage.getItem('courseArchitectHighScore')) || 0;\n        this.speedrunTime = 0;\n        this.speedrunActive = false;\n        \n        this.panels = [];\n        this.actionPrompt = '';\n        this.promptTimer = 0;\n        \n        this.inventoryScroll = 0;\n        this.hoveredInventoryIndex = -1;\n        \n        this.completionRate = 0;\n        this.targetCompletionRate = 0;\n        \n        this.particles = [];\n        this.shimmerProgress = 0;\n        this.publishing = false;\n    }\n    \n    onResize() {}\n    \n    update(dt) {\n        if (this.game.gameState.phase === 'navigation') {\n            this.speedrunTime += dt;\n        }\n        \n        this.completionRate += (this.targetCompletionRate - this.completionRate) * dt * 3;\n        \n        if (this.promptTimer > 0) this.promptTimer -= dt;\n        else this.actionPrompt = '';\n        \n        this.particles = this.particles.filter(p => {\n            p.life -= dt;\n            p.x += p.vx * dt;\n            p.y += p.vy * dt;\n            p.alpha = p.life / p.maxLife;\n            return p.life > 0;\n        });\n        \n        if (this.publishing) {\n            this.shimmerProgress += dt * 2;\n            if (this.shimmerProgress > 1.5) {\n                this.publishing = false;\n                this.shimmerProgress = 0;\n            }\n        }\n        \n        this.updateInventoryHover();\n    }\n    \n    updateInventoryHover() {\n        if (this.game.gameState.phase !== 'authoring') {\n            this.hoveredInventoryIndex = -1;\n            return;\n        }\n        \n        const mouse = this.game.mouse;\n        const startX = 20;\n        const y = 20;\n        const itemWidth = 70;\n        const spacing = 10;\n        \n        this.hoveredInventoryIndex = -1;\n        this.game.assetManager.assetTypes.forEach((type, i) => {\n            const x = startX + i * (itemWidth + spacing) + this.inventoryScroll;\n            if (mouse.x >= x && mouse.x <= x + itemWidth && mouse.y >= y && mouse.y <= y + 70) {\n                this.hoveredInventoryIndex = i;\n            }\n        });\n    }\n    \n    showPrompt(text) {\n        this.actionPrompt = text;\n        this.promptTimer = 3;\n    }\n    \n    addParticles(x, y, color, count = 12) {\n        for (let i = 0; i < count; i++) {\n            const angle = (Math.PI * 2 / count) * i + Math.random() * 0.5;\n            const speed = 50 + Math.random() * 100;\n            this.particles.push({\n                x, y,\n                vx: Math.cos(angle) * speed,\n                vy: Math.sin(angle) * speed,\n                color,\n                size: 4 + Math.random() * 6,\n                life: 0.5 + Math.random() * 0.5,\n                maxLife: 1,\n                alpha: 1\n            });\n        }\n    }\n    \n    triggerPublishAnimation() {\n        this.publishing = true;\n        this.shimmerProgress = 0;\n        const canvas = this.game.assetManager.courseCanvas;\const cx = canvas.x + canvas.width / 2;\n        const cy = canvas.y + canvas.height / 2;\n        for (let i = 0; i < 30; i++) {\n            const angle = (Math.PI * 2 / 30) * i;\n            const speed = 200 + Math.random() * 150;\n            this.particles.push({\n                x: cx, y: cy,\n                vx: Math.cos(angle) * speed,\n                vy: Math.sin(angle) * speed,\n                color: ['#10B981', '#3B82F6', '#F59E0B', '#8B5CF6', '#EC4899'][Math.floor(Math.random() * 5)],\n                size: 6 + Math.random() * 8,\n                life: 1 + Math.random() * 0.5,\n                maxLife: 1.5,\n                alpha: 1\n            });\n        }\n    }\n    \n    render(ctx) {\n        ctx.save();\n        ctx.setTransform(1, 0, 0, 1, 0, 0);\n        \n        this.renderTopBar(ctx);\n        this.renderPhaseUI(ctx);\n        this.renderActionPrompt(ctx);\n        this.renderParticles(ctx);\n        \n        if (this.publishing) {\n            this.renderPublishShimmer(ctx);\n        }\n        \n        ctx.restore();\n    }\n    \n    renderTopBar(ctx) {\n        const padding = 20;\n        const barHeight = 60;\n        \n        ctx.fillStyle = 'rgba(255, 255, 255, 0.95)';\n        ctx.shadowColor = 'rgba(0,0,0,0.08)';\n        ctx.shadowBlur = 20;\n        ctx.shadowOffsetY = 4;\n        ctx.fillRect(0, 0, this.game.screenWidth, barHeight);\n        ctx.shadowColor = 'transparent';\n        \n        ctx.fillStyle = '#0D9488';\n        ctx.font = 'bold 22px Inter';\n        ctx.textAlign = 'left';\n        ctx.fillText('Course Architect', padding, 3