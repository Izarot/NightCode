ing: 12px 20px;\n            background: rgba(10, 22, 40, 0.85);\n            backdrop-filter: blur(8px);\n            border-bottom: 1px solid rgba(0, 255, 213, 0.2);\n            z-index: 10;\n        }\n\n        .timer {\n            font-size: 28px;\n            font-weight: 700;\n            color: var(--accent-cyan);\n            min-width: 140px;\n            text-align: center;\n        }\n\n        .status-indicators {\n            display: flex;\n            gap: 20px;\n        }\n\n        .status-item {\n            display: flex;\n            align-items: center;\n            gap: 8px;\n        }\n\n        .stage-name {\n            font-size: 14px;\n            color: var(--text-muted);\n            font-weight: 500;\n        }\n\n        .hud-panel {\n            background: var(--bg-panel);\n            border: 1px solid rgba(0, 255, 213, 0.3);\n            border-radius: 12px;\n            padding: 12px 16px;\n            min-width: 200px;\n        }\n\n        .hud-panel h3 {\n            font-size: 11px;\n            text-transform: uppercase;\n            letter-spacing: 1px;\n            color: var(--text-muted);\n            margin-bottom: 6px;\n        }\n\n        .hud-value {\n            font-size: 22px;\n            font-weight: 700;\n            color: var(--accent-cyan);\n        }\n\n        /* Center circle / capture zones */\n        .center-circles {\n            position: absolute;\n            top: 50%; left: 50%;\n            transform: translate(-50%, -50%);\n            width: 600px;\n            height: 600px;\n            border: 2px solid var(--accent-cyan);\n            border-radius: 50%;\n            pointer-events: none;\n        }\n\n        .capture-zone {\n            position: absolute;\n            top: 0; left: 0;\n            width: 100%; height: 100%;\n            opacity: 0.6;\n            pointer-events: none;\n        }\n\n        /* Bottom mini-map */\n        .mini-map {\n            position: absolute;\n  