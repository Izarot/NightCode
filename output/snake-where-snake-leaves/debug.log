ent.getElementById('startBtn');\n\n    bestVal.textContent = bestScore;\n\n    // ---------- Helpers ----------\n    function randRange(a, b) { return a + Math.random() * (b - a); }\n    function clamp(v, a, b) { return Math.max(a, Math.min(b, v)); }\n    function dist(a, b) { return Math.hypot(a.x - b.x, a.y - b.y); }\n\n    function formatTime(ms) {\n        const total = Math.floor(ms / 1000);\n        const m = Math.floor(total / 60).toString().padStart(2, '0');\n        const s = (total % 60).toString().padStart(2, '0');\n        return m + ':' + s;\n    }\n\n    // ---------- Initialization ----------\n    function initStars() {\n        stars = [];\n        for (let i = 0; i < 120; i++) {\n            stars.push({\n                x: randRange(0, BASE_WIDTH),\n                y: randRange(0, BASE_HEIGHT),\n                size: randRange(0.5, 2.5),\n                alpha: randRange(0.3, 1)\n            });\n        }\n    }\\n\n    function initZones() {\n        burningZones = [];\n        const n = 3 + Math.floor(Math.random() * 2);\n        for (let i = 0; i < n; i++) {\n            const w = randRange(90, 160);\n            const h = randRange(90, 160);\n            const x = randRange(60, BASE_WIDTH - 60 - w);\n            const y = randRange(60, BASE_HEIGHT - 60 - h);\n            burningZones.push({ x, y, w, h, flicker: randRange(0, 6.28) });\n        }\n    }\n\n    function spawnFood() {\n        if (foods.length >= 3) return;\n        let x, y, safe, tries = 0;\n        do {\n            safe = true;\n            x = randRange(40, BASE_WIDTH - 40);\n            y = randRange(40, BASE_HEIGHT - 40);\n            for (const z of burningZones) {\n                if (x > z.x - 20 && x < z.x + z.w + 20 && y > z.y - 20 && y < z.y + z.h + 20) safe = false;\n            }\n            for (const s of snake) {\n                if (dist({ x, y }, s) < 60) safe = false;\n            }\n            tries++;\n        } while (!safe && tries < 50);\n        if (safe) foods.push({ x, y, pulse: randRange(0, 6.28) });\n    }\n\n    function resetGame() {\n        score = 0;\n        elapsed = 0;\n        heat = 0;\n        speed = BASE_SPEED;\n        direction = { x: 1, y: 0 };\n        nextDirection = { x: 1, y: 0 };\n        snake = [{ x: BASE_WIDTH / 2, y: BASE_HEIGHT / 2, age: 0 }];\n        particles = [];\n        foods = [];\n        initStars();\n        initZones();\n        spawnFood();\n        spawnFood();\n        gameState = STATE.PLAYING;\n        pauseBtn.style.display = 'none';\n        pauseText.style.display = 'none';\n        gameOverOverlay.style.display = 'none';\n        startOverlay.style.display = 'none';\n        updateTrailBar();\n    }\n\n    // ---------- Input ----------\n    function setDirection(dx, dy) {\n        const now = performance.now();\n        if (now - lastInputTime < 80) return;\n        if (dx === -direction.x && dy === -direction.y) return;\n        nextDirection = { x: dx, y: dy };\n        lastInputTime = now;\n    }\n\n    document.addEventListener('keydown', (e) => {\n        if (gameState === STATE.PLAYING) {\n            switch (e.key) {\n                case 'ArrowUp': case 'w': case 'W': setDirection(0, -1); break;\n                case 'ArrowDown': case 's': case 'S': setDirection(0, 1); break;\n                case 'ArrowLeft': case 'a': case 'A': setDirection(-1, 0); break;\n                case 'ArrowRight': case 'd': case 'D': setDirection(1, 0); break;\n                case 'p': case 'P': togglePause(); break;\n                case 'r': case 'R': if (gameState === STATE.GAMEOVER) resetGame(); break;\n            }\n        } else if (gameState === STATE.GAMEOVER && (e.key === 'r' || e.key === 'R')) {\n            resetGame();\n        } else if (gameState === STATE.PAUSED && (e.key === 'p' || e.key === 'P')) {\n            togglePause();\n        }\n    });\n\n    // Touch controls\n    let touchStart = null;\n    canvas.addEventListener('touchstart', (e) => {\n        if (e.touches.length === 1) touchStart = { x: e.touches[0].clientX, y: e.touches[0].clientY };\n    }, { passive: false });\n    canvas.addEventListener('touchend', (e) => {\n        if (!touchStart) return;\n        const t = e.changedTouches[0];\n        const dx = t.clientX - touchStart.x;\n        const dy = t.clientY - touchStart.y;\n        if (Math.hypot(dx, dy) < 20) return;\n        if (Math.abs(dx) > Math.abs(dy)) setDirection(dx > 0 ? 1 : -1, 0);\n        else setDirection(0, dy > 0 ? 1 : -1);\n        touchStart = null;\n    }, { passive: false });\n\n    function togglePause() {\n        if (gameState === STATE.PLAYING) {\n            gameState = STATE.PAUSED;\n            pauseBtn.style.display = 'none';\n            pauseText.style.display = 'block';\n            stopCrackle();\n        } else if (gameState === STATE.PAUSED) {\n            gameState = STATE.PLAYING;\n            pauseBtn.style.display = 'flex';\n            pauseText.style.display = 'none';\n            startCrackle();\n        }\n    }\n\n    pauseBtn.addEventListener('click', togglePause);\n    restartBtn.addEventListener('click', resetGame);\n    startBtn.addEventListener('click', () => { initAudio(); resetGame(); });\n\n    // ---------- Update ----------\n    function update(dt) {\n        if (gameState !== STATE.PLAYING) return;\n\n        elapsed += dt * 1000;\n\n        // Apply queued direction\n        if (nextDirection.x !== -direction.x || nextDirection.y !== -direction.y) {\n            direction = { ...nextDirection };\n        }\n\n        speed = clamp(BASE_SPEED * (1 - PENALTY * heat), MIN_SPEED_FLOOR, BASE_SPEED);\n\n        const moveDist = speed * dt;\n        const head = snake[0];\n        const newHead = { x: head.x + direction.x * moveDist, y: head.y + direction.y * moveDist };\n\n        // Wall collision\n        if (newHead.x < SEGMENT_RADIUS || newHead.x > BASE_WIDTH - SEGMENT_RADIUS ||\n            newHead.y < SEGMENT_RADIUS || newHead.y > BASE_HEIGHT - SEGMENT_RADIUS) {\n            gameOver();\n            return;\n        }\n\n        // Self collision\n        for (let i = 1; i < snake.length; i++) {\n            const seg = snake[i];\n            const d = dist(newHead, seg);\n            if (d < SEGMENT_RADIUS + 4) {\n                gameOver();\n                return;\n            }\n        }\n\n        // Food collision\n        let ate = false;\n        for (let i = foods.length - 1; i >= 0; i--) {\n            if (dist(newHead, foods[i]) < HEAD_RADIUS + FOOD_RADIUS + 4) {\n                score += 10;\n                playEat();\n                foods.splice(i, 1);\n                ate = true;\n                spawnFood();\n            }\n        }\n\n        // Move snake\n        snake.unshift(newHead);\n        if (!ate) snake.pop();\n\n        // Fire trail particles\n        for (let i = 0; i < snake.length; i++) {\n            const seg = snake[i];\n            const size = BASE_PARTICLE_SIZE * (1 + GROWTH_FACTOR * Math.min(i, 20));\n            particles.push({\n                x: seg.x + randRange(-3, 3),\n                y: seg.y + randRange(-3, 3),\n                vx: randRange(-15, 15),\n                vy: randRange(-60, -10),\n                age: 0,\n                maxAge: TRAIL_LIFETIME,\n                size: size,\n                alpha: 1\n            });\n        }\n\n        // Limit particles\n        while (particles.length > MAX_PARTICLES) particles.shift();\n\n        // Heat from trail\n        heat = clamp(heat + HEAT_GAIN * dt * 60, 0, MAX_HEAT);\n\n        // Heat from burning zones\n        for (const z of burningZones) {\n            if (newHead.x > z.x && newHead.x < z.x + z.w &&\n                newHead.y > z.y && newHead.y < z.y + z.h) {\n                heat = clamp(heat + HEAT_ZONE_GAIN * dt * 60, 0, MAX_HEAT);\n            }\n        }\n\n        // Heat decay\n        heat = clamp(heat - HEAT_DECAY * dt, 0, MAX_HEAT);\n\n        // Particle update\n        for (let