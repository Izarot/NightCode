// src/core/state.js
import { InputManager } from '../systems/input.js';
import { CollisionService } from '../core/collision.js';
import { PortalSystem } from '../entities/portal.js';
import { Snake } from '../entities/snake.js';
import { Food } from '../entities/food.js';
import { ParticleSystem } from '../entities/particles.js';
import { SoundManager } from '../sounds.js';
import { COLORS, GAME, PORTAL } from '../config/constants.js';

export class GameState {
  constructor() {
    this.input = new InputManager();
    this.collisionService = new CollisionService();
    this.snake = null;
    this.food = null;
    this.portals = [];
    this.particles = null;
    this.sound = new SoundManager();
    this.state = 'MENU'; // MENU, PLAYING, PAUSED, GAME_OVER
    this.score = 0;
    this.level = 1;
    this.foodsEaten = 0;
    this.speed = GAME.BASE_SPEED;
    this.multiplier = 1.0;
    this.gameStartTime = 0;
    this.lastUpdate = 0;
    this.isPaused = false;
    
    // Portal state
    this.activePortals = new Map(); // portalId -> {pairedId, position}
  }
  
  init() {
    this.snake = new Snake(VIRTUAL_WIDTH / 2, VIRTUAL_HEIGHT / 2, GAME.START_LENGTH);
    this.spawnFood();
    this.setupPortals();
    this.score = 0;
    this.level = 1;
    this.foodsEaten = 0;
    this.multiplier = 1.0;
    this.speed = GAME.BASE_SPEED;
    this.state = 'PLAYING';
    this.gameStartTime = performance.now();
    this.input.init();
  }
  
  setupPortals() {
    // Create 2 portals (paired)
    this.portals = [];
    // Portal A at left side, Portal B at right side
    this.portals.push({ id: 'A', x: 50, y: 200, color: COLORS.PORTAL_A });
    this.portals.push({ id: 'B', x: 350, y: 200, color: COLORS.PORTAL_B });
  }
  
  spawnFood() {
    // Random position not on snake or portals
    let valid = false;
    while (!valid) {
