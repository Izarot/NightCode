export class Snake {
  constructor(x, y, startLength) {
    this.segments = [];
    this.direction = { x: 1, y: 0 };
    this.nextDirection = { x: 1, y: 0 };
    this.growth = 0;
    this.head = { x, y };
    
    for (let i = startLength - 1; i >= 0; i--) {
      this.segments.push({ x: x - i * CELL_SIZE, y });
    }
    this.head = this.segments[0];
  }
  
  update(portals) {
    // Queue direction
    this.direction = { ...this.nextDirection };
    
    // Move
    const head = { x: this.head.x + this.direction.x * CELL_SIZE, y: this.head.y + this.direction.y * CELL_SIZE };
    
    // Portal teleportation
    let portalResult = null;
    for (const portal of portals) {
      if (portal.id === 'A' && head.x <= portal.x + 5 && Math.abs(head.y - portal.y) < 20) {
        portalResult = { portal, paired: this._getPairedPortal(portal) };
        break;
      }
      if (portal.id === 'B' && head.x >= portal.x - 5 && Math.abs(head.y - portal.y) < 20) {
        portalResult = { portal, paired: this._getPairedPortal(portal) };
        break;
      }
    }
    
    if (portalResult) {
      head = { x: portalResult.paired.x, y: portalResult.paired.y };
    }
    
    // Insert new head
    this.segments.unshift(head);
    this.head = head;
    
    // Apply growth
    if (this.growth > 0) {
      this.growth--;
    } else {
      this.segments.pop();
    }
  }
  
  _getPairedPortal(portal) {
    for (const p of this.portals) {
      if (p.id !== portal.id) return p;
    }
    return portal;
  }
  
  occupies(x, y) {
    for (const segment of this.segments) {
      if (segment.x === x && segment.y === y) return true;
    }
    return false;
  }
}


