**src/sounds.js**:
```javascript
export class SoundManager {
  constructor() {
    this.context = null;
    this.sounds = new Map();
    this.enabled = true;
  }
  
  init() {
    if (!this.context) {
      this.context = new (window.AudioContext || window.webkitAudioContext)();
    }
  }
  
  generateOscillator(type, frequency, duration, gain = 0.1) {
    if (!this.context) this.init();
    
    const oscillator = this.context.createOscillator();
    const gainNode = this.context.createGain();
    
    oscillator.type = type;
    oscillator.frequency.value = frequency;
    
    gainNode.gain.value = gain;
    gainNode.gain.exponentialRampToValueAtTime(0.001, this.context.currentTime + duration);
    
    oscillator.connect(gainNode);
    gainNode.connect(this.context.destination);
    
    oscillator.start(this.context.currentTime);
    oscillator.stop(this.context.currentTime + duration);
  }
  
  playChomp() {
    this.generateOscillator('sawtooth', 220, 0.1, 0.3);
  }
  
  playPortal() {
    this.generateOscillator('sine', 150, 0.2, 0.2);
    setTimeout(() => {
      this.generateOscillator('sine', 440, 0.1, 0.1);
    }, 150);
  }
  
  playGameOver() {
    this.generateOscillator('sine', 110, 0.5, 0.4);
    setTimeout(() => {
      this.generateOscillator('sine', 220, 0.3, 0.3);
    }, 200);
  }
  
  toggleMute() {
    this.enabled = !this.enabled;
    return this.enabled;
  }
}
```

