The game loop from the spec:
```js
const dt = 1/60;
let accumulator = 0;
function loop(timestamp) {
  const delta = timestamp - lastTimestamp;
  lastTimestamp = timestamp;
  accumulator += delta;
  while (accumulator >= dt) {
    input.update();
    state.update(dt);
    accumulator -= dt;
  }
  render();
  requestAnimationFrame(loop);
}
```

