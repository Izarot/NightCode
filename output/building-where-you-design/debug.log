amera view\n    const w = canvas.width;\n    const h = canvas.height;\n    const scale = Math.min(w / 180, h / 180);\n    const mmSize = 180 * scale;\n    \n    // Calculate offsets\n    const cmx = (w - mmSize) / 2;\n    const cmy = (h - mmSize) / 2;\n    \n    // Resize SVG\n    const original = mmCanvas;\n    const svg = original.createDocumentElement();\n    svg.setAttribute('width', mmSize);\n    svg.setAttribute('height', mmSize);\n    \n    // Draw simplified grid\n    for (let y = 0; y < CONFIG.MAP_HEIGHT; y++) {\n        for (let x = 0; x < CONFIG.MAP_WIDTH; x++) {\n            const z = gameState.zones[y][x];\n            if (z) {\n                svg.append(`<rect x="${x*CONFIG.TILE_SIZE}" y="${y*CONFIG.TILE_SIZE}" width="${CONFIG.TILE_SIZE}" height="${CONFIG.TILE_SIZE}" fill="${CONFIG.ZONE_COLORS[z]}" opacity="0.6"/>`);\n            }\n        }\n    }\n    \n    // Draw buildings\n    for (const b of gameState.builds) {\n        const bx = (b.col * CONFIG.TILE_SIZE) * gameState.camera.zoom + cmx;\n        const by = (b.row * CONFIG.TILE_SIZE) * gameState.camera.zoom + cmy;\n        svg.append(`<rect x="${bx}" y="${by}" width="${CONFIG.TILE_SIZE}" height="${CONFIG.TILE_SIZE}" fill="#5B9BD5" opacity="0.5"/>`);\n    }\n    \n    mmCanvas.innerHTML = '';\n    mmCanvas.appendChild(svg.toString());\n}\n\n// --- Event Handlers ---\nfunction selectBuilding(building) {\n    gameState.selectedBuilding = building;\n    document.querySelectorAll('.zone-tab').forEach(t => t.classList.remove('active'));\n    document.querySelector(`[data-zone="${building.type}"]`).classList.add('active');\n}\n\nfunction deselectBuilding() {\n    gameState.selectedBuilding = null;\n    document.querySelectorAll('.zone-tab').forEach(t => t.classList.remove('active'));\n}\n\nfunction moveCamera(dx, dy) {\n    const newCam = {\n        x: gameState.camera.x + dx,\n        y: gameState.camera.y + dy,\n        zoom: Math.min(2.0, Math.max(0.5, gameState.camera.zoom))\n    };\n    // Clamp 