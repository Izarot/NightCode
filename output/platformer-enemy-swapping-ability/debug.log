ore { content: ''; position: absolute; inset: 0; border: 3px solid #00ffff; transform: rotate(45deg); border-radius: 4px; box-shadow: 0 0 8px #00ffff; }\n    .swap-diamond .cooldown { position: absolute; inset: 0; border-radius: 4px; clip-path: polygon(50% 50%, 50% 0, 100% 0, 100% 100%, 50% 100%); background: rgba(0,0,0,0.6); transform: rotate(-45deg); }\n    .chain-pop { position: absolute; left: 50%; top: -20px; transform: translateX(-50%); font-weight: bold; color: #ffcc00; text-shadow: 0 0 4px #000; animation: pop 0.3s ease-out; }\n    @keyframes pop { 0% { opacity: 0; transform: translateX(-50%) scale(0.5); } 50% { opacity: 1; transform: translateX(-50%) scale(1.2); } 100% { opacity: 1; transform: translateX(-50%) scale(1); } }\n    .toast { position: absolute; left: 12px; bottom: 70px; background: rgba(0,0,0,0.7); padding: 8px 12px; border-radius: 6px; border-left: 3px solid #00ffff; animation: slideIn 0.3s ease-out; }\n    @keyframes slideIn { from { opacity: 0; transform: translateX(-20px); } to { opacity: 1; transform: translateX(0); } }\n    .screen { position: fixed; inset: 0; background: rgba(10,10,18,0.95); display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 24px; color: #e0e0ff; z-index: 10; pointer-events: auto; }\n    .screen.hidden { display: none; }\n    .screen h1 { font-size: 48px; letter-spacing: 0.1em; text-transform: uppercase; background: linear-gradient(90deg, #00ffff, #ff00ff); -webkit-background-clip: text; background-clip: text; color: transparent; }\n    .screen button { padding: 12px 32px; font-size: 18px; background: transparent; border: 2px solid #00ffff; color: #00ffff; border-radius: 4px; cursor: pointer; transition: 0.2s; }\n    .screen button:hover { background: rgba(0,255,255,0.1); }\n    .stat-row { display: flex; gap: 32px; font-size: 18px; }\n    .stat { text-align: center; }\n    .stat-value { font-size: 32px; font-weight: bold; color: #00ffff; }\n    .rank { font-size: 64px; font-weight: