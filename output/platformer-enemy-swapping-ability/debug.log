-value\" id=\"stat-shards\">0/3</div>Shards</div>\n      <div class=\"stat\"><div class=\"stat-value\" id=\"stat-chain\">1</div>Max Chain</div>\n    </div>\n    <div class=\"rank\" id=\"stat-rank\">C</div>\n    <button id=\"btn-next\">Next Level</button>\n    <button id=\"btn-retry\">Retry</button>\n  </div>\n  <div class=\"screen hidden\" id=\"screen-game-complete\">\n    <h1>Game Complete</h1>\n    <p>You've mastered the swap.</p>\n    <button id=\"btn-title\">Return to Title</button>\n  </div>\n  <div class=\"screen hidden\" id=\"screen-settings\">\n    <h1>Settings</h1>\n    <div class=\"settings-grid\" id=\"settings-grid\"></div>\n    <button id=\"btn-back\">Back</button>\n  </div>\n  <script type=\"module\" src=\"/src/main.ts\"></script>\n</body>\n</html>",
  "src/main.ts": "import { Game } from './game.js';\n\nconst canvas = document.getElementById('game-canvas') as HTMLCanvasElement;\nconst game = new Game(canvas);\ngame.start();",
  "src/core/config.ts": "export const CONFIG = {\n  // Logical resolution\n  LOGICAL_WIDTH: 960,\n  LOGICAL_HEIGHT: 540,\n  // Physics\n  TILE_SIZE: 32,\n  GRAVITY: 2400,\n  FALL_MULTIPLIER: 1.35,\n  LOW_JUMP_MULTIPLIER: 1.8,\n  JUMP_VELOCITY: -720,\n  MAX_FALL_SPEED: 980,\n  RUN_MAX_SPEED: 265,\n  GROUND_ACCEL: 2600,\n  GROUND_DECEL: 3200,\n  AIR_ACCEL: 1700,\n  AIR_DECEL: 400,\n  COYOTE_TIME: 0.09,\n  JUMP_BUFFER: 0.12,\n  JUMP_CUT_MULTIPLIER: 0.45,\n  WALL_SLIDE_SPEED: 130,\n  WALL_JUMP_VX: 280,\n  WALL_JUMP_VY: -700,\n  WALL_STICK_TIME: 0.12,\n  // Swap\n  SWAP_RANGE: 260,\n  SWAP_ANGLE: 75, // degrees\n  SWAP_COOLDOWN_BASE: 0.9,\n  SWAP_CHAIN_WINDOW: 1.4,\n  SWAP_CHAIN_MAX_RANGE_BONUS: 0.4,\n  SWAP_CHAIN_COOLDOWN_REDUCTION: 0.06,\n  SWAP_MIN_COOLDOWN: 0.35,\n  SWAP_HITSTOP: 0.07,\n  SWAP_SHAKE: 5,\n  SWAP_INVULN_BEFORE: 0.1,\n  SWAP_INVULN_AFTER: 0.25,\n  SWAP_DAZE_TIME: 0.5,\n  SWAP_RELOCKOUT: 0.4,\n  SWAP_SPEED_CLAMP: 700,\n  WISP_COOLDOWN: 0.35,\n  // Player\n  PLAYER_WIDTH: 20,\n  PLAYER_HEIGHT: 28,\n  MAX_HEARTS: 3,\n  IFRAMES: 1.2,\n  // Visual\n  PARTICLE_CAP: 400,\n  // Timing\n  FIXED_DT: 1/60,\n  MAX_STEPS: 4,\n  // Colors\n  COLORS: {\n    bg: '#0a0a12',\n    tile: '#1a1a2e',\n    tileHighlight: '#2a2a4e',\n    player: '#00ffff',\n    playerTrail: 'rgba(0,255,255,0.5)',\n    enemy: '#ff3366',\n    enemyDazed: '#ffaa00',\n    hazard: '#ff0033',\n    shard: '#ffcc00',\n    checkpoint: '#00ff88',\n    exit: '#ff00ff',\n    swapField: 'rgba(0,255,255,0.15)',\n    swapFieldBorder: '#00ffff',\n    text: '#e0e0ff',\n    uiAccent: '#00ffff',\n    uiWarn: '#ff3366',\n    chainColors: ['#00ffff', '#88ff00', '#ffcc00', '#ff6600', '#ff00ff']\n  }\n} as const;\n\nexport type Config = typeof CONFIG;",
  "src/core/timing.ts": "export class Timing {\n  fixedDt: number;\n  maxSteps: number;\n  accumulator = 0;\n  lastTime = 0;\n  timeScale = 1;\n  hitStopTimer = 0;\n  shakeIntensity = 0;\n  shakeTimer = 0;\n\n  constructor(fixedDt: number, maxSteps: number) {\n    this.fixedDt = fixedDt;\n    this.maxSteps = maxSteps;\n  }\n\n  update(currentTime: number): { steps: number; dt: number } {\n    if (this.hitStopTimer > 0) {\n      this.hitStopTimer -= currentTime - this.lastTime;\n      if (this.hitStopTimer < 0) this.hitStopTimer = 0;\n      this.lastTime = currentTime;\n      return { steps: 0, dt: 0 };\n    }\n    const frameTime = (currentTime - this.lastTime) * this.timeScale;\n    this.lastTime = currentTime;\n    this.accumulator += frameTime;\n    \n    if (this.shakeTimer > 0) {\n      this.shakeTimer -= frameTime;\n      if (this.shakeTimer < 0) this.shakeTimer = 0;\n    }\n\n    const steps = Math.min(Math.floor(this.accumulator / this.fixedDt), this.maxSteps);\n    this.accumulator -= steps * this.fixedDt;\n    return { steps, dt: this.fixedDt };\n  }\n\n  addHitStop(duration: number) { this.hitStopTimer = Math.max(this.hitStopTimer, duration); }\n  addShake(intensity: number, duration: number) { this.shakeIntensity = intensity; this.shakeTimer = duration; }\n  getShakeOffset(): { x: number; y: number } {\n    if (this.shakeTimer <= 0) return { x: 0, y: 0 };\n    const t = this.shakeTimer;\n    return {\n      x: (Math.random() - 0.5) * this.shakeIntensity * (t / 0.1),\n      y: (Math.random() - 0.5) * this.shakeIntensity * (t / 0.1)\n    };\n  }\n\n  reset() { this.accumulator = 0; this.lastTime = performance.now(); this.hitStopTimer = 0; this.shakeTimer = 0; }\n}",
  "src/input/input.ts": "export type Action = 'left' | 'right' | 'jump' | 'swap' | 'cycle' | 'pause' | 'restart';\n\nexport class Input {\n  private keyMap: Record<string, Action> = {\n    'ArrowLeft': 'left', 'KeyA': 'left',\n    'ArrowRight': 'right', 'KeyD': 'right',\n    'Space': 'jump', 'KeyZ': 'jump',\n    'KeyX': 'swap', 'KeyK': 'swap',\n    'KeyC': 'cycle', 'KeyL': 'cycle',\n    'Escape': 'pause',\n    'KeyR': 'restart'\n  };\n  private gamepadMap: Record<number, Action> = {\n    14: 'left', 15: 'right', // dpad\n    0: 'jump', // A\n    2: 'swap', // X\n    3: 'cycle', // Y\n    9: 'pause', // Start\n    5: 'restart' // RB\n  };\n  private pressed = new Set<Action>();\n  private justPressed = new Set<Action>();\n  private justReleased = new Set<Action>();\n  private buffers: Record<Action, number> = {\n    left: 0, right: 0, jump: 0, swap: 0, cycle: 0, pause: 0, restart: 0\n  };\n  private bufferTimes: Record<Action, number> = { jump: 0.12, swap: 0.10 };\n  private mouseX = 0;\n  private mouseY = 0;\n  private mouseDown = false;\n\n  constructor() {\n    window.addEventListener('keydown', e => this.onKey(e.code, true));\n    window.addEventListener('keyup', e => this.onKey(e.code, false));\n    window.addEventListener('mousemove', e => { this.mouseX = e.clientX; this.mouseY = e.clientY; });\n    window.addEventListener('mousedown', () => this.mouseDown = true);\n    window.addEventListener('mouseup', () => this.mouseDown = false);\n    window.addEventListener('gamepadconnected', () => {});\n  }\n\n  private onKey(code: string, down: boolean) {\n    const action = this.keyMap[code];\n    if (!action) return;\n    if (down) {\n      if (!this.pressed.has(action)) this.justPressed.add(action);\n      this.pressed.add(action);\n      this.buffers[action] = this.bufferTimes[action] || 0;\n    } else {\n      this.pressed.delete(action);\n      this.justReleased.add(action);\n    }\n  }\n\n  update(dt: number) {\n    this.justPressed.clear();\n    this.justReleased.clear();\n    // Gamepad polling\n    const gp = navigator.getGamepads()[0];\n    if (gp) {\n      const axes = gp.axes;\n      if (axes[0] < -0.3) this.setPressed('left'); else this.release('left');\n      if (axes[0] > 0.3) this.setPressed('right'); else this.release('right');\n      gp.buttons.forEach((btn, i) => {\n        const action = this.gamepadMap[i];\n        if (action) {\n          if (btn.pressed) this.setPressed(action);\n          else this.release(action);\n        }\n      });\n    }\n    // Decay buffers\n    for (const a of Object.keys(this.buffers) as Action[]) {\n      if (this.buffers[a] > 0) this.buffers[a] = Math.max(0, this.buffers[a] - dt);\n    }\n  }\n\n  private setPressed(action: Action) {\n    if (!this.pressed.has(action)) this.justPressed.add(action);\n    this.pressed.add(action);\n    this.buffers[action] = this.bufferTimes[action] || 0;\n  }\n  private release(action: Action) { this.pressed.delete(action); this.justReleased.add(action); }\n\n  isPressed(action: Action) { return this.pressed.has(action); }\n  isJustPressed(action: Action) { return this.justPressed.has(action); }\n  isJustReleased(action: Action) { return this.justReleased.has(action); }\n  consumeBuffer(action: Action) { this.buffers[action] = 0; }\n  hasBuffer(action: Action) { return this.buffers[action] > 0; }\n  getMousePos() { return { x: this.mouseX, y: this.mouseY }; }\n  isMouseDown() { return this.mouseDown; }\n}",
  "src/physics/physics.ts": "import { CONFIG } from '../core/config.js';\n\nexport type TileType = 0 | 1 | 2 | 3 | 4; // 0 empty, 1 solid, 2 one-way, 3 hazard, 4 conveyor\n\nexport interface TileMap {\n  width: number;\n  height: number;\n  data: TileType[];\n  conveyors: Map<number, number>; // tile index -> direction (-1 left, 1 right)\n}\n\nexport class Physics {\n  tileMap: TileMap;\n  tileSize: number;\n\n  constructor(tileMap: TileMap) {\n    this.tileMap = tileMap;\n    this.tileSize = CONFIG.TILE_SIZE;\n  }\n\n  getTile(x: number, y: number): TileType {\n    const tx = Math.floor(x / this.tileSize);\n    const ty = Math.floor(y / this.tileSize);\n    if (tx < 0 || tx >= this.tileMap.width || ty < 0 || ty >= this.tileMap.height) return 1;\n    return this.tileMap.data[ty * this.tileMap.width + tx];\n  }\n\n  isSolid(x: number, y: number): boolean {\n    const t = this.getTile(x, y);\n    return t === 1 || t === 3;\n  }\n\n  isOneWay(x: number, y: number): boolean {\n    return this.getTile(x, y) === 2;\n  }\n\n  isHazard(x: number, y: number): boolean {\n    return this.getTile(x, y) === 3;\n  }\n\n  getConveyorForce(x: number, y: number): number {\n    const tx = Math.floor(x / this.tileSize);\n    const ty = Math.floor(y / this.tileSize);\n    const idx = ty * this.tileMap.width + tx;\n    return this.tileMap.conveyors.get(idx) || 0;\n  }\n\n  // AABB sweep collision\n  checkCollision(ax: number, ay: number, aw: number, ah: number, vx: number, vy: number, dt: number): { x: number; y: number; vx: number; vy: number; grounded: boolean; walled: boolean; ceiling: boolean } {\n    let x = ax, y = ay;\n    let grounded = false, walled = false, ceiling = false;\n    \n    // X movement\n    if (vx !== 0) {\n      const nx = x + vx * dt;\n      const sign = vx > 0 ? 1 : -1;\n      const hw = aw / 2;\n      const hh = ah / 2;\n      // Check tiles along path\n      const steps = Math.ceil(Math.abs(vx) * dt / this.tileSize) + 1;\n      for (let i = 0; i < steps; i++) {\n        const tx = x + (nx - x) * (i / steps);\n        const left = tx - hw;\n        const right = tx + hw;\n        const top = y - hh;\n        const bottom = y - 0.01; // slightly above bottom for wall check\n        const checkX = sign > 0 ? right : left;\n        for (let py = top; py < bottom; py += this.tileSize / 2) {\n          if (this.isSolid(checkX, py) || (this.isOneWay(checkX, py) && sign > 0)) {\n            // Hit wall\n            x = (sign > 0 ? Math.floor((checkX) / this.tileSize) : Math.ceil((checkX) / this.tileSize)) * this.tileSize - sign * hw;\n            vx = 0;\n            walled = true;\n            gotoXEnd;\n          }\n        }\n      }\n      x = nx;\n      gotoXEnd: ;\n    }\n    \n    // Y movement\n    if (vy !== 0) {\n      const ny = y + vy * dt;\n      const sign = vy > 0 ? 1 : -1;\n      const hw = aw / 2;\n      const hh = ah / 2;\n      const steps = Math.ceil(Math.abs(vy) * dt / this.tileSize) + 1;\n      for (let i = 0; i < steps; i++) {\n        const ty = y + (ny - y) * (i / steps);\n        const left = x - hw + 0.01;\n        const right = x + hw - 0.01;\n        const checkY = sign > 0 ? ty + hh : ty - hh;\n        for (let px = left; px < right; px += this.tileSize / 2) {\n          const tile = this.getTile(px, checkY);\n          if (tile === 1 || (tile === 3 && sign > 0) || (tile === 2 && sign > 0 && vy > 0)) {\n            y = (sign > 0 ? Math.floor((checkY) / this.tileSize) : Math.ceil((checkY) / this.tileSize)) * this.tileSize - sign * hh;\n            vy = 0;\n            if (sign > 0) grounded = true; else ceiling = true;\n            gotoYEnd;\n          }\n        }\n      }\n      y = ny;\n      gotoYEnd: ;\n    }\n    \n    return { x, y, vx, vy, grounded, walled, ceiling };\n  }\n\n  // Check if AABB at position overlaps any solid tile\n  aabbOverlapsSolid(x: number, y: number, w: number, h: number): boolean {\n    const hw = w / 2, hh = h / 2;\n    const left = Math.floor((x - hw) / this.tileSize);\n    const right = Math.floor((x + hw - 0.01) / this.tileSize);\n    const top = Math.floor((y - hh) / this.tileSize);\n    const bottom = Math.floor((y - 0.01) / this.tileSize);\n    for (let ty = top; ty <= bottom; ty++) {\n      for (let tx = left; tx <= right; tx++) {\n        if (tx < 0 || tx >= this.tileMap.width || ty < 0 || ty >= this.tileMap.height) return true;\n        const t = this.tileMap.data[ty * this.tileMap.width + tx];\n        if (t === 1 || t === 3) return true;\n      }\n    }\n    return false;\n  }\n}",
  "src/entities/player.ts": "import { CONFIG } from '../core/config.js';\nimport { Physics } from '../physics/physics.js';\nimport { Input, Action } from '../input/input.js';\n\nexport class Player {\n  x = 0; y = 0;\n  vx = 0; vy = 0;\n  width = CONFIG.PLAYER_WIDTH;\n  height = CONFIG.PLAYER_HEIGHT;\n  facing = 1;\n  grounded = false;\n  walled = false;\n  ceiling = false;\n  coyoteTimer = 0;\n  jumpBufferTimer = 0;\n  wallStickTimer = 0;\n  wallSide = 0;\n  hearts = CONFIG.MAX_HEARTS;\n  maxHearts = CONFIG.MAX_HEARTS;\n  invulnTimer = 0;\n  phaseTimer = 0; // swap invulnerability\n  dazedTimer = 0;\n  shards = 0;\n  deaths = 0;\n  swapCooldown = 0;\n  swapChain = 0;\n  swapChainTimer = 0;\n  lastSwapTime = -999;\n  targetEnemy: Enemy | null = null;\n  enemies: Enemy[] = [];\n  physics: Physics;\n  input: Input;\n  onDeath: () => void = () => {};\n  onShardCollect: () => void = () => {};\n  onCheckpoint: () => void = () => {};\n  onExit: () => void = () => {};\n\n  constructor(physics: Physics, input: Input) {\n    this.physics = physics;\n    this.input = input;\n  }\n\n  spawn(x: number, y: number) {\n    this.x = x; this.y = y;\n    this.vx = 0; this.vy = 0;\n    this.grounded = false; this.walled = false;\n    this.coyoteTimer = 0; this.jumpBufferTimer = 0;\n    this.wallStickthis.wallStickTimer = 0; this.wallSide = 0;\n    this.invulnTimer = 0; this.phaseTimer = 0; this.dazedTimer = 0;\n    this.swapCooldown = 0; this.swapChain = 0; this.swapChainTimer = 0;\n    this.lastSwapTime = -999; this.targetEnemy = null;\n  }\n\n  update(dt: number) {\n    if (this.dazedTimer > 0) {\n      this.dazedTimer -= dt;\n      this.vx *= 0.95;\n      return;\n    }\n    \n    // Timers\n    if (this.invulnTimer > 0) this.invulnTimer -= dt;\n    if (this.phaseTimer > 0) this.phaseTimer -= dt;\n    if (this.swapCooldown > 0) this.swapCooldown -= dt;\n    if (this.swapChainTimer > 0) {\n      this.swapChainTimer -= dt;\n      if (this.swapChainTimer <= 0) this.swapChain = 0;\n    }\n    \n    // Input\n    const left = this.input.isPressed('left');\n    const right = this.input.isPressed('right');\n    const jumpPressed = this.input.isPressed('jump');\n    const jumpJust = this.input.isJustPressed('jump');\n    const swapJust = this.input.isJustPressed('swap');\n    \n    // Jump buffer\n    if (jumpJust) this.jumpBufferTimer = CONFIG.JUMP_BUFFER;\n    else this.jumpBufferTimer = Math.max(0, this.jumpBufferTimer - dt);\n    \n    // Coyote time\n    if (this.grounded) this.coyoteTimer = CONFIG.COYOTE_TIME;\n    else this.coyoteTimer = Math.max(0, this.coyoteTimer - dt);\n    \n    // Wall stick\n    if (this.walled && !this.grounded && this.vy > 0) {\n      if (this.wallStickTimer < CONFIG.WALL_STICK_TIME) this.wallStickTimer += dt;\n      this.vy = Math.min(this.vy, CONFIG.WALL_SLIDE_SPEED);\n    } else {\n      this.wallStickTimer = 0;\n    }\n    \n    // Horizontal movement\n    let targetVx = 0;\n    if (left) targetVx -= 1;\n    if (right) targetVx += 1;\n    \n    if (targetVx !== 0) {\n      this.facing = targetVx > 0 ? 1 : -1;\n      if (this.grounded) {\n        this.vx = this.approach(this.vx, targetVx * CONFIG.RUN_MAX_SPEED, CONFIG.GROUND_ACCEL * dt);\n      } else {\n        this.vx = this.approach(this.vx, targetVx * CONFIG.RUN_MAX_SPEED, CONFIG.AIR_ACCEL * dt);\n      }\n    } else {\n      if (this.grounded) {\n        this.vx = this.approach(this.vx, 0, CONFIG.GROUND_DECEL * dt);\n      } else {\n        this.vx = this.approach(this.vx, 0, CONFIG.AIR_DECEL * dt);\n      }\n    }\n    \n    // Conveyor force\n    const conveyor = this.physics.getConveyorForce(this.x, this.y + this.height / 2);\n    if (conveyor !== 0) this.vx += conveyor * 120 * dt;\n    \n    // Jump\n    const canJump = this.grounded || this.coyoteTimer > 0 || (this.walled && this.wallStickTimer > 0);\n    if (this.jumpBufferTimer > 0 && canJump) {\n      if (this.walled && !this.grounded && this.wallStickTimer > 0) {\n        this.vx = -this.wallSide * CONFIG.WALL_JUMP_VX;\n        this.vy = CONFIG.WALL_JUMP_VY;\n        this.wallStickTimer = 0;\n        this.jumpBufferTimer = 0;\n      } else {\n        this.vy = CONFIG.JUMP_VELOCITY;\n        this.coyoteTimer = 0;\n        this.jumpBufferTimer = 0;\n      }\n    }\n    \n    // Jump cut\n    if (this.input.isJustReleased('jump') && this.vy < 0) {\n      this.vy *= CONFIG.JUMP_CUT_MULTIPLIER;\n    }\n    \n    // Gravity\n    if (this.vy < 0) this.vy += CONFIG.GRAVITY * CONFIG.LOW_JUMP_MULTIPLIER * dt;\n    else this.vy += CONFIG.GRAVITY * CONFIG.FALL_MULTIPLIER * dt;\n    this.vy = Math.min(this.vy, CONFIG.MAX_FALL_SPEED);\n    \n    // Swap logic\n    if (swapJust && this.swapCooldown <= 0 && this.targetEnemy && !this.targetEnemy.dead) {\n      this.performSwap();\n    }\n    \n    // Physics step\n    const result = this.physics.checkCollision(this.x, this.y, this.width, this.height, this.vx, this.vy, dt);\n    this.x = result.x; this.y = result.y;\n    this.vx = result.vx; this.vy = result.vy;\n    this.grounded = result.grounded;\n    this.walled = result.walled;\n    this.ceiling = result.ceiling;\n    if (result.walled) this.wallSide = this.vx > 0 ? 1 : -1;\n    \n    // Hazard check\n    if (this.physics.isHazard(this.x, this.y + this.height / 2 - 2) && this.invulnTimer <= 0 && this.phaseTimer <= 0) {\n      this.takeDamage();\n    }\n    \n    // Update target enemy\n    this.updateTargetEnemy();\n  }\n\n  private approach(current: number, target: number, maxChange: number): number {\n    if (current < target) return Math.min(current + maxChange, target);\n    return Math.max(current - maxChange, target);\n  }\n\n  private updateTargetEnemy() {\n    let best: Enemy | null = null;\n    let bestScore = -1;\n    const range = CONFIG.SWAP_RANGE * (1 + this.swapChain * CONFIG.SWAP_CHAIN_MAX_RANGE_BONUS);\n    const angleRad = (CONFIG.SWAP_ANGLE * Math.PI) / 180;\n    const halfAngle = angleRad / 2;\n    \n    for (const enemy of this.enemies) {\n      if (enemy.dead || enemy.dazedTimer > 0) continue;\n      const dx = enemy.x - this.x;\n      const dy = enemy.y - this.y;\n      const dist = Math.hypot(dx, dy);\n      if (dist > range) continue;\n      const angle = Math.atan2(dy, dx);\n      const facingAngle = this.facing === 1 ? 0 : Math.PI;\n      const diff = Math.abs(((angle - facingAngle + Math.PI) % (2 * Math.PI)) - Math.PI);\n      if (diff > halfAngle) continue;\n      const score = (range - dist) * Math.cos(diff);\n      if (score > bestScore) {\n        bestScore = score;\n        best = enemy;\n      }\n    }\n    this.targetEnemy = best;\n  }\n\n  private performSwap() {\n    if (!this.targetEnemy) return;\n    \n    const enemy = this.targetEnemy;\n    const now = performance.now() / 1000;\n    const chainWindow = now - this.lastSwapTime < CONFIG.SWAP_CHAIN_WINDOW;\n    \n    if (chainWindow) {\n      this.swapChain = Math.min(this.swapChain + 1, 5);\n      this.swapChainTimer = CONFIG.SWAP_CHAIN_WINDOW;\n    } else {\n      this.swapChain = 1;\n      this.swapChainTimer = CONFIG.SWAP_CHAIN_WINDOW;\n    }\n    this.lastSwapTime = now;\n    \n    // Swap positions\n    const px = this.x, py = this.y;\n    this.x = enemy.x; this.y = enemy.y;\n    enemy.x = px; enemy.y = py;\n    \n    // Transfer momentum\n    const playerSpeed = Math.hypot(this.vx, this.vy);\n    const enemySpeed = Math.hypot(enemy.vx, enemy.vy);\n    this.vx = enemy.vx * 0.5;\n    this.vy = enemy.vy * 0.5;\n    enemy.vx = this.vx * 0.5;\n    enemy.vy = this.vy * 0.5;\n    \n    // Clamp speed\n    const speed = Math.hypot(this.vx, this.vy);\n    if (speed > CONFIG.SWAP_SPEED_CLAMP) {\n      this.vx = (this.vx / speed) * CONFIG.SWAP_SPEED_CLAMP;\n      this.vy = (this.vy / speed) * CONFIG.SWAP_SPEED_CLAMP;\n    }\n    \n    // Daze enemy\n    enemy.dazedTimer = CONFIG.SWAP_DAZE_TIME;\n    enemy.vx *= 0.3; enemy.vy *= 0.3;\n    \n    // Cooldown\n    this.swapCooldown = Math.max(CONFIG.SWAP_MIN_COOLDOWN, CONFIG.SWAP_COOLDOWN_BASE - this.swapChain * CONFIG.SWAP_CHAIN_COOLDOWN_REDUCTION);\n    \n    // Invulnerability\n    this.phaseTimer = CONFIG.SWAP_INVULN_BEFORE + CONFIG.SWAP_INVULN_AFTER;\n    \n    // Hitstop & shake\n    this.physics.addHitStop?.(CONFIG.SWAP_HITSTOP);\n    this.physics.addShake?.(CONFIG.SWAP_SHAKE, 0.15);\n    \n    // Relockout\n    enemy.swapLockout = CONFIG.SWAP_RELOCKOUT;\n  }\n\n  takeDamage() {\n    if (this.invulnTimer > 0 || this.phaseTimer > 0) return;\n    this.hearts--;\n    this.invulnTimer = CONFIG.IFRAMES;\n    if (this.hearts <= 0) {\n      this.deaths++;\n      this.onDeath();\n    }\n  }\n\n  heal(amount: number) {\n    this.hearts = Math.min(this.maxHearts, this.hearts + amount);\n  }\n\n  addShard() {\n    this.shards++;\n    this.onShardCollect();\n  }\n\n  setCheckpoint() { this.onCheckpoint(); }\n  triggerExit() { this.onExit(); }\n\n  getSwapCooldownRatio(): number {\n    return Math.max(0, this.swapCooldown / CONFIG.SWAP_COOLDOWN_BASE);\n  }\n\n  getSwapRange(): number {\n    return CONFIG.SWAP_RANGE * (1 + this.swapChain * CONFIG.SWAP_CHAIN_MAX_RANGE_BONUS);\n  }\n\n  getSwapAngle(): number { return CONFIG.SWAP_ANGLE; }\n}\n\nexport interface Enemy {\n  x: number; y: number;\n  vx: number; vy: number;\n  width: number; height: number;\n  dead: boolean;\n  dazedTimer: number;\n  swapLockout: number;\n  patrolLeft: number; patrolRight: number;\n  facing: number;\n  type: 'walker' | 'flyer' | 'shooter';\n  shootTimer: number;\n}",
  "src/entities/enemy.ts": "import { CONFIG } from '../core/config.js';\nimport { Physics } from '../physics/physics.js';\nimport { Enemy as EnemyType } from './player.js';\n\nexport class EnemyManager {\n  enemies: EnemyType[] = [];\n  physics: Physics;\n  particles: ParticleSystem;\n\n  constructor(physics: Physics, particles: ParticleSystem) {\n    this.physics = physics;\n    this.particles = particles;\n  }\n\n  spawn(x: number, y: number, type: EnemyType['type'] = 'walker', patrolLeft?: number, patrolRight?: number) {\n    const enemy: EnemyType = {\n      x, y,\n      vx: 0, vy: 0,\n      width: 24, height: 24,\n      dead: false,\n      dazedTimer: 0,\n      swapLockout: 0,\n      patrolLeft: patrolLeft ?? x - 80,\n      patrolRight: patrolRight ?? x + 80,\n      facing: 1,\n      type,\n      shootTimer: 0\n    };\n    this.enemies.push(enemy);\n    return enemy;\n  }\n\n  update(dt: number, playerX: number, playerY: number) {\n    for (const enemy of this.enemies) {\n      if (enemy.dead) continue;\n      \n      if (enemy.dazedTimer > 0) {\n        enemy.dazedTimer -= dt;\n        enemy.vx *= 0.9;\n        enemy.vy += CONFIG.GRAVITY * dt;\n        enemy.vy = Math.min(enemy.vy, CONFIG.MAX_FALL_SPEED);\n      } else if (enemy.swapLockout > 0) {\n        enemy.swapLockout -= dt;\n      } else {\n        this.updateAI(enemy, dt, playerX, playerY);\n      }\n      \n      // Physics\n      const result = this.physics.checkCollision(enemy.x, enemy.y, enemy.width, enemy.height, enemy.vx, enemy.vy, dt);\n      enemy.x = result.x; enemy.y = result.y;\n      enemy.vx = result.vx; enemy.vy = result.vy;\n      enemy.grounded = result.grounded;\n      enemy.walled = result.walled;\n      \n      // Hazard death\n      if (this.physics.isHazard(enemy.x, enemy.y + enemy.height / 2)) {\n        this.killEnemy(enemy);\n      }\n    }\n    this.enemies = this.enemies.filter(e => !e.dead);\n  }\n\n  private updateAI(enemy: EnemyType, dt: number, playerX: number, playerY: number) {\n    switch (enemy.type) {\n      case 'walker':\n        if (enemy.facing > 0) {\n          enemy.vx = this.approach(enemy.vx, 80, 400 * dt);\n          if (enemy.x >= enemy.patrolRight || enemy.walled) enemy.facing = -1;\n        } else {\n          enemy.vx = this.approach(enemy.vx, -80, 400 * dt);\n          if (enemy.x <= enemy.patrolLeft || enemy.walled) enemy.facing = 1;\n        }\n        break;\n      case 'flyer':\n        const dx = playerX - enemy.x;\n        const dy = playerY - enemy.y;\n        const dist = Math.hypot(dx, dy);\n        if (dist < 200) {\n          enemy.vx = this.approach(enemy.vx, (dx / dist) * 120, 600 * dt);\n          enemy.vy = this.approach(enemy.vy, (dy / dist) * 120 - 50, 600 * dt);\n        } else {\n          enemy.vy += Math.sin(performance.now() / 300 + enemy.x) * 30 * dt;\n        }\n        break;\n      case 'shooter':\n        enemy.vx = this.approach(enemy.vx, 0, 800 * dt);\n        enemy.shootTimer -= dt;\n        if (enemy.shootTimer <= 0 && Math.abs(playerX - enemy.x) < 300 && Math.abs(playerY - enemy.y) < 100) {\n          enemy.shootTimer = 2;\n          this.particles.spawnProjectile(enemy.x, enemy.y, playerX > enemy.x ? 1 : -1);\n        }\n        break;\n    }\n    enemy.vy += CONFIG.GRAVITY * dt;\n    enemy.vy = Math.min(enemy.vy, CONFIG.MAX_FALL_SPEED);\n  }\n\n  private approach(current: number, target: number, maxChange: number): number {\n    if (current < target) return Math.min(current + maxChange, target);\n    return Math.max(current - maxChange, target);\n  }\n\n  killEnemy(enemy: EnemyType) {\n    enemy.dead = true;\n    for (let i = 0; i < 8; i++) {\n      this.particles.add(enemy.x, enemy.y, CONFIG.COLORS.enemy, Math.random() * 6.28, 80 + Math.random() * 80, 0.4);\n    }\n  }\n\n  getEnemies(): EnemyType[] { return this.enemies; }\n  clear() { this.enemies = []; }\n}",
  "src/entities/particles.ts": "import { CONFIG } from '../core/config.js';\n\nexport interface Particle {\n  x: number; y: number;\n  vx: number; vy: number;\n  life: number; maxLife: number;\n  color: string;\n  size: number;\n  type: 'normal' | 'trail' | 'swap' | 'shard' | 'projectile';\n}\n\nexport class ParticleSystem {\n  particles: Particle[] = [];\n  maxParticles = CONFIG.PARTICLE_CAP;\n\n  add(x: number, y: number, color: string, angle: number, speed: number, life: number, size = 3, type: Particle['type'] = 'normal') {\n    if (this.particles.length >= this.maxParticles) return;\n    this.particles.push({\n      x, y,\n      vx: Math.cos(angle) * speed,\n      vy: Math.sin(angle) * speed,\n      life, maxLife: life,\n      color, size, type\n    });\n  }\n\n  spawnTrail(x: number, y: number, color: string) {\n    this.add(x, y, color, Math.random() * 6.28, 20 + Math.random() * 30, 0.2, 2, 'trail');\n  }\n\n  spawnSwapBurst(x: number, y: number, chain: number) {\n    const colors = CONFIG.COLORS.chainColors;\n    const color = colors[Math.min(chain - 1, colors.length - 1)];\n    for (let i = 0; i < 16; i++) {\n      this.add(x, y, color, (i / 16) * 6.28, 150 + Math.random() * 100, 0.5 + Math.random() * 0.3, 4, 'swap');\n    }\n  }\n\n  spawnShardCollect(x: number, y: number) {\n    for (let i = 0; i < 12; i++) {\n      this.add(x, y, CONFIG.COLORS.shard, (i / 12) * 6.28, 100 + Math.random() * 80, 0.6, 5, 'shard');\n    }\n  }\n\n  spawnProjectile(x: number, y: number, dir: number) {\n    this.add(x, y, CONFIG.COLORS.hazard, dir === 1 ? 0 : Math.PI, 300, 2, 6, 'projectile');\n  }\n\n  spawnDeath(x: number, y: number) {\n    for (let i = 0; i < 20; i++) {\n      this.add(x, y, CONFIG.COLORS.player, Math.random() * 6.28, 100 + Math.random() * 150, 0.5 + Math.random() * 0.5, 4);\n    }\n  }\n\n  spawnCheckpoint(x: number, y: number) {\n    for (let i = 0; i < 16; i++) {\n      this.add(x, y, CONFIG.COLORS.checkpoint, (i / 16) * 6.28, 80 + Math.random() * 60, 0.8, 4);\n    }\n  }\n\n  update(dt: number) {\n    for (let i = this.particles.length - 1; i >= 0; i--) {\n      const p = this.particles[i];\n      p.life -= dt;\n      if (p.life <= 0) {\n        this.particles.splice(i, 1);\n        continue;\n      }\n      const t = p.life / p.maxLife;\n      p.x += p.vx * dt;\n      p.y += p.vy * dt;\n      if (p.type !== 'projectile') {\n        p.vy += 200 * dt;\n        p.vx *= 0.98;\n        p.vy *= 0.98;\n      }\n    }\n  }\n\n  render(ctx: CanvasRenderingContext2D, camX: number, camY: number) {\n    for (const p of this.particles) {\n      const t = p.life / p.maxLife;\n      ctx.globalAlpha = t;\n      ctx.fillStyle = p.color;\n      const size = p.size * t;\n      ctx.beginPath();\n      ctx.arc(p.x - camX, p.y - camY, Math.max(1, size), 0, Math.PI * 2);\n      ctx.fill();\n    }\n    ctx.globalAlpha = 1;\n  }\n\n  clear() { this.particles = []; }\n}",
  "src/levels/levels.ts": "import { CONFIG } from '../core/config.js';\nimport { TileMap, TileType } from '../physics/physics.js';\nimport { EnemyManager } from '../entities/enemy.js';\nimport { ParticleSystem } from '../entities/particles.js';\nimport { Player } from '../entities/player.js';\n\nexport interface LevelData {\n  tileMap: TileMap;\n  playerStart: { x: number; y: number };\n  checkpoints: { x: number; y: number }[];\n  shards: { x: number; y: number; collected: boolean }[];\n  exit: { x: number; y: number };\n  enemies: { x: number; y: number; type: 'walker' | 'flyer' | 'shooter'; patrolLeft?: number; patrolRight?: number }[];\n  parallax: { color: string; speed: number }[];\n}\n\nfunction createTileMap(width: number, height: number, layout: string[]): TileMap {\n  const data: TileType[] = [];\n  const conveyors = new Map<number, number>();\n  for (let y = 0; y < height; y++) {\n    const row = layout[y];\n    for (let x = 0; x < width; x++) {\n      const char = row[x];\n      let tile: TileType = 0;\n      switch (char) {\n        case '#': tile = 1; break;\n        case '~': tile = 2; break;\n        case '^': tile = 3; break;\n        case '>': tile = 4; conveyors.set(y * width + x, 1); break;\n        case '<': tile = 4; conveyors.set(y * width + x, -1); break;\n      }\n      data.push(tile);\n    }\n  }\n  return { width, height, data, conveyors };\n}\n\nexport const LEVELS: LevelData[] = [\n  // Level 1 - Tutorial\n  {\n    tileMap: createTileMap(30, 17, [\n      '##############################',\n      '#                            #',\n      '#                            #',\n      '#                            #',\n      '#                            #',\n      '#                            #',\n      '#              *             #',\n      '#                            #',\n      '#                            #',\n      '#                            #',\n      '#                            #',\n      '#                            #',\n     