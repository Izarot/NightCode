<title>Tempest Tiles</title>
<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🌩️</text></svg>">
<style>
*{margin:0;padding:0;box-sizing:border-box}
html,body{width:100%;height:100%;overflow:hidden;background:#0a0a1a;font-family:'Segoe UI',system-ui,sans-serif}
body{display:flex;justify-content:center;align-items:center}
#wrap{position:relative;width:1920px;height:1080px;transform-origin:center center;flex-shrink:0}
canvas{display:block;image-rendering:pixelated;background:#0d0d2b;touch-action:none}
#hud{position:absolute;top:0;left:0;width:100%;height:100%;pointer-events:none;z-index:10}
.panel{position:absolute;pointer-events:auto;background:rgba(10,10,30,.75);border:1px solid rgba(255,255,255,.12);border-radius:12px;backdrop-filter:blur(8px)}
#barometer{top:16px;left:50%;transform:translateX(-50%);display:flex;gap:6px;padding:8px 14px}
.bslot{width:52px;height:52px;border-radius:10px;display:flex;flex-direction:column;align-items:center;justify-content:center;font-size:22px;font-weight:700;transition:all .3s;position:relative;overflow:hidden}
.bslot .count{font-size:10px;opacity:.7;position:absolute;bottom:2px}
.bslot.active{box-shadow:0 0 16px var(--bc),inset 0 0 8px var(--bc)}
.bslot.current{outline:2px solid #fff;outline-offset:1px}
#scorePanel{top:16px;right:16px;min-width:180px;padding:12px 16px}
.score-row{display:flex;justify-content:space-between;align-items:center;margin:4px 0;color:#e0e0ff;font-size:14px}
.score-val{font-weight:700;font-size:18px;color:#fff}
#cyclePanel{top:16px;left:16px;min-width:160px;padding:12px 16px}
.cycle-dots{display:flex;gap:6px;margin-top:6px}
.cdot{width:18px;height:18px;border-radius:50%;border:2px solid rgba(255,255,255,.2);transition:all .3s}
.cdot.filled{border-color:#fff;background:var(--cc)}
#shuffleBtn{bottom:16px;right:16px;padding:10px 20px;font-size:14px;font-weight:700;color:#fff;background:linear-gradient(135deg,#e74c3c,#c0392b);border:none;border-radius:10px;cursor:pointer;transition:all .2s;pointer-events:auto}
#shuffleBtn:hover{transform:scale(1.05);box-shadow:0 0 20px rgba(231,76,60,.5)}
#shuffleBtn:disabled{opacity:.4;cursor:not-allowed;transform:none;box-shadow:none}
#timerPanel{bottom:16px;left:16px;min-width:120px;padding:8px 14px;color:#aaa;font-size:13px}
#startScreen{position:absolute;top:0;left:0;width:100%;height:100%;display:flex;flex-direction:column;align-items:center;justify-content:center;background:rgba(5,5,20,.92);z-index:20;pointer-events:auto}
#startScreen h1{font-size:56px;color:#fff;text-shadow:0 0 30px rgba(100,149,237,.6);margin-bottom:8px;letter-spacing:2px}
#startScreen .subtitle{color:#888;font-size:16px;margin-bottom:32px}
#startScreen button{padding:14px 48px;font-size:20px;font-weight:700;color:#fff;background:linear-gradient(135deg,#667eea,#764ba2);border:none;border-radius:12px;cursor:pointer;transition:all .2s;pointer-events:auto}
#startScreen button:hover{transform:scale(1.05);box-shadow:0 0 30px rgba(102,126,234,.5)}
#endScreen{position:absolute;top:0;left:0;width:100%;height:100%;display:none;flex-direction:column;align-items:center;justify-content:center;background:rgba(5,5,20,.92);z-index:20;pointer-events:auto}
#endScreen h2{font-size:42px;color:#fff;margin-bottom:12px}
#endScreen .stats{color:#ccc;font-size:16px;margin:6px 0;text-align:center}
#endScreen button{margin-top:24px;padding:12px 36px;font-size:16px;font-weight:700;color:#fff;background:linear-gradient(135deg,#667eea,#764ba2);border:none;border-radius:10px;cursor:pointer;pointer-events:auto}
#weatherBanner{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);font-size:48px;font-weight:900;color:var(--wc);text-shadow:0 0 40px var(--wc);opacity:0;pointer-events:none;z-index:15;transition:opacity .5s;letter-spacing:4px}
#weatherBanner.show{opacity:1}
</style>
</head>
<body>
<div id="wrap">
<canvas id="c"></canvas>
<div id="hud">
<div class="panel" id="barometer"></div>
<div class="panel" id="scorePanel">
<div class="score-row"><span>SCORE</span><span class="score-val" id="scoreVal">0</span></div>
<div class="score-row"><span>COMBO</span><span class="score-val" id="comboVal">x1</span></div>
<div class="score-row"><span>TIME</span><span class="score-val" id="timeVal">0:00</span></div>
</div>
<div class="panel" id="cyclePanel">
<div style="color:#ccc;font-size:13px;margin-bottom:4px">CYCLE</div>
<div class="cycle-dots" id="cycleDots"></div>
</div>
<div class="panel" id="timerPanel">SPEEDRUN</div>
<button id="shuffleBtn">RESTACK (3)</button>
<div id="weatherBanner"></div>
</div>
<div id="startScreen">
<h1>🌩️ TEMPEST TILES 🌩️</h1>
<div class="subtitle">Survive the storm · Match tiles · Weather shifts</div>
<button id="startBtn">START</button>
</div>
<div id="endScreen">
<h2 id="endTitle">STORM CLEARED!</h2>
<div class="stats" id="endStats"></div>
<button id="restartBtn">PLAY AGAIN</button>
</div>
</div>
<script>
"use strict";
// ======================== CONFIG ========================
const CFG={W:1920,H:1080,TS:72,TSW:8,STIFF:45,DAMP:8.5,GRAV:1200,MAXCYC:10,SHUFFLES:3,BAROMSZ:5,WEATHERMIN:3,WEATHERMAX:5};
// ======================== DATA ========================
const TT=[
{id:0,name:"Bamboo",emoji:"🎋",color:"#4CAF50"},
{id:1,name:"Chars",emoji:"🀇",color:"#E91E63"},
{id:2,name:"Dots",emoji:"🔴",color:"#FF9800"},
{id:3,name:"Winds",emoji:"🌬",color:"#2196F3"},
{id:4,name:"Dragons",emoji:"🐉",color:"#F44336"},
{id:5,name:"Seasons",emoji:"🌸",color:"#9C27B0"}
];
const WT=[
{id:0,name:"Wind",icon:"🌬",color:"#87CEEB"},
{id:1,name:"Rain",icon:"🌧",color:"#4FC3F7"},
{id:2,name:"Lightning",icon:"⚡",color:"#FFEB3B"},
{id:3,name:"Quake",icon:"🌋",color:"#8D6E63"},
{id:4,name:"Fog",icon:"🌫",color:"#B0BEC5"}
];
// ======================== STATE ========================
let G={
state:"BOOT",tiles:[],selected:[],cursor:{x:CFG.W/2,y:CFG.H/2,vx:0,vy:0,tx:CFG.W/2,ty:CFG.H/2,st:0},
weather:null,baro:[],score:0,combo:0,chainT:0,shuffles:CFG.SHUFFLES,pressure:0,cycle:0,maxCycles:CFG.MAXCYC,
timer:0,highScore:0,particles:[],shake:0,flash:0,lockout:0,windDrift:0,rainDrops:[],fogAlpha:0,
audio:null,lastTime:0,running:false
};
// ======================== AUDIO ========================
class Audio{
constructor(){this.ctx=null;this.enabled=true}
init(){try{this.ctx=new(window.AudioContext||window.webkitAudioContext)()}catch(e){this.enabled=false}}
play(freq,dur=.15,type="sine",vol=.12){
if(!this.ctx||!this.enabled)return;
try{
const o=this.ctx.createOscillator(),g=this.ctx.createGain();
o.type=type;o.frequency.value=freq;
g.gain.setValueAtTime(vol,this.ctx.currentTime);
g.gain.exponentialRampToValueAtTime(.001,this.ctx.currentTime+dur);
o.connect(g);g.connect(this.ctx.destination);
o.start();o.stop(this.ctx.currentTime+dur);
}catch(e){}
}
match(){this.play(660,.1,"sine",.1);setTimeout(()=>this.play(880,.12,"sine",.1),60)}
miss(){this.play(200,.2,"sawtooth",.06)}
weather(){this.play(110,.5,"triangle",.08)}
chain(){this.play(440,.08,"sine",.08);setTimeout(()=>this.play(554,.08,"sine",.08),50);setTimeout(()=>this.play(659,.1,"sine",.08),100)}
win(){[523,659,784,1047].forEach((f,i)=>setTimeout(()=>this.play(f,.3,"sine",.1),i*150))}
lose(){[400,350,300,250].forEach((f,i)=>setTimeout(()=>this.play(f,.4,"sawtooth",.08),i*200))}
click(){this.play(800,.05,"square",.04)}
}
G.audio=new Audio();
// ======================== TILES ========================
function genTiles(){
const tiles=[];const rows=12;const total=rows*rows;
for(let r=0;r<rows;r++){
const cols=r*2+1;
for(let c=0;c<cols;c++){
tiles.push({row:r,col:c,type:Math.floor(Math.random()*TT.length),x:0,y:0,vy:0,removed:false,blocked:false});
}
}
// center horizontally
const totalW=rows*CFG.TSW*2-CFG.TSW;
const startX=(CFG.W-totalW)/2;
tiles.forEach(t=>{t.x=startX+((t.col-(rows-1)/2)*CFG.TSW);t.y=60+t.row*CFG.TSW});
return tiles;}
function findFree(t){
if(t.removed)return false;
const above=tiles.find(x=>x.row===t.row-1&&x.col===t.col&&!x.removed);
const left=tiles.find(x=>x.row===t.row&&x.col===t.col-1&&!x.removed);
const right=tiles.find(x=>x.row===t.row&&x.col===t.col+1&&!x.removed);
return !above&&!left&&!right;
}
function updateBlocked(){
tiles.forEach(t=>{t.blocked=findFree(t)?false:true});}
function findMatches(){
const pairs=[];
for(let i=0;i<tiles.length;i++){
if(tiles[i].removed)continue;
if(!findFree(tiles[i]))continue;
for(let j=i+1;j<tiles.length;j++){
if(tiles[j].removed)continue;
if(!findFree(