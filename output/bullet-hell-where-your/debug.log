t.Config.VIRTUAL_HEIGHT - this.hitboxSize/2);\n    // Focus mode: Shift reduces speed and reveals 1px hitbox\n    this.focused = this.keyState.shift;\n    if (this.focused) this.maxSpeed = PixelPoint.Config.FOCUS_MAX_SPEED; else this.maxSpeed = PixelPoint.Config.PLAYER_MAX_SPEED;\n  }\n  draw(ctx, camera) {\n    var drawPos = { x: this.pos.x - camera.x, y: this.pos.y - camera.y };\n    var isFocus = this.focused;\n    // Draw player sprite (8x8 glowing core)\n    ctx.save();\n    ctx.translate(drawPos.x, drawPos.y);\n    if (isFocus) {\n      ctx.globalAlpha = 0.4;\n      ctx.fillStyle = PixelPoint.Config.PLAYER_FOCUS;\n      ctx.shadowBlur = 15;\n      ctx.shadowColor = PixelPoint.Config.PLAYER_FOCUS;\n      ctx.fillRect(-4, -4, 8, 8);\n      ctx.fillStyle = '#fff';\n      ctx.fillRect(-0.5, -4, 1, 8); // 1px hitbox cross\n      ctx.fillRect(-4, -0.5, 8, 1);\n    } else {\n      ctx.fillStyle = PixelPoint.Config.PLAYER_DEFAULT;\n      ctx.shadowBlur = 10;\n      ctx.shadowColor = '#00ffcc';\n      ctx.fillRect(-4, -4, 8, 8);\n    }\n    ctx.restore();\n    // Draw focus ring\n    if (isFocus) {\n      ctx.save();\n      ctx.translate(drawPos.x, drawPos.y);\n      ctx.strokeStyle = '#00ffff';\n      ctx.lineWidth = 2;\n      ctx.beginPath();\n      ctx.arc(0, 0, 5, 0, Math.PI * 2);\n      ctx.stroke();\n      ctx.restore();\n    }\n  }\n};\n",
