  "src/config.js": "var PixelPoint = PixelPoint || {};\nPixelPoint.Config = {\n  VIRTUAL_WIDTH: 3840,\n  VIRTUAL_HEIGHT: 2160,\n  CAMERA_LERP: 0.12,\n  PLAYER_ACCELERATION: 0.8,\n  PLAYER_MAX_SPEED: 6,\n  PLAYER_FRICTION: 0.92,\n  FOCUS_MAX_SPEED: 3,\n  PLAYER_HITBOX_SIZE: 1,\n  BULLET_LIFESPAN: 400,\n  ENEMY_SPAWN_RATE: 1200,\n  SCORE_PER_SECOND: 1,\n  SCORE_PER_BULLET_DODGED: 10,\n  HIGH_SCORE_KEY: 'pp_highscore',\n  COLOR: {\n    BACKGROUND: '#050505',\n    PLAYER_DEFAULT: '#00ffcc',\n    PLAYER_FOCUS: '#00aaff',\n    BULLET_GREEN: '#00ff00',\n    BULLET_YELLOW: '#ffff00',\n    BULLET_RED: '#ff0000',\n    BULLET_PURPLE: '#a000ff',\n    UI_TEXT: '#fff',\n    UI_ACCENT: '#00ffff',\n    PARTICLE: '#fff'\n  }\n};\",
