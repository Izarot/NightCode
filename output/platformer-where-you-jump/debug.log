        src/particles/ParticleSystem.js:
            export class ParticleSystem {
                constructor() {
                    this.particles = [];
                }
                update() {
                    this.particles = this.particles.filter(p => p.life > 0);
                    this.particles.forEach(p => {
                        p.x += p.vx;
                        p.y += p.vy;
                        p.life -= 16; // assuming 60fps, 16ms per frame
                        p.alpha = p.life / p.initialLife;
                    });
                }
                addParticle(x, y, vx, vy, life, color) {
                    this.particles.push({ x, y, vx, vy, life, initialLife: life, color, alpha: 1 });
                }
                draw(ctx) {
                    ctx.save();
                    this.particles.forEach(p => {
                        ctx.globalAlpha = p.alpha;
                        ctx.fillStyle = p.color;
                        ctx.beginPath();
                        ctx.arc(p.x, p.y, 2, 0, Math.PI * 2);
                        ctx.fill();
                    });
                    ctx.restore();
                }
            }

        Now, the note:

        src/note/Note.js:
            export class Note {
                constructor(x, y, pitch, type) {
                    this.x = x;
                    this.y = y;
                    this.pitch = pitch; // midi note number
                    this.type = type; // 'quarter', 'eighth', etc. - we'll ignore for now
                    this.width = 48;
                    this.height = 48;
                    this.color = this.getColorFromPitch(pitch);
                    this.scale = 1;
                    this.pulseOffset = Math.random() * Math.PI * 2;
                }
                getColorFromPitch(pitch) {
                    // We'll map pitch class (0-11) to the colors in the spec
                    const pitchClass = pitch % 12;
                    const colors = {
                        0: '#ff6b9d', // C
                        2: '#c44569', // D
                        4: '#f8b500', // E
                        5: '#6bff6b', // F
                        7: '#00d4ff', // G
                        9: '#7b68ee', // A
                        11: '#ff4757' // B
                    };
                    return colors[pitchClass] || '#ffffff';
                }
                update() {
                    // Pulse on beat: we'll assume a global beat? We'll skip for now and just do a gentle pulse
                    this.pulseOffset += 0.05;
                    this.scale = 1 + 0.1 * Math.sin(this.pulseOffset);
                }
                draw(ctx) {
                    ctx.save();
                    ctx.translate(this.x + this.width/2, this.y + this.height/2);
                    ctx.scale(this.scale, this.scale);
                    ctx.translate(-this.width/2, -this.height/2);
                    // Draw a simple rounded rectangle for the note head
                    ctx.fillStyle = this.color;
                    ctx.beginPath();
                    ctx.roundRect(0, 0, this.width, this.height, 10);
                    ctx.fill();
                    // Draw a stem (simplified)
                    ctx.fillStyle = this.color;
                    ctx.fillRect(this.width - 5, this.height/2 - 10, 5, 20);
                    ctx.restore();
                }
            }

