        src/engine/GameEngine.js:
            import { Player } from '../player/Player.js';
            import { Note } from '../note/Note.js';
            import { AudioManager } from '../audio/AudioManager.js';
            import { ParticleSystem } from '../particles/ParticleSystem.js';
            import { HUD } from '../ui/HUD.js';
            import { LevelManager } from '../levels/LevelManager.js';
            import { levels } from '../levels/LevelData.js';

            export class GameEngine {
                constructor() {
                    this.canvas = document.getElementById('gameCanvas');
                    this.ctx = this.canvas.getContext('2d');
                    this.resizeCanvas();
                    window.addEventListener('resize', () => this.resizeCanvas());
                    this.player = new Player(100, 300);
                    this.audioManager = new AudioManager();
                    this.particleSystem = new ParticleSystem();
                    this.hud = new HUD();
                    this.levelManager = new LevelManager();
                    this.levelManager.levels = levels;
                    this.currentLevel = this.levelManager.loadLevel(0);
                    this.notes = this.currentLevel.notes.map(n => new Note(n.x, n.y, n.pitch, n.type));
                    this.input = { left: false, right: false, jump: false };
                    this.lastTime = 0;
                    this.setupInput();
                }
                resizeCanvas() {
                    this.canvas.width = window.innerWidth;
                    this.canvas.height = window.innerHeight;
                }
                setupInput() {
                    window.addEventListener('keydown', (e) => {
                        switch (e.key) {
                            case 'a':
                            case 'ArrowLeft': this.input.left = true; break;
                            case 'd':
                            case 'ArrowRight': this.input.right = true; break;
                            case ' ':
                            case 'w':
                            case 'ArrowUp': this.input.jump = true; break;
                        }
                    });
