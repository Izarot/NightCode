   export class Player{constructor(x,y){this.x=x;this.y=y;this.width=32;this.height=48;this.velocity={x:0,y:0};this.maxSpeed=8;this.acceleration=0.8;this.friction=0.85;this.gravity=0.6;this.jumpPower=-14;this.onGround=false;this.coyoteTime=0;this.jumpBuffer=0;this.trail=[];this.maxTrailLength=5}update(input,platforms){this.trail.unshift({x:this.x,y:this.y});if(this.trail.length>this.maxTrailLength)this.trail.pop();if(input.left)this.velocity.x-=this.acceleration;if(input.right)this.velocity.x+=this.acceleration;if(input.jump&&this.jumpBuffer>0)this.jump();if(!input.left&&!input.right)this.velocity.x*=this.friction;this.velocity.y+=this.gravity;if(this.onGround)this.coyoteTime=6;else this.coyoteTime=Math.max(0,this.coyoteTime-1);if(input.jump)this.jumpBuffer=8;else this.jumpBuffer=Math.max(0,this.jumpBuffer-1);this.x+=this.velocity.x;this.y+=this.velocity.y;this.onGround=false;platforms.forEach(p=>{if(this.velocity.y>0&&this.x+this.width>p.x&&this.x<p.x+p.width&&this.y+this.height>p.y&&this.y<p.y+p.height&&this.y+this.height-this.velocity.y<=p.y){this.y=p.y-this.height;this.velocity.y=0;this.onGround=true}});if(this.x<0){this.x=0;this.velocity.x=0}}jump(){if(this.coyoteTime>0||this.onGround){this.velocity.y=this.jumpPower;this.jumpBuffer=0;this.coyoteTime=0}}draw(ctx){ctx.save();this.trail.forEach((p,i)=>{ctx.globalAlpha=(i+1)/(this.trail.length+1)*0.5;ctx.fillStyle='#00d4ff';ctx.fillRect(p.x,p.y,this.width,this.height)});ctx.restore();ctx.fillStyle='#ffffff';ctx.fillRect(this.x,this.y,this.width,this.height}}}

