          src/levels/LevelManager.js:
            export class LevelManager {
                constructor() {
                    this.currentLevel = 0;
                    this.levels = []; // will be set from LevelData
                }
                loadLevel(index) {
                    // We'll assume levels are loaded from LevelData
                    return levels[index];
                }
                getCurrentLevel() {
                    return this.levels[this.currentLevel];
                }
                nextLevel() {
                    this.currentLevel = Math.min(this.currentLevel + 1, this.levels.length - 1);
                }
            }

