            export class HUD {
                constructor() {
                    this.score = 0;
                    this.highScore = localStorage.getItem('noteJumperHighScore') || 0;
                    this.combo = 0;
                    this.perfects = 0;
                    this.goods = 0;
                    this.offs = 0;
                    this.timer = 0;
                    this.lastUpdate = Date.now();
                }
                update(deltaTime) {
                    this.timer += deltaTime / 1000; // to seconds
                }
                draw(ctx) {
                    ctx.save();
                    ctx.font = '24px Orbitron';
                    ctx.fillStyle = '#ffffff';
                    ctx.textAlign = 'left';
                    ctx.fillText(`SCORE: ${this.score.toString().padStart(4, '0')}`, 20, 40);
                    ctx.fillText(`HI-SCORE: ${this.highScore.toString().padStart(4, '0')}`, 20, 80);
                    ctx.fillText(`TIME: ${Math.floor(this.timer)}s`, 20, 120);
                    ctx.textAlign = 'center';
                    ctx.fillText(`COMBO: ${this.combo}x`, ctx.canvas.width / 2, 40);
                    ctx.textAlign = 'right';
                    ctx.fillText(`PERFECT: ${this.perfects}`, ctx.canvas.width - 20, 40);
                    ctx.fillText(`GOOD: ${this.goods}`, ctx.canvas.width - 20, 80);
                    ctx.fillText(`OFF: ${this.offs}`, ctx.canvas.width - 20, 120);
                    ctx.restore();
                }
                updateScore(points) {
                    this.score += points;
                    if (this.score > this.highScore) {
                        this.highScore = this.score;
                        localStorage.setItem('noteJumperHighScore', this.highScore);
                    }
                }
                // ... other methods for combo, etc.
