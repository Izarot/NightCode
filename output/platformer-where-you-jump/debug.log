        src/player/Player.js:
            export class Player {
                constructor(x, y) {
                    this.x = x;
                    this.y = y;
                    this.width = 32;
                    this.height = 48;
                    this.velocity = { x: 0, y: 0 };
                    this.maxSpeed = 8;
                    this.acceleration = 0.8;
                    this.friction = 0.85;
                    this.gravity = 0.6;
                    this.jumpPower = -14;
                    this.onGround = false;
                    this.coyoteTime = 0;
                    this.jumpBuffer = 0;
                    this.trail = []; // for motion trail
                    this.maxTrailLength = 5;
                }
                update(input, platforms) {
                    // Save current position for trail
                    this.trail.unshift({ x: this.x, y: this.y });
                    if (this.trail.length > this.maxTrailLength) {
                        this.trail.pop();
                    }

                    // Handle input
                    if (input.left) {
                        this.velocity.x -= this.acceleration;
                    }
                    if (input.right) {
                        this.velocity.x += this.acceleration;
                    }
                    if (input.jump && this.jumpBuffer > 0) {
                        this.jump();
                    }

                    // Apply friction
                    if (!input.left && !input.right) {
                        this.velocity.x *= this.friction;
                    }

                    // Apply gravity
                    this.velocity.y += this.gravity;

                    // Coyote time and jump buffer
                    if (this.onGround) {
                        this.coyoteTime = 6; // 6 frames
                    } else {
                        this.coyoteTime = Math.max(0, this.coyoteTime - 1);
                    }
                    if (input.jump) {
                        this.jumpBuffer = 8; // 8 frames
                    } else {
                        this.jumpBuffer = Math.max(0, this.jumpBuffer - 1);
                    }

                    // Update position
                    this.x += this.velocity.x;
                    this.y += this.velocity.y;

                    // Simple platform collision (we'll assume platforms are notes for now)
                    this.onGround = false;
                    platforms.forEach(platform => {
                        if (this.velocity.y > 0 &&
                            this.x + this.width > platform.x &&
                            this.x < platform.x + platform.width &&
                            this.y + this.height > platform.y &&
                            this.y < platform.y + platform.height &&
                            this.y + this.height - this.velocity.y <= platform.y) {
                            this.y = platform.y - this.height;
                            this.velocity.y = 0;
                            this.onGround = true;
                        }
                    });

                    // Prevent going too far left
                    if (this.x < 0) {
                        this.x = 0;
                        this.velocity.x = 0;
                    }
                }
                jump() {
                    if (this.coyoteTime > 0 || this.onGround) {
                        this.velocity.y = this.jumpPower;
                        this.jumpBuffer = 0;
                        this.coyoteTime = 0;
                    }
                }
                draw(ctx) {
                    // Draw trail
                    ctx.save();
                    this.trail.forEach((pos, i) => {
                        const alpha = (i + 1) / (this.trail.length + 1);
                        ctx.globalAlpha = alpha * 0.5;
                        ctx.fillStyle = '#00d4ff';
                        ctx.fillRect(pos.x, pos.y, this.width, this.height);
                    });
                    ctx.restore();

                    // Draw player
                    ctx.fillStyle = '#ffffff';
                    ctx.fillRect(this.x, this.y, this.width, this.height);
                    // Glow trail? We'll skip for simplicity, but we have the trail above.
                }
            }

