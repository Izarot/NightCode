effect\\n    ctx.shadowColor = '#00ff88';\\n    ctx.shadowBlur = 15;\\n    ctx.beginPath();\\n    ctx.arc(0, 0, 18, 0, Math.PI * 2);\\n    ctx.fill();\\n    ctx.shadowBlur = 0;\\n}\\n\\nfunction drawParticles() {\\n    particles.forEach(p => {\\n        ctx.globalAlpha = p.alpha;\\n        ctx.fillStyle = p.color;\\n        ctx.beginPath();\\n        ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);\\n        ctx.fill();\\n    });\\n    ctx.globalAlpha = 1;\\n}\\n\\n// --- Particle System ---\\nlet particles = [];\\n\\nfunction spawnParticles(x, y, color, count) {\\n    for (let i = 0; i < count; i++) {\\n        particles.push({\\n            x, y,\\n            vx: (Math.random() - 0.5) * 4,\\n            vy: (Math.random() - 0.5) * 4,\\n            alpha: 1,\\n            life: 1,\\n            decay: 0.02,\\n            color\\n        });\\n    }\\n}\\n\\nfunction updateParticles(dt) {\\n    particles = particles.filter(p => p.life > 0);\\n    particles.forEach(p => {\\n        p.x += p.vx;\\n        p.y += p.vy;\\n        p.vy += 0.05;\\n        p.life -= p.decay;\\n        p.alpha = p.life;\\n    });\\n}\\n\\n// --- Level Generation ---\\nfunction initLevel(levelIndex) {\\n    const level = LEVELS[levelIndex];\\n    \\n    // Generate random lights and power sources\\n    const lights = generateLights(level.lights);\\n    const powerSources = generatePowerSources(level.powerSources);\\\\n    \\n    // Assign lights to power sources via wires (simplified)\\\n    assignConnections(lights, powerSources);\\\\n}\\n\\nfunction assignConnections(lights, sources) {\\n    // Simple assignment: connect each light to nearest source\\n    lights.forEach(light => {\\n        let closestSource = null;\\n        let minDist = Infinity;\\\\n        \\n        sources.forEach(source => {\\n            const dist = distance(light.x, light.y, source.x, source.y);\\n            if (dist < minDist) {\\n                minDist = dist;\\n                closestSource = source;\\n            }\\n        });\\n        \\n        if (closestSource) {\\n            // Find a free wire slot (simplified: place directly)\\n            const wire = createWire(closestSource, light);\\n            if (wire) {\\n                gameState.wireManager.addWire(wire);\\n            }\\n        }\\n    });\\n}\\n\\nfunction createWire(from, to) {\\n    // Check for collisions with existing wires\\n    const occupied = gameState.wireManager.getOccupiedArea(from, to);\\\\n    if (!occupied) {\\n        const wire = {\\n            id: Date.now() + Math.random(),\\n            from: {...from},\\n            to: {...to},\\n            active: false,\\n            type: 'straight'\\n        };\\n        gameState.wireManager.addWire(wire);\\n        return wire;\\n    }\\n}\\n\\n// --- Game State Management ---\\nfunction startGame() {\\n    gameState.isRunning = true;\\n    gameState.isPowerModeActive = false;\\n    gameState.timeRemaining = 60;\\n    gameState.activeLoadCounter = 0;\\n    gameState.speedrunTimer = 0;\\n    \\n    // Reset particles\\n    particles = [];\\n    \\n    // Initialize wire manager\\n    gameState.wireManager = new WireManager(canvas.width, canvas.height);\\\n    \\n    // Init level\\n    initLevel(0);\\\n    \\n    // Render initial state\\n    renderInitialState();\\n}\\n\\nfunction endGame(victory) {\\n    gameState.isRunning = false;\\n    if (victory) {\\n        // Save high score\\n        try {\\n            const newScore = gameState.activeLoadCounter;\\n            if (newScore > gameState.highScore) {\\n                gameState.highScore = newScore;\\n                localStorage.setItem('electric_circuit_highscore', gameState.highScore);\\n            }\\n        } catch (_) {\\n            // Ignore errors\\n        }\\n        alert(`Congratulations! You lit ${gameState.activeLoadCounter} lights!\\nHigh Score: ${gameState.highScore}\\n`);\\n    } else {\\n        alert(`Game Over! You didn\'t light enough lights.\\nYour best score: ${gameState.highScore}\\n`);\\n    }\\n}\\n\\n// --- HUD Updates ---\\nfunction updateHUD() {\\n    const counter = document.getElementById('activeLoadCounter');\\n    const timeEl = document.getElementById('timeRemaining');\\n    const speedRunEl = document.getElementById('speedrunTimer');\\n    \\n    counter.textContent = `${gameState.activeLoadCounter}/${LEVELS[0].lights}`;\\n    timeEl.textContent = formatTime(gameState.timeRemaining);\\n    \\n    if (gameState.speedrunTimer > 0) {\\n        const mins = Math.floor(gameState.speedrunTimer / 60);\\n        const secs = Math.floor(gameState.speedrunTimer % 60);\\n        speedRunEl.textContent = `${mins}:${secs.toString().padStart(2, '0')}`;\\n    }\\n}\\n\\nfunction formatTime(seconds) {\\n    const mins = Math.floor(seconds / 60);\\n    const secs = seconds % 60;\\n    return `${String(mins).padStart(2, '0')}:${String(secs).padStart(2, '0')}`;\\n}\\n\\n// --- UI Helpers ---\\nfunction showMessage(text, duration = 2000) {\\n    const msgDiv = document.createElement('div');\\n    msgDiv.id = 'gameMessage';\\n    msgDiv.textContent = text;\\n    msgDiv.style.position = 'fixed';\\n    msgDiv.style.top = '50px';\\n    msgDiv.style.left = '50%;\\n        transform: translateX(-50%);\\n        background: #ff6b35;\\n        color: white;\\n        padding: 12px 24px;\\n        border-radius: 8px;\\n        font-family: sans-serif;\\n        font-size: 14px;\\n        opacity: 0;\\n        transition: opacity 0.3s;\\n        pointer-events: none;\\n        z-index: 100;\\n    };\\n    document.body.appendChild(msgDiv);\\n    setTimeout(() => {\\n        msgDiv.style.opacity = '0';\\n        setTimeout(() => msgDiv.remove(), 300);\\n    }, duration);\\n}\\n\\n// --- Keyboard Controls ---\\nconst keys = {};\\nwindow.addEventListener('keydown', e => {\\n    keys[e.key] = true;\\n    // Prevent scrolling\\n    if (['ArrowUp','ArrowDown','ArrowLeft','ArrowRight','Space'].includes(e.key)) {\\n        e.preventDefault();\\n    }\\n});\\n\\nwindow.addEventListener('keyup', e => {\\n    keys[e.key] = false;\\n});\\n\\n// Toggle power mode\\nconst powerToggleBtn = document.querySelector(\'[data-action="toggle-power"]\');\\nif (powerToggleBtn) {\\n    powerToggleBtn.addEventListener(\'click\', () => {\\n        gameState.isPowerModeActive = !gameState.isPowerModeActive;\\\n        powerToggleBtn.textContent = gameState.isPowerModeActive ? \'OFF\' : \'ON\';\\\n        showMessage(gameState.isPowerModeActive ? \n            \'Power mode ON - Ready to wire!\' : \n            \'Power mode OFF - Disconnect all wires.\',\\n            1500);\\n    });\\n}\\n\\n// Touch support for mobile\\nlet touchStart = null;\\nwindow.addEventListener('touchstart', e => {\\n    touchStart = {x: e.touches[0].clientX, y: e.touches[0].clientY};\\n});\\n\\nwindow.addEventListener('touchend', e => {\\n    if (touchStart) {\\n        const dx = e.changedTouches[0].clientX - touchStart.x;\\n        const dy = e.changedTouches[0].clientY - touchStart.y;\\n        \\n        if (Math.abs(dx) > 30 && Math.abs(dy) < 30) {\\n            // Swipe detected\\n            const swipeAngle = Math.atan2(dy, dx);\\n            if (swipeAngle > -Math.PI/2 && swipeAngle < Math.PI/2) {\\n                handleSwipe(swipeAngle);\\n            }\\n        }\\n    }\\n});\\n\\nfunction handleSwipe(angle) {\\n    const player = gameState.playerPosition;\\n    const dir = angle > 0 ? \'right\' : \'left\';\\\\n    const newX = player.x + 20 * dir;\\n    const newY = player.y;\\\\n    \\n    // Check collision with walls\\n    if (newX < 0 || newX > canvas.width || newY < 0 || newY > canvas.height) {\\n        showMessage(\'Cannot move outside the canvas!\', 1500);\\n        return;\\n    }\\n    \\n    // Attempt to place wire\\n    placeWire(newX, newY, dir);\\n}\\n\\n// --- Input Actions ---\\nfunction placeWire(x1, y1, direction) {\\n    if (!gameState.isRunning) return;\\\n    \\n    // Get target position\\n    let target = {x: x1, y: y1};\\n    if (direction === 'right') {\\n        target.x += 120;\\n    } else if (direction === 'left') {\\n        target.x -= 120;\\n    } else if (direction === 'down') {\\n        target.y += 120;\\n    } else if (direction === 'up') {\\n        target.y -= 120;\\n    }\\n    \\n    // Check bounds\\n    if (target.x < 0 || target.x > canvas.width || target.y < 0 || target.y > canvas.height) {\\n        showMessage(\'Out of bounds! Try again.\', 2000);\\n        return;\\n    }\\n    \\n    // Check for collisions with existing wires\\n    if (gameState.wireManager.isWireOccupied(target.from, target.to)) {\\n        showMessage(\'Wire collision! Avoid overlapping wires.\', 2000);\\n        return;\\n    }\\n    \\n    // Create wire\\n    const wire = createWire(target.from, target.to);\\n    if (wire) {\\n        gameState.wireManager.addWire(wire);\\n        spawnParticles(target.x, target.y, '#00b4d8', 5);\\n        showMessage(\'Wire placed successfully!\', 1500);\\n    }\\n}\\n\\n// --- Win Condition ---\\nfunction checkWinCondition() {\\n    const allOn = lights.filter(l => l.state === 'ON').length === LEVELS[0].lights;\\\n    if (allOn) {\\n        endGame(true);\\n    }\\n}\\n\\n// --- Main Game Loop ---\\nfunction gameLoop(timestamp) {\\n    if (!gameState.isRunning) return;\\\n\\n    const deltaTime = timestamp - gameState.lastTime;\\n    gameState.lastTime = timestamp;\\\\n\\n    update(deltaTime);\\n    checkWinCondition();\\n    updateHUD();\\n    draw();\\n    requestAnimationFrame(gameLoop);\\n}\\n\\n// Start the game loop\\nrequestAnimationFrame(gameLoop);\\n",
  "game.ts": "// Core game logic for Electric Circuit Puzzle\\n// Manages levels, timing, win/loss conditions, and game state\\n\\nconst LEVELS = [\\n    {\\n        name: \"Level 1\",\\n        lights: 6,\\n        powerSources: 3,\\n        difficulty: \"easy\"\\n    },\\n    {\\n        name: \"Level 2\",\\n        lights: 9,\\n        powerSources: 4,\\n        difficulty: \"medium\"\\n    },\\n    {\\n        name: \"Level 3\",\\n        lights: 12,\\n        powerSources: 5,\\n        difficulty: \"hard\"\\n    }\\n];\\n\\n// Global state\\nlet currentLevel = 0;\\nlet currentLightCount = 0;\\nlet highScore = 0;\\n\\n// Timing\\nlet timeRemaining = 60;\\nlet speedrunTimer = 0;\\n\\n// Player state\\nlet playerPosition = {x: 400, y: 300};\\nlet playerDirection = {x: 0, y: 0};\\n\\n// Power mode\\nlet powerModeActive = false;\\n\\n// Wire manager\\nlet wireManager = new WireManager(canvas.width, canvas.height);\\n\\n// Light fixtures\\nlet lights = [];\\n\\n// --- Initialization ---\\nfunction initLevel() {\\n    const level = LEVELS[currentLevel];\\n    \\n    // Generate random lights\\n    const lightPositions = generatePoints(canvas.width, canvas.height, level.lights);\\n    lights = lightPositions.map(p => ({\\n        x: p.x,\\n        y: p.y,\\n        state: 'OFF'\\n    }));\\n    \\n    // Generate power sources\\n    const sourcePositions = generatePoints(canvas.width, canvas.height, level.powerSources);\\n    \\n    // Connect some initial wires\\n    connectDemoWires();\\n}\\n\\n// --- Level Generation ---\\nfunction generatePoints(width, height, count) {\\n    const points = [];\\n    let added = 0;\\n    while (added < count) {\\n        const x = Math.random() * (width - 80);\\n        const y = Math.random() * (height - 100);\\n        // Avoid creating points too close together\\n        if (points.length === 0 || distance(x, y, points[points.length - 1].x, points[points.length - 1].y) > 150) {\\n            points.push({x, y});\\n            added++;\\n        }\\n    }\\n    return points;\\n}\\n\\nfunction distance(ax, ay, bx, by) {\\n    return Math.sqrt((ax - bx) ** 2 + (ay - by) ** 2);\\n}\\n\\nfunction connectDemoWires() {\\n    // Pre-connect some wires for better starting experience\\n    const wires = [\\n        {from: {x: 300, y: 400}, to: {x: 450, y: 350}},\\n        {from: {x: 250, y: 550}, to: {x: 350, y: 650}},\\n        {from: {x: 500, y: 200}, to: {x: 480, y: 180}}\\n    ];\\n    window.demoWires = wires;\\n}\\n\\n// --- Player Movement ---\\nfunction getRandomPosition() {\\n    const w = canvas.width;\\n    const h = canvas.height;\\n    return {\\n        x: Math.random() * (w - 80),\\n        y: Math.random() * (h - 100)\\n    };\\n}\\n\\nfunction movePlayer(dx, dy) {\\n    const speed = 6;\\n    const accel = 0.5;\\n    const decel = 0.8;\\n    \\n    // Apply acceleration\\n    playerDirection.x += dx * accel;\\n    playerDirection.y += dy * accel;\\n    \\n    // Clamp to max speed\\n    const speed = Math.sqrt(playerDirection.x ** 2 + playerDirection.y ** 2);\\n    if (speed > 6) {\\n        playerDirection.x = (playerDirection.x / speed) * 6;\\n        playerDirection.y = (playerDirection.y / speed) * 6;\\n    }\\n    \\n    // Apply friction\\n    playerDirection.x *= 0.98;\\n    playerDirection.y *= 0.98;\\n    \\n    // Limit movement\\n    const newX = playerPosition.x + playerDirection.x;\\n    const newY = playerPosition.y + playerDirection.y;\\n    \\n    // Wall collision\\n    if (newX < 0) newX = 0;\\n    if (newX > canvas.width - 20) newX = canvas.width - 20;\\n    if (newY < 0) newY = 0;\\n    if (newY > canvas.height - 100) newY = canvas.height - 100;\\n    \\n    playerPosition.x = newX;\\n    playerPosition.y = newY;\\n}\\n\\n// --- Wire Management ---\\nclass WireManager {\\n    constructor(width, height) {\\n        this.width = width;\\n        this.height = height;\\n        this.wires = [];\\n        this.occupiedGrid = new Map();\\n    }\\n\\n    addWire(wire) {\\n        this.wires.push(wire);\\n        this.occupiedGrid.set(`${wire.from.x},${wire.from.y}`, wire.from);\\n        this.occupiedGrid.set(`${wire.to.x},${wire.to.y}`, wire.to);\\n        \\n        // Check for self-collisions\\n        if (this.isWireOccupied(wire.from, wire.to)) {\\n            console.error(\"Wire collision detected!\");\\n            return false;\\n        }\\n        \\n        // Check for intersections with other wires\\n        if (this.hasIntersection(wire)) {\\n            console.error(\"Wire intersects another wire!\");\\n            return false;\\n        }\\n        \\n        return true;\\n    }\\n\\n    isWireOccupied(from, to) {\\n        const keyFrom = `${from.x},${from.y}`;\\n        const keyTo = `${to.x},${to.y}`;\\n        \\n        // Check vertical overlap\\n        if (from.y >= to.y) {\\n            if (from.x < to.x) {\\n                if (this.occupiedGrid.get(keyFrom) && this.occupiedGrid.get(keyTo)) {\\n                    return true;\\n                }\\n                } else if (from.x > to.x) {\\n                    if (this.occupiedGrid.get(keyFrom) && this.occupiedGrid.get(keyTo)) {\\n                        return true;\\n                    }\\n                }\\n            }\\n        } else {\\n            if (from.x >= to.x) {\\n                if (this.occupiedGrid.get(keyFrom) && this.occupiedGrid.get(keyTo)) {\\n                    return true;\\n                }\\n            } else if (from.x } else if (from.x > to.x) {
