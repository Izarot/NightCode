  "main.js": "// Entry point for Electric Circuit Puzzle\\n// Initializes the game, sets up the canvas, and starts the main loop\\n\\nconst canvas = document.getElementById('gameCanvas');\\nconst ctx = canvas.getContext('2d');\\n\\n// Resize handler for responsive canvas\\nfunction resizeCanvas() {\\n    const rect = canvas.getBoundingClientRect();\\n    canvas.width = Math.min(window.innerWidth - 40, 900);\\n    canvas.height = Math.min(window.innerHeight - 80, 700);\\n}\\n\\nwindow.addEventListener('resize', resizeCanvas);\\n\\n\\n// Initialize game state\\nlet gameState = {\\n    isRunning: false,\\n    isPowerModeActive: false,\\n    timeRemaining: 60,\\n    highScore: 0,\\n    lastTime: 0,\\n    particles: []\\n};\\n\\n// Load high score from LocalStorage\\ntry {\\n    const savedScore = localStorage.getItem('electric_circuit_highscore');\\n    gameState.highScore = savedScore ? parseInt(savedScore, 10) : 0;\\n} catch (_) {\\n    gameState.highScore = 0;\\n}\\n\\n// Start the game\\nstartGame();\\n\\n// --- Game Loop ---\\nfunction gameLoop(timestamp) {\\n    if (!gameState.isRunning) return;\\\n\\n    const deltaTime = timestamp - gameState.lastTime;\\n    gameState.lastTime = timestamp;\\\\n\\n    update(deltaTime);\\n    draw();\\n    requestAnimationFrame(gameLoop);\\n}\\n\\n\\n// --- Initialization ---\\nfunction startGame() {\\n    gameState.isRunning = true;\\n    gameState.timeRemaining = 60;\\n    gameState.activeLoadCounter = 0;\\n    gameState.speedrunTimer = 0;\\n    \\n    // Set up initial state\\n    initLevel();\\n    renderInitialState();\\n}\\n\\n// --- Level Management ---\\nconst LEVELS = [\\n    {\\n        name: \"Level 1\",\\n        lights: 6,\\n        powerSources: 3,\\n        difficulty: \"easy\"\\n    },\\n    {\\n        name: \"Level 2\",\\n        lights: 9,\\n        powerSources: 4,\\n        difficulty: \"medium\"\\n    },\\n    {\\n        name: \"Level 3\",\\n        lights: 12,\\n        powerSources: 5,\\n        difficulty: \"hard\"\\n    }\\n];\\n\\nfunction initLevel(levelIndex) {\\n    const level = LEVELS[levelIndex];\\n    \\n    // Generate random positions for lights and power sources\\n    const lights = generateLights(level.lights);\\n    const powerSources = generatePowerSources(level.powerSources);\\\\n    \\n    // Position player randomly\\n    const playerPos = getRandomPosition();\\n    \\n    // Connect some initial wires for demo\\n    connectDemoWires();\\n}\\n\\nfunction getRandomPosition() {\\n    const w = canvas.width;\\n    const h = canvas.height;\\n    return {\\n        x: Math.random() * (w - 80),\\n        y: Math.random() * (h - 100)\\n    };\\n}\\n\\nfunction generateLights(count) {\\n    const lights = [];\\n    const positions = generatePoints(w, h, count);\\n    for (let i = 0; i < count; i++) {\\n        lights.push({...positions[i]});\\n    }\\n    return lights;\\n}\\n\\nfunction generatePowerSources(count) {\\n    const sources = [];\\n    const positions = generatePoints(w, h, count);\\n    for (let i = 0; i < count; i++) {\\n        sources.push({...positions[i]});\\n    }\\n    return sources;\\n}\\n\\nfunction generatePoints(width, height, count) {\\n    const points = [];\\n    let added = 0;\\n    while (added < count) {\\n        const x = Math.random() * (width - 80);\\n        const y = Math.random() * (height - 100);\\n        // Avoid creating points too close together\\n        if (points.length === 0 || distance(x, y, points[points.length - 1].x, points[points.length - 1].y) > 150) {\\n            points.push({x, y});\\n            added++;\\n        }\\n    }\\n    return points;\\n}\\n\\nfunction distance(ax, ay, bx, by) {\\n    return Math.sqrt((ax - bx) ** 2 + (ay - by) ** 2);\\n}\\n\\nfunction connectDemoWires() {\\n    // Add some pre-connection wires for better starting experience\\n    const wires = [\\n        {from: {x: 300, y: 400}, to: {x: 450, y: 350}},\\n        {from: {x: 250, y: 550}, to: {x: 350, y: 650}},\\n        {from: {x: 500, y: 200}, to: {x: 480, y: 180}}\\n    ];\\n    // Store in global for later use\\n    window.demoWires = wires;\\n}\\n\\n// --- Update Logic ---\\nfunction update(deltaTime) {\\n    if (!gameState.isRunning) return;\\\n\\n    // Update speedrun timer\\n    if (gameState.speedrunTimer > 0) {\\n        gameState.speedrunTimer -= deltaTime;\\n        if (gameState.speedrunTimer <= 0) {\\n            endGame(false);\\n        }\\n    }\\n\\n    // Handle power mode toggle\\n    if (gameState.isPowerModeActive && gameState.isRunning) {\\n        switch (document.querySelector('[data-action="toggle-power"]')) {\\n            case \'on\':\\n                gameState.isPowerModeActive = false;\\n                break;\\n            case \'off\':\\n                gameState.isPowerModeActive = true;\\n                break;\\n        }\\n    }\\n}\\n\\n// --- Draw Logic ---\\nfunction draw() {\\n    // Clear canvas with dark background\\n    ctx.fillStyle = '#1a1a1a';\\n    ctx.fillRect(0, 0, canvas.width, canvas.height);\\n\\n    \\n    // Draw floor and walls\\n    drawFloorAndWalls();\\n    \\n    // Draw wires\\n    drawWires();\\n    \\n    // Draw lights\\n    drawLights();\\n    \\n    // Draw player\\n    drawPlayer();\\n    \\n    // Draw particles\\n    drawParticles();\\n}\\n\\nfunction drawFloorAndWalls() {\\n    // Floor\\n    ctx.fillStyle = '#2a2a2a';\\n    ctx.fillRect(0, canvas.height - 40, canvas.width, 40);\\n    \\n    // Grid lines (subtle)\\n    ctx.strokeStyle = '#333';\\n    ctx.lineWidth = 1;\\n    for (let x = 0; x <= canvas.width; x += 50) {\\n        ctx.beginPath();\\n        ctx.moveTo(x, 0);\\n        ctx.lineTo(x, canvas.height - 40);\\n        ctx.stroke();\\n    }\\n    for (let y = 0; y <= canvas.height; y += 50) {\\n        ctx.beginPath();\\n        ctx.moveTo(0, y);\\n        ctx.lineTo(canvas.width, y);\\n        ctx.stroke();\\n    }\\n}\\n\\nfunction drawWires() {\\n    // Draw demo wires first\\n    if (window.demoWire