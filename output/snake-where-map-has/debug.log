 x: portal1.x,\n                y: portal1.y,\n                pairIndex: portals.length,\n                color: COLORS.portals[colorIndex],\n                pulsePhase: Math.random() * Math.PI * 2\n            });\n            \n            portals.push({\n                x: portal2.x,\n                y: portal2.y,\n                pairIndex: portals.length - 1,\n                color: COLORS.portals[colorIndex],\n                pulsePhase: Math.random() * Math.PI * 2\n            });\n        }\n        \n        function createPortalPosition() {\n            let attempts = 0;\n            while (attempts < 100) {\n                const x = Math.floor(Math.random() * (BASE_WIDTH / GRID_SIZE - 2)) + 1;\n                const y = Math.floor(Math.random() * (BASE_HEIGHT / GRID_SIZE - 2)) + 1;\n                \n                // Check not on snake\n                let valid = true;\n                for (let seg of snake) {\n                    if (seg.x === x && seg.y === y) {\n                        valid = false;\n                        break;\n                    }\n                }\n                \n                // Check not on food\n                if (food.x === x && food.y === y) valid = false;\n                \n                // Check not on other portals\n                for (let p of portals) {\n                    if (Math.abs(p.x - x) < 3 && Math.abs(p.y - y) < 3) {\n                        valid = false;\n                        break;\n                    }\n                }\n                \n                if (valid) return { x, y };\n                attempts++;\n            }\n            return { x: 1, y: 1 };\n        }\n        \n        function checkPortalEntry() {\n            if (portalCooldown > 0 || invincibilityTime > 0) return;\n            \n            const head = snake[0];\n            \n            for (let portal of portals) {\n                if (head.x === portal.x && head.y === portal.y) {\n                    const pair = portals[portal.pairIndex];\n                    \n                    // Check if exit is valid\n                    let exitValid = true;\n                    for (let seg of snake) {\n                        if (seg.x === pair.x && seg.y === pair.y) {\n                            exitValid = false;\n                            break;\n                        }\n                    }\n                    \n                    if (exitValid && pair.x >= 0 && pair.x < BASE_WIDTH / GRID_SIZE && \n                        pair.y >= 0 && pair.y < BASE_HEIGHT / GRID_SIZE) {\n                        // Teleport!\n                        playSound('teleport');\n                        \n                        // Create teleport particles\n                        for (let i = 0; i < 12; i++) {\n                            const angle = (i / 12) * Math.PI * 2;\n                            particles.push({\n                                x: (head.x + 0.5) * GRID_SIZE,\n                                y: (head.y + 0.5) * GRID_SIZE,\n                                vx: Math.cos(angle) * 100,\n                                vy: Math.sin(angle) * 100,\n                                life: 0.8,\n                                color: portal.color,\n                                size: 4\n                            });\n                        }\n                        \n                        // Teleport snake\n                        const dx = pair.x - head.x;\n                        const dy = pair.y - head.y;\n                        \n                        for (let i = snake.length - 1; i > 0; i--) {\n                            snake[i].x += dx;\n                            snake[i].y += dy;\n                        }\n                        \n                        // Add invincibility\n                        invincibilityTime = 0.2;\n                        portalCooldown = 0.5;\n                        \n                        return;\n                    }\n                }\n            }\n        }\n        \n        // ============================================\n        // FOOD SYSTEM\n        // ============================================\n        \n        function spawnFood() {\n            let attempts = 0;\n            while (attempts < 100) {\n                const x = Math.floor(Math.random() * (BASE_WIDTH / GRID_SIZE - 2)) + 1;\n                const y = Math.floor(Math.random() * (BASE_HEIGHT / GRID_SIZE - 2)) + 1;\n                \n                let valid = true;\n                \n                // Check snake\n                for (let seg of snake) {\n                    if (seg.x === x && seg.y === y) {\n                        valid = false;\n                        break;\n                    }\n                }\n                \n                // Check portals\n                for (let p of portals) {\n                    if (p.x === x && p.y === y) {\n                        valid = false;\n                        break;\n                    }\n                }\n                \n                if (valid) {\n                    food = { x, y };\n                    return;\n                }\n                attempts++;\n            }\n        }\n        \n        // ============================================\n        // INPUT HANDLING\n        // ============================================\n        \n        function handleKeyDown(e) {\n            if (gameState === STATE.MENU) {\n                if (e.code === 'Space' || e.code === 'Enter') {\n                    initAudio();\n                    playSound('click');\n                    gameState = STATE.PLAYING;\n                    initGame();\n                }\n                return;\n            }\n            \n            if (gameState === STATE.GAME_OVER) {\n                if (e.code === 'Space' || e.code === 'Enter') {\n                    playSound('click');\n                    gameState = STATE.PLAYING;\n                    initGame();\n                } else if (e.code === 'Escape') {\n                    playSound('click');\n                    gameState = STATE.MENU;\n                }\n                return;\n            }\n            \n            if (gameState === STATE.PAUSED) {\n                if (e.code === 'Escape' || e.code === 'Space') {\n                    playSound('click');\n                    gameState = STATE.PLAYING;\n                }\n                return;\n            }\n            \n            if (gameState === STATE.PLAYING) {\n                if (e.code === 'Escape') {\n                    playSound('click');\n                    gameState = STATE.PAUSED;\n                    return;\n                }\n                \n                if (e.code === 'KeyG') {\n                    showGrid = !showGrid;\n                    return;\n                }\n                \n                const now = performance.now() / 1000;\n                if (now - lastInputTime < INPUT_DEBOUNCE) return;\n                \n                switch (e.code) {\n                    case 'ArrowUp':\n                    case 'KeyW':\n                        if (direction.y !== 1) {\n                            nextDirection = { x: 0, y: -1 };\n                            lastInputTime = now;\n                        }\n                        break;\n                    case 'ArrowDown':\n                    case 'KeyS':\n                        if (direction.y !== -1) {\n                            nextDirection = { x: 0, y: 1 };\n                            lastInputTime = now;\n                        }\n                        break;\n                    case 'ArrowLeft':\n                    case 'KeyA':\n                        if (direction.x !== 1) {\n                            nextDirection = { x: -1, y: 0 };\n                            lastInputTime = now;\n                        }\n                        break;\n                    case 'ArrowRight':\n                    case 'KeyD':\n                        if (direction.x !== -1) {\n                            nextDirection = { x: 1, y: 0 };\n                            lastInputTime = now;\n                        }\n                        break;\n                }\n            }\n        }\n        \n        function handleTouchStart(e) {\n            e.preventDefault();\n            initAudio();\n            \n            const touch = e.touches[0];\n            const rect = canvas.getBoundingClientRect();\n            touchStart = {\n                x: touch.clientX - rect.left,\n                y: touch.clientY - rect.top,\n                time: performance.now()\n            };\n            touchValid = true;\n            \n            // Check button clicks\n            if (gameState === STATE.MENU) {\n                if (isPointInButton(touchStart.x, touchStart.y, 'play')) {\n                    playSound('click');\n                    gameState = STATE.PLAYING;\n                    initGame();\n                }\n            } else if (gameState === STATE.PAUSED) {\n                if (isPointInButton(touchStart.x, touchStart.y, 'resume')) {\n                    playSound('click');\n                    gameState = STATE.PLAYING;\n                } else if (isPointInButton(touchStart.x, touchStart.y, 'menu')) {\n                    playSound('click');\n                    gameState = STATE.MENU;\n                }\n            } else if (gameState === STATE.GAME_OVER) {\n                if (isPointInButton(touchStart.x, touchStart.y, 'retry')) {\n                    playSound('click');\n                    gameState = STATE.PLAYING;\n                    initGame();\n                } else if (isPointInButton(touchStart.x, touchStart.y, 'mainMenu')) {\n                    playSound('click');\n                    gameState = STATE.MENU;\n                }\n            } else if (gameState === STATE.PLAYING) {\n                // Long press to pause\n                setTimeout(() => {\n                    if (touchValid && touchStart) {\n                        const rect = canvas.getBoundingClientRect();\n                        const cx = rect.width / 2;\n                        const cy = rect.height / 2;\n                        const dx = touchStart.x - cx;\n                        const dy = touchStart.y - cy;\n                        if (Math.sqrt(dx*dx + dy*dy) < 100) {\n                            playSound('click');\n                            gameState = STATE.PAUSED;\n                        }\n                    }\n                }, 500);\n            }\n        }\n        \n        function handleTouchEnd(e) {\n            if (!touchStart || !touchValid) return;\n            if (gameState !== STATE.PLAYING) {\n                touchStart = null;\n                return;\n            }\n            \n            const touch = e.changedTouches[0];\n            const rect = canvas.getBoundingClientRect();\n            const endX = touch.clientX - rect.left;\n            const endY = touch.clientY - rect.top;\n            \n            const dx = endX - touchStart.x;\n            const dy = endY - touchStart.y;\n            const duration = (performance.now() - touchStart.time) / 1000;\n            \n            if (Math.abs(dx) > 30 || Math.abs(dy) > 30) {\n                const now = performance.now() / 1000;\n                if (now - lastInputTime >= INPUT_DEBOUNCE && duration < 0.5) {\n                    if (Math.abs(dx) > Math.abs(dy)) {\n                        if (dx > 0 && direction.x !== -1) {\n                            nextDirection = { x: 1, y: 0 };\n                        } else if (dx < 0 && direction.x !== 1) {\n                            nextDirection = { x: -1, y: 0 };\n                        }\n                    } else {\n                        if (dy > 0 && direction.y !== -1) {\n                            nextDirection = { x: 0, y: 1 };\n                        } else if (dy < 0 && direction.y !== 1) {\n                            nextDirection = { x: 0, y: -1 };\n                        }\n                    }\n                    lastInputTime = now;\n                }\n            }\n            \n            touchStart = null;\n            touchValid = false;\n        }\n        \n        function isPointInButton(px, py, btnName) {\n            const btn = buttons[btnName];\n            if (!btn) return false;\n            return px >= btn.x && px <= btn.x + btn.w && py >= btn.y && py <= btn.y + btn.h;\n        }\n        \n        // Event listeners\n        window.addEventListener('keydown', handleKeyDown);\n        canvas.addEventListener('touchstart', handleTouchStart, { passive: false });\n        canvas.addEventListener('touchend', handleTouchEnd, { passive: false });\n        canvas.addEventListener('touchcancel', () => { touchStart = null; touchValid = false; });\n        \n        canvas.addEventListener('mousemove', (e) => {\n            const rect = canvas.getBoundingClientRect();\n            mousePos.x = e.clientX - rect.left;\n            mousePos.y = e.clientY - rect.top;\n        });\n        \n        canvas.addEventListener('click', (e) => {\n            initAudio();\n            const rect = canvas.getBoundingClientRect();\n            const x = e.clientX - rect.left;\n            const y = e.clientY - rect.top;\n            \n            if (gameState === STATE.MENU) {\n                if (isPointInButton(x, y, 'play')) {\n                    playSound('click');\n                    gameState = STATE.PLAYING;\n                    initGame();\n                }\n            } else if (gameState === STATE.PAUSED) {\n                if (isPointInButton(x, y, 'resume')) {\n                    playSound('click');\n                    gameState = STATE.PLAYING;\n                } else if (isPointInButton(x, y, 'menu')) {\n                    playSound('click');\n                    gameState = STATE.MENU;\n                }\n            } else if (gameState === STATE.GAME_OVER) {\n                if (isPointInButton(x, y, 'retry')) {\n                    playSound('click');\n                    gameState = STATE.PLAYING;\n                    initGame();\n                } else if (isPointInButton(x, y, 'mainMenu')) {\n                    playSound('click');\n                    gameState = STATE.MENU;\n                }\n            }\n        });\n        \n        // ============================================\n        // GAME LOGIC\n        // ============================================\n        \n        function update(dt) {\n            if (gameState !== STATE.PLAYING) return;\n            \n            animationTime += dt;\n            foodPulse = (Math.sin(animationTime * 4) + 1) / 2;\n            \n            // Speed run timer\n            speedRunTime += dt;\n            \n            // Update timers\n            if (invincibilityTime > 0) invincibilityTime -= dt;\n            if (portalCooldown > 0) portalCooldown -= dt;\n            \n            // Score pop animation\n            if (scorePopScale > 1) {\n                scorePopScale = Math.max(1, scorePopScale - dt * 3);\n            }\n            \n            // Update particles\n            for (let i = particles.length - 1; i >= 0; i--) {\n                const p = particles[i];\n                p.x += p.vx * dt;\n                p.y += p.vy * dt;\n                p.life -= dt;\n                if (p.life <= 0) {\n                    particles.splice(i, 1);\n                }\n            }\n            \n            // Move accumulator\n            const moveInterval = GRID_SIZE / currentSpeed;\n            moveAccumulator += dt;\n            \n            while (moveAccumulator >= moveInterval) {\n                moveAccumulator -= moveInterval;\n                \n                // Apply direction\n                direction = { ...nextDirection };\n                \n                // Calculate