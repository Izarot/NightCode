            ctx.shadowBlur = 12;
            
            // Main body
            const gradient = ctx.createRadialGradient(cx - 2, cy - 2, 0, cx, cy, radius);
            gradient.addColorStop(0, '#ffffff');
            gradient.addColorStop(0.4, COLORS.food);
            gradient.addColorStop(1, '#e6a800');
            
            ctx.beginPath();
            ctx.arc(cx, cy, radius, 0, Math.PI * 2);
            ctx.fillStyle = gradient;
            ctx.fill();
            
            ctx.restore();
        }
        
        function drawSnake() {
            // Draw body segments
            for (let i = snake.length - 1; i >= 0; i--) {
                const seg = snake[i];
                const cx = (seg.x + 0.5) * GRID_SIZE;
                const cy = (seg.y + 0.5) * GRID_SIZE;
                const size = GRID_SIZE * 0.45;
                
                // Gradient color from head to tail
                const t = i / Math.max(1, snake.length - 1);
                const r = Math.floor(233 + (255 - 233) * t);
                const g = Math.floor(69 + (107 - 69) * t);
                const b = Math.floor(96 + (107 - 96) * t);
                
                if (i === 0) {
                    // Head
                    ctx.save();
                    ctx.shadowColor = COLORS.snakeHead;
                    ctx.shadowBlur = invincibilityTime > 0 ? 20 : 10;
                    
                    // Direction indicator (eyes)
                    const eyeOffset = GRID_SIZE * 0.2;
                    const eyeRadius = 3;
                    
                    // Draw eyes based on direction
                    let eye1x, eye1y, eye2x, eye2y;
                    if (direction.x === 1) {
                        eye1x = cx + eyeOffset; eye1y = cy - eyeOffset;
                        eye2x = cx + eyeOffset; eye2y = cy + eyeOffset;
                    } else if (direction.x === -1) {
                        eye1x = cx - eyeOffset; eye1y = cy - eyeOffset;
                        eye2x = cx - eyeOffset; eye2y = cy + eyeOffset;
                    } else if (direction.y === -1) {
                        eye1x = cx - eyeOffset; eye1y = cy - eyeOffset;
                        eye2x = cx + eyeOffset; eye2y = cy - eyeOffset;
                    } else {
                        eye1x = cx - eyeOffset; eye1y = cy + eyeOffset;
                        eye2x = cx + eyeOffset; eye2y = cy + eyeOffset;
                    }
                    
                    // Eye glow during invincibility
                    if (invincibilityTime > 0) {
                        const flash = Math.sin(animationTime * 20) > 0;
                        ctx.fillStyle = flash ? '#ffffff' : COLORS.snakeHead;
                    } else {
                        ctx.fillStyle = COLORS.snakeHead;
                    }
                    
                    // Draw body
                    ctx.beginPath();
                    ctx.arc(cx, cy, size, 0, Math.PI * 2);
                    ctx.fill();
                    
                    // Draw eyes
                    ctx.fillStyle = '#ffffff';
                    ctx.beginPath();
                    ctx.arc(eye1x, eye1y, eyeRadius, 0, Math.PI * 2);
                    ctx.fill();
                    ctx.beginPath();
                    ctx.arc(eye2x, eye2y, eyeRadius, 0, Math.PI * 2);
                    ctx.fill();
                    
                    // Pupils
                    ctx.fillStyle = '#000000';
                    ctx.beginPath();
                    ctx.arc(eye1x + direction.x, eye1y + direction.y, 1.5, 0, Math.PI * 2);
                    ctx.fill();
                    ctx.beginPath();
                    ctx.arc(eye2x + direction.x, eye2y + direction.y, 1.5, 0, Math.PI * 2);
                    ctx.fill();
                    
                    ctx.restore();
                } else {
                    // Body segment
                    ctx.globalAlpha = 0.9 - (t * 0.3);
                    ctx.beginPath();
                    ctx.arc(cx, cy, size - (t * 2), 0, Math.PI * 2);
                    ctx.fillStyle = `rgb(${r}, ${g}, ${b})`;
                    ctx.fill();
                    ctx.globalAlpha = 1;
                }
            }
        }
        
        function drawParticles() {
            for (let p of particles) {
                ctx.save();
                ctx.globalAlpha = p.life;
                ctx.fillStyle = p.color;
                ctx.beginPath();
                ctx.arc(p.x, p.y, p.size * p.life, 0, Math.PI * 2);
                ctx.fill();
                ctx.restore();
            }
        }
        
        function drawUI() {
            // Score
            ctx.save();
            ctx.font = 'bold 24px Segoe UI, sans-serif';
            ctx.fillStyle = COLORS.ui.text;
            ctx.textAlign = 'left';
            ctx.textBaseline = 'top';
            ctx.shadowColor = '#000000';
            ctx.shadowBlur = 4;
            
            const scoreText = `Score: ${score}`;
            ctx.fillText(scoreText, 20, 20);
            
            // Speed run time
            const minutes = Math.floor(speedRunTime / 60);
            const seconds = Math.floor(speedRunTime % 60);
            const timeText = `Time: ${minutes}:${seconds.toString().padStart(2, '0')}`;
            ctx.fillText(timeText, 20, 50);
            
            // Speed indicator
            const speedPercent = Math.round(((currentSpeed - BASE_SPEED) / (MAX_SPEED - BASE_SPEED)) * 100);
            ctx.fillStyle = COLORS.food;
            ctx.fillText(`Speed: ${speedPercent}%`, 20, 80);
            
            // High score
            ctx.fillStyle = COLORS.ui.text;
            ctx.textAlign = 'right';
            ctx.fillText(`Best: ${highScore}`, BASE_WIDTH - 20, 20);
            
            // Snake length
            ctx.textAlign = 'left';
            ctx.fillText(`Length: ${snake.length}`, BASE_WIDTH - 20, 50);
            
            ctx.restore();
        }
        
        function drawButton(text, x, y, w, h, key, isHovered) {
            const radius = 8;
            const color = isHovered ? '#ffffff' : COLORS.ui.button;
            
            ctx.save();
            ctx.shadowColor = color;
            ctx.shadowBlur = isHovered ? 20 : 10;
            
            // Background
            ctx.fillStyle = color;
            ctx.beginPath();
            ctx.roundRect(x, y, w, h, radius);
            ctx.fill();
            
            // Text
            ctx.shadowBlur = 0;
            ctx.fillStyle = COLORS.ui.buttonText;
            ctx.font = 'bold 20px Segoe UI, sans-serif';
            ctx.textAlign = 'center';
            ctx.textBaseline = 'middle';
            ctx.fillText(text, x + w/2, y + h/2);
            
            ctx.restore();
            
            buttons[key] = { x, y, w, h };
        }
        
        function drawMenu() {
            drawBackground();
            
            // Title
            ctx.save();
            ctx.shadowColor = '#7b2cbf';
            ctx.shadowBlur = 20;
            ctx.font = 'bold 64px Segoe UI, sans-serif';
            ctx.fillStyle = COLORS.ui.text;
            ctx.textAlign = 'center';
            ctx.textBaseline = 'middle';
            ctx.fillText('PORTAL SNAKE', BASE_WIDTH/2, 150);
            
            // Subtitle
            ctx.shadowColor = '#f5576c';
            ctx.shadowBlur = 10;
            ctx.font = '20px Segoe UI, sans-serif';
            ctx.fillStyle = '#aaa';
            ctx.fillText('Enter portals, eat food, survive!', BASE_WIDTH/2, 200);
            
            // High score
            if (highScore > 0) {
                ctx.shadowColor = '#4ecdc4';
                ctx.fillStyle = COLORS.ui.success;
                ctx.fillText(`High Score: ${highScore}`, BASE_WIDTH/2, 250);
            }
            
            ctx.restore();
            
            // Play button
            const btnW = 200;
            const btnH = 50;
            const btnX = BASE_WIDTH/2 - btnW/2;
            const btnY = 320;
            const hovered = isPointInButton(mousePos.x, mousePos.y, 'play');
            drawButton('PLAY', btnX, btnY, btnW, btnH, 'play', hovered);
            
            // Controls info
            ctx.font = '16px Segoe UI, sans-serif';
            ctx.fillStyle = '#888';
            ctx.textAlign = 'center';
            ctx.fillText('Arrow Keys / WASD to move', BASE_WIDTH/2, 420);
            ctx.fillText('G to toggle grid | ESC to pause', BASE_WIDTH/2, 445);
            ctx.fillText('Touch: swipe to move, hold center to pause', BASE_WIDTH/2, 470);
        }
        
        function drawPauseMenu() {
            // Darken background
            ctx.fillStyle = 'rgba(0, 0, 0, 0.6)';
            ctx.fillRect(0, 0, BASE_WIDTH, BASE_HEIGHT);
            
            // Title
            ctx.save();
            ctx.font = 'bold 48px Segoe UI, sans-serif';
            ctx.fillStyle = COLORS.ui.text;
            ctx.textAlign = 'center';
            ctx.textBaseline = 'middle';
            ctx.fillText('PAUSED', BASE_WIDTH/2, 180);
            
            // Score
            ctx.font = '24px Segoe UI, sans-serif';
            ctx.fillStyle = COLORS.food;
            ctx.fillText(`Current Score: ${score}`, BASE_WIDTH/2, 240);
            ctx.restore();
            
            // Buttons
            const btnW = 180;
            const btnH = 45;
            const btnX = BASE_WIDTH/2 - btnW/2;
            
            const resumeHovered = isPointInButton(mousePos.x, mousePos.y, 'resume');
            drawButton('RESUME', btnX, 300, btnW, btnH, 'resume', resumeHovered);
            
            const menuHovered = isPointInButton(mousePos.x, mousePos.y, 'menu');
            drawButton('MENU', btnX, 360, btnW, btnH, 'menu', menuHovered);
        }
        
        function drawGameOver() {
            // Darken background
            ctx.fillStyle = 'rgba(0, 0, 0, 0.7)';
            ctx.fillRect(0, 0, BASE_WIDTH, BASE_HEIGHT);
            
            // Title
            ctx.save();
            ctx.shadowColor = COLORS.ui.danger;
            ctx.shadowBlur = 15;
            ctx.font = 'bold 56px Segoe UI, sans-serif';
            ctx.fillStyle = COLORS.ui.danger;
            ctx.textAlign = 'center';
            ctx.textBaseline = 'middle';
            ctx.fillText('GAME OVER', BASE_WIDTH/2, 150);
            
            // Score
            ctx.shadowColor = COLORS.food;
            ctx.shadowBlur = 10;
            ctx.font = 'bold 32px Segoe UI, sans-serif';
            ctx.fillStyle = COLORS.ui.text;
            ctx.fillText(`Score: ${score}`, BASE_WIDTH/2, 220);
            
            // Time
            const minutes = Math.floor(speedRunTime / 60);
            const seconds = Math.floor(speedRunTime % 60);
            ctx.font = '20px Segoe UI, sans-serif';
            ctx.fillStyle = '#aaa';
            ctx.fillText(`Time: ${minutes}:${seconds.toString().padStart(2, '0')}`, BASE_WIDTH/2, 260);
            
            // New high score
            if (isNewHighScore) {
                ctx.shadowColor = COLORS.ui.success;
                ctx.fillStyle = COLORS.ui.success;
                ctx.font = 'bold 28px Segoe UI, sans-serif';
                ctx.fillText('NEW HIGH SCORE!', BASE_WIDTH/2, 310);
            } else {
                ctx.fillStyle = '#888';
                ctx.fillText(`Best: ${highScore}`, BASE_WIDTH/2, 310);
            }
            ctx.restore();
            
            // Buttons
            const btnW = 180;
            const btnH = 45;
            const btnX = BASE_WIDTH/2 - btnW/2;
            
            const retryHovered = isPointInButton(mousePos.x, mousePos.y, 'retry');
            drawButton('RETRY', btnX, 370, btnW, btnH, 'retry', retryHovered);
            
            const menuHovered = isPointInButton(mousePos.x, mousePos.y, 'mainMenu');
            drawButton('MAIN MENU', btnX, 430, btnW, btnH, 'mainMenu', menuHovered);
        }
        
        function draw() {
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            
            switch (gameState) {
                case STATE.MENU:
                    drawMenu();
                    break;
                    
                case STATE.PLAYING:
                case STATE.PAUSED:
                    drawBackground();
                    drawGrid();
                    
                    // Draw portals
                    for (let i = 0; i < portals.length; i++) {
                        drawPortal(portals[i], i);
                    }
                    
                    drawFood();
                    drawSnake();
                    drawParticles();
                    drawUI();
                    
                    if (gameState === STATE.PAUSED) {
                        drawPauseMenu();
                    }
                    break;
                    
                case STATE.GAME_OVER:
                    drawBackground();
                    drawGrid();
                    
                    for (let i = 0; i < portals.length; i++) {
                        drawPortal(portals[i], i);
                    }
                    
                    drawFood();
                    drawSnake();
                    drawParticles();
                    drawGameOver();
                    break;
            }
        }
        
        // ============================================\n        // GAME LOOP\n        // ============================================\n        \n        function gameLoop(timestamp) {\n            if (!lastTime) lastTime = timestamp;\n            deltaTime = (timestamp - lastTime) / 1000;\n            lastTime = timestamp;\n            \n            // Cap delta time to prevent large jumps\n            deltaTime = Math.min(deltaTime, 0.1);\n            \n            update(deltaTime);\n            draw();\n            \n            requestAnimationFrame(gameLoop);\n        }\n        \n        // ============================================\n        // START\n        // ============================================\n        \n        window.addEventListener('resize', resize);\n        resize();\n        \n        // Initialize buttons array for menu\n        buttons = {};\n        \n        requestAnimationFrame(gameLoop);\n    </script>
</body>
</html>"}