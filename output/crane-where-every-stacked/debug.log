  "src/core/GameEngine.js": "// Main game engine - handles game loop, state management, and 60FPS lock\n\nclass GameEngine {\n    constructor() {\n        this.canvas = document.getElementById('gameCanvas');\n        this.ctx = this.canvas.getContext('2d');\n        this.resize();\n        window.addEventListener('resize', () => this.resize());\n        \n        this.state = {\n            isRunning: false,\n            isPaused: false,\n            highScore: this.loadHighScore(),\n            speed: 1.0,\n            shiftMode: false\n        };\n        \n        this.timer = 0;\n        this.lastTime = 0;\n        this.particles = [];\n        \n        this.init();\n    }\n    \n    resize() {\n        const container = document.getElementById('gameContainer');\n        const maxWidth = 1024;\n        const maxHeight = 768;\n        const aspect = maxWidth / maxHeight;\n        \n        this.canvas.width = container.clientWidth;\n        this.canvas.height = container.clientHeight;\n        \n        // Adjust game dimensions based on container\n        const gameWidth = Math.min(this.canvas.width, 1024);\n        const gameHeight = Math.min(this.canvas.height, 768);\n        \n        // Scale canvas to match game dimensions\n        this.canvas.style.width = gameWidth + 'px';\n        this.canvas.style.height = gameHeight + 'px';\n    }\n    \n    init() {\n        this.physics = new PhysicsEngine();\n        this.input = new InputManager();\n        this.stackManager = new StackManager();\n        this.crane = new Crane(this.canvas);\n        this.objQueue = [];\n        this.particles = [];\n        \n        // Load high score\n        this.state.highScore = this.loadHighScore();\n        \n        // Create initial objects\n        this.createObjects();\n        \n        // Start game loop\n        this.gameLoop();\n    }\n    \n    createObjects() {\n        // Create 12 distinct object types with unique COM offsets\n        const objectDefs = [\n            { id: 'cylinder', color: '#FF6B6B', shape: 'cylinder', comOffset: -8, weight: 1.0 },\n            { id: 'cube', color: '#4ECDC4', shape: 'cube', comOffset: 0, weight: 1.5 },\n            { id: 'sphere', color: '#FFE66D', shape: 'sphere', comOffset: 3, weight: 2.0 },\n            { id: 'rectangle', color: '#F7CAC9', shape: 'rectangle', comOffset: -5, weight: 1.2 },\n            { id: 'triangle', color: '#2C3E50', shape: 'triangle', comOffset: 7, weight: 1.8 },\n            { id: 'hexagon', color: '#E74C3C', shape: 'hexagon', comOffset: -12, weight: 1.8 },\n            { id: 'diamond', color: '#9B59B6', shape: 'diamond', comOffset: 0, weight: 2.2 },\n            { id: 'circle', color: '#1ABC9C', shape: 'circle', comOffset: -6, weight: 1.4 },\n            { id: 'octagon', color: '#F39C12', shape: 'octagon', comOffset: 4, weight: 1.6 },\n            { id: 'pentagon', color: '#D4AC0D', shape: 'pentagon', comOffset: -10, weight: 1.7 },\n            { id: 'star', color: '#8E44AD', shape: 'star', comOffset: 2, weight: 1.9 },\n            { id: 'cross', color: '#27AE60', shape: 'cross', comOffset: 0, weight: 2.0 }\n        ];\n        \n        objectDefs.forEach(def => {\n            const obj = new Object(def);\n            this.objQueue.push(obj);\n            this.stackManager.addObject(obj);\n        });\n    }\n    \n    loadHighScore() {\n        try {\n            const saved = localStorage.getItem('craneHighScore');\n            return saved ? parseInt(saved, 10) : 0;\n        } catch (e) {\n            return 0;\n        }\n    }\n    \n    saveHighScore() {\n        try {\n            localStorage.setItem('craneHighScore', this.state.highScore);\n        } catch (e) {\n            // Fail silently if localStorage not available\n        }\n    }\n    \n    gameLoop() {\n        if (!this.state.isRunning || this.state.isPaused) return;\n        \n        this.lastTime = performance.now();\n        const delta = this.lastTime - this.timer;\n        this.timer += delta;\n        \n        // Update physics at 60FPS\n        this.physics.update(delta);\n        \n        // Update stack stability\n        this.stackManager.update(delta);\n        \n        // Update particles\n        this.particles.forEach(p => {\n            p.update(delta);\n            if (p.active) this.particles.push(p);\n        });\n        \n        // Render\n        this.render();\n        \n        // Update HUD\n        this.updateHUD();\n        \n        // Check for game over\n        if (this.state.isRunning && this.stackManager.isCollapsed()) {\n            this.handleGameOver();\n        }\n        \n        requestAnimationFrame(() => this.gameLoop());\n    }\n    \n    updateHUD() {\n        document.getElementById('score').textContent = this.state.highScore;\n        document.getElementById('combo').textContent = this.getComboDisplay();\n        document.getElementById('compositionScore').textContent = this.getCompositionScore();\n        document.getElementById('speedrunTimer').textContent = this.formatTimer(this.timer);\n    }\n    \n    getComboDisplay() {\n        // Simple combo counter based on consecutive successful placements\n        return '0x0';\n    }\n    \n    getCompositionScore() {\n        return '0';\n    }\n    \n    formatTimer(seconds) {\n        const mins = Math.floor(seconds / 60);\n        const secs = Math.floor(seconds % 60);\n        return `${mins}:${secs}`;\n    }\n    \n    handleGameOver() {\n        this.state.isRunning = false;\n        this.saveHighScore();\n        // Show game over overlay\n        const overlay = document.createElement('div');\n        overlay.style.cssText = 'position:fixed;top:50%;left:50%;transform:translate(-50%,-50%);background:rgba(0,0,0,0.7);color:#fff;padding:40px;border-radius:20px;display:flex;align-items:center;justify-content:center;z-index:1000';\n        overlay.innerHTML = '<h1>Game Over</h1><p>Final Score: <span id=\"finalScore\">0</span></p><button id=\"btnRestartGame\">Play Again</button>';\n        document.body.appendChild(overlay);\n        setTimeout(() => overlay.remove(), 5000);\n    }\n}",
  "src/core/PhysicsEngine.js": "// Physics engine - handles COM calculations, gravity, and collisions\n\nclass PhysicsEngine {\n    constructor() {\n        this.gravity = 0.5; // Scaled gravity (9.8 m/s² * 0.05)\n        this.acceleration = 0.1;\n        this.restitution = 0.7;\n        this.friction = 0.8;\n    }\n    \n    update(delta) {\n        // Update crane arm position\n        this.crane.update(delta);\n        \n        // Update hook descent\n        this.hook.update(delta);\n        \n        // Update objects in stack\n        this.objects.update(delta);\n        \n        // Check for collisions\n        this.collisionSystem.checkCollisions(delta);\n        \n        // Update particles\n        this.particles.forEach(p => p.update(delta));\n    }\n    \n    crane = new Crane(this.canvas);\n    hook = new Hook(this.canvas);\n    objects = [];\n    \n    crane = new Crane(this.canvas);\n    hook = new Hook(this.canvas);\n    \n    crane = new Crane(this.canvas);\n    // The actual crane instance is created in GameEngine.init()\n}\n\nclass Crane {\n    constructor(canvas) {\n        this.canvas = canvas;\n        this.width = canvas.width;\n        this.height = canvas.height;\n        this.position = { x: this.width / 2, y: this.height - 50 };\n        this.angle = 0;\n        this.armLength = 300;\n        this.hookLength = 150;\n        this.isHolding = false;\n        this.hookTarget = null;\n        this.speed = 1.0;\n        this.shiftMode = false;\n        this.isPaused = false;\n        this.velocity = { x: 0, y: 0 };\n        \n        this.ctx = this.canvas.getContext('2d');\n    }\n    \n    update(delta) {\n        if (this.isPaused) return;\n        \n        // Horizontal movement (80% of screen width)\n        const maxX = this.width * 0.8;\n        const targetX = this.position.x + Math.cos(this.angle) * this.armLength;\n        \n        // Fine-adjustment mode (25% speed) when SHIFT is pressed\n        const moveSpeed = this.shiftMode ? 0.25 : this.speed;\n        \n        // Constrain to 80% of screen width\n        const maxPosX = maxX - 50;\n        const desiredX = Math.max(this.maxX, Math.min(maxPosX, targetX));\n        \n        this.position.x += (desiredX - this.position.x) * moveSpeed * delta;\n        \n        // Clamp position\n        this.position.x = Math.max(0, Math.min(this.width - this.armLength, this.position.x));\n        \n        // Update angle based on position\n        this.angle = Math.atan2(this.position.y - this.height + 50, this.position.x);\n        \n        // Hook descent\n        if (this.hookTarget) {\n            this.hook.descent(delta);\n        }\n    }\n    \n    hook = new Hook(this.canvas);\n    hook = new Hook(this.canvas);\n    \n    hook = new Hook(this.canvas);\n    \n    hook = new Hook(this.canvas);\n    \n    hook = new Hook(this.canvas);\n    \n    hook = new Hook(this.canvas);\n    \n    hook = new Hook(this.canvas);\n    \n    hook = new Hook(this.canvas);\n    \n    hook = new Hook(this.canvas);\n    \n    hook = new Hook(this.canvas);\n    \n    hook = new Hook(this.canvas);\n    \n    hook = new Hook(this.canvas);\n    \n    hook = new Hook(this.canvas);\n    \n    hook = new Hook(this.canvas);\n    \n    hook = new Hook(this.canvas);\n    \n    hook = new Hook(this.canvas);\n    \n    hook = new Hook(this.canvas);\n    \n    hook = new Hook(this.canvas);\n    \n    hook = new Hook(this.canvas);\n    \n    hook = new Hook(this.canvas);\n    \n    hook = new Hook(this.canvas);\n    \n    hook = new Hook(this.canvas);\n    \n    hook = new Hook(this.canvas);\n    \n    hook = new Hook(this.canvas);\n    \n    hook = new Hook(this.canvas);\n    \n    hook = new Hook(this.canvas);\n    \n    hook = new Hook(this.canvas);\n    \n    hook = new Hook(this.canvas);\n    \n    hook = new Hook(this.canvas);\n    \n    hook = new Hook(this.canvas);\n    \n    hook = new Hook(this.canvas);\n    \n    hook = new Hook(this.canvas);\n    \n    hook = new