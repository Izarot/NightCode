6. "src/features/game/gameLogic.js": "import { safetyService } from '../../core/safety/safetyService.js';\\nimport { safetyCheck } from '../../core/safety/safetyHook.js';\\nimport { audioService } from '../../services/audioService.js';\\nimport { palette } from '../../config/palette.js';\\n\\nlet canvas, ctx;\\nlet timer = 0;\\nlet score = 0;\\nlet highScore = 0;\\nlet gameRunning = true;\\n\\nfunction init() {\\n  safetyService.requestConsent();\\n\\n  highScore = parseInt(localStorage.getItem('highScore')) || 0;\\n\\n  canvas = document.getElementById('gameCanvas');\\n  ctx = canvas.getContext('2d');\\n  resizeCanvas();\\n\\n  window.addEventListener('resize', resizeCanvas);\\n  setInterval(updateTimer, 1000);\\n  audioService.init();\\n  requestAnimationFrame(gameLoop);\\n}\\n\\nfunction resizeCanvas() {\\n  canvas.width = window.innerWidth;\\n  canvas.height = window.innerHeight;\\n}\\n\\nfunction updateTimer() {\\n  if (!gameRunning) return;\\n  timer++;\\n  const mins = Math.floor(timer / 60);\\n  const secs = timer % 60;\\n  document.getElementById('timer').textContent = `${String(mins).padStart(2, '0')}:${String(secs).padStart(2, '0')}\\);\\n  if (score > highScore) {\\n    highScore = score;\\n    localStorage.setItem('highScore', highScore);\\n    audioService.playSound('highScore');\\n  }\\n}\\n\\nconst square = {\\n  x: 0,\\n  y: 0,\\n  size: 50,\\n  speed: 2,\\n  dx: 2,\\n  dy: 2\\n};\\n\\nfunction gameLoop() {\\n  if (!gameRunning) return;\\n  draw();\\n  update();\\n  requestAnimationFrame(gameLoop);\\n}\\n\\nfunction update() {\\n  if (!safetyCheck()) return;\\n  square.x += square.dx;\\n  square.y += square.dy;\\n\\n  if (square.x <= 0 || square.x + square.size >= canvas.width) square.dx *= -1;\\n  if (square.y <= 0 || square.y + square.size >= canvas.height) square.dy *= -1;\\n\\n  canvas.addEventListener('click', (e) => {\\n    const rect = canvas.getBoundingClientRect();\\n    const clickX = e.clientX - rect.left;\\n    const clickY = e.clientY - rect.top;\\n    if (clickX >= square.x && clickX <= square.x + square.size && clickY >= square.y && clickY <= square.y + square.size) {\\n      score++;\\n      audioService.playSound('click');\\n    }\\n  });\\n}\\n\\nfunction draw() {\\n  ctx.clearRect(0, 0, canvas.width, canvas.height);\\n  ctx.fillStyle = palette.primary;\\n  ctx.fillRect(square.x, square.y, square.size, square.size);\\n}\\n\\ninit();"

Check that we escaped double quotes: there are none inside except maybe in template literal `${String(mins)...}` which uses backticks, not double quotes. So fine.

