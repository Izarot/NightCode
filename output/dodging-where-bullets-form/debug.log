export const safetyService = {
  checkConsent: () => {
    return !!localStorage.getItem('consentGiven');
  },
  requestConsent: () => {
    if (!safetyService.checkConsent()) {
      const given = confirm('Do you consent to play?');
      if (given) {
        localStorage.setItem('consentGiven', 'true');
      }
    }
  },
  emergencyStop: () => {
    localStorage.setItem('gamePaused', 'true');
  },
  isPaused: () => {
    return localStorage.getItem('gamePaused') === 'true';
  },
  resume: () => {
    localStorage.removeItem('gamePaused');
  }
};

