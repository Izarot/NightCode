```js
function collapse(cleared){
  // Row collapse: for each cleared row, move cells above down
  const clearedRows = new Set();
  cleared.forEach(idx=>{
    const r=Math.floor(idx/COLS), c=idx%COLS;
    clearedRows.add(r);
  });
  for(let r=0;r<ROWS;r++){
    if(clearedRows.has(r)){
      // gather cells from rows above
      const cells=[];
      for(let rr=r-1;rr>=0;rr--) for(let cc=0;cc<COLS;cc++) if(grid[rr][cc]) cells.push([rr,cc]);
      // place them in row r
      for(let cc=0;cc<COLS;cc++) grid[r][cc]=0;
      cells.forEach(([rr,cc])=>grid[r][cc]=grid[rr][cc]);
    }
  }
  // Column collapse: for each cleared col, move cells left of it right
  const clearedCols = new Set();
  cleared.forEach(idx=>{
    const r=Math.floor(idx/COLS), c=idx%COLS;
    clearedCols.add(c);
  });
  for(let c=0;c<COLS;c++){
    if(clearedCols.has(c)){
      const cells=[];
      for(let cc=c-1;cc>=0;cc--) for(let rr=0;rr<ROWS;rr++) if(grid[rr][cc]) cells.push([rr,cc]);
      for(let rr=0;rr<ROWS;rr++) grid[rr][c]=0;
      cells.forEach(([rr,cc])=>grid[rr][c+1]=grid[rr][cc]);
    }
  }
}
```

