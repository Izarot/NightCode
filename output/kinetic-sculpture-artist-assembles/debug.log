  "index.html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, user-scalable=no\">\n    <title>SCRAPKIN</title>\n    <link rel=\"icon\" href=\"data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🤖</text></svg>\">\n    <style>\n        * { margin: 0; padding: 0; box-sizing: border-box; }\n        body { background: #1a1a2e; overflow: hidden; font-family: 'Courier New', monospace; }\n        canvas { display: block; width: 100vw; height: 100vh; touch-action: none; }\n        #game-container { position: relative; width: 100vw; height: 100vh; }\n    </style>\n</head>\n<body>\n    <div id=\"game-container\"><canvas id=\"game-canvas\"></canvas></div>\n    <script type=\"module\" src=\"src/main.js\"></script>\n</body>\n</html>",
  "src/main.js": "import { InputManager } from './core/input.js';\nimport { AudioEngine } from './core/audio.js';\nimport { GameTimer } from './core/timing.js';\nimport { Player } from './game/player.js';\nimport { Inventory } from './game/inventory.js';\nimport { AssemblySystem } from './game/assembly.js';\nimport { ConstructManager } from './game/constructs.js';\nimport { EnemyManager } from './game/enemies.js';\nimport { CombatSystem } from './game/combat.js';\nimport { World } from './game/world.js';\nimport { Renderer } from './render/renderer.js';\nimport { ParticleSystem } from './render/particles.js';\nimport { EffectSystem } from './render/effects.js';\nimport { HUD } from './render/hud.js';\nimport { RECIPES } from './data/recipes.js';\n\nclass ScrapkinGame {\n    constructor() {\n        this.canvas = document.getElementById('game-canvas');\n        this.ctx = this.canvas.getContext('2d');\n        this.resize();\n        window.addEventListener('resize', () => this.resize());\n\n        this.input = new InputManager(this.canvas);\n        this.audio = new AudioEngine();\n        this.timer = new GameTimer();\n        this.particles = new ParticleSystem();\n        this.effects = new EffectSystem(this.particles);\n        this.world = new World(this.canvas.width, this.canvas.height);\n        this.inventory = new Inventory();\n        this.player = new Player(this.canvas.width / 2, this.canvas.height / 2, this.input, this.audio, this.particles, this.inventory);\n        this.assembly = new AssemblySystem(this.player, this.inventory, RECIPES, this.audio, this.particles);\n        this.constructs = new ConstructManager(this.audio, this.particles);\n        this.enemies = new EnemyManager(this.world, this.player, this.audio, this.particles);\n        this.combat = new CombatSystem(this.player, this.enemies, this.constructs, this.audio, this.particles);\n        this.renderer = new Renderer(this.ctx, this.canvas.width, this.canvas.height);\n        this.hud = new HUD(this.ctx, this.canvas.width, this.canvas.height, this.player, this.inventory, this.assembly, this.constructs, this.timer);\n\n        this.running = true;\n        this.lastTime = 0;\n        this.accumulator = 0;\n        this.fixedTimestep = 1 / 60;\n        this.maxSubSteps = 5;\n\n        this.highScore = parseInt(localStorage.getItem('scrapkin_highscore') || '0', 10);\n        this.sessionScore = 0;\n\n        requestAnimationFrame(this.gameLoop.bind(this));\n    }\n\n    resize() {\n        const container = document.getElementById('game-container');\n        const rect = container.getBoundingClientRect();\n        const dpr = window.devicePixelRatio || 1;\n        this.canvas.width = rect.width * dpr;\n        this.canvas.height = rect.height * dpr;\n        this.canvas.style.width = rect.width + 'px';\n        this.canvas.style.height = rect.height + 'px';\n        this.ctx.scale(dpr, dpr);\n        this.logicalWidth = rect.width;\n        this.logicalHeight = rect.height;\n        if (this.renderer) this.renderer.resize(this.logicalWidth, this.logicalHeight);\n        if (this.hud) this.hud.resize(this.logicalWidth, this.logicalHeight);\n        if (this.world) this.world.resize(this.logicalWidth, this.logicalHeight);\n    }\n\n    gameLoop(timestamp) {\n        if (!this.running) return;\n        const deltaTime = (timestamp - this.lastTime) / 1000;\n        this.lastTime = timestamp;\n        this.accumulator += Math.min(deltaTime, 0.1);\n\n        let subSteps = 0;\n        while (this.accumulator >= this.fixedTimestep && subSteps < this.maxSubSteps) {\n            this.update(this.fixedTimestep);\n            this.accumulator -= this.fixedTimestep;\n            subSteps++;\n        }\n\n        const alpha = this.accumulator / this.fixedTimestep;\n        this.render(alpha);\n        requestAnimationFrame(this.gameLoop.bind(this));\n    }\n\n    update(dt) {\n        this.timer.update(dt);\n        this.input.update();\n        this.player.update(dt, this.world);\n        this.assembly.update(dt);\n        this.constructs.update(dt, this.world);\n        this.enemies.update(dt, this.world);\n        this.combat.update(dt);\n        this.particles.update(dt);\n        this.effects.update(dt);\n        this.world.update(dt);\n\n        if (this.player.health <= 0) {\n            this.gameOver();\n        }\n    }\n\n    render(alpha) {\n        this.ctx.clearRect(0, 0, this.logicalWidth, this.logicalHeight);\n        this.renderer.renderWorld(this.world, this.player);\n        this.constructs.render(this.ctx, alpha);\n        this.enemies.render(this.ctx, alpha);\n        this.player.render(this.ctx, alpha);\n        this.particles.render(this.ctx);\n        this.effects.render(this.ctx);\n        this.assembly.render(this.ctx);\n        this.hud.render();\n    }\n\n    gameOver() {\n        this.running = false;\n        this.sessionScore = Math.floor(this.timer.elapsed * 100) + this.player.scrapCollected * 10;\n        if (this.sessionScore > this.highScore) {\n            this.highScore = this.sessionScore;\n            localStorage.setItem('scrapkin_highscore', this.highScore.toString());\n        }\n        this.audio.playGameOver();\n        setTimeout(() => {\n            if (confirm(`GAME OVER\\nScore: ${this.sessionScore}\\nHigh Score: ${this.highScore}\\n\\nPlay again?`)) {\n                location.reload();\n            }\n        }, 500);\n    }\n}\n\nnew ScrapkinGame();",
  "src/core/input.js": "export class InputManager {\n    constructor(canvas) {\n        this.canvas = canvas;\n        this.keys = new Set();\n        this.mouse = { x: 0, y: 0, down: false, justPressed: false, justReleased: false };\n        this.touch = { x: 0, y: 0, active: false };\n        this.bindEvents();\n    }\n\n    bindEvents() {\n        window.addEventListener('keydown', (e) => {\n            this.keys.add(e.code);\n            if (e.code === 'Space') e.preventDefault();\n        });\n        window.addEventListener('keyup', (e) => this.keys.delete(e.code));\n\n        this.canvas.addEventListener('mousemove', (e) => {\n            const rect = this.canvas.getBoundingClientRect();\n            this.mouse.x = (e.clientX - rect.left) * (this.canvas.width / rect.width);\n            this.mouse.y = (e.clientY - rect.top) * (this.canvas.height / rect.height);\n        });\n        this.canvas.addEventListener('mousedown', (e) => {\n            this.mouse.down = true;\n            this.mouse.justPressed = true;\n        });\n        this.canvas.addEventListener('mouseup', () => {\n            this.mouse.down = false;\n            this.mouse.justReleased = true;\n        });\n\n        this.canvas.addEventListener('touchstart', (e) => {\n            e.preventDefault();\n            const touch = e.touches[0];\n            const rect = this.canvas.getBoundingClientRect();\n            this.touch.x = (touch.clientX - rect.left) * (this.canvas.width / rect.width);\n            this.touch.y = (touch.clientY - rect.top) * (this.canvas.height / rect.height);\n            this.touch.active = true;\n            this.mouse.down = true;\n            this.mouse.justPressed = true;\n            this.mouse.x = this.touch.x;\n            this.mouse.y = this.touch.y;\n        }, { passive: false });\n        this.canvas.addEventListener('touchmove', (e) => {\n            e.preventDefault();\n            const touch = e.touches[0];\n            const rect = this.canvas.getBoundingClientRect();\n            this.touch.x = (touch.clientX - rect.left) * (this.canvas.width / rect.width);\n            this.touch.y = (touch.clientY - rect.top) * (this.canvas.height / rect.height);\n            this.mouse.x = this.touch.x;\n            this.mouse.y = this.touch.y;\n        }, { passive: false });\n        this.canvas.addEventListener('touchend', () => {\n            this.touch.active = false;\n            this.mouse.down = false;\n            this.mouse.justReleased = true;\n        });\n\n        window.addEventListener('blur', () => {\n            this.keys.clear();\n            this.mouse.down = false;\n        });\n    }\n\n    update() {\n        this.mouse.justPressed = false;\n        this.mouse.justReleased = false;\n    }\n\n    isKeyDown(code) { return this.keys.has(code); }\n    isKeyJustPressed(code) { return this.keys.has(code) && !this.prevKeys?.has(code); }\n    getMousePos() { return { x: this.mouse.x, y: this.mouse.y }; }\n}",
  "src/core/audio.js": "export class AudioEngine {\n    constructor() {\n        this.ctx = new (window.AudioContext || window.webkitAudioContext)();\n        this.masterGain = this.ctx.createGain();\n        this.masterGain.connect(this.ctx.destination);\n        this.masterGain.gain.value = 0.3;\n        this.enabled = true;\n        this.unlockAudio();\n    }\n\n    unlockAudio() {\n        const resume = () => {\n            if (this.ctx.state === 'suspended') this.ctx.resume();\n            document.removeEventListener('click', resume);\n            document.removeEventListener('keydown', resume);\n        };\n        document.addEventListener('click', resume);\n        document.addEventListener('keydown', resume);\n    }\n\n    createOscillator(type, freq, duration, gainValue = 0.1) {\n        if (!this.enabled) return;\n        const osc = this.ctx.createOscillator();\n        const gain = this.ctx.createGain();\n        osc.type = type;\n        osc.frequency.value = freq;\n        gain.gain.value = gainValue;\n        osc.connect(gain);\n        gain.connect(this.masterGain);\n        osc.start();\n        gain.gain.exponentialRampToValueAtTime(0.001, this.ctx.currentTime + duration);\n        osc.stop(this.ctx.currentTime + duration);\n    }\n\n    playPickup() {\n        this.createOscillator('sine', 800, 0.1, 0.15);\n        setTimeout(() => this.createOscillator('sine', 1200, 0.1, 0.1), 50);\n    }\n\n    playAssemble() {\n        for (let i = 0; i < 3; i++) {\n            setTimeout(() => this.createOscillator('square', 200 + i * 100, 0.15, 0.1), i * 50);\n        }\n    }\n\n    playDeploy() {\n        this.createOscillator('sawtooth', 150, 0.3, 0.2);\n        this.createOscillator('triangle', 300, 0.2, 0.1);\n    }\n\n    playLaunch() {\n        this.createOscillator('sine', 400, 0.1, 0.2);\n        this.createOscillator('sine', 600, 0.15, 0.15);\n    }\n\n    playDamage() {\n        this.createOscillator('sawtooth', 100, 0.2, 0.3);\n    }\n\n    playEnemyHit() {\n        this.createOscillator('square', 300, 0.1, 0.2);\n        this.createOscillator('noise', 800, 0.05, 0.1);\n    }\n\n    playShockwave() {\n        this.createOscillator('sine', 80, 0.5, 0.4);\n        this.createOscillator('triangle', 160, 0.3, 0.2);\n    }\n\n    playGameOver() {\n        const notes = [200, 150, 100, 80];\n        notes.forEach((f, i) => setTimeout(() => this.createOscillator('sine', f, 0.5, 0.2), i * 200));\n    }\n\n    playAmbientHum() {\n        if (this.ambientOsc) return;\n        this.ambientOsc = this.ctx.createOscillator();\n        this.ambientGain = this.ctx.createGain();\n        this.ambientOsc.type = 'sine';\n        this.ambientOsc.frequency.value = 60;\n        this.ambientGain.gain.value = 0.02;\n        this.ambientOsc.connect(this.ambientGain);\n        this.ambientGain.connect(this.masterGain);\n        this.ambientOsc.start();\n    }\n\n    stopAmbientHum() {\n        if (this.ambientOsc) {\n            this.ambientOsc.stop();\n            this.ambientOsc = null;\n        }\n    }\n\n    setMasterVolume(vol) { this.masterGain.gain.value = vol; }\n}",
  "src/core/math.js": "export const Vec2 = {\n    create: (x = 0, y = 0) => ({ x, y }),\n    copy: (v) => ({ x: v.x, y: v.y }),\n    add: (a, b) => ({ x: a.x + b.x, y: a.y + b.y }),\n    sub: (a, b) => ({ x: a.x - b.x, y: a.y - b.y }),\n    mul: (v, s) => ({ x: v.x * s, y: v.y * s }),\n    div: (v, s) => ({ x: v.x / s, y: v.y / s }),\n    dot: (a, b) => a.x * b.x + a.y * b.y,\n    len: (v) => Math.hypot(v.x, v.y),\n    len2: (v) => v.x * v.x + v.y * v.y,\n    normalize: (v) => { const l = Math.hypot(v.x, v.y); return l ? { x: v.x / l, y: v.y / l } : { x: 0, y: 0 }; },\n    clamp: (v, max) => { const l = Math.hypot(v.x, v.y); if (l > max) return { x: v.x / l * max, y: v.y / l * max }; return v; },\n    lerp: (a, b, t) => ({ x: a.x + (b.x - a.x) * t, y: a.y + (b.y - a.y) * t }),\n    angle: (v) => Math.atan2(v.y, v.x),\n    fromAngle: (a) => ({ x: Math.cos(a), y: Math.sin(a) }),\n    rotate: (v, a) => ({ x: v.x * Math.cos(a) - v.y * Math.sin(a), y: v.x * Math.sin(a) + v.y * Math.cos(a) }),\n    dist: (a, b) => Math.hypot(a.x - b.x, a.y - b.y),\n    dist2: (a, b) => { const dx = a.x - b.x, dy = a.y - b.y; return dx * dx + dy * dy; }\n};\n\nexport const clamp = (v, min, max) => Math.max(min, Math.min(max, v));\nexport const lerp = (a, b, t) => a + (b - a) * t;\nexport const random = (min, max) => Math.random() * (max - min) + min;\nexport const randomInt = (min, max) => Math.floor(Math.random() * (max - min + 1)) + min;\nexport const deg2rad = (d) => d * Math.PI / 180;\nexport const rad2deg = (r) => r * 180 / Math.PI;\n\nexport function rectCircleCollide(rx, ry, rw, rh, cx, cy, cr) {\n    const closestX = clamp(cx, rx, rx + rw);\n    const closestY = clamp(cy, ry, ry + rh);\n    const dx = cx - closestX;\n    const dy = cy - closestY;\n    return dx * dx + dy * dy < cr * cr;\n}\n\nexport function circleCircleCollide(x1, y1, r1, x2, y2, r2) {\n    const dx = x2 - x1, dy = y2 - y1;\n    return dx * dx + dy * dy < (r1 + r2) * (r1 + r2);\n}\n",
  "src/core/timing.js": "export class GameTimer {\n    constructor() {\n        this.elapsed = 0;\n        this.running = true;\n        this.startTime = performance.now();\n    }\n\n    update(dt) {\n        if (this.running) this.elapsed += dt;\n    }\n\n    getFormattedTime() {\n        const totalMs = this.elapsed * 1000;\n        const mins = Math.floor(totalMs / 60000);\n        const secs = Math.floor((totalMs % 60000) / 1000);\n        const ms = Math.floor((totalMs % 1000) / 10);\n        return `${mins.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}.${ms.toString().padStart(2, '0')}`;\n    }\n\n    pause() { this.running = false; }\n    resume() { this.running = true; }\n    reset() { this.elapsed = 0; this.startTime = performance.now(); }\n}",
  "src/game/player.js": "import { Vec2 } from '../core/math.js';\n\nexport class Player {\n    constructor(x, y, input, audio, particles, inventory) {\n        this.pos = Vec2.create(x, y);\n        this.vel = Vec2.create(0, 0);\n        this.acc = Vec2.create(0, 0);\n        this.radius = 18;\n        this.health = 100;\n        this.maxHealth = 100;\n        this.input = input;\n        this.audio = audio;\n        this.particles = particles;\n        this.inventory = inventory;\n        this.scrapCollected = 0;\n        this.drag = 0.88;\n        this.accelForce = 800;\n        this.maxSpeed = 200;\n        this.launchCooldown = 0;\n        this.launchPower = 1.8;\n        this.isLaunching = false;\n        this.launchTimer = 0;\n        this.legAngle = 0;\n        this.legPhase = 0;\n        this.invulnTimer = 0;\n        this.weight = 0;\n        this.updateWeight();\n    }\n\n    updateWeight() {\n        this.weight = this.inventory.items.reduce((sum, item) => sum + (item ? item.weight : 0), 0);\n        this.drag = 0.88 + this.weight * 0.02;\n        this.maxSpeed = 200 - this.weight * 5;\n    }\n\n    update(dt, world) {\n        this.updateWeight();\n        this.invulnTimer = Math.max(0, this.invulnTimer - dt);\n        this.launchCooldown = Math.max(0, this.launchCooldown - dt);\n\n        if (this.isLaunching) {\n            this.launchTimer -= dt;\n            if (this.launchTimer <= 0) {\n                this.isLaunching = false;\n                this.audio.playShockwave();\n                this.particles.emitShockwave(this.pos.x, this.pos.y, 150);\n                world.damageNearby(this.pos, 150, 30, this);\n                this.enemies?.forEach(e => { if (Vec2.dist(e.pos, this.pos) < 150) e.stun(1.5); });\n            }\n        }\n\n        const moveInput = Vec2.create(0, 0);\n        if (this.input.isKeyDown('KeyW') || this.input.isKeyDown('ArrowUp')) moveInput.y -= 1;\n        if (this.input.isKeyDown('KeyS') || this.input.isKeyDown('ArrowDown')) moveInput.y += 1;\n        if (this.input.isKeyDown('KeyA') || this.input.isKeyDown('ArrowLeft')) moveInput.x -= 1;\n        if (this.input.isKeyDown('KeyD') || this.input.isKeyDown('ArrowRight')) moveInput.x += 1;\n\n        const mouse = this.input.getMousePos();\n        const toMouse = Vec2.sub(mouse, this.pos);\n        const mouseDist = Vec2.len(toMouse);\n\n        if (Vec2.len(moveInput) > 0) {\n            const dir = Vec2.normalize(moveInput);\n            this.acc = Vec2.mul(dir, this.accelForce);\n        } else if (mouseDist > 20) {\n            const dir = Vec2.normalize(toMouse);\n            this.acc = Vec2.mul(dir, this.accelForce * 0.6);\n        } else {\n            this.acc = Vec2.create(0, 0);\n        }\n\n        this.vel = Vec2.add(this.vel, Vec2.mul(this.acc, dt));\n        this.vel = Vec2.mul(this.vel, this.drag);\n        this.vel = Vec2.clamp(this.vel, this.maxSpeed);\n        this.pos = Vec2.add(this.pos, Vec2.mul(this.vel, dt));\n\n        this.pos.x = clamp(this.pos.x, this.radius, world.width - this.radius);\n        this.pos.y = clamp(this.pos.y, this.radius, world.height - this.radius);\n\n        if (this.input.isKeyDown('Space') && this.launchCooldown <= 0 && !this.isLaunching) {\n            this.vel = Vec2.mul(this.vel, this.launchPower);\n            this.isLaunching = true;\n            this.launchTimer = 0.8;\n            this.launchCooldown = 2.5;\n            this.audio.playLaunch();\n            this.particles.emitLaunch(this.pos, this.vel);\n        }\n\n        if (this.input.isKeyDown('KeyE')) {\n            this.assemblyMode = true;\n        } else {\n            this.assemblyMode = false;\n        }\n\n        this.legPhase += Vec2.len(this.vel) * dt * 0.05;\n        this.legAngle = Math.sin(this.legPhase) * 0.5;\n\n        world.scrapPiles.forEach(pile => {\n            if (Vec2.dist(this.pos, pile.pos) < this.radius + pile.radius) {\n                const collected = pile.collect(this.inventory);\n                if (collected) {\n                    this.scrapCollected++;\n                    this.audio.playPickup();\n                    this.particles.emitPickup(pile.pos);\n                }\n            }\n        });\n    }\n\n    takeDamage(amount, knockback) {\n        if (this.invulnTimer > 0) return;\n        this.health = Math.max(0, this.health - amount);\n        this.invulnTimer = 1.0;\n        this.vel = Vec2.add(this.vel, knockback);\n        this.audio.playDamage();\n        this.particles.emitDamage(this.pos);\n    }\n\n    render(ctx, alpha) {\n        ctx.save();\n        ctx.translate(this.pos.x, this.pos.y);\n        const speed = Vec2.len(this.vel);\n        const bodyAngle = speed > 10 ? Vec2.angle(this.vel) : (this.input.getMousePos().x - this.pos.x > 0 ? 0 : Math.PI);\n        ctx.rotate(bodyAngle);\n\n        if (this.invulnTimer > 0 && Math.floor(this.invulnTimer * 10) % 2 === 0) {\n            ctx.globalAlpha = 0.5;\n        }\n\n        ctx.strokeStyle = '#00ffff';\n        ctx.lineWidth = 2;\n        ctx.fillStyle = '#2f3640';\n\n        ctx.beginPath();\n        ctx.ellipse(0, 0, 22, 16, 0, 0, Math.PI * 2);\n        ctx.fill();\n        ctx.stroke();\n\n        ctx.fillStyle = '#cd6f3c';\n        ctx.beginPath();\n        ctx.ellipse(15, -5, 8, 6, 0, 0, Math.PI * 2);\n        ctx.fill();\n        ctx.stroke();\n\n        ctx.fillStyle = '#00ffff';\n        ctx.beginPath();\n        ctx.arc(18, -6, 3, 0, Math.PI * 2);\n        ctx.fill();\n\n        const legLength = 25;\n        for (let i = -1; i <= 1; i += 2) {\n            const legAngle = this.legAngle * i * 0.8;\n            const hipX = -10;\n            const hipY = i * 10;\n            const kneeX = hipX + Math.sin(legAngle) * legLength * 0.5;\n            const kneeY = hipY + Math.cos(legAngle) * legLength * 0.5;\n            const footX = kneeX + Math.sin(legAngle * 1.5) * legLength * 0.5;\n            const footY = kneeY + Math.cos(legAngle * 1.5) * legLength * 0.5;\n\n            ctx.beginPath();\n            ctx.moveTo(hipX, hipY);\n            ctx.lineTo(kneeX, kneeY);\n            ctx.lineTo(footX, footY);\n            ctx.strokeStyle = '#cd6f3c';\n            ctx.lineWidth = 3;\n            ctx.stroke();\n\n            ctx.fillStyle = '#fbc531';\n            ctx.beginPath();\n            ctx.arc(footX, footY, 4, 0, Math.PI * 2);\n            ctx.fill();\n        }\n\n        if (this.isLaunching) {\n            const progress = 1 - this.launchTimer / 0.8;\n            ctx.strokeStyle = `rgba(0, 255, 255, ${0.8 - progress * 0.8})`;\n            ctx.lineWidth = 3;\n            ctx.beginPath();\n            ctx.arc(0, 0, 30 + progress * 50, 0, Math.PI * 2);\n            ctx.stroke();\n        }\n\n        ctx.restore();\n    }\n}\n\nfunction clamp(v, min, max) { return Math.max(min, Math.min(max, v)); }",
  "src/game/inventory.js": "export class Inventory {\n    constructor() {\n        this.slots = 4;\n        this.items = [];\n        this.animations = [];\n    }\n\n    addItem(type) {\n        if (this.items.length >= this.slots) return false;\n        const item = { type, ...ITEM_DEFS[type] };\n        this.items.push(item);\n        this.animations.push({ index: this.items.length - 1, scale: 1.5, time: 0.3 });\n        return true;\n    }\n\n    removeItem(index) {\n        return this.items.splice(index, 1)[0];\n    }\n\n    getItem(index) {\n        return this.items[index];\n    }\n\n    hasItems(types) {\n        const counts = {};\n        this.items.forEach(item => counts[item.type] = (counts[item.type] || 0) + 1);\n        return types.every(t => (counts[t] || 0) >= 1);\n    }\n\n    consumeItems(types) {\n        types.forEach(type => {\n            const idx = this.items.findIndex(i => i.type === type);\n            if (idx !== -1) this.items.splice(idx, 1);\n        });\n    }\n\n    update(dt) {\n        this.animations = this.animations.filter(anim => {\n            anim.time -= dt;\n            anim.scale = 1 + (anim.scale - 1) * (anim.time / 0.3);\n            return anim.time > 0;\n        });\n    }\n\n    getAnimationScale(index) {\n        const anim = this.animations.find(a => a.index === index);\n        return anim ? anim.scale : 1;\n    }\n}\n\nconst ITEM_DEFS = {\n    gear: { name: 'Gear', color: '#cd6f3c', weight: 3, icon: 'gear' },\n    piston: { name: 'Piston', color: '#707070', weight: 4, icon: 'piston' },\n    spring: { name: 'Spring', color: '#00ffff', weight: 1, icon: 'spring: { name: 'Spring', color: '#00ffff', weight: 1, icon: 'spring' },\n    circuit: { name: 'Circuit', color: '#ff6b6b', weight: 2, icon: 'circuit' },\n    battery: { name: 'Battery', color: '#fbc531', weight: 3, icon: 'battery' },\n    sensor: { name: 'Sensor', color: '#a29bfe', weight: 1, icon: 'sensor' },\n    motor: { name: 'Motor', color: '#e17055', weight: 5, icon: 'motor' }\n};\n",
  "src/game/assembly.js": "import { Vec2 } from '../core/math.js';\nimport { RECIPES } from '../data/recipes.js';\n\nexport class AssemblySystem {\n    constructor(player, inventory, recipes, audio, particles) {\n        this.player = player;\n        this.inventory = inventory;\n        this.recipes = recipes;\n        this.audio = audio;\n        this.particles = particles;\n        this.previewRecipe = null;\n        this.showPreview = false;\n        this.assemblyCooldown = 0;\n    }\n\n    update(dt) {\n        this.assemblyCooldown = Math.max(0, this.assemblyCooldown - dt);\n        \n        if (this.player.assemblyMode && this.assemblyCooldown <= 0) {\n            this.checkRecipes();\n        }\n    }\n\n    checkRecipes() {\n        for (const recipe of this.recipes) {\n            if (this.inventory.hasItems(recipe.ingredients)) {\n                this.assemble(recipe);\n                return;\n            }\n        }\n    }\n\n    assemble(recipe) {\n        this.inventory.consumeItems(recipe.ingredients);\n        const construct = recipe.result;\n        this.player.constructs.deploy(construct, this.player.pos, this.player.vel);\n        this.audio.playAssemble();\n        this.particles.emitAssemble(this.player.pos);\n        this.assemblyCooldown = 0.5;\n    }\n\n    render(ctx) {\n        if (!this.player.assemblyMode) return;\n        \n        ctx.save();\n        ctx.translate(this.player.pos.x, this.player.pos.y - 60);\n        \n        for (let i = 0; i < this.recipes.length; i++) {\n            const recipe = this.recipes[i];\n            const canMake = this.inventory.hasItems(recipe.ingredients);\n            \n            ctx.fillStyle = canMake ? 'rgba(0, 255, 255, 0.2)' : 'rgba(255, 100, 100, 0.1)';\n            ctx.strokeStyle = canMake ? '#00ffff' : '#ff6b6b';\n            ctx.lineWidth = 2;\n            \n            const y = i * 40;\n            ctx.beginPath();\n            ctx.roundRect(-80, y, 160, 35, 5);\n            ctx.fill();\n            ctx.stroke();\n            \n            ctx.fillStyle = canMake ? '#00ffff' : '#888';\n            ctx.font = '12px Courier New';\n            ctx.textAlign = 'center';\n            ctx.fillText(recipe.name, 0, y + 14);\n            \n            ctx.font = '10px Courier New';\n            const ingText = recipe.ingredients.join(' + ');\n            ctx.fillText(ingText, 0, y + 28);\n        }\n        \n        ctx.restore();\n    }\n}\n",
  "src/game/constructs.js": "import { Vec2 } from '../core/math.js';\nimport { circleCircleCollide } from '../core/math.js';\n\nconst CONSTRUCT_DEFS = {\n    turret: {\n        name: 'Turret',\n        health: 80,\n        maxHealth: 80,\n        radius: 20,\n        color: '#00ffff',\n        fireRate: 1.5,\n        range: 300,\n        damage: 15,\n        projectileSpeed: 400,\n        projectileColor: '#00ffff',\n        weight: 0\n    },\n    wall: {\n        name: 'Wall',\n        health: 200,\n        maxHealth: 200,\n        radius: 25,\n        color: '#707070',\n        fireRate: 0,\n        range: 0,\n        damage: 0,\n        projectileSpeed: 0,\n        projectileColor: '#707070',\n        weight: 0\n    },\n    launcher: {\n        name: 'Launcher',\n        health: 60,\n        maxHealth: 60,\n        radius: 22,\n        color: '#ff6b6b',\n        fireRate: 3.0,\n        range: 400,\n        damage: 30,\n        projectileSpeed: 300,\n        projectileColor: '#ff6b6b',\n        weight: 0\n    },\n    healer: {\n        name: 'Healer',\n        health: 50,\n        maxHealth: 50,\n        radius: 18,\n        color: '#00ff88',\n        fireRate: 2.0,\n        range: 150,\n        damage: -10,\n        projectileSpeed: 200,\n        projectileColor: '#00ff88',\n        weight: 0\n    },\n    shockwave: {\n        name: 'Shockwave Tower',\n        health: 100,\n        maxHealth: 100,\n        radius: 24,\n        color: '#a29bfe',\n        fireRate: 5.0,\n        range: 200,\n        damage: 25,\n        projectileSpeed: 0,\n        projectileColor: '#a29bfe',\n        weight: 0\n    }\n};\n\nexport class ConstructManager {\n    constructor(audio, particles) {\n        this.constructs = [];\n        this.audio = audio;\n        this.particles = particles;\n    }\n\n    deploy(type, pos, playerVel) {\n        const def = CONSTRUCT_DEFS[type];\n        if (!def) return;\n        \n        const construct = {\n            ...def,\n            pos: Vec2.create(pos.x, pos.y),\n            vel: Vec2.create(0, 0),\n            fireTimer: Math.random() * def.fireRate,\n            angle: 0,\n            deployTime: 0.5,\n            deployed: false\n        };\n        \n        this.constructs.push(construct);\n        this.audio.playDeploy();\n        this.particles.emitDeploy(pos);\n    }\n\n    update(dt, world) {\n        for (let i = this.constructs.length - 1; i >= 0; i--) {\n            const c = this.constructs[i];\n            \n            if (!c.deployed) {\n                c.deployTime -= dt;\n                if (c.deployTime <= 0) c.deployed = true;\n                continue;\n            }\n            \n            if (c.health <= 0) {\n                this.particles.emitExplosion(c.pos, c.color);\n                this.audio.playEnemyHit();\n                this.constructs.splice(i, 1);\n                continue;\n            }\n            \n            if (c.fireRate > 0) {\n                c.fireTimer -= dt;\n                if (c.fireTimer <= 0) {\n                    this.fireConstruct(c, world);\n                    c.fireTimer = c.fireRate;\n                }\n            }\n        }\n    }\n\n    fireConstruct(construct, world) {\n        let target = null;\n        let minDist = construct.range;\n        \n        for (const enemy of world.enemies) {\n            const dist = Vec2.dist(construct.pos, enemy.pos);\n            if (dist < minDist) {\n                minDist = dist;\n                target = enemy;\n            }\n        }\n        \n        if (target) {\n            const angle = Vec2.angle(Vec2.sub(target.pos, construct.pos));\n            construct.angle = angle;\n            \n            if (construct.name === 'Shockwave Tower') {\n                this.particles.emitShockwave(construct.pos.x, construct.pos.y, construct.range);\n                world.damageNearby(construct.pos, construct.range, construct.damage, null);\n                this.audio.playShockwave();\n            } else {\n                this.spawnProjectile(construct, angle);\n                this.audio.playLaunch();\n            }\n        }\n    }\n\n    spawnProjectile(construct, angle) {\n        const vel = Vec2.fromAngle(angle);\n        vel.x *= construct.projectileSpeed;\n        vel.y *= construct.projectileSpeed;\n        \n        construct.projectiles = construct.projectiles || [];\n        construct.projectiles.push({\n            pos: Vec2.create(construct.pos.x, construct.pos.y),\n            vel: vel,\n            damage: construct.damage,\n            color: construct.projectileColor,\n            radius: 4,\n            life: 2\n        });\n    }\n\n    updateProjectiles(dt, world) {\n        for (const c of this.constructs) {\n            if (!c.projectiles) continue;\n            \n            for (let i = c.projectiles.length - 1; i >= 0; i--) {\n                const p = c.projectiles[i];\n                p.pos.x += p.vel.x * dt;\n                p.pos.y += p.vel.y * dt;\n                p.life -= dt;\n                \n                if (p.life <= 0) {\n                    c.projectiles.splice(i, 1);\n                    continue;\n                }\n                \n                for (const enemy of world.enemies) {\n                    if (circleCircleCollide(p.pos.x, p.pos.y, p.radius, enemy.pos.x, enemy.pos.y, enemy.radius)) {\n                        enemy.takeDamage(p.damage, Vec2.mul(Vec2.normalize(p.vel), 50));\n                        this.particles.emitHit(enemy.pos, p.color);\n                        c.projectiles.splice(i, 1);\n                        break;\n                    }\n                }\n            }\n        }\n    }\n\n    render(ctx, alpha) {\n        for (const c of this.constructs) {\n            ctx.save();\n            ctx.translate(c.pos.x, c.pos.y);\n            \n            if (!c.deployed) {\n                const scale = 1 - c.deployTime / 0.5;\n                ctx.scale(scale, scale);\n                ctx.globalAlpha = scale;\n            }\n            \n            ctx.strokeStyle = c.color;\n            ctx.lineWidth = 2;\n            ctx.fillStyle = c.color + '40';\n            \n            ctx.beginPath();\n            ctx.arc(0, 0, c.radius, 0, Math.PI * 2);\n            ctx.fill();\n            ctx.stroke();\n            \n            if (c.name === 'Turret' || c.name === 'Launcher') {\n                ctx.save();\n                ctx.rotate(c.angle);\n                ctx.fillStyle = c.color;\n                ctx.beginPath();\n                ctx.moveTo(c.radius + 5, 0);\n                ctx.lineTo(c.radius + 15, -5);\n                ctx.lineTo(c.radius + 15, 5);\n                ctx.fill();\n                ctx.restore();\n            } else if (c.name === 'Healer') {\n                ctx.fillStyle = c.color;\n                ctx.font = '16px Courier New';\n                ctx.textAlign = 'center';\n                ctx.fillText('+', 0, 5);\n            } else if (c.name === 'Shockwave Tower') {\n                ctx.strokeStyle = c.color;\n                ctx.lineWidth = 1;\n                ctx.beginPath();\n                ctx.arc(0, 0, c.range * 0.5, 0, Math.PI * 2);\n                ctx.stroke();\n            }\n            \n            const healthPct = c.health / c.maxHealth;\n            ctx.fillStyle = healthPct > 0.5 ? '#00ff00' : healthPct > 0.25 ? '#ffff00' : '#ff0000';\n            ctx.fillRect(-c.radius, -c.radius - 8, c.radius * 2 * healthPct, 4);\n            ctx.strokeStyle = '#000';\n            ctx.strokeRect(-c.radius, -c.radius - 8, c.radius * 2, 4);\n            \n            ctx.restore();\n            \n            if (c.projectiles) {\n                for (const p of c.projectiles) {\n                    ctx.save();\n                    ctx.translate(p.pos.x, p.pos.y);\n                    ctx.fillStyle = p.color;\n                    ctx.beginPath();\n                    ctx.arc(0, 0, p.radius, 0, Math.PI * 2);\n                    ctx.fill();\n                    ctx.restore();\n                }\n            }\n        }\n    }\n\n    getConstructs() {\n        return this.constructs;\n    }\n}\n",
  "src/game/enemies.js": "import { Vec2 } from '../core/math.js';\nimport { circleCircleCollide, random, randomInt } from '../core/math.js';\n\nconst ENEMY_TYPES = {\n    scraper: {\n        name: 'Scraper',\n        health: 30,\n        maxHealth: 30,\n        radius: 16,\n        speed: 80,\n        color: '#ff6b6b',\n        damage: 10,\n        attackRange: 25,\n        attackCooldown: 1.0,\n        score: 10,\n        weight: 1\n    },\n    charger: {\n        name: 'Charger',\n        health: 50,\n        maxHealth: 50,\n        radius: 20,\n        speed: 120,\n        color: '#e17055',\n        damage: 20,\n        attackRange: 30,\n        attackCooldown: 2.0,\n        score: 25,\n        weight: 2\n    },\n    spitter: {\n        name: 'Spitter',\n        health: 25,\n        maxHealth: 25,\n        radius: 14,\n        speed: 50,\n        color: '#74b9ff',\n        damage: 15,\n        attackRange: 250,\n        attackCooldown: 2.5,\n        score: 20,\n        weight: 1,\n        projectileSpeed: 200,\n        projectileColor: '#74b9ff'\n    },\n    tank: {\n        name: 'Tank',\n        health: 150,\n        maxHealth: 150,\n        radius: 28,\n        speed: 40,\n        color: '#636e72',\n        damage: 30,\n        attackRange: 35,\n        attackCooldown: 3.0,\n        score: 50,\n        weight: 3\n    },\n    swarmer: {\n        name: 'Swarmer',\n        health: 15,\n        maxHealth: 15,\n        radius: 10,\n        speed: 150,\n        color: '#fd79a8',\n        damage: 5,\n        attackRange: 20,\n        attackCooldown: 0.5,\n        score: 5,\n        weight: 0.5\n    }\n};\n\nexport class EnemyManager {\n    constructor(world, player, audio, particles) {\n        this.world = world;\n        this.player = player;\n        this.audio = audio;\n        this.particles = particles;\n        this.enemies = [];\n        this.spawnTimer = 0;\n        this.spawnInterval = 3.0;\n        this.wave = 1;\n        this.enemiesInWave = 0;\n        this.maxEnemies = 15;\n        this.spawnQueue = [];\n    }\n\n    update(dt, world) {\n        this.spawnTimer -= dt;\n        \n        if (this.enemies.length < this.maxEnemies && this.spawnTimer <= 0) {\n            this.spawnEnemy();\n            this.spawnTimer = this.spawnInterval;\n        }\n        \n        for (let i = this.enemies.length - 1; i >= 0; i--) {\n            const enemy = this.enemies[i];\n            \n            if (enemy.health <= 0) {\n                this.player.scrapCollected += enemy.score;\n                this.particles.emitExplosion(enemy.pos, enemy.color);\n                this.audio.playEnemyHit();\n                this.enemies.splice(i, 1);\n                continue;\n            }\n            \n            this.updateEnemy(enemy, dt, world);\n        }\n        \n        this.updateProjectiles(dt);\n    }\n\n    spawnEnemy() {\n        const types = Object.keys(ENEMY_TYPES);\n        const weights = types.map(t => ENEMY_TYPES[t].weight);\n        const totalWeight = weights.reduce((a, b) => a + b, 0);\n        let rand = random(0, totalWeight);\n        let selectedType = types[0];\n        \n        for (let i = 0; i < types.length; i++) {\n            rand -= weights[i];\n            if (rand <= 0) {\n                selectedType = types[i];\n                break;\n            }\n        }\n        \n        const def = ENEMY_TYPES[selectedType];\n        const angle = random(0, Math.PI * 2);\n        const dist = random(400, 600);\n        const pos = Vec2.create(\n            this.player.pos.x + Math.cos(angle) * dist,\n            this.player.pos.y + Math.sin(angle) * dist\n        );\n        \n        pos.x = Math.max(def.radius, Math.min(this.world.width - def.radius, pos.x));\n        pos.y = Math.max(def.radius, Math.min(this.world.height - def.radius, pos.y));\n        \n        const enemy = {\n            ...def,\n            pos: pos,\n            vel: Vec2.create(0, 0),\n            attackTimer: 0,\n            stunTimer: 0,\n            wanderAngle: random(0, Math.PI * 2),\n            wanderTimer: 0\n        };\n        \n        this.enemies.push(enemy);\n        this.enemiesInWave++;\n        \n        if (this.enemiesInWave >= 5 + this.wave * 2) {\n            this.wave++;\n            this.enemiesInWave = 0;\n            this.spawnInterval = Math.max(0.5, this.spawnInterval - 0.1);\n            this.maxEnemies = Math.min(30, this.maxEnemies + 2);\n        }\n    }\n\n    updateEnemy(enemy, dt, world) {\n        enemy.stunTimer = Math.max(0, enemy.stunTimer - dt);\n        \n        if (enemy.stunTimer > 0) {\n            enemy.vel = Vec2.mul(enemy.vel, 0.9);\n            enemy.pos = Vec2.add(enemy.pos, Vec2.mul(enemy.vel, dt));\n            return;\n        }\n        \n        const toPlayer = Vec2.sub(this.player.pos, enemy.pos);\n        const distToPlayer = Vec2.len(toPlayer);\n        \n        if (distToPlayer < enemy.attackRange && enemy.attackTimer <= 0) {\n            this.attack(enemy);\n            enemy.attackTimer = enemy.attackCooldown;\n        } else {\n            enemy.attackTimer = Math.max(0, enemy.attackTimer - dt);\n        }\n        \n        if (distToPlayer > enemy.attackRange * 0.8) {\n            const dir = Vec2.normalize(toPlayer);\n            enemy.vel = Vec2.add(enemy.vel, Vec2.mul(dir, enemy.speed * dt));\n        } else {\n            enemy.wanderTimer -= dt;\n            if (enemy.wanderTimer <= 0) {\n                enemy.wanderAngle = random(0, Math.PI * 2);\n                enemy.wanderTimer = random(1, 3);\n            }\n            const wanderDir = Vec2.fromAngle(enemy.wanderAngle);\n            enemy.vel = Vec2.add(enemy.vel, Vec2.mul(wanderDir, enemy.speed * 0.3 * dt));\n        }\n        \n        enemy.vel = Vec2.clamp(enemy.vel, enemy.speed);\n        enemy.pos = Vec2.add(enemy.pos, Vec2.mul(enemy.vel, dt));\n        \n        enemy.pos.x = Math.max(enemy.radius, Math.min(world.width - enemy.radius, enemy.pos.x));\n        enemy.pos.y = Math.max(enemy.radius, Math.min(world.height - enemy.radius, enemy.pos.y));\n    }\n\n    attack(enemy) {\n        const toPlayer = Vec2.sub(this.player.pos, enemy.pos);\n        \n        if (enemy.name === 'Spitter') {\n            const angle = Vec2.angle(toPlayer);\n            const vel = Vec2.fromAngle(angle);\n            vel.x *= enemy.projectileSpeed;\n            vel.y *= enemy.projectileSpeed;\n            \n            enemy.projectiles = enemy.projectiles || [];\n            enemy.projectiles.push({\n                pos: Vec2.create(enemy.pos.x, enemy.pos.y),\n                vel: vel,\n                damage: enemy.damage,\n                color: enemy.projectileColor,\n                radius: 6,\n                life: 3\n            });\n            this.audio.playLaunch();\n        } else {\n            if (Vec2.len(toPlayer) < enemy.attackRange + this.player.radius) {\n                this.player.takeDamage(enemy.damage, Vec2.mul(Vec2.normalize(toPlayer), -100));\n            }\n        }\n    }\n\n    updateProjectiles(dt) {\n        for (const enemy of this.enemies) {\n            if (!enemy.projectiles) continue;\n            \n            for (let i = enemy.projectiles.length - 1; i >= 0; i--) {\n                const p = enemy.projectiles[i];\n                p.pos.x += p.vel.x * dt;\n                p.pos.y += p.vel.y * dt;\n                p.life -= dt;\n                \n                if (p.life <= 0) {\n                    enemy.projectiles.splice(i, 1);\n                    continue;\n                }\n                \n                if (circleCircleCollide(p.pos.x, p.pos.y, p.radius, this.player.pos.x, this.player.pos.y, this.player.radius)) {\n                    this.player.takeDamage(p.damage, Vec2.mul(Vec2.normalize(p.vel), 50));\n                    this.particles.emitHit(this.player.pos, p.color);\n                    enemy.projectiles.splice(i, 1);\n                }\n            }\n        }\n    }\n\n    stunNearby(pos, radius, duration) {\n        for (const enemy of this.enemies) {\n            if (Vec2.dist(enemy.pos, pos) < radius) {\n                enemy.stunTimer = duration;\n            }\n        }\n    }\n\n    render(ctx, alpha) {\n        for (const enemy of this.enemies) {\n            ctx.save();\n            ctx.translate(enemy.pos.x, enemy.pos.y);\n            \n            if (enemy.stunTimer > 0) {\n                ctx.globalAlpha = 0.5;\n                ctx.filter = 'grayscale(1)'; \n            }\n            \n            ctx.strokeStyle = enemy.color;\n            ctx.lineWidth = 2;\n            ctx.fillStyle = enemy.color + '40';\n            \n            if (enemy.name === 'Charger') {\n                ctx.beginPath();\n                for (let i = 0; i < 3; i++) {\n                    const a = (i / 3) * Math.PI * 2;\n                    const r = enemy.radius * (i === 0 ? 1 : 0.6);\n                    const x = Math.cos(a) * r;\n                    const y = Math.sin(a) * r;\n                    if (i === 0) ctx.moveTo(x, y);\n                    else ctx.lineTo(x, y);\n                }\n                ctx.closePath();\n                ctx.fill();\n                ctx.stroke();\n            } else if (enemy.name === 'Tank') {\n                ctx.beginPath();\n                ctx.arc(0, 0, enemy.radius, 0, Math.PI * 2);\n                ctx.fill();\n                ctx.stroke();\n                ctx.strokeStyle = '#fff';\n                ctx.lineWidth = 3;\n                ctx.beginPath();\n                ctx.arc(0, 0, enemy.radius - 5, 0, Math.PI * 2);\n                ctx.stroke();\n            } else {\n                ctx.beginPath();\n                ctx.arc(0, 0, enemy.radius, 0, Math.PI * 2);\n                ctx.fill();\n                ctx.stroke();\n            }\n            \n            if (enemy.name === 'Spitter') {\n                ctx.fillStyle = enemy.color;\n                ctx.beginPath();\n                ctx.arc(0, -enemy.radius + 5, 4, 0, Math.PI * 2);\n                ctx.fill();\n            }\n            \n            const healthPct = enemy.health / enemy.maxHealth;\n            ctx.fillStyle = healthPct > 0.5 ? '#00ff00' : healthPct > 0.25 ? '#ffff00' : '#ff0000';\n            ctx.fillRect(-enemy.radius, -enemy.radius - 6, enemy.radius * 2 * healthPct, 3);\n            ctx.strokeStyle = '#000';\n            ctx.strokeRect(-enemy.radius, -enemy.radius - 6, enemy.radius * 2, 3);\n            \n            ctx.restore();\n            \n            if (enemy.projectiles) {\n                for (const p of enemy.projectiles) {\n                    ctx.save();\n                    ctx.translate(p.pos.x, p.pos.y);\n                    ctx.fillStyle = p.color;\n                    ctx.beginPath();\n                    ctx.arc(0, 0, p.radius, 0, Math.PI * 2);\n                    ctx.fill();\n                    ctx.restore();\n                }\n            }\n        }\n    }\n\n    getEnemies() {\n        return this.enemies;\n    }\n}\n",
  "src/game/combat.js": "import { Vec2 } from '../core/math.js';\nimport { circleCircleCollide } from '../core/math.js';\n\nexport class CombatSystem {\n    constructor(player, enemies, constructs, audio, particles) {\n        this.player = player;\n        this.enemies = enemies;\n        this.constructs = constructs;\n        this.audio = audio;\n        this.particles = particles;\n    }\n\n    update(dt) {\n        this.checkPlayerEnemyCollisions();\n        this.checkConstructEnemyCollisions();\n        this.checkProjectileCollisions();\n    }\n\n    checkPlayerEnemyCollisions() {\n        const enemyList = this.enemies.getEnemies();\n        for (const enemy of enemyList) {\n            if (circleCircleCollide(\n                this.player.pos.x, this.player.pos.y, this.player.radius,\n                enemy.pos.x, enemy.pos.y, enemy.radius\n            )) {\n                const knockback = Vec2.mul(\n                    Vec2.normalize(Vec2.sub(this.player.pos, enemy.pos)),\n                    200\n                );\n                this.player.takeDamage(enemy.damage * 0.5, knockback);\n                enemy.health -= 5;\n                this.particles.emitHit(this.player.pos, '#ff6b6b');\n            }\n        }\n    }\n\n    checkConstructEnemyCollisions() {\n        const enemyList = this.enemies.getEnemies();\n        const constructList = this.constructs.getConstructs();\n        \n        for (const construct of constructList) {\n            if (!construct.deployed) continue;\n            \n            for (const enemy of enemyList) {\n                if (circleCircleCollide(\n                    construct.pos.x, construct.pos.y, construct.radius,\n                    enemy.pos.x, enemy.pos.y, enemy.radius\n                )) {\n                    const knockback = Vec2.mul(\n                        Vec2.normalize(Vec2.sub(enemy.pos, construct.pos)),\n                        150\n                    );\n                    enemy.vel = Vec2.add(enemy.vel, knockback);\n                    enemy.takeDamage(5, knockback);\n                    this.particles.emitHit(enemy.pos, construct.color);\n                }\n            }\n        }\n    }\n\n    checkProjectileCollisions() {\n        const enemyList = this.enemies.getEnemies();\n        const constructList = this.constructs.getConstructs();\n        \n        for (const construct of constructList) {\n            if (!construct.projectiles) continue;\n            \n            for (let i = construct.projectiles.length - 1; i >= 0; i--) {\n                const proj = construct.projectiles[i];\n                \n                for (const enemy of enemyList) {\n                    if (circleCircleCollide(\n                        proj.pos.x, proj.pos.y, proj.radius,\n                        enemy.pos.x, enemy.pos.y, enemy.radius\n                    )) {\n                        enemy.takeDamage(proj.damage, Vec2.mul(Vec2.normalize(proj.vel), 100));\n                        this.particles.emitHit(enemy.pos, proj.color);\n                        construct.projectiles.splice(i, 1);\n                        break;\n                    }\n                }\n            }\n        }\n        \n        for (const enemy of enemyList) {\n            if (!enemy.projectiles) continue;\n            \n            for (let i = enemy.projectiles.length - 1; i >= 0; i--) {\n                const proj = enemy.projectiles[i];\n                \n                if (circleCircleCollide(\n                    proj.pos.x, proj.pos.y, proj.radius,\n                    this.player.pos.x, this.player.pos.y, this.player.radius\n                )) {\n                    this.player.takeDamage(proj.damage, Vec2.mul(Vec2.normalize(proj.vel), 100));\n                    this.particles.emitHit(this.player.pos, proj.color);\n                    enemy.projectiles.splice(i, 1);\n                    break;\n                }\n            }\n        }\n    }\n}\n",
  "src/game/world.js": "import { Vec2 } from '../core/math.js';\nimport { random, randomInt } from '../core/math.js';\n\nexport class World {\n    constructor(width, height) {\n        this.width = width;\n        this.height = height;\n        this.scrapPiles = [];\n        this.spawnTimer = 0;\n        this.spawnInterval = 2.0;\n        this.maxPiles = 20;\n        this.enemies = [];\n        this.backgroundStars = [];\n        this.generateBackground();\n    }\n\n    generateBackground() {\n        for (let i = 0; i < 200; i++) {\n            this.backgroundStars.push({\n                x: random(0, this.width),\n                y: random(0, this.height),\n                size: random(0.5, 2),\n                brightness: random(0.2, 1),\n                twinkleSpeed: random(0.5, 2),\n                twinklePhase: random(0, Math.PI * 2)\n            });\n        }\n    }\n\n    resize(width, height) {\n        this.width = width;\n        this.height = height;\n    }\n\n    update(dt) {\n        this.spawnTimer -= dt;\n        if (this.scrapPiles.length < this.maxPiles && this.spawnTimer <= 0) {\n            this.spawnScrapPile();\