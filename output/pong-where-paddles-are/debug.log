s.length = 0;\n            paddlePlayer.y = canvas.height / 2;\n            paddleAI.y = canvas.height / 2;\n            paddleAI.targetY = canvas.height / 2;\n            controlsHintOpacity = 1;\n            gameState = GameState.READY;\n        }\n\n        function initGame() {\n            canvas = document.getElementById('gameCanvas');\n            ctx = canvas.getContext('2d');\n            \n            resize();\n            window.addEventListener('resize', resize);\n            \n            initControls();\n            resetGame();\n            \n            document.getElementById('highScore').textContent = `BEST: ${highScore}`;\n            \n            requestAnimationFrame(gameLoop);\n        }\n\n        function resize() {\n            const windowWidth = window.innerWidth;\n            const windowHeight = window.innerHeight;\n            const aspectRatio = CONFIG.baseWidth / CONFIG.baseHeight;\n            \n            let width, height;\n            \n            if (windowWidth / windowHeight > aspectRatio) {\n                height = windowHeight;\n                width = height * aspectRatio;\n            } else {\n                width = windowWidth;\n                height = width / aspectRatio;\n            }\n            \n            canvas.width = CONFIG.baseWidth;\n            canvas.height = CONFIG.baseHeight;\n            canvas.style.width = `${width}px`;\n            canvas.style.height = `${height}px`;\n            \n            scale = width / CONFIG.baseWidth;\n            \n            // Update paddle positions\n            const paddleOffset = 60;\n            paddlePlayer.x = paddleOffset;\n            paddlePlayer.y = canvas.height / 2;\n            paddleAI.x = canvas.width - paddleOffset;\n            paddleAI.y = canvas.height / 2;\n            paddleAI.targetY = canvas.height / 2;\n        }\n\n        // ============== RENDERING ==============\n        function drawBackground() {\n            // Gradient background\n            const gradient = ctx.createRadialGradient(\n                canvas.width / 2, canvas.height / 2, 0,\n                canvas.width / 2, canvas.height / 2, canvas.width * 0.7\n            );\n            gradient.addColorStop(0, COLORS.bgLight);\n            gradient.addColorStop(1, COLORS.bgDark);\n            ctx.fillStyle = gradient;\n            ctx.fillRect(0, 0, canvas.width, canvas.height);\n            \n            // Center line\n            ctx.setLineDash([4, 20]);\n            ctx.strokeStyle = 'rgba(255, 255, 255, 0.08)';\n            ctx.lineWidth = 2;\n            ctx.beginPath();\n            ctx.moveTo(canvas.width / 2, 0);\n            ctx.lineTo(canvas.width / 2, canvas.height);\n            ctx.stroke();\n            ctx.setLineDash([]);\n            \n            // Goal zones\n            const leftGradient = ctx.createLinearGradient(0, 0, 80, 0);\n            leftGradient.addColorStop(0, 'rgba(232, 193, 112, 0.1)');\n            leftGradient.addColorStop(1, 'rgba(232, 193, 112, 0)');\n            ctx.fillStyle = leftGradient;\n            ctx.fillRect(0, 0, 80, canvas.height);\n            \n            const rightGradient = ctx.createLinearGradient(canvas.width, 0, canvas.width - 80, 0);\n            rightGradient.addColorStop(0, 'rgba(112, 184, 232, 0.1)');\n            rightGradient.addColorStop(1, 'rgba(112, 184, 232, 0)');\n            ctx.fillStyle = rightGradient;\n            ctx.fillRect(canvas.width - 80, 0, 80, canvas.height);\n            \n            // Corner accents\n            ctx.fillStyle = 'rgba(255, 255, 255, 0.05)';\n            const cornerSize = 40;\n            // Top left\n            ctx.beginPath();\n            ctx.moveTo(0, cornerSize);\n            ctx.lineTo(cornerSize, cornerSize);\n            ctx.lineTo(cornerSize, 0);\n            ctx.fill();\n            // Top right\n            ctx.beginPath();\n            ctx.moveTo(canvas.width, cornerSize);\n            ctx.lineTo(canvas.width - cornerSize, cornerSize);\n            ctx.lineTo(canvas.width - cornerSize, 0);\n            ctx.fill();\n            // Bottom left\n            ctx.beginPath();\n            ctx.moveTo(0, canvas.height - cornerSize);\n            ctx.lineTo(cornerSize, canvas.height - cornerSize);\n            ctx.lineTo(cornerSize, canvas.height);\n            ctx.fill();\n            // Bottom right\n            ctx.beginPath();\n            ctx.moveTo(canvas.width, canvas.height - cornerSize);\n            ctx.lineTo(canvas.width - cornerSize, canvas.height - cornerSize);\n            ctx.lineTo(canvas.width - cornerSize, canvas.height);\n            ctx.fill();\n        }\n\n        function drawBall() {\n            if (!ball.active && gameState !== GameState.READY) return;\n            \n            // Trail\n            ball.trail.forEach((pos, i) => {\n                const alpha = (1 - i / CONFIG.ball.trailLength) * 0.3;\n                const size = CONFIG.ball.radius * (1 - i / CONFIG.ball.trailLength * 0.5);\n                \n                ctx.beginPath();\n                ctx.arc(pos.x, pos.y, size, 0, Math.PI * 2);\n                ctx.fillStyle = `rgba(255, 255, 240, ${alpha})`;\n                ctx.fill();\n            });\n            \n            if (!ball.active) return;\n            \n            // Glow\n            ctx.save();\n            ctx.shadowColor = COLORS.ballGlow;\n            ctx.shadowBlur = 20;\n            \n            // Ball\n            ctx.beginPath();\n            ctx.arc(ball.x, ball.y, CONFIG.ball.radius, 0, Math.PI * 2);\n            ctx.fillStyle = COLORS.ball;\n            ctx.fill();\n            \n            ctx.restore();\n        }\n\n        function drawHUD() {\n            // Score\n            ctx.font = '48px Courier New';\n            ctx.textAlign = 'center';\n            ctx.textBaseline = 'top';\n            ctx.fillStyle = COLORS.text;\n            ctx.fillText(`${score.player} — ${score.ai}`, canvas.width / 2, 50);\n       