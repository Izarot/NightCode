   height: 70px;\n            border-radius: 50%;\n            background: rgba(255, 255, 255, 0.15);\n            border: 2px solid rgba(255, 255, 255, 0.3);\n            color: white;\n            font-size: 24px;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            user-select: none;\n            -webkit-user-select: none;\n            cursor: pointer;\n            transition: all 0.15s ease;\n        }\n        \n        .mobileBtn:active {\n            background: rgba(255, 255, 255, 0.3);\n            transform: scale(0.95);\n        }\n        \n        @media (max-width: 768px), (pointer: coarse) {\n            #mobileControls {\n                display: flex;\n            }\n        }\n    </style>\n</head>\n<body>\n    <canvas id=\"gameCanvas\"></canvas>\n    <div id=\"speedrunTimer\">00:00.00</div>\n    <div id=\"highScore\">BEST: 0</div>\n    <div id=\"mobileControls\">\n        <button class=\"mobileBtn\" id=\"btnUp\">▲</button>\n        <button class=\"mobileBtn\" id=\"btnDown\">▼</button>\n    </div>\n\n    <script>\n    (function() {\n        'use strict';\n\n        // ============== CONFIGURATION ==============\n        const CONFIG = {\n            baseWidth: 1280,\n            baseHeight: 720,\n            \n            paddle: {\n                width: 120,\n                height: 160,\n                curvature: 40,\n                strokeWidth: 8,\n                playerSpeed: 10,\n                aiSpeed: 7,\n                glowBlur: 20\n            },\n            \n            ball: {\n                radius: 14,\n                baseSpeed: 8,\n                maxSpeed: 14,\n                speedIncrement: 0.3,\n                trailLength: 8\n            },\n            \n            ai: {\n                errorChance: 0.15,\n                errorRange: 30,\n                reactionDelay: 3\n            },\n            \n            scoring: {\n                targetScore: 7,\n                respawnDelay: 1500\n            },\n            \n            particles: {\n                impactCount: 15,\n                scoreCount: 50\n            }\n        };\n\n        const COLORS = {\n            bgDark: '#0d0d12',\n            bgLight: '#1a1a24',\n            leftPaddle: '#e8c170',\n            leftHighlight: '#f4d98c',\n            rightPaddle: '#70b8e8',\n            rightHighlight: '#8ccdf4',\n            ball: '#ffffff',\n            ballGlow: '#fffef0',\n            text: 'rgba(255, 255, 255, 0.4)',\n            accent: '#ff6b9d'\n        };\n\n        // ============== GAME STATE ==============\n        const GameState = {\n            READY: 'ready',\n            PLAYING: 'playing',\n            PAUSED: 'paused',\n            GAME_OVER: 'gameover'\n        };\n\n        let canvas, ctx;\n        let scale = 1;\n        let gameState = GameState.READY;\n        let score = { player: 0, ai: 0 };\n        let highScore = parseInt(localStorage.getItem('bowlPongHighScore')) || 0;\n        let timerStart = 0;\n        let timerElapsed = 0;\n        let lastTime = 0;\n        let controlsHintOpacity = 1;\n        let gameStartTime = 0;\n\n        // ============== AUDIO SYSTEM ==============\n        const AudioSystem = {\n            ctx: null,\n            \n            init() {\n                try {\n                    this.ctx = new (window.AudioContext || window.webkitAudioContext)();\n                } catch (e) {\n                    console.log('Web Audio not supported');\n                }\n            },\n            \n            play(type) {\n                if (!this.ctx) return;\n                \n                const osc = this.ctx.createOscillator();\n                const gain = this.ctx.createGain();\n                osc.connect(gain);\n                gain.connect(this.ctx.destination);\n                \n                const now = this.ctx.currentTime;\n                \n                switch(type) {\n                    case 'paddle':\n                        osc.type = 'sine';\n                        osc.frequency.setValueAtTime(440 + Math.random() * 200, now);\n                        gain.gain.setValueAtTime(0.3, now);\n                        gain.gain.exponentialDecayTo && gain.gain.exponentialDecayTo(0.01, now + 0.1);\n                        gain.gain.setTargetAtTime(0.01, now, 0.05);\n                        osc.start(now);\n                        osc.stop(now + 0.15);\n                        break;\n                        \n                    case 'wall':\n                        osc.type = 'sine';\n                        osc.frequency.setValueAtTime(220, now);\n                        gain.gain.setValueAtTime(0.15, now);\n                        gain.gain.setTargetAtTime(0.01, now, 0.03);\n                        osc.start(now);\n                        osc.stop(now + 0.08);\n                        break;\n                        \n                    case 'score':\n                        osc.type = 'triangle';\n                        osc.frequency.setValueAtTime(523, now);\n                        osc.frequency.setValueAtTime(659, now + 0.1);\n                        osc.frequency.setValueAtTime(784, now + 0.2);\n                        gain.gain.setValueAtTime(0.3, now);\n                        gain.gain.setTargetAtTime(0.01, now + 0.25, 0.1);\n                        osc.start(now);\n                        osc.stop(now + 0.4);\n                        break;\n                        \n                    case 'gameover':\n                        osc.type = 'sawtooth';\n                        osc.frequency.setValueAtTime(400, now);\n                        osc.frequency.setValueAtTime(300, now + 0.15);\n                        osc.frequency.setValueAtTime(200, now + 0.3);\n                        gain.gain.setValueAtTime(0.2, now);\n                        gain.gain.setTargetAtTime(0.01, now + 0.4, 0.1);\n                        osc.start(now);\n                        osc.stop(now + 0.5);\n                        break;\n                }\n            }\n        };\n\n        // ============== ENTITIES ==============\n        const ball = {\n            x: 0, y: 0,\n            vx: 0, vy: 0,\n            speed: CONFIG.ball.baseSpeed,\n            trail: [],\n            active: false\n        };\n\n        const paddlePlayer = {\n            x: 0, y: 0,\n            vy: 0,\n            color: COLORS.leftPaddle,\n            highlight: COLORS.leftHighlight\n        };\n\n        const paddleAI = {\n            x: 0, y: 0,\n            vy: 0,\n            targetY: 0,\n            reactionCounter: 0,\n            lastBallDir: 0,\n            color: COLORS.rightPaddle,\n            highlight: COLORS.rightHighlight\n        };\n\n        // ============== PARTICLE SYSTEM ==============\n        const particles = [];\n\n        function createParticles(x, y, color, count, isScore = false) {\n            for (let i = 0; i < count; i++) {\n                const angle = isScore \n                    ? (Math.random() - 0.5) * Math.PI\n                    : Math.random() * Math.PI * 2;\n                const speed = isScore \n                    ? 2 + Math.random() * 4\n                    : 1 + Math.random() * 3;\n                \n                particles.push({\n                    x, y,\n                    vx: Math.cos(angle) * speed,\n                    vy: Math.sin(angle) * speed - (isScore ? 3 : 0),\n                    size: isScore ? 4 + Math.random() * 4 : 3 + Math.random() * 3,\n                    color,\n                    alpha: 1,\n                    decay: 0.015 + Math.random() * 0.01\n                });\n            }\n        }\n\n        function updateParticles() {\n            for (let i = particles.length - 1; i >= 0; i--) {\n                const p = particles[i];\n                p.x += p.vx;\n                p.y += p.vy;\n                p.vy += 0.1;\n                p.alpha -= p.decay;\n                p.size *= 0.98;\n                \n                if (p.alpha <= 0) {\n                    particles.splice(i, 1);\n                }\n            }\n        }\n\n        function drawParticles() {\n            particles.forEach(p => {\n                ctx.beginPath();\n                ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);\n                ctx.fillStyle = p.color.replace(')', `, ${p.alpha})`).replace('rgb', 'rgba');\n                ctx.fill();\n            });\n        }\n\n        // ============== PADDLE RENDERING ==============\n        function drawBowlPaddle(paddle, isLeft) {\n            const { x, y } = paddle;\n            const { width, height, strokeWidth, glowBlur } = CONFIG.paddle;\n            const curvature = CONFIG.paddle.curvature;\n            \n            // Calculate arc parameters\n            const direction = isLeft ? 1 : -1;\n            const arcRadius = (width * width) / (4 * curvature) + curvature;\n            const centerOffsetX = direction * (width / 2 - curvature);\n            \n            ctx.save();\n            \n            // Outer glow\n            ctx.shadowColor = paddle.color;\n            ctx.shadowBlur = glowBlur;\n            \n            // Draw bowl arc\n            ctx.beginPath();\n            const startAngle = isLeft ? -Math.PI/2 : Math.PI/2;\n            const endAngle = isLeft ? Math.PI/2 : -Math.PI/2;\n            \n            if (isLeft) {\n                ctx.arc(x + centerOffsetX, y, arcRadius, startAngle, endAngle, false);\n            } else {\n                ctx.arc(x + centerOffsetX, y, arcRadius, startAngle, endAngle, true);\n            }\n            \n            // Gradient fill\n            const gradient = ctx.createLinearGradient(\n                x - width/2, y - height/2,\n                x + width/2, y + height/2\n            );\n            gradient.addColorStop(0, paddle.highlight);\n            gradient.addColorStop(0.5, paddle.color);\n            gradient.addColorStop(1, paddle.highlight);\n            \n            ctx.strokeStyle = gradient;\n            ctx.lineWidth = strokeWidth;\n            ctx.lineCap = 'round';\n            ctx.stroke();\n            \n            // Inner highlight line\n            ctx.shadowBlur = 0;\n            ctx.beginPath();\n            const innerCurvature = curvature * 0.6;\n            const innerRadius = arcRadius - 8;\n            \n            if (isLeft) {\n                ctx.arc(x + centerOffsetX, y, innerRadius, startAngle, endAngle, false);\n            } else {\n                ctx.arc(x + centerOffsetX, y, innerRadius, startAngle, endAngle, true);\n            }\n            \n            ctx.strokeStyle = `rgba(255, 255, 255, 0.2)`;\n            ctx.lineWidth = 2;\n            ctx.stroke();\n            \n            ctx.restore();\n        }\n\n        // ============== BALL PHYSICS ==============\n        function resetBall(direction = 1) {\n            ball.x = canvas.width / 2;\n            ball.y = canvas.height / 2;\n            ball.speed = CONFIG.ball.baseSpeed;\n            \n            const angle = (Math.random() - 0.5) * Math.PI / 3;\n            ball.vx = Math.cos(angle) * ball.speed * direction;\n            ball.vy = Math.sin(angle) * ball.speed;\n            \n            ball.trail = [];\n            ball.active = true;\n        }\n\n        function updateBall() {\n            if (!ball.active) return;\n            \n            // Update trail\n            ball.trail.unshift({ x: ball.x, y: ball.y });\n            if (ball.trail.length > CONFIG.ball.trailLength) {\n                ball.trail.pop();\n            }\n            \n            ball.x += ball.vx;\n            ball.y += ball.vy;\n            \n            // Wall collision (top/bottom)\n            const radius = CONFIG.ball.radius;\n            if (ball.y - radius < 0) {\n                ball.y = radius;\n                ball.vy *= -1;\n                AudioSystem.play('wall');\n            }\n            if (ball.y + radius > canvas.height) {\n                ball.y = canvas.height - radius;\n                ball.vy *= -1;\n                AudioSystem.play('wall');\n            }\n            \n            // Scoring\n            if (ball.x < -radius) {\n                scorePoint('ai');\n            } else if (ball.x > canvas.width + radius) {\n                scorePoint('player');\n            }\n            \n            // Paddle collisions\n            checkPaddleCollision(paddlePlayer, true);\n            checkPaddleCollision(paddleAI, false);\n        }\n\n        function checkPaddleCollision(paddle, isLeft) {\n            const { width, height, curvature } = CONFIG.paddle;\n            const radius = CONFIG.ball.radius;\n            const direction = isLeft ? 1 : -1;\n            \n            const paddleLeft = paddle.x - width / 2;\n            const paddleRight = paddle.x + width / 2;\n            const paddleTop = paddle.y - height / 2;\n            const paddleBottom = paddle.y + height / 2;\n            \n            // Quick bounds check\n            if (ball.x < paddleLeft - radius || ball.x > paddleRight + radius) return;\n            if (ball.y < paddleTop - radius || ball.y > paddleBottom + radius) return;\n            \n            // Calculate arc collision\n            const arcRadius = (width * width) / (4 * curvature) + curvature;\n            const centerOffsetX = direction * (width / 2 - curvature);\n            const arcCenterX = paddle.x + centerOffsetX;\n            \n            // Find closest point on arc to ball\n            const dy = ball.y - paddle.y;\n            const t = (dy + height / 2) / height;\n            const angleAtHit = (t - 0.5) * Math.PI * direction;\n            \n            // Calculate normal at hit point\n            const normalX = -Math.sin(angleAtHit) * direction;\n            const normalY = Math.cos(angleAtHit);\n            \n            // Check if ball is within arc's reach\n            const distToArc = Math.sqrt(\n                Math.pow(ball.x - arcCenterX, 2) + \n                Math.pow(ball.y - paddle.y, 2)\n            );\n            \n            const innerRadius = arcRadius - CONFIG.paddle.strokeWidth;\n            const outerRadius = arcRadius + CONFIG.paddle.strokeWidth;\n            \n            if (distToArc > innerRadius - radius && distToArc < outerRadius + radius) {\n                // Collision detected - reflect ball\n                const nx = ball.x - arcCenterX;\n                const ny = ball.y - paddle.y;\n                const len = Math.sqrt(nx * nx + ny * ny);\n                const normal = { x: nx / len, y: ny / len };\n                \n                // Reflect velocity\n                const dot = ball.vx * normal.x + ball.vy * normal.y;\n                ball.vx = ball.vx - 2 * dot * normal.x;\n                ball.vy = ball.vy - 2 * dot * normal.y;\n                \n                // Add angle variation based on hit position\n                const angleVariation = (t - 0.5) * 1.2;\n                ball.vy += angleVariation * 2;\n                \n                // Move ball out of paddle\n                ball.x = arcCenterX + normal.x * (outerRadius + radius);\n                ball.y = ball.y + normal.y * radius;\n                \n                // Speed up\n                ball.speed = Math.min(ball.speed + CONFIG.ball.speedIncrement, CONFIG.ball.maxSpeed);\n                const currentSpeed = Math.sqrt(ball.vx * ball.vx + ball.vy * ball.vy);\n                ball.vx = (ball.vx / currentSpeed) * ball.speed;\n                ball.vy = (ball.vy / currentSpeed) * ball.speed;\n                \n                // Ensure ball goes away from paddle\n                if ((isLeft && ball.vx < 0) || (!isLeft && ball.vx > 0)) {\n                    ball.vx *= -1;\n                }\n                \n                // Particles and sound\n                createParticles(ball.x, ball.y, isLeft ? COLORS.leftPaddle : COLORS.rightPaddle, CONFIG.particles.impactCount);\n                AudioSystem.play('paddle');\n            }\n        }\n\n        function scorePoint(scorer) {\n            ball.active = false;\n            score[scorer]++;\n            \n            createParticles(\n                scorer === 'player' ? canvas.width : 0,\n                canvas.height / 2,\n                '#ffffff',\n                CONFIG.particles.scoreCount,\n                true\n            );\n            \n            AudioSystem.play('score');\n            \n            // Update high score\n            if (score.player > highScore) {\n                highScore = score.player;\n                localStorage.setItem('bowlPongHighScore', highScore);\n                document.getElementById('highScore').textContent = `BEST: ${highScore}`;\n            }\n            \n            if (score.player >= CONFIG.scoring.targetScore || score.ai >= CONFIG.scoring.targetScore) {\n                gameState = GameState.GAME_OVER;\n                AudioSystem.play('gameover');\n            } else {\n                setTimeout(() => {\n                    if (gameState === GameState.PLAYING) {\n                        resetBall(scorer === 'player' ? 1 : -1);\n                    }\n                }, CONFIG.scoring.respawnDelay);\n            }\n        }\n\n        // ============== AI CONTROLLER ==============\n        function updateAI() {\n            paddleAI.reactionCounter++;\n            \n            if (paddleAI.reactionCounter > CONFIG.ai.reactionDelay) {\n                paddleAI.reactionCounter = 0;\n                \n                // Predict where ball will be\n                if (ball.vx > 0) {\n                    const timeToReach = (paddleAI.x - ball.x) / ball.vx;\n                    let predictedY = ball.y + ball.vy * timeToReach;\n                    \n                    // Account for bounces\n                    while (predictedY < 0 || predictedY > canvas.height) {\n                        if (predictedY < 0) predictedY = -predictedY;\n                        if (predictedY > canvas.height) predictedY = 2 * canvas.height - predictedY;\n                    }\n                    \n                    paddleAI.targetY = predictedY;\n                }\n            }\n            \n            // Add imperfection\n            if (Math.random() < CONFIG.ai.errorChance) {\n                paddleAI.targetY += (Math.random() - 0.5) * CONFIG.ai.errorRange * 2;\n            }\n            \n            // Move toward target\n            const diff = paddleAI.targetY - paddleAI.y;\n            paddleAI.vy = 0;\n            \n            if (Math.abs(diff) > 5) {\n                paddleAI.vy = Math.sign(diff) * CONFIG.paddle.aiSpeed;\n            }\n            \n            paddleAI.y += paddleAI.vy;\n            \n            // Clamp to bounds\n            const halfHeight = CONFIG.paddle.height / 2;\n            paddleAI.y = Math.max(halfHeight, Math.min(canvas.height - halfHeight, paddleAI.y));\n        }\n\n        // ============== INPUT HANDLING ==============\n        const keys = {};\n\n        function handleInput() {\n            paddlePlayer.vy = 0;\n            \n            if (keys['w'] || keys['W'] || keys['ArrowUp']) {\n                paddlePlayer.vy = -CONFIG.paddle.playerSpeed;\n            }\n            if (keys['s'] || keys['S'] || keys['ArrowDown']) {\n                paddlePlayer.vy = CONFIG.paddle.playerSpeed;\n            }\n            \n            paddlePlayer.y += paddlePlayer.vy;\n            \n            // Clamp to bounds\n            const halfHeight = CONFIG.paddle.height / 2;\n            paddlePlayer.y = Math.max(halfHeight, Math.min(canvas.height - halfHeight, paddlePlayer.y));\n        }\n\n        function initControls() {\n            document.addEventListener('keydown', e => {\n                keys[e.key] = true;\n                \n                if (e.key === ' ' || e.code === 'Space') {\n                 