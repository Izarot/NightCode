                ctx.fillStyle = 'rgba(255, 255, 255, 0.5)';
                ctx.shadowBlur = 0;
                ctx.fillText('First to 7 wins', canvas.width / 2, canvas.height / 2 - 20);
                
                ctx.font = '16px Courier New';
                ctx.fillText('W/S or ↑/↓ to move', canvas.width / 2, canvas.height / 2 + 20);
                
                // Fade out controls hint
                if (controlsHintOpacity > 0 && gameState === GameState.PLAYING) {
                    controlsHintOpacity -= 0.01;
                }
            }
            
            if (gameState === GameState.PAUSED) {
                ctx.fillStyle = 'rgba(0, 0, 0, 0.7)';
                ctx.fillRect(0, 0, canvas.width, canvas.height);
                
                ctx.fillStyle = '#ffffff';
                ctx.font = '36px sans-serif';
                ctx.fillText('PAUSED', canvas.width / 2, canvas.height / 2 - 20);
                
                ctx.font = '20px Courier New';
                ctx.fillStyle = 'rgba(255, 255, 255, 0.6)';
                ctx.fillText('Press SPACE to resume', canvas.width / 2, canvas.height / 2 + 20);
            }
            
            if (gameState === GameState.GAME_OVER) {
                ctx.fillStyle = 'rgba(0, 0, 0, 0.8)';
                ctx.fillRect(0, 0, canvas.width, canvas.height);
                
                ctx.textAlign = 'center';
                
                const won = score.player >= CONFIG.scoring.targetScore;
                
                ctx.fillStyle = won ? '#f4d98c' : '#8ccdf4';
                ctx.font = '48px sans-serif';
                ctx.fillText(won ? 'YOU WIN!' : 'AI WINS', canvas.width / 2, canvas.height / 2 - 80);
                
                ctx.fillStyle = '#ffffff';
                ctx.font = '32px Courier New';
                ctx.fillText(`${score.player} — ${score.ai}`, canvas.width / 2, canvas.height / 2 - 20);
                
                const finalTime = formatTime(timerElapsed);
                ctx.font = '24px Courier New';
                ctx.fillText(`Time: ${finalTime}`, canvas.width / 2, canvas.height / 2 + 30);
                
                ctx.font = '18px Courier New';
                ctx.fillStyle = 'rgba(255, 255, 255, 0.6)';
                ctx.fillText('Press R to play again', canvas.width / 2, canvas.height / 2 + 80);
            }
            
            ctx.shadowBlur = 0;
        }

        function formatTime(ms) {
            const minutes = Math.floor(ms / 60000);
            const seconds = Math.floor((ms % 60000) / 1000);
            const centiseconds = Math.floor((ms % 1000) / 10);
            return `${minutes.toString().padStart(2, '0')}:${seconds.toString().padStart(2, '0')}.${centiseconds.toString().padStart(2, '0')}`;
        }

        function updateTimer() {
            if (gameState === GameState.PLAYING) {
                timerElapsed = performance.now() - timerStart;
                document.getElementById('speedrunTimer').textContent = formatTime(timerElapsed);
            }
        }

        // ============== GAME LOOP ==============
        function update(deltaTime) {
            if (gameState === GameState.PLAYING) {
                handleInput();
                updateBall();
                updateAI();
                updateParticles();
            }
            
            updateTimer();
        }

        function render() {
            drawBackground();
            
            drawParticles();
            
            drawBall();
            
            drawBowlPaddle(paddlePlayer, true);
            drawBowlPaddle(paddleAI, false);
            
            drawHUD();
        }

        function gameLoop(timestamp) {
            const deltaTime = timestamp - lastTime;
            lastTime = timestamp;
            
            update(deltaTime);
            render();
            
            requestAnimationFrame(gameLoop);
        }

        // Start the game
        initGame();
    })();
    </script>
</body>
</html>}}