"src/components/Turret.ts": "export class Turret {\n private game: GameCanvas;\n private position: { x: number; y: number } = { x: 0, y: 0 };\n private rotation = 0;\n private fireRate = 1000; // ms\n private lastFired = 0;\n\n constructor(game: GameCanvas) {\n this.game = game;\n this.position.x = game.ctx.canvas.width / 2 - 50;\n this.position.y = game.ctx.canvas.height - 100;\n }\n\n update(deltaTime: number) {\n // Handle input and rotation\n if (performance.now() - this.lastFired > this.fireRate) {\n this.fire();\n this.lastFired = performance.now();\n }\n }\n\n private fire() {\n bullets.createBullet(this.position.x + 50, this.position.y, this.rotation);\n }\n\n draw(ctx: CanvasRenderingContext2D) {\n // Draw turret body and rotation indicator\n ctx.fillStyle = 'black';\n ctx.fillRect(this.position.x, this.position.y, 100, 50);\n ctx.save();\n ctx.translate(this.position.x + 50, this.position.y + 25);\n ctx.rotate(this.rotation);\n ctx.fillStyle = 'red';\n ctx.fillRect(-5, -5, 10, 10);\n ctx.restore();\n }\n}", "src/components/Bullet.ts": "export class Bullet {\n private game: GameCanvas;\n private bullets: Bullet[] = [];\n private speed = 5;\n\n constructor(game: GameCanvas) {\n this.game = game;\n }\n\n createBullet(x: number, y: number, angle: number) {\n this.bullets.push({ x, y, angle, alive: true });\n }\n\n update(deltaTime: number) {\n this.bullets.forEach(bullet => {\n if (bullet.alive) {\n bullet.x += Math.cos(bullet.angle) * this.speed * deltaTime;\n bullet.y += Math.sin(bullet.angle) * this.speed * deltaTime;\n if (bullet.x < 0 || bullet.x > this.game.ctx.canvas.width || bullet.y < 0 || bullet.y > this.game.ctx.canvas.height) {\n bullet.alive = false;\n }\n }\n });\n this.bullets = this.bullets.filter(bullet => bullet.alive);\n }\n\n draw(ctx: CanvasRenderingContext2D) {\n this.bullets.forEach(bullet => {\n ctx.fillStyle = 'white';\n ctx.beginPath();\n ctx.arc(bullet.x, bullet.y, 3, 0, Math.PI * 2);\n ctx.fill();\n });\n }\n}", "src/components/Targ