    for (let y = 0; y < CONSTANTS.MAZE_HEIGHT; y++) {
      for (let x = 0; x < CONSTANTS.MAZE_WIDTH; x++) {
        const cell = this.maze.grid[y][x];
        const px = x * CONSTANTS.TILE_SIZE;
        const py = y * CONSTANTS.TILE_SIZE;
        
        if (cell.type === '1') {
          this.mazeCtx.fillStyle = '#4a4a6a';
          this.mazeCtx.fillRect(px, py, CONSTANTS.TILE_SIZE, CONSTANTS.TILE_SIZE);
        } else if (cell.type === '2' && !cell.collected) {
          this.mazeCtx.fillStyle = '#ffdd00';
          this.mazeCtx.beginPath();
          this.mazeCtx.arc(px + CONSTANTS.TILE_SIZE/2, py + CONSTANTS.TILE_SIZE/2, 3, 0, Math.PI * 2);
          this.mazeCtx.fill();
        } else if (cell.type === '3' && !cell.collected) {
          this.mazeCtx.fillStyle = '#ffdd00';
          this.mazeCtx.beginPath();
          this.mazeCtx.arc(px + CONSTANTS.TILE_SIZE/2, py + CONSTANTS.TILE_SIZE/2, 5, 0, Math.PI * 2);
          this.mazeCtx.fill();
        }
      }
    }
  }
  
  drawPlayer(player) {
    const centerX = player.x + CONSTANTS.TILE_SIZE/2;
    const centerY = player.y + CONSTANTS.TILE_SIZE/2;
    
    this.mazeCtx.fillStyle = '#ffff00';
    this.mazeCtx.beginPath();
    
    const angle = player.mouthAngle;
    const mouthWidth = 0.3;
    
    this.mazeCtx.moveTo(centerX, centerY);
    this.mazeCtx.arc(centerX, centerY, CONSTANTS.TILE_SIZE/2 - 2, Math.PI - angle, Math.PI + angle);
    this.mazeCtx.closePath();
    this.mazeCtx.fill();
    
    const eyeX = centerX + Math.cos(angle - 0.5) * 4;
    const eyeY = centerY + Math.sin(angle - 0.5) * 4;
    this.mazeCtx.fillStyle = '#000000';
    this.mazeCtx.beginPath();
    this.mazeCtx.arc(eyeX, eyeY, 2, 0, Math.PI * 2);
    this.mazeCtx.fill();
  }
  
  drawGhosts(ghosts) {
    for (const ghost of ghosts) {
      if (ghost.eaten) continue;
      
      const centerX = ghost.x + CONSTANTS.TILE_SIZE/2;
      const centerY = ghost.y + CONSTANTS.TILE_SIZE/2;
      
      this.mazeCtx.fillStyle = ghost.vulnerable ? '#00ffff' : ghost.color;
      this.mazeCtx.beginPath();
      this.mazeCtx.moveTo(centerX, centerY - CONSTANTS.TILE_SIZE/2);
      this.mazeCtx.arc(centerX, centerY - CONSTANTS.TILE_SIZE/4, CONSTANTS.TILE_SIZE/2, Math.PI, 0);
      this.mazeCtx.lineTo(centerX + CONSTANTS.TILE_SIZE/2, centerY + CONSTANTS.TILE_SIZE/2);
      this.mazeCtx.arc(centerX, centerY + CONSTANTS.TILE_SIZE/2, CONSTANTS.TILE_SIZE/2, 0, Math.PI, true);
      this.mazeCtx.closePath();
      this.mazeCtx.fill();
      
      if (ghost.vulnerable && ghost.flashTimer > 500 && (ghost.flashTimer % 200 < 100)) {
        this.mazeCtx.fillStyle = 'rgba(0, 255, 255, 0.5)';
        this.mazeCtx.beginPath();
        this.mazeCtx.arc(centerX, centerY, CONSTANTS.TILE_SIZE/2, 0, Math.PI * 2);
        this.mazeCtx.fill();
      }
    }
  }
  
  drawSpotlight(player, powered) {
    const centerX = player.x + CONSTANTS.TILE_SIZE/2;
    const centerY = player.y + CONSTANTS.TILE_SIZE/2;
    
    this.spotlightCtx.save();
    this.spotlightCtx.globalCompositeOperation = 'destination-out';
    
    const gradient = this.spotlightCtx.createRadialGradient(
      centerX, centerY, 0,
      centerX, centerY, this.spotlightRadius
    );
    gradient.addColorStop(0, 'rgba(0, 0, 0, 0.8)');
    gradient.addColorStop(1, 'rgba(0, 0, 0, 0)');
    
    this.spotlightCtx.fillStyle = gradient;
    this.spotlightCtx.fillRect(0, 0, CONSTANTS.CANVAS_WIDTH, CONSTANTS.CANVAS_HEIGHT);
    
    this.spotlightCtx.restore();
  }
  
  drawOverlay() {
    this.overlayCtx.fillStyle = 'rgba(0, 0, 0, 0.3)';
    this.overlayCtx.fillRect(0, 0, CONSTANTS.CANVAS_WIDTH, CONSTANTS.CANVAS_HEIGHT);
  }
  
  drawUI(player, ghosts, score, lives, highScore) {
    this.uiCtx.fillStyle = '#ffffff';
    this.uiCtx.font = '14px monospace';
    this.uiCtx.textAlign = 'left';
    this.uiCtx.fillText('SCORE: ' + score, 10, 25);
    this.uiCtx.fillText('HIGH SCORE: ' + highScore, 10, 45);
    
    for (let i = 0; i < lives; i++) {
      this.uiCtx.fillStyle = '#ffff00';
      this.uiCtx.beginPath();
      const mouthAngle = 0.3;
      this.uiCtx.moveTo(400 + i * 20, 30);
      this.uiCtx.arc(400 + i * 20, 30, 8, Math.PI - mouthAngle, Math.PI + mouthAngle);
      this.uiCtx.closePath();
      this.uiCtx.fill();
    }
  }
}

class Game {
  constructor() {
    this.maze = new Maze();
    this.player = new Player(this.maze);
    this.ghostManager = new GhostManager();
    this.renderer = new Renderer(this.maze);
    
    this.score = 0;
    this.lives = CONSTANTS.STARTING_LIVES;
    this.highScore = 0;
    this.powered = false;
    this.powerTimer = 0;
    this.lastFrameTime = 0;
    this.running = false;
    this.paused = false;
    
    this.init();
  }
  
  init() {
    Audio.init();
    
    document.getElementById('startBtn').addEventListener('click', () => {
      this.start();
      document.getElementById('startScreen').classList.add('hidden');
    });
    
    document.getElementById('resumeBtn').addEventListener('click', () => {
      this.resume();
    });
    
    document.getElementById('restartBtn').addEventListener('click', () => {
      this.restart();
    });
    
    document.getElementById('restartFromPauseBtn').addEventListener('click', () => {
      this.restart();
    });
    
    document.addEventListener('keydown', (e) => {
      if (e.key === 'p' || e.key === 'P') {
        e.preventDefault();
        this.togglePause();
      }
      if (e.key === 'm' || e.key === 'M') {
        e.preventDefault();
        Audio.toggleMute();
      }
    });
    
    window.addEventListener('resize', () => {
      const container = document.getElementById('gameContainer');
      const rect = container.getBoundingClientRect();
      this.renderer.mazeCanvas.width = rect.width;
      this.renderer.mazeCanvas.height = rect.height;
      this.renderer.spotlightCanvas.width = rect.width;
      this.renderer.spotlightCanvas.height = rect.height;
      this.renderer.overlayCanvas.width = rect.width;
      this.renderer.overlayCanvas.height = rect.height;
      this.renderer.uiCanvas.width = rect.width;
      this.renderer.uiCanvas.height = rect.height;
    });
  }
  
  start() {
    this.reset();
    this.lastFrameTime = performance.now();
    this.running = true;
    this.gameLoop();
  }
  
  reset() {
    this.player.reset();
    this.ghostManager.reset();
    this.score = 0;
    this.lives = CONSTANTS.STARTING_LIVES;
    this.powered = false;
    this.powerTimer = 0;
    this.maze.init();
  }
  
  restart() {
    this.reset();
    document.getElementById('gameOverScreen').classList.add('hidden');
    document.getElementById('startScreen').classList.remove('hidden');
    this.running = false;
  }
  
  pause() {
    this.paused = true;
    document.getElementById('pauseMenu').classList.remove('hidden');
  }
  
  resume() {
    this.paused = false;
    document.getElementById('pauseMenu').classList.add('hidden');
  }
  
  togglePause() {
    if (!this.running) return;
    if (this.paused) {
      this.resume();
    } else {
      this.pause();
    }
  }
  
  gameOver() {
    document.getElementById('finalScore').textContent = this.score;
    document.getElementById('highScoreDisplay').textContent = this.highScore;
    document.getElementById('gameOverScreen').classList.remove('hidden');
    this.running = false;
  }
  
  gameLoop() {
    if (!this.running) return;
    
    const now = performance.now();
    const dt = now - this.lastFrameTime;
    this.lastFrameTime = now;
    
    this.update(dt);
    this.render();
    
    requestAnimationFrame(() => this.gameLoop());
  }
  
  update(dt) {
    this.player.update(dt);
    this.ghostManager.update(dt, this.player, this.maze);
    
    const dotResult = this.maze.collectDot(this.player.x + CONSTANTS.TILE_SIZE/2, this.player.y + CONSTANTS.TILE_SIZE/2);
    if (dotResult) {
      this.score += dotResult.points;
      Audio.play('eat_dot');
      
      if (dotResult.type === 'pellet') {
        this.powered = true;
        this.powerTimer = CONSTANTS.POWER_DURATION;
        this.ghostManager.makeAllVulnerable();
        Audio.play('power_pellet');
      }
    }
    
    if (this.powered) {
      this.powerTimer -= dt;
      if (this.powerTimer <= 0) {
        this.powered = false;
      }
    }
    
    const collidedGhost = this.ghostManager.checkCollision(this.player);
    if (collidedGhost) {
      if (this.powered && !collidedGhost.eaten) {
        collidedGhost.eaten = true;
        this.score += CONSTANTS.GHOST_SCORES.shift();
        CONSTANTS.GHOST_SCORES.push(CONSTANTS.GHOST_SCORES[CONSTANTS.GHOST_SCORES.length - 1] * 2);
        Audio.play('eat_ghost');
      } else {
        this.player.triggerDeath();
        this.lives--;
        if (this.lives <= 0) {
          this.highScore = Math.max(this.highScore, this.score);
          this.gameOver();
        } else {
          setTimeout(() => {
            this.player.reset();
            this.ghostManager.reset();
          }, 1000);
        }
      }
    }
    
    if (this.maze.dotsRemaining <= 0) {
      this.highScore = Math.max(this.highScore, this.score);
      alert('YOU WIN! Final Score: ' + this.score);
      this.restart();
    }
  }
  
  render() {
    this.renderer.clear();
    this.renderer.drawMaze();
    this.renderer.drawPlayer(this.player);
    this.renderer.drawGhosts(this.ghostManager.ghosts);
    this.renderer.drawSpotlight(this.player, this.powered);
    this.renderer.drawOverlay();
    this.renderer.drawUI(this.player, this.ghostManager.ghosts, this.score, this.lives, this.highScore);
  }
}

const game = new Game();

document.addEventListener('keydown', function(e) {
  if (e.key === 'ArrowUp' || e.key === 'w' || e.key === 'W') {
    e.preventDefault();
    if (game.player.nextDirection !== 'up' && game.player.canMove('up')) {
      game.player.nextDirection = 'up';
    }
  }
  if (e.key === 'ArrowDown' || e.key === 's' || e.key === 'S') {
    e.preventDefault();
    if (game.player.nextDirection !== 'down' && game.player.canMove('down')) {
      game.player.nextDirection = 'down';
    }
  }
  if (e.key === 'ArrowLeft' || e.key === 'a' || e.key === 'A') {
    e.preventDefault();
    if (game.player.nextDirection !== 'left' && game.player.canMove('left')) {
      game.player.nextDirection = 'left';
    }
  }
  if (e.key === 'ArrowRight' || e.key === 'd' || e.key === 'D') {
    e.preventDefault();
    if (game.player.nextDirection !== 'right' && game.player.canMove('right')) {
      game.player.nextDirection = 'right';
    }
  }
});

Audio.init();
  </script>
</body>
</html>
"
}