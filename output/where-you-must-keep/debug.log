 this.active = [];\n    this.inactive = [];\n    for (let i = 0; i < initialSize; i++) this.inactive.push(factory());\n  }\n  acquire() {\n    let obj = this.inactive.pop() || this.factory();\n    this.active.push(obj);\n    return obj;\n  }\n  release(obj) {\n    const idx = this.active.indexOf(obj);\n    if (idx !== -1) {\n      this.active.splice(idx, 1);\n      this.reset(obj);\n      this.inactive.push(obj);\n    }\n  }\n  update(dt) {\n    for (let i = this.active.length - 1; i >= 0; i--) {\n      const obj = this.active[i];\n      if (obj.update && obj.update(dt) === false) this.release(obj);\n    }\n  }\n  render(ctx) {\n    for (const obj of this.active) if (obj.render) obj.render(ctx);\n  }\n  clear() {\n    this.active.forEach(obj => this.release(obj));\n  }\n}\n\n// --- Audio System ---\nclass AudioSystem {\n  constructor() {\n    this.ctx = null;\n    this.masterGain = null;\n    this.musicGain = null;\n    this.sfxGain = null;\n    this.meterGain = null;\n    this.compressor = null;\n    this.meterOsc = null;\n    this.meterVelOsc = null;\n    this.droneOsc = null;\n    this.droneGain = null;\n    this.arpOsc = null;\n    this.arpGain = null;\n    this.chaosOsc = null;\n    this.chaosGain = null;\n    this.musicTime = 0;\n    this.arpNotes = [220, 246.94, 277.18, 329.63, 369.99, 415.3, 466.16, 493.88]; // A minor\n    this.arpIndex = 0;\n    this.lastArpTime = 0;\n    this.enabled = true;\n    this.volumes = { master: 0.7, sfx: 0.8, music: 0.5 };\n  }\n  init() {\n    if (this.ctx) return;\n    this.ctx = new (window.AudioContext || window.webkitAudioContext)();\n    this.masterGain = this.ctx.createGain();\n    this.masterGain.gain.value = this.volumes.master;\n    this.compressor = this.ctx.createDynamicsCompressor();\n    this.compressor.threshold.value = -12;\n    this.compressor.knee.value = 12;\n    this.compressor.ratio.value = 4;\n    this.compressor.attack.value = 0.003;\n    this.compressor.release.value = 0.25;\n    this.musicGain = this.ctx.createGain();\n    this.musicGain.gain.value = this.volumes.music;\n    this.sfxGain = this.ctx.createGain();\n    this.sfxGain.gain.value = this.volumes.sfx;\n    this.meterGain = this.ctx.createGain();\n    this.meterGain.gain.value = 0.3;\n    this.masterGain.connect(this.compressor);\n    this.compressor.connect(this.ctx.destination);\n    this.musicGain.connect(this.masterGain);\n    this.sfxGain.connect(this.masterGain);\n    this.meterGain.connect(this.masterGain);\n    // Meter tone\n    this.meterOsc = this.ctx.createOscillator();\n    this.meterOsc.type = 'sine';\n    this.meterOsc.frequency.value = 440;\n    this.meterOsc.connect(this.meterGain);\n    this.meterOsc.start();\n    // Velocity whistle\n    this.meterVelOsc = this.ctx.createOscillator();\n    this.meterVelOsc.type = 'sine';\n    this.meterVelOsc.frequency.value = 880;\n    const velGain = this.ctx.createGain();\n    velGain.gain.value = 0.05;\n    this.meterVelOsc.connect(velGain).connect(this.meterGain);\n    this.meterVelOsc.start();\n    // Drone\n    this.droneOsc = this.ctx.createOscillator();\n    this.droneOsc.type = 'sine';\n    this.droneOsc.frequency.value = 40;\n    this.droneGain = this.ctx.createGain();\n    this.droneGain.gain.value = 0;\n    this.droneOsc.connect(this.droneGain).connect(this.musicGain);\n    this.droneOsc.start();\n    // Arp\n    this.arpOsc = this.ctx.createOscillator();\n    this.arpOsc.type ='square';\n    this.arpGain = this.ctx.createGain();\n    this.arpGain.gain.value = 0;\n    this.arpOsc.connect(this.arpGain).connect(this.musicGain);\n    this.arpOsc.start();\n    // Chaos layer\n    this.chaosOsc = this.ctx.createOscillator();\n    this.chaosOsc.type = 'sawtooth';\n    this.chaosGain = this.ctx.createGain();\n    this.chaosGain.gain.value = 0;\n    this.chaosOsc.connect(this.chaosGain).connect(this.musicGain);\n    this.chaosOsc.start();\n    // Filter for music\n    this.musicFilter = this.ctx.createBiquadFilter();\n    this.musicFilter.type = 'lowpass';\n    this.musicFilter.frequency.value = 2000;\n    this.musicFilter.Q.value = 2;\n    this.musicGain.connect(this.musicFilter).connect(this.masterGain);\n    // Reconnect music gain through filter\n    this.musicGain.disconnect();\n    this.musicGain.connect(this.musicFilter);\n    this.musicFilter.connect(this.masterGain);\n  }\n  setVolumes(master, sfx, music) {\n    this.volumes = { master, sfx, music };\n    if (this.masterGain) this.masterGain.gain.value = master;\n    if (this.sfxGain) this.sfxGain.gain.value = sfx;\n    if (this.musicGain) this.musicGain.gain.value = music;\n  }\n  setEnabled(enabled) { this.enabled = enabled; if (this.ctx) this.ctx[enabled ? 'resume' : 'suspend'](); }\n  update(dt, gameState) {\n    if (!this.enabled || !this.ctx) return;\n    this.musicTime += dt;\n    const phase = gameState.phase;\n    const entropy = gameState.entropy;\n    const velocity = Math.abs(gameState.velocity);\n    const inSafe = gameState.inSafe;\n    const dampenActive = gameState.dampenActive;\n    // Meter tone - pitch based on position\n    const meterPitch = 220 + (entropy - 0.5) * 440;\n    this.meterOsc.frequency.setTargetAtTime(meterPitch, this.ctx.currentTime, 0.05);\n    const meterVol = 0.15 + velocity * 0.3 + (inSafe ? 0 : 0.1);\n    this.meterGain.gain.setTargetAtTime(meterVol * this.volumes.music, this.ctx.currentTime, 0.1);\n    // Velocity whistle\n    this.meterVelOsc.frequency.setTargetAtTime(880 + velocity * 1000, this.ctx.currentTime, 0.02);\n    // Drone - intensity based on phase and entropy\n    const droneTarget = phase >= 2 ? 0.08 + entropy * 0.15 : 0;\n    this.droneGain.gain.setTargetAtTime(droneTarget * this.volumes.music, this.ctx.currentTime, 1.0);\n    this.droneOsc.frequency.setTargetAtTime(40 + phase * 5 + entropy * 20, this.ctx.currentTime, 2.0);\n    // Arpeggio - speed based on phase\n    if (phase >= 1) {\n      const arpSpeed = 0.15 + phase * 0.03 + entropy * 0.1;\n      if (this.musicTime - this.lastArpTime > arpSpeed) {\n        this.arpIndex = (this.arpIndex + 1) % this.arpNotes.length;\n        const note = this.arpNotes[this.arpIndex] * Math.pow(2, Math.floor(phase / 2));\n        this.arpOsc.frequency.setValueAtTime(note, this.ctx.currentTime);\n        this.arpGain.gain.setValueAtTime(0.08 * this.volumes.music, this.ctx.currentTime);\n        this.arpGain.gain.exponentialRampToValueAtTime(0.001, this.ctx.currentTime + arpSpeed * 0.8);\n        this.lastArpTime = this.musicTime;\n      }\n    } else {\n      this.arpGain.gain.setTargetAtTime(0, this.ctx.currentTime, 0.5);\n    }\n    // Chaos layer for final phases\n    if (phase >= 4) {\n      this.chaosGain.gain.setTargetAtTime((entropy - 0.5) * 0.1 * this.volumes.music, this.ctx.currentTime, 0.5);\n      this.chaosOsc.frequency.setTargetAtTime(60 + Math.random() * 200 + entropy * 300, this.ctx.currentTime, 0.1);\n    } else {\n      this.chaosGain.gain.setTargetAtTime(0, this.ctx.currentTime, 1.0);\n    }\n    // Filter sweep\n    this.musicFilter.frequency.setTargetAtTime(800 + phase * 300 + entropy * 2000, this.ctx.currentTime, 1.0);\n  }\n  playSFX(type, params = {}) {\n    if (!this.enabled || !this.ctx) return;\n    const now = this.ctx.currentTime;\n    switch (type) {\n      case 'dampen': {\n        const osc = this.ctx.createOscillator();\n        const gain = this.ctx.createGain();\n        osc.type = 'sine';\n        osc.frequency.setValueAtTime(600, now);\n        osc.frequency.exponentialRampToValueAtTime(200, now + 0.3);\n        gain.gain.setValueAtTime(0.3 * this.volumes.sfx, now);\n        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.4);\n        osc.connect(gain).connect(this.sfxGain);\n        osc.start(now);\n        osc.stop(now + 0.5);\n        break;\n      }\n      case 'dampen_end': {\n        const osc = this.ctx.createOscillator();\n        const gain = this.ctx.createGain();\n        osc.type = 'triangle';\n        osc.frequency.setValueAtTime(300, now);\n        osc.frequency.exponentialRampToValueAtTime(150, now + 0.2);\n        gain.gain.setValueAtTime(0.2 * this.volumes.sfx, now);\n        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.3);\n        osc.connect(gain).connect(this.sfxGain);\n        osc.start(now);\n        osc.stop(now + 0.4);\n        break;\n      }\n      case 'breach': {\n        const osc = this.ctx.createOscillator();\n        const gain = this.ctx.createGain();\n        osc.type = 'sawtooth';\n        osc.frequency.setValueAtTime(150, now);\n        osc.frequency.exponentialRampToValueAtTime(50, now + 0.5);\n        gain.gain.setValueAtTime(0.4 * this.volumes.sfx, now);\n        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.6);\n        osc.connect(gain).connect(this.sfxGain);\n        osc.start(now);\n        osc.stop(now + 0.7);\n        break;\n      }\n      case 'phase_shift': {\n        const osc = this.ctx.createOscillator();\n        const gain = this.ctx.createGain();\n        osc.type = 'square';\n        osc.frequency.setValueAtTime(400, now);\n        osc.frequency.exponentialRampToValueAtTime(800, now + 0.1);\n        osc.frequency.exponentialRampToValueAtTime(400, now + 0.2);\n        gain.gain.setValueAtTime(0.25 * this.volumes.sfx, now);\n        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.3);\n        osc.connect(gain).connect(this.sfxGain);\n        osc.start(now);\n        osc.stop(now + 0.4);\n        break;\n      }\n      case 'inversion': {\n        const osc = this.ctx.createOscillator();\n        const gain = this.ctx.createGain();\n        osc.type = 'sine';\n        osc.frequency.setValueAtTime(800, now);\n        osc.frequency.exponentialRampToValueAtTime(200, now + 0.15);\n        osc.frequency.exponentialRampToValueAtTime(800, now + 0.3);\n        gain.gain.setValueAtTime(0.3 * this.volumes.sfx, now);\n        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.4);\n        osc.connect(gain).connect(this.sfxGain);\n        osc.start(now);\n        osc.stop(now + 0.5);\n        break;\n      }\n      case 'milestone': {\n        [440, 554.37, 659.25, 880].forEach((freq, i) => {\n          const osc = this.ctx.createOscillator();\n          const gain = this.ctx.createGain();\n          osc.type = 'triangle';\n          osc.frequency.value = freq;\n          gain.gain.setValueAtTime(0.15 * this.volumes.sfx, now + i * 0.08);\n          gain.gain.exponentialRampToValueAtTime(0.001, now + i * 0.08 + 0.3);\n          osc.connect(gain).connect(this.sfxGain);\n          osc.start(now + i * 0.08);\n          osc.stop(now + i * 0.08 + 0.4);\n        });\n        break;\n      }\n      case 'victory': {\n        [261.63, 329.63, 392, 523.25, 659.25, 783.99, 1046.5].forEach((freq, i) => {\n          const osc = this.ctx.createOscillator();\n          const gain = this.ctx.createGain();\n          osc.type = 'sine';\n          osc.frequency.value = freq;\n          gain.gain.setValueAtTime(0.2 * this.volumes.sfx, now + i * 0.06);\n          gain.gain.exponentialRampToValueAtTime(0.001, now + i * 0.06 + 0.5);\n          osc.connect(gain).connect(this.sfxGain);\n          osc.start(now + i * 0.06);\n          osc.stop(now + i * 0.06 + 0.6);\n        });\n        break;\n      }\n      case 'gameover': {\n        const osc = this.ctx.createOscillator();\n        const gain = this.ctx.createGain();\n        osc.type = 'sawtooth';\n        osc.frequency.setValueAtTime(200, now);\n        osc.frequency.exponentialRampToValueAtTime(50, now + 1.0);\n        gain.gain.setValueAtTime(0.4 * this.volumes.sfx, now);\n        gain.gain.exponentialRampToValueAtTime(0.001, now + 1.2);\n        osc.connect(gain).connect(this.sfxGain);\n        osc.start(now);\n        osc.stop(now + 1.5);\n        break;\n      }\n      case 'click': {\n        const osc = this.ctx.createOscillator();\n        const gain = this.ctx.createGain();\n        osc.type = 'square';\n        osc.frequency.value = 800;\n        gain.gain.setValueAtTime(0.1 * this.volumes.sfx, now);\n        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.05);\n        osc.connect(gain).connect(this.sfxGain);\n        osc.start(now);\n        osc.stop(now + 0.1);\n        break;\n      }\n    }\n  }\n}\n\n// --- Particle System ---\nclass ParticleSystem {\n  constructor() {\n    this.pool = new Pool(\n      () => ({ x: 0, y: 0, vx: 0, vy: 0, life: 1, maxLife: 1, size: 2, color: '#fff', type: 'default' }),\n      (p) => { p.life = 1; p.maxLife = 1; p.size = 2; },\n      200\n    );\n    this.sparkPool = new Pool(\n      () => ({ x: 0, y: 0, vx: 0, vy: 0, life: 1, maxLife: 1, size: 1, hue: 0 }),\n      (p) => { p.life = 1; p.maxLife = 1; },\n      300\n    );\n  }\n  emit(x, y, count, options = {}) {\n    for (let i = 0; i < count; i++) {\n      const p = this.pool.acquire();\n      p.x = x + (options.offsetX || 0);\n      p.y = y + (options.offsetY || 0);\n      const angle = options.angle !== undefined ? options.angle + rand(-options.spread || 0, options.spread || 0) : rand(0, Math.PI * 2);\n      const speed = rand(options.speedMin || 50, options.speedMax || 200);\n      p.vx = Math.cos(angle) * speed;\n      p.vy = Math.sin(angle) * speed;\n      p.life = p.maxLife = rand(options.lifeMin || 0.3, options.lifeMax || 1.5);\n      p.size = rand(options.sizeMin || 1, options.sizeMax || 4);\n      p.color = options.color || '#00ff88';\n      p.type = options.type || 'default';\n      p.gravity = options.gravity || 0;\n      p.friction = options.friction || 0.98;\n    }\n  }\n  emitSparks(x, y, count, hue) {\n    for (let i = 0; i < count; i++) {\n      const p = this.sparkPool.acquire();\n      p.x = x; p.y = y;\n      const angle = rand(0, Math.PI * 2);\n      const speed = rand(100, 400);\n      p.vx = Math.cos(angle) * speed;\n      p.vy = Math.sin(angle) * speed;\n      p.life = p.maxLife = rand(0.2, 0.6);\n      p.size = rand(1, 3);\n      p.hue = hue + rand(-20, 20);\n    }\n  }\n  emitMeterTrail(x, y, entropy, velocity, inSafe) {\n    if (Math.random() < 0.3) {\n      const p = this.pool.acquire();\n      p.x = x + rand(-2, 2);\n      p.y = y;\n      p.vx = rand(-30, 30);\n      p.vy = -velocity * 50 + rand(-20, 20);\n      p.life = p.maxLife = rand(0.2, 0.5);\n      p.size = rand(1, 3);\n      p.color = inSafe ? '#00ff88' : (entropy > 0.85 || entropy < 0.15 ? '#ff2244' : '#ffaa00');\n      p.type = 'trail';\n    }\n  }\n  update(dt) {\n    this.pool.update(dt);\n    this.sparkPool.update(dt);\n  }\n  render(ctx) {\n    this.pool.render(ctx);\n    this.sparkPool.render(ctx);\n  }\n  renderParticle(ctx, p) {\n    const alpha = p.life / p.maxLife;\n    ctx.globalAlpha = alpha;\n    ctx.fillStyle = p.color;\n    if (p.type === 'trail') {\n      ctx.beginPath();\n      ctx.arc(p.x, p.y, p.size * alpha, 0, Math.PI * 2);\n      ctx.fill();\n    } else {\n      ctx.fillRect(p.x - p.size * 0.5 * alpha, p.y - p.size * 0.5 * alpha, p.size * alpha, p.size * alpha);\n    }\n    ctx.globalAlpha = 1;\n  }\n  renderSpark(ctx, p) {\n    const alpha = p.life / p.maxLife;\n    ctx.globalAlpha = alpha;\n    ctx.fillStyle = `hsl(${p.hue}, 100%, 50%)`;\n    ctx.beginPath();\n    ctx.arc(p.x, p.y, p.size * alpha, 0, Math.PI * 2);\n    ctx.fill();\n    ctx.globalAlpha = 1;\n  }\n}\n\n// Extend pools with custom render\nParticleSystem.prototype.pool.render = function(ctx) {\n  for (const p of this.active) {\n    p.life -= 1/60;\n    p.vx *= p.friction;\n    p.vy *= p.friction;\n    p.vy += p.gravity;\n    p.x += p.vx / 60;\n    p.y += p.vy / 60;\n    if (p.life <= 0) { this.release(p); continue; }\n    const alpha = p.life / p.maxLife;\n    ctx.globalAlpha = alpha;\n    ctx.fillStyle = p.color;\n    if (p.type === 'trail') {\n      ctx.beginPath();\n      ctx.arc(p.x, p.y, p.size * alpha, 0, Math.PI * 2);\n      ctx.fill();\n    } else {\n      ctx.fillRect(p.x - p.size * 0.5 * alpha, p.y - p.size * 0.5 * alpha, p.size * alpha, p.size * alpha);\n    }\n    ctx.globalAlpha = 1;\n  }\n};\nParticleSystem.prototype.sparkPool.render = function(ctx) {\n  for (const p of this.active) {\n    p.life -= 1/60;\n    p.vx *= 0.95;\n    p.vy *= 0.95;\n    p.vy += 200;\n    p.x += p.vx / 60;\n    p.y += p.vy / 60;\n    if (p.life <= 0) { this.release(p); continue; }\n    const alpha = p.life / p.maxLife;\n    ctx.globalAlpha = alpha;\n    ctx.fillStyle = `hsl(${p.hue}, 100%, 50%)`;\n    ctx.beginPath();\n    ctx.arc(p.x, p.y, p.size * alpha, 0, Math.PI * 2);\n    ctx.fill();\n    ctx.globalAlpha = 1;\n  }\n};\n\n// --- Background Grid ---\nclass GridBackground {\n  constructor() {\n    this.time = 0;\n    this.offsetX = 0;\n    this.offsetY = 0;\n    this.distortion = 0;\n  }\n  update(dt, entropy, phase) {\n    this.time += dt;\n    this.offsetX = (this.offsetX + 20 * dt) % 80;\n    this.offsetY = (this.offsetY + 15 * dt) % 80;\n    this.distortion = entropy * 0.5 + phase * 0.1;\n  }\n  render(ctx, colors) {\n    ctx.save();\n    ctx.strokeStyle = colors.grid;\n    ctx.lineWidth = 1;\n    ctx.globalAlpha = 0.3;\n    const spacing = 80;\n    const w = CONFIG.CANVAS_W, h = CONFIG.CANVAS_H;\n    for (let x = -this.offsetX; x < w + spacing; x += spacing) {\n      ctx.beginPath();\n      for (let y = 0; y <= h; y += 10) {\n        const dx = Math.sin(this.time * 2 + y * 0.02) * this.distortion * 20;\n        if (y === 0) ctx.moveTo(x + dx, y);\n        else ctx.lineTo(x + dx, y);\n      }\n      ctx.stroke();\n    }\n    for (let y = -this.offsetY; y < h + spacing; y += spacing) {\n      ctx.beginPath();\n      for (let x = 0; x <= w; x += 10) {\n        const dy = Math.cos(this.time * 1.5 + x * 0.02) * this.distortion * 20;\n        if (x === 0) ctx.moveTo(x, y + dy);\n        else ctx.lineTo(x, y + dy);\n      }\n      ctx.stroke();\n    }\n    ctx.globalAlpha = 1;\n    ctx.restore();\n  }\n}\n\n// --- Meter Renderer ---\nclass MeterRenderer {\n  constructor() {\n    this.breachFlash = 0;\n    this.inversionFlash = 0;\n    this.shake = { x: 0, y: 0, time: 0 };\n  }\n  update(dt, gameState) {\n    if (gameState.breachActive) this.breachFlash = Math.min(1, this.breachFlash + dt * 4);\n    else this.breachFlash = Math.max(0, this.breachFlash - dt * 2);\n    if (gameState.inversionTriggered) {\n      this.inversionFlash = 1;\n      gameState.inversionTriggered = false;\n    }\n    this.inversionFlash = Math.max(0, this.inversionFlash - dt * 3);\n    if (gameState.shakeIntensity > 0) {\n      this.shake.time += dt;\n      this.shake.x = Math.sin(this.shake.time * 50) * gameState.shakeIntensity * 10;\n      this.shake.y = Math.cos(this.shake.time * 47) * gameState.shakeIntensity * 10;\n      gameState.shakeIntensity = Math.max(0, gameState.shakeIntensity - dt * 2);\n    } else {\n      this.shake.x = this.shake.y = 0;\n    }\n  }\n  render(ctx, gameState, colors) {\n    const { METER_X, METER_Y, METER_W, METER_H } = CONFIG;\n    const entropy = gameState.entropy;\n    const inSafe = gameState.inSafe;\n    const dampenActive = gameState.dampenActive;\n    const dampenCooldown = gameState.dampenCooldown;\n    const phase = gameState.phase;\n    ctx.save();\n    ctx.translate(METER_X + this.shake.x, METER_Y + this.shake.y);\n    // Background track\n    const grad = ctx.createLinearGradient(-METER_W/2, -METER_H/2, -METER_W/2, METER_H/2);\n    grad.addColorStop(0, colors.void);\n    grad.addColorStop(0.15, colors.crit);\n    grad.addColorStop(0.35, colors.warn);\n    grad.addColorStop(0.5, colors.safe);\n    grad.addColorStop(0.65, colors.safe);\n    grad.addColorStop(0.85, colors.warn);\n    grad.addColorStop(1, colors.crit);\n    ctx.fillStyle = grad;\n    ctx.fillRect(-METER_W/2, -METER_H/2, METER_W, METER_H);\n    // Grid lines on meter\n    ctx.strokeStyle = colors.grid;\n    ctx.lineWidth = 1;\n    ctx.globalAlpha = 0.3;\n    for (let i = 0; i <= 10; i++) {\n      const y = -METER_H/2 + (i/10) * METER_H;\n      ctx.beginPath();\n      ctx.moveTo(-METER_W/2 - 5, y);\n      ctx.lineTo(METER_W/2 + 5, y);\n      ctx.stroke();\n    }\n    ctx.globalAlpha = 1;\n    // Safe zone highlight\n    const safeTop = -METER_H/2 + CONFIG.SAFE_MIN * METER_H;\n    const safeBot = -METER_H/2 + CONFIG.SAFE_MAX * METER_H;\n    const safeGrad = ctx.createLinearGradient(0, safeTop, 0, safeBot);\n    safeGrad.addColorStop(0, colors.safe + '40');\n    safeGrad.addColorStop(0.5, colors.safe + '20');\n    safeGrad.addColorStop(1, colors.safe + '40');\n    ctx.fillStyle = safeGrad;\n    ctx.fillRect(-METER_W/2, safeTop, METER_W, safeBot - safeTop);\n    // Home position marker\n    const homeY = 0;\n    ctx.strokeStyle = colors.player;\n    ctx.lineWidth = 2;\n    ctx.setLineDash([5, 5]);\n    ctx.beginPath();\n    ctx.moveTo(-METER_W/2 - 10, homeY);\n    ctx.lineTo(METER_W/2 + 10, homeY);\n    ctx.stroke();\n    ctx.setLineDash([]);\n    // Entropy indicator (the moving bar)\n    const entropyY = -METER_H/2 + entropy * METER_H;\n    const barH = 8;\n    const barW = METER_W + 16;\n    // Glow\n    if (inSafe) {\n      ctx.shadowColor = colors.safe;\n      ctx.shadowBlur = 20;\n    } else if (entropy <= CONFIG.WARN_MIN || entropy >= CONFIG.WARN_MAX) {\n      ctx.shadowColor = colors.crit;\n      ctx.shadowBlur = 30;\n    } else {\n      ctx.shadowColor = colors.warn;\n      ctx.shadowBlur = 15;\n    }\n    const entropyGrad = ctx.createLinearGradient(-barW/2, 0, barW/2, 0);\n    entropyGrad.addColorStop(0, colors.entropy);\n    entropyGrad.addColorStop(0.5, inSafe ? colors.safe : colors.entropy);\n    entropyGrad.addColorStop(1, colors.entropy);\n    ctx.fillStyle = entropyGrad;\n    ctx.fillRect(-barW/2, entropyY - barH/2, barW, barH);\n    ctx.shadowBlur = 0;\n    // Velocity indicator (small arrow on side)\n    const vel = gameState.velocity;\n    if (Math.abs(vel) > 0.01) {\n      const arrowX = METER_W/2 + 12;\n      const arrowY = entropyY;\n      const arrowSize = 8 + Math.min(Math.abs(vel) * 20, 16);\n      ctx.fillStyle = vel > 0 ? colors.entropy : colors.player;\n      ctx.beginPath();\n      if (vel > 0) {\n        ctx.moveTo(arrowX, arrowY - arrowSize/2);\n        ctx.lineTo(arrowX + arrowSize, arrowY);\n        ctx.lineTo(arrowX, arrowY + arrowSize/2);\n      } else {\n        ctx.moveTo(arrowX + arrowSize, arrowY - arrowSize/2);\n        ctx.lineTo(arrowX, arrowY);\n        ctx.lineTo(arrowX + arrowSize, arrowY + arrowSize/2);\n      }\n      ctx.fill();\n    }\n    // Breach flash\n    if (this.breachFlash > 0) {\n      ctx.globalAlpha = this.breachFlash * 0.5;\n      ctx.fillStyle = colors.crit;\n      ctx.fillRect(-METER_W/2 - 20, -METER_H/2 - 20, METER_W + 40, METER_H + 40);\n      ctx.globalAlpha = 1;\n    }\n    // Inversion flash\n    if (this.inversionFlash > 0) {\n      ctx.globalAlpha = this.inversionFlash * 0.3;\n      ctx.fillStyle = colors.entropy;\n      ctx.fillRect(-METER_W/2 - 20, -METER_H/2 - 20, METER_W + 40, METER_H + 40);\n      ctx.globalAlpha = 1;\n    }\n    // Dampen zone indicator\n    if (dampenActive || dampenCooldown > 0) {\n      const dampenY = -METER_H/2 + 0.5 * METER_H;\n      const h = 60;\n      ctx.strokeStyle = dampenActive ? colors.safe : colors.uidim;\n      ctx.lineWidth = 3;\n      ctx.setLineDash([10, 5]);\n      ctx.globalAlpha = dampenActive ? 1 : 0.5;\n      ctx.beginPath();\n      ctx.moveTo(-METER_W/2 - 15, dampenY - h/2);\n      ctx.lineTo(METER_W/2 + 15, dampenY - h/2);\n      ctx.moveTo(-METER_W/2 - 15, dampenY + h/2);\n      ctx.lineTo(METER_W/2 + 15, dampenY + h/2);\n      ctx.stroke();\n      ctx.setLineDash([]);\n      ctx.globalAlpha = 1;\n    }\n    ctx.restore();\n  }\n}\n\n// --- Avatar Renderer ---\nclass AvatarRenderer {\n  constructor() {\n    this.bobTime = 0;\n    this.tilt = 0;\n    this.scale = 1;\n    this.trail = [];\n  }\n  update(dt, gameState) {\n    this.bobTime += dt;\n    const targetTilt = -gameState.velocity * 0.3;\n    this.tilt = lerp(this.tilt, targetTilt, 1 - Math.pow(0.01, dt));\n    this.scale = gameState.dampenActive ? 1.2 : (gameState.inSafe ? 1.0 : 0.9);\n    // Trail\n    this.trail.unshift({ x: gameState.avatarX, y: gameState.avatarY, time: 0 });\n    if (this.trail.length > 20) this.trail.pop();\n    this.trail.forEach(t => t.time += dt);\n  }\n  render(ctx, gameState, colors) {\n    const x = gameState.avatarX;\n    const y = gameState.avatarY;\n    const inSafe = gameState.inSafe;\n    const dampenActive = gameState.dampenActive;\n    ctx.save();\n    ctx.translate(x, y);\n    ctx.rotate(this.tilt);\n    ctx.scale(this.scale, this.scale);\n    // Trail\n    this.trail.forEach((t, i) => {\n      const alpha = 1 - t.time / 0.5;\n      if (alpha <= 0) return;\n      ctx.globalAlpha = alpha * 0.3;\n      ctx.fillStyle = inSafe ? colors.safe : colors.player;\n      ctx.beginPath();\n      ctx.arc(0, 0, 12 * (1 - t.time / 0.5), 0, Math.PI * 2);\n      ctx.fill();\n    });\n    ctx.globalAlpha = 1;\n    // Main body\n    const grad = ctx.createRadialGradient(0, 0, 0, 0, 0, 18);\n    grad.addColorStop(0, inSafe ? colors.safe : colors.player);\n    grad.addColorStop(1, colors.void);\n    ctx.fillStyle = grad;\n    ctx.shadowColor = inSafe ? colors.safe : colors.player;\n    ctx.shadowBlur = dampenActive ? 30 : 15;\n    // Hexagon\n    ctx.beginPath();\n    for (let i = 0; i < 6; i++) {\n      const angle = (i / 6) * Math.PI * 2 - Math.PI / 6;\n      const r = 16 + Math.sin(this.bobTime * 4 + i) * 2