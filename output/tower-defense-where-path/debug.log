  "index.html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<title>Path-Painter Tower Defense</title>\n<link rel=\"icon\" href=\"data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22><text y=%220.9em%22 font-size=%2232%22>🎮</text></svg>\">\n<link rel=\"stylesheet\" href=\"style.css\">\n</head>\n<body>\n<div id=\"game-container\">\n<canvas id=\"gameCanvas\" width=\"1280\" height=\"720\"></canvas>\n<div id=\"ui\">\n<div id=\"resources\">\n<span>Coins: <span id=\"coinCount\">1000</span></span>\n<span>Health: <span id=\"healthCount\">100</span>/<span id=\"maxHealth\">100</span></span>\n</div>\n<div id=\"waveInfo\">\n<span>Wave: <span id=\"waveNumber\">0</span></span>\n<span>Time: <span id=\"waveTimer\">30</span>s</span>\n</div>\n<div id=\"timer\">\n<span>Time: <span id=\"runTimer\">0</span>s</span>\n</div>\n<div id=\"shop\">\n<button id=\"towerBtn\">Place Tower (100)</button>\n</div>\n<div id=\"messages\"></div>\n</div>\n</div>\n<script src=\"game.js\"></script>\n</body>\n</html>",
  "style.css": "html,body{\nmargin:0;padding:0;background:#111;color:#fff;font-family:sans-serif;height:100%;\n}\n#game-container{\nposition:relative;width:100%;max-width:1280px;margin:auto;background:#000;\n}\n#game-container::after{\ncontent:\"\";display:block;padding-bottom:56.25%;\n}\n#gameCanvas{\nposition:absolute;top:0;left:0;width:100%;height:100%;image-rendering:pixelated;\n}\n#ui{\nposition:absolute;top:0;left:0;right:0;bottom:0;pointer-events:none;display:flex;flex-direction:column;padding:10px;box-sizing:border-box;\n}\n#resources,#waveInfo,#timer{\npointer-events:all;margin-bottom:8px;background:rgba(0,0,0,0.5);padding:6px;border-radius:4px;display:flex;gap:12px;font-size:18px;\n}\n#shop{\nmargin-top:auto;align-self:flex-end;background:rgba(0,0,0,0.5);padding:6px;border-radius:4px;\n}\nbutton{\nbackground:#ff6;color:#000;border:none;padding:6px 12px;border-radius:4px;cursor:pointer;font-size:16px;\n}\nbutton:hover{\nbackground:#ff0;\n}\n#messages{\nposition:absolute;bottom:20px;left:50%;transform:translateX(-50%);background:rgba(0,0,0,0.7);color:#ff0;padding:8px 16px;border-radius:4px;pointer-events:none;font-size:18px;\n}",
  "game.js": "(function(){\n'use strict';\n\nconst CANVAS_WIDTH = 1280;\nconst CANVAS_HEIGHT = 720;\nconst GRID_SIZE = 32;\nconst SETTLE_TIME = 2000; // ms after which trail becomes solid\nconst TOWER_COST = 100;\nconst TOWER_RANGE = 150;\nconst TOWER_DAMAGE = 10;\nconst TOWER_FIRE_RATE = 500; // ms\nconst ENEMY_SPEED = 80; // px/s\nconst ENEMY_HEALTH = 30;\nconst ENEMY_DAMAGE_TO_BASE = 10;\nconst COIN_PER_KILL = 10;\nconst STARTING_COINS = 1000;\nconst STARTING_HEALTH = 100;\nconst WAVE_DELAY = 15000; // ms between waves\nconst ENEMIES_PER_WAVE_BASE = 3;\nconst ENEMY_INCREMENT_PER_WAVE = 2;\n\nlet canvas = document.getElementById('gameCanvas');\nlet ctx = canvas.getContext('2d');\n\nlet state = {\ncoins: STARTING_COINS,\nhealth: STARTING_HEALTH,\nmaxHealth: STARTING_HEALTH,\nwave: 0,\ntimeToNextWave: WAVE_DELAY,\nenemies: [],\ntowers: [],\nprojectiles: [],\npathPoints: [], // raw points with timestamp\nsolidPoints: [], // points older than SETTLE_TIME\nplacingTower: false,\npreviewX: 0,\npreviewY: 0,\ngameOver: false,\nlastTime: 0,\nelapsedTime: 0,\nhighScoreWaves: 0\n};\n\n// Input\nlet mouseX = 0, mouseY = 0;\ncanvas.addEventListener('mousedown', e => {\nconst rect = canvas.getBoundingClientRect();\nmouseX = e.clientX - rect.left;\nmouseY = e.clientY - rect.top;\nif (state.placingTower) {\nplaceTowerAt(mouseX, mouseY);\n} else {\n// click to select tower? not needed\n}\n});\ncanvas.addEventListener('touchstart', e => {\ne.preventDefault();\nconst touch = e.touches[0];\nconst rect = canvas.getBoundingClientRect();\nmouseX = touch.clientX - rect.left;\nmouseY = touch.clientY - rect.top;\nif (state.placingTower) {\nplaceTowerAt(mouseX, mouseY);\n}\n});\ncanvas.addEventListener('mousemove', e => {\nconst rect = canvas.getBoundingClientRect();\nmouseX = e.clientX - rect.left;\nmouseY = e.clientY - rect.top;\nif (state.placingTower) {\nupdatePreview(mouseX, mouseY);\n}\n});\ncanvas.addEventListener('touchmove', e => {\ne.preventDefault();\nconst touch = e.touches[0];\nconst rect = canvas.getBoundingClientRect();\nmouseX = touch.clientX - rect.left;\nmouseY = touch.clientY - rect.top;\nif (state.placingTower) {\nupdatePreview(mouseX, mouseY);\n}\n});\n\nfunction updatePreview(mx, my) {\nstate.previewX = Math.round(mx / GRID_SIZE) * GRID_SIZE;\nstate.previewY = Math.round(my / GRID_SIZE) * GRID_SIZE;\nif (state.previewX < 0) state.previewX = 0;\nif (state.previewY < 0) state.previewY = 0;\nif (state.previewX >= CANVAS_WIDTH) state.previewX = CANVAS_WIDTH - GRID_SIZE;\nif (state.previewY >= CANVAS_HEIGHT) state.previewY = CANVAS_HEIGHT - GRID_SIZE;\n}\n\nfunction placeTowerAt(x, y) {\nconst gx = Math.round(x / GRID_SIZE) * GRID_SIZE;\nconst gy = Math.round(y / GRID_SIZE) * GRID_SIZE;\n// check occupancy\nconst key = `${gx},${gy}`;\nif (state.towers.some(t => `${Math.round(t.x/GRID_SIZE)*GRID_SIZE},${Math.round(t.y/GRID_SIZE)*GRID_SIZE}` === key)) {\nshowMessage('Cannot place tower here');\nreturn;\n}\nif (state.coins < TOWER_COST) {\nshowMessage('Not enough coins');\nreturn;\n}\nstate.coins -= TOWER_COST;\nstate.towers.push({\nx: gx + GRID_SIZE/2,\ny: gy + GRID_SIZE/2,\ntype: 'archer',\nlevel: 1,\nrange: TOWER_RANGE,\ndamage: TOWER_DAMAGE,\ncooldown: 0\n});\nplaySound('place');\nstate.placingTower = false;\ndocument.getElementById('towerBtn').textContent = `Place Tower (${TOWER_COST})`;\nshowMessage('Tower placed');\n}\n\nfunction showMessage(msg) {\nconst el = document.getElementById('messages');\nel.textContent = msg;\nel.style.opacity = '1';\nsetTimeout(() => { el.style.opacity = '0'; }, 1500);\n}\n\n// Tower button\ndocument.getElementById('towerBtn').addEventListener('click', () => {\nif (!state.placingTower) {\nstate.placingTower = true;\ndocument.getElementById('towerBtn').textContent = 'Placing... (click to cancel)';\nshowMessage('Click to place tower');\n} else {\nstate.placingTower = false;\ndocument.getElementById('towerBtn').textContent = `Place Tower (${TOWER_COST})`;\nshowMessage('Placement cancelled');\n}\n});\n\n// Audio\nlet audioCtx = null;\nfunction initAudio() {\nif (!audioCtx) {\naudioCtx = new (window.AudioContext || window.webkitAudioContext)();\n}\n}\nfunction playSound(type) {\nif (!audioCtx) return;\nconst osc = audioCtx.createOscillator();\nconst gain = audioCtx.createGain();\nosc.connect(gain);\ngain.connect(audioCtx.destination);\ngain.gain.setValueAtTime(0, audioCtx.currentTime);\nswitch(type) {\ncase 'place':\nosc.frequency.value = 400;\ngain.gain.linearRampToValueAtTime(0.2, audioCtx.currentTime + 0.01);\ngain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 0.2);\nbreak;\ncase 'shot':\nosc.frequency.value = 600;\ngain.gain.linearRampToValueAtTime(0.1, audioCtx.currentTime + 0.01);\ngain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 0.1);\nbreak;\ncase 'hit':\nosc.frequency.value = 200;\ngain.gain.linearRampToValueAtTime(0.2, audioCtx.currentTime + 0.01);\ngain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 0.15);\nbreak;\ncase 'die':\nosc.frequency.value = 100;\ngain.gain.linearRampToValueAtTime(0.2, audioCtx.currentTime + 0.01);\ngain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 0.3);\nbreak;\ncase 'wave':\nosc.frequency.value = 800;\ngain.gain.linearRampToValueAtTime(0.2, audioCtx.currentTime + 0.01);\ngain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 0.3);\nbreak;\ndefault:\nosc.frequency.value = 440;\ngain.gain.linearRampToValueAtTime(0.2, audioCtx.currentTime + 0.01);\ngain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 0.2);\n}\nosc.start(audioCtx.currentTime);\nosc.stop(audioCtx.currentTime + 0.5);\n}\n\n// Game logic\nfunction spawnEnemy() {\nstate.enemies.push({\nx: 0,\ny: Math.random() * (CANVAS_HEIGHT - 50) + 25,\nhealth: ENEMY_HEALTH,\nspeed: ENEMY_SPEED,\nwaypointIdx: 0\n});\n}\n\nfunction updatePath() {\nconst now = Date.now();\n// add points from each enemy\nstate.enemies.forEach(e => {\nstate.pathPoints.push({x: e.x, y: e.y, time: now});\n});\n// solidify old points\nstate.solidPoints = state.pathPoints.filter(p => now - p.time > SETTLE_TIME);\n}\n\nfunction updateEnemies(dt) {\nstate.enemies.forEach((e, i) => {\nif (state.solidPoints.length > 0) {\nlet targetIdx = e.waypointIdx;\nif (targetIdx >= state.solidPoints.length) {\ntargetIdx = state.solidPoints.length - 1;\n}\nconst target = state.solidPoints[targetIdx];\nconst dx = target.x - e.x;\nconst dy = target.y - e.y;\nconst dist = Math.hypot(dx, dy);\nif (dist < 5) {\ne.waypointIdx++;\nif (e.waypointIdx >= state.solidPoints.length) {\ne.waypointIdx = state.solidPoints.length; // go to base\n}\n} else {\nconst speed = e.speed * dt / 1000;\ne.x += (dx / dist) * speed;\ne.y += (dy / dist) * speed;\n}\n} else {\n// no path yet, go straight to base\nconst dx = CANVAS_WIDTH - e.x;\nconst dy = CANVAS_HEIGHT/2 - e.y; // aim at middle height\nconst dist = Math.hypot(dx, dy);\nif (dist > 1) {\nconst speed = e.speed * dt / 1000;\ne.x += (dx / dist) * speed;\ne.y += (dy / dist) * speed;\n}\n}\n// check if reached base\nif (e.x >= CANVAS_WIDTH - 10) {\nstate.health -= ENEMY_DAMAGE_TO_BASE;\nstate.enemies.splice(i, 1);\nshowMessage('Enemy reached base!');\nplaySound('hit');\n}\n});\n// remove dead enemies\nstate.enemies = state.enemies.filter(e => e.health > 0);\n}\n\nfunction updateTowers(dt) {\nstate.towers.forEach(t => {\nif (t.cooldown > 0) t.cooldown -= dt;\n// find nearest enemy in range\nlet target = null;\nlet nearest = t.range + 1;\nstate.enemies.forEach(e => {\nconst dx = e.x - t.x;\nconst dy = e.y - t.y;\nconst dist = Math.hypot(dx, dy);\nif (dist < t.range && dist < nearest) {\nnearest = dist;\ntarget = e;\n}\n});\nif (target && t.cooldown <= 0) {\n// fire projectile\nstate.projectiles.push({\nx: t.x,\ny: t.y,\ntarget: target,\nspeed: 300,\ndamage: t.damage\n});\nt.cooldown = TOWER_FIRE_RATE;\nplaySound('shot');\n}\n});\n}\n\nfunction updateProjectiles(dt) {\nstate.projectiles.forEach((p, i) => {\nif (!p.target || p.target.health <= 0) {\nstate.projectiles.splice(i, 1);\nreturn;\n}\nconst dx = p.target.x - p.x;\nconst dy = p.target.y - p.y;\nconst dist = Math.hypot(dx, dy);\nif (dist < 5) {\n// hit\np.target.health -= p.damage;\nplaySound('hit');\nif (p.target.health <= 0) {\nstate.coins += COIN_PER_KILL;\nplaySound('die');\n// remove enemy\nconst idx = state.enemies.indexOf(p.target);\nif (idx > -1) state.enemies.splice(idx, 1);\n}\nstate.projectiles.splice(i, 1);\n}\n});\n}\n\nfunction render() {\nctx.clearRect(0,0,CANVAS_WIDTH,CANVAS_HEIGHT);\n// draw solid path\nctx.strokeStyle = '#555';\nctx.lineWidth = 2;\nctx.beginPath();\nstate.solidPoints.forEach((p,i)=>{ \nif(i===0) ctx.moveTo(p.x,p.y);\nelse ctx.lineTo(p.x,p.y);\n});\nctx.stroke();\n// draw enemies\nstate.enemies.forEach(e=>{\nctx.fillStyle = '#f00';\nctx.beginPath();\nctx.arc(e.x,e.y,8,0,Math.PI*2);\nctx.fill();\n});\n// draw towers\nstate.towers.forEach(t=>{\nctx.fillStyle = '#0f0';\nctx.beginPath();\nctx.arc(t.x,t.y,12,0,Math.PI*2);\nctx.fill();\nctx.strokeStyle = '#080';\nctx.lineWidth = 2;\nctx.beginPath();\nctx.arc(t.x,t.y,t.range,0,Math.PI*2);\nctx.stroke();\n});\n// draw projectiles\nstate.projectiles.forEach(p=>{\nctx.fillStyle = '#ff0';\nctx.beginPath();\nctx.arc(p.x,p.y,4,0,Math.PI*2);\nctx.fill();\n});\n// draw preview tower if placing\nif(state.placingTower){\nctx.fillStyle = 'rgba(0,255,0,0.3)';\nctx.fillRect(state.previewX,state.previewY,GRID_SIZE,GRID_SIZE);\nctx.strokeStyle = '#0f0';\nctx.strokeRect(state.previewX,state.previewY,GRID_SIZE,GRID_SIZE);\n}\n}\n\nfunction gameLoop(timestamp){\nif(!state.lastTime) state.lastTime = timestamp;\nconst dt = timestamp - state.lastTime;\nstate.lastTime = timestamp;\nstate.elapsedTime += dt;\n// update\nupdatePath();\nupdateEnemies(dt);\nupdateTowers(dt);\nupdateProjectiles(dt);\n// check wave\nif(state.enemies.length===0 && state.timeToNextWave<=0){\nstartWave();\n}else{\nstate.timeToNextWave -= dt;\n}\n// render\nrender();\n// ui updates\ndocument.getElementById('coinCount').textContent = state.coins;\ndocument.getElementById('healthCount').textContent = state.health;\ndocument.getElementById('waveNumber').textContent = state.wave;\ndocument.getElementById('waveTimer').textContent = Math.max(0,Math.ceil(state.timeToNextWave/1000));\ndocument.getElementById('runTimer').textContent = Math.floor(state.elapsedTime/1000);\n// game over\nif(state.health<=0 && !state.gameOver){\nstate.gameOver = true;\nshowMessage('Game Over! Survived '+state.wave+' waves');\nplaySound('die');\n}\n// request next frame\nif(!state.gameOver){\nrequestAnimationFrame(gameLoop);\n}\n}\n\nfunction startWave(){\nstate.wave++;\nstate.timeToNextWave = WAVE_DELAY;\nconst count = ENEMIES_PER_WAVE_BASE + (state.wave-1)*ENEMY_INCREMENT_PER_WAVE;\nfor(let i=0;i<count;i++){\nsetTimeout(()=>{spawnEnemy();}, i*800);\n}\nplaySound('wave');\nif(state.wave>state.highScoreWaves) state.highScoreWaves = state.wave;\n}\n\nfunction init(){\ninitAudio();\n// start first wave after short delay\nsetTimeout(()=>{startWave();}, 1000);\nrequestAnimationFrame(gameLoop);\n}\ninit();\n\n})();\n