  \n  update(id: string, newPos: Vec2) {\n    const oldPos = this.entityPos.get(id);\n    if (oldPos) {\n      const ok = this.key(oldPos.x, oldPos.y);\n      const nk = this.key(newPos.x, newPos.y);\n      if (ok !== nk) {\n        this.cells.get(ok)?.delete(id);\n        if (!this.cells.has(nk)) this.cells.set(nk, new Set());\n        this.cells.get(nk)!.add(id);\n      }\n    } else {\n      if (!this.cells.has(nk)) this.cells.set(nk, new Set());\n      this.cells.get(nk)!.add(id);\n    }\n    this.entityPos.set(id, newPos.clone());\n  }\n  \n  remove(id: string) {\n    const pos = this.entityPos.get(id);\n    if (pos) {\n      this.cells.get(this.key(pos.x, pos.y))?.delete(id);\n      this.entityPos.delete(id);\n    }\n  }\n  \n  query(x: number, y: number, radius: number, out: string[]) {\n    const minX = Math.floor((x - radius) / GRID_SIZE);\n    const maxX = Math.floor((x + radius) / GRID_SIZE);\n    const minY = Math.floor((y - radius) / GRID_SIZE);\n    const maxY = Math.floor((y + radius) / GRID_SIZE);\n    for (let gx = minX; gx <= maxX; gx++) {\n      for (let gy = minY; gy <= maxY; gy++) {\n        const cell = this.cells.get(`${gx},${gy}`);\n        if (cell) cell.forEach(id => out.push(id));\n      }\n    }\n  }\n  \n  clear() { this.cells.clear(); this.entityPos.clear(); }\n}\n\n// --- CAPSULE COLLISION ---\nfunction capsuleIntersect(ax, ay, bx, by, ar, br) {\n  // Segment A: a->b, radius ar. Segment B: c->d, radius br\n  // Simplified: treat as circle vs segment for trail segments (short)\n  // Actually we need segment vs segment. Use point-segment distance.\n  return false; // placeholder\n}\nfunction pointSegmentDist2(px, py, ax, ay, bx, by) {\n  const dx = bx - ax, dy = by - ay;\n  const l2 = dx*dx + dy*dy;\n  if (l2 === 0) return dist2(px, py, ax, ay);\n  let t = ((px - ax) * dx + (py - ay) * dy) / l2;\n  t = clamp(t, 0, 1);\n  const cx = ax + t * dx, cy = ay + t * dy;\n  return dist2(px, py, cx, cy);\n}\nfunction capsulesIntersect(ax, ay, bx, by, ar, cx, cy, dx, dy, cr) {\n  const r = ar + cr;\n  const r2 = r * r;\n  // Check if segments are close enough\n  // Quick reject: bounding boxes\n  const minAx = Math.min(ax, bx) - ar, maxAx = Math.max(ax, bx) + ar;\n  const minAy = Math.min(ay, by) - ar, maxAy = Math.max(ay, by) + ar;\n  const minCx = Math.min(cx, dx) - cr, maxCx = Math.max(cx, dx) + cr;\n  const minCy = Math.min(cy, dy) - cr, maxCy = Math.max(cy, dy) + cr;\n  if (maxAx < minCx || minAx > maxCx || maxAy < minCy || minAy > maxCy) return false;\n  // Distance between segments\n  // Simplified: check endpoints vs other segment\n  if (pointSegmentDist2(ax, ay, cx, cy, dx, dy) < r2) return true;\n  if (pointSegmentDist2(bx, by, cx, cy, dx, dy) < r2) return true;\n  if (pointSegmentDist2(cx, cy, ax, ay, bx, by) < r2) return true;\n  if (pointSegmentDist2(dx, dy, ax, ay, bx, by) < r2) return true;\n  return false;\n}\n\n// --- COLOR PALETTE ---\nconst PALETTE = {\n  bg: '#0a0a12',\n  grid: '#1a1a2e',\n  playerCore: '#ffffff',\n  playerTrim: '#00ffff',\n  weapons: {\n    ballpoint: { main: '#00ffff', fade: '#0088ff', glow: '#00ffff' },\n    fountain: { main: '#ff00ff', fade: '#ff0088', glow: '#ff00ff' },\n    rollerball: { main: '#ffff00', fade: '#ffaa00', glow: '#ffff00' },\n    highlighter: { main: '#00ff88', fade: '#00cc66', glow: '#00ff88' }\n  },\n  enemy: { body: '#2a2a3e', rim: '#ff3366' },\n  elite: { body: '#3a1a1a', rim: '#ff6600' },\n  void: '#000000',\n  hpFull: '#00ffff',\n  hpEmpty: '#880000',\n  inkLow: '#ff3366',\n  combo: '#ff00ff',\n  timer: '#ffff00',\n  score: '#00ff88'\n};\n\n// Color blind adjustments\nfunction applyColorBlind(color, mode) {\n  if (mode === 'none') return color;\n  // Simple matrix approximations\n  const r = parseInt(color.slice(1,3),16)/255;\n  const g = parseInt(color.slice(3,5),16)/255;\n  const b = parseInt(color.slice(5,7),16)/255;\n  let nr, ng, nb;\n  if (mode === 'protan') { nr = 0.567*r + 0.433*g; ng = 0.558*r + 0.442*g; nb = b; }\n  else if (mode === 'deutan') { nr = 0.625*r + 0.375*g; ng = 0.7*r + 0.3*g; nb = b; }\n  else { nr = r; ng = 0.95*g + 0.05*b; nb = 0.433*g + 0.567*b; }\n  const toHex = (v) => Math.round(clamp(v,0,1)*255).toString(16).padStart(2,'0');\n  return `#${toHex(nr)}${toHex(ng)}${toHex(nb)}`;\n}\n\n// --- AUDIO ENGINE ---\nclass AudioEngine {\n  ctx: AudioContext;\n  masterGain: GainNode;\n  musicGain: GainNode;\n  sfxGain: GainNode;\n  analyser: AnalyserNode;\n  musicState = { drone: null, beat: null, lead: null, percussion: null };\n  \n  constructor() {\n    this.ctx = new (window.AudioContext || window.webkitAudioContext)();\n    this.masterGain = this.ctx.createGain();\n    this.masterGain.gain.value = 0.3;\n    this.musicGain = this.ctx.createGain();\n    this.musicGain.gain.value = 0.5;\n    this.sfxGain = this.ctx.createGain();\n    this.sfxGain.gain.value = 0.5;\n    this.analyser = this.ctx.createAnalyser();\n    this.analyser.fftSize = 256;\n    this.musicGain.connect(this.masterGain);\n    this.sfxGain.connect(this.masterGain);\n    this.masterGain.connect(this.analyser);\n    this.analyser.connect(this.ctx.destination);\n    this.initMusic();\n  }\n  \n  initMusic() {\n    // Drone - always playing\n    this.musicState.drone = this.createDrone();\n    this.musicState.drone.connect(this.musicGain);\n    this.musicState.drone.start();\n    \n    // Beat - fades in at wave 2\n    this.musicState.beat = this.createBeat();\n    this.musicState.beat.connect(this.musicGain);\n    this.musicState.beat.gain.gain.value = 0;\n    \n    // Lead - fades in at combo > 3\n    this.musicState.lead = this.createLead();\n    this.musicState.lead.connect(this.musicGain);\n    this.musicState.lead.gain.gain.value = 0;\n    \n    // Percussion - high energy\n    this.musicState.percussion = this.createPercussion();\n    this.musicState.percussion.connect(this.musicGain);\n    this.musicState.percussion.gain.gain.value = 0;\n  }\n  \n  createDrone() {\n    const gain = this.ctx.createGain();\n    gain.gain.value = 0.15;\n    const osc1 = this.ctx.createOscillator(); osc1.type = 'sine'; osc1.frequency.value = 55;\n    const osc2 = this.ctx.createOscillator(); osc2.type = 'sawtooth'; osc2.frequency.value = 110;\n    const filter = this.ctx.createBiquadFilter(); filter.type = 'lowpass'; filter.frequency.value = 200;\n    osc1.connect(filter); osc2.connect(filter); filter.connect(gain);\n    return { gain, osc1, osc2, filter, start: () => { osc1.start(); osc2.start(); } };\n  }\n  \n  createBeat() {\n    const gain = this.ctx.createGain();\n    gain.gain.value = 0;\n    const schedule = (time) => {\n      const kick = this.ctx.createOscillator(); kick.type = 'sine'; kick.frequency.setValueAtTime(150, time); kick.frequency.exponentialRampToValueAtTime(40, time + 0.3);\n      const kickGain = this.ctx.createGain(); kickGain.gain.setValueAtTime(0.3, time); kickGain.gain.exponentialRampToValueAtTime(0.01, time + 0.4);\n      kick.connect(kickGain); kickGain.connect(gain);\n      kick.start(time); kick.stop(time + 0.5);\n      \n      const hat = this.ctx.createBufferSource();\n      const buffer = this.ctx.createBuffer(1, 4410, 44100);\n      const data = buffer.getChannelData(0);\n      for (let i = 0; i < data.length; i++) data[i] = Math.random() * 2 - 1;\n      hat.buffer = buffer;\n      const hatGain = this.ctx.createGain(); hatGain.gain.setValueAtTime(0.05, time); hatGain.gain.exponentialRampToValueAtTime(0.001, time + 0.1);\n      const hatFilter = this.ctx.createBiquadFilter(); hatFilter.type = 'highpass'; hatFilter.frequency.value = 8000;\n      hat.connect(hatFilter); hatFilter.connect(hatGain); hatGain.connect(gain);\n      hat.start(time + 0.25);\n      \n      if (gain.gain.value > 0.01) setTimeout(() => schedule(this.ctx.currentTime + 0.5), 500);\n    };\n    return { gain, start: () => { gain.gain.value = 0.2; schedule(this.ctx.currentTime); } };\n  }\n  \n  createLead() {\n    const gain = this.ctx.createGain(); gain.gain.value = 0;\n    const filter = this.ctx.createBiquadFilter(); filter.type = 'bandpass'; filter.frequency.value = 800; filter.Q.value = 5;\n    const osc = this.ctx.createOscillator(); osc.type = 'square'; osc.frequency.value = 220;\n    osc.connect(filter); filter.connect(gain);\n    return { gain, osc, filter, start: () => { osc.start(); } };\n  }\n  \n  createPercussion() {\n    const gain = this.ctx.createGain(); gain.gain.value = 0;\n    return { gain, trigger: () => {\n      const noise = this.ctx.createBufferSource();\n      const buffer = this.ctx.createBuffer(1, 4410, 44100);\n      const data = buffer.getChannelData(0);\n      for (let i = 0; i < data.length; i++) data[i] = (Math.random() * 2 - 1) * Math.exp(-i/500);\n      noise.buffer = buffer;\n      const nGain = this.ctx.createGain(); nGain.gain.value = 0.1;\n      const nFilter = this.ctx.createBiquadFilter(); nFilter.type = 'bandpass'; nFilter.frequency.value = 2000;\n      noise.connect(nFilter); nFilter.connect(nGain); nGain.connect(gain);\n      noise.start();\n    }};\n  }\n  \n  updateMusic(wave, combo, hp) {\n    if (this.musicState.beat.gain.gain.value === 0 && wave >= 2) this.musicState.beat.start();\n    if (this.musicState.lead.gain.gain.value === 0 && combo > 3) this.musicState.lead.start();\n    if (this.musicState.percussion.gain.gain.value === 0 && (wave >= 10 || hp <= 1)) this.musicState.percussion.start();\n    \n    const targetBeat = wave >= 2 ? 0.2 : 0;\n    const targetLead = combo > 3 ? Math.min(0.15, (combo - 3) * 0.03) : 0;\n    const targetPerc = (wave >= 10 || hp <= 1) ? 0.15 : 0;\n    \n    this.musicState.beat.gain.gain.linearRampToValueAtTime(targetBeat, this.ctx.currentTime + 2);\n    this.musicState.lead.gain.gain.linearRampToValueAtTime(targetLead, this.ctx.currentTime + 1);\n    this.musicState.percussion.gain.gain.linearRampToValueAtTime(targetPerc, this.ctx.currentTime + 1);\n    \n    // Modulate lead frequency with combo\n    if (this.musicState.lead.osc) {\n      this.musicState.lead.osc.frequency.setTargetAtTime(220 + combo * 20, this.ctx.currentTime, 0.1);\n    }\n  }\n  \n  playShoot(inkPercent) {\n    const osc = this.ctx.createOscillator();\n    osc.type = 'sine';\n    const freq = 800 + (1 - inkPercent) * 400;\n    osc.frequency.setValueAtTime(freq, this.ctx.currentTime);\n    osc.frequency.exponentialRampToValueAtTime(freq * 0.5, this.ctx.currentTime + 0.05);\n    const gain = this.ctx.createGain();\n    gain.gain.setValueAtTime(0.08, this.ctx.currentTime);\n    gain.gain.exponentialRampToValueAtTime(0.001, this.ctx.currentTime + 0.08);\n    osc.connect(gain); gain.connect(this.sfxGain);\n    osc.start(); osc.stop(this.ctx.currentTime + 0.1);\n  }\n  \n  playTrailHit(enemyMaxHp) {\n    const noise = this.ctx.createBufferSource();\n    const buffer = this.ctx.createBuffer(1, 2205, 44100);\n    const data = buffer.getChannelData(0);\n    for (let i = 0; i < data.length; i++) data[i] = (Math.random() * 2 - 1) * Math.exp(-i/200);\n    noise.buffer = buffer;\n    const gain = this.ctx.createGain(); gain.gain.value = 0.06;\n    const filter = this.ctx.createBiquadFilter(); filter.type = 'bandpass'; filter.frequency.value = 500 + enemyMaxHp * 100; filter.Q.value = 3;\n    const sub = thisctx.createOscillator(); sub.type = 'sine'; sub.frequency.setValueAtTime(80, this.ctx.currentTime); sub.frequency.exponentialRampToValueAtTime(40, this.ctx.currentTime + 0.3);\n      const subGain = this.ctx.createGain(); subGain.gain.setValueAtTime(0.1, this.ctx.currentTime); subGain.gain.exponentialRampToValueAtTime(0.001, this.ctx.currentTime + 0.4);\n      sub.connect(subGain); subGain.connect(this.sfxGain);\n      noise.connect(filter); filter.connect(gain); gain.connect(this.sfxGain);\n      noise.start(); noise.stop(this.ctx.currentTime + 0.3);\n      sub.start(); sub.stop(this.ctx.currentTime + 0.4);\n      this.musicState.percussion.trigger();\n    }};\n  }\n  \n  playEnemyDeath(isElite) {\n    const osc = this.ctx.createOscillator();\n    osc.type = isElite ? 'sawtooth' : 'square';\n    osc.frequency.setValueAtTime(isElite ? 200 : 400, this.ctx.currentTime);\n    osc.frequency.exponentialRampToValueAtTime(50, this.ctx.currentTime + 0.3);\n    const gain = this.ctx.createGain();\n    gain.gain.setValueAtTime(0.1, this.ctx.currentTime);\n    gain.gain.exponentialRampToValueAtTime(0.001, this.ctx.currentTime + 0.3);\n    const filter = this.ctx.createBiquadFilter(); filter.type = 'lowpass'; filter.frequency.value = 1000;\n    osc.connect(filter); filter.connect(gain); gain.connect(this.sfxGain);\n    osc.start(); osc.stop(this.ctx.currentTime + 0.4);\n  }\n  \n  playUpgrade() {\n    const notes = [523.25, 659.25, 783.99, 1046.5];\n    notes.forEach((freq, i) => {\n      const osc = this.ctx.createOscillator(); osc.type = 'sine';\n      osc.frequency.value = freq;\n      const gain = this.ctx.createGain();\n      gain.gain.setValueAtTime(0.08, this.ctx.currentTime + i * 0.08);\n      gain.gain.exponentialRampToValueAtTime(0.001, this.ctx.currentTime + i * 0.08 + 0.3);\n      osc.connect(gain); gain.connect(this.sfxGain);\n      osc.start(this.ctx.currentTime + i * 0.08);\n      osc.stop(this.ctx.currentTime + i * 0.08 + 0.4);\n    });\n  }\n  \n  playWaveClear() {\n    const notes = [261.63, 329.63, 392.00, 523.25, 659.25];\n    notes.forEach((freq, i) => {\n      const osc = this.ctx.createOscillator(); osc.type = 'triangle';\n      osc.frequency.value = freq;\n      const gain = this.ctx.createGain();\n      gain.gain.setValueAtTime(0.1, this.ctx.currentTime + i * 0.1);\n      gain.gain.exponentialRampToValueAtTime(0.001, this.ctx.currentTime + i * 0.1 + 0.5);\n      osc.connect(gain); gain.connect(this.sfxGain);\n      osc.start(this.ctx.currentTime + i * 0.1);\n      osc.stop(this.ctx.currentTime + i * 0.1 + 0.6);\n    });\n  }\n  \n  playGameOver() {\n    const osc = this.ctx.createOscillator(); osc.type = 'sawtooth';\n    osc.frequency.setValueAtTime(220, this.ctx.currentTime);\n    osc.frequency.exponentialRampToValueAtTime(55, this.ctx.currentTime + 1);\n    const gain = this.ctx.createGain();\n    gain.gain.setValueAtTime(0.15, this.ctx.currentTime);\n    gain.gain.exponentialRampToValueAtTime(0.001, this.ctx.currentTime + 1.5);\n    const filter = this.ctx.createBiquadFilter(); filter.type = 'lowpass'; filter.frequency.setValueAtTime(2000, this.ctx.currentTime); filter.frequency.exponentialRampToValueAtTime(100, this.ctx.currentTime + 1);\n    osc.connect(filter); filter.connect(gain); gain.connect(this.sfxGain);\n    osc.start(); osc.stop(this.ctx.currentTime + 1.5);\n  }\n  \n  resume() { if (this.ctx.state === 'suspended') this.ctx.resume(); }\n}\n\n// --- PARTICLE SYSTEM ---\nclass Particle {\n  id = '';\n  pos = new Vec2();\n  vel = new Vec2();\n  life = 0;\n  maxLife = 1;\n  size = 2;\n  color = '#00ffff';\n  alpha = 1;\n  gravity = 0;\n  shrink = true;\n  active = false;\n  \n  reset() { this.active = false; this.life = 0; }\n  \n  update(dt) {\n    if (!this.active) return false;\n    this.life += dt;\n    if (this.life >= this.maxLife) { this.active = false; return false; }\n    this.vel.y += this.gravity * dt;\n    this.pos.add(this.vel.clone().scale(dt));\n    const t = this.life / this.maxLife;\n    this.alpha = 1 - t;\n    if (this.shrink) this.size *= 0.98;\n    return true;\n  }\n  \n  draw(ctx, cam) {\n    if (!this.active) return;\n    ctx.globalAlpha = this.alpha;\n    ctx.fillStyle = this.color;\n    ctx.beginPath();\n    ctx.arc(this.pos.x - cam.x, this.pos.y - cam.y, Math.max(0.5, this.size), 0, PI2);\n    ctx.fill();\n    ctx.globalAlpha = 1;\n  }\n}\n\nclass ParticleSystem {\n  pool: Pool<Particle>;\n  particles: Particle[] = [];\n  \n  constructor() {\n    this.pool = new Pool(() => new Particle(), p => p.reset(), 512);\n  }\n  \n  emit(x, y, count, color, speedMin, speedMax, lifeMin, lifeMax, sizeMin, sizeMax, gravity = 0) {\n    for (let i = 0; i < count; i++) {\n      const p = this.pool.acquire();\n      p.id = uuid();\n      p.pos.set(x, y);\n      const ang = rand(0, PI2);\n      const spd = rand(speedMin, speedMax);\n      p.vel.set(Math.cos(ang) * spd, Math.sin(ang) * spd);\n      p.life = 0;\n      p.maxLife = rand(lifeMin, lifeMax);\n      p.size = rand(sizeMin, sizeMax);\n      p.color = color;\n      p.gravity = gravity;\n      p.shrink = true;\n      p.active = true;\n      this.particles.push(p);\n    }\n  }\n  \n  emitRing(x, y, count, color, radius, speed, life, size) {\n    for (let i = 0; i < count; i++) {\n      const p = this.pool.acquire();\n      p.id = uuid();\n      const ang = (i / count) * PI2 + rand(-0.1, 0.1);\n      p.pos.set(x + Math.cos(ang) * radius, y + Math.sin(ang) * radius);\n      p.vel.set(Math.cos(ang) * speed, Math.sin(ang) * speed);\n      p.life = 0;\n      p.maxLife = life;\n      p.size = size;\n      p.color = color;\n      p.gravity = 0;\n      p.shrink = true;\n      p.active = true;\n      this.particles.push(p);\n    }\n  }\n  \n  emitTrail(x, y, color, size) {\n    const p = this.pool.acquire();\n    p.id = uuid();\n    p.pos.set(x + rand(-2, 2), y + rand(-2, 2));\n    p.vel.set(rand(-10, 10), rand(-10, 10));\n    p.life = 0;\n    p.maxLife = rand(0.2, 0.4);\n    p.size = size * rand(0.5, 1);\n    p.color = color;\n    p.gravity = 0;\n    p.shrink = true;\n    p.active = true;\n    this.particles.push(p);\n  }\n  \n  update(dt) {\n    for (let i = this.particles.length - 1; i >= 0; i--) {\n      const p = this.particles[i];\n      if (!p.update(dt)) {\n        this.pool.release(p);\n        this.particles.splice(i, 1);\n      }\n    }\n  }\n  \n  draw(ctx, cam) {\n    this.particles.forEach(p => p.draw(ctx, cam));\n  }\n  \n  clear() {\n    this.particles.forEach(p => this.pool.release(p));\n    this.particles.length = 0;\n  }\n}\n\n// --- TRAIL SYSTEM ---\nclass TrailSegment {\n  id = '';\n  start = new Vec2();\n  end = new Vec2();\n  prevStart = new Vec2();\n  prevEnd = new Vec2();\n  width = 8;\n  color = '#00ffff';\n  glowColor = '#00ffff';\n  life = 0;\n  maxLife = 5;\n  active = false;\n  weaponType = 'ballpoint';\n  damage = 10;\n  \n  reset() { this.active = false; this.life = 0; }\n  \n  update(dt) {\n    if (!this.active) return false;\n    this.life += dt;\n    if (this.life >= this.maxLife) { this.active = false; return false; }\n    this.prevStart.copy(this.start);\n    this.prevEnd.copy(this.end);\n    return true;\n  }\n  \n  getT() { return this.life / this.maxLife; }\n  \n  draw(ctx, cam, colorBlindMode) {\n    if (!this.active) return;\n    const t = this.getT();\n    const alpha = 1 - t * t;\n    const w = this.width * (1 - t * 0.5);\n    \n    const c = applyColorBlind(this.color, colorBlindMode);\n    const gc = applyColorBlind(this.glowColor, colorBlindMode);\n    \n    // Glow\n    ctx.save();\n    ctx.globalAlpha = alpha * 0.3;\n    ctx.strokeStyle = gc;\n    ctx.lineWidth = w * 2.5;\n    ctx.lineCap = 'round';\n    ctx.shadowColor = gc;\n    ctx.shadowBlur = 15;\n    ctx.beginPath();\n    ctx.moveTo(this.start.x - cam.x, this.start.y - cam.y);\n    ctx.lineTo(this.end.x - cam.x, this.end.y - cam.y);\n    ctx.stroke();\n    ctx.restore();\n    \n    // Core\n    ctx.globalAlpha = alpha;\n    ctx.strokeStyle = c;\n    ctx.lineWidth = w;\n    ctx.lineCap = 'round';\n    ctx.beginPath();\n    ctx.moveTo(this.start.x - cam.x, this.start.y - cam.y);\n    ctx.lineTo(this.end.x - cam.x, this.end.y - cam.y);\n    ctx.stroke();\n    ctx.globalAlpha = 1;\n  }\n}\n\nclass TrailSystem {\n  pool: Pool<TrailSegment>;\n  segments: TrailSegment[] = [];\n  \n  constructor() {\n    this.pool = new Pool(() => new TrailSegment(), s => s.reset(), 128);\n  }\n  \n  addSegment(start: Vec2, end: Vec2, width: number, color: string, glowColor: string, life: number, weaponType: string, damage: number) {\n    const seg = this.pool.acquire();\n    seg.id = uuid();\n    seg.start.copy(start);\n    seg.end.copy(end);\n    seg.prevStart.copy(start);\n    seg.prevEnd.copy(end);\n    seg.width = width;\n    seg.color = color;\n    seg.glowColor = glowColor;\n    seg.maxLife = life;\n    seg.life = 0;\n    seg.weaponType = weaponType;\n    seg.damage = damage;\n    seg.active = true;\n    this.segments.push(seg);\n    return seg;\n  }\n  \n  update(dt) {\n    for (let i = this.segments.length - 1; i >= 0; i--) {\n      const s = this.segments[i];\n      if (!s.update(dt)) {\n        this.pool.release(s);\n        this.segments.splice(i, 1);\n      }\n    }\n  }\n  \n  draw(ctx, cam, colorBlindMode) {\n    this.segments.forEach(s => s.draw(ctx, cam, colorBlindMode));\n  }\n  \n  clear() {\n    this.segments.forEach(s => this.pool.release(s));\n    this.segments.length = 0;\n  }\n}\n\n// --- ENTITY BASE ---\nclass Entity {\n  id = '';\n  pos = new Vec2();\n  vel = new Vec2();\n  radius = 16;\n  hp = 1;\n  maxHp = 1;\n  active = true;\n  kind = 'entity';\n  \n  constructor() { this.id = uuid(); }\n  \n  takeDamage(amount) { this.hp -= amount; if (this.hp <= 0) this.active = false; }\n  \n  update(dt) {}\n  \n  draw(ctx, cam, colorBlindMode) {}\n}\n\n// --- PLAYER ---\nclass Player extends Entity {\n  radius = 14;\n  hp = 3;\n  maxHp = 3;\n  invuln = 0;\n  ink = 100;\n  maxInk = 100;\n  inkRegen = 15;\n  inkCost = 8;\n  weapon = 'ballpoint';\n  weaponLevel = 1;\n  fireCooldown = 0;\n  fireRate = 0.12;\n  speed = 280;\n  dashCooldown = 0;\n  dashDuration = 0;\n  dashSpeed = 600;\n  trailWidth = 8;\n  trailLife = 4;\n  trailDamage = 12;\n  combo = 1;\n  comboTimer = 0;\n  score = 0;\n  wave = 1;\n  time = 0;\n  maxCombo = 1;\n  upgrades = {\n    fireRate: 0,\n    inkEfficiency: 0,\n    inkRegen: 0,\n    trailWidth: 0,\n    trailLife: 0,\n    trailDamage: 0,\n    speed: 0,\n    hp: 0,\n    dashCooldown: 0,\n    projectileSpeed: 0,\n    projectileDamage: 0,\n    projectilePierce: 0,\n    inkOnKill: 0,\n    hpOnKill: 0,\n    comboTime: 0,\n    scoreMult: 0\n  };\n  \n  constructor() {\n    super();\n    this.kind = 'player';\n    this.pos.set(0, 0);\n    this.vel.set(0, 0);\n  }\n  \n  applyUpgrades() {\n    const u = this.upgrades;\n    this.fireRate = 0.12 * Math.pow(0.85, u.fireRate);\n    this.inkCost = 8 * Math.pow(0.9, u.inkEfficiency);\n    this.inkRegen = 15 + u.inkRegen * 3;\n    this.trailWidth = 8 + u.trailWidth * 2;\n    this.trailLife = 4 + u.trailLife * 0.8;\n    this.trailDamage = 12 + u.trailDamage * 3;\n    this.speed = 280 + u.speed * 15;\n    this.maxHp = 3 + u.hp;\n    this.hp = Math.min(this.hp, this.maxHp);\n    this.dashCooldown = Math.max(0.4, 1.2 - u.dashCooldown * 0.15);\n  }\n  \n  update(dt, input, trailSys, particleSys, spatialGrid, audio, colorBlindMode) {\n    this.time += dt;\n    \n    // Invulnerability\n    if (this.invuln > 0) this.invuln -= dt;\n    \n    // Combo decay\n    if (this.comboTimer > 0) {\n      this.comboTimer -= dt;\n      if (this.comboTimer <= 0) this.combo = 1;\n    }\n    \n    // Ink regen\n    this.ink = Math.min(this.maxInk, this.ink + this.inkRegen * dt);\n    \n    // Dash\n    if (this.dashDuration > 0) {\n      this.dashDuration -= dt;\n      if (this.dashDuration <= 0) this.vel.scale(0.3);\n    }\n    if (this.dashCooldown > 0) this.dashCooldown -= dt;\n    \n    // Movement\n    if (this.dashDuration <= 0) {\n      this.vel.set(0, 0);\n      if (input.up) this.vel.y -= 1;\n      if (input.down) this.vel.y += 1;\n      if (input.left) this.vel.x -= 1;\n      if (input.right) this.vel.x += 1;\n      this.vel.normalize().scale(this.speed);\n    }\n    \n    this.pos.add(this.vel.clone().scale(dt));\n    \n    // World bounds\n    const bound = 2000;\n    this.pos.x = clamp(this.pos.x, -bound, bound);\n    this.pos.y = clamp(this.pos.y, -bound, bound);\n    \n    // Trail behind player\n    if (this.vel.length2() > 100) {\n      const back = this.vel.clone().normalize().scale(-this.radius);\n      const trailStart = this.pos.clone().add(back);\n      const trailEnd = this.pos.clone().sub(this.vel.clone().normalize().scale(this.speed * dt * 0.5)).add(back);\n      const w = this.trailWidth;\n      const weaponColors = PALETTE.weapons[this.weapon];\n      trailSys.addSegment(trailStart, trailEnd, w, weaponColors.main, weaponColors.glow, this.trailLife, this.weapon, this.trailDamage);\n      \n      // Trail particles\n      if (Math.random() < 0.3) {\n        particleSys.emitTrail(this.pos.x + back.x, this.pos.y + back.y, weaponColors.main, w * 0.5);\n      }\n    }\n    \n    // Shooting\n    if (this.fireCooldown > 0) this.fireCooldown -= dt;\n    const aimDir = new Vec2(input.aimX, input.aimY);\n    if (aimDir.length() > 0.1 && this.fireCooldown <= 0 && this.ink >= this.inkCost) {\n      this.fireCooldown = this.fireRate;\n      this.ink -= this.inkCost;\n      this.shoot(aimDir.normalize(), trailSys, particleSys, audio);\n    }\n    \n    // Dash input\n    if (input.dash && this.dashCooldown <= 0 && this.dashDuration <= 0) {\n      this.dashCooldown = 1.2 - this.upgrades.dashCooldown * 0.15;\n      this.dashDuration = 0.15;\n      const dashDir = this.vel.length() > 0 ? this.vel.clone().normalize() : aimDir.normalize();\n      this.vel.set(dashDir.x * this.dashSpeed, dashDir.y * this.dashSpeed);\n      this.invuln = 0.2;\n      audio.playShoot(this.ink / this.maxInk);\n      particleSys.emitRing(this.pos.x, this.pos.y, 12, PALETTE.weapons[this.weapon].main, 0, 200, 0.3, 4);\n    }\n    \n    spatialGrid.update(this.id, this.pos);\n  }\n  \n  shoot(dir: Vec2, trailSys, particleSys, audio) {\n    const weaponColors = PALETTE.weapons[this.weapon];\n    const projSpeed = 600 + this.upgrades.projectileSpeed * 50;\n    const projDamage = 15 + this.upgrades.projectileDamage * 5;\n    const pierce = this.upgrades.projectilePierce;\n    \n    // Create projectile trail segment (instant line)\n    const start = this.pos.clone().add(dir.clone().scale(this.radius));\n    const end = start.clone().add(dir.clone().scale(projSpeed * 0.8));\n    trailSys.addSegment(start, end, 4, weaponColors.main, weaponColors.glow, 0.3, this.weapon, projDamage);\n    \n    // Muzzle flash particles\n    particleSys.emitRing(start.x, start.y, 8, weaponColors.main, 4, 150, 0.2, 3);\n    \n    audio.playShoot(this.ink / this.maxInk);\n    \n    // Store projectile for collision (simplified as instant ray)\n    // We'll handle collision in game loop via raycast\n    return { start, end, damage: projDamage, pierce, weapon: this.weapon };\n  }\n  \n  draw(ctx, cam, colorBlindMode) {\n    const x = this.pos.x - cam.x;\n    const y = this.pos.y - cam.y;\n    \n    // Invulnerability flash\n    if (this.invuln > 0 && Math.floor(this.invuln * 20) % 2 === 0) {\n      ctx.globalAlpha = 0.5;\n    }\n    \n    // Body glow\n    ctx.save();\n    ctx.shadowColor = applyColorBlind(PALETTE.playerTrim, colorBlindMode);\n    ctx.shadowBlur = 20;\n    ctx.fillStyle = applyColorBlind(PALETTE.playerCore, colorBlindMode);\n    ctx.beginPath();\n    ctx.arc(x, y, this.radius, 0, PI2);\n    ctx.fill();\n    ctx.restore();\n    \n    // Core\n    ctx.fillStyle = applyColorBlind(PALETTE.playerCore, colorBlindMode);\n    ctx.beginPath();\n    ctx.arc(x, y, this.radius * 0.6, 0, PI2);\n    ctx.fill();\n    \n    // Weapon indicator ring\n    const weaponColors = PALETTE.weapons[this.weapon];\n    ctx.strokeStyle = applyColorBlind(weaponColors.main, colorBlindMode);\n    ctx.lineWidth = 2;\n    ctx.beginPath();\n    ctx.arc(x, y, this.radius + 4, 0, PI2);\n    ctx.stroke();\n    \n    // Dash indicator\n    if (this.dashCooldown <= 0) {\n      ctx.strokeStyle = applyColorBlind('#ffff00', colorBlindMode);\n      ctx.lineWidth = 1;\n      ctx.setLineDash([4, 4]);\n      ctx.beginPath();\n      ctx.arc(x, y, this.radius + 8, 0, PI2);\n      ctx.stroke();\n      ctx.setLineDash([]);\n    }\n    \n    ctx.globalAlpha = 1;\n  }\n}\n\n// --- ENEMY TYPES ---\nconst ENEMY_TYPES = {\n  drifter: { hp: 1, speed: 60, radius: 16, score: 10, color: PALETTE.enemy, elite: false },\n  seeker: { hp: 2, speed: 100, radius: 14, score: 25, color: PALETTE.enemy, elite: false },\n  charger: { hp: 4, speed: 50, radius: 20, score: 50, color: PALETTE.enemy, elite: false, chargeSpeed: 300 },\n  splitter: { hp: 3, speed: 70, radius: 18, score: 40, color: PALETTE.enemy, elite: false, splits: 3 },\n  voidWalker: { hp: 6, speed: 80, radius: 22, score: 100, color: { body: '#000000', rim: '#ff00ff' }, elite: true },\n  inkEater: { hp: 8, speed: 90, radius: 24, score: 150, color: { body: '#1a001a', rim: '#ff00aa' }, elite: true, inkDrain: 10 }\n};\n\nclass Enemy extends Entity {\n  type = 'drifter';\n  chargeTimer = 0;\n  chargeState = 0; // 0=idle, 1=charging, 2=charging\n  targetAngle = 0;\n  \n  constructor(typeName) {\n    super();\n    this.kind = 'enemy';\n    this.type = typeName;\n    const def = ENEMY_TYPES[typeName];\n    this.hp = def.hp;\n    this.maxHp = def.hp;\n    this.radius = def.radius;\n    this.speed = def.speed;\n    this.scoreValue = def.score;\n    this.color = def.color;\n    this.isElite = def.elite;\n    this.chargeSpeed = def.chargeSpeed || 0;\n    this.splits = def.splits || 0;\n    this.inkDrain = def.inkDrain || 0;\n  }\n  \n  update(dt, player, spatialGrid) {\n    if (!this.active) return;\n    \n    const def = ENEMY_TYPES[this.type];\n    const toPlayer = new Vec2(player.pos.x - this.pos.x, player.pos.y - this.pos.y);\n    const dist = toPlayer.length();\n    \n    if (this.type === 'charger') {\n      this.chargeTimer -= dt;\n      if (this.chargeState === 0) {\n        // Wander\n        this.targetAngle += rand(-1, 1) * dt;\n        this.vel.set(Math.cos(this.targetAngle), Math.sin(this.targetAngle)).scale(this.speed * 0.5);\n        if (dist < 400 && this.chargeTimer <= 0) {\n          this.chargeState = 1;\n          this.chargeTimer = 1.5;\n        }\n      } else if (this.chargeState === 1) {\n        // Telegraph\n        this.vel.scale(0.95);\n        if (this.chargeTimer <= 0) {\n          this.chargeState = 2;\n          this.chargeTimer = 0.8;\n          this.targetAngle = toPlayer.angle();\n        }\n      } else {\n        // Charge\n        this.vel.set(Math.cos(this.targetAngle), Math.sin(this.targetAngle)).scale(this.chargeSpeed);\n        if (this.chargeTimer <= 0) {\n          this.chargeState = 0;\n          this.chargeTimer = rand(2, 4);\n        }\n      }\n    } else if (this.type === 'voidWalker') {\n      // Teleport occasionally\n      if (dist < 300 && Math.random() < dt * 0.5) {\n        const ang = rand(0, PI2);\n        const teleportDist = 200;\n        this.pos.set(player.pos.x + Math.cos(ang) * teleportDist, player.pos.y + Math.sin(ang) * teleportDist);\n      }\n      toPlayer.normalize().scale(this.speed);\n      this.vel.copy(toPlayer);\n    } else if (this.type === 'inkEater') {\n      toPlayer.normalize().scale(this.speed);\n      this.vel.copy(toPlayer);\n    } else {\n      // Basic seek\n      toPlayer.normalize().scale(this.speed);\n      this.vel.copy(toPlayer);\n    }\n    \n    this.pos.add(this.vel.clone().scale(dt));\n    spatialGrid.update(this.id, this.pos);\n  }\n  \n  draw(ctx, cam, colorBlindMode) {\n    const x = this.pos.x - cam.x;\n    const y = this.pos.y - cam.y;\n    \n    // Body\n    ctx.fillStyle = applyColorBlind(this.color.body, colorBlindMode);\n    ctx.beginPath();\n    ctx.arc(x, y, this.radius, 0, PI2);\n    ctx.fill();\n    \n    // Rim\n    ctx.strokeStyle = applyColorBlind(this.color.rim, colorBlindMode);\n    ctx.lineWidth = this.isElite ? 3 : 2;\n    ctx.beginPath();\n    ctx.arc(x, y, this.radius, 0, PI2);\n    ctx.stroke();\n    \n    // Elite marker\n    if (this.isElite) {\n      ctx.fillStyle = applyColorBlind(this.color.rim, colorBlindMode);\n      ctx.font = '12px monospace';\n      ctx.textAlign = 'center';\n      ctx.textBaseline = 'middle';\n      ctx.fillText('★', x, y + 4);\n    }\n    \n    // HP bar\n    if (this.hp < this.maxHp) {\n      const bw = this.radius * 2;\n      const bh = 4;\n      const bx = x - bw / 2;\n      const by = y - this.radius - 8;\n      ctx.fillStyle = applyColorBlind(PALETTE.hpEmpty, colorBlindMode);\n      ctx.fillRect(bx, by, bw, bh);\n      ctx.fillStyle = applyColorBlind(PALETTE.hpFull, colorBlindMode);\n      ctx.fillRect(bx, by, bw * (this.hp / this.maxHp), bh);\n    }\n    \n    // Charge indicator\n    if (this.type === 'charger' && this.chargeState === 1) {\n      ctx.strokeStyle = applyColorBlind('#ffff00', colorBlindMode);\n      ctx.lineWidth = 2;\n      ctx.setLineDash([4, 4]);\n      ctx.beginPath();\n      ctx.arc(x, y, this.radius + 8, 0, PI2);\n      ctx.stroke();\n      ctx.setLineDash([]);\n    }\n  }\n}\n\n// --- WAVE MANAGER ---\nclass WaveManager {\n  wave = 1;\n  spawnTimer = 0;\n  enemiesPerWave = 5;\n  maxEnemies = 30;\n  eliteChance = 0;\n  spawnQueue: string[] = [];\n  \n  nextWave() {\n    this.wave++;\n    this.enemiesPerWave = Math.min(5 + this.wave * 2, 50);\n    this.maxEnemies = Math.min(30 + this.wave * 3, 100);\n    this.eliteChance = Math.min(0.05 + this.wave * 0.01, 0.3);\n    this.generateQueue();\n  }\n  \n  generateQueue() {\n    this.spawnQueue = [];\n    const types = ['drifter', 'seeker', 'charger', 'splitter'];\n    const eliteTypes = ['voidWalker', 'inkEater'];\n    \n    for (let i = 0; i < this.enemiesPerWave; i++) {\n      if (Math.random() < this.eliteChance && this.wave >= 3) {\n        this.spawnQueue.push(eliteTypes[randInt(0, eliteTypes.length - 1)]);\n      } else {\n        this.spawnQueue.push(types[randInt(0,