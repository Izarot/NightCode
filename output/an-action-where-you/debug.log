   width: 100%;\n      height: 100%;\n      touch-action: none;\n    }\n\n    /* ---------- Scanlines / CRT flavor ---------- */\n    #scanlines {\n      position: absolute;\n      inset: 0;\n      pointer-events: none;\n      z-index: 5;\n      opacity: 0.16;\n      background: repeating-linear-gradient(\n        to bottom,\n        rgba(255,255,255,0.06) 0px,\n        rgba(255,255,255,0.06) 1px,\n        transparent 1px,\n        transparent 3px\n      );\n      mix-blend-mode: overlay;\n    }\n\n    /* ---------- Overlays ---------- */\n    .overlay {\n      position: absolute;\n      inset: 0;\n      z-index: 20;\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      justify-content: center;\n      padding: 24px;\n      text-align: center;\n      background: radial-gradient(circle at 50% 45%, rgba(0, 243, 255, 0.07), rgba(0,0,0,0.72) 62%, rgba(0,0,0,0.9));\n      backdrop-filter: blur(2px);\n      transition: opacity 220ms ease;\n    }\n\n    .overlay.hidden {\n      opacity: 0;\n      pointer-events: none;\n    }\n\n    .overlay-card {\n      width: min(560px, 92vw);\n      padding: clamp(20px, 4vw, 40px);\n      border: 1px solid rgba(0, 243, 255, 0.35);\n      background: linear-gradient(160deg, rgba(8, 14, 24, 0.94), rgba(14, 4, 8, 0.94));\n      box-shadow:\n        0 0 0 1px rgba(255,255,255,0.04) inset,\n        0 0 40px rgba(0, 243, 255, 0.18),\n        0 0 90px rgba(255, 26, 26, 0.12);\n      clip-path: polygon(0 14px, 14px 0, calc(100% - 14px) 0, 100% 14px, 100% calc(100% - 14px), calc(100% - 14px) 100%, 14px 100%, 0 calc(100% - 14px));\n    }\n\n    .title {\n      margin: 0;\n      font-size: clamp(34px, 9vw, 68px);\n      font-weight: 900;\n      letter-spacing: 0.14em;\n      line-height: 1;\n      color: #fff;\n      text-shadow:\n        0 0 6px rgba(0, 243, 255, 0.9),\n        0 0 22px rgba(0, 243, 255, 0.55),\n        0 0 48px rgba(191, 0, 255, 0.45);\n      animation: titlePulse 3.2s ease-in-out infinite;\n    }\n\n    @keyframes titlePulse {\n      0%, 100% { text-shadow: 0 0 6px rgba(0,243,255,0.9), 0 0 22px rgba(0,243,255,0.5), 0 0 48px rgba(191,0,255,0.4); }\n      50%      { text-shadow: 0 0 10px rgba(0,243,255,1), 0 0 34px rgba(0,243,255,0.75), 0 0 70px rgba(191,0,255,0.6); }\n    }\n\n    .subtitle {\n      margin: 14px 0 0;\n      font-size: clamp(11px, 2.6vw, 15px);\n      letter-spacing: 0.28em;\n      text-transform: uppercase;\n      color: var(--muted);\n      opacity: 0.9;\n    }\n\n    .divider {\n      height: 1px;\n      margin: 22px 0;\n      background: linear-gradient(90deg, transparent, rgba(0,243,255,0.7), rgba(255,26,26,0.7), transparent);\n    }\n\n    .instructions {\n      display: grid;\n      grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));\n      gap: 10px 18px;\n      margin: 0 0 24px;\n      font-size: clamp(10px, 2.4vw, 13px);\n      letter-spacing: 0.08em;\n      color: #cfefff;\n      text-align: left;\n    }\n\n    .instructions div { display: flex; align-items: center; gap: 8px; }\n    .key {\n      display: inline-flex;\n      align-items: center;\n      justify-content: center;\n      min-width: 26px;\n      height: 24px;\n      padding: 0 7px;\n      border: 1px solid rgba(0,243,255,0.55);\n      border-radius: 4px;\n      font-size: 11px;\n      color: var(--cyan);\n      background: rgba(0,243,255,0.07);\n      box-shadow: 0 0 10px rgba(0,243,255,0.18);\n    }\n\n    .btn {\n      position: relative;\n      appearance: none;\n      cursor: pointer;\n      width: 100%;\n      margin-top: 10px;\n      padding: 15px 22px;\n      font-family: inherit;\n      font-size: clamp(13px, 3vw, 16px);\n      font-weight: 700;\n      letter-spacing: 0.22em;\n      text-transform: uppercase;\n      color: #eaffff;\n      background: linear-gradient(180deg, rgba(0,243,255,0.16), rgba(0,243,255,0.04));\n      border: 1px solid rgba(0,243,255,0.7);\n      clip-path: polygon(0 10px, 10px 0, 100% 0, 100% calc(100% - 10px), calc(100% - 10px) 100%, 0 100%);\n      box-shadow: 0 0 18px rgba(0,243,255,0.25), inset 0 0 18px rgba(0,243,255,0.08);\n      transition: transform 120ms ease, box-shadow 180ms ease, background 180ms ease, color 180ms ease;\n    }\n\n    .btn:hover, .btn:focus-visible {\n      outline: none;\n      color: #001417;\n      background: linear-gradient(180deg, #7ffaff, #00f3ff);\n      box-shadow: 0 0 30px rgba(0,243,255,0.75), 0 0 70px rgba(0,243,255,0.35);\n      transform: translateY(-1px);\n    }\n\n    .btn:active { transform: translateY(1px) scale(0.995); }\n\n    .btn.ghost {\n      color: #ffd7d7;\n      border-color: rgba(255,26,26,0.6);\n      background: linear-gradient(180deg, rgba(255,26,26,0.14), rgba(255,26,26,0.03));\n      box-shadow: 0 0 18px rgba(255,26,26,0.2);\n    }\n\n    .btn.ghost:hover, .btn.ghost:focus-visible {\n      color: #1a0000;\n      background: linear-gradient(180deg, #ff8a8a, #ff1a1a);\n      box-shadow: 0 0 30px rgba(255,26,26,0.7);\n    }\n\n    .btn-row { display: flex; gap: 10px; flex-wrap: wrap; }\n    .btn-row .btn { flex: 1 1 140px; }\n\n    /* ---------- Game over stats ---------- */\n    .stats {\n      display: grid;\n      grid-template-columns: repeat(3, 1fr);\n      gap: 10px;\n      margin: 6px 0 20px;\n    }\n\n    .stat {\n      padding: 12px 8px;\n      border: 1px solid rgba(255,255,255,0.1);\n      background: rgba(255,255,255,0.03);\n    }\n\n    .stat .label {\n      display: block;\n      font-size: 9px;\n      letter-spacing: 0.2em;\n      color: #8fb9c9;\n      text-transform: uppercase;\n      margin-bottom: 6px;\n    }\n\n    .stat .value {\n      font-size: clamp(16px, 4.4vw, 24px);\n      font-weight: 700;\n      color: #fff;\n      text-shadow: 0 0 12px rgba(0,243,255,0.5);\n    }\n\n    .record {\n      margin: 0 0 16px;\n      font-size: clamp(11px, 2.8vw, 14px);\n      letter-spacing: 0.2em;\n      color: var(--amber);\n      text-transform: uppercase;\n      min-height: 18px;\n    }\n\n    .record.flash { animation: recordFlash 900ms ease-in-out infinite alternate; }\n\n    @keyframes recordFlash {\n      from { text-shadow: 0 0 6px rgba(255,179,0,0.6); color: #ffd98a; }\n      to   { text-shadow: 0 0 22px rgba(255,179,0,1), 0 0 44px rgba(255,26,26,0.8); color: #fff; }\n    }\n\n    .gameover-title {\n      margin: 0;\n      font-size: clamp(28px, 7.5vw, 52px);\n      font-weight: 900;\n      letter-spacing: 0.12em;\n      color: #fff;\n      text-shadow: 0 0 10px rgba(255,26,26,0.95), 0 0 34px rgba(255,26,26,0.6), 0 0 70px rgba(120,0,0,0.8);\n    }\n\n    /* ---------- Top bar (speedrun timer + high score) ---------- */\n    #topbar {\n      position: absolute;\n      top: 0;\n      left: 0;\n      right: 0;\n      z-index: 12;\n      display: flex;\n      justify-content: space-between;\n      align-items: flex-start;\n      gap: 8px;\n      padding: max(10px, env(safe-area-inset-top)) 14px 0;\n      pointer-events: none;\n      font-size: clamp(10px, 2.6vw, 13px);\n      letter-spacing: 0.16em;\n    }\n\n    .chip {\n      display: flex;\n      align-items: center;\n      gap: 8px;\n      padding: 7px 12px;\n      border: 1px solid rgba(0,243,255,0.28);\n      background: rgba(4, 10, 16, 0.62);\n      clip-path: polygon(0 8px, 8px 0, 100% 0, 100% calc(100% - 8px), calc(100% - 8px) 100%, 0 100%);\n      box-shadow: 0 0 16px rgba(0,243,255,0.12);\n      backdrop-filter: blur(4px);\n    }\n\n    .chip .tag { color: #7fd8e8; font-size: 9px; letter-spacing: 0.24em; }\n    .chip .num { color: #fff; font-weight: 700; font-variant-numeric: tabular-nums; }\n\n    #timerChip .num { color: var(--cyan); text-shadow: 0 0 10px rgba(0,243,255,0.7); }\n    #timerChip.warn .num { color: var(--amber); text-shadow: 0 0 12px rgba(255,179,0,0.85); }\n    #timerChip.danger .num { color: var(--crimson); text-shadow: 0 0 14px rgba(255,26,26,0.9); }\n\n    /* ---------- Mobile controls ---------- */\n    #touchControls {\n      position: absolute;\n      left: 0;\n      right: 0;\n      bottom: 0;\n      height: 42%;\n      z-index: 14;\n      display: none;\n      pointer-events: none;\n    }\n\n    #touchControls .pad {\n      position: absolute;\n      bottom: max(18px, env(safe-area-inset-bottom));\n      width: 34%;\n      max-width: 190px;\n      aspect-ratio: 1 / 1;\n      border-radius: 50%;\n      border: 2px solid rgba(0,243,255,0.4);\n      background: radial-gradient(circle, rgba(0,243,255,0.16), rgba(0,243,255,0.02) 70%);\n      box-shadow: 0 0 26px rgba(0,243,255,0.22), inset 0 0 26px rgba(0,243,255,0.12);\n      opacity: 0.4;\n      pointer-events: auto;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      font-size: clamp(22px, 7vw, 34px);\n      color: rgba(0,243,255,0.85);\n      user-select: none;\n      transition: opacity 120ms ease, transform 120ms ease, box-shadow 120ms ease;\n    }\n\n    #touchControls .pad.active {\n      opacity: 0.85;\n      transform: scale(0.96);\n      box-shadow: 0 0 40px rgba(0,243,255,0.6), inset 0 0 34px rgba(0,243,255,0.3);\n    }\n\n    #padLeft  { left: max(14px, env(safe-area-inset-left)); }\n    #padRight { right: max(14px, env(safe-area-inset-right)); }\n\n    body.touch #touchControls { display: block; }\n\n    /* ---------- Utility buttons ---------- */\n    #utility {\n      position: absolute;\n      right: 12px;\n      bottom: max(12px, env(safe-area-inset-bottom));\n      z-index: 16;\n      display: flex;\n      gap: 8px;\n    }\n\n    .icon-btn {\n      width: 40px;\n      height: 40px;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      font-size: 16px;\n      color: #bff6ff;\n      background: rgba(4, 10, 16, 0.7);\n      border: 1px solid rgba(0,243,255,0.3);\n      border-radius: 8px;\n      cursor: pointer;\n      transition: background 150ms ease, box-shadow 150ms ease, color 150ms ease;\n    }\n\n    .icon-btn:hover, .icon-btn:focus-visible {\n      outline: none;\n      color: #001417;\n      background: var(--cyan);\n      box-shadow: 0 0 22px rgba(0,243,255,0.7);\n    }\n\n    .sr-only {\n      position: absolute;\n      width: 1px; height: 1px;\n      padding: 0; margin: -1px;\n      overflow: hidden;\n      clip: rect(0,0,0,0);\n      white-space: nowrap;\n      border: 0;\n    }\n\n    @media (max-width: 520px) {\n      .stats { grid-template-columns: 1fr; }\n      .stat { display: flex; justify-content: space-between; align-items: center; padding: 9px 12px; }\n      .stat .label { margin: 0; }\n      .instructions { grid-template-columns: 1fr; }\n    }\n\n    @media (prefers-reduced-motion: reduce) {\n      .title { animation: none; }\n      .record.flash { animation: none; color: #fff; }\n    }\n  </style>\n</head>\n<body>\n  <main id=\"stage\">\n    <canvas id=\"game\" aria-label=\"Blade Reflex game canvas\" role=\"img\"></canvas>\n    <div id=\"scanlines\" aria-hidden=\"true\"></div>\n\n    <!-- Speedrun timer + persistent high score -->\n    <div id=\"topbar\">\n      <div class=\"chip\" id=\"timerChip\">\n        <span class=\"tag\">RUN</span>\n        <span class=\"num\" id=\"runTimer\">00:00.0</span>\n      </div>\n      <div class=\"chip\" id=\"bestChip\">\n        <span class=\"tag\">BEST</span>\n        <span class=\"num\" id=\"bestScore\">0</span>\n      </div>\n    </div>\n\n    <!-- Mobile virtual pads -->\n    <div id=\"touchControls\" aria-hidden=\"true\">\n      <div class=\"pad\" id=\"padLeft\">◀</div>\n      <div class=\"pad\" id=\"padRight\">▶</div>\n    </div>\n\n    <!-- Utility -->\n    <div id=\"utility\">\n      <button class=\"icon-btn\" id=\"soundBtn\" type=\"button\" aria-label=\"Toggle sound\" title=\"Toggle sound (M)\">🔊</button>\n      <button class=\"icon-btn\" id=\"pauseBtn\" type=\"button\" aria-label=\"Pause game\" title=\"Pause (P)\">⏸</button>\n    </div>\n\n    <!-- START SCREEN -->\n    <section class=\"overlay\" id=\"menuScreen\">\n      <div class=\"overlay-card\">\n        <h1 class=\"title\">BLADE REFLEX</h1>\n        <p class=\"subtitle\">Survive the cascade. Move to dodge.</p>\n        <div class=\"divider\"></div>\n        <div class=\"instructions\">\n          <div><span class=\"key\">◀</span><span class=\"key\">▶</span> / <span class=\"key\">A</span><span class=\"key\">D</span> Move</div>\n          <div><span class=\"key\">P</span> Pause</div>\n          <div><span class=\"key\">M</span> Mute</div>\n          <div><span class=\"key\">R</span> Restart</div>\n        </div>\n        <button class=\"btn\" id=\"startBtn\" type=\"button\">Start Run</button>\n        <p class=\"subtitle\" style=\"margin-top:16px; font-size:10px; letter-spacing:0.18em;\">3 shields · dodge knives · chain 10 for combo bonus</p>\n      </div>\n    </section>\n\n    <!-- PAUSE SCREEN -->\n    <section class=\"overlay hidden\" id=\"pauseScreen\">\n      <div class=\"overlay-card\">\n        <h2 class=\"gameover-title\" style=\"text-shadow:0 0 10px rgba(0,243,255,0.9),0 0 34px rgba(0,243,255,0.5);\">PAUSED</h2>\n        <p class=\"subtitle\">Signal held. The knives are waiting.</p>\n        <div class=\"divider\"></div>\n        <div class=\"btn-row\">\n          <button class=\"btn\" id=\"resumeBtn\" type=\"button\">Resume</button>\n          <button class=\"btn ghost\" id=\"restartBtn\" type=\"button\">Restart</button>\n        </div>\n        <button class=\"btn ghost\" id=\"exitBtn\" type=\"button\" style=\"margin-top:10px;\">Exit to Menu</button>\n      </div>\n    </section>\n\n    <!-- GAME OVER SCREEN -->\n    <section class=\"overlay hidden\" id=\"overScreen\">\n      <div class=\"overlay-card\">\n        <h2 class=\"gameover-title\">YOU WERE SPLIT</h2>\n        <p class=\"subtitle\" id=\"overSubtitle\">The cascade claims another.</p>\n        <div class=\"divider\" style=\"margin:16px 0;\"></div>\n        <div class=\"stats\">\n          <div class=\"stat\"><span class=\"label\">Score</span><span class=\"value\" id=\"finalScore\">0</span></div>\n          <div class=\"stat\"><span class=\"label\">Max Streak</span><span class=\"value\" id=\"finalStreak\">0</span></div>\n          <div class=\"stat\"><span class=\"label\">Survived</span><span class=\"value\" id=\"finalTime\">00:00</span></div>\n        </div>\n        <p class=\"record\" id=\"recordLine\">BEST 0</p>\n        <div class=\"btn-row\">\n          <button class=\"btn\" id=\"retryBtn\" type=\"button\">Retry</button>\n          <button class=\"btn ghost\" id=\"menuBtn\" type=\"button\">Menu</button>\n        </div>\n      </div>\n    </section>\n\n    <p class=\"sr-only\" id=\"liveRegion\" aria-live=\"polite\"></p>\n  </main>\n\n  <script src=\"game.js\"></script>\n</body>\n</html>\n", "game.js": "/* ============================================================================\n * BLADE REFLEX — Neon Dodge 'em Up\n * Single-file HTML5 Canvas game engine (no build step required).\n * ----------------------------------------------------------------------------\n * Architecture mirrors the GTS: core (state machine, physics, input, audio,\n * utils), game (player, knives, collision, scoring, particles, object pools)\n * and ui (HUD, menus, overlays, responsive touch controls).\n * ========================================================================== */\n(function () {\n  'use strict';\n\n  /* ==========================================================================\n   * 0. CONSTANTS & PALETTE\n   * ======================================================================== */\n  const PALETTE = {\n    void:      '#050505',\n    voidDeep:  '#1a0505',\n    cyan:      '#00f3ff',\n    cyanSoft:  'rgba(0, 243, 255, 0.55)',\n    violet:    '#bf00ff',\n    lime:      '#b6ff00',\n    crimson:   '#ff1a1a',\n    crimsonDk: '#7a0000',\n    amber:     '#ffb300',\n    white:     '#ffffff',\n    steel:     '#c9d6e2',\n    steelDk:   '#5a6673',\n    rust:      '#8a3b2a',\n    muted:     '#55ffff'\n  };\n\n  const CFG = {\n    // Player physics (GTS §2.1)\n    accel: 0.8,\n    friction: 0.85,\n    maxSpeed: 13,\n    minSpeedThreshold: 0.1,\n    playerW: 32,\n    playerH: 64,\n    playerHalfW: 16,\n    playerHalfH: 32,\n    playerBottomPad: 100,\n\n    // Health / damage (GTS §1.3)\n    maxHP: 3,\n    iFrames: 1.5,          // seconds\n\n    // Spawning (GTS §1.2)\n    spawnStart: 1200,      // ms\n    spawnMin: 150,         // ms\n    spawnStepEvery: 10000, // ms\n    spawnStepAmount: 100,  // ms\n    spawnEdgePad: 50,      // px\n\n    // Scoring (GTS §1.4)\n    dodgePoints: 10,\n    comboEvery: 10,\n    comboBonus: 50,\n    timeScorePer: 100,     // ms -> +1\n\n    // Feel\n    nearMissDist: 15,\n    maxParticles: 420,\n    maxKnives: 90\n  };\n\n  const STORAGE_KEY = 'bladeReflex.highScore.v1';\n  const STORAGE_MUTE = 'bladeReflex.muted.v1';\n\n  /* ==========================================================================\n   * 1. UTILITIES\n   * ======================================================================== */\n  const U = {\n    rand: (a, b) => a + Math.random() * (b - a),\n    randInt: (a, b) => Math.floor(a + Math.random() * (b - a + 1)),\n    pick: (arr) => arr[(Math.random() * arr.length) | 0],\n    clamp: (v, a, b) => (v < a ? a : v > b ? b : v),\n    lerp: (a, b, t) => a + (b - a) * t,\n    dist2: (x1, y1, x2, y2) => {\n      const dx = x1 - x2, dy = y1 - y2;\n      return dx * dx + dy * dy;\n    },\n    // Axis-aligned bounding box overlap test\n    aabb: (ax, ay, aw, ah, bx, by, bw, bh) =>\n      Math.abs(ax - bx) * 2 < (aw + bw) && Math.abs(ay - by) * 2 < (ah + bh),\n    fmtTime: (ms, tenths) => {\n      const total = Math.max(0, ms);\n      const m = Math.floor(total / 60000);\n      const s = Math.floor((total % 60000) / 1000);\n      const t = Math.floor((total % 1000) / 100);\n      const base = String(m).padStart(2, '0') + ':' + String(s).padStart(2, '0');\n      return tenths ? base + '.' + t : base;\n    },\n    fmtScore: (n) => Math.floor(n).toLocaleString('en-US'),\n    safeStorage: {\n      get(key, fallback) {\n        try {\n          const v = window.localStorage.getItem(key);\n          return v === null ? fallback : v;\n        } catch (e) { return fallback; }\n      },\n      set(key, value) {\n        try { window.localStorage.setItem(key, String(value)); } catch (e) { /* private mode */ }\n      }\n    }\n  };\n\n  /* ==========================================================================\n   * 2. AUDIO — Web Audio API synth SFX + procedural synthwave loop\n   * ======================================================================== */\n  const Audio2 = {\n    ctx: null,\n    master: null,\n    musicGain: null,\n    sfxGain: null,\n    muted: U.safeStorage.get(STORAGE_MUTE, '0') === '1',\n    started: false,\n    musicTimer: null,\n    step: 0,\n    nextNoteTime: 0,\n    bpm: 120,\n\n    init() {\n      if (this.ctx) return;\n      const AC = window.AudioContext || window.webkitAudioContext;\n      if (!AC) return;\n      try {\n        this.ctx = new AC();\n        this.master = this.ctx.createGain();\n        this.master.gain.value = this.muted ? 0 : 0.9;\n        this.master.connect(this.ctx.destination);\n\n        this.sfxGain = this.ctx.createGain();\n        this.sfxGain.gain.value = 0.55;\n        this.sfxGain.connect(this.master);\n\n        this.musicGain = this.ctx.createGain();\n        this.musicGain.gain.value = 0.16;\n        this.musicGain.connect(this.master);\n      } catch (e) { this.ctx = null; }\n    },\n\n    resume() {\n      this.init();\n      if (this.ctx && this.ctx.state === 'suspended') this.ctx.resume();\n    },\n\n    setMuted(m) {\n      this.muted = m;\n      U.safeStorage.set(STORAGE_MUTE, m ? '1' : '0');\n      if (this.master && this.ctx) {\n        this.master.gain.cancelScheduledValues(this.ctx.currentTime);\n        this.master.gain.linearRampToValueAtTime(m ? 0 : 0.9, this.ctx.currentTime + 0.12);\n      }\n    },\n\n    toggleMute() { this.setMuted(!this.muted); return this.muted; },\n\n    // --- primitives --------------------------------------------------------\n    tone(opts) {\n      if (!this.ctx || this.muted) return;\n      const {\n        type = 'sine', freq = 440, freqEnd = null, dur = 0.12,\n        gain = 0.3, delay = 0, dest = null, detune = 0\n      } = opts;\n      const t0 = this.ctx.currentTime + delay;\n      const osc = this.ctx.createOscillator();\n      const g = this.ctx.createGain();\n      osc.type = type;\n      osc.frequency.setValueAtTime(freq, t0);\n      if (freqEnd !== null) osc.frequency.exponentialRampToValueAtTime(Math.max(20, freqEnd), t0 + dur);\n      if (detune) osc.detune.setValueAtTime(detune, t0);\n      g.gain.setValueAtTime(0.0001, t0);\n      g.gain.exponentialRampToValueAtTime(Math.max(0.0002, gain), t0 + 0.008);\n      g.gain.exponentialRampToValueAtTime(0.0001, t0 + dur);\n      osc.connect(g);\n      g.connect(dest || this.sfxGain);\n      osc.start(t0);\n      osc.stop(t0 + dur + 0.02);\n    },\n\n    noise(opts) {\n      if (!this.ctx || this.muted) return;\n      const { dur = 0.2, gain = 0.3, delay = 0, filterType = 'bandpass', freq = 1200, q = 1.2, sweepTo = null } = opts;\n      const t0 = this.ctx.currentTime + delay;\n      const len = Math.max(1, Math.floor(this.ctx.sampleRate * dur));\n      const buf = this.ctx.createBuffer(1, len, this.ctx.sampleRate);\n      const data = buf.getChannelData(0);\n      for (let i = 0; i < len; i++) data[i] = (Math.random() * 2 - 1) * (1 - i / len);\n      const src = this.ctx.createBufferSource();\n      src.buffer = buf;\n      const filt = this.ctx.createBiquadFilter();\n      filt.type = filterType;\n      filt.frequency.setValueAtTime(freq, t0filt.frequency.setValueAtTime(freq, t0);\n      if (sweepTo !== null) filt.frequency.exponentialRampToValueAtTime(Math.max(40, sweepTo), t0 + dur);\n      filt.Q.value = q;\n      const g = this.ctx.createGain();\n      g.gain.setValueAtTime(Math.max(0.0002, gain), t0);\n      g.gain.exponentialRampToValueAtTime(0.0001, t0 + dur);\n      src.connect(filt);\n      filt.connect(g);\n      g.connect(this.sfxGain);\n      src.start(t0);\n      src.stop(t0 + dur + 0.02);\n    },\n\n    // --- SFX ---------------------------------------------------------------\n    sfxDodge() {\n      this.tone({ type: 'triangle', freq: 880, freqEnd: 1320, dur: 0.08, gain: 0.12 });\n    },\n    sfxNearMiss() {\n      this.tone({ type: 'sawtooth', freq: 1600, freqEnd: 2400, dur: 0.06, gain: 0.08 });\n    },\n    sfxCombo(level) {\n      const base = 520 + Math.min(level, 12) * 40;\n      this.tone({ type: 'square', freq: base, freqEnd: base * 1.5, dur: 0.12, gain: 0.16 });\n      this.tone({ type: 'triangle', freq: base * 2, dur: 0.1, gain: 0.1, delay: 0.04 });\n    },\n    sfxHit() {\n      this.noise({ dur: 0.28, gain: 0.5, filterType: 'lowpass', freq: 900, sweepTo: 120 });\n      this.tone({ type: 'sawtooth', freq: 220, freqEnd: 60, dur: 0.3, gain: 0.3 });\n    },\n    sfxShield() {\n      this.tone({ type: 'sine', freq: 660, freqEnd: 990, dur: 0.18, gain: 0.2 });\n    },\n    sfxStart() {\n      this.tone({ type: 'square', freq: 330, freqEnd: 660, dur: 0.16, gain: 0.2 });\n      this.tone({ type: 'square', freq: 660, freqEnd: 990, dur: 0.18, gain: 0.18, delay: 0.12 });\n    },\n    sfxGameOver() {\n      this.tone({ type: 'sawtooth', freq: 440, freqEnd: 55, dur: 0.9, gain: 0.35 });\n      this.noise({ dur: 0.7, gain: 0.4, filterType: 'lowpass', freq: 1400, sweepTo: 80 });\n    },\n    sfxSpawn() {\n      this.tone({ type: 'triangle', freq: 1200, freqEnd: 700, dur: 0.05, gain: 0.05 });\n    },\n\n    // --- Procedural synthwave loop ----------------------------------------\n    startMusic() {\n      this.init();\n      if (!this.ctx || this.started) return;\n      this.started = true;\n      this.step = 0;\n      this.nextNoteTime = this.ctx.currentTime + 0.1;\n      const bassSeq = [0, 0, 7, 0, 5, 5, 3, 5];\n      const leadSeq = [12, 15, 19, 15, 12, 10, 7, 10];\n      const root = 55; // A1\n      const spb = 60 / this.bpm / 2; // eighth notes\n      const schedule = () => {\n        if (!this.started) return;\n        while (this.nextNoteTime < this.ctx.currentTime + 0.2) {\n          const s = this.step;\n          const t = this.nextNoteTime;\n          // bass\n          const bNote = root * Math.pow(2, bassSeq[s % bassSeq.length] / 12);\n          this._musicTone('sawtooth', bNote, t, spb * 0.9, 0.5);\n          // lead every other step\n          if (s % 2 === 0) {\n            const lNote = root * 4 * Math.pow(2, leadSeq[(s / 2 | 0) % leadSeq.length] / 12);\n            this._musicTone('square', lNote, t, spb * 1.4, 0.22);\n          }\n          // hat\n          this._musicNoise(t, 0.03, 0.08);\n          this.nextNoteTime += spb;\n          this.step++;\n        }\n        this.musicTimer = setTimeout(schedule, 60);\n      };\n      schedule();\n    },\n\n    _musicTone(type, freq, t0, dur, gain) {\n      if (!this.ctx || this.muted) return;\n      const osc = this.ctx.createOscillator();\n      const g = this.ctx.createGain();\n      osc.type = type;\n      osc.frequency.setValueAtTime(freq, t0);\n      g.gain.setValueAtTime(0.0001, t0);\n      g.gain.exponentialRampToValueAtTime(gain, t0 + 0.02);\n      g.gain.exponentialRampToValueAtTime(0.0001, t0 + dur);\n      osc.connect(g);\n      g.connect(this.musicGain);\n      osc.start(t0);\n      osc.stop(t0 + dur + 0.02);\n    },\n\n    _musicNoise(t0, dur, gain) {\n      if (!this.ctx || this.muted) return;\n      const len = Math.max(1, Math.floor(this.ctx.sampleRate * dur));\n      const buf = this.ctx.createBuffer(1, len, this.ctx.sampleRate);\n      const data = buf.getChannelData(0);\n      for (let i = 0; i < len; i++) data[i] = (Math.random() * 2 - 1);\n      const src = this.ctx.createBufferSource();\n      src.buffer = buf;\n      const filt = this.ctx.createBiquadFilter();\n      filt.type = 'highpass';\n      filt.frequency.value = 6000;\n      const g = this.ctx.createGain();\n      g.gain.setValueAtTime(gain, t0);\n      g.gain.exponentialRampToValueAtTime(0.0001, t0 + dur);\n      src.connect(filt);\n      filt.connect(g);\n      g.connect(this.musicGain);\n      src.start(t0);\n      src.stop(t0 + dur + 0.02);\n    },\n\n    stopMusic() {\n      this.started = false;\n      if (this.musicTimer) { clearTimeout(this.musicTimer); this.musicTimer = null; }\n    }\n  };\n\n  /* ==========================================================================\n   * 3. DOM / CANVAS SETUP\n   * ======================================================================== */\n  const canvas = document.getElementById('game');\n  const ctx = canvas.getContext('2d');\n\n  const dom = {\n    menuScreen: document.getElementById('menuScreen'),\n    pauseScreen: document.getElementById('pauseScreen'),\n    overScreen: document.getElementById('overScreen'),\n    startBtn: document.getElementById('startBtn'),\n    resumeBtn: document.getElementById('resumeBtn'),\n    restartBtn: document.getElementById('restartBtn'),\n    exitBtn: document.getElementById('exitBtn'),\n    retryBtn: document.getElementById('retryBtn'),\n    menuBtn: document.getElementById('menuBtn'),\n    soundBtn: document.getElementById('soundBtn'),\n    pauseBtn: document.getElementById('pauseBtn'),\n    runTimer: document.getElementById('runTimer'),\n    bestScore: document.getElementById('bestScore'),\n    timerChip: document.getElementById('timerChip'),\n    finalScore: document.getElementById('finalScore'),\n    finalStreak: document.getElementById('finalStreak'),\n    finalTime: document.getElementById('finalTime'),\n    recordLine: document.getElementById('recordLine'),\n    overSubtitle: document.getElementById('overSubtitle'),\n    liveRegion: document.getElementById('liveRegion'),\n    padLeft: document.getElementById('padLeft'),\n    padRight: document.getElementById('padRight')\n  };\n\n  let DPR = Math.min(window.devicePixelRatio || 1, 2);\n  let W = 0, H = 0;\n\n  function resize() {\n    DPR = Math.min(window.devicePixelRatio || 1, 2);\n    W = window.innerWidth;\n    H = window.innerHeight;\n    canvas.width = Math.floor(W * DPR);\n    canvas.height = Math.floor(H * DPR);\n    canvas.style.width = W + 'px';\n    canvas.style.height = H + 'px';\n    ctx.setTransform(DPR, 0, 0, DPR, 0, 0);\n  }\n  window.addEventListener('resize', resize);\n  window.addEventListener('orientationchange', () => setTimeout(resize, 120));\n  resize();\n\n  /* ==========================================================================\n   * 4. GAME STATE\n   * ======================================================================== */\n  const STATE = { MENU: 'menu', PLAYING: 'playing', PAUSED: 'paused', OVER: 'over' };\n\n  const game = {\n    state: STATE.MENU,\n    score: 0,\n    displayScore: 0,\n    streak: 0,\n    maxStreak: 0,\n    hp: CFG.maxHP,\n    elapsed: 0,          // ms survived\n    spawnTimer: 0,\n    spawnInterval: CFG.spawnStart,\n    lastStepAt: 0,\n    best: parseInt(U.safeStorage.get(STORAGE_KEY, '0'), 10) || 0,\n    shake: 0,\n    flash: 0,\n    hitFlash: 0,\n    time: 0,             // seconds since load (for shaders)\n    knives: [],\n    particles: [],\n    stars: [],\n    grid: [],\n    player: null\n  };\n\n  /* ==========================================================================\n   * 5. OBJECT POOLS\n   * ======================================================================== */\n  const knifePool = [];\n  const particlePool = [];\n\n  function acquireKnife() {\n    const k = knifePool.pop() || {};\n    k.active = true;\n    game.knives.push(k);\n    return k;\n  }\n  function releaseKnife(k) {\n    k.active = false;\n    if (knifePool.length < CFG.maxKnives) knifePool.push(k);\n  }\n\n  function acquireParticle() {\n    if (game.particles.length >= CFG.maxParticles) return null;\n    const p = particlePool.pop() || {};\n    p.active = true;\n    game.particles.push(p);\n    return p;\n  }\n  function releaseParticle(p) {\n    p.active = false;\n    if (particlePool.length < CFG.maxParticles) particlePool.push(p);\n  }\n\n  /* ==========================================================================\n   * 6. PLAYER\n   * ======================================================================== */\n  function createPlayer() {\n    return {\n      x: W / 2,\n      y: H - CFG.playerBottomPad,\n      vx: 0,\n      w: CFG.playerW,\n      h: CFG.playerH,\n      iFrames: 0,\n      alive: true,\n      tilt: 0,\n      trail: []\n    };\n  }\n\n  /* ==========================================================================\n   * 7. KNIVES\n   * ======================================================================== */\n  function spawnKnife() {\n    if (game.knives.length >= CFG.maxKnives) return;\n    const fromTop = Math.random() < 0.82;\n    const k = acquireKnife();\n    k.len = U.rand(34, 58);\n    k.w = U.rand(6, 10);\n    k.rot = 0;\n    k.spin = 0;\n    k.color = U.pick([PALETTE.steel, PALETTE.cyan, PALETTE.violet, PALETTE.lime]);\n    k.glow = U.pick([PALETTE.cyan, PALETTE.violet, PALETTE.crimson]);\n    k.passed = false;\n    k.nearMissed = false;\n\n    if (fromTop) {\n      k.x = U.rand(CFG.spawnEdgePad, W - CFG.spawnEdgePad);\n      k.y = -k.len;\n      const aimAtPlayer = Math.random() < 0.35 && game.player;\n      let tx = aimAtPlayer ? game.player.x + U.rand(-60, 60) : U.rand(0, W);\n      const ty = H + 40;\n      const ang = Math.atan2(ty - k.y, tx - k.x);\n      const speed = U.rand(3.4, 6.2) + Math.min(game.elapsed / 60000, 6) * 0.5;\n      k.vx = Math.cos(ang) * speed;\n      k.vy = Math.sin(ang) * speed;\n      k.rot = ang + Math.PI / 2;\n    } else {\n      // occasional side sweep\n      const fromLeft = Math.random() < 0.5;\n      k.x = fromLeft ? -k.len : W + k.len;\n      k.y = U.rand(H * 0.15, H * 0.7);\n      const speed = U.rand(4, 7);\n      k.vx = fromLeft ? speed : -speed;\n      k.vy = U.rand(-0.6, 1.4);\n      k.rot = fromLeft ? -Math.PI / 2 : Math.PI / 2;\n    }\n    Audio2.sfxSpawn();\n  }\n\n  /* ==========================================================================\n   * 8. PARTICLES\n   * ======================================================================== */\n  function burst(x, y, color, count, opts) {\n    opts = opts || {};\n    const speed = opts.speed || 4;\n    const spread = opts.spread || Math.PI * 2;\n    const dir = opts.dir || 0;\n    const life = opts.life || 0.6;\n    const size = opts.size || 3;\n    for (let i = 0; i < count; i++) {\n      const p = acquireParticle();\n      if (!p) break;\n      const a = dir + U.rand(-spread / 2, spread / 2);\n      const sp = U.rand(speed * 0.3, speed);\n      p.x = x; p.y = y;\n      p.vx = Math.cos(a) * sp;\n      p.vy = Math.sin(a) * sp;\n      p.life = life * U.rand(0.6, 1.2);\n      p.maxLife = p.life;\n      p.size = size * U.rand(0.6, 1.4);\n      p.color = color;\n      p.gravity = opts.gravity || 0;\n      p.drag = opts.drag != null ? opts.drag : 0.92;\n      p.glow = opts.glow !== false;\n    }\n  }\n\n  /* ==========================================================================\n   * 9. BACKGROUND (stars + perspective grid)\n   * ======================================================================== */\n  function initBackground() {\n    game.stars.length = 0;\n    const count = Math.floor((W * H) / 9000);\n    for (let i = 0; i < count; i++) {\n      game.stars.push({\n        x: Math.random() * W,\n        y: Math.random() * H,\n        z: U.rand(0.2, 1),\n        tw: Math.random() * Math.PI * 2\n      });\n    }\n  }\n\n  function updateBackground(dt) {\n    for (const s of game.stars) {\n      s.y += (10 + s.z * 40) * dt;\n      s.tw += dt * 3;\n      if (s.y > H) { s.y = -2; s.x = Math.random() * W; }\n    }\n  }\n\n  function drawBackground() {\n    // deep gradient\n    const g = ctx.createLinearGradient(0, 0, 0, H);\n    g.addColorStop(0, '#04060c');\n    g.addColorStop(0.55, '#050505');\n    g.addColorStop(1, '#120306');\n    ctx.fillStyle = g;\n    ctx.fillRect(0, 0, W, H);\n\n    // stars\n    for (const s of game.stars) {\n      const a = 0.3 + 0.7 * (0.5 + 0.5 * Math.sin(s.tw));\n      ctx.globalAlpha = a * s.z;\n      ctx.fillStyle = s.z > 0.7 ? PALETTE.cyan : '#9fdcff';\n      const sz = s.z * 2;\n      ctx.fillRect(s.x, s.y, sz, sz);\n    }\n    ctx.globalAlpha = 1;\n\n    // horizon glow\n    const hg = ctx.createRadialGradient(W / 2, H * 0.62, 10, W / 2, H * 0.62, W * 0.7);\n    hg.addColorStop(0, 'rgba(191,0,255,0.10)');\n    hg.addColorStop(0.5, 'rgba(0,243,255,0.05)');\n    hg.addColorStop(1, 'rgba(0,0,0,0)');\n    ctx.fillStyle = hg;\n    ctx.fillRect(0, 0, W, H);\n\n    // perspective floor grid\n    drawGrid();\n  }\n\n  const gridScroll = { off: 0 };\n  function drawGrid() {\n    const horizon = H * 0.62;\n    ctx.save();\n    ctx.strokeStyle = 'rgba(0,243,255,0.14)';\n    ctx.lineWidth = 1;\n    ctx.shadowColor = PALETTE.cyan;\n    ctx.shadowBlur = 6;\n\n    // horizontal lines (moving toward viewer)\n    const rows = 14;\n    for (let i = 0; i < rows; i++) {\n      let t = (i + (gridScroll.off % 1)) / rows;\n      t = t * t; // accelerate toward viewer\n      const y = horizon + t * (H - horizon);\n      ctx.globalAlpha = 0.15 + t * 0.5;\n      ctx.beginPath();\n      ctx.moveTo(0, y);\n      ctx.lineTo(W, y);\n      ctx.stroke();\n    }\n\n    // vertical converging lines\n    const cols = 16;\n    ctx.globalAlpha = 0.22;\n    for (let i = 0; i <= cols; i++) {\n      const x = (i / cols) * W;\n      ctx.beginPath();\n      ctx.moveTo(W / 2 + (x - W / 2) * 0.15, horizon);\n      ctx.lineTo(x, H);\n      ctx.stroke();\n    }\n    ctx.restore();\n    ctx.globalAlpha = 1;\n  }\n\n  /* ==========================================================================\n   * 10. UPDATE\n   * ======================================================================== */\n  function updatePlayer(dt) {\n    const p = game.player;\n    if (!p || !p.alive) return;\n\n    let dir = 0;\n    if (input.left) dir -= 1;\n    if (input.right) dir += 1;\n\n    p.vx += dir * CFG.accel * (dt * 60);\n    if (dir === 0) p.vx *= Math.pow(CFG.friction, dt * 60);\n    p.vx = U.clamp(p.vx, -CFG.maxSpeed, CFG.maxSpeed);\n    if (Math.abs(p.vx) < CFG.minSpeedThreshold) p.vx = 0;\n\n    p.x += p.vx * (dt * 60);\n    const half = p.w / 2;\n    if (p.x < half) { p.x = half; p.vx = 0; }\n    if (p.x > W - half) { p.x = W - half; p.vx = 0; }\n\n    p.tilt = U.lerp(p.tilt, U.clamp(p.vx / CFG.maxSpeed, -1, 1) * 0.35, 0.2);\n\n    if (p.iFrames > 0) p.iFrames -= dt;\n\n    // motion trail\n    p.trail.push({ x: p.x, y: p.y, a: 1 });\n    if (p.trail.length > 12) p.trail.shift();\n    for (const t of p.trail) t.a -= dt * 3;\n  }\n\n  function updateKnives(dt) {\n    const p = game.player;\n    const step = dt * 60;\n    for (let i = game.knives.length - 1; i >= 0; i--) {\n      const k = game.knives[i];\n      k.x += k.vx * step;\n      k.y += k.vy * step;\n\n      // off-screen cull\n      if (k.x < -120 || k.x > W + 120 || k.y > H + 120 || k.y < -200) {\n        if (!k.passed && k.y > (p ? p.y : H)) {\n          // counted as dodged when passing player line\n        }\n        releaseKnife(k);\n        game.knives.splice(i, 1);\n        continue;\n      }\n\n      if (!p || !p.alive) continue;\n\n      // collision (AABB around knife tip region)\n      const dx = Math.abs(k.x - p.x);\n      const dy = Math.abs(k.y - p.y);\n      const hitW = (k.w + p.w) / 2;\n      const hitH = (k.len + p.h) / 2;\n\n      if (dx < hitW && dy < hitH) {\n        if (p.iFrames <= 0) {\n          onPlayerHit(k);\n          releaseKnife(k);\n          game.knives.splice(i, 1);\n          continue;\n        }\n      }\n\n      // near miss + dodge scoring when passing player's vertical band\n      if (!k.passed && k.y > p.y + p.h * 0.5) {\n        k.passed = true;\n        onDodge(k, dx);\n      }\n    }\n  }\n\n  function updateParticles(dt) {\n    for (let i = game.particles.length - 1; i >= 0; i--) {\n      const p = game.particles[i];\n      p.life -= dt;\n      if (p.life <= 0) {\n        releaseParticle(p);\n        game.particles.splice(i, 1);\n        continue;\n      }\n      p.vy += p.gravity * (dt * 60);\n      p.vx *= Math.pow(p.drag, dt * 60);\n      p.vy *= Math.pow(p.drag, dt * 60);\n      p.x += p.vx * (dt * 60);\n      p.y += p.vy * (dt * 60);\n    }\n  }\n\n  /* ==========================================================================\n   * 11. SCORING / EVENTS\n   * ======================================================================== */\n  function onDodge(k, dx) {\n    game.streak++;\n    if (game.streak > game.maxStreak) game.maxStreak = game.streak;\n    game.score += CFG.dodgePoints;\\n\n    const near = dx < (k.w + game.player.w) / 2 + CFG.nearMissDist;\n    if (near && !k.nearMissed) {\n      k.nearMissed = true;\n      game.score += 5;\n      Audio2.sfxNearMiss();\n      burst(k.x, k.y, PALETTE.amber, 6, { speed: 3, life: 0.4, size: 2 });\n    } else {\n      Audio2.sfxDodge();\n    }\n\n    if (game.streak % CFG.comboEvery === 0) {\n      game.score += CFG.comboBonus;\n      Audio2.sfxCombo(game.streak / CFG.comboEvery);\n      const p = game.player;\n      burst(p.x, p.y - 20, PALETTE.lime, 22, { speed: 6, life: 0.7, size: 3 });\n      game.flash = Math.max(game.flash, 0.35);\n      announce('Combo ' + game.streak + '!');\n    }\n  }\n\n  function onPlayerHit(k) {\n    const p = game.player;\n    game.hp--;\n    game.streak = 0;\n    p.iFrames = CFG.iFrames;\n    game.shake = Math.min(1, game.shake + 0.9);\n    game.hitFlash = 1;\n    Audio2.sfxHit();\n    burst(p.x, p.y, PALETTE.crimson, 30, { speed: 7, life: 0.8, size: 4, gravity: 0.15 });\n    burst(k.x, k.y, PALETTE.steel, 14, { speed: 5, life: 0.5, size: 3 });\n\n    if (game.hp <= 0) {\n      game.hp = 0;\n      endGame();\n    } else {\n      announce('Hit! ' + game.hp + ' shields left.');\n    }\n  }\n\n  /* ==========================================================================\n   * 12. FLOW CONTROL\n   * ======================================================================== */\n  function resetRun() {\n    game.score = 0;\n    game.displayScore = 0;\n    game.streak = 0;\n    game.maxStreak = 0;\n    game.hp = CFG.maxHP;\n    game.elapsed = 0;\n    game.spawnTimer = 0;\n    game.spawnInterval = CFG.spawnStart;\n    game.lastStepAt = 0;\n    game.shake = 0;\n    game.flash = 0;\n    game.hitFlash = 0;\n    game.knives.length = 0;\n    game.particles.length = 0;\n    game.player = createPlayer();\n  }\n\n  function startGame() {\n    Audio2.resume();\n    Audio2.sfxStart();\n    Audio2.startMusic();\n    resetRun();\n    game.state = STATE.PLAYING;\n    hideAllOverlays();\n    announce('Run started. Good luck.');\n  }\n\n  function pauseGame() {\n    if (game.state !== STATE.PLAYING) return;\n    game.state = STATE.PAUSED;\n    showOverlay(dom.pauseScreen);\n    Audio2.stopMusic();\n    announce('Paused.');\n  }\n\n  function resumeGame() {\n    if (game.state !== STATE.PAUSED) return;\n    game.state = STATE.PLAYING;\n    hideAllOverlays();\n    Audio2.resume();\n    Audio2.startMusic();\n    announce('Resumed.');\n  }\n\n  function endGame() {\n    if (game.state === STATE.OVER) return;\n    game.state = STATE.OVER;\n    Audio2.stopMusic();\n    Audio2.sfxGameOver();\n    game.shake = 1;\n    game.hitFlash = 1;\n    const p = game.player;\n    if (p) {\n      burst(p.x, p.y, PALETTE.crimson, 60, { speed: 9, life: 1.2, size: 5, gravity: 0.2 });\n      burst(p.x, p.y, PALETTE.cyan, 40, { speed: 7, life: 1.0, size: 4 });\n      p.alive = false;\n    }\n\n    const final = Math.floor(game.score);\n    const isRecord = final > game.best;\n    if (isRecord) {\n      game.best = final;\n      U.safeStorage.set(STORAGE_KEY, final);\n    }\n\n    dom.finalScore.textContent = U.fmtScore(final);\n    dom.finalStreak.textContent = String(game.maxStreak);\n    dom.finalTime.textContent = U.fmtTime(game.elapsed, false);\n    dom.bestScore.textContent = U.fmtScore(game.best);\n\n    dom.recordLine.textContent = isRecord ? '★ NEW RECORD ★' : 'BEST ' + U.fmtScore(game.best);\n    dom.recordLine.classList.toggle('flash', isRecord);\n\n    const lines = [\n      'The cascade claims another.',\n      'So close. Again?',\n      'Steel always wins. Try again.',\n      'Reflexes need sharpening.'\n    ];\n    dom.overSubtitle.textContent = U.pick(lines);\n\n    setTimeout(() => {\n      if (game.state === STATE.OVER) showOverlay(dom.overScreen);\n    }, 650);\n\n    announce('Game over. Score ' + final + (isRecord ? '. New record!' : '.'));\n  }\n\n  function exitToMenu() {\n    game.state = STATE.MENU;\n    Audio2.stopMusic();\n    hideAllOverlays();\n    showOverlay(dom.menuScreen);\n    dom.bestScore.textContent = U.fmtScore(game.best);\n    announce('Main menu.');\n  }\n\n  /* ==========================================================================\n   * 13. OVERLAY HELPERS\n   * ======================================================================== */\n  function showOverlay(el) {\n    el.classList.remove('hidden');\n  }\n  function hideAllOverlays() {\n    dom.menuScreen.classList.add('hidden');\n    dom.pauseScreen.classList.add('hidden');\n    dom.overScreen.classList.add('hidden');\n  }\n  let announceTimer = null;\n  function announce(msg) {\n    if (!dom.liveRegion) return;\n    dom.liveRegion.textContent = msg;\n  }\n\n  /* ==========================================================================\n   * 14. SPAWN DIRECTOR\n   * ======================================================================== */\n  function updateSpawning(dt) {\n    // ramp difficulty over time\n    if (game.elapsed - game.lastStepAt >= CFG.spawnStepEvery) {\n      game.lastStepAt = game.elapsed;\n      game.spawnInterval = Math.max(CFG.spawnMin, game.spawnInterval - CFG.spawnStepAmount);\n    }\n\n    game.spawnTimer += dt * 1000;\n    while (game.spawnTimer >= game.spawnInterval) {\n      game.spawnTimer -= game.spawnInterval;\n      spawnKnife();\n      // occasional double spawn at higher difficulty\n      if (game.spawnInterval < 500 && Math.random() < 0.35) spawnKnife();\n    }\n  }\n\n  /* ==========================================================================\n   * 15. RENDER\n   * ======================================================================== */\n  function drawPlayer() {\n    const p = game.player;\n    if (!p || !p.alive) return;\n\n    // trail\n    for (let i = 0; i < p.trail.length; i++) {\n      const t = p.trail[i];\n      if (t.a <= 0) continue;\n      ctx.globalAlpha = t.a * 0.25;\n      ctx.fillStyle = PALETTE.cyan;\n      const s = (i / p.trail.length);\n      ctx.fillRect(t.x - p.w / 2 * s, t.y - p.h / 2 * s, p.w * s, p.h * s);\n    }\n    ctx.globalAlpha = 1;\n\n    // i-frame blink\n    if (p.iFrames > 0 && Math.floor(p.iFrames * 20) % 2 === 0) {\n      ctx.globalAlpha = 0.4;\n    }\n\n    ctx.save();\n    ctx.translate(p.x, p.y);\n    ctx.rotate(p.tilt);\n\n    // glow body\n    ctx.shadow