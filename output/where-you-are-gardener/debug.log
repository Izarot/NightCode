r;\n        }\n        \n        canvas {\n            display: block;\n            max-width: 100vw;\n            max-height: 90vh;\n            width: 100%;\n            height: auto;\n            border-radius: 12px;\n            cursor: crosshair;\n            transition: box-shadow 0.3s ease;\n        }\n        \n        /* Responsive Canvas Adjustment */\n        @media (max-width: 600px) {\n            #game-container {\n                max-width: 95vw;\n            }\n            .top-bar, .bottom-bar {\n                padding: 10px;\n            }\n        }\n        \n        /* HUD Styles */\n        .hud {\n            position: absolute;\n            top: 16px;\n            left: 16px;\n            right: 16px;\n            display: flex;\n            gap: 24px;\n            z-index: 10;\n            pointer-events: none;\n        }\n        .hud-item {\n            background: rgba(0, 0, 0, 0.85);\n            backdrop-filter: blur(8px);\n            padding: 12px 18px;\n            border-radius: 8px;\n            color: var(--text-main);\n            font-size: 14px;\n            font-weight: 500;\n        }\n        .hud-item .value {\n            font-size: 24px;\n            font-weight: bold;\n            color: var(--primary-green);\n        }\n        .hud-item .label {\n            font-size: 11px;\n            text-transform: uppercase;\n            letter-spacing: 1px;\n            color: var(--text-light);\n        }\n        \n        /* Top Bar (Water Meter + Score + Time) */\n        .top-bar {\n            display: flex;\n            align-items: center;\n            justify-content: space-between;\n            padding: 12px 16px;\n            background: rgba(255, 255, 255, 0.9);\n            border-radius: 8px;\n            box-shadow: 0 2px 8px rgba(0,0,0,0.1);\n        }\n        .water-meter {\n            display: flex;\n            align-items: center;\n            gap: 8px;\n            height: 8px;\n            border-radius: 4px;\n            overflow: hidden;\n        }\n        .water-fill {\n            height: 100%;\n            background: linear-gradient(to top, var(--primary-green), var(--accent-blue));\n            transition: width 0.5s ease;\n        }\n        .water-empty {\n            height: 100%;\n            background: linear-gradient(to top, #555, #333);\n        }\n        .water-label {\n            font-size: 11px;\n            color: var(--text-light);\n            margin-left: 4px;\n        }\n        .score-display {\n            font-size: 28px;\n            font-weight: bold;\n            color: var(--primary-green);\n        }\n        .time-display {\n            font-size: 18px;\n            color: var(--accent-blue);\n        }\n        \n        /* Bottom Bar (Mini-map + Notifications) */\n        .bottom-bar {\n            display: flex;\n            align-items: center;\n            justify-content: space-between;\n            padding: 12px 16px;\n            background: rgba(0, 0, 0, 0.85);\n            border-radius: 8px;\n            box-shadow: 0 2px 8px rgba(0,0,0,0.1);\n        }\n        .mini-map {\n            width: 80px;\n            height: 60px;\n            border-radius: 4px;\n            background: rgba(0,0,0,0.5);\n            overflow: hidden;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n        }\n        .mini-map .cell {\n            width: 32px;\n            height: 32px;\n            border-radius: 4px;\n        }\n        .minimap-cell.tree { background: var(--forest-green); }\n        .minimap-cell.flower { background: var(--flower-pink); }\n        .minimap-cell.potato { background: var(--soil-brown); }\n        \n        .notification {\n            background: var(--warning-orange);\n            color: white;\n            padding: 8px 12px;\n            border-radius: 6px;\n            font-size: 13px;\n            animation: pulse 1.5s infinite;\n        }\n        @k