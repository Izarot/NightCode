"// render.js\nexport class Renderer {\n  constructor(canvas, game) {\n    this.canvas = canvas;\n    this.game = game;\n    this.ctx = canvas.getContext('2d');\n    this.width = canvas.width;\n    this.height = canvas.height;\n    this.tubeWidth = 80;\n    this.tubeSpacing = 20;\n    this.particleCount = 50;\n    this.particles = [];\n    this.drawBackground();\n    this.redrawTubes();\n  }\n\n  resize() {\n    this.width = this.canvas.width;\n    this.height = this.canvas.height;\n    this.drawBackground();\n    this.redrawTubes();\n  }\n\n  drawBackground() {\n    const grad = this.ctx.createLinearGradient(0, 0, 0, this.height);\n    grad.addColorStop(0, 'var(--bg-start)');\n    grad.addColorStop(1, 'var(--bg-end)');\n    this.ctx.fillStyle = grad;\n    this.ctx.fillRect(0, 0, this.width, this.height);\n  }\n\n  redrawTubes() {\n    const game = this.game;\n    const w = this.width;\n    const h = this.height;\n    const tubeWidth = this.tubeWidth;\n    const spacing = this.tubeSpacing;\n    const startX = (w - (this.tubesCount() * tubeWidth + (this.tubesCount() - 1) * spacing)) / 2;\n    this.tubes = [];\n    for (let i = 0; i < this.tubesCount(); i++) {\n      const x = startX + i * (tubeWidth + spacing);\n      const y = h * 0.6;\n      const tube = this.game.tubes[i];\n      this.tubes.push({tube, x, y});\n    }\n  }\n\n  tubesCount() {\n    return this.game.tubes.length;\n  }\n\n  render() {\n    const ctx = this.ctx;\n    const w = this.width;\n    const h = this.height;\n    ctx.clearRect(0, 0, w, h);\n    this.drawBackground();\n    this.redrawTubes();\n    for (const {tube, x, y} of this.tubes) {\n      tube.draw(ctx);\n    }\n    this.drawParticles();\n    this.drawHUD();\n  }\n\n  drawParticles() {\n    this.ctx.fillStyle = 'rgba(255,255,255,0.2)';\n    for (let i = 0; i < this.particleCount; i++) {\n      const p = this.particles[i];\n      if (!p) continue;\n      this.ctx.beginPath();\n      this.ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);\n      this.ctx.fill();\n    }\n  }\n\n  drawHUD() {\n    const game = this.game;\n    const ctx = this.ctx;\n    const w = this.width;\n    const h = this.height;\n    ctx.fillStyle = '#fff';\n    ctx.font = '20px Arial';\n    ctx.fillText(`Time: ${game.formatTime(game.timer)}`, 10, 30);\n    ctx.fillText(`Moves: ${game.moves}`, 10, 60);\n    ctx.fillText(`Best: ${game.highScore}`, 10, 90);\n    // hint button\n    ctx.fillStyle = '#ff0';\n    ctx.fillRect(w - 120, h - 50, 80, 30);\n    ctx.fillStyle = '#fff';\n    ctx.fillText('Hint', w - 115, h - 35);\n    // undo button\n    ctx.fillStyle = '#f00';\n    ctx.fillRect(w - 200, h - 50, 80, 30);\n    ctx.fillText('Undo', w - 195, h - 35);\n  }\n}"

