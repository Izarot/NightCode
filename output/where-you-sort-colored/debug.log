"// input.js\nexport class Input {\n  constructor(canvas, game) {\n    this.canvas = canvas;\n    this.game = game;\n    this.isTouch = false;\n    this.startX = 0;\n    this.startY = 0;\n    this.sourceIdx = null;\n    this.canvas.addEventListener('pointerdown', this.handlePointerDown.bind(this));\n    this.canvas.addEventListener('pointerup', this.handlePointerUp.bind(this));\n    this.canvas.addEventListener('pointermove', this.handlePointerMove.bind(this));\n  }\n\n  handlePointerDown(e) {\n    const rect = this.canvas.getBoundingClientRect();\n    const x = e.clientX - rect.left;\n    const y = e.clientY - rect.top;\n    this.isTouch = e.type === 'pointerdown';\n    this.startX = x;\n    this.startY = y;\n    const idx = this.getTubeIndex(x, y);\n    if (idx !== null) {\n      this.sourceIdx = idx;\n    }\n  }\n\n  handlePointerUp(e) {\n    if (!this.isTouch) return;\n    const rect = this.canvas.getBoundingClientRect();\n    const x = e.clientX - rect.left;\n    const y = e.clientY - rect.top;\n    const targetIdx = this.getTubeIndex(x, y);\n    if (this.sourceIdx !== null && targetIdx !== undefined && this.sourceIdx !== targetIdx) {\n      this.game.pour(this.sourceIdx, targetIdx);\n      this.sourceIdx = null;\n    }\n    this.isTouch = false;\n  }\n\n  handlePointerMove(e) {\n    // not needed for simple tap\n  }\n\n  getTubeIndex(x, y) {\n    const tubes = this.game.tubes;\n    const tubeWidth = 80;\n    const spacing = 20;\n    const startX = (this.canvas.width - (tubes.length * tubeWidth + (tubes.length - 1) * spacing)) / 2;\n    for (let i = 0; i < tubes.length; i++) {\n      const tubeX = startX + i * (tubeWidth + spacing);\n      const tubeTop = tubeX - 20; // top of tube area? we need to map y coordinate to tube index.\n      // For simplicity, consider any y within tube vertical range (approx 60% of canvas height)\n      if (y >= tubeTop && y <= tubeTop + 300) {\n        return i;\n      }\n    }\n    return null;\n  }\n\n  start() {\n    // nothing\n  }\n}

