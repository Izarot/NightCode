```js
// game.js
export class Game {
  constructor() {
    this.state = 'playing';
    this.levelIndex = 0;
    this.moves = 0;
    this.timer = 0; // seconds
    this.highScore = parseInt(localStorage.getItem('wsHighScore')) || 0;
    this.levels = []; // will be filled after fetch
    this.loadLevels();
    this.currentLevel = null;
    this.tubes = []; // array of Tube objects
    this.pouring = null; // {from, to}
    this.undoStack = [];
    this.hintCount = 3;
  }

  async loadLevels() {
    // fetch levels.json (assuming same origin)
    const resp = await fetch('data/levels.json');
    const data = await resp.json();
    this.levels = data;
    this.startLevel();
  }

  startLevel() {
    const levelData = this.levels[this.levelIndex];
    // create tubes based on levelData.tubeCount
    this.tubes = [];
    for (let i = 0; i < levelData.tubeCount; i++) {
      const tube = new Tube(i, levelData.initial[i]);
      this.tubes.push(tube);
    }
    this.moves = 0;
    this.timer = 0;
    this.pouring = null;
    this.undoStack = [];
    this.hintCount = 3;
    this.updateHighScore();
  }

  updateHighScore() {
    const best = this.moves;
    if (best < this.highScore) {
      this.highScore = best;
      localStorage.setItem('wsHighScore', this.highScore);
    }
  }

  update(t delta) {
    if (this.state !== 'playing') return;
    this.timer += delta;
    // check win condition
    if (this.isWin()) {
      this.win();
    }
  }

  isWin() {
    for (const tube of this.tubes) {
      if (tube.isEmpty()) continue;
      const color = tube.contents[0];
      for (const liquid of tube.contents) {
        if (liquid !== color) return false;
      }
    }
    return true;
  }

  win() {
    this.state = 'win';
    // play success sound
    audio.playSound('success');
    // maybe show stars etc.
  }

  pour(fromIdx, toIdx) {
    const from = this.tubes[fromIdx];
    const to = this.tubes[toIdx];
    if (from.isEmpty()) return;
    const srcColor = from.topColor();
    const dstColor = to.topColor();
    if (srcColor !== dstColor && dstColor !== 'empty') return; // invalid
    // perform pour: move top unit(s) from from to to
    const amount = Math.min(1, 4 - to.height); // each unit is 1 height
    // Actually each tube capacity 4 units; we can move one unit at a time.
    // For simplicity, move one unit.
    if (amount <= 0) return;
    // move one unit
    from.pop();
    to.push(srcColor);
    this.moves++;
    this.undoStack.push({fromIdx, toIdx, movedColor: srcColor});
    // check win after move
  }

  undo() {
    if (this.undoStack.length === 0) return;
    const {fromIdx, toIdx, movedColor} = this.undoStack.pop();
    // revert: move a unit of movedColor back to from
    // need to know which tube had that color at top before move.
    // For simplicity, we assume the top of 'to' was movedColor.
    const to = this.tubes[toIdx];
    const from = this.tubes[fromIdx];
    // remove from to
    const idx = to.contents.indexOf(movedColor);
    if (idx !== -1) {
      to.contents.splice(idx, 1);
    }
    // add to from (top)
    from.push(movedColor);
    this.moves--;
  }

  hint() {
    if (this.hintCount <= 0) return;
    // find a valid pour
    for (let i = 0; i < this.tubes.length; i++) {
      if (this.tubes[i].isEmpty()) continue;
      const srcColor = this.tubes[i].topColor();
      for (let j = 0; j < this.tubes.length; j++) {
        if (i === j) continue;
        const dst = this.tubes[j];
        if (dst.isEmpty() || dst.topColor() === srcColor) {
          // valid move
          this.hintCount--;
          this.pour(i, j);
          return;
        }
      }
    }
  }

  // other methods...
}
```

