```js
class Tube {
  constructor(id, initialColors = []) {
    this.id = id;
    this.x = 0; // will be set by renderer
    this.y = 0;
    this.width = 80;
    this.height = 300; // max height 4 units * unitHeight
    this.units = 4; // capacity
    this.contents = []; // array of colors, top is last element
    this.populate(initialColors);
    this.unitHeight = 75; // pixel per unit
  }
  populate(colors) {
    // initialColors is array of colors for each unit from bottom to top?
    // We'll assume colors array length = units, each element is color of that unit.
    this.contents = colors.slice();
  }
  topColor() {
    return this.contents.length ? this.contents[this.contents.length - 1] : 'transparent';
  }
  isEmpty() {
    return this.contents.length === 0;
  }
  push(color) {
    this.contents.push(color);
  }
  pop() {
    return this.contents.pop();
  }
  draw(ctx) {
    // draw tube body
    ctx.fillStyle = '#555';
    ctx.fillRect(this.x, this.y, this.width, this.height);
    // draw liquid
    const unitH = this.unitHeight;
    for (let i = 0; i < this.contents.length; i++) {
      const color = this.contents[i];
      ctx.fillStyle = color;
      ctx.fillRect(this.x, this.y + i * unitH, this.width, unitH);
    }
    // draw top highlight (gradient)
    // maybe simple border
  }
}
