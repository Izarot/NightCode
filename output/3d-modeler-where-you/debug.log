```javascript
const TILE_W = 64;
const TILE_H = 32;

class Renderer {
  constructor(canvas) {
    this.canvas = canvas;
    this.ctx = canvas.getContext('2d');
    this.particles = [];
  }
  
  project(wx, wy, wz) {
    const cam = window.__state.camera;
    const sx = (wx - wz) * TILE_W / 2;
    const sy = (wx + wz) * TILE_H / 2 - wy * TILE_H;
    return {
      x: sx * cam.zoom + cam.x,
      y: sy * cam.zoom + cam.y
    };
  }
  
  drawGrid(grid) {
    const ctx = this.ctx;
    const cam = window.__state.camera;
    ctx.save();
    ctx.translate(cam.x, cam.y);
    ctx.scale(cam.zoom, cam.zoom);
    
    // Floor plane
    ctx.strokeStyle = 'rgba(100,100,150,0.3)';
    ctx.lineWidth = 0.5;
    for (let i = -16; i <= 16; i++) {
      const p1 = this.project(-16, 0, i);
      const p2 = this.project(16, 0, i);
      ctx.beginPath(); ctx.moveTo(p1.x, p1.y); ctx.lineTo(p2.x, p2.y); ctx.stroke();
      
      const p3 = this.project(i, 0, -16);
      const p4 = this.project(i, 0, 16);
      ctx.beginPath(); ctx.moveTo(p3.x, p3.y); ctx.lineTo(p4.x, p4.y); ctx.stroke();
    }
    
    // Axis indicators
    ctx.strokeStyle = 'rgba(255,0,0,0.5)';
    ctx.beginPath(); ctx.moveTo(this.project(-16,0,-16).x, this.project(-16,0,-16).y); ctx.lineTo(this.project(16,0,-16).x, this.project(16,0,-16).y); ctx.stroke();
    ctx.strokeStyle = 'rgba(0,255,0,0.5)';
    ctx.beginPath(); ctx.moveTo(this.project(-16,0,-16).x, this.project(-0,0,-16).y); ctx.lineTo(this.project(16,0,-16).x, this.project(16,0,-16).y); ctx.stroke();
    
    ctx.restore();
  }
  
  drawVoxels(grid) {
    const ctx = this.ctx;
    const cam = window.__state.camera;
    
    // Collect all visible faces
    const faces = [];
    grid.forEach((v) => {
      if (!v.occupied || !v.visible) return;
      const proj = this.project(v.x, v.y, v.z);
      const facesData = this.getFaces(v);
      for (const f of facesData) {
        faces.push({ ...f, voxel: v, proj });
      }
    });
    
    // Sort by depth (screen Y ascending = far first)
    faces.sort((a, b) => a.proj.y - b.proj.y);
    
    for (const f of faces) {
      this.drawFace(f);
    }
  }
  
  getFaces(v) {
    const hw = TILE_W / 2;
    const hh = TILE_H / 2;
    const base = this.project(v.x, v.y, v.z);
    const top = this.project(v.x, v.y + 1, v.z);
    const bot = this.project(v.x, v.y - 1, v.z);
    const lft = this.project(v.x - 1, v.y, v.z);
    const rgt = this.project(v.x + 1, v.y, v.z);
    const fwd = this.project(v.x, v.y, v.z + 1);
    const bck = this.project(v.x, v.y, v.z - 1);
    
    return [
      { type: 'top', pts: [base, top, top, top], mat: v.faces.top },
      { type: 'bottom', pts: [bot, bot, bot, bot], mat: v.faces.bottom },
      { type: 'left', pts: [lft, lft, base, base], mat: v.faces.left },
      { type: 'right', pts: [rgt, rgt, base, base], mat: v.faces.right },
      { type: 'front', pts: [base, fwd, fwd, base], mat: v.faces.front },
      { type: 'back', pts: [base, bck, bck, base], mat: v.faces.back },
    ];
  }
  
  drawFace(f) {
    const ctx = this.ctx;
    const cam = window.__state.camera;
    const m = MATERIALS[f.mat] || MATERIALS[0];
    const intensity = this.getLightIntensity(f.type);
    
    ctx.save();
    ctx.translate(cam.x, cam.y);
    ctx.scale(cam.zoom, cam.zoom);
    
    // Apply lighting
    const litColor = this.applyLighting(m.color, intensity);
    
    ctx.fillStyle = litColor;
    ctx.strokeStyle = 'rgba(0,0,0,0.3)';
    ctx.lineWidth = 0.5;
    
    if (m.transparent) {
      ctx.globalAlpha = 0.6;
    }
    
    ctx.beginPath();
    ctx.moveTo(f.pts[0].x, f.pts[0].y);
    for (let i = 1; i < f.pts.length; i++) {
      ctx.lineTo(f.pts[i].x, f.pts[i].y);
    }
    ctx.closePath();
    ctx.fill();
    ctx.stroke();
    
    // Emissive glow
    if (m.emissive) {
      ctx.shadowColor = m.color;
      ctx.shadowBlur = 8;
      ctx.fill();
    }
    
    ctx.restore();
  }
  
  getLightIntensity(type) {
    switch(type) {
      case 'top': return 1.0;
      case 'left': return 0.7;
      case 'right': return 0.4;
      default: return 0.5;
    }
  }
  
  applyLighting(color, intensity) {
    // Simple brightness adjustment
    const r = parseInt(color.substr(1,2), 16);
