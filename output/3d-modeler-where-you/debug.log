javascript
const TILE_W = 64;
const TILE_H = 32;

class Renderer {
  constructor(canvas) {
    this.canvas = canvas;
    this.ctx = canvas.getContext('2d');
    this.particles = [];
  }
  
  project(wx, wy, wz) {
    const cam = window.__state.camera;
    const sx = (wx - wz) * TILE_W / 2;
    const sy = (wx + wz) * TILE_H / 2 - wy * TILE_H;
    return { x: sx * cam.zoom + cam.x, y: sy * cam.zoom + cam.y };
  }
  
  drawGrid(grid) {
    const ctx = this.ctx;
    const cam = window.__state.camera;
    ctx.save();
    ctx.translate(cam.x, cam.y);
    ctx.scale(cam.zoom, cam.zoom);
    
    // Floor grid lines
    ctx.strokeStyle = 'rgba(80,80,120,0.25)';
    ctx.lineWidth = 0.5;
    for (let i = -16; i <= 16; i++) {
      const p1 = this.project(-16, 0, i);
      const p2 = this.project(16, 0, i);
      ctx.beginPath(); ctx.moveTo(p1.x, p1.y); ctx.lineTo(p2.x, p2.y); ctx.stroke();
      
      const p3 = this.project(i, 0, -16);
      const p4 = this.project(i, 0, 16);
      ctx.beginPath(); ctx.moveTo(p3.x, p3.y); ctx.lineTo(p4.x, p4.y); ctx.stroke();
    }
    
    // Axis indicators
    ctx.font = '14px sans-serif';
    ctx.fillStyle = 'rgba(255,80,80,0.6)';
    ctx.fillText('X', this.project(16, 0, -16).x + 4, this.project(16, 0, -16).y);
    ctx.fillStyle = 'rgba(80,255,80,0.6)';
    ctx.fillText('Z', this.project(-16, 0, 16).x + 4, this.project(-16, 0, 16).y);
    
    ctx.restore();
  }
  
  drawVoxels(grid) {
    const ctx = this.ctx;
    const cam = window.__state.camera;
    
    const faces = [];
    grid.forEach((v) => {
      if (!v.occupied || !v.visible) return;
      const proj = this.project(v.x, v.y, v.z);
      const f = this.getFaces(v);
      for (const face of f) {
        faces.push({ ...face, voxel: v, proj });
      }
    });
    
    faces.sort((a, b) => a.proj.y - b.proj.y);
    
    for (const face of faces) {
      this.drawFace(face);
    }
  }
  
  getFaces(v) {
    const base = this.project(v.x, v.y, v.z);
    const top = this.project(v.x, v.y + 1, v.z);
    const bot = this.project(v.x, v.y - 1, v.z);
    const lft = this.project(v.x - 1, v.y, v.z);
    const rgt = this.project(v.x + 1, v.y, v.z);
    const fwd = this.project(v.x, v.y, v.z + 1);
    const bck = this.project(v.x, v.y, v.z - 1);
    
    return [
      { type: 'top', pts: [base, top, top, top], mat: v.faces.top },
      { type: 'bottom', pts: [bot, bot, bot, bot], mat: v.faces.bottom },
      { type: 'left', pts: [lft, lft, base, base], mat: v.faces.left },
      { type: 'right', pts: [rgt, rgt, base, base], mat: v.faces.right },
      { type: 'front', pts: [base, fwd, fwd, base], mat: v.faces.front },
      { type: 'back', pts: [base, bck, bck, base], mat: v.faces.back },
    ];
  }
  
  drawFace(face) {
    const ctx = this.ctx;
    const cam = window.__state.camera;
    const m = MATERIALS[face.mat] || MATERIALS[0];
    const intensity = this.getLightIntensity(face.type);
    
    ctx.save();
    ctx.translate(cam.x, cam.y);
    ctx.scale(cam.zoom, cam.zoom);
    
    const litColor = this.applyLighting(m.color, intensity);
    
    ctx.fillStyle = litColor;
    ctx.strokeStyle = 'rgba(0,0,0,0.25)';
    ctx.lineWidth = 0.5;
    
    if (m.transparent) ctx.globalAlpha = 0.5;
    
    ctx.beginPath();
    ctx.moveTo(face.pts[0].x, face.pts[0].y);
    for (let i = 1; i < face.pts.length; i++) {
      ctx.lineTo(face.pts[i].x, face.pts[i].y);
    }
    ctx.closePath();
    ctx.fill();
    ctx.stroke();
    
    if (m.emissive) {
      ctx.shadowColor = m.color;
      ctx.shadowBlur = 6;
      ctx.fill();
    }
    
    ctx.restore();
  }
  
  getLightIntensity(type) {
    switch (type) {
      case 'top': return 1.0;
      case 'left': return 0.7;
      case 'right': return 0.4;
      default: return 0.5;
    }
  }
  
  applyLighting(hex, intensity) {
    const r = parseInt(hex.substr(1, 2), 16);
    const g = parseInt(hex.substr(3, 2), 16);
    const b = parseInt(hex.substr(5, 2), 16);
    return `rgb(${Math.round(r * intensity)},${Math.round(g * intensity)},${Math.round(b * intensity)})`;
  }
  
  addParticles(wx, wy, wz, color) {
    for (let i = 0; i < 4; i++) {
      this.particles.push({
        x: wx + (Math.random() - 0.5) * 0.5,
        y: wy + (Math.random() - 0.5) * 0.5,
        z: wz + (Math.random() - 0.5) * 0.5,
        vx: (Math.random() - 0.5) * 0.1,
        vy: Math.random() * 0.1,
        vz: (Math.random() - 0.5) * 0.1,
        life: 1.0,
        color,
      });
    }
  }
  
  updateParticles(dt) {
    for (let i = this.particles.length - 1; i >= 0; i--) {
      const p = this.particles[i];
      p.x += p.vx;
      p.y += p.vy;
      p.z += p.vz;
      p.vy -= 0.002;
      p.life -= dt * 2;
      if (p.life <= 0) this.particles.splice(i, 1);
    }
  }
  
  drawParticles() {
    const ctx = this.ctx;
    const cam = window.__state.camera;
    ctx.save();
    ctx.translate(cam.x, cam.y);
    ctx.scale(cam.zoom, cam.zoom);
    for (const p of this.particles) {
      const proj = this.project(p.x, p.y, p.z);
      ctx.globalAlpha = p.life * 0.8;
      ctx.fillStyle = p.color;
      ctx.beginPath();
      ctx.arc(proj.x, proj.y, 2, 0, Math.PI * 2);
      ctx.fill();
    }
    ctx.restore();
  }
  
  resize(w, h) {
    this.canvas.width = w;
    this.canvas.height = h;
  }
}


