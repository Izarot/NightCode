class Voxel {
  constructor(x, y, z) {
    this.x = x; this.y = y; this.z = z;
    this.occupied = false;
    this.materialId = 0;
    this.faces = { top: 0, bottom: 0, left: 0, right: 0, front: 0, back: 0 };
    this.visible = true;
    this.lighting = 0;
  }
}

class VoxelGrid {
  constructor(size = 32) {
    this.size = size;
    this.voxels = new Map();
    this.layerVisibility = new Array(size).fill(true);
    this.layerLocked = new Array(size).fill(false);
  }
  
  key(x, y, z) { return `${x},${y},${z}`; }
  
  get(x, y, z) {
    if (x < 0 || x >= this.size || y < 0 || y >= this.size || z < 0 || z >= this.size) return null;
    return this.voxels.get(this.key(x, y, z));
  }
  
  set(x, y, z, v) {
    if (x < 0 || x >= this.size || y < 0 || y >= this.size || z < 0 || z >= this.size) return false;
    const k = this.key(x, y, z);
    if (!this.voxels.has(k)) this.voxels.set(k, new Voxel(x, y, z));
    this.voxels.get(k).occupied = v.occupied;
    this.voxels.get(k).materialId = v.materialId;
    this.voxels.get(k).faces = { ...v.faces };
    this.voxels.get(k).visible = v.visible;
    return true;
  }
  
  remove(x, y, z) {
    const k = this.key(x, y, z);
    if (this.voxels.has(k)) this.voxels.delete(k);
  }
  
  count() { return this.voxels.size; }
  
  forEach(fn) {
    for (const v of this.vovels.values()) fn(v);
  }
}
