function applyTool(tool, grid, mouse, state) {
  if (tool === 'select') {
    // Selection logic
    const voxel = worldFromMouse(mouse, grid);
    if (voxel) {
      state.selectedVoxels = [voxel];
    }
  } else if (tool === 'sculpt') {
    const voxel = worldFromMouse(mouse, grid);
    if (voxel && !voxel.occupied) {
      grid.set(voxel.x, voxel.y, voxel.z, { occupied: true, materialId: state.activeMaterial });
      state.history.push({ action: 'add', pos: [voxel.x, voxel.y, voxel.z] });
      state.history.push({ action: 'faces', pos: [voxel.x, voxel.y, voxel.z], faces: voxel.faces });
      state.historyIndex = state.history.length;
    }
  } else if (tool === 'erase') {
    const voxel = worldFromMouse(mouse, grid);
    if (voxel && voxel.occupied) {
      grid.remove(voxel.x, voxel.y, voxel.z);
      state.history.push({ action: 'remove', pos: [voxel.x, voxel.y, voxel.z] });
      state.historyIndex = state.history.length;
    }
  } else if (tool === 'paint') {
    const voxel = worldFromMouse(mouse, grid);
