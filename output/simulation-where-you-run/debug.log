const canvas = document.getElementById('gameCanvas');
const ctx = canvas.getContext('2d');
const dpr = window.devicePixelRatio || 1;
function resize() {
  const w = 1280;
  const h = 720;
  canvas.width = w * dpr;
  canvas.height = h * dpr;
  ctx.scale(dpr, dpr);
}
window.addEventListener('resize', resize);
resize();

const LOGICAL_WIDTH = 1280;
const LOGICAL_HEIGHT = 720;

// Colors
const COLORS = {
  bg: '#fafafa',
  player: '#42a5f5',
  prep: '#8d6e63',
  oven: '#e53935',
  serve: '#66bb6a',
  customer: '#fdd835',
  pizzaBase: '#ffe0b2',
  sauce: '#b71c1c',
  cheese: '#fff9c4',
  topping: {
    pepperoni: '#d32f2f',
    mushroom: '#6d4c41',
    olive: '#827717',
    pepper: '#ef6c00',
    pineapple: '#ffeb3b'
  }
};

// Input
const keys = {};
window.addEventListener('keydown', e => { keys[e.key.toLowerCase()] = true; });
window.addEventListener('keyup', e => { keys[e.key.toLowerCase()] = false; });

// Game state
let day = 1;
let coins = 0;
let highScore = loadHighScore();
let gameTime = 0; // seconds
let paused = false;
let lastTimestamp = 0;

// Entities
class Entity { constructor(id){ this.id = id; } }
class Player extends Entity {
  constructor(){ super('player'); this.x = LOGICAL_WIDTH/2; this.y = LOGICAL_HEIGHT-50; this.radius = 20; this.speed = 200; this.vx=0; this.vy=0; this.holding=null; }
  update(dt){
    const acc = 400;
    const friction = 8;
    let ax=0, ay=0;
    if(keys['w']||keys['arrowup']) ay-=1;
    if(keys['s']||keys['arrowdown']) ay+=1;
    if(keys['a']||keys['arrowleft']) ax-=1;
    if(keys['d']||keys['arrowright']) ax+=1;
    const len = Math.hypot(ax,ay);
    if(len>0){ ax/=len; ay/=len; }
    this.vx += ax*acc*dt;
    this.vy += ay*acc*dt;
    this.vx *= 1 - friction*dt;
    this.vy *= 1 - friction*dt;
    const maxSp = 200;
    const sp = Math.hypot(this.vx,this.vy);
    if(sp>maxSp){ const scale=maxSp/sp; this.vx*=scale; this.vy*=scale; }
    this.x += this.vx*dt;
    this.y += this.vy*dt;
    // bounds
    if(this.x<this.radius) this.x=this.radius;
    if(this.x>LOGICAL_WIDTH-this.radius) this.x=LOGICAL_WIDTH-this.radius;
    if(this.y<this.radius) this.y=this.radius;
    if(this.y>LOGICAL_HEIGHT-this.radius) this.y=LOGICAL_HEIGHT-this.radius;
  }
  draw(ctx){
    ctx.save();
    ctx.translate(this.x,this.y);
    ctx.fillStyle = COLORS.player;
    ctx.beginPath();
    ctx.arc(0,0,this.radius,0,Math.PI*2);
    ctx.fill();
    ctx.restore();
  }
}
class Station {
  constructor(x,y,width,height,type,color){
    this.x=x; this.y=y; this.width=width; this.height=height; this.type=type; this.color=color;
  }
  contains(px,py){ return px>=this.x && px<=this.x+this.width && py>=this.y && py<=this.y+this.height; }
  draw(ctx){
    ctx.fillStyle=this.color;
    ctx.fillRect(this.x,this.y,this.width,this.height);
    ctx.strokeStyle='#555';
    ctx.strokeRect(this.x,this.y,this.width,this.height);
    ctx.fillStyle='#fff';
    ctx.font='16px sans-serif';
    ctx.fillText(this.type,this.x+10,this.y+20);
  }
}
const stations = [
  new Station(100, LOGICAL_HEIGHT-150, 200, 80, 'Prep', COLORS.prep),
  new Station(LOGICAL_WIDTH/2-60, LOGICAL_HEIGHT-150, 120, 80, 'Oven', COLORS.oven),
  new Station(LOGICAL_WIDTH-300, LOGICAL_HEIGHT-150, 200, 80, 'Serve', COLORS.serve)
];

class Customer {
  constructor(){ super('customer'); this.x = -50; this.y = LOGICAL_HEIGHT/2; this.targetX = 100; this.state='walking'; this.patience=30; this.order=null; this.served=false; }
  update(dt){
    if(this.state==='walking'){
      if(this.x<this.targetX){ this.x+=100*dt; if(this.x>=this.targetX){ this.x=this.targetX; this.state='waiting'; } }
    }else if(this.state==='waiting'){
      this.patience-=dt;
      if(this.patience<=0){ this.state='leaving'; }
    }else if(this.state==='leaving'){
      this.x+=150*dt;
      if(this.x>LOGICAL_WIDTH+50){ return 'removed'; }
    }
    return null;
  }
  draw(ctx){
    ctx.fillStyle=COLORS.customer;
    ctx.beginPath();
    ctx.arc(this.x,this.y,20,0,Math.PI*2);
    ctx.fill();
    ctx.fillStyle='#000';
    ctx.font='12px sans-serif';
    ctx.fillText('C',this.x-4,this.y+4);
    // patience bar
    ctx.fillStyle='#555';
    ctx.fillRect(this.x-20,this.y-30,40,5);
    ctx.fillStyle=COLORS.customer;
    ctx.fillRect(this.x-20,this.y-30,40*(this.patience/30),5);
  }
}

// Order generation
const sizes = ['SM','MD','LG'];
const sauces = ['Tomato','BBQ','Pesto'];
const cheeses = ['None','Light','Normal','Extra'];
const toppingsList = ['Pepperoni','Mushroom','Olive','Pepper','Pineapple'];
const toppingMod = {
  Pepperoni:0.10,
  Mushroom:0.05,
  Olive:0.03,
  Pepper:0.07,
  Pineapple:0.25
};
function generateOrder(){
  const size = sizes[Math.floor(Math.random()*sizes.length)];
  const sauce = sauces[Math.floor(Math.random()*sauces.length)];
  const cheese = cheeses[Math.floor(Math.random()*cheeses.length)];
  const numToppings = Math.floor(Math.random()*4); // 0-3
  const toppings = [];
  for(let i=0;i<numToppings;i++){
    const t = toppingsList[Math.floor(Math.random()*toppingsList.length)];
    if(!toppings.includes(t)) toppings.push(t);
  }
  return {size,sauce,cheese,toppings};
}
let currentOrder = generateOrder();
let customer = new Customer();

// Pizza being prepared
class Pizza {
  constructor(){ super('pizza'); this.base=null; this.sauce=null; this.cheese=null; this.toppings=[]; this.state='empty'; this.progress=0; this.cookTime=0; }
  reset(){ this.base=null; this.sauce=null; this.cheese=null; this.toppings=[]; this.state='empty'; this.progress=0; this.cookTime=0; }
}
const pizza = new Pizza();

// Topping palette UI (drawn as rects)
const palette = [
  {name:'Pepperoni',color:COLORS.topping.pepperoni,x:LOGICAL_WIDTH/2-150,y:LOGICAL_HEIGHT-80,w:40,h:40},
  {name:'Mushroom',color:COLORS.topping.mushroom,x:LOGICAL_WIDTH/2-100,y:LOGICAL_HEIGHT-80,w:40,h:40},
  {name:'Olive',color:COLORS.topping.olive,x:LOGICAL_WIDTH/2-50,y:LOGICAL_HEIGHT-80,w:40,h:40},
  {name:'Pepper',color:COLORS.topping.pepper,x:LOGICAL_WIDTH/2,y:LOGICAL_HEIGHT-80,w:40,h:40},
  {name:'Pineapple',color:COLORS.topping.pineapple,x:LOGICAL_WIDTH/2+50,y:LOGICAL_HEIGHT-80,w:40,h:40}
];
let selectedTopping = null;

// Interaction
function checkInteraction(){
  // if player near prep station and presses E, allow topping selection
  const prep = stations[0];
  if(prep.contains(player.x,player.y)){
    if(keys['e']){
      // toggle topping selection mode? We'll just set selectedTopping based on click later
    }
  }
}

// Mouse for selecting topping and placing
let mouse = {x:0,y:0,down:false};
canvas.addEventListener('mousedown', e=>{ const rect=canvas.getBoundingClientRect(); mouse.x=(e.clientX-rect.left)/dpr; mouse.y=(e.clientY-rect.top)/dpr; mouse.down=true; });
canvas.addEventListener('mouseup', e=>{ mouse.down=false; });
canvas.addEventListener('mousemove', e=>{ const rect=canvas.getBoundingClientRect(); mouse.x=(e.clientX-rect.left)/dpr; mouse.y=(e.clientY-rect.top)/dpr; });

function handleMouse(){
  if(mouse.down){
    // check palette selection
    for(const p of palette){
      if(mouse.x>=p.x && mouse.x<=p.x+p.w && mouse.y>=p.y && mouse.y<=p.y+p.h){
        selectedTopping = p.name;
        break;
      }
    }
    // if over pizza and have selected topping, add to pizza
    // simple pizza area: center
    const pizzaCenterX = LOGICAL_WIDTH/2;
    const pizzaCenterY = LOGICAL_HEIGHT/2-50;
    const pizzaRadius = 60;
    const dx = mouse.x-pizzaCenterX;
    const dy = mouse.y-pizzaCenterY;
    if(Math.hypot(dx,dy)<=pizzaRadius && selectedTopping){
      pizza.toppings.push(selectedTopping);
      selectedTopping = null;
      playSFX('topping');
    }
    // if over oven and pizza ready to cook
    const oven = stations[1];
    if(oven.contains(mouse.x,mouse.y) && pizza.state==='prepared'){
      pizza.state='cooking';
      pizza.progress=0;
      // compute cook time
      const baseTimes = {SM:8, MD:12, LG:16};
      let base = baseTimes[pizza.base||'MD']; // default
      let modSum = 0;
      for(const t of pizza.toppings){
        modSum += toppingMod[t]||0;
      }
      pizza.cookTime = base*(1+modSum);
      playSFX('oven');
    }
    // if over serve and pizza cooked
    const serve = stations[2];
    if(serve.contains(mouse.x,mouse.y) && pizza.state==='ready'){
      servePizza();
    }
  }
}
function servePizza(){
  // compute accuracy
  const expected = currentOrder;
  let accuracy = 100;
  // sauce
  if(pizza.sauce!==expected.sauce) accuracy-=20;
  // cheese
  if(pizza.cheese!==expected.cheese) accuracy-=20;
  // toppings: missing or extra
  const expectedSet = new Set(expected.toppings);
  const actualSet = new Set(pizza.toppings);
  for(const t of expectedSet){
    if(!actualSet.has(t)) accuracy-=10;
  }
  for(const t of actualSet){
    if(!expectedSet.has(t)) accuracy-=5;
  }
  if(accuracy<0) accuracy=0;
  // timeliness: we don't have wait time, just give full
  const timeliness = 100;
  const satisfaction = (accuracy+timeliness)/2;
  const baseReward = {SM:10, MD:15, LG:20};
  const earned = Math.floor(baseReward[expected.size]*(satisfaction/100));
  coins+=earned;
  if(coins>highScore){ highScore=coins; saveHighScore(highScore); }
  // reset
  pizza.reset();
  currentOrder = generateOrder();
  customer = new Customer();
  playSFX('coin');
}

// Simple audio using Web Audio API
const audioCtx = new (window.AudioContext||window.webkitAudioContext)();
function playSFX(type){
  const osc = audioCtx.createOscillator();
  const gain = audioCtx.createGain();
  osc.connect(gain).connect(audioCtx.destination);
  const now = audioCtx.currentTime;
  gain.gain.setValueAtTime(0,now);
  gain.gain.linearRampToValueAtTime(0.2,now+0.01);
  gain.gain.exponentialRampToValueAtTime(0.001,now+0.3);
  switch(type){
    case 'topping': osc.frequency.setValueAtTime(400,now); break;
    case 'oven': osc.frequency.setValueAtTime(200,now); break;
    case 'coin': osc.frequency.setValueAtTime(600,now); break;
    default: osc.frequency.setValueAtTime(300,now);
  }
  osc.start(now);
  osc.stop(now+0.5);
}

// Game loop
function timestamp(t){
  if(!lastTimestamp) lastTimestamp = t;
  const dt = (t - lastTimestamp)/1000; // seconds
  lastTimestamp = t;
  if(!paused){
    update(dt);
    render();
  }
  requestAnimationFrame(timestamp);
}
function update(dt){
  gameTime+=dt;
  player.update(dt);
  checkInteraction();
  handleMouse();
  // customer update
  const res = customer.update(dt);
  if(res==='removed'){
    // customer left without being served -> penalty
    coins = Math.max(0,coins-10);
    customer = new Customer();
    currentOrder = generateOrder();
  }
  // pizza cooking progress
  if(pizza.state==='cooking'){
    pizza.progress += dt/pizza.cookTime;
    if(pizza.progress>=1){
      pizza.state='ready';
      playSFX('ready');
    }else if(pizza.progress>1.2){
      pizza.state='burnt';
      playSFX('burnt');
    }
  }
}
function render(){
  ctx.clearRect(0,0,LOGICAL_WIDTH,LOGICAL_HEIGHT);
  // background
  ctx.fillStyle=COLORS.bg;
  ctx.fillRect(0,0,LOGICAL_WIDTH,LOGICAL_HEIGHT);
  // stations
  for(const s of stations) s.draw(ctx);
  // player
  player.draw(ctx);
  // customer
  customer.draw(ctx);
  // order display
  ctx.fillStyle='#000';
  ctx.font='16px sans-serif';
  ctx.fillText(`Order: ${currentOrder.size} ${currentOrder.sauce} ${currentOrder.cheese} ${currentOrder.toppings.join(', ')||'none'}`,20,30);
  // pizza
  const px = LOGICAL_WIDTH/2;
  const py = LOGICAL_HEIGHT/2-50;
  const radius = 60;
  ctx.fillStyle = pizza.base?COLORS.pizzaBase:'#ccc';
  ctx.beginPath();
  ctx.arc(px,py,radius,0,Math.PI*2);
  ctx.fill();
  // sauce
  if(pizza.sauce){
    ctx.fillStyle = COLORS.sauce;
    ctx.beginPath();
    ctx.arc(px,py,radius*0.8,0,Math.PI*2);
    ctx.fill();
  }
  // cheese
  if(pizza.cheese && pizza.cheese!=='None'){
    ctx.fillStyle = COLORS.cheese;
    // draw sprinkles as small circles
    for(let i=0;i<15;i++){
      const angle = Math.random()*Math.PI*2;
      const r = radius*0.6+Math.random()*10;
      ctx.beginPath();
      ctx.arc(px+Math.cos(angle)*r, py+Math.sin(angle)*r, 2,0,Math.PI*2);
      ctx.fill();
    }
  }
  // toppings
  for(const t of pizza.toppings){
    const color = COLORS.topping[t]||'#999';
    // place randomly on pizza
    const angle = Math.random()*Math.PI*2;
    const r = radius*0.5+Math.random()*20;
    ctx.fillStyle=color;
    ctx.beginPath();
    ctx.arc(px+Math.cos(angle)*r, py+Math.sin(angle)*r, 5,0,Math.PI*2);
    ctx.fill();
  }
  // cooking progress ring
  if(pizza.state==='cooking'||pizza.state==='ready'){
    ctx.strokeStyle = '#0f0';
    ctx.lineWidth = 4;
    ctx.beginPath();
    ctx.arc(px,py,radius+10, -Math.PI/2, -Math.PI/2 + 2*Math.PI*pizza.progress);
    ctx.stroke();
  }
  // palette
  for(const p of palette){
    ctx.fillStyle = p.color;
    ctx.fillRect(p.x,p.y,p.w,p.h);
    ctx.strokeStyle='#000';
    ctx.strokeRect(p.x,p.y,p.w,p.h);
    ctx.fillStyle='#000';
    ctx.font='12px sans-serif';
    ctx.fillText(p.name,p.x,p.y-5);
  }
  if(selectedTopping){
    ctx.strokeStyle='#ff0';
    ctx.lineWidth=3;
    for(const p of palette){
      if(p.name===selectedTopping){
        ctx.strokeRect(p.x,p.y,p.w,p.h);
        break;
      }
    }
  }
  // HUD
  ctx.fillStyle='#000';
  ctx.font='20px sans-serif';
  ctx.fillText(`Day: ${day}`,20,LOGICAL_HEIGHT-20);
  ctx.fillText(`Coins: ${coins}`,20,LOGICAL_HEIGHT-50);
  ctx.fillText(`High Score: ${highScore}`,20,LOGICAL_HEIGHT-80);
  // timer
  const mins = Math.floor(gameTime/60).toString().padStart(2,'0');
  const secs = Math.floor(gameTime%60).toString().padStart(2,'0');
  ctx.fillText(`Time: ${mins}:${secs}`,LOGICAL_WIDTH-120,30);
}
function loadHighScore(){
  const val = localStorage.getItem('pizzaRushHighScore');
  return val ? parseInt(val,10) : 0;
}
function saveHighScore(val){
  localStorage.setItem('pizzaRushHighScore',val);
}
