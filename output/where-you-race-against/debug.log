{"index.html":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no\">\n  <meta name=\"theme-color\" content=\"#0A0A1A\">\n  <meta name=\"description\" content=\"Ghost Racer - Race against your best lap time\">\n  <title>Ghost Racer</title>\n  <link rel=\"icon\" href=\"data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ctext y='.9em' font-size='90'%3E🏎️%3C/text%3E%3C/svg%3E\">\n  <link rel=\"manifest\" href=\"manifest.json\">\n  <link href=\"https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700&family=Exo+2:wght@400;700&display=swap\" rel=\"stylesheet\">\n  <link rel=\"stylesheet\" href=\"css/game.css\">\n</head>\n<body>\n  <canvas id=\"gameCanvas\"></canvas>\n  <div id=\"uiLayer\"></div>\n  <script src=\"js/ui/hud.js\"></script>\n  <script src=\"js/ui/menu.js\"></script>\n  <script src=\"js/systems/audio.js\"></script>\n  <script src=\"js/systems/track.js\"></script>\n  <script src=\"js/systems/ghost.js\"></script>\n  <script src=\"js/systems/physics.js\"></script>\n  <script src=\"js/core/renderer.js\"></script>\n  <script src=\"js/core/input.js\"></script>\n  <script src=\"js/core/game.js\"></script>\n  <script>if('serviceWorker' in navigator){navigator.serviceWorker.register('service-worker.js');}</script>\n</body>\n</html>","css/game.css":"*{margin:0;padding:0;box-sizing:border-box;}\nbody{background:#0A0A1A;overflow:hidden;font-family:'Exo 2',sans-serif;touch-action:none;}\ncanvas{display:block;width:100vw;height:100vh;}\n#uiLayer{position:absolute;top:0;left:0;width:100%;height:100%;pointer-events:none;}\n.hud{position:absolute;pointer-events:none;}\n#speedometer{top:10px;right:10px;width:120px;height:120px;}\n#lapTimer{top:10px;left:50%;transform:translateX(-50%);font-family:'Orbitron',monospace;font-size:24px;color:#00D4FF;text-align:center;}\n#ghostDelta{top:48px;left:50%;transform:translateX(-50%);font-family:'Orbitron',monospace;font-size:14px;color:#B800FF;text-align:center;}\n#minimap{bottom:10px;left:10px;width:150px;height:150px;}\n#mobileControls{display:none;position:absolute;bottom:20px;width:100%;height:120px;pointer-events:auto;}\n#joystick{position:absolute;left:20px;bottom:20px;width:120px;height:120px;background:rgba(255,255,255,0.1);border-radius:50%;border:2px solid #00D4FF;}\n#joystickKnob{position:absolute;top:50%;left:50%;width:50px;height:50px;background:#00D4FF;border-radius:50%;transform:translate(-50%,-50%);}\n#brakeBtn{position:absolute;right:20px;bottom:20px;width:90px;height:90px;background:rgba(255,0,0,0.3);border-radius:50%;border:2px solid #FF0000;color:#FFF;font-family:'Orbitron',monospace;font-size:16px;}\n#startOverlay,#pauseMenu,#lapModal{position:absolute;top:0;left:0;width:100%;height:100%;background:rgba(10,10,26,0.9);display:flex;flex-direction:column;align-items:center;justify-content:center;color:#FFF;pointer-events:auto;}\n#startOverlay h1{font-family:'Orbitron',monospace;font-size:48px;color:#00D4FF;margin-bottom:20px;}\n#startOverlay button{font-family:'Orbitron',monospace;font-size:20px;padding:12px 30px;margin:10px;background:#00D4FF;border:none;color:#0A0A1A;cursor:pointer;}\n#pauseMenu h2,#lapModal h2{font-family:'Orbitron',monospace;font-size:32px;color:#B800FF;margin-bottom:20px;}\n#lapModal p{font-size:18px;margin:8px 0;}\n.hidden{display:none!important;}\n@media(max-width:768px){#mobileControls{display:flex;}#startOverlay h1{font-size:32px;}#lapTimer{font-size:20px;}#ghostDelta{font-size:12px;}}","js/core/game.js":"const canvas=document.getElementById('gameCanvas');const ctx=canvas.getContext('2d');const ui=document.getElementById('uiLayer');let width,height;function resize(){width=canvas.width=window.innerWidth;height=canvas.height=window.innerHeight;}window.addEventListener('resize',resize);resize();\nconst GAME={state:'menu',lap:1,startTime:0,lapTime:0,ghostTime:null,delta:0,highScore:null,track:null,player:null,ghost:null,renderer:null,input:null,audio:null,hud:null,menu:null,particles:[],camera:{x:0,y:0,angle:0},lastFrame:0};\nGAME.highScore=parseFloat(localStorage.getItem('ghostRacerHighScore')||'0');\nGAME.audio=new AudioSystem();\nGAME.track=new TrackGenerator();\nGAME.input=new InputHandler();\nGAME.physics=new PhysicsSystem();\nGAME.ghost=new GhostSystem();\nGAME.renderer=new Renderer();\nGAME.hud=new HUD();\nGAME.menu=new Menu();\nGAME.menu.init();\nfunction gameLoop(timestamp){const dt=(timestamp-GAME.lastFrame)/16.67;GAME.lastFrame=timestamp;\nif(GAME.state==='playing'){GAME.physics.update(dt);GAME.ghost.update(dt);GAME.renderer.update(dt);}\nGAME.renderer.render(dt);requestAnimationFrame(gameLoop);}\nrequestAnimationFrame(gameLoop);","js/core/input.js":"class InputHandler{constructor(){this.keys={up:false,down:false,left:false,right:false,space:false};this.joystick={x:0,y:0,active:false};this.brake=false;this.touchDetected=false;this.setup();}\nsetup(){window.addEventListener('keydown',e=>{this.touchDetected=true;switch(e.code){case'ArrowUp':this.keys.up=true;break;case'ArrowDown':this.keys.down=true;break;case'ArrowLeft':this.keys.left=true;break;case'ArrowRight':this.keys.right=true;break;case'Space':this.keys.space=true;break;}});\nwindow.addEventListener('keyup',e=>{switch(e.code){case'ArrowUp':this.keys.up=false;break;case'ArrowDown':this.keys.down=false;break;case'ArrowLeft':this.keys.left=false;break;case'ArrowRight':this.keys.right=false;break;case'Space':this.keys.space=false;break;}});\nconst joy=document.getElementById('joystick');const knob=joy.querySelector('#joystickKnob');joy.addEventListener('touchstart',e=>{this.touchDetected=true;e.preventDefault();const rect=joy.getBoundingClientRect();const touch=e.touches[0];this.joystick.active=true;this.updateJoystick(touch,rect,knob);});\njoy.addEventListener('touchmove',e=>{e.preventDefault();const rect=joy.getBoundingClientRect();this.updateJoystick(e.touches[0],rect,knob);});\njoy.addEventListener('touchend',e=>{e.preventDefault();this.joystick.active=false;this.joystick.x=0;this.joystick.y=0;knob.style.transform=`translate(-50%,-50%)`;});\nconst brake=document.getElementById('brakeBtn');brake.addEventListener('touchstart',e=>{e.preventDefault();this.brake=true;});brake.addEventListener('touchend',e=>{e.preventDefault();this.brake=false;});}\nupdateJoystick(touch,rect,knob){const dx=touch.clientX-(rect.left+rect.width/2);const dy=touch.clientY-(rect.top+rect.height/2);const dist=Math.min(Math.hypot(dx,dy),60);const angle=Math.atan2(dy,dx);this.joystick.x=Math.cos(angle)*dist/60;this.joystick.y=Math.sin(angle)*dist/60;knob.style.transform=`translate(calc(-50% + ${Math.cos(angle)*dist}px),calc(-50% + ${Math.sin(angle)*dist}px))`;}}","js/core/renderer.js":"class Renderer{constructor(){this.bgStars=[];for(let i=0;i<200;i++)this.bgStars.push({x:Math.random()*2000,y:Math.random()*1500,s:Math.random()*2+0.5});}\nrender(dt){const{canvas,ctx,player,track,ghost}=GAME;ctx.fillStyle='#0A0A1A';ctx.fillRect(0,0,canvas.width,canvas.height);\nctx.save();ctx.translate(canvas.width/2-canvas.width*0.3,canvas.height/2-canvas.height*0.35);\nfor(const s of this.bgStars){ctx.fillStyle=`rgba(255,255,255,${s.s/3})`;ctx.beginPath();ctx.arc(s.x+player.x*0.02,s.y+player.y*0.02,s.s,0,Math.PI*2);ctx.fill();}\nctx.save();ctx.translate(-player.x,-player.y);ctx.strokeStyle='#2A2A2A';ctx.lineWidth=120;ctx.lineCap='round';ctx.lineJoin='round';ctx.beginPath();track.draw(ctx);ctx.stroke();\nctx.strokeStyle='#CCCCCC';ctx.lineWidth=4;ctx.beginPath();track.draw(ctx);ctx.stroke();ctx.restore();\nif(ghost)ghost.render(ctx);if(player){player.render(ctx);this.renderParticles();}\nctx.restore();}\nupdate(dt){const{player}=GAME;for(let i=player.particles.length-1;i>=0;i--){const p=player.particles[i];p.x+=p.vx;p.y+=p.vy;p.life-=dt;p.alpha=p.life/p.maxLife;if(p.alpha<=0)player.particles.splice(i,1);}}\nrenderParticles(){const{player,ctx}=GAME;for(const p of player.particles){ctx.fillStyle=`rgba(200,200,200,${p.alpha})`;ctx.beginPath();ctx.arc(p.x,p.y,p.size,0,Math.PI*2);ctx.fill();}}","js/systems/physics.js":"class PhysicsSystem{constructor(){this.checkpoints=[];}\nupdate(dt){const{player,track,ghost}=GAME;if(!player)return;\nlet accel=0;if(player.input.keys.up)accel=0.3;if(player.input.keys.down)accel=-0.15;if(player.input.brake)accel=-0.5;\nplayer.vx+=accel*dt;player.vx*=0.95;player.vx=Math.max(Math.min(player.vx,8),-4);\nconst speed=Math.hypot(player.vx,player.vy);const turnSpeed=speed<4?0.04:0.02;\nlet turn=0;if(player.input.keys.left)turn=-1;if(player.input.keys.right)turn=1;\nif(player.input.joystick.active){turn=player.input.joystick.x;}if(turn!==0){player.angle+=turn*turnSpeed*dt;}\nplayer.vy=player.vx*Math.sin(player.angle);player.vx=player.vx*Math.cos(player.angle);\nplayer.x+=player.vx*dt;player.y+=player.vy*dt;\nthis.checkTrackCollision();this.checkCheckpoints();\nif(ghost)ghost.checkLap();}}\ncheckTrackCollision(){const{player,track}=GAME;const p=player.pos();for(const seg of track.segments){const closest=track.closestPointOnSegment(seg,p);const dist=Math.hypot(closest.x-p.x,closest.y-p.y);if(dist<56){const nx=(p.x-closest.x)/dist;const ny=(p.y-closest.y)/dist;const dot=player.vx*nx+player.vy*ny;player.vx=(player.vx-2*dot*nx)*0.7;player.vy=(player.vy-2*dot*ny)*0.7;player.x=closest.x+nx*57;player.y=closest.y+ny*57;GAME.audio.playCollision(Math.abs(dot));}}}\ncheckCheckpoints(){const{player,track}=GAME;for(const cp of track.checkpoints){if(Math.hypot(player.x-cp.x,player.y-cp.y)<30)player.checkpoint=cp.index;}}","js/systems/ghost.js":"class GhostSystem{constructor(){this.recorded=[];this.isPlaying=false;this.startTime=0;this.lapStart=null;this.checkpoint=0;}\nupdate(dt){const{player,track}=GAME;if(!this.isPlaying)return;\nconst now=Date.now();if(!this.startTime)this.startTime=now;\nconst progress=track.getProgress(player.x,player.y);if(progress>0.99&&this.lapStart){this.lapTime=now-this.lapStart;this.isPlaying=false;GAME.ghostTime=this.lapTime;GAME.hud.showLapModal(this.lapTime,GAME.ghostTime);GAME.audio.playFinish();}\nconst idx=Math.floor((now-this.startTime)/1000*60/10);if(idx<this.recorded.length){const r=this.recorded[idx];player.x=r.x;player.y=r.y;player.vx=r.vx;player.vy=r.vy;player.angle=r.angle;}}\nrecord(dt){const{player}=GAME;this.recorded.push({x:player.x,y:player.y,vx:player.vx,vy:player.vy,angle:player.angle});if(this.recorded.length>6000)this.recorded.shift();}\ncheckLap(){const{player,track}=GAME;if(!this.lapStart&&player.checkpoint===track.checkpoints.length-1){this.lapStart=Date.now();}}\nrender(ctx){const{recorded}=this;if(!recorded.length)return;ctx.save();ctx.globalAlpha=0.6;ctx.strokeStyle='#B800FF';ctx.lineWidth=6;ctx.lineCap='round';ctx.beginPath();for(let i=0;i<recorded.length;i+=2){const r=recorded[i];ctx.moveTo(r.x,r.y);ctx.lineTo(r.x+recorded[i+1].x-r.x,r.y+recorded[i+1].y-r.y);}ctx.stroke();ctx.restore();}\nsave(){localStorage.setItem('ghostRacerGhost',JSON.stringify(this.recorded));localStorage.setItem('ghostRacerHighScore',this.lapTime||0);}\nload(){const d=localStorage.getItem('ghostRacerGhost');if(d){this.recorded=JSON.parse(d);this.isPlaying=true;}}","js/systems/audio.js":"class AudioSystem{constructor(){this.ctx=new(window.AudioContext||window.webkitAudioContext)();this.master=this.ctx.createGain();this.master.gain.value=0.3;this.master.connect(this.ctx.destination);this.engineOsc=null;this.engineGain=null;}\nplayTone(freq,type,duration,volume=0.5){const osc=this.ctx.createOscillator();const gain=this.ctx.createGain();osc.type=type;osc.frequency.setValueAtTime(freq,this.ctx.currentTime);gain.gain.setValueAtTime(volume,this.ctx.currentTime);gain.gain.exponentialRampToValueAtTime(0.01,this.ctx.currentTime+duration);osc.connect(gain);gain.connect(this.master);osc.start();osc.stop(this.ctx.currentTime+duration);}\nplayEngine(){this.engineOsc=this.ctx.createOscillator();this.engineGain=this.ctx.createGain();this.engineOsc.type='sawtooth';this.engineOsc.connect(this.engineGain);this.engineGain.connect(this.master);this.engineGain.gain.value=0.1;this.engineOsc.start();this.updateEngine();}\nupdateEngine(){const{player}=GAME;if(!this.engineOsc)return;const speed=Math.hypot(player.vx,player.vy);this.engineOsc.frequency.setValueAtTime(60+speed*40,this.ctx.currentTime);requestAnimationFrame(()=>this.updateEngine());}\nstopEngine(){if(this.engineOsc){this.engineOsc.stop();this.engineOsc=null;}}\nplayCollision(velocity){this.playTone(100+velocity*20,'square',0.15,0.7);}playFinish(){this.playTone(523.25,'sine',0.3,0.6);setTimeout(()=>this.playTone(659.25,'sine',0.3,0.6),150);setTimeout(()=>this.playTone(783.99,'sine',0.4,0.6),300);}\nplayClick(){this.playTone(800,'sine',0.05,0.3);}playCountdown(n){this.playTone(400+n*100,'square',0.2,0.5);}}","js/systems/track.js":"class TrackGenerator{constructor(){this.segments=[];this.checkpoints=[];}\ngenerate(){this.segments=[];this.checkpoints=[];const cx=0,cy=0;const points=[];const n=8+Math.floor(Math.random()*4);for(let i=0;i<n;i++){const angle=(i/n)*Math.PI*2;const r=250+Math.random()*150;points.push({x:cx+Math.cos(angle)*r,y:cy+Math.sin(angle)*r});}\nfor(let i=0;i<points.length;i++){const p1=points[i];const p2=points[(i+1)%points.length];this.segments.push({p1,p2});}\nfor(let i=0;i<Math.min(4,points.length);i++){const p=points[i];p.x+=Math.cos((i/n)*Math.PI*2)*40;p.y+=Math.sin((i/n)*Math.PI*2)*40;this.checkpoints.push({x:p.x,y:p.y,index:i});}\nthis.center={x:cx,y:cy};}\ngetProgress(x,y){const d=Math.hypot(x-this.center.x,y-this.center.y);return 1-d/500;}closestPointOnSegment(seg,p){const a=seg.p1,b=seg.p2;const abx=b.x-a.x,aby=b.y-a.y;const t=((p.x-a.x)*abx+(p.y-a.y)*aby)/(abx*abx+aby*aby);const tclamped=Math.max(0,Math.min(1,t));return{x:a.x+tclamped*abx,y:a.y+tclamped*aby};}\ndraw(ctx){const{segments}=this;ctx.moveTo(segments[0].p1.x,segments[0].p1.y);for(const s of segments)ctx.lineTo(s.p2.x,s.p2.y);ctx.closePath();}\nreset(){this.segments=[];this.checkpoints=[];}}","js/ui/hud.js":"class HUD{constructor(){this.timerEl=null;this.deltaEl=null;this.speedEl=null;this.minimapEl=null;this.init();}\ninit(){this.timerEl=document.createElement('div');this.timerEl.id='lapTimer';this.timerEl.className='hud';this.timerEl.textContent='00:00.000';document.getElementById('uiLayer').appendChild(this.timerEl);\nthis.deltaEl=document.createElement('div');this.deltaEl.id='ghostDelta';this.deltaEl.className='hud';this.deltaEl.textContent='VS GHOST';document.getElementById('uiLayer').appendChild(this.deltaEl);\nthis.speedEl=document.createElement('div');this.speedEl.id='speedometer';this.speedEl.className='hud';document.getElementById('uiLayer').appendChild(this.speedEl);\nthis.minimapEl=document.createElement('canvas');this.minimapEl.id='minimap';document.getElementById('uiLayer').appendChild(this.minimapEl);}\nupdate(dt){const{player,ghost}=GAME;const ms=Date.now()-GAME.startTime;const m=Math.floor(ms/1000);const s=Math.floor(ms%1000/10);const ms2=Math.floor(ms%100);\nlet deltaText='VS GHOST';if(ghost&&ghost.lapTime){const diff=(ghost.lapTime-ms)/1000;deltaText=(diff>0?'+':'')+diff.toFixed(3)+'s';}\nthis.timerEl.textContent=`${m.toString().padStart(2,'0')}:${s.toString().padStart(2,'0')}.${ms2.toString().padStart(2,'0')}`;\nthis.deltaEl.textContent=deltaText;\nconst speed=Math.hypot(player.vx,player.vy)/8*100;this.drawSpeedometer(speed);this.drawMinimap();}\nshowLapModal(lapTime,ghostTime){const overlay=document.createElement('div');overlay.id='lapModal';overlay.innerHTML=`<h2>LAP COMPLETE</h2><p>Time: ${(lapTime/1000).toFixed(3)}s</p><p>Ghost: ${(ghostTime/1000).toFixed(3)}s</p><p>${lapTime<ghostTime?'YOU WON!':'TRY AGAIN'}</p><button onclick="GAME.menu.showMenu()">MAIN MENU</button>`;\ndocument.getElementById('uiLayer').appendChild(overlay);setTimeout(()=>overlay.remove(),5000);}\ndrawSpeedometer(speed){const el=this.speedEl;el.innerHTML=`<svg viewBox='0 0 100 100'><defs><linearGradient id='g' x1='0' y1='1' x2='0' y2='0'><stop offset='0%' style='stop-color:#00FF00'/><stop offset='50%' style='stop-color:#FFFF00'/><stop offset='100%' style='stop-color:#FF0000'/></linearGradient></defs><circle cx='50' cy='50' r='45' fill='none' stroke='#333' stroke-width='8'/><circle cx='50' cy='50' r='45' fill='none' stroke='url(#g)' stroke-width='8' stroke-dasharray='212' stroke-dashoffset='${212-212*speed/100}' transform='rotate(-90 50 50)'/><text x='50' y='55' text-anchor='middle' fill='#FFF' font-family='Orbitron' font-size='16'>${Math.round(speed)}%</text></svg>`;}\ndrawMinimap(){const el=this.minimapEl;const ctx=el.getContext('2d');el.width=150;el.height=150;const{player,track}=GAME;ctx.fillStyle='#1A1A2E';ctx.fillRect(0,0,150,150);ctx.strokeStyle='#CCCCCC';ctx.lineWidth=2;ctx.beginPath();let first=true;for(const s of track.segments){if(first){ctx.moveTo(s.p1.x/10+75,s.p1.y/10+75);first=false;}else ctx.lineTo(s.p2.x/10+75,s.p2.y/10+75);}ctx.closePath();ctx.stroke();ctx.fillStyle='#00D4FF';ctx.beginPath();ctx.arc(player.x/10+75,player.y/10+75,4,0,Math.PI*2);ctx.fill();}}","js/ui/menu.js":"class Menu{constructor(){this.overlay=null;}\ninit(){this.showMenu();}\nshowMenu(){const ui=document.getElementById('uiLayer');ui.innerHTML='';this.overlay=document.createElement('div');this.overlay.id='startOverlay';this.overlay.innerHTML=`<h1>GHOST RACER</h1><p style='margin-bottom:20px;color:#888'>High Score: ${(GAME.highScore/1000).toFixed(3)}s</p><button onclick="GAME.menu.start()">RACE</button><button onclick="GAME.menu.resetGhost()">RESET GHOST</button>`;\nui.appendChild(this.overlay);}\nstart(){GAME.track.generate();GAME.ghost.reset();GAME.ghost.load();GAME.state='playing';GAME.startTime=Date.now();GAME.lapStart=null;GAME.player=new Player();GAME.input.keys.up=true;setTimeout(()=>GAME.input.keys.up=false,100);GAME.audio.playCountdown(3);setTimeout(()=>GAME.audio.playCountdown(2),1000);setTimeout(()=>GAME.audio.playCountdown(1),2000);setTimeout(()=>{GAME.audio.playEngine();},3000);}\nresetGhost(){localStorage.removeItem('ghostRacerGhost');localStorage.removeItem('ghostRacerHighScore');GAME.highScore=0;this.showMenu();}\nshowPause(){if(this.overlay)this.overlay.remove();this.overlay=document.createElement('div');this.overlay.id='pauseMenu';this.overlay.innerHTML=`<h2>PAUSED</h2><button onclick="GAME.menu.resume()">RESUME</button><button onclick="GAME.menu.showMenu()">MENU</button>`;\ndocument.getElementById('uiLayer').appendChild(this.overlay);}\nresume(){if(this.overlay)this.overlay.remove();GAME.state='playing';GAME.startTime=Date.now();GAME.audio.playEngine();}\nshowPause(){if(this.overlay)this.overlay.remove();this.overlay=document.createElement('div');this.overlay.id='pauseMenu';this.overlay.innerHTML=`<h2>PAUSED</h2><button onclick="GAME.menu.resume()">RESUME</button><button onclick="GAME.menu.showMenu()">MENU</button>`;\ndocument.getElementById('uiLayer').appendChild(this.overlay);}}","js/systems/player.js":"class Player{constructor(){this.x=0;this.y=0;this.vx=0;this.vy=0;this.angle=0;this.checkpoint=0;this.particles=[];this.input=GAME.input;const track=GAME.track;const seg=track.segments[0];this.x=seg.p1.x;this.y=seg.p1.y;this.angle=Math.atan2(seg.p2.y-seg.p1.y,seg.p2.x-seg.p1.x);}\npos(){return{x:this.x,y:this.y};}\nrender(ctx){const{player}=GAME;ctx.save();ctx.translate(player.x,player.y);ctx.rotate(player.angle+Math.PI/2);\nconst bob=Math.sin(Date.now()/100)*2;ctx.translate(0,bob);\nctx.fillStyle='#00D4FF';ctx.fillRect(-10,-4,20,8);ctx.fillStyle='#FFF';ctx.fillRect(-6,-4,4,8);ctx.fillStyle='#00D4FF';ctx.fillRect(4,-4,6,8);\nctx.fillStyle='#B800FF';ctx.fillRect(-10,-7,20,3);ctx.fillStyle='#B800FF';ctx.fillRect(-10,-1,20,3);\nctx.restore();\nconst speed=Math.hypot(player.vx,player.vy);if(speed>3){const drift=speed>5;for(let i=0;i<(drift?2:1);i++)player.particles.push({x:player.x+Math.cos(player.angle+Math.PI)*8,y:player.y+Math.sin(player.angle+Math.PI)*8,vx:(Math.random()-0.5)*2,vy:(Math.random()-0.5)*2,size:Math.random()*3+2,life:30,maxLife:30,alpha:1});}\nif(GAME.ghost)GAME.ghost.record();}}","service-worker.js":"const CACHE='ghost-racer-v1';const ASSETS=['./','./index.html','./css/game.css','./js/core/game.js','./js/core/input.js','./js/core/renderer.js','./js/systems/physics.js','./js/systems/ghost.js','./js/systems/track.js','./js/systems/audio.js','./js/systems/player.js','./js/ui/hud.js','./js/ui/menu.js'];\nself.addEventListener('install',e=>{e.waitUntil(caches.open(CACHE).then(c=>c.addAll(ASSETS)));});\nself.addEventListener('fetch',e=>{e.respondWith(caches.match(e.request).then(r=>r||fetch(e.request)));});","manifest.json":{"name":"Ghost Racer","short_name":"Ghost Racer","start_url":"./","display":"standalone","background_color":"#0A0A1A","theme_color":"#0A0A1A","icons":[{"src":"data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ctext y='.9em' font-size='90'%3E🏎️%3C/text%3E%3C/svg%3E","sizes":"any","type":"image/svg+xml"}]}}}}