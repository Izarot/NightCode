{\n            const p = this.player;\n            const px = Math.round(p.x);\n            const py = Math.round(p.y);\n            \n            if (py >= this.stackHeight) {\n                this.endGame('Overtaken by stack');\n                return;\n            }\n            \n            if (!p.dashing && this.maze[py] && this.maze[py][px] === 2) {\n                this.endGame('Crushed into wall');\n                return;\n            }\n            \n            for (const piece of this.pieces) {\n                if (piece.state === 'settling' || piece.state === 'fall{"index.html": "...ing') {
                    const shape = this.getRotatedShape(piece);
                    const dist = Math.hypot(piece.x + shape[0].length/2 - p.x, piece.y + shape.length/2 - p.y);
                    if (dist < 0.8) {
                        this.endGame('Crushed by block');
                        return;
                    }
                }
            }
        }
        
        endGame(reason) {
            this.state = 'gameover';
            this.deathCause = reason;
            playSound('death');
            
            if (this.score > this.highScore) {
                this.highScore = this.score;
                localStorage.setItem('tetrisFallHighScore', this.highScore);
                this.showNotification('NEW HIGH SCORE!', '#ffd700');
            }
            
            document.getElementById('overlay').classList.remove('hidden');
            document.getElementById('menuContent').classList.add('hidden');
            document.getElementById('gameOverContent').classList.add('show');
            document.getElementById('timer').style.display = 'none';
            
            document.getElementById('finalScore').textContent = this.score;
            document.getElementById('stats').innerHTML = 
                'TIME: ' + this.formatTime(this.timeElapsed) + '<br>' +
                'DEPTH: ' + this.maxDepth + '<br>' +
                'BLOCKS: ' + this.blocksSettled + '<br>' +
                'DISTANCE: ' + Math.floor(this.distanceTraveled);
            document.getElementById('deathCause').textContent = reason;
            
            this.updateHighScoreDisplay();
        }
        
        updateHUD() {
            document.getElementById('score').textContent = 'SCORE: ' + this.score;
            document.getElementById('stackDist').textContent = 'STACK: ' + Math.floor(this.stackHeight);
            
            const stackClass = this.stackHeight > CONFIG.GRID_SIZE * 0.7 ? 'danger' : 
                               this.stackHeight > CONFIG.GRID_SIZE * 0.5 ? 'warning' : '';
            document.getElementById('stackDist').className = stackClass;
            
            const dashFill = document.getElementById('dashFill');
            const now = performance.now();
            if (this.player) {
                const cooldownRemaining = Math.max(0, this.player.dashCooldownEnd - now);
                const fillPercent = Math.max(0, 100 - (cooldownRemaining / CONFIG.DASH_COOLDOWN) * 100);
                dashFill.style.width = fillPercent + '%';
            }
        }
        
        updateHighScoreDisplay() {
            document.getElementById('highScore').textContent = 'HIGH SCORE: ' + this.highScore;
        }
        
        formatTime(seconds) {
            const mins = Math.floor(seconds / 60);
            const secs = Math.floor(seconds % 60);
            return mins.toString().padStart(2, '0') + ':' + secs.toString().padStart(2, '0');
        }
        
        draw() {
            const ctx = this.ctx;
            const cs = CONFIG.CELL_SIZE;
            
            ctx.save();
            if (this.screenShake.duration > 0) {
                ctx.translate(this.screenShake.x, this.screenShake.y);
            }
            
            ctx.fillStyle = CONFIG.COLORS.bg;
            ctx.fillRect(0, 0, this.canvas.width, this.canvas.height);
            
            for (let y = 0; y < CONFIG.GRID_SIZE; y++) {
                for (let x = 0; x < CONFIG.GRID_SIZE; x++) {
                    if ((x + y) % 2 === 0) {
                        ctx.fillStyle = 'rgba(26, 58, 92, 0.3)';
                        ctx.fillRect(x * cs, y * cs, cs, cs);
                    }
                }
            }
            
            for (let y = 0; y < CONFIG.GRID_SIZE; y++) {
                for (let x = 0; x < CONFIG.GRID_SIZE; x++) {
                    if (this.maze[y][x] === 1) {
                        ctx.fillStyle = '#1a2a4a';
                        ctx.fillRect(x * cs + 1, y * cs + 1, cs - 2, cs - 2);
                        
                        ctx.strokeStyle = 'rgba(100, 150, 200, 0.3)';
                        ctx.strokeRect(x * cs + 2, y * cs + 2, cs - 4, cs - 4);
                    }
                }
            }
            
            if (this.stackHeight > 0) {
                const stackY = (CONFIG.GRID_SIZE - this.stackHeight) * cs;
                const gradient = ctx.createLinearGradient(0, stackY, 0, this.canvas.height);
                gradient.addColorStop(0, 'rgba(255, 0, 64, 0.8)');
                gradient.addColorStop(1, 'rgba(255, 0, 64, 0.2)');
                ctx.fillStyle = gradient;
                ctx.fillRect(0, stackY, this.canvas.width, this.canvas.height - stackY);
                
                ctx.strokeStyle = '#ff0040';
                ctx.lineWidth = 3;
                ctx.beginPath();
                ctx.moveTo(0, stackY);
                ctx.lineTo(this.canvas.width, stackY);
                ctx.stroke();
                
                ctx.fillStyle = '#ff0040';
                ctx.font = '12px Orbitron';
                ctx.fillText('STACK', 5, stackY - 5);
            }
            
            for (let y = 0; y < CONFIG.GRID_SIZE; y++) {
                for (let x = 0; x < CONFIG.GRID_SIZE; x++) {
                    if (this.maze[y][x] === 2) {
                        const color = CONFIG.COLORS.pieces[(x * 7 + y) % 7];
                        ctx.fillStyle = color;
                        ctx.fillRect(x * cs + 2, y * cs + 2, cs - 4, cs - 4);
                        
                        ctx.shadowColor = color;
                        ctx.shadowBlur = 8;
                        ctx.fillRect(x * cs + 4, y * cs + 4, cs - 8, cs - 8);
                        ctx.shadowBlur = 0;
                    }
                }
            }
            
            for (const piece of this.pieces) {
                const shape = this.getRotatedShape(piece);
                const color = CONFIG.COLORS.pieces[piece.color];
                
                for (let py = 0; py < shape.length; py++) {
                    for (let px = 0; px < shape[py].length; px++) {
                        if (shape[py][px]) {
                            const drawX = (piece.x + px) * cs;
                            const drawY = (piece.y + py) * cs;
                            
                            if (drawY > -cs) {
                                ctx.fillStyle = color;
                                ctx.fillRect(drawX + 2, drawY + 2, cs - 4, cs - 4);
                                
                                ctx.shadowColor = color;
                                ctx.shadowBlur = piece.state === 'settling' ? 15 : 10;
                                ctx.fillRect(drawX + 4, drawY + 4, cs - 8, cs - 8);
                                ctx.shadowBlur = 0;
                                
                                ctx.strokeStyle = 'rgba(255,255,255,0.5)';
                                ctx.strokeRect(drawX + 3, drawY + 3, cs - 6, cs - 6);
                            }
                        }
                    }
                }
            }
            
            for (const particle of this.particles) {
                ctx.globalAlpha = particle.life;
                ctx.fillStyle = particle.color;
                ctx.beginPath();
                ctx.arc(particle.x, particle.y, particle.size * particle.life, 0, Math.PI * 2);
                ctx.fill();
            }
            ctx.globalAlpha = 1;
            
            for (const p of this.ambientParticles) {
                ctx.globalAlpha = p.alpha;
                ctx.fillStyle = '#0ff';
                ctx.beginPath();
                ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
                ctx.fill();
            }
            ctx.globalAlpha = 1;
            
            if (this.state === 'playing' || this.state === 'gameover') {
                const p = this.player;
                const px = p.x * cs + cs / 2;
                const py = p.y * cs + cs / 2;
                
                const pulse = 0.8 + Math.sin(performance.now() / 200) * 0.2;
                
                if (p.iframes <= 0 || Math.floor(p.iframes * 10) % 2 === 0) {
                    ctx.shadowColor = CONFIG.COLORS.playerGlow;
                    ctx.shadowBlur = 15 * pulse;
                    
                    ctx.fillStyle = CONFIG.COLORS.player;
                    ctx.beginPath();
                    ctx.arc(px, py, cs / 3, 0, Math.PI * 2);
                    ctx.fill();
                    
                    ctx.strokeStyle = CONFIG.COLORS.playerGlow;
                    ctx.lineWidth = 2;
                    ctx.beginPath();
                    ctx.arc(px, py, cs / 2.5, 0, Math.PI * 2);
                    ctx.stroke();
                    
                    ctx.fillStyle = CONFIG.COLORS.playerGlow;
                    ctx.beginPath();
                    ctx.arc(px + p.facing.x * cs / 3, py + p.facing.y * cs / 3, 3, 0, Math.PI * 2);
                    ctx.fill();
                    
                    ctx.shadowBlur = 0;
                }
                
                if (p.dashing) {
                    ctx.strokeStyle = 'rgba(0, 255, 255, 0.5)';
                    ctx.lineWidth = 3;
                    ctx.setLineDash([5, 5]);
                    ctx.beginPath();
                    ctx.moveTo(px, py);
                    ctx.lineTo(px + p.dashDir.x * cs * 2, py + p.dashDir.y * cs * 2);
                    ctx.stroke();
                    ctx.setLineDash([]);
                }
            }
            
            ctx.restore();
        }
        
        loop(timestamp) {
            const dt = Math.min((timestamp - this.lastTime) / 1000, 0.1);
            this.lastTime = timestamp;
            
            if (this.state === 'playing') {
                this.timeElapsed = (performance.now() - this.gameStartTime) / 1000;
                
                if (performance.now() - this.lastSpawnTime > this.getSpawnInterval()) {
                    this.spawnPiece();
                    this.lastSpawnTime = performance.now();
                }
                
                this.updatePlayer(dt);
                this.updatePieces(dt);
                this.updateStack(dt);
                this.checkDeaths();
                this.updateHUD();
                
                document.getElementById('timer').textContent = this.formatTime(this.timeElapsed);
            }
            
            for (let i = this.particles.length - 1; i >= 0; i--) {
                const p = this.particles[i];
                p.x += p.vx;
                p.y += p.vy;
                p.life -= dt * 2;
                if (p.life <= 0) {
                    this.particles.splice(i, 1);
                }
            }
            
            for (const p of this.ambientParticles) {
                p.x += p.vx;
                p.y += p.vy;
                if (p.x < 0) p.x = this.canvas.width;
                if (p.x > this.canvas.width) p.x = 0;
                if (p.y < 0) p.y = this.canvas.height;
                if (p.y > this.canvas.height) p.y = 0;
            }
            
            if (this.screenShake.duration > 0) {
                this.screenShake.duration -= dt * 1000;
                if (this.screenShake.duration <= 0) {
                    this.screenShake.x = 0;
                    this.screenShake.y = 0;
                }
            }
            
            this.draw();
            requestAnimationFrame(this.loop);
        }
    }
    
    window.addEventListener('load', () => {
        new Game();
    });
    </script>
</body>
