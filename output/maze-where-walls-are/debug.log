utton class=\"btn\" id=\"restartBtn\">PLAY AGAIN</button>\n            </div>\n        </div>\n    </div>\n\n    <script>\n    const CONFIG = {\n        GRID_SIZE: 20,\n        CELL_SIZE: 32,\n        PLAYER_SPEED: 8,\n        DASH_SPEED: 20,\n        DASH_DURATION: 500,\n        DASH_COOLDOWN: 1500,\n        BASE_FALL_SPEED: 3,\n        FALL_ACCEL: 0.2,\n        ACCEL_INTERVAL: 15,\n        STACK_RISE_SPEED: 0.15,\n        SPAWN_INTERVAL: 2000,\n        MIN_SPAWN_INTERVAL: 800,\n        COLORS: {\n            bg: '#0a0e27',\n            grid: '#1a3a5c',\n            player: '#ffffff',\n            playerGlow: '#00ffff',\n            stackLine: '#ff0040',\n            pieces: ['#00ffff', '#ffff00', '#ff00ff', '#ff8800', '#0088ff', '#00ff00', '#ff0044']\n        },\n        PIECES: [\n            { shape: [[1,1,1,1]], color: 0 },\n            { shape: [[1,1],[1,1]], color: 1 },\n            { shape: [[0,1,0],[1,1,1]], color: 2 },\n            { shape: [[1,0,0],[1,1,1]], color: 3 },\n            { shape: [[0,0,1],[1,1,1]], color: 4 },\n            { shape: [[0,1,1],[1,1,0]], color: 5 },\n            { shape: [[1,1,0],[0,1,1]], color: 6 }\n        ]\n    };\n\n    const audioCtx = new (window.AudioContext || window.webkitAudioContext)();\n    \n    function playSound(type) {\n        const osc = audioCtx.createOscillator();\n        const gain = audioCtx.createGain();\n        osc.connect(gain);\n        gain.connect(audioCtx.destination);\n        const now = audioCtx.currentTime;\n        \n        switch(type) {\n            case 'move':\n                osc.frequency.value = 800;\n                osc.type = 'square';\n                gain.gain.setValueAtTime(0.05, now);\n                gain.gain.exponentialDecayTo && gain.gain.exponentialDecayTo(0.01, now + 0.05);\n                gain.gain.setValueAtTime(0.05, now);\n                gain.gain.linearRampToValueAtTime(0.001, now + 0.05);\n                osc.start(now);\n                osc.stop(now + 0.05);\n     