is.distanceTraveled = 0;\n            this.maxDepth = 0;\n            this.deathCause = '';\n            \n            this.maze = this.generateMaze();\n            this.player = {\n                x: 1, y: 1,\n                targetX: 1, targetY: 1,\n                moveProgress: 1,\n                dashing: false,\n                dashDir: {x: 0, y: 0},\n                dashEndTime: 0,\n                dashCooldownEnd: 0,\n                iframes: 0,\n                facing: {x: 0, y: 1}\n            };\n            \n            this.pieces = [];\n            this.stackHeight = 0;\n            this.lastSpawnTime = 0;\n            this.gameStartTime = performance.now();\n            \n            this.particles = [];\n            this.updateHUD();\n            \n            document.getElementById('overlay').classList.add('hidden');\n            document.getElementById('timer').style.display = 'block';\n        }\n        \n        generateMaze() {\n            const maze = Array(CONFIG.GRID_SIZE).fill(null).map(() => \n                Array(CONFIG.GRID_SIZE).fill(1)\n            );\n            \n            const stack = [[1, 1]];\n            maze[1][1] = 0;\n            \n            const dirs = [[0, -2], [0, 2], [-2, 0], [2, 0]];\n            \n            while (stack.length > 0) {\n                const [cx, cy] = stack[stack.length - 1];\n                const shuffled = dirs.slice().sort(() => Math.random() - 0.5);\n                let found = false;\n                \n                for (const [dx, dy] of shuffled) {\n                    const nx = cx + dx, ny = cy + dy;\n                    if (nx > 0 && nx < CONFIG.GRID_SIZE - 1 && \n                        ny > 0 && ny < CONFIG.GRID_SIZE - 1 && \n                        maze[ny][nx] === 1) {\n                        maze[cy + dy/2][cx + dx/2] = 0;\n                        maze[ny][nx] = 0;\n                        stack.push([nx, ny]);\n                        found = true;\n                        