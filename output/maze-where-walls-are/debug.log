0ff',\n                                size: 6\n                            });\n                        }\n                    } else {\n                        p.dashing = false;\n                    }\n                } else {\n                    p.dashing = false;\n                }\n            } else {\n                if (p.dashing) {\n                    p.dashing = false;\n                }\n                \n                if (this.inputBuffer && now - this.inputBufferTime < 100) {\n                    const speed = CONFIG.PLAYER_SPEED * dt;\n                    const targetX = Math.round(p.x);\n                    const targetY = Math.round(p.y);\n                    const dx = this.inputBuffer.x;\n                    const dy = this.inputBuffer.y;\n                    const newX = targetX + dx;\n                    const newY = targetY + dy;\n                    \n                    if (newX >= 0 && newX < CONFIG.GRID_SIZE && newY >= 0 && newY < CONFIG.GRID_SIZE) {\n                        if (this.maze[newY][newX] !== 1) {\n                            p.x += dx * speed;\n                            p.y += dy * speed;\n                            p.facing = {x: dx, y: dy};\n                            \n                            if (Math.abs(p.x - targetX) >= 0.9 || Math.abs(p.y - targetY) >= 0.9) {\n                                p.x = Math.round(p.x);\n                                p.y = Math.round(p.y);\n                                this.distanceTraveled++;\n                                playSound('move');\n                                this.inputBuffer = null;\n                            }\n                        } else {\n                            this.inputBuffer = null;\n                        }\n                    } else {\n                        this.inputBuffer = null;\n                    }\n                }\n            }\n            \n            if (p.iframes > 0) {\n                p.iframes -= dt;\n            }\n 