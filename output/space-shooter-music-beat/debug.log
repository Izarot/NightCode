  "index.html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Rhythm Void</title>\n  <link rel=\"icon\" href=\"data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22><text y=%220.9em%22 font-size=%2232%22>🎵</text></svg>\" />\n  <style>\n    * { margin: 0; padding: 0; box-sizing: border-box; }\n    body, html { width: 100%; height: 100%; overflow: hidden; background: #050510; }\n    #gameCanvas { display: block; width: 100%; height: 100%; touch-action: none; }\n    #hud { position: absolute; top: 0; left: 0; width: 100%; pointer-events: none; font-family: 'Courier New', monospace; color: #E0E0E0; }\n    #score { position: absolute; top: 20px; left: 20px; font-size: 32px; text-shadow: 0 0 4px #00FFFF; }\n    #timer { position: absolute; top: 20px; right: 20px; font-size: 24px; }\n    #highScore { position: absolute; bottom: 20px; left: 20px; font-size: 18px; opacity: 0.7; }\n  </style>\n</head>\n<body>\n  <canvas id=\"gameCanvas\"></canvas>\n  <div id=\"hud\">\n    <div id=\"score\">0</div>\n    <div id=\"timer\">00:00</div>\n    <div id=\"highScore\">High: 0</div>\n  </div>\n  <script type=\"module\" src=\"/src/main.js\"></script>\n</body>\n</html>",
  "src/main.js": "// Rhythm Void - Core Game\nconst canvas = document.getElementById('gameCanvas');\nconst ctx = canvas.getContext('2d');\nconst scoreEl = document.getElementById('score');\nconst timerEl = document.getElementById('timer');\nconst highScoreEl = document.getElementById('highScore');\n\n// Resize canvas to fit window\nfunction resizeCanvas() {\n  canvas.width = window.innerWidth;\n  canvas.height = window.innerHeight;\n}\nwindow.addEventListener('resize', resizeCanvas);\nresizeCanvas();\n\n// Color palette\nconst COLORS = {\n  bg: '#050510',\n  player: '#00FFFF',\n  playerCore: '#FFFFFF',\n  bullet: '#00FFFF',\n  enemy: '#FF3366',\n  enemyBullet: '#FFAA00',\n  hud: '#E0E0E0',\n  hudAccent: '#00FFFF'\n};\n\n// Game state\nlet lastTime = 0;\nlet score = 0;\nlet highScore = loadHighScore();\nlet gameTime = 0;\nlet isGameOver = false;\n\n// Player\nconst player = {\n  x: canvas.width / 2,\n  y: canvas.height / 2,\n  radius: 8,\n  speed: 5,\n  dx: 0,\n  dy: 0,\n  color: COLORS.player,\n  coreColor: COLORS.playerCore\n};\n\n// Bullets\nconst bullets = [];\nconst enemyBullets = [];\n\n// Enemies\nconst enemies = [];\nconst SPAWN_INTERVAL = 1500; // ms\nlet lastSpawn = 0;\n\n// Audio setup\nconst audioCtx = new (window.AudioContext || window.webkitAudioContext)();\nlet analyser;\nlet musicBuffer;\n\n// Load and play music\nasync function loadMusic() {\n  try {\n    const response = await fetch('data:audio/mp3;base64,//uQxAAAAAAAAAAAAAAAAAAAAAAAWGluZwAAAA8AAAACAAACcQBZZnJhbWVzAAD//wMAAAAAAAAAAACqcmVhbHMAAP//AwAAAAAAAAAAAQAAAAAAAAAAAEV4aWYAAFogAAABAAAAYgAAAAEAAlZNZzMiAAAAAABJRU5ErkJggg==');\n    musicBuffer = await response.arrayBuffer();\n    const audioBuffer = await audioCtx.decodeAudioData(musicBuffer);\n    const source = audioCtx.createBufferSource();\n    source.buffer = audioBuffer;\n    source.loop = true;\n    analyser = audioCtx.createAnalyser();\n    analyser.fftSize = 256;\n    source.connect(analyser);\n    analyser.connect(audioCtx.destination);\n    source.start(0);\n  } catch (e) {\n    console.error('Music load failed:', e);\n  }\n}\nloadMusic();\n\n// Simple beat detection\nlet beatThreshold = 0;\nlet lastBeatTime = 0;\nconst BEAT_COOLDOWN = 300; // ms\n\nfunction updateBeat() {\n  if (!analyser) return;\n  const data = new Uint8Array(analyser.frequencyBinCount);\n  analyser.getByteFrequencyData(data);\n  const bass = data.slice(0, data.length / 4).reduce((a, b) => a + b, 0) / (data.length / 8);\n  \n  // Dynamic threshold\n  beatThreshold = Math.max(beatThreshold * 0.95, bass * 0.6);\n  \n  const now = performance.now();\n  if (bass > beatThreshold && now - lastBeatTime > BEAT_COOLDOWN) {\n    lastBeatTime = now;\n    spawnEnemy();\n    // Visual beat flash\n    document.body.style.background = `rgba(0, 255, 255, 0.1)`;\n    setTimeout(() => { document.body.style.background = COLORS.bg; }, 100);\n  }\n}\n\n// Game functions\nfunction spawnEnemy() {\n  const side = Math.floor(Math.random() * 4);\n  let x, y;\n  switch (side) {\n    case 0: x = Math.random() * canvas.width; y = -20; break;\n    case 1: x = canvas.width + 20; y = Math.random() * canvas.height; break;\n    case 2: x = Math.random() * canvas.width; y = canvas.height + 20; break;\n    case 3: x = -20; y = Math.random() * canvas.height; break;\n  }\n  enemies.push({ x, y, radius: 12, speed: 1.5, color: COLORS.enemy });\n}\n\nfunction updatePlayer(dt) {\n  // Input (WASD + mouse aim)\n  const keys = {};\n  window.addEventListener('keydown', e => keys[e.code] = true);\n  window.addEventListener('keyup', e => keys[e.code] = false);\n  \n  let dx = 0, dy = 0;\n  if (keys['KeyW']) dy -= 1;\n  if (keys['KeyS']) dy += 1;\n  if (keys['KeyA']) dx -= 1;\n  if (keys['KeyD']) dx += 1;\n  \n  const len = Math.sqrt(dx*dx + dy*dy);\n  if (len > 0) {\n    dx /= len; dy /= len;\n  }\n  player.dx = dx * player.speed;\n  player.dy = dy * player.speed;\n  player.x += player.dx * dt;\n  player.y += player.dy * dt;\n  \n  // Boundaries\n  player.x = Math.max(player.radius, Math.min(canvas.width - player.radius, player.x));\n  player.y = Math.max(player.radius, Math.min(canvas.height - player.radius, player.y));\n  \n  // Shooting (click or space)\n  if (keys['Space'] || mouseDown) {\n    shoot();\n  }\n}\n\nlet mouseDown = false;\nlet mouseX = 0, mouseY = 0;\nwindow.addEventListener('mousedown', e => { mouseDown = true; mouseX = e.clientX; mouseY = e.clientY; });\nwindow.addEventListener('mouseup', e => mouseDown = false);\nwindow.addEventListener('mousemove', e => { mouseX = e.clientX; mouseY = e.clientY; });\n\nfunction shoot() {\n  const now = performance.now();\n  if (!player.lastShot || now - player.lastShot > 200) {\n    player.lastShot = now;\n    const angle = Math.atan2(mouseY - player.y, mouseX - player.x);\n    bullets.push({\n      x: player.x,\n      y: player.y,\n      vx: Math.cos(angle) * 8,\n      vy: Math.sin(angle) * 8,\n      radius: 3,\n      color: COLORS.bullet\n    });\n    // Shoot sound\n    playShootSound();\n  }\n}\n\nfunction playShootSound() {\n  const oscillator = audioCtx.createOscillator();\n  const gain = audioCtx.createGain();\n  oscillator.type = 'square';\n  oscillator.frequency.value = 400;\n  gain.gain.setValueAtTime(0, audioCtx.currentTime);\n  gain.gain.linearRampToValueAtTime(0.2, audioCtx.currentTime + 0.01);\n  gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 0.2);\n  oscillator.connect(gain);\n  gain.connect(audioCtx.destination);\n  oscillator.start();\n  oscillator.stop(audioCtx.currentTime + 0.2);\n}\n\nfunction updateBullets(dt) {\n  // Player bullets\n  for (let i = bullets.length - 1; i >= 0; i--) {\n    const b = bullets[i];\n    b.x += b.vx * dt;\n    b.y += b.vy * dt;\n    if (b.x < -10 || b.x > canvas.width + 10 || b.y < -10 || b.y > canvas.height + 10) {\n      bullets.splice(i, 1);\n    }\n  }\n  \n  // Enemy bullets (simplified)\n  for (let i = enemyBullets.length - 1; i >= 0; i--) {\n    const b = enemyBullets[i];\n    b.x += b.vx * dt;\n    b.y += b.vy * dt;\n    if (b.x < -10 || b.x > canvas.width + 10 || b.y < -10 || b.y > canvas.height + 10) {\n      enemyBullets.splice(i, 1);\n    }\n  }\n}\n\nfunction updateEnemies(dt) {\n  for (let i = enemies.length - 1; i >= 0; i--) {\n    const e = enemies[i];\n    // Move toward player\n    const dx = player.x - e.x;\n    const dy = player.y - e.y;\n    const dist = Math.sqrt(dx*dx + dy*dy);\n    if (dist > 0) {\n      e.x += (dx / dist) * e.speed * dt;\n      e.y += (dy / dist) * e.speed * dt;\n    }\n    \n    // Collision with player\n    const playerDist = Math.sqrt((player.x - e.x)**2 + (player.y - e.y)**2);\n    if (playerDist < player.radius + e.radius) {\n      gameOver();\n      return;\n    }\n    \n    // Collision with bullets\n    for (let j = bullets.length - 1; j >= 0; j--) {\n      const b = bullets[j];\n      const dist = Math.sqrt((b.x - e.x)**2 + (b.y - e.y)**2);\n      if (dist < b.radius + e.radius) {\n        enemies.splice(i, 1);\n        bullets.splice(j, 1);\n        score += 10;\n        playExplosionSound();\n        break;\n      }\n    }\n  }\n}\n\nfunction playExplosionSound() {\n  const oscillator = audioCtx.createOscillator();\n  const gain = audioCtx.createGain();\n  oscillator.type = 'noise';\n  oscillator.frequency.value = 200;\n  gain.gain.setValueAtTime(0.3, audioCtx.currentTime);\n  gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 0.3);\n  oscillator.connect(gain);\n  gain.connect(audioCtx.destination);\n  oscillator.start();\n  oscillator.stop(audioCtx.currentTime + 0.3);\n}\n\nfunction gameOver() {\n  isGameOver = true;\n  if (score > highScore) {\n    highScore = score;\n    saveHighScore(highScore);\n  }\n}\n\nfunction loadHighScore() {\n  return parseInt(localStorage.getItem('rhythmVoidHighScore') || '0');\n}\n\nfunction saveHighScore(score) {\n  localStorage.setItem('rhythmVoidHighScore', score);\n}\n\n// Game loop\nfunction update(timestamp) {\n  if (!lastTime) lastTime = timestamp;\n  const dt = (timestamp - lastTime) / 1000; // seconds\n  lastTime = timestamp;\n  \n  if (!isGameOver) {\n    gameTime += dt;\n    updateBeat();\n    updatePlayer(dt);\n    updateBullets(dt);\n    updateEnemies(dt);\n    \n    // Spawn enemies periodically\n    if (timestamp - lastSpawn > SPAWN_INTERVAL) {\n      lastSpawn = timestamp;\n      spawnEnemy();\n    }\n  }\n  \n  render();\n  requestAnimationFrame(update);\n}\n\nfunction render() {\n  ctx.fillStyle = COLORS.bg;\n  ctx.fillRect(0, 0, canvas.width, canvas.height);\n  \n  // Draw player\n  ctx.fillStyle = player.color;\n  ctx.beginPath();\n  ctx.arc(player.x, player.y, player.radius, 0, Math.PI * 2);\n  ctx.fill();\n  ctx.fillStyle = player.coreColor;\n  ctx.beginPath();\n  ctx.arc(player.x, player.y, player.radius * 0.5, 0, Math.PI * 2);\n  ctx.fill();\n  \n  // Draw bullets\n  ctx.fillStyle = COLORS.bullet;\n  bullets.forEach(b => {\n    ctx.beginPath();\n    ctx.arc(b.x, b.y, b.radius, 0, Math.PI * 2);\n    ctx.fill();\n  });\n  \n  // Draw enemy bullets\n  ctx.fillStyle = COLORS.enemyBullet;\n  enemyBullets.forEach(b => {\n    ctx.beginPath();\n    ctx.arc(b.x, b.y, b.radius, 0, Math.PI * 2);\n    ctx.fill();\n  });\n  \n  // Draw enemies\n  ctx.fillStyle = COLORS.enemy;\n  enemies.forEach(e => {\n    ctx.beginPath();\n    ctx.arc(e.x, e.y, e.radius, 0, Math.PI * 2);\n    ctx.fill();\n  });\n  \n  // HUD\n  scoreEl.textContent = score.toString().padStart(9, '0');\n  const minutes = Math.floor(gameTime / 60);\n  const seconds = Math.floor(gameTime % 60);\n  timerEl.textContent = `${String(minutes).padStart(2, '0')}:${String(seconds).padStart(2, '0')}`;\n  highScoreEl.textContent = `High: ${highScore.toString().padStart(6, '0')}`;\n  \n  // Game over\n  if (isGameOver) {\n    ctx.fillStyle = 'rgba(0,0,0,0.7)';\n    ctx.fillRect(0, 0, canvas.width, canvas.height);\n    ctx.fillStyle = COLORS.hudAccent;\n    ctx.font = '48px monospace';\n    ctx.textAlign = 'center';\n    ctx.fillText('GAME OVER', canvas.width / 2, canvas.height / 2 - 20);\n    ctx.font = '24px monospace';\n    ctx.fillText(`Score: ${score}`, canvas.width / 2, canvas.height / 2 + 20);\n    ctx.fillText('Click to Restart', canvas.width / 2, canvas.height / 2 + 60);\n    \n    window.addEventListener('click', () => {\n      location.reload();\n    }, { once: true });\n  }\n}\n\n// Start game\nrequestAnimationFrame(update);\nwindow.addEventListener('click', () => {\n  if (audioCtx.state === 'suspended') {\n    audioCtx.resume();\n  }\n});\n}\n}"\n}"