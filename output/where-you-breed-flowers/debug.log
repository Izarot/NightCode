ition:absolute;top:-4px;left:-4px;right:-4px;bottom:-4px;border:4px solid transparent;border-top-color:#FFB347;border-radius:50%;animation:spin 2s linear infinite}\n    @keyframes spin{to{transform:rotate(360deg)}}\n    .plant-canvas{position:absolute;top:0;left:0;width:100%;height:100%}\n    .plot{position:relative;width:100px;height:100px;cursor:pointer}\n    .grid{display:grid;grid-template-columns:repeat(5,100px);grid-template-rows:repeat(4,100px);gap:8px;position:absolute;top:50%;left:50%;transform:translate(-50%,-50%)}\n    .plot:nth-child(odd){margin-top:50px}\n    @media (max-width:768px){.grid{transform:translate(-50%,-50%) scale(0.7)}.sidebar{width:100vw;max-width:320px}.hud-top{padding:0 10px}.bottom-bar{padding:0 10px}}\n  </style>\n</head>\n<body>\n  <canvas id=\"game\" width=\"1280\" height=\"720\"></canvas>\n  <div class=\"speedrun\" id=\"speedrun\">00:00.00</div>\n  <div class=\"hud-top\">\n    <div class=\"logo\">FLORAGENESIS</div>\n    <div class=\"patron-area\">\n      <div class=\"patron\" id=\"patronSprite\">🧚</div>\n      <div class=\"patron-info\">\n        <div class=\"patron-name\" id=\"patronName\">Awaiting Patron...</div>\n        <div class=\"patron-desc\" id=\"patronDesc\"></div>\n        <div class=\"stars\" id=\"stars\"><span class=\"star empty\">★</span><span class=\"star empty\">★</span><span class=\"star empty\">★</span></div>\n        <div class=\"progress-bar\" style=\"width:200px;margin-top:4px\"><div class=\"progress-fill\" id=\"patronProgress\" style=\"width:0%\"></div></div>\n      </div>\n    </div>\n    <div class=\"currency\">\n      <div class=\"coin\"><span class=\"coin-icon\">🪙</span><span id=\"coins\">0</span></div>\n      <div class=\"coin\"><span class=\"coin-icon\">💎</span><span id=\"shards\">0</span></div>\n    </div>\n  </div>\n  <button class=\"menu-btn sidebar-toggle\" id=\"sidebarToggle\" aria-label=\"Open sidebar\">🧬</button>\n  <div class=\"sidebar\" id=\"sidebar\">\n    <div class=\"sidebar-content\">\n      <div class=\"tabs\">\n        <button class=\"tab active\" data-tab=\"inspector\">Inspector</button>\n        <button class=\"tab\" data-tab=\"catalog\">Catalog</button>\n        <button class=\"tab\" data-tab=\"codex\">Codex</button>\n      </div>\n      <div class=\"panel active\" id=\"panel-inspector\">\n        <div class=\"section-title\">Genome Inspector</div>\n        <div id=\"genomeDisplay\"><p style=\"color:#8B7355;text-align:center;padding:20px\">Select a flower to inspect</p></div>\n        <div class=\"section-title\" style=\"margin-top:20px\">Punnett Square</div>\n        <div id=\"punnettDisplay\"><p style=\"color:#8B7355;text-align:center;padding:20px\">Drag another flower here</p></div>\n      </div>\n      <div class=\"panel\" id=\"panel-catalog\">\n        <div class=\"section-title\">Seed Catalog</div>\n        <div id=\"catalogList\"></div>\n      </div>\n      <div class=\"panel\" id=\"panel-codex\">\n        <div class=\"section-title\">Codex</div>\n        <div id=\"codexList\"></div>\n      </div>\n    </div>\n  </div>\n  <div class=\"bottom-bar\">\n    <div class=\"time-controls\">\n      <button class=\"btn secondary\" id=\"btnPause\" aria-label=\"Pause\">⏸</button>\n      <button class=\"btn secondary\" id=\"btnPlay\" aria-label=\"Play\">▶</button>\n      <button class=\"btn secondary\" id=\"btnSpeed\" aria-label=\"Speed\">▶▶</button>\n    </div>\n    <button class=\"btn\" id=\"btnSettings\">⚙ Settings</button>\n  </div>\n  <div class=\"tooltip\" id=\"tooltip\"></div>\n  <script>\n    // ============ CORE ENGINE ============\n    const Mulberry32 = (seed) => {\n      let t = seed >>> 0;\n      return () => {\n        t += 0x6D2B79F5;\n        let r = Math.imul(t ^ (t >>> 15), 1 | t);\n        r ^= r + Math.imul(r ^ (r >>> 7), 61 | r);\n        return ((r ^ (r >>> 14)) >>> 0) / 4294967296;\n      };\n    };\n    \n    class RNG {\n      constructor(seed = Date.now()) { this.fn = Mulberry32(seed); }\n      next() { return this.fn(); }\n      int(min, max) { return Math.floor(this.next() * (max - min + 1)) + min; }\n      float(min, max) { return this.next() * (max - min) + min; }\n      pick(arr) { return arr[this.int(0, arr.length - 1)]; }\n      chance(p) { return this.next() < p; }\n    }\n    \n    const rng = new RNG(0xF10RA6EN);\n    \n    // ============ GENETICS ============\n    const LOCI = [\n      {id:'L0',name:'Hue',type:'discrete',values:['red','orange','yellow','pink','purple','blue','white'],colors:['#E74C3C','#E67E22','#F1C40F','#F8BBD0','#9B59B6','#3498DB','#FFFFFF']},\n      {id:'L1',name:'Saturation',type:'continuous',min:0,max:1},\n      {id:'L2',name:'Petal Count',type:'continuous',min:3,max:8},\n      {id:'L3',name:'Petal Shape',type:'discrete',values:['rounded','pointed','ruffled','lily','daisy']},\n      {id:'L4',name:'Stem Height',type:'continuous',min:0,max:1},\n      {id:'L5',name:'Leaf Pattern',type:'discrete',values:['solid','variegated','striped','spotted']},\n      {id:'L6',name:'Center Color',type:'discrete',values:['yellow','black','white','magenta','cyan'],colors:['#FFD700','#000000','#FFFFFF','#FF00FF','#00FFFF']},\n      {id:'L7',name:'Glow',type:'discrete',values:['none','faint','radiant','legendary']}\n    ];\n    \n    function createGenome(base = null) {\n      const g = {};\n      LOCI.forEach(l => {\n        if (base && base[l.id]) {\n          g[l.id] = [...base[l.id]];\n        } else if (l.type === 'discrete') {\n          const a = rng.int(0, l.values.length - 1);\n          const b = rng.int(0, l.values.length - 1);\n          g[l.id] = [a, b];\n        } else {\n          g[l.id] = [rng.float(l.min, l.max), rng.float(l.min, l.max)];\n        }\n      });\n      return g;\n    }\n    \n    function getPhenotype(genome) {\n      const p = {};\n      LOCI.forEach(l => {\n        const [a, b] = genome[l.id];\n        if (l.type === 'discrete') {\n          p[l.id] = a >= b ? l.values[a] : l.values[b];\n        } else {\n          p[l.id] = (a + b) / 2;\n        }\n      });\n      return p;\n    }\n    \n    function crossGenomes(g1, g2) {\n      const child = {};\n      LOCI.forEach(l => {\n        const a1 = g1[l.id][rng.int(0,1)];\n        const a2 = g2[l.id][rng.int(0,1)];\n        let v1 = a1, v2 = a2;\n        if (rng.chance(0.02)) v1 = l.type === 'discrete' ? rng.int(0, l.values.length - 1) : rng.float(l.min, l.max);\n        if (rng.chance(0.02)) v2 = l.type === 'discrete' ? rng.int(0, l.values.length - 1) : rng.float(l.min, l.max);\n        child[l.id] = [v1, v2];\n      });\n      return child;\n    }\n    \n    function genomeMatch(g1, g2) {\n      let matches = 0;\n      LOCI.forEach(l => {\n        const p1 = getPhenotype(g1)[l.id];\n        const p2 = getPhenotype(g2)[l.id];\n        if (l.type === 'discrete') { if (p1 === p2) matches++; }\n        else { if (Math.abs(p1 - p2) < 0.15) matches++; }\n      });\n      return matches;\n    }\n    \n    function genomeToString(g) {\n      return LOCI.map(l => `${l.id}:[${g[l.id].join(',')}]`).join(' ');\n    }\n    \n    // ============ SPECIES & PATRONS ============\n    const SPECIES = [\n      {name:'Sun Poppy',cost:50,genome:createGenome({L0:[1,1],L2:[5,5],L3:[0,0],L6:[0,0]})},\n      {name:'Moon Lily',cost:75,genome:createGenome({L0:[6,6],L3:[3,3],L6:[2,2],L7:[1,1]})},\n      {name:'Blush Rose',cost:60,genome:createGenome({L0:[3,3],L2:[5,5],L3:[2,2],L5:[1,1]})},\n      {name:'Violet Dream',cost:80,genome:createGenome({L0:[4,4],L1:[0.8,0.8],L3:[1,1],L6:[3,3]})},\n      {name:'Azure Bell',cost:90,genome:createGenome({L0:[5,5],L2:[4,4],L3:[3,3],L4:[0.3,0.3]})},\n      {name:'Golden Crown',cost:120,genome:createGenome({L0:[1,1],L1:[0.9,0.9],L2:[7,7],L7:[2,2]})},\n    ];\n    \n    const PATRONS = [\n      {name:'Petal',emoji:'🧚',desc:'A blue flower with 6 pointed petals and a magenta center.',target:createGenome({L0:[5,5],L2:[6,6],L3:[1,1],L6:[3,3]})},\n      {name:'Bloom',emoji:'🧚‍♀️',desc:'Something radiant, white, with ruffled petals.',target:createGenome({L0:[6,6],L3:[2,2],L7:[2,2]})},\n      {name:'Flora',emoji:'🧚‍♂️',desc:'A tall purple lily with striped leaves and a cyan heart.',target:createGenome({L0:[4,4],L3:[3,3],L4:[0.8,0.8],L5:[2,2],L6:[4,4]})},\n      {name:'Nectar',emoji:'🦋',desc:'A legendary golden crown with 8 petals, faint glow.',target:createGenome({L0:[1,1],L1:[0.9,0.9],L2:[8,8],L7:[1,1]})},\n      {name:'Pollen',emoji:'🐝',desc:'A pale yellow daisy with 5 petals, solid leaves.',target:createGenome({L0:[2,2],L1:[0.3,0.3],L2:[5,5],L3:[4,4],L5:[0,0]})},\n    ];\n    \n    // ============ AUDIO ============\n    class AudioEngine {\n      constructor() {\n        this.ctx = null;\n        this.enabled = true;\n      }\n      init() {\n        if (!this.ctx) this.ctx = new (window.AudioContext || window.webkitAudioContext)();\n        if (this.ctx.state === 'suspended') this.ctx.resume();\n      }\n      playChime(freq, dur, type='sine') {\n        if (!this.enabled || !this.ctx) return;\n        const o = this.ctx.createOscillator();\n        const g = this.ctx.createGain();\n        o.type = type; o.frequency.value = freq;\n        g.gain.setValueAtTime(0.1, this.ctx.currentTime);\n        g.gain.exponentialRampToValueAtTime(0.001, this.ctx.currentTime + dur);\n        o.connect(g).connect(this.ctx.destination);\n        o.start(); o.stop(this.ctx.currentTime + dur);\n      }\n      pollenDrop() { this.playChime(880, 0.15); this.playChime(1320, 0.1, 'triangle'); }\n      cross() { [523,659,784].forEach((f,i)=>setTimeout(()=>this.playChime(f,0.2,'sine'),i*80)); }\n      perfect() { [262,330,392,523,659,784].forEach((f,i)=>setTimeout(()=>this.playChime(f,0.3,'triangle'),i*60)); }\n      patron() { this.playChime(1047, 0.2, 'sine'); setTimeout(()=>this.playChime(1319, 0.2, 'sine'), 150); }\n      ambient() {}\n    }\n    const audio = new AudioEngine();\n    \n    // ============ ENTITIES ============\n    class Plant {\n      constructor(genome, plotIndex) {\n        this.genome = genome;\n        this.phenotype = getPhenotype(genome);\n        this.plotIndex = plotIndex;\n        this.age = 0;\n        this.matureTime = 30 + this.phenotype.L4 * 20;\n        this.state = 'growing';\n        this.scale = 0;\n        this.sway = rng.float(0, Math.PI * 2);\n        this.swaySpeed = rng.float(0.3, 0.6);\n      }\n      update(dt) {\n        this.age += dt;\n        this.sway += dt * this.swaySpeed;\n        if (this.state === 'growing') {\n          this.scale = Math.min(1, this.age / this.matureTime);\n          if (this.age >= this.matureTime) this.state = 'mature';\n        }\n      }\n      getColor() {\n        const hue = this.phenotype.L0;\n        const sat = this.phenotype.L1;\n        const locus = LOCI.find(l=>l.id==='L0');\n        const idx = locus.values.indexOf(hue);\n        const base = locus.colors[idx];\n        return base;\n      }\n    }\n    \n    class Particle {\n      constructor(x, y, color, life, vx, vy, size) {\n        this.x = x; this.y = y; this.color = color;\n        this.life = life; this.maxLife = life;\n        this.vx = vx; this.vy = vy; this.size = size;\n      }\n      update(dt) {\n        this.x += this.vx * dt; this.y += this.vy * dt;\n        this.vy += 50 * dt; this.life -= dt;\n      }\n      draw(ctx) {\n        const a = this.life / this.maxLife;\n        ctx.globalAlpha = a;\n        ctx.fillStyle = this.color;\n        ctx.beginPath(); ctx.arc(this.x, this.y, this.size * a, 0, Math.PI * 2); ctx.fill();\n        ctx.globalAlpha = 1;\n      }\n    }\n    \n    class Patron {\n      constructor(data) {\n        this.data = data;\n        this.x = 640; this.y = -100;\n        this.targetY = 80;\n        this.arrived = false;\n        this.timer = 90;\n        this.matchQuality = 0;\n      }\n      update(dt, plants) {\n        if (!this.arrived) {\n          this.y += (this.targetY - this.y) * 0.05;\n          if (Math.abs(this.y - this.targetY) < 1) this.arrived = true;\n        } else {\n          this.timer -= dt;\n          let best = 0;\n          plants.forEach(p => { if (p.state === 'mature') best = Math.max(best, genomeMatch(p.genome, this.data.target)); });\n          this.matchQuality = best;\n          if (this.timer <= 0) return false;\n        }\n        return true;\n      }\n    }\n    \n    // ============ RENDERER ============\n    class Renderer {\n      constructor(canvas) {\n        this.canvas = canvas;\n        this.ctx = canvas.getContext('2d');\n        this.ctx.imageSmoothingEnabled = true;\n        this.width = 1280; this.height = 720;\n        this.particles = [];\n        this.hoverPlot = -1;\n        this.selectedPlot = -1;\n        this.draggingPollen = null;\n        this.dragStart = null;\n      }\n      resize() {\n        const rect = this.canvas.parentElement.getBoundingClientRect();\n        const scale = Math.min(rect.width / this.width, rect.height / this.height);\n        this.canvas.style.width = (this.width * scale) + 'px';\n        this.canvas.style.height = (this.height * scale) + 'px';\n      }\n      hexToPixel(q, r) {\n        const size = 50;\n        const x = size * 1.732 * (q + r / 2);\We are in the middle of the `Renderer` class, specifically the `hexToPixel` method. We need to continue the JSON from the next character after the cut-off.
