  "index.html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Gravity Well Air Hockey</title>\n    <link rel=\"icon\" href=\"data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🌀</text></svg>\" />\n    <link rel=\"stylesheet\" href=\"styles.css\">\n</head>\n<body>\n    <div id=\"loading\">Loading...</div>\n    <canvas id=\"gameCanvas\"></canvas>\n    <div id=\"uiOverlay\">\n        <div id=\"mainMenu\" class=\"menu\">\n            <h1>GRAVITY WELL</h1>\n            <button id=\"soloBtn\">PLAY SOLO</button>\n            <button id=\"versusBtn\">VERSUS LOCAL</button>\n            <button id=\"settingsBtn\">SETTINGS</button>\n        </div>\n        <div id=\"pauseMenu\" class=\"menu\">\n            <h1>PAUSED</h1>\n            <button id=\"resumeBtn\">RESUME</button>\n            <button id=\"restartBtn\">RESTART</button>\n            <button id=\"quitToMenuBtn\">QUIT</button>\n        </div>\n        <div id=\"settingsMenu\" class=\"menu\">\n            <h1>SETTINGS</h1>\n            <label>Gravity Strength: <input type=\"range\" id=\"gravitySlider\" min=\"0.5\" max=\"2.0\" step=\"0.1\" value=\"1.0\"></label>\n            <label>Win Score: <select id=\"winScoreSelect\">\n                <option value=\"3\">3</option>\n                <option value=\"5\">5</option>\n                <option value=\"7\" selected>7</option>\n                <option value=\"10\">10</option>\n                <option value=\"15\">15</option>\n            </select></label>\n            <label>AI Difficulty: <select id=\"aiDiffSelect\">\n                <option value=\"1\">1</option>\n                <option value=\"2\">2</option>\n                <option value=\"3\">3</option>\n                <option value=\"4\">4</option>\n                <option value=\"5\" selected>5</option>\n                <option value=\"6\">6</option>\n                <option value=\"7\">7</option>\n                <option value=\"8\">8</option>\n                <option value=\"9\">9</option>\n                <option value=\"10\">10</option>\n            </select></label>\n            <button id=\"backBtn\">BACK</button>\n        </div>\n        <div id=\"gameOverMenu\" class=\"menu\">\n            <h1 id=\"gameOverTitle\">GAME OVER</h1>\n            <div id=\"statsPanel\"></div>\n            <button id=\"rematchBtn\">REMATCH</button>\n            <button id=\"menuBtn\">MENU</button>\n        </div>\n    </div>\n    <script type=\"module\" src=\"main.js\"></script>\n</body>\n</html>",
  "styles.css": "* {\n    margin: 0;\n    padding: 0;\n    box-sizing: border-box;\n}\n\nbody {\n    background: #050810;\n    color: #e0e8ff;\n    font-family: 'Orbitron', 'Rajdhani', sans-serif;\n    overflow: hidden;\n    height: 100vh;\n    touch-action: manipulation;\n}\n\n#loading {\n    position: absolute;\n    top: 50%;\n    left: 50%;\n    transform: translate(-50%, -50%);\n    font-size: 2rem;\n    color: #00ffff;\n    text-shadow: 0 0 10px rgba(0, 255, 255, 0.7);\n}\n\n#gameCanvas {\n    display: block;\n    width: 100%;\n    height: 100%;\n    background: radial-gradient(ellipse at center, #0a0f1a 0%, #050810 100%);\n    touch-action: none;\n}\n\n#uiOverlay {\n    position: absolute;\n    top: 0;\n    left: 0;\n    width: 100%;\n    height: 100%;\n    pointer-events: none;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n}\n\n.menu {\n    background: rgba(10, 15, 26, 0.85);\n    backdrop-filter: blur(10px);\n    border: 1px solid rgba(0, 255, 255, 0.3);\n    border-radius: 12px;\n    padding: 2rem;\n    text-align: center;\n    width: 90%;\n    max-width: 400px;\n    pointer-events: all;\n    color: #e0e8ff;\n}\n\n.menu h1 {\n    font-size: 2.5rem;\n    margin-bottom: 1.5rem;\n    background: linear-gradient(to right, #00ffff, #ff00ff);\n    -webkit-background-clip: text;\n    -webkit-text-fill-color: transparent;\n    text-shadow: 0 0 10px rgba(0, 255, 255, 0.5);\n}\n\n.menu button {\n    background: transparent;\n    color: #e0e8ff;\n    border: 2px solid currentColor;\n    padding: 0.75rem 2rem;\n    margin: 0.5rem;\n    font-family: inherit;\n    font-size: 1.1rem;\n    border-radius: 6px;\n    cursor: pointer;\n    transition: all 0.2s ease;\n    text-transform: uppercase;\n    letter-spacing: 0.1em;\n}\n\n.menu button:hover {\n    background: currentColor;\n    color: #050810;\n    box-shadow: 0 0 15px currentColor;\n}\n\n.menu label {\n    display: block;\n    margin: 1rem 0;\n    font-size: 1.1rem;\n}\n\n.menu input[type=\"range\"] {\n    width: 100%;\n}\n\n.menu select {\n    width: 100%;\n    padding: 0.5rem;\n    background: rgba(5, 8, 16, 0.7);\n    border: 1px solid rgba(0, 255, 255, 0.3);\n    border-radius: 4px;\n    color: #e0e8ff;\n    font-family: inherit;\n    margin-top: 0.5rem;\n}\n\n#statsPanel {\n    margin: 1.5rem 0;\n    text-align: left;\n    font-size: 1.1rem;\n    line-height: 1.6;\n}\n\n@media (max-height: 500px) {\n    .menu {\n        padding: 1.5rem;\n    }\n    .menu h1 {\n        font-size: 2rem;\n    }\n    .menu button {\n        padding: 0.5rem 1.5rem;\n        font-size: 1rem;\n    }\n}",
  "main.js": "import { Engine } from './src/core/Engine.js';\nimport { UIManager } from './src/ui/UIManager.js';\nimport { Settings } from './src/ui/Settings.js';\nimport { AudioEngine } from './src/audio/AudioEngine.js';\n\nconst canvas = document.getElementById('gameCanvas');\nconst loadingEl = document.getElementById('loading');\n\nasync function init() {\n    try {\n        await AssetLoader.loadFonts();\n        await AudioEngine.init();\n        \n        const settings = new Settings();\n        const uiManager = new UIManager(canvas, settings);\n        const engine = new Engine(canvas, settings, uiManager, AudioEngine);\n        \n        uiManager.setEngine(engine);\n        engine.setUIManager(uiManager);\n        \n        loadingEl.style.display = 'none';\n        engine.start();\n        \n        window.addEventListener('resize', () => engine.onResize());\n    } catch (e) {\n        console.error('Failed to initialize game:', e);\n        loadingEl.textContent = 'Initialization failed. See console.';\n    }\n}\n\nif (document.readyState === 'loading') {\n    document.addEventListener('DOMContentLoaded', init);\n} else {\n    init();\n}",
  "src/core/Engine.js": "import { World } from './physics/World.js';\nimport { InputManager } from './InputManager.js';\nimport { AssetLoader } from './AssetLoader.js';\nimport { Renderer } from '../render/Renderer.js';\nimport { HUDRenderer } from '../render/HUDRenderer.js';\nimport { EntityRenderer } from '../render/EntityRenderer.js';\nimport { FieldRenderer } from '../render/FieldRenderer.js';\nimport { TableRenderer } from '../render/TableRenderer.js';\nimport { Player } from '../entities/Player.js';\nimport { AIController } from '../entities/AIController.js';\n\nconst FIXED_TIMESTEP = 1 / 120;\n\nexport class Engine {\n    constructor(canvas, settings, uiManager, audioEngine) {\n        this.canvas = canvas;\n        this.settings = settings;\n        this.uiManager = uiManager;\n        this.audioEngine = audioEngine;\n        \n        this.ctx = canvas.getContext('2d', { alpha: false });\n        this.world = new World();\n        this.inputManager = new InputManager(canvas);\n        \n        this.tableRenderer = new TableRenderer();\n        this.fieldRenderer = new FieldRenderer();\n        this.entityRenderer = new EntityRenderer();\n        this.hudRenderer = new HUDRenderer();\n        this.renderer = new Renderer(this.ctx, [\n            this.tableRenderer,\n            this.fieldRenderer,\n            this.entityRenderer,\n            this.hudRenderer\n        ]);\n        \n        this.player1 = new Player(0, '#00ffff', true);\n        this.player2 = new Player(1, '#ff00ff', false);\n        this.aiController = new AIController(this.player2, settings);\n        \n        this.world.addBody(this.player1.mallet);\n        this.world.addBody(this.player2.mallet);\n        this.world.addBody(this.world.puck);\n        \n        this.lastTimestamp = 0;\n        this.accumulator = 0;\n        this.isRunning = false;\n        this.isPaused = false;\n        \n        this.bindEvents();\n    }\n    \n    bindEvents() {\n        window.addEventListener('resize', () => this.onResize());\n        this.canvas.addEventListener('pointerdown', (e) => this.onPointerDown(e));\n        this.canvas.addEventListener('pointermove', (e) => this.onPointerMove(e));\n        this.canvas.addEventListener('pointerup', () => this.onPointerUp());\n    }\n    \n    onResize() {\n        const dpr = window.devicePixelRatio > 2 ? 2 : window.devicePixelRatio;\n        this.canvas.width = this.canvas.clientWidth * dpr;\n        this.canvas.height = this.canvas.clientHeight * dpr;\n        this.ctx.scale(dpr, dpr);\n        this.world.setDimensions(this.canvas.clientWidth, this.canvas.clientHeight);\n        this.renderer.onResize();\n    }\n    \n    onPointerDown(e) {\n        if (this.uiManager.isMenuOpen()) return;\n        const rect = this.canvas.getBoundingClientRect();\n        const x = (e.clientX - rect.left) / (rect.width / this.canvas.width) * this.canvas.clientWidth;\n        const y = (e.clientY - rect.top) / (rect.height / this.canvas.height) * this.canvas.clientHeight;\n        const worldPos = this.world.screenToWorld(x, y);\n        \n        if (worldPos.x < -0.15) {\n            this.player1.setTarget(worldPos);\n        } else if (worldPos.x > 0.15) {\n            this.player2.setTarget(worldPos);\n        }\n    }\n    \n    onPointerMove(e) {\n        if (this.uiManager.isMenuOpen()) return;\n        const rect = this.canvas.getBoundingClientRect();\n        const x = (e.clientX - rect.left) / (rect.width / this.canvas.width) * this.canvas.clientWidth;\n        const y = (e.clientY - rect.top) / (rect.height / this.canvas.height) * this.canvas.clientHeight;\n        const worldPos = this.world.screenToWorld(x, y);\n        \n        if (this.player1.isDragging && worldPos.x < -0.15) {\n            this.player1.setTarget(worldPos);\n        } else if (this.player2.isDragging && worldPos.x > 0.15) {\n            this.player2.setTarget(worldPos);\n        }\n    }\n    \n    onPointerUp() {\n        this.player1.stopDragging();\n        this.player2.stopDragging();\n    }\n    \n    start() {\n        this.isRunning = true;\n        this.lastTimestamp = performance.now();\n        this.loop();\n    }\n    \n    loop(timestamp) {\n        if (!this.isRunning) return;\n        \n        const dt = (timestamp - this.lastTimestamp) / 1000;\n        this.lastTimestamp = timestamp;\n        this.accumulator += dt;\n        \n        while (this.accumulator >= FIXED_TIMESTEP) {\n            if (!this.isPaused) {\n                this.update(FIXED_TIMESTEP);\n            }\n            this.accumulator -= FIXED_TIMESTEP;\n        }\n        \n        this.render();\n        requestAnimationFrame(this.loop.bind(this));\n    }\n    \n    update(dt) {\n        this.inputManager.update(dt);\n        \n        if (!this.isPaused) {\n            this.world.applyGravity(dt, this.settings.gravityStrength);\n            this.world.update(dt);\n            \n            this.player1.update(dt, this.inputManager);\n            this.aiController.update(dt, this.world, this.inputManager);\n            \n            this.checkCollisions();\n            this.checkGoals();\n        }\n    }\n    \n    render() {\n        this.ctx.clearRect(0, 0, this.canvas.width, this.canvas.height);\n        this.renderer.render(this.world, this.player1, this.player2, this.settings);\n    }\n    \n    checkCollisions() {\n        // Simplified collision handling\n        const puck = this.world.puck;\n        const mallet1 = this.player1.mallet;\n        const mallet2 = this.player2.mallet;\n        \n        [mallet1, mallet2].forEach(mallet => {\n            const dx = puck.x - mallet.x;\n            const dy = puck.y - mallet.y;\n            const dist = Math.sqrt(dx*dx + dy*dy);\n            const minDist = puck.radius + mallet.radius;\n            \n            if (dist < minDist && dist > 0) {\n                const nx = dx / dist;\n                const ny = dy / dist;\n                const relVelX = puck.vx - mallet.vx;\n                const relVelY = puck.vy - mallet.vy;\n                const relVelAlongNormal = relVelX * nx + relVelY * ny;\n                \n                if (relVelAlongNormal > 0) return;\n                \n                const e = 0.85;\n                const j = -(1 + e) * relVelAlongNormal;\n                const impulse = j / (1/puck.mass + 1/mallet.mass);\n                \n                puck.vx += (impulse / puck.mass) * nx;\n                puck.vy += (impulse / puck.mass) * ny;\n                \n                // Velocity injection\n                puck.vx += mallet.vx * 0.3;\n                puck.vy += mallet.vy * 0.3;\n                \n                this.audioEngine.playHit(impulse);\n                this.world.applyScreenShake(0.1);\n            }\n        });\n        \n        // Wall collisions\n        if (puck.x - puck.radius < -this.world.halfWidth) {\n            puck.x = -this.world.halfWidth + puck.radius;\n            puck.vx = Math.abs(puck.vx) * this.world.wallRestitution;\n            this.audioEngine.playWallBounce();\n        }\n        if (puck.x + puck.radius > this.world.halfWidth) {\n            puck.x = this.world.halfWidth - puck.radius;\n            puck.vx = -Math.abs(puck.vx) * this.world.wallRestitution;\n            this.audioEngine.playWallBounce();\n        }\n        if (puck.y - puck.radius < -this.world.halfHeight) {\n            puck.y = -this.world.halfHeight + puck.radius;\n            puck.vy = Math.abs(puck.vy) * this.world.wallRestitution;\n            this.audioEngine.playWallBounce();\n        }\n        if (puck.y + puck.radius > this.world.halfHeight) {\n            puck.y = this.world.halfHeight - puck.radius;\n            puck.vy = -Math.abs(puck.vy) * this.world.wallRestitution;\n            this.audioEngine.playWallBounce();\n        }\n    }\n    \n    checkGoals() {\n        const puck = this.world.puck;\n        const goalWidth = 0.9;\n        const goalLineX = -this.world.halfWidth;\n        \n        if (puck.x < goalLineX - 0.1 && Math.abs(puck.y) < goalWidth/2) {\n            this.scorePoint(1);\n            return;\n        }\n        \n        const goalLineX2 = this.world.halfWidth;\n        if (puck.x > goalLineX2 + 0.1 && Math.abs(puck.y) < goalWidth/2) {\n            this.scorePoint(0);\n            return;\n        }\n    }\n    \n    scorePoint(scoringPlayerIndex) {\n        this.isPaused = true;\n        const scoringPlayer = scoringPlayerIndex === 0 ? this.player1 : this.player2;\n        const otherPlayer = scoringPlayerIndex === 0 ? this.player2 : this.player1;\n        \n        scoringPlayer.score++;\n        this.audioEngine.playGoal();\n        this.world.applyScreenShake(0.3);\n        \n        setTimeout(() => {\n            if (scoringPlayer.score >= this.settings.winScore) {\n                this.gameOver(scoringPlayerIndex);\n            } else {\n                this.resetRound();\n            }\n        }, 1500);\n    }\n    \n    resetRound() {\n        this.world.resetPuck();\n        this.player1.reset();\n        this.player2.reset();\n        this.isPaused = false;\n        this.serveTimer = 180; // 3 seconds invincibility\n    }\n    \n    gameOver(winningPlayerIndex) {\n        this.uiManager.showGameOver(\n            winningPlayerIndex === 0 ? this.player1 : this.player2,\n            winningPlayerIndex === 1 ? this.player1 : this.player2,\n            this.world.getStats()\n        );\n        this.isRunning = false;\n    }\n}\n\nclass AssetLoader {\n    static async loadFonts() {\n        try {\n            await document.fonts.load('400px Orbitron');\n            await document.fonts.load('400px Rajdhani');\n        } catch (e) {\n            console.warn('Font loading failed, using fallback');\n        }\n    }\n}",
  "src/core/InputManager.js": "export class InputManager {\n    constructor(canvas) {\n        this.canvas = canvas;\n        this.keys = {};\n        this.pointers = new Map();\n        this.gamepads = [];\n        \n        window.addEventListener('keydown', (e) => this.keys[e.code] = true);\n        window.addEventListener('keyup', (e) => this.keys[e.code] = false);\n    }\n    \n    update(dt) {\n        this.gamepads = navigator.getGamepads ? [...navigator.getGamepads()].filter(gp => gp) : [];\n    }\n    \n    isKeyPressed(code) {\n        return this.keys[code] || false;\n    }\n    \n    getPointerPosition() {\n        if (this.pointers.size === 0) return null;\n        const first = this.pointers.values().next().value;\n        return { x: first.x, y: first.y };\n    }\n    \n    getGamepadAxes() {\n        if (this.gamepads.length === 0) return [0, 0];\n        const gp = this.gamepads[0];\n        return [gp.axes[0], gp.axes[1]];\n    }\n}",
  "src/core/AssetLoader.js": "export class AssetLoader {\n    static async loadFonts() {\n        try {\n            await document.fonts.load('400px Orbitron');\n            await document.fonts.load('400px Rajdhani');\n        } catch (e) {\n            console.warn('Font loading failed, using fallback');\n        }\n    }\n}",
  "src/physics/World.js": "const G_CONST = 18.0;\nconst SOFTENING_RADIUS = 0.05;\nconst MAX_RADIUS = 1.5;\n\nexport class World {\n    constructor() {\n        this.reset();\n    }\n    \n    reset() {\n        this.halfWidth = 2.0;\n        this.halfHeight = 1.125;\n        this.wallRestitution = 0.95;\n        this.puck = {\n            x: 0, y: 0,\n            vx: 0, vy: 0,\n            radius: 0.0635,\n            mass: 0.05,\n            restitution: 0.95\n        };\n        this.mallets = [];\n        this.score = { p1: 0, p2: 0 };\n        this.screenShakeTrauma = 0;\n    }\n    \n    setDimensions(canvasWidth, canvasHeight) {\n        this.canvasWidth = canvasWidth;\n        this.canvasHeight = canvasHeight;\n        this.ppm = Math.min(canvasWidth / (this.halfWidth * 2), canvasHeight / (this.halfHeight * 2));\n    }\n    \n    screenToWorld(screenX, screenY) {\n        return {\n            x: (screenX - this.canvasWidth / 2) / this.ppm,\n            y: (screenY - this.canvasHeight / 2) / this.ppm\n        };\n    }\n    \n    worldToScreen(worldX, worldY) {\n        return {\n            x: worldX * this.ppm + this.canvasWidth / 2,\n            y: worldY * this.ppm + this.canvasHeight / 2\n        };\n    }\n    \n    applyGravity(dt, gravityScale) {\n        const puck = this.puck;\n        const dx = 0 - puck.x;\n        const dy = 0 - puck.y;\n        const distSq = dx*dx + dy*dy;\n        const dist = Math.sqrt(distSq);\n        \n        if (dist < MAX_RADIUS && dist > 0.001) {\n            const effectiveDist = Math.max(dist, SOFTENING_RADIUS);\n            const forceMagnitude = G_CONST * gravityScale / (effectiveDist * effectiveDist);\n            const accel = Math.min(forceMagnitude, 500.0);\n            puck.vx += (dx / dist) * accel * dt;\n            puck.vy += (dy / dist) * accel * dt;\n        }\n    }\n    \n    update(dt) {\n        // Simple damping\n        this.puck.vx *= 1 - 0.005 * dt;\n        this.puck.vy *= 1 - 0.005 * dt;\n        \n        // Max speed clamp\n        const speed = Math.sqrt(this.puck.vx**2 + this.puck.vy**2);\n        if (speed > 35) {\n            const scale = 35 / speed;\n            this.puck.vx *= scale;\n            this.puck.vy *= scale;\n        }\n        \n        this.puck.x += this.puck.vx * dt;\n        this.puck.y += this.puck.vy * dt;\n        \n        // Update mallets\n        this.mallets.forEach(mallet => {\n            mallet.x += mallet.vx * dt;\n            mallet.y += mallet.vy * dt;\n            \n            // Keep mallet in bounds\n            const maxX = this.halfWidth - mallet.radius - 0.15;\n            const minX = -this.halfWidth + mallet.radius + 0.15;\n            if (mallet.playerId === 0) {\n                mallet.x = Math.min(mallet.x, maxX);\n            } else {\n                mallet.x = Math.max(mallet.x, minX);\n            }\n            mallet.x = Math.max(Math.min(mallet.x, this.halfWidth - mallet.radius), -this.halfWidth + mallet.radius);\n            mallet.y = Math.max(Math.min(mallet.y, this.halfHeight - mallet.radius), -this.halfHeight + mallet.radius);\n        });\n    }\n    \n    resetPuck() {\n        this.puck.x = 0;\n        this.puck.y = 0;\n        this.puck.vx = 0;\n        this.puck.vy = 0;\n    }\n    \n    addBody(body) {\n        if (body.type === 'mallet') this.mallets.push(body);\n    }\n    \n    applyScreenShake(amount) {\n        this.screenShakeTrauma = Math.min(1, this.screenShakeTrauma + amount);\n    }\n    \n    getScreenShakeOffset() {\n        if (this.screenShakeTrauma <= 0) return { x: 0, y: 0 };\n        const offset = this.screenShakeTrauma ** 2 * 15;\n        return {\n            x: (Math.random() * 2 - 1) * offset,\n            y: (Math.random() * 2 - 1) * offset\n        };\n    }\n    \n    updateScreenShake(dt) {\n        this.screenShakeTrauma = Math.max(0, this.screenShakeTrauma - dt * 2);\n    }\n    \n    getStats() {\n        return {\n            maxSpeed: Math.sqrt(this.puck.vx**2 + this.puck.vy**2),\n            timeSurvived: 0 // Simplified\n        };\n    }\n}",
  "src/physics/Solver.js": "export class Solver {\n    static solveCollisions(world, dt) {\n        // Simplified - handled in Engine for this implementation\n    }\n}",
  "src/physics/Bodies.js": "export class Puck {\n    constructor() {\n        this.type = 'puck';\n        this.radius = 0.0635;\n        this.mass = 0.05;\n        this.restitution = 0.95;\n        this.reset();\n    }\n    \n    reset() {\n        this.x = 0;\n        this.y = 0;\n        this.vx = 0;\n        this.vy = 0;\n    }\n}\n\nexport class Mallet {\n    constructor(playerId, color) {\n        this.type = 'mallet';\n        this.playerId = playerId;\n        this.color = color;\n        this.radius = 0.095;\n        this.mass = 2.0;\n        this.restitution = 0.85;\n        this.x = 0;\n        this.y = 0;\n        this.vx = 0;\n        this.vy = 0;\n        this.targetX = 0;\n        this.targetY = 0;\n        this.isDragging = false;\n    }\n    \n    setTarget(x, y) {\n        this.targetX = x;\n        this.targetY = y;\n    }\n    \n    startDragging() {\n        this.isDragging = true;\n    }\n    \n    stopDragging() {\n        this.isDragging = false;\n    }\n}",
  "src/entities/Player.js": "import { Mallet } from '../physics/Bodies.js';\n\nexport class Player {\n    constructor(id, color, isHuman) {\n        this.id = id;\n        this.color = color;\n        this.isHuman = isHuman;\n        this.score = 0;\n        this.mallet = new Mallet(id, color);\n        this.kp = 1200;\n        this.kd = 65;\n        this.prevX = 0;\n        this.prevY = 0;\n    }\n\n    update(dt, inputManager) {\n        if (this.isHuman) {\n            const targetX = this.mallet.targetX;\n            const targetY = this.mallet.targetY;\n            const dx = targetX - this.mallet.x;\n            const dy = targetY - this.mallet.y;\n            const velX = dx * this.kp - this.mallet.vx * this.kd;\n            const velY = dy * this.kp - this.mallet.vy * this.kd;\n            this.mallet.vx += velX * dt;\n            this.mallet.vy += velY * dt;\n        }\n    }\n"