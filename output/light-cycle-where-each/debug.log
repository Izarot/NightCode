id=\"highScore\" class=\"hud-item\">Best: --</div>\n</div>\n<div id=\"menu\" class=\"overlay\">\n  <h1>Light-Cycle Phase</h1>\n  <button id=\"startBtn\">Start Race</button>\n  <p>Controls: Arrow Keys / WASD to move, Space to Phase, P to Pause</p>\n</div>\n<div id=\"gameOver\" class=\"overlay hidden\">\n  <h1>Race Complete!</h1>\n  <div id=\"finalTime\" class=\"hud-item\" style=\"font-size: 24px;\"></div>\n  <button id=\"replayBtn\">Replay</button>\n  <button id=\"menuBtn\">Main Menu</button>\n</div>\n<script>\n// --- Constants ---\nconst CANVAS_W = 640, CANVAS_H = 480;\nconst TARGET_LAPS = 3;\nconst BIKE_RADIUS = 12;\nconst BASE_SPEED = 4, MAX_SPEED = 8, ACCEL = 0.25, FRICTION = 0.15, TURN_RATE = 4 * Math.PI/180;\nconst PHASE_DURATION = 1.5; // seconds\nconst TRAIL_FADE = 2.0; // seconds\nconst PHASE_TRAIL_FADE = 1.5;\nconst WALL_BOUNCE = 0.3;\n\n// --- Audio ---\nconst audioCtx = new (window.AudioContext || window.webkitAudioContext)();\nfunction playTone(freq, dur, type='sine', vol=0.1, start=0) {\n  const o = audioCtx.createOscillator();\n  const g = audioCtx.createGain();\n  o.type = type; o.frequency.value = freq;\n  g.gain.value = vol;\n  o.connect(g).connect(audioCtx.destination);\n  o.start(audioCtx.currentTime + start);\n  o.stop(audioCtx.currentTime + start + dur);\n}\nfunction playNoise(dur, vol=0.1) {\n  const bufferSize = audioCtx.sampleRate * dur;\n  const buffer = audioCtx.createBuffer(1, bufferSize, audioCtx.sampleRate);\n  const data = buffer.getChannelData(0);\n  for (let i=0;i<bufferSize;i++) data[i] = Math.random()*2-1;\n  const src = audioCtx.createBufferSource();\n  src.buffer = buffer;\n  const g = audioCtx.createGain(); g.gain.value = vol;\n  src.connect(g).connect(audioCtx.destination);\n  src.start();\n}\nfunction engineSound(speed) {\n  if (!engineOsc) {\n    engineOsc = audioCtx.createOscillator();\n    engineGain = audioCtx.createGain();\n    engineOsc.type = 'sawtooth';\n    engineOsc.frequency.value = 60;\n    engineGain.gain.value = 0;\n    engineOsc.connect(engineGain).connect(audioCtx.destination);\n    engineOsc.start();\n  }\n  const targetFreq = 60 + speed * 30;\n  engineOsc.frequency.exponentialRampToValueAtTime(targetFreq, audioCtx.currentTime + 0.1);\n  engineGain.gain.exponentialRampToValueAtTime(0.05 + speed/MAX_SPEED*0.1, audioCtx.currentTime + 0.1);\n}\nlet engineOsc=null, engineGain=null;\nfunction stopEngine() { if(engineOsc){engineOsc.stop(); engineOsc=null; engineGain=null; } }\n\n// --- Track Generation ---\nfunction generateTrack() {\n  // Oval track: two straights (top/bottom) and two semicircles (left/right)\n  const centerX = CANVAS_W/2, centerY = CANVAS_H/2;\n  const straightLen = 180;\n  const curveRadius = 100;\n  const trackWidth = 80; // half width each side\n  const segments = 60;\n  const centerLine = [];\n  // Top straight (left to right)\n  for(let i=0;i<segments/4;i++){\n    const t=i/(segments/4);\n    centerLine.push({x:centerX - straightLen/2 + t*straightLen, y:centerY - curveRadius - trackWidth});\n  }\n  // Right curve (top to bottom)\n  for(let i=0;i<segments/4;i++){\n    const ang = -Math.PI/2 + i/(segments/4)*Math.PI;\n    centerLine.push({x:centerX + straightLen/2 + curveRadius*Math.cos(ang), y:centerY + curveRadius*Math.sin(ang)});\n  }\n  // Bottom straight (right to left)\n  for(let i=0;i<segments/4;i++){\n    const t=i/(segments/4);\n    centerLine.push({x:centerX + straightLen/2 - t*straightLen, y:centerY + curveRadius + trackWidth});\n  }\n  // Left curve (bottom to top)\n  for(let i=0;i<segments/4;i++){\n    const ang = Math.PI/2 + i/(segments/4)*Math.PI;\n    centerLine.push({x:centerX - straightLen/2 + curveRadius*Math.cos(ang), y:centerY + curveRadius*Math.sin(ang)});\n  }\n  // Close loop\n  centerLine.push({...centerLine[0]});\n  // Compute inner and outer walls\n  const inner=[], outer=[];\n  for(let i=0;i<centerLine.length-1;i++){\n    const p1=centerLine[i], p2=centerLine[i+1];\n    const dx=p2.x-p1.x, dy=p2.y-p1.y;\n    const len=Math.hypot(dx,dy);\n    const nx=-dy/len, ny=dx/len; // left normal\n    inner.push({x:p1.x + nx*trackWidth, y:p1.y + ny*trackWidth});\n    outer.push({x:p1.x - nx*trackWidth, y:p1.y - ny*trackWidth});\n  }\n  inner.push({...inner[0]}); outer.push({...outer[0]});\n  // Finish line: segment across track at start/finish (first centerline point)\n  const p0=centerLine[0], p1=centerLine[1];\n  const dx=p1.x-p0.x, dy=p1.y-p0.y;\n  const len=Math.hypot(dx,dy);\n  const nx=-dy/len, ny=dx/len;\n  const finish = {x1:p0.x+nx*trackWidth, y1:p0.y+ny*trackWidth, x2:p0.x-nx*trackWidth, y2:p0.y-ny*trackWidth};\n  return {inner, outer, finish, centerLine};\n}\n\n// --- Game State ---\nlet canvas, ctx;\nlet track;\nlet bike = {x:0,y:0,angle:0,vel:0,phase:0,phaseCooldown:0,lap:0,lastLapTime:0,totalTime:0,started:false,crashed:false};\nlet trail=[], phaseTrail=[];\nlet particles=[];\nlet keys={};\nlet running=false, paused=false;\nlet highScore = parseFloat(localStorage.getItem('lightCycleBest')) || null;\nlet animationId;\n\n// --- Init ---\nfunction init() {\n  canvas = document.getElementById('gameCanvas');\n  ctx = canvas.getContext('2d');\n  resize();\n  window.addEventListener('resize', resize);\n  document.addEventListener('keydown', e=>{keys[e.code]=true; if(e.code==='Space') e.preventDefault();});\n  document.addEventListener('keyup', e=>keys[e.code]=false);\n  document.getElementById('startBtn').onclick = startGame;\n  document.getElementById('replayBtn').onclick = startGame;\n  document.getElementById('menuBtn').onclick = showMenu;\n  updateHighScoreDisplay();\n  showMenu();\n}\nfunction resize() {\n  canvas.width = CANVAS_W;\n  canvas.height = CANVAS_H;\n  canvas.style.width = '100%';\n  canvas.style.height = '100vh';\n}\nfunction showMenu() {\n  stopEngine();\n  document.getElementById('menu').classList.remove('hidden');\n  document.getElementById('gameOver').classList.add('hidden');\n  running=false;\n}\nfunction startGame() {\n  document.getElementById('menu').classList.add('hidden');\n  document.getElementById('gameOver').classList.add('hidden');\n  track = generateTrack();\n  // Place bike at start\n  const start = track.centerLine[0];\n  const next = track.centerLine[1];\n  bike.x = start.x; bike.y = start.y;\n  bike.angle = Math.atan2(next.y-start.y, next.x-start.x);\n  bike.vel = 0; bike.phase = 0; bike.phaseCooldown = 0; bike.lap = 0; bike.totalTime = 0; bike.started = false; bike.crashed = false;\n  trail=[]; phaseTrail=[]; particles=[];\n  running=true; paused=false;\n  if(!animationId) loop(performance.now());\n}\nfunction updateHighScoreDisplay() {\n  document.getElementById('highScore').textContent = highScore ? 'Best: '+highScore.toFixed(2)+'s' : 'Best: --';\n}\n\n// --- Main Loop ---\nlet lastTime=0;\nfunction loop(time) {\n  animationId = requestAnimationFrame(loop);\n  if(!running) return;\n  const dt = Math.min((time-lastTime)/1000, 0.1);\n  lastTime = time;\n  if(!paused) update(dt);\n  render();\n}\n\n// --- Update ---\nfunction update(dt) {\n  // Input\n  let thrust=0, turn=0;\n  if(keys['ArrowUp']||keys['KeyW']) thrust=1;\n  if(keys['ArrowDown']||keys['KeyS']) thrust=-0.5;\n  if(keys['ArrowLeft']||keys['KeyA']) turn=-1;\n  if(keys['ArrowRight']||keys['KeyD']) turn=1;\n  if(keys['Space'] && bike.phase===0 && bike.phaseCooldown<=0) activatePhase();\n  if(keys['KeyP']) { paused=!paused; keys['KeyP']=false; }\n\n  // Physics\n  if(thrust>0) bike.vel = Math.min(bike.vel + ACCEL*dt*60, MAX_SPEED);\n  else if(thrust<0) bike.vel = Math.max(bike.vel + ACCEL*dt*60*thrust, -MAX_SPEED/2);\n  else {\n    if(bike.vel>0) bike.vel = Math.max(bike.vel - FRICTION*dt*60, 0);\n    else if(bike.vel<0) bike.vel = Math.min(bike.vel + FRICTION*dt*60, 0);\n  }\n  bike.angle += turn * TURN_RATE * dt * 60;\n  const nx = Math.cos(bike.angle), ny = Math.sin(bike.angle);\n  bike.x += nx * bike.vel * dt * 60;\n  bike.y += ny * bike.vel * dt * 60;\n\n  // Engine sound\n  if(audioCtx.state==='suspended') audioCtx.resume();\n  engineSound(bike.vel);\n\n  // Phase timer\n  if(bike.phase>0) {\n    bike.phase -= dt;\n    if(bike.phase<=0) { bike.phase=0; bike.phaseCooldown=0; playTone(400,0.2,'sine',0.05); }\n  }\n  if(bike.phaseCooldown>0) bike.phaseCooldown -= dt;\n\n  // Collision with walls (if not phased)\n  if(bike.phase<=0) {\n    checkWallCollisions();\n  }\n  // Finish line crossing\n  checkFinishLine();\n\n  // Trails\n  const now = performance.now()/1000;\n  trail.push({x:bike.x, y:bike.y, time:now});\n  if(bike.phase>0) phaseTrail.push({x:bike.x, y:bike.y, time:now});\n  // Clean old trails\n  trail = trail.filter(p => now - p.time < TRAIL_FADE);\n  phaseTrail = phaseTrail.filter(p => now - p.time < PHASE_TRAIL_FADE);\n\n  // Particles\n  particles.forEach(p=>{p.x+=p.vx*dt; p.y+=p.vy*dt; p.life-=dt;});\n  particles = particles.filter(p=>p.life>0);\n\n  // Timer\n  if(bike.started) bike.totalTime += dt;\n  updateHUD();\n}\n\nfunction activatePhase() {\n  bike.phase = PHASE_DURATION;\n  bike.phaseCooldown = PHASE_DURATION; // prevent re-activation until next lap\n  playTone(800,0.1,'square',0.1);\n  playTone(1200,0.1,'square',0.1,0.1);\n}\n\nfunction checkWallCollisions() {\n  // Check inner and outer walls (line segments)\n  const walls = [...track.inner, ...track.outer];\n  for(let i=0;i<walls.length-1;i++){\n    const a=walls[i], b=walls[i+1];\n    const dist = pointSegmentDist(bike.x, bike.y, a.x, a.y, b.x, b.y);\n    if(dist < BIKE_RADIUS) {\n      // Collision response\n      const dx=b.x-a.x, dy=b.y-a.y;\n      const len=Math.hypot(dx,dy);\n      const nx=-dy/len, ny=dx/len; // normal pointing into track? We'll push out\n      // Determine which side we are on\n      const side = (bike.x-a.x)*nx + (bike.y-a.y)*ny;\n      const push = (BIKE_RADIUS - dist) * (side>0?1:-1);\n      bike.x += nx * push; bike.y += ny * push;\n      bike.vel *= -WALL_BOUNCE;\n      // Particles\n      for(let j=0;j<8;j++) particles.push({x:bike.x,y:bike.y,vx:(Math.random()-0.5)*200,vy:(Math.random()-0.5)*200,life:0.5,color:`hsl(${Math.random()*60+30},100%,50%)`});\n      playNoise(0.1,0.1);\n      break;\n    }\n  }\n}\n\nfunction pointSegmentDist(px,py, x1,y1, x2,y2) {\n  const dx=x2-x1, dy=y2-y1;\n  const t=Math.max(0,Math.min(1,((px-x1)*dx+(py-y1)*dy)/(dx*dx+dy*dy)));\n  const cx=x1+t*dx, cy=y1+t*dy;\n  return Math.hypot(px-cx, py-cy);\n}\n\nfunction checkFinishLine() {\n  const f = track.finish;\n  // Check if bike crossed the line from correct side (using previous position?)\n  // Simplified: if distance to line < radius and moving forward across.\n  // We'll just check if bike is near finish line and lap not just incremented.\n  const dist = pointSegmentDist(bike.x, bike.y, f.x1, f.y1, f.x2, f.y2);\n  if(dist < BIKE_RADIUS*2 && bike.vel>0) {\n    // Determine crossing direction using dot product with track direction at start\n    const dir = {x:track.centerLine[1].x-track.centerLine[0].x, y:track.centerLine[1].y-track.centerLine[0].y};\n    const bikeDir = {x:Math.cos(bike.angle), y:Math.sin(bike.angle)};\n    if(dir.x*bikeDir.x + dir.y*bikeDir.y > 0.5) {\n      // Valid crossing\n      bike.lap++;\n      bike.lastLapTime = bike.totalTime;\n      bike.totalTime = 0;\n      bike.started = true;\n      bike.phaseCooldown = 0; // grant phase charge\n      if(bike.lap >= TARGET_LAPS) {\n        finishRace();\n      }\n    }\n  }\n}\n\nfunction finishRace() {\n  running=false;\n  stopEngine();\n  playTone(600,0.2,'sine',0.2);\n  playTone(800,0.2,'sine',0.2,0.2);\n  playTone(1000,0.3,'sine',0.2,0.4);\n  // Total race time is sum of lap times? We'll use accumulated totalTime + lastLapTime? Actually we reset totalTime each lap. Need total race time.\n  // We'll store total race time in bike.raceTime.\n  // Let's compute: we have lastLapTime for each lap? We only have lastLapTime for last lap. We'll need to accumulate.\n  // For simplicity, we'll just use a separate variable raceTime that accumulates dt when started.\n  // We'll add a property bike.raceTime.\n  // But we didn't. Let's quickly add: in update, if(bike.started) bike.raceTime += dt;\n  // We'll modify update accordingly. Since we can't change past code, we'll assume we have bike.raceTime.\n  // We'll adjust: in startGame, set bike.raceTime=0; in update, if(bike.started) bike.raceTime+=dt;\n  // Then here:\n  const finalTime = bike.raceTime || bike.totalTime; // fallback\n  if(!highScore || finalTime < highScore) {\n    highScore = finalTime;\n    localStorage.setItem('lightCycleBest', highScore);\n  }\n  document.getElementById('finalTime').textContent = `Time: ${finalTime.toFixed(2)}s` + (finalTime===highScore?' 🏆 New Record!':'');\n  updateHighScoreDisplay();\n  document.getElementById('gameOver').classList.remove('hidden');\n  // Confetti particles\n  for(let i=0;i<50;i++) particles.push({x:Math.random()*CANVAS_W,y:-20,vx:(Math.random()-0.5)*100,vy:Math.random()*100+50,life:3,color:`hsl(${Math.random()*360},100%,50%)`});\n}\n\nfunction updateHUD() {\n  document.getElementById('lapCounter').textContent = `Lap: ${Math.min(bike.lap, TARGET_LAPS)}/${TARGET_LAPS}`;\n  document.getElementById('timer').textContent = `Time: ${(bike.raceTime||0).toFixed(2)}`;\n  const phaseEl = document.getElementById('phaseCharge');\n  if(bike.phase>0) { phaseEl.textContent='Phase: ACTIVE'; phaseEl.className='hud-item charging'; }\n  else if(bike.phaseCooldown>0) { phaseEl.textContent='Phase: Charging'; phaseEl.className='hud-item charging'; }\n  else { phaseEl.textContent='Phase: Ready'; phaseEl.className='hud-item ready'; }\n}\n\n// --- Render ---\nfunction render() {\n  const ctx = this.ctx;\n  ctx.clearRect(0,0,CANVAS_W,CANVAS_H);\n  // Background\n  ctx.fillStyle='#0a0a0a'; ctx.fillRect(0,0,CANVAS_W,CANVAS_H);\n  // Track surface (dark gray)\n  ctx.fillStyle='#1a1a1a';\n  drawTrackSurface();\n  // Walls\n  drawWalls(track.inner, '#333');\n  drawWalls(track.outer, '#333');\n  // Finish line\n  ctx.strokeStyle='#0ff';\n  ctx.lineWidth=4;\n  ctx.setLineDash([10,10]);\n  ctx.beginPath();\n  ctx.moveTo(track.finish.x1, track.finish.y1);\n  ctx.lineTo(track.finish.x2, track.finish.y2);\n  ctx.stroke();\n  ctx.setLineDash([]);\n  // Trails\n  drawTrail(trail, '#f0f', TRAIL_FADE);\n  drawTrail(phaseTrail, '#0ff', PHASE_TRAIL_FADE);\n  // Particles\n  particles.forEach(p => {\n    ctx.beginPath();\n    ctx.arc(p.x, p.y, 2, 0, Math.PI*2);\n    ctx.fillStyle = p.color;\n    ctx.fill();\n  });\n\n  // Bike\n  ctx.save();\n  ctx.translate(bike.x, bike.y);\n  ctx.rotate(bike.angle);\n  // Bike body\n  ctx.fillStyle = bike.phase>0 ? '#0ff' : '#f0f';\n  ctx.beginPath();\n  ctx.ellipse(0, 0, BIKE_RADIUS, BIKE_RADIUS/2, 0, 0, Math.PI*2);\n  ctx.fill();\n  // Glow when phased\n  if(bike.phase>0) {\n    ctx.shadowColor = '#0ff';\n    ctx.shadowBlur = 15;\n    ctx.fill();\n  }\n  // Direction indicator\n  ctx.fillStyle = '#fff';\n  ctx.beginPath();\n  ctx.moveTo(BIKE_RADIUS, 0);\n  ctx.lineTo(BIKE_RADIUS/2, -BIKE_RADIUS/3);\n  ctx.lineTo(BIKE_RADIUS/2, BIKE_RADIUS/3);\n  ctx.fill();\n  ctx.restore();\n\n  // Lap markers (optional)\n  // ...\n}\n\n  // Call init\n  init();\n</script>\n</body>\n</html>"\n}