\"alive\">12 ALIVE</div>\n<div id=\"timer\">00:00</div>\n<div id=\"highscore\">BEST: --</div>\n<canvas id=\"minimap\"></canvas>\n<div id=\"healthBar\"><div id=\"healthFill\"></div></div>\n<div id=\"shieldBar\"><div id=\"shieldFill\"></div></div>\n<div id=\"weaponInfo\">PISTON<br>15 / 45</div>\n<div id=\"crosshair\"><svg width=\"24\" height=\"24\"><circle cx=\"12\" cy=\"12\" r=\"8\" fill=\"none\" stroke=\"#fff\" stroke-width=\"1\" opacity=\".7\"/><line x1=\"12\" y1=\"0\" x2=\"12\" y2=\"6\" stroke=\"#fff\"/><line x1=\"12\" y1=\"18\" x2=\"12\" y2=\"24\" stroke=\"#fff\"/><line x1=\"0\" y1=\"12\" x2=\"6\" y2=\"12\" stroke=\"#fff\"/><line x1=\"18\" y1=\"12\" x2=\"24\" y2=\"12\" stroke=\"#fff\"/></svg></div>\n<div id=\"killfeed\"></div>\n</div>\n<div id=\"mobileControls\">\n<div class=\"joystick\" id=\"joyLeft\"></div>\n<div class=\"joystick\" id=\"joyRight\"></div>\n</div>\n<div id=\"menu\">\n<h1>VOID CLOSURE</h1>\n<button class=\"btn\" onclick=\"startGame()\">PLAY</button>\n<button class=\"btn\" onclick=\"showCredits()\">CREDITS</button>\n</div>\n<div id=\"deathScreen\">\n<h2>ELIMINATED</h2>\n<div class=\"stat\" id=\"deathStats\"></div>\n<button class=\"btn\" onclick=\"startGame()\">PLAY AGAIN</button>\n</div>\n<div id=\"victoryScreen\">\n<h2>VOID CHAMPION</h2>\n<div class=\"stat\" id=\"victoryStats\"></div>\n<button class=\"btn\" onclick=\"startGame()\">PLAY AGAIN</button>\n</div>\n</div>\n<script>\nconst canvas=document.getElementById('game');\nconst ctx=canvas.getContext('2d');\nconst minimap=document.getElementById('minimap');\nconst minimapCtx=minimap.getContext('2d');\nlet W,H,scale;\nfunction resize(){W=canvas.width=window.innerWidth;H=canvas.height=window.innerHeight;minimap.width=minimap.height=150;scale=Math.min(W/1920,H/1080)}\nresize();\nwindow.addEventListener('resize',resize);\n\n// Audio\nconst audioCtx=new(window.AudioContext||window.webkitAudioContext)();\nfunction playSound(freq,dur,type='square',vol=.1){const o=audioCtx.createOscillator();const g=audioCtx.createGain();o.type=type;o.frequency.value=freq;g.gain.setValueAtTime(vol,audioCtx.currentTime);g.gain.exponentialRampToValueAtTime(.001,audioCtx.currentTime+dur);o.connect(g);g.connect(audioCtx.destination);o.start();o.stop(audioCtx.currentTime+dur)}\nfunction shoot(weapon){const freqs={piston:800,shotgun:400,smg:600,sniper:200,launcher:150,railgun:300};playSound(freqs[weapon]||500,.1,'square',.15);playSound(freqs[weapon]||500,.05,'sawtooth',.1)}\nfunction hit(){playSound(300,.1,'sine',.2)}\nfunction pickUp(){playSound(1200,.1,'sine',.15)}\nfunction death(){playSound(100,.5,'sawtooth',.2)}\nfunction victory(){[523,659,784,1047].forEach((f,i)=>setTimeout(()=>playSound(f,.3,'sine',.2),i*150))}\n\n// Game State\nlet gameState='menu',players=[],projectiles=[],loots=[],particles=[],killFeed=[],time=0,gameTime=0,currentPhase=0,safeRadius=1000,shrinkCenter={x:0,y:0},supplyDrops=[],buildings=[];\nlet player,keys={},mouse={x:W/2,y:H/2},highScore=parseInt(localStorage.getItem('voidClosureHighScore'))||0;\ndocument.getElementById('highscore').textContent='BEST: '+(highScore?formatTime(highScore):'--');\n\nconst WEAPONS={piston:{name:'PISTON',dmg:12,rate:3,reload:1.2,mag:15,color:'#aaa',spread:0.05,speed:800,type:'bullet'},shotgun:{name:'SHOTGUN',dmg:8,rate:1,reload:2,mag:6,color:'#4a4',spread:0.3,pellets:6,speed:600,type:'bullet'},smg:{name:'SMG',dmg:10,rate:10,reload:2.5,mag:45,color:'#4aa',spread:0.1,speed:700,type:'bullet'},sniper:{name:'SNIPER',dmg:75,rate:0.5,reload:2.5,mag:5,color:'#44f',spread:0,range:1500,type:'hitscan'},launcher:{name:'LAUNCHER',dmg:50,rate:0.8,reload:3,mag:3,color:'#a4a',spread:0.15,speed:400,blast:60,type:'rocket'},railgun:{name:'RAILGUN',dmg:45,rate:1,reload:4,mag:3,color:'#f4f',spread:0,charge:.8,pierce:1,type:'pierce'}};\nconst COLORS=['#ff3366','#33ff66','#3366ff','#ffff33','#ff33ff','#33ffff','#ff8833','#8833ff','#33ff88','#ff3333','#33ff33','#3333ff'];\n\nfunction formatTime(s){return Math.floor(s/60)+':'+(s%60<10?'0':'')+s%60}\n\nclass Entity{constructor(x,y,r,color){this.x=x;this.y=y;this.r=r;this.color=color;this.vx=0;this.vy=0}}\nclass Player extends Entity{constructor(x,y,isBot,color){super(x,y,12,color||COLORS[Math.floor(Math.random()*COLORS.length)]);this.isBot=isBot;this.hp=100;this.shield=0;this.shieldRegen=0;this.weapon=null;this.ammo=0;this.reserve=0;this.lastShot=0;this.reloading=false;this.reloadTime=0;this.angle=0;this.speed=240;this.accel=1800;this.kills=0;this.dmgDealt=0;this.alive=true;this.botTarget=null;this.botWander={x:x,y:y,time:0}}\nclass Projectile{constructor(x,y,vx,vy,dmg,owner,color,weapon){this.x=x;this.y=y;this.vx=vx;this.vy=vy;this.dmg=dmg;this.owner=owner;this.color=color;this.weapon=weapon;this.life=2;this.trail=[]}}\nclass Loot{constructor(x,y,type,rarity){this.x=x;this.y=y;this.type=type;this.rarity=rarity;this.r=8;this.pulse=Math.random()*Math.PI*2;const colors={common:'#aaa',uncommon:'#4a4',rare:'#44f',epic:'#a4a'};this.color=colors[rarity]||'#aaa'}}\nclass Particle{constructor(x,y,vx,vy,color,life,size){this.x=x;this.y=y;this.vx=vx;this.vy=vy;this.color=color;this.life=life;this.maxLife=life;this.size=size||2}}\n\nfunction generateMap(){\nconst mapW=1800,mapH=1400;\nshrinkCenter={x:mapW/2,y:mapH/2};\nsafeRadius=mapW/2;\nbuildings=[];\nfor(let i=0;i<12;i++){\nconst bw=80+Math.random()*100,bh=60+Math.random()*80;\nbuildings.push({x:Math.random()*(mapW-bw-100)+50,y:Math.random()*(mapH-bh-100)+50,w:bw,h:bh});\n}\nloots=[];\nbuildings.forEach(b=>{\nconst items=3+Math.floor(Math.random()*3);\nfor(let i=0;i<items;i++)loots.push(createLoot(b.x+Math.random()*b.w,b.y+Math.random()*b.h));\n});\nfor(let i=0;i<30;i++)loots.push(createLoot(100+Math.random()*(mapW-200),100+Math.random()*(mapH-200)));\n}\n\nfunction createLoot(x,y){\nconst types=['weapon','shield'];\nconst type=types[Math.floor(Math.random()*types.length)];\nlet rarity='common',r=Math.random();\nif(r>.98)rarity='epic';else if(r>.9)rarity='rare';else if(r>.7)rarity='uncommon';\nif(type==='weapon'){\nconst weapons=['piston','shotgun','smg','sniper','launcher','railgun'];\nconst w=weapons[Math.floor(Math.random()*weapons.length)];\nreturn new Loot(x,y,w,rarity);\n}else return new Loot(x,y,'shield',rarity);\n}\n\nfunction spawnPlayers(){\nplayers=[];\nplayer=new Player(200+Math.random()*200,200+Math.random()*200,false);\nplayer.weapon='piston';player.ammo=15;player.reserve=45;\nplayers.push(player);\nfor(let i=1;i<12;i++){\nconst p=new Player(100+Math.random()*1600,100+Math.random()*1200,true);\np.weapon='piston';p.ammo=15;p.reserve=45;\nplayers.push(p);\n}\n}\n\nfunction startGame(){\nif(audioCtx.state==='suspended')audioCtx.resume();\ngenerateMap();\nspawnPlayers();\nprojectiles=[];particles=[];killFeed=[];time=0;gameTime=0;currentPhase=0;safeRadius=1800/2;supplyDrops=[];\nplayer.shieldRegen=5;\ngameState='playing';\ndocument.getElementById('menu').style.display='none';\ndocument.getElementById('deathScreen').style.display='none';\ndocument.getElementById('victoryScreen').style.display='none';\n}\n\nfunction showCredits(){\nalert('VOID CLOSURE\\nA Last-Stand Survival Arena\\n\\nBuilt with pure HTML5 Canvas\\nWeb Audio API for sound effects');\n}\n\nfunction update(dt){\nif(gameState!=='playing')return;\ngameTime+=dt;time++;\nupdatePhase();\nupdatePlayer(dt);\nplayers.filter(p=>p.isBot&&p.alive).forEach(b=>updateBot(b,dt));\nupdateProjectiles(dt);\nupdateParticles(dt);\ncheckCollisions();\nupdateUI();\nspawnSupplyDrop();\n}\n\nfunction updatePhase(){\nconst phases=[{t:0,r:900},{t:30,r:630},{t:180,r:360},{t:360,r:135},{t:480,r:0}];\nfor(let i=phases.length-1;i>=0;i--){\nif(gameTime>=phases[i].t){currentPhase=i;safeRadius=phases[i].r;break}\n}\n}\n\nfunction updatePlayer(dt){\nif(!player.alive)return;\nlet ax=0,ay=0;\nif(keys['w']||keys['arrowup'])ay=-1;\nif(keys['s']||keys['arrowdown'])ay=1;\nif(keys['a']||keys['arrowleft'])ax=-1;\nif(keys['d']||keys['arrowright'])ax=1;\nif(ax||ay){const l=Math.sqrt(ax*ax+ay*ay);ax/=l;ay/=l}\nplayer.vx=ax*player.speed;player.vy=ay*player.speed;\nplayer.x+=player.vx*dt;player.y+=player.vy*dt;\nplayer.angle=Math.atan2(mouse.y-player.y,mouse.x-player.x);\nconst dist=Math.hypot(player.x-shrinkCenter.x,player.y-shrinkCenter.y);\nif(dist>safeRadius){\nconst pull=1500*(1-dist/(900));\nconst angle=Math.atan2(shrinkCenter.y-player.y,shrinkCenter.x-player.x);\nplayer.x+=Math.cos(angle)*pull*dt;\nplayer.y+=Math.sin(angle)*pull*dt;\nplayer.hp-=5*dt;\n}\nplayer.x=Math.max(20,Math.min(1780,player.x));player.y=Math.max(20,Math.min(1380,player.y));\nif(player.hp<=0)killPlayer(player,null);\nif(player.shieldRegen>0&&player.shield<50){player.shieldRegen-=dt;if(player.shieldRegen<=0)player.shield=Math.min(50,player.shield+5*dt)}\nif(player.reloading){player.reloadTime-=dt;if(player.reloadTime<=0){player.reloading=false;player.ammo=WEAPONS[player.weapon].mag}}\nif(player.shield<50&&time%60===0&&player.shieldRegen<=0)player.shieldRegen=5;\n}\n\nfunction updateBot(bot,dt){\nif(!bot.alive)return;\nconst nearestEnemy=players.filter(p=>p.alive&&p!==bot).sort((a,b)=>Math.hypot(a.x-bot.x,a.y-bot.y)-Math.hypot(b.x-bot.x,b.y-bot.y))[0];\nif(nearestEnemy&&Math.hypot(nearestEnemy.x-bot.x,nearestEnemy.y-bot.y)<400){bot.botTarget=nearestEnemy;bot.angle=Math.atan2(nearestEnemy.y-bot.y,nearestEnemy.x-bot.x);if(Date.now()-bot.lastShot>1000/WEAPONS[bot.weapon].rate)shootBot(bot)}\nelse{bot.botWander.time-=dt;if(bot.botWander.time<=0){bot.botWander={x:200+Math.random()*1400,y:200+Math.random()*1000,time:2+Math.random()*3}}\nconst dx=bot.botWander.x-bot.x,dy=bot.botWander.y-bot.y;\nconst dist=Math.hypot(dx,dy);\nif(dist>20){bot.vx=dx/dist*bot.speed;bot.vy=dy/dist*bot.speed;bot.angle=Math.atan2(dy,dx)}\n}\nbot.x+=bot.vx*dt;bot.y+=bot.vy*dt;\nbot.vx*=0.9;bot.vy*=0.9;\nconst dist=Math.hypot(bot.x-shrinkCenter.x,bot.y-shrinkCenter.y);\nif(dist>safeRadius){const pull=1500*(1-dist/900);const angle=Math.atan2(shrinkCenter.y-bot.y,shrinkCenter.x-bot.x);bot.x+=Math.cos(angle)*pull*dt;bot.y+=Math.sin(angle)*pull*dt;bot.hp-=5*dt}\nbot.x=Math.max(20,Math.min(1780,bot.x));bot.y=Math.max(20,Math.min(1380,bot.y));\nif(bot.hp<=0)killPlayer(bot,null);\nconst loot=nearestLoot(bot);\nif(loot&&Math.hypot(loot.x-bot.x,loot.y-bot.y)<30)pickupLoot(bot,loot);\n}\n\nfunction shootBot(bot){const w=WEAPONS[bot.weapon];bot.lastShot=Date.now();shoot(bot.weapon);if(w.pellets){for(let i=0;i<w.pellets;i++){const a=bot.angle+(Math.random()-.5)*w.spread;projectiles.push(new Projectile(bot.x,bot.y,Math.cos(a)*w.speed,Math.sin(a)*w.speed,w.dmg,bot,bot.color,bot.weapon))}}\nelse{projectiles.push(new Projectile(bot.x,bot.y,Math.cos(bot.angle)*w.speed,Math.sin(bot.angle)*w.speed,w.dmg,bot,bot.color,bot.weapon))}}\n\nfunction shoot(e){\nif(!player.alive||player.reloading||player.ammo<=0)return;\nconst w=WEAPONS[player.weapon];\nif(Date.now()-player.lastShot<1000/w.rate)return;\nplayer.lastShot=Date.now();player.ammo--;\nshoot(player.weapon);\nif(w.pellets){for(let i=0;i<w.pellets;i++){const a=player.angle+(Math.random()-.5)*w.spread;projectiles.push(new Projectile(player.x,player.y,Math.cos(a)*w.speed,Math.sin(a)*w.speed,w.dmg,player,player.color,player.weapon))}}\nelse projectiles.push(new Projectile(player.x,player.y,Math.cos(player.angle)*w.speed,Math.sin(player.angle)*w.speed,w.dmg,player,player.color,player.weapon));\n}\n\nfunction updateProjectiles(dt){\nprojectiles.forEach(p=>{\np.trail.push({x:p.x,y:p.y});if(p.trail.length>5)p.trail.shift();\np.x+=p.vx*dt;p.y+=p.vy*dt;p.life-=dt;\nconst w=WEAPONS[p.weapon];\nif(w.type==='rocket'){\nconst dist=Math.hypot(p.x-shrinkCenter.x,p.y-shrinkCenter.y);\nif(dist<safeRadius){const pull=200*(1-dist/safeRadius);\nconst a=Math.atan2(shrinkCenter.y-p.y,shrinkCenter.x-p.x);\np.vx+=Math.cos(a)*pull*dt;p.vy+=Math.sin(a)*pull*dt;\nconst l=Math.hypot(p.vx,p.vy);\np.vx=p.vx/l*w.speed;p.vy=p.vy/l*w.speed\n}}\n});\nprojectiles=projectiles.filter(p=>p.life>0);\n}\n\nfunction updateParticles(dt){particles.forEach(p=>{p.x+=p.vx*dt;p.y+=p.vy*dt;p.life-=dt});particles=particles.filter(p=>p.life>0)}\n\nfunction checkCollisions(){\nprojectiles.forEach(p=>{\nif(p.hit)return;\nplayers.forEach(t=>{\nif(t===p.owner||!t.alive)return;\nif(Math.hypot(p.x-t.x,p.y-t.y)<t.r+5){\nconst w=WEAPONS[p.weapon];\nlet dmg=p.dmg;\nif(t.shield>0){const s=Math.min(t.shield,dmg*.5);t.shield-=s;dmg-=s}\nt.hp-=dmg;p.owner.dmgDealt+=dmg;t.shieldRegen=5;\nhit();\nfor(let i=0;i<5;i++)particles.push(new Particle(t.x,t.y,(Math.random()-.5)*200,(Math.random()-.5)*200,t.color,.5));\nif(t.hp<=0)killPlayer(t,p.owner);\np.hit=true;\n}\n});\nif(p.hit)return;\nloots.forEach((l,i)=>{if(Math.hypot(p.x-l.x,p.y-l.y)<l.r+5&&!player.isBot){pickupLoot(player,l);loots.splice(i,1)}});\n});\n\n// Loot pickup\nplayers.forEach(p=>{\nif(!p.alive)return;\nloots.forEach((l,i)=>{if(Math.hypot(p.x-l.x,p.y-l.y)<l.r+20){pickupLoot(p,l);loots.splice(i,1)}});\n});\n}\n\nfunction pickupLoot(p,l){\nif(l.type==='shield'){p.shield=Math.min(50,p.shield+25);pickUp()}\nelse{const w=WEAPONS[l.type];p.weapon=l.type;p.ammo=w.mag;p.reserve=w.mag*3;pickUp()}\n}\n\nfunction nearestLoot(p){let nearest=null,dist=Infinity;loots.forEach(l=>{const d=Math.hypot(l.x-p.x,l.y-p.y);if(d<dist){dist=d;nearest=l}});return nearest}\n\nfunction killPlayer(victim,killer){\nvictim.alive=false;\ndeath();\nfor(let i=0;i<20;i++)particles.push(new Particle(victim.x,victim.y,(Math.random()-.5)*300,(Math.random()-.5)*300,victim.color,1,4));\nif(killer){\nkiller.kills++;\naddKillFeed(killer.isBot?'BOT_'+killer.kills:'YOU',victim.isBot?'BOT_'+victim.kills:'YOU',WEAPONS[killer.weapon]?.name||'PISTON');\n}\nif(victim===player){\nif(gameTime>highScore){highScore=Math.floor(gameTime);localStorage.setItem('voidClosureHighScore',highScore)}\ngameState='dead';\ndocument.getElementById('deathStats').innerHTML=`Time: ${formatTime(Math.floor(gameTime))}<br>Kills: ${player.kills}<br>Damage: ${Math.floor(player.dmgDealt)}`;\ndocument.getElementById('deathScreen').style.display='flex';\n}\nconst alive=players.filter(p=>p.alive);\nif(alive.length===1&&alive[0]===player){victory();gameState='won';document.getElementById('victoryStats').innerHTML=`Time: ${formatTime(Math.floor(gameTime))}<br>Kills: ${player.kills}<br>Damage: ${Math.floor(player.dmgDealt)}`;document.getElementById('victoryScreen').style.display='flex'}\n}\n\nfunction addKillFeed(killer,victim,weapon){\nkillFeed.push({killer,victim,weapon,time:4});\nif(killFeed.length>5)killFeed.shift();\n}\n\nfunction spawnSupplyDrop(){\nif(time%3600===0&&time>0){\nconst x=200+Math.random()*1400,y=200+Math.random()*1000;\nsupplyDrops.push({x,y,time:30});\nloots.push(new Loot(x,y,'railgun','epic'));\nloots.push(new Loot(x+20,y,'shield','epic'));\n}}\n\nfunction updateUI(){\nconst alive=players.filter(p=>p.alive).length;\ndocument.getElementById('alive').textContent=alive+' ALIVE';\ndocument.getElementById('timer').textContent=formatTime(Math.floor(gameTime));\ndocument.getElementById('healthFill').style.width=Math.max(0,player.hp)+'%';\ndocument.getElementById('shieldFill').style.width=(player.shield/50)*100+'%';\nconst w=WEAPONS[player.weapon];\ndocument.getElementById('weaponInfo').innerHTML=(w.name||player.weapon).toUpperCase()+'<br>'+player.ammo+' / '+(player.reserve||w.mag*3);\nconst feed=document.getElementById('killfeed');\nfeed.innerHTML=killFeed.filter(k=>{k.time-=1/60;return k.time>0}).map(k=>`<div class=\"kill\">${k.killer} eliminated ${k.victim} with ${k.weapon}</div>`).join('');\n}\n\nfunction render(){\nctx.fillStyle='#0a0a1a';\nctx.fillRect(0,0,W,H);\nctx.save();\nctx.translate(-player.x+W/2,-player.y+H/2);\ndrawWorld();\ndrawSafeZone();\ndrawBuildings();\nloots.forEach(l=>drawLoot(l));\nsupplyDrops.forEach(s=>drawSupplyDrop(s));\nprojectiles.forEach(p=>drawProjectile(p));\nparticles.forEach(p=>drawParticle(p));\nplayers.filter(p=>p.alive).forEach(p=>drawPlayer(p));\ndrawBlackHole();\nctx.restore();\nrenderMinimap();\n}\n\nfunction drawWorld(){\nctx.strokeStyle='#1a1a3a';ctx.lineWidth=2;\nfor(let x=0;x<1800;x+=100){ctx.beginPath();ctx.moveTo(x,0);ctx.lineTo(x,1400);ctx.stroke()}\nfor(let y=0;y<1400;y+=100){ctx.beginPath();ctx.moveTo(0,y);ctx.lineTo(1800,y);ctx.stroke()}\n}\n\nfunction drawSafeZone(){\nconst dist=Math.hypot(player.x-shrinkCenter.x,player.y-shrinkCenter.y);\nctx.beginPath();ctx.arc(shrinkCenter.x,shrinkCenter.y,safeRadius,0,Math.PI*2);\nif(dist>safeRadius){ctx.fillStyle='rgba(100,0,0,.3)'}else{ctx.fillStyle='rgba(0,50,100,.2)'}\nctx.fill();\nctx.strokeStyle='#00f0ff';ctx.lineWidth=3;\nctx.setLineDash([10,5]);ctx.stroke();ctx.setLineDash([]);\n}\n\nfunction drawBuildings(){\nbuildings.forEach(b=>{\nctx.fillStyle='#1a1a2a';ctx.fillRect(b.x,b.y,b.w,b.h);\nctx.strokeStyle='#333';ctx.lineWidth=2;ctx.strokeRect(b.x,b.y,b.w,b.h);\n});\n}\n\nfunction drawBlackHole(){\nconst t=Date.now()/1000;\nconst grd=ctx.createRadialGradient(shrinkCenter.x,shrinkCenter.y,0,shrinkCenter.x,shrinkCenter.y,100);\ngrd.addColorStop(0,'#000');grd.addColorStop(.5,'#1a0a2a');grd.addColorStop(1,'transparent');\nctx.fillStyle=grd;\nctx.beginPath();ctx.arc(shrinkCenter.x,shrinkCenter.y,100,0,Math.PI*2);ctx.fill();\nctx.strokeStyle='#ff00ff';ctx.lineWidth=2;\nfor(let i=0;i<3;i++){\nctx.beginPath();\nctx.arc(shrinkCenter.x,shrinkCenter.y,40+i*20, t+i*.5, t+i*.5+Math.PI*1.5);\nctx.stroke();\n}\nctx.strokeStyle='#00f0ff';ctx.lineWidth=1;\nfor(let i=0;i<6;i++){\nconst a=t+i*Math.PI/3;\nctx.beginPath();\nctx.arc(shrinkCenter.x,shrinkCenter.y,40+i*20, t+i*.5, t+i*.5+Math.PI*1.5);
ctx.stroke();
}
}

function drawLoot(l){
const p=Math.sin(Date.now()/200+l.pulse)*0.3+1;
ctx.fillStyle=l.color;
ctx.beginPath();
ctx.arc(l.x,l.y,l.r*p,0,Math.PI*2);
ctx.fill();
ctx.strokeStyle='#fff';
ctx.lineWidth=1;
ctx.stroke();
}

function drawSupplyDrop(s){
ctx.fillStyle='rgba(0,0,0,0.5)';
ctx.fillRect(s.x-20,s.y-20,40,40);
ctx.strokeStyle='#ffd700';
ctx.lineWidth=2;
ctx.strokeRect(s.x-20,s.y-20,40,40);
ctx.fillStyle='#ffd700';
ctx.font='12px Arial';
ctx.textAlign='center';
ctx.fillText('SUPPLY',s.x,s.y+4);
}

function drawProjectile(p){
if(p.trail.length>1){
ctx.strokeStyle=p.color;
ctx.lineWidth=2;
ctx.beginPath();
ctx.moveTo(p.trail[0].x,p.trail[0].y);
for(let i=1;i<p.trail.length;i++)ctx.lineTo(p.trail[i].x,p.trail[i].y);
ctx.lineTo(p.x,p.y);
ctx.stroke();
}
ctx.fillStyle=p.color;
ctx.beginPath();
ctx.arc(p.x,p.y,3,0,Math.PI*2);
ctx.fill();
}

function drawParticle(p){
ctx.globalAlpha=p.life/p.maxLife;
ctx.fillStyle=p.color;
ctx.beginPath();
ctx.arc(p.x,p.y,p.size,0,Math.PI*2);
ctx.fill();
ctx.globalAlpha=1;
}

function drawPlayer(p){
ctx.fillStyle=p.color;
ctx.beginPath();
ctx.arc(p.x,p.y,p.r,0,Math.PI*2);
ctx.fill();
if(p===player){
ctx.strokeStyle='#fff';
ctx.lineWidth=2;
ctx.beginPath();
ctx.arc(p.x,p.y,p.r+4,0,Math.PI*2);
ctx.stroke();
}
ctx.fillStyle='#fff';
ctx.beginPath();
ctx.arc(p.x+Math.cos(p.angle)*p.r*.7,p.y+Math.sin(p.angle)*p.r*.7,3,0,Math.PI*2);
ctx.fill();
if(p.hp<100){
ctx.fillStyle='rgba(255,0,0,0.5)';
ctx.fillRect(p.x-p.r,p.y-p.r-8,p.r*2*(p.hp/100),3);
}
}

function renderMinimap(){
minimapCtx.fillStyle='#0a0a1a';
minimapCtx.fillRect(0,0,150,150);
const scaleX=150/1800,scaleY=150/1400;
minimapCtx.fillStyle='rgba(0,50,100,0.3)';
minimapCtx.beginPath();
minimapCtx.arc(shrinkCenter.x*scaleX,shrinkCenter.y*scaleY,safeRadius*scaleX,0,Math.PI*2);
minimapCtx.fill();
players.filter(p=>p.alive).forEach(p=>{
minimapCtx.fillStyle=p===player?'#fff':p.color;
minimapCtx.beginPath();
minimapCtx.arc(p.x*scaleX,p.y*scaleY,3,0,Math.PI*2);
minimapCtx.fill();
});
}

let lastTime=0;
function gameLoop(ts){
const dt=Math.min((ts-lastTime)/1000,0.1);
lastTime=ts;
update(dt);
render();
requestAnimationFrame(gameLoop);
}
requestAnimationFrame(gameLoop);

document.addEventListener('keydown',e=>keys[e.key.toLowerCase()]=true);
document.addEventListener('keyup',e=>keys[e.key.toLowerCase()]=false);
document.addEventListener('mousemove',e=>{mouse.x=e.clientX;mouse.y=e.clientY});
document.addEventListener('mousedown',e=>{if(e.button===0)shoot()});
document.addEventListener('contextmenu',e=>e.preventDefault());
document.addEventListener('keydown',e=>{if(e.key==='r'&&!player.reloading&&player.ammo<WEAPONS[player.weapon].mag&&player.reserve>0){player.reloading=true;player.reloadTime=WEAPONS[player.weapon].reload}});

window.startGame=startGame;
window.showCredits=showCredits;
</script>
</body>
</html>"}