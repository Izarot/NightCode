sqrt(this.x * this.x + this.y * this.y); }\n    normalize() { const len = this.length(); return len > 0 ? new Vector2(this.x / len, this.y / len) : new Vector2(0, 0); }\n    angle() { return Math.atan2(this.y, this.x); }\n    static fromAngle(angle) { return new Vector2(Math.cos(angle), Math.sin(angle)); }\n}\n\nclass AudioManager {\n    constructor() {\n        try {\n            this.audioCtx = new (window.AudioContext || window.webkitAudioContext)();\n            this.enabled = true;\n        } catch (e) { this.enabled = false; }\n    }\n    playEnginePitch(frequency, gain = 0.3) {\n        if (!this.enabled || !this.audioCtx) return;\n        const osc = this.audioCtx.createOscillator();\n        const amp = this.audioCtx.createGain();\n        osc.connect(amp);\n        amp.connect(this.audioCtx.destination);\n        osc.type = 'sine';\n        osc.frequency.setValueAtTime(frequency, this.audioCtx.currentTime);\n        amp.gain.setValueAtTime(gain, this.audioCtx.currentTime);\n        amp.gain.exponentialRampToValueAtTime(0.001, this.audioCtx.currentTime + 0.1);\n        osc.start();\n        osc.stop(this.audioCtx.currentTime + 0.1);\n    }\n    playBoostSound() {\n        if (!this.enabled || !this.audioCtx) return;\n        const osc = this.audioCtx.createOscillator();\n        const amp = this.audioCtx.createGain();\n        osc.connect(amp);\n        amp.connect(this.audioCtx.destination);\n        osc.type = 'square';\n        osc.frequency.setValueAtTime(80, this.audioCtx.currentTime);\n        amp.gain.setValueAtTime(0.4, this.audioCtx.currentTime);\n        amp.gain.exponentialRampToValueAtTime(0.001, this.audioCtx.currentTime + 0.5);\n        osc.start();\n        osc.stop(this.audioCtx.currentTime + 0.5);\n    }\n    playGateSound() {\n        if (!this.enabled || !this.audioCtx) return;\n        const osc = this.audioCtx.createOscillator();\n        const amp = this.audioCtx.createGain();\n        osc.connect(amp);\n        amp.connect(this.audioCtx.destination);\n        osc.type = 'triangle';\n        osc.frequency.setValueAtTime(440, this.audioCtx.currentTime);\n        amp.gain.setValueAtTime(0.3, this.audioCtx.currentTime);\n        amp.gain.exponentialRampToValueAtTime(0.001, this.audioCtx.currentTime + 0.3);\n        osc.start();\n        osc.stop(this.audioCtx.currentTime + 0.3);\n    }\n}\n\nclass Particle {\n    constructor() {\n        this.reset();\n    }\n    reset() {\n        this.x = 0; this.y = 0;\n        this.vx = 0; this.vy = 0;\n        this.life = 0; this.maxLife = 0;\n        this.size = 0; this.color = '';\n        this.alpha = 1;\n        this.blend = 'normal';\n    }\n    init(x, y, vx, vy, life, size, color, blend = 'normal') {\n        this.x = x; this.y = y;\n        this.vx = vx; this.vy = vy;\n        this.life = life; this.maxLife = life;\n        this.size = size; this.color = color;\n        this.alpha = 1; this.blend = blend;\n    }\n    update(dt) {\n        this.x += this.vx * dt;\n        this.y += this.vy * dt;\n        this.life -= dt;\n        this.alpha = Math.max(0, this.life / this.maxLife);\n    }\n}\n\nclass ParticlePool {\n    constructor(maxParticles = 500) {\n        this.particles = [];\n        this.active = [];\n        for (let i = 0; i < maxParticles; i++) {\n            this.particles.push(new Particle());\n        }\n    }\n    create(x, y, vx, vy, life, size, color, blend = 'normal') {\n        const p = this.particles.find(p => p.life <= 0);\n        if (p) {\n            p.init(x, y, vx, vy, life, size, color, blend);\n            this.active.push(p);\n        }\n    }\n    update(dt) {\n        for (let i = this.active.length - 1; i >= 0; i--) {\n            const p = this.active[i];\n            p.update(dt);\n            if (p.life <= 0) {\n                this.active.splice(i, 1);\n            }\n        }\n    }\n    render(ctx) {\n        ctx.save();\n        for (const p of this.active) {\n            ctx.globalAlpha = p.alpha;\n            if (p.blend === 'lighter') ctx.globalCompositeOperation = 'lighter';\n            else ctx.globalCompositeOperation = 'normal';\n            ctx.fillStyle = p.color;\n            ctx.fillRect(p.x, p.y, p.size, p.size);\n        }\n        ctx.restore();\n    }\n}\n\nclass Vehicle {\n    constructor() {\n        this.pos = new Vector2(400, 300);\n        this.vel = new Vector2(0, 0);\n        this.angle = 0;\n        this.steering = 0;\n        this.throttle = 0;\n        this.isDrifting = false;\n        this.driftMeter = 0;\n        this.boostActive = false;\n        this.boostTime = 0;\n        this.boostDuration = 2.5;\n        this.boostMultiplier = 1.4;\n        this.maxSpeed = 450;\n        this.accelerationForce = 1200;\n        this.cDrag = 0.02;\n        this.cRoll = 0.1;\n        this.muLateral = 0.85;\n        this.muDrift = 0.08;\n        this.steeringRate = 4.5;\n        this.turnScale = 100;\n        this.kDriftSlide = 0.15;\n        this.radius = 15;\n        this.lap = 0;\n        this.totalLaps = 3;\n        this.gateIndex = 0;\n    }\n    getForward() { return new Vector2(Math.sin(this.angle), -Math.cos(this.angle)); }\n    getRight() { return new Vector2(Math.cos(this.angle), Math.sin(this.angle)); }\n    getLocalVelocity() {\n        const forward = this.getForward();\n        const right = this.getRight();\n        return {\n            longitudinal: this.vel.dot(forward),\n            lateral: this.vel.dot(right)\n        };\n    }\n    update(dt, input) {\n        this.steering = input.left ? -1 : input.right ? 1 : 0;\n        this.throttle = input.accelerate ? 1 : 0;\n        this.isDrifting = input.drift;\n        \n        const localVel = this.getLocalVelocity();\n        const speed = this.vel.length();\n        const forward = this.getForward();\n        const right = this.getRight();\n        \n        let mu = this.isDrifting ? this.muDrift : this.muLateral;\n        \n        let force = new Vector2(0, 0);\n        \n        if (this.throttle) {\n            force = force.add(forward.mul(this.accelerationForce * this.throttle));\n        }\n        \n        const dragForce = this.vel.mul(-this.cDrag * speed * speed);\n        const rollForce = forward.mul(-this.cRoll * localVel.longitudinal);\n        const lateralForce = right.mul(-mu * localVel.lateral);\n        \n        force = force.add(dragForce).add(rollForce).add(lateralForce);\n        \n        if (this.boostActive) {\n            this.boostTime -= dt;\n            if (this.boostTime <= 0) this.boostActive = false;\n        }\n        \n        if (this.boostActive) {\n            force = force.mul(this.boostMultiplier);\n        }\n        \n        this.vel = this.vel.add(force.mul(dt));\n        \n        const speedMag = this.vel.length();\n        if (speedMag > this.maxSpeed) {\n            this.vel = this.vel.normalize().mul(this.maxSpeed);\n        }\n        \n        const turnFactor = speed / (speed + this.turnScale);\n        this.angle += this.steering * this.steeringRate * turnFactor * dt;\n        \n        if (this.isDrifting) {\n            const angleDiff = Math.abs(this.getAngleDiff());\n            this.driftMeter = Math.min(100, this.driftMeter + angleDiff * 50 * dt);\n            const driftTorque = this.steering * this.kDriftSlide * localVel.longitudinal * dt;\n            this.angle += driftTorque;\n        } else {\n            this.driftMeter = Math.max(0, this.driftMeter - 30 * dt);\n        }\n        \n        this.pos = this.pos.add(this.vel.mul(dt));\n    }\n    getAngleDiff() {\n        const velAngle = this.vel.angle();\n        let diff = this.angle - velAngle;\n        while (diff > Math.PI) diff -= 2 * Math.PI;\n        while (diff < -Math.PI) diff += 2 * Math.PI;\n        return diff;\n    }\n    getSpeed() { return this.vel.length(); }\n}\n\nclass Gate {\n    constructor(x1, y1, x2, y2, type = 'checkpoint') {\n        this.start = new Vector2(x1, y1);\n        this.end = new Vector2(x2, y2);\n        this.type = type;\n        this.triggered = false;\n    }\n    checkCollision(vehicle) {\n        if (this.triggered) return false;\n        \n        const closest = this.getClosestPoint(vehicle.pos);\n        const dist = vehicle.pos.sub(closest).length();\n        \n        if (dist < vehicle.radius) {\n            this.triggered = true;\n            return true;\n        }\n        return false;\n    }\n    getClosestPoint(point) {\n        const line = this.end.sub(this.start);\n        const lineLen = line.length();\n        if (lineLen === 0) return this.start;\n        \n        const lineNorm = line.normalize();\n        const toPoint = point.sub(this.start);\n        const proj = toPoint.dot(lineNorm);\n        \n        if (proj < 0) return this.start;\n        if (proj > lineLen) return this.end;\n        \n        return this.start.add(lineNorm.mul(proj));\n    }\n}\n\nclass Track {\n    constructor() {\n        this.gates = [];\n        this.walls = [];\n        this.createTrack();\n    }\n    createTrack() {\n        this.gates.push(new Gate(400, 100, 400, 150, 'checkpoint'));\n        this.gates.push(new Gate(400, 150, 400, 200, 'checkpoint'));\n        this.gates.push(new Gate(400, 200, 400, 250, 'checkpoint'));\n        this.gates.push(new Gate(400, 250, 400, 300, 'checkpoint'));\n        this.gates.push(new Gate(400, 300, 400, 350, 'checkpoint'));\n        this.gates.push(new Gate(400, 350, 400, 400, 'checkpoint'));\n        this.gates.push(new Gate(400, 400, 400, 450, 'checkpoint'));\n        this.gates.push(new Gate(400, 450, 400, 500, 'checkpoint'));\n        this.gates.push(new Gate(400, 500, 400, 550, 'checkpoint'));\n        this.gates.push(new Gate(400, 550, 400, 600, 'checkpoint'));\n        this.gates.push(new Gate(400, 600, 400, 650, 'checkpoint'));\n        this.gates.push(new Gate(400, 650, 400, 700, 'checkpoint'));\n        this.gates.push(new Gate(400, 700, 400, 750, 'checkpoint'));\n        this.gates.push(new Gate(400, 750, 400,