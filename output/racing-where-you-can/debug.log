        this.ctx.fillText('BOOST', this.canvas.width - 210, 40);
        this.ctx.fillText('DRIFT', this.canvas.width - 210, 60);
        this.ctx.fillText('SPEED', this.canvas.width - 210, 80);
        
        const boostFill = this.vehicle.boostActive ? '#FFD700' : '#333333';
        this.ctx.fillStyle = boostFill;
        this.ctx.fillRect(this.canvas.width - 200, 35, 60, 10);
        
        const driftFill = this.vehicle.driftMeter > 0 ? '#FF4500' : '#333333';
        this.ctx.fillStyle = driftFill;
        this.ctx.fillRect(this.canvas.width - 200, 55, this.vehicle.driftMeter / 100 * 60, 10);
        
        const speedFill = this.vehicle.getSpeed() / this.vehicle.maxSpeed;
        const speedFillColor = this.vehicle.getSpeed() < 100 ? '#00FF00' : this.vehicle.getSpeed() < 200 ? '#FFFF00' : '#FF4500';
        this.ctx.fillStyle = speedFillColor;
        this.ctx.fillRect(this.canvas.width - 200, 75, speedFill * 60, 10);
        
        this.ctx.restore();
        
        this.ctx.fillStyle = 'rgba(0, 0, 0, 0.7)';
        this.ctx.fillRect(20, this.canvas.height - 100, 300, 80);
        this.ctx.strokeStyle = '#00F0FF';
        this.ctx.lineWidth = 2;
        this.ctx.strokeRect(20, this.canvas.height - 100, 300, 80);
        
        this.ctx.fillStyle = '#FFFFFF';
        this.ctx.font = '18px monospace';
        this.ctx.textAlign = 'left';
        this.ctx.fillText('SPEEDRUN', 30, this.canvas.height - 75);
        
        const minutes = Math.floor(this.elapsedTime / 60);
        const seconds = Math.floor(this.elapsedTime % 60);
        const ms = Math.floor((this.elapsedTime % 1) * 100);
        this.ctx.font = '24px monospace';
        this.ctx.fillStyle = '#00F0FF';
        this.ctx.fillText(`${minutes.toString().padStart(2, '0')}:${seconds.toString().padStart(2, '0')}.${ms.toString().padStart(2, '0')}`, 30, this.canvas.height - 45);
        
        this.ctx.fillStyle = '#FF4500';
        this.ctx.font = '14px monospace';
        this.ctx.fillText(`HS: ${this.highScore.toFixed(2)}`, this.canvas.width - 150, this.canvas.height - 50);
        
        this.ctx.restore();
    }
    loop(timestamp) {
        if (!this.lastTime) this.lastTime = timestamp;
        const delta = (timestamp - this.lastTime) / 1000;
        this.lastTime = timestamp;
        
        this.accumulator += delta;
        while (this.accumulator >= this.physicsStep) {
            this.update(this.physicsStep);
            this.accumulator -= this.physicsStep;
        }
        
        this.render();
        this.renderHUD();
        
        if (!this.running) {
            this.running = true;
            this.startTime = performance.now();
        }
        
        requestAnimationFrame((t) => this.loop(t));
    }
    start() {
        this.resizeCanvas();
        this.loop(0);
    }
}

window.addEventListener('load', () => {
    const game = new Game();
    game.start();
});"
