ush({ start: new Vector2(800, 0), end: new Vector2(800, 800) });\n        this.walls.push({ start: new Vector2(800, 800), end: new Vector2(0, 800) });\n        this.walls.push({ start: new Vector2(0, 800), end: new Vector2(0, 0) });\n    }\n}\n\nclass Game {\n    constructor() {\n        this.canvas = document.getElementById('gameCanvas');\n        this.ctx = this.canvas.getContext('2d');\n        this.audio = new AudioManager();\n        this.vehicle = new Vehicle();\n        this.track = new Track();\n        this.particles = new ParticlePool();\n        this.input = { left: false, right: false, accelerate: false, drift: false };\n        this.lastTime = 0;\n        this.accumulator = 0;\n        this.physicsStep = 1 / 120;\n        this.running = false;\n        this.startTime = 0;\n        this.elapsedTime = 0;\n        this.highScore = this.loadHighScore();\n        this.camera = { x: 400, y: 300, scale: 1 };\n        this.setupEventListeners();\n        this.resizeCanvas();\n    }\n    loadHighScore() {\n        const saved = localStorage.getItem('driftgate_highscore');\n        return saved ? parseFloat(saved) : 0;\n    }\n    saveHighScore(score) {\n        localStorage.setItem('driftgate_highscore', score.toString());\n        this.highScore = score;\n    }\n    resizeCanvas() {\n        this.canvas.width = window.innerWidth;\n        this.canvas.height = window.innerHeight;\n    }\n    setupEventListeners() {\n        window.addEventListener('resize', () => this.resizeCanvas());\n        window.addEventListener('keydown', (e) => {\n            if (e.code === 'ArrowLeft' || e.key === 'a') this.input.left = true;\n            if (e.code === 'ArrowRight' || e.key === 'd') this.input.right = true;\n            if (e.code === 'ArrowUp' || e.key === 'w' || e.code === 'Space') this.input.accelerate = true;\n            if (e.code === 'ShiftLeft' || e.code === 'ShiftRight') this.input.drift = true;\n        });\n        window.addEventListener('keyup', (e) => {\n            if (e.code === 'ArrowLeft' || e.key === 'a') this.input.left = false;\n            if (e.code === 'ArrowRight' || e.key === 'd') this.input.right = false;\n            if (e.code === 'ArrowUp' || e.key === 'w' || e.code === 'Space') this.input.accelerate = false;\n            if (e.code === 'ShiftLeft' || e.code === 'ShiftRight') this.input.drift = false;\n        });\n        this.canvas.addEventListener('touchstart', (e) => { e.preventDefault(); this.handleTouch(e, true); });\n        this.canvas.addEventListener('touchend', (e) => { e.preventDefault(); this.handleTouch(e, false); });\n    }\n    handleTouch(e, pressed) {\n        const rect = this.canvas.getBoundingClientRect();\n        const x = e.touches[0].clientX - rect.left;\n        const y = e.touches[0].clientY - rect.top;\n        if (x < rect.width / 2) this.input.left = pressed;\n        else this.input.right = pressed;\n        if (y < rect.height / 2) this.input.accelerate = pressed;\n        if (e.touches[0].clientY > rect.height * 0.7) this.input.drift = pressed;\n    }\n    update(dt) {\n        this.vehicle.update(dt, this.input);\n        this.particles.update(dt);\n        \n        for (const gate of this.track.gates) {\n            if (gate.checkCollision(this.vehicle)) {\n                if (gate.type === 'boost') {\n                    const angleDiff = Math.abs(this.vehicle.getAngleDiff());\n                    if (angleDiff > 0.4) {\n                        this.vehicle.boostActive = true;\n                        this.vehicle.boostTime = this.vehicle.boostDuration;\n                        this.audio.playBoostSound();\n                        this.spawnBoostParticles();\n                    }\n                    this.audio.playGateSound();\n                } else {\n                    this.audio.playGateSound();\n                }\n                gate.triggered = false;\n            }\n        }\n        \n        for (const wall of this.track.walls) {\n            const closest = this.getClosestPointOnLine(this.vehicle.pos, wall.start, wall.end);\n            const dist = this.vehicle.pos.sub(closest).length();\n            if (dist < this.vehicle.radius) {\n                const normal = this.getWallNormal(wall.start, wall.end);\n                const velAlongNormal = this.vehicle.vel.dot(normal);\n                if (velAlongNormal < 0) {\n                    this.vehicle.vel = this.vehicle.vel.sub(normal.mul(velAlongNormal * 0.6));\n                    this.spawnSmokeParticles();\n                }\n            }\n        }\n        \n        this.updateCamera();\n        this.elapsedTime = (performance.now() - this.startTime) / 1000;\n    }\n    getClosestPointOnLine(point, lineStart, lineEnd) {\n        const line = lineEnd.sub(lineStart);\n        const lineLen = line.length();\n        if (lineLen === 0) return lineStart;\n        const lineNorm = line.normalize();\n        const toPoint = point.sub(lineStart);\n        const proj = toPoint.dot(lineNorm);\n        if (proj < 0) return lineStart;\n        if (proj > lineLen) return lineEnd;\n        return lineStart.add(lineNorm.mul(proj));\n    }\n    getWallNormal(start, end) {\n        const line = end.sub(start);\n        return new Vector2(-line.y, line.x).normalize();\n    }\n    spawnSmokeParticles() {\n        for (let i = 0; i < 10; i++) {\n            const angle = Math.random() * Math.PI * 2;\n            const speed = Math.random() * 50 + 20;\n            this.particles.create(\n                this.vehicle.pos.x, this.vehicle.pos.y,\n                Math.cos(angle) * speed, Math.sin(angle) * speed,\n                0.5, 3, '#333333'\n            );\n        }\n    }\n    spawnBoostParticles() {\n        for (let i = 0; i < 20; i++) {\n            const angle = Math.random() * Math.PI * 2;\n            const speed = Math.random() * 100 + 50;\n            this.particles.create(\n                this.vehicle.pos.x, this.vehicle.pos.y,\n                Math.cos(angle) * speed, Math.sin(angle) * speed,\n                1, 4, '#FFD700', 'lighter'\n            );\n        }\n    }\n    updateCamera() {\n        this.camera.x = this.vehicle.pos.x - this.canvas.width / (this.camera.scale * 2);\n        this.camera.y = this.vehicle.pos.y - this.canvas.height / (this.camera.scale * 2);\n        \n        const lateralSpeed = Math.abs(this.vehicle.getLocalVelocity().lateral);\n        if (lateralSpeed > 30) {\n            this.camera.scale = 0.75;\n        } else {\n            this.camera.scale = 1;\n        }\n    }\n    render() {\n        this.ctx.save();\n        this.ctx.translate(-this.camera.x, -this.camera.y);\n        this.ctx.scale(this.camera.scale, this.camera.scale);\n        \n        this.ctx.fillStyle = '#05060a';\n        this.ctx.fillRect(0, 0, this.canvas.width / this.camera.scale, this.canvas.height / this.camera.scale);\n        \n        this.ctx.strokeStyle = '#1A1D24';\n        this.ctx.lineWidth = 4;\n        this.ctx.strokeRect(0, 0, 800, 2000);\n        \n        this.ctx.strokeStyle = '#00F0FF';\n        this.ctx.lineWidth = 2;\n        this.ctx.setLineDash([10, 5]);\n        this.ctx.strokeRect(20, 20, 760, 1960);\n        this.ctx.setLineDash([]);\n        \n        for (const gate of this.track.gates) {\n            if (gate.type === 'boost') {\n                this.ctx.strokeStyle = '#FFD700';\n                this.ctx.shadowColor = '#FFD700';\n                this.ctx.shadowBlur = 20;\n            } else {\n                this.ctx.strokeStyle = '#00F0FF';\n                this.ctx.shadowColor = '#00F0FF';\n                this.ctx.shadowBlur = 10;\n            }\n            this.ctx.lineWidth = 6;\n            this.ctx.beginPath();\n            this.ctx.moveTo(gate.start.x, gate.start.y);\n            this.ctx.lineTo(gate.end.x, gate.end.y);\n            this.ctx.stroke();\n            \n            const midX = (gate.start.x + gate.end.x) / 2;\n            const midY = (gate.start.y + gate.end.y) / 2