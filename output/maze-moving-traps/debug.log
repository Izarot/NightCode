    }
}
}, "js/main.js": "const Game = {\n    canvas: null,\n    renderer: null,\n    maze: null,\n    player: null,\n    sentinels: [],\n    state: 'menu',\n    level: 1,\n    lives: 3,\n    startTime: 0,\n    elapsedTime: 0,\n    cellSize: 32,\n    mazeWidth: 31,\n    mazeHeight: 21,\n    keys: {},\n    \n    init() {\n        this.canvas = document.getElementById('gameCanvas');\n        this.renderer = new Renderer(this.canvas);\n        this.setupInput();\n        this.updateHighScoreDisplay();\n        this.loop();\n    },\n    \n    setupInput() {\n        window.addEventListener('keydown', (e) => {\n            this.keys[e.code] = true;\n            \n            if (this.state === 'menu') {\n                this.startGame();\n            } else if (this.state === 'dead' && e.code === 'Space') {\n                this.respawn();\n            } else if (e.code === 'KeyR') {\n                this.restartLevel();\n            } else if (e.code === 'KeyN') {\n                this.newMaze();\n            }\n        });\n        \n        window.addEventListener('keyup', (e) => {\n            this.keys[e.code] = false;\n        });\n        \n        this.canvas.addEventListener('click', () => {\n            if (this.state === 'menu') {\n                this.startGame();\n            }\n        });\n        \n        this.canvas.addEventListener('touchstart', (e) => {\n            e.preventDefault();\n            if (this.state === 'menu') {\n                this.startGame();\n                return;\n            }\n            this.handleTouch(e.touches);\n        });\n        \n        this.canvas.addEventListener('touchmove', (e) => {\n            e.preventDefault();\n            if (this.state === 'playing') {\n                this.handleTouch(e.touches);\n            }\n        });\n        \n        this.canvas.addEventListener('touchend', (e) => {\n            e.preventDefault();\n            this.player.inputX = 0;\n            this.player.inputY = 0;\n        });\n    },\n    \n    handleTouch(touches) {\n        if (touches.length === 0 || !this.player) return;\n        \n        const touch = touches[0];\n        const rect = this.canvas.getBoundingClientRect();\n        const x = (touch.clientX - rect.left) / this.renderer.scale;\n        const y = (touch.clientY - rect.top) / this.renderer.scale;\n        \n        const centerX = this.renderer.canvas.width / 2;\n        const centerY = this.renderer.canvas.height / 2;\n        \n        let dx = x - centerX;\n        let dy = y - centerY;\n        \n        const dist = Math.sqrt(dx * dx + dy * dy);\n        if (dist > 20) {\n            this.player.inputX = dx / dist;\n            this.player.inputY = dy / dist;\n        }\n    },\n    \n    startGame() {\n        this.state = 'playing';\n        this.level = 1;\n        this.lives = 3;\n        this.updateLivesDisplay();\n        this.updateLevelDisplay();\n        document.getElementById('overlay').classList.add('hidden');\n        this.initLevel();\n    },\n    \n    initLevel() {\n        const mazeSeed = Date.now() + this.level * 1000;\n        this.maze = new Maze(this.mazeWidth, this.mazeHeight, mazeSeed);\n        \n        const startPos = this.maze.getStartPos();\n        this.player = new Player(\n            (startPos.x + 0.5) * this.cellSize,\n            (startPos.y + 0.5) * this.cellSize,\n            this.cellSize * 0.35\n        );\n        \n        const sentinelCount = 3 + this.level * 2;\n        this.sentinels = TrapFactory.createSentinels(this.maze, this.cellSize, sentinelCount);\n        \n        this.startTime = performance.now();\n        this.elapsedTime = 0;\n    },\n    \n    nextLevel() {\n        this.level++;\n        this.updateLevelDisplay();\n        this.initLevel();\n    },\n    \n    restartLevel() {\n        if (this.state !== 'playing') return;\n        const startPos = this.maze.getStartPos();\n        this.player.reset(\n            (startPos.x + 0.5) * this.cellSize,\n            (startPos.y + 0.5) * this.cellSize\n        );\n        this.sentinels = TrapFactory.createSentinels(this.maze, this.cellSize, 3 + this.level * 2);\n        this.startTime = performance.now();\n    },\n    \n    newMaze() {\n        if (this.state !== 'playing') return;\n        this.maze.regenerate();\n        const startPos = this.maze.getStartPos();\n        this.player.reset(\n            (startPos.x + 0.5) * this.cellSize,\n            (startPos.y + 0.5) * this.cellSize\n        );\n        this.sentinels = TrapFactory.createSentinels(this.maze, this.cellSize, 3 + this.level * 2);\n        this.startTime = performance.now();\n    },\n    \n    playerHit() {\n        this.lives--;\n        this.updateLivesDisplay();\n        \n        this.renderer.flashScreen('rgb(255, 0, 85)', 300);\n        \n        if (this.lives <= 0) {\n            this.state = 'gameover';\n            this.showOverlay('GAME OVER', 'PRESS SPACE TO RESTART');\n        } else {\n            this.state = 'dead';\n            this.showOverlay('OUCH!', 'PRESS SPACE TO CONTINUE');\n        }\n    },\n    \n    respawn() {\n        const startPos = this.maze.getStartPos();\n        this.player.reset(\n            (startPos.x + 0.5) * this.cellSize,\n            (startPos.y + 0.5) * this.cellSize\n        );\n        this.sentinels = TrapFactory.createSentinels(this.maze, this.cellSize, 3 + this.level * 2);\n        this.startTime = performance.now();\n        this.state = 'playing';\n        document.getElementById('overlay').classList.add('hidden');\n    },\n    \n    levelComplete() {\n        const time = this.elapsedTime;\n        const bestTime = Utils.localStorage.get('bestTime_' + this.level, null);\n        \n        if (!bestTime || time < bestTime) {\n            Utils.localStorage.set('bestTime_' + this.level, time);\n            this.updateHighScoreDisplay();\n        }\n        \n        this.renderer.flashScreen('rgb(255, 215, 0)', 500, () => {\n            this.nextLevel();\n        });\n    },\n    \n    showOverlay(title, subtitle) {\n        const overlay = document.getElementById('overlay');\n        overlay.querySelector('h1').textContent = title;\n        overlay.querySelector('p').textContent = subtitle;\n        overlay.classList.remove('hidden');\n    },\n    \n    updateLivesDisplay() {\n        const hearts = '❤️'.repeat(this.lives) + '🖤'.repeat(Math.max(0, 3 - this.lives));\n        document.getElementById('lives').textContent = hearts;\n    },\n    \n    updateLevelDisplay() {\n        document.getElementById('level').textContent = 'LEVEL ' + this.level;\n    },\n    \n    updateHighScoreDisplay() {\n        const bestTime = Utils.localStorage.get('bestTime_' + this.level, null);\n        const display = document.getElementById('highScore');\n        if (bestTime) {\n            display.textContent = 'BEST: ' + Utils.formatTime(bestTime);\n        } else {\n            display.textContent = 'BEST: --:--';\n        }\n    },\n    \n    update(dt) {\n        if (this.state !== 'playing') return;\n        \n        this.elapsedTime = performance.now() - this.startTime;\n        document.getElementById('timer').textContent = Utils.formatTime(this.elapsedTime);\n        \n        this.player.inputX = 0;\n        this.player.inputY = 0;\n        \n        if (this.keys['KeyW'] || this.keys['ArrowUp']) this.player.inputY = -1;\n        if (this.keys['KeyS'] || this.keys['ArrowDown']) this.player.inputY = 1;\n        if (this.keys['KeyA'] || this.keys['ArrowLeft']) this.player.inputX = -1;\n        if (this.keys['KeyD'] || this.keys['ArrowRight']) this.player.inputX = 1;\n        \n        this.player.update(dt);\n        \n        Physics.circleWallCollision(this.player, this.maze, this.cellSize);\n        \n        for (const sentinel of this.sentinels) {\n            sentinel.update(dt);\n        }\n        \n        if (Physics.checkPlayerSentinelCollision(this.player, this.sentinels)) {\n            this.playerHit();\n            return;\n        }\n        \n        const exitPos = this.maze.getExitPos();\n        if (Physics.checkExitCollision(this.player, exitPos.x, exitPos.y, this.cellSize)) {\n            this.levelComplete();\n        }\n        \n        const targetX = this.player.x;\n        const targetY = this.player.y;\n        this.renderer.updateCamera(targetX, targetY, this.maze.width, this.maze.height, this.cellSize);\n    },\n    \n    render(time) {\n        this.renderer.clear();\n        \n        if (this.maze) {\n            this.renderer.drawMaze(this.maze, this.cellSize);\n            \n            const exitPos = this.maze.getExitPos();\n            this.renderer.drawExit(exitPos.x, exitPos.y, this.cellSize, time / 1000);\n            \n            if (this.player) {\n                this.renderer.drawPlayer(this.player);\n            }\n            \n            this.renderer.drawSentinels(this.sentinels, time / 1000);\n        }\n    },\n    \n    loop() {\n        let lastTime = performance.now();\n        \n        const frame = (time) => {\n            const dt = Math.min((time - lastTime) / 1000, 0.1);\n            lastTime = time;\n            \n            this.update(dt);\n            this.render(time);\n            \n            requestAnimationFrame(frame);\n        };\n        \n        requestAnimationFrame(frame);\n    }\n};\n\ndocument.addEventListener('DOMContentLoaded', () => {\n    Game.init();\n});"}