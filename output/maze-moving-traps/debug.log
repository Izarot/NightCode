\nclass Sentinel {\n    constructor(type, x, y, data) {\n        this.type = type;\n        this.x = x;\n        this.y = y;\n        this.size = 12;\n        this.glowPhase = Math.random() * Math.PI * 2;\n        \n        if (type === 'patrol') {\n            this.startX = x;\n            this.startY = y;\n            this.endX = data.endX;\n            this.endY = data.endY;\n            this.speed = 150;\n            this.progress = 0;\n            this.direction = 1;\n        } else if (type === 'orbit') {\n            this.centerX = data.centerX;\n            this.centerY = data.centerY;\n            this.radius = data.radius;\n            this.angle = data.startAngle || 0;\n            this.angularSpeed = 1.5;\n            this.direction = data.direction || 1;\n        }\n    }\n    \n    update(dt) {\n        this.glowPhase += dt * 4;\n        \n        if (this.type === 'patrol') {\n            const dx = this.endX - this.startX;\n            const dy = this.endY - this.startY;\n            const totalDist = Math.sqrt(dx * dx + dy * dy);\n            \n            this.progress += (this.speed * dt * this.direction) / totalDist;\n            \n            if (this.progress >= 1) {\n                this.progress = 1;\n                this.direction = -1;\n            } else if (this.progress <= 0) {\n                this.progress = 0;\n                this.direction = 1;\n            }\n            \n            this.x = this.startX + dx * this.progress;\n            this.y = this.startY + dy * this.progress;\n        } else if (this.type === 'orbit') {\n            this.angle += this.angularSpeed * this.direction * dt;\n            this.x = this.centerX + Math.cos(this.angle) * this.radius;\n            this.y = this.centerY + Math.sin(this.angle) * this.radius;\n        }\n    }\n    \n    getGlowIntensity() {\n        return 10 + Math.sin(this.glowPhase) * 5;\n    }\n}\n\nclass TrapFactory {\n    static createSentinels(maze, cellSize, count) {\n        const sentinels = [];\n        const exitPos = maze.getExitPos();\n        \n        for (let i = 0; i < count; i++) {\n            const corridor = maze.getRandomCorridor();\n            if (!corridor) continue;\n            \n            const wx = (corridor.x + 0.5) * cellSize;\n            const wy = (corridor.y + 0.5) * cellSize;\n            \n            if (Utils.distance(wx, wy, (exitPos.x + 0.5) * cellSize, (exitPos.y + 0.5) * cellSize) < cellSize * 3) {\n                continue;\n            }\n            \n            const type = Math.random() < 0.6 ? 'patrol' : 'orbit';\n            \n            if (type === 'patrol') {\n                const neighbors = this.findPatrolDirections(maze, corridor.x, corridor.y);\n                if (neighbors.length > 0) {\n                    const dir = neighbors[Math.floor(Math.random() * neighbors.length)];\n                    const steps = 3 + Math.floor(Math.random() * 3);\n                    sentinels.push(new Sentinel('patrol', wx, wy, {\n                        endX: (corridor.x + dir.dx * steps + 0.5) * cellSize,\n                        endY: (corridor.y + dir.dy * steps + 0.5) * cellSize\n                    }));\n                }\n            } else {\n                sentinels.push(new Sentinel('orbit', wx, wy, {\n                    centerX: wx,\n                    centerY: wy,\n                    radius: cellSize * 0.5,\n                    startAngle: Math.random() * Math.PI * 2,\n                    direction: Math.random() < 0.5 ? 1 : -1\n                }));\n            }\n        }\n        \n        return sentinels;\n    }\n    \n    static findPatrolDirections(maze, x, y) {\n        const dirs = [];\n        if (y > 1 && maze.grid[y - 1][x] === 0) dirs.push({dx: 0, dy: -1});\n        if (y < maze.height - 2 && maze.grid[y + 1][x] === 0) dirs.push({dx: 0, dy: 1});\n        if (x > 1 && maze.grid[y][x - 1] === 0) dirs.push({dx: -1, dy: 0});\n        if (x < maze.width - 2 && maze.grid[y][x + 1] === 0) dirs.push({dx: 1, dy: 0});\n        return dirs;\n    }\n}", "js/physics.js": "class Physics {\n    static circleWallCollision(player, maze, cellSize) {\n        const gridX = Math.floor(player.x / cellSize);\n        const gridY = Math.floor(player.y / cellSize);\n        \n        for (let dy = -1; dy <= 1; dy++) {\n            for (let dx = -1; dx <= 1; dx++) {\n                const cx = gridX + dx;\n                const cy = gridY + dy;\n                \n                if (cx < 0 || cx >= maze.width || cy < 0 || cy >= maze.height) continue;\n                if (maze.grid[cy][cx] === 0) continue;\n                \n                const wallLeft = cx * cellSize;\n                const wallTop = cy * cellSize;\n                const wallRight = wallLeft + cellSize;\n                const wallBottom = wallTop + cellSize;\n                \n                if (Utils.circleRectCollision(\n                    player.x, player.y, player.radius,\n                    wallLeft, wallTop, cellSize, cellSize\n                )) {\n                    const closestX = Utils.clamp(player.x, wallLeft, wallRight);\n                    const closestY = Utils.clamp(player.y, wallTop, wallBottom);\n                    \n                    const cdx = player.x - closestX;\n                    const cdy = player.y - closestY;\n                    const dist = Math.sqrt(cdx * cdx + cdy * cdy);\n                    \n                    if (dist < player.radius && dist > 0) {\n                        const overlap = player.radius - dist;\n                        const nx = cdx / dist;\n                        const ny = cdy / dist;\n                        \n                        player.x += nx * overlap;\n                        player.y += ny * overlap;\n                        \n                        const dot = player.vx * nx + player.vy * ny;\n                        player.vx -= dot * nx * 1.2;\n                        player.vy -= dot * ny * 1.2;\n                    }\n                }\n            }\n        }\n    }\n    \n    static checkPlayerSentinelCollision(player, sentinels) {\n        for (const sentinel of sentinels) {\n            const dist = Utils.distance(player.x, player.y, sentinel.x, sentinel.y);\n            if (dist < player.radius + sentinel.size) {\n                return true;\n            }\n        }\n        return false;\n    }\n    \n    static checkExitCollision(player, exitX, exitY, cellSize) {\n        const exitCenterX = (exitX + 0.5) * cellSize;\n        const exitCenterY = (exitY + 0.5) * cellSize;\n        const dist = Utils.distance(player.x, player.y, exitCenterX, exitCenterY);\n        return dist < player.radius + cellSize * 0.4;\n    }\n}", "js/renderer.js": "class Renderer {\n    constructor(canvas) {\n        this.canvas = canvas;\n        this.ctx = canvas.getContext('2d');\n        this.canvas.width = 960;\n        this.canvas.height = 640;\n        this.scale = 1;\n        this.offsetX = 0;\n        this.offsetY = 0;\n        this.camera = {x: 0, y: 0, viewportWidth: 960, viewportHeight: 640};\n        this.resize();\n        \n        window.addEventListener('resize', () => this.resize());\n    }\n    \n    resize() {\n        const windowWidth = window.innerWidth;\n        const windowHeight = window.innerHeight;\n        const aspectRatio = 960 / 640;\n        \n        let newWidth, newHeight;\n        \n        if (windowWidth / windowHeight > aspectRatio) {\n            newHeight = windowHeight;\n            newWidth = newHeight * aspectRatio;\n        } else {\n            newWidth = windowWidth;\n            newHeight = newWidth / aspectRatio;\n        }\n        \n        this.canvas.style.width = `${newWidth}px`;\n        this.canvas.style.height = `${newHeight}px`;\n        \n        this.scale = newWidth / 960;\n        this.offsetX = (windowWidth - newWidth) / 2;\n        this.offsetY = (windowHeight - newHeight) / 2;\n    }\n    \n    clear() {\n        this.ctx.fillStyle = '#050505';\n        this.ctx.fillRect(0, 0, this.canvas.width, this.canvas.height);\n    }\n    \n    updateCamera(targetX, targetY, mazeWidth, mazeHeight, cellSize) {\n        const worldWidth = mazeWidth * cellSize;\n        const worldHeight = mazeHeight * cellSize;\n        \n        this.camera.x = Utils.clamp(\n            targetX - this.camera.viewportWidth / 2,\n            0,\n            worldWidth - this.camera.viewportWidth\n        );\n        this.camera.y = Utils.clamp(\n            targetY - this.camera.viewportHeight / 2,\n            0,\n            worldHeight - this.camera.viewportHeight\n        );\n    }\n    \n    drawMaze(maze, cellSize) {\n        const cells = Utils.getViewportCells(this.camera, maze.width, maze.height, cellSize);\n        \n        this.ctx.fillStyle = '#1a1a1a';\n        this.ctx.strokeStyle = '#00ffff';\n        this.ctx.lineWidth = 2;\n        \n        for (let y = cells.startY; y < cells.endY; y++) {\n            for (let x = cells.startX; x < cells.endX; x++) {\n                if (maze.grid[y][x] === 1) {\n                    const screenX = x * cellSize - this.camera.x;\n                    const screenY = y * cellSize - this.camera.y;\n                    \n                    this.ctx.shadowColor = '#00ffff';\n                    this.ctx.shadowBlur = 15;\n                    this.ctx.fillRect(screenX, screenY, cellSize, cellSize);\n                    this.ctx.shadowBlur = 0;\n                    this.ctx.strokeRect(screenX + 1, screenY + 1, cellSize - 2, cellSize - 2);\n                }\n            }\n        }\n    }\n    \n    drawExit(x, y, cellSize, time) {\n        const screenX = (x + 0.5) * cellSize - this.camera.x;\n        const screenY = (y + 0.5) * cellSize - this.camera.y;\n        const pulse = 0.7 + Math.sin(time * 3) * 0.3;\n        const size = cellSize * 0.35 * pulse;\n        \n        this.ctx.save();\n        this.ctx.translate(screenX, screenY);\n        this.ctx.rotate(time * 0.5);\n        \n        this.ctx.shadowColor = '#ffd700';\n        this.ctx.shadowBlur = 20 * pulse;\n        this.ctx.fillStyle = '#ffd700';\n        this.ctx.fillRect(-size, -size, size * 2, size * 2);\n        \n        this.ctx.strokeStyle = '#fff';\n        this.ctx.lineWidth = 2;\n        this.ctx.strokeRect(-size * 0.6, -size * 0.6, size * 1.2, size * 1.2);\n        \n        this.ctx.restore();\n    }\n    \n    drawPlayer(player) {\n        for (let i = player.trail.length - 1; i >= 0; i--) {\n            const t = player.trail[i];\n            const alpha = (1 - i / player.trail.length) * 0.4;\n            const size = player.radius * (1 - i / player.trail.length * 0.5);\n            \n            const screenX = t.x - this.camera.x;\n            const screenY = t.y - this.camera.y;\n            \n            this.ctx.beginPath();\n            this.ctx.arc(screenX, screenY, size, 0, Math.PI * 2);\n            this.ctx.fillStyle = `rgba(57, 255, 20, ${alpha})`;\n            this.ctx.fill();\n        }\n        \n        const screenX = player.x - this.camera.x;\n        const screenY = player.y - this.camera.y;\n        \n        this.ctx.shadowColor = '#39ff14';\n        this.ctx.shadowBlur = 20;\n        this.ctx.beginPath();\n        this.ctx.arc(screenX, screenY, player.radius, 0, Math.PI * 2);\n        this.ctx.fillStyle = '#39ff14';\n        this.ctx.fill();\n        \n        this.ctx.shadowBlur = 0;\n        this.ctx.beginPath();\n        this.ctx.arc(screenX, screenY, player.radius * 0.5, 0, Math.PI * 2);\n        this.ctx.fillStyle = '#ffffff';\n        this.ctx.fill();\n    }\n    \n    drawSentinels(sentinels, time) {\n        for (const sentinel of sentinels) {\n            const screenX = sentinel.x - this.camera.x;\n            const screenY = sentinel.y - this.camera.y;\n            const glow = sentinel.getGlowIntensity();\n            \n            this.ctx.save();\n            this.ctx.translate(screenX, screenY);\n            \n       