(()=>{const c=document.getElementById('c');const ctx=c.getContext('2d');let W=innerWidth,H=innerHeight;c.width=W;c.height=H;window.onresize=()=>{W=innerWidth;H=innerHeight;c.width=W;c.height=H;};const p={x:W/2-60,y:H-30,w:120,h:15,v:0,ax:0.5,f:0.9};const r=8;let bx=W/2,by=H-100,vx=0,vy=0,orbiting=null,orbitT=0,orbitA=0,orbitR=0,orbitD=1;const bricks=[];const cols=9,rows=5,bw=(W-20)/cols,bh=20;for(let i=0;i<rows;i++)for(let j=0;j<cols;j++){const h=3-Math.floor(i/2)%3;bricks.push({x:20+j*bw,y:20+i*bh,w:bw,h:bh,health:h,color:h===3?'#0f0':h===2?'#ff0':'#f00'});}let score=0,lives=3,high=parseInt(localStorage.getItem('hs'))||0;if(score>high)localStorage.setItem('hs',score);const ui=document.getElementById('s');const ut=document.getElementById('t');const uh=document.getElementById('h');uh.innerHTML=high;let start=performance.now();function fmt(t){const m=Math.floor(t/60),s=Math.floor(t%60);return`${m}:${s<10?'0':''}${s}`;}function play(f,d){try{if(!window.AudioContext)window.AudioContext=window.webkitAudioContext;const ac=new AudioContext();const o=ac.createOscillator();const g=ac.createGain();o.frequency.value=f;o.type='sine';o.connect(g).connect(ac.destination);o.start();g.gain.setValueAtTime(0.1,ac.currentTime);g.gain.exponentialRampToValueAtTime(0.001,ac.currentTime+d);o.stop(ac.currentTime+d)}catch(e){}};window.onmousemove=e=>{p.targetX=e.clientX-c.offsetLeft-p.w/2;};window.onkeydown=e=>{if(e.key=='ArrowLeft')p.targetX-=20;if(e.key=='ArrowRight')p.targetX+=20;};function coll(b){const dx=b.x+b.w/2-bx,dy=b.y+b.h/2-by;return Math.hypot(dx,dy)<b.w/2+b.h/2+r;}function orbitUpdate(dt){orbitT+=dt;orbitA+=orbitR*orbitD*dt;bx=bx?bx:orbiting.x+orbiting.w/2;by=by?by:orbiting.y+orbiting.h/2;bx=orbiting.x+orbiting.w/2+orbitR*Math.cos(orbitA);by=orbiting.y+orbiting.h/2+orbitR*Math.sin(orbitA);if(orbitT>5000){orbiting.health--;if(orbiting.health<=0){const i=bricks.indexOf(orbiting);if(i>-1)bricks.splice(i,1);score+=orbiting.health+1;ui.innerHTML=score;play(200,0.2);orbiting=null;orbitT=0;}else{play(150,0.1);}};}function gameLoop(){const now=performance.now();const dt=now-start;start=now;// paddle smoothp.x+=(p.targetX-p.x)*0.1;// ball move if not orbiting{if(!orbiting){bx+=vx*dt/20;by+=vy*dt/20;if(bx-r<0){bx=r;vx=-vx;play(200,0.1);}if(bx+r>W){bx=W-r;vx=-vx;play(200,0.1);}if(by-r<0){by=r;vy=-vy;play(200,0.1);}if(by+r>H){lives--;if(lives<=0){alert('Game Over');return;}bx=W/2;by=H-100;vx=vy=0;orbiting=null;orbitT=0;};// brick collision bricks.forEach((b,i)=>{if(coll(b)){if(b.health>1){orbiting=b;orbitR=bw*1.5;orbitA=Math.atan2(by-b.y,b.x+b.w/2-bx);orbitD=Math.random()>.5?1:-1;orbitT=0;}else{b.health--;if(b.health<=0){bricks.splice(i,1);score+=b.health+1;ui.innerHTML=score;play(300,0.2);}}})}}else{orbitUpdate(dt/20);}// render ctx.fillStyle='#000';ctx.fillRect(0,0,W,H);// paddle ctx.fillStyle='#0ff';ctx.fillRect(p.x,p.y,p.w,p.h);// ball ctx.fillStyle='#fff';ctx.beginPath();ctx.arc(bx,by,r,0,Math.PI*2);ctx.fill();// bricks bricks.forEach(b=>{ctx.fillStyle=b.color;ctx.fillRect(b.x,b.y,b.w,b.h);});// timer ut.innerHTML=fmt((performance.now()-start0)/1000);// requestAnimationFrame(gameLoop)};gameLoop();})();

