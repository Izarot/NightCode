core/grid.js:

```js
export class Grid {
  constructor(width, height, tileSize) {
    this.width = width;
    this.height = height;
    this.tileSize = tileSize;
    this.cells = Array.from({length: height}, () => Array(width).fill(null));
  }
  isInside(x, y) {
    return x >= 0 && x < this.width && y >= 0 && y < this.height;
  }
  getCell(x, y) {
    if (!this.isInside(x, y)) return null;
    return this.cells[y][x];
  }
  setCell(x, y, value) {
    if (this.isInside(x, y)) this.cells[y][x] = value;
  }
}
```

core/spatialHash.js:

```js
export class SpatialHash {
  constructor(cellSize) {
    this.cellSize = cellSize;
    this.map = new Map();
  }
  insert(entity) {
    const key = this._key(entity.x, entity.y);
    if (!this.map.has(key)) this.map.set(key, []);
    this.map.get(key).push(entity);
  }
  query(x, y) {
    const cx = Math.floor(x / this.cellSize);
    const cy = Math.floor(y / this.cellSize);
    const result = [];
    for (let dx = -1; dx <= 1; dx++) {
      for (let dy = -1; dy <= 1; dy++) {
        const key = this._key(cx + dx, cy + dy);
        if (this.map.has(key)) result.push(...this.map.get(key));
      }
    }
    return result;
  }
  _key(x, y) {
    return `${x},${y}`;
  }
}
```

