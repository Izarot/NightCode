 targetDiff * eased;\n    }\n  }\n  \n  render(level, ball, exit) {\n    const ctx = this.ctx;\n    const w = this.canvas.width;\n    const h = this.canvas.height;\n    \n    ctx.fillStyle = this.colors.bg;\n    ctx.fillRect(0, 0, w, h);\n    \n    ctx.save();\n    ctx.translate(w / 2, h / 2);\n    ctx.rotate(-this.visualRotation);\n    ctx.translate(-level.width / 2, -level.height / 2);\n    \n    for (const wall of level.walls) {\n      ctx.fillStyle = this.colors.wallFill;\n      ctx.strokeStyle = this.colors.wallStroke;\n      ctx.lineWidth = 2;\n      ctx.shadowColor = this.colors.wallStroke;\n      ctx.shadowBlur = 10;\n      ctx.fillRect(wall.x, wall.y, wall.w, wall.h);\n      ctx.strokeRect(wall.x, wall.y, wall.w, wall.h);\n    }\n    \n    ctx.shadowBlur = 0;\n    ctx.beginPath();\n    ctx.arc(level.ball.x, level.ball.y, 15, 0, Math.PI * 2);\n    ctx.strokeStyle = this.colors.start;\n    ctx.setLineDash([5, 5]);\n    ctx.stroke();\n    ctx.setLineDash([]);\n    \n    const pulse = Math.sin(this.time * 0.005) * 0.3 + 0.7;\n    ctx.fillStyle = this.colors.exitGlow;\n    ctx.fillRect(exit.x - 5, exit.y - 5, exit.w + 10, exit.h + 10);\n    ctx.fillStyle = `rgba(0, 255, 136, ${0.3 * pulse})`;\n    ctx.fillRect(exit.x, exit.y, exit.w, exit.h);\n    ctx.strokeStyle = this.colors.exit;\n    ctx.lineWidth = 3;\n    ctx.shadowColor = this.colors.exit;\n    ctx.shadowBlur = 15 * pulse;\n    ctx.strokeRect(exit.x, exit.y, exit.w, exit.h);\n    \n    const scanY = (this.time * 0.1) % exit.h;\n    ctx.strokeStyle = `rgba(255, 255, 255, ${0.5 * pulse})`;\n    ctx.lineWidth = 1;\n    ctx.beginPath();\n    ctx.moveTo(exit.x, exit.y + scanY);\n    ctx.lineTo(exit.x + exit.w, exit.y + scanY);\n    ctx.stroke();\n    \n    ctx.shadowBlur = 20;\n    ctx.shadowColor = this.colors.ballGlow;\n    const grad = ctx.createRadialGradient(\n      ball.x - ball.radius * 0.3, ball.y - ball.radius * 0.3, 0,\n      ball.x, ball.y, ball.radius\n    );\n    grad.addColorStop(0, this.colors.ballGlow);\n    grad.addColorStop(0.5, this.colors.ball);\n    grad.addColorStop(1, '#aa2244');\n    ctx.fillStyle = grad;\n    ctx.beginPath();\n    ctx.arc(ball.x, ball.y, ball.radius, 0, Math.PI * 2);\n    ctx.fill();\n    \n    ctx.restore();\n  }\n}\n\nconst renderer = new Renderer(document.getElementById('gameCanvas'));", "js/game.js": "(function() {\n  const canvas = document.getElementById('gameCanvas');\n  const levelNumEl = document.getElementById('levelNum');\n  const movesEl = document.getElementById('moves');\n  const timerEl = document.getElementById('timer');\n  const highScoreEl = document.getElementById('highScore');\n  const overlay = document.getElementById('overlay');\n  const overlayTitle = document.getElementById('overlayTitle');\n  const overlayText = document.getElementById('overlayText');\n  \n  let currentLevel = 0;\n  let ball = { x: 0, y: 0, vx: 0, vy: 0, radius: 12 };\n  let gravityAngle = 0;\n  let targetGravityAngle = 0;\n  let moves = 0;\n  let canRotate = true;\n  let gameState = 'playing';\n  let startTime = 0;\n  let elapsedTime = 0;\n  let highScore = localStorage.getItem('orbitHighScore') || null;\n  \n  if (highScore) {\n    highScoreEl.textContent = `BEST: ${formatTime(parseFloat(highScore))}`;\n  }\n  \n  function formatTime(ms) {\n    const totalSec = Math.floor(ms / 1000);\n    const min = Math.floor(totalSec / 60);\n    const sec = totalSec % 60;\n    const centis = Math.floor((ms % 1000) / 10);\n    return `${min.toString().padStart(2, '0')}:${sec.toString().padStart(2, '0')}.${centis.toString().padStart(2, '0')}`;\n  }\n  \n  function loadLevel(index) {\n    const level = LEVELS[index];\n    ball.x = level.ball.x;\n    ball.y = level.ball.y;\n    ball.vx = 0;\n    ball.vy = 0;\n    gravityAngle = 0;\n    targetGravityAngle = 0;\n    renderer.visualRotation = 0;\n    renderer.targetRotation = 0;\n    renderer.rotationProgress = 1;\n    moves = 0;\n    gameState = 'playing';\n    startTime = performance.now();\n    \n    renderer.resize(level.width, level.height);\n    levelNumEl.textContent = level.id;\n    movesEl.textContent = moves;\n    \n    canvas.style.width = Math.min(level.width, window.innerWidth * 0.95) + 'px';\n    canvas.style.height = Math.min(level.height, window.innerHeight * 0.6) + 'px';\n    \n    overlay.style.display = 'none';\n  }\n  \n  function rotateWorld(direction) {\n    if (!canRotate || gameState !== 'playing') return;\n    \n    audio.init();\n    audio.playRotate();\n    \n    moves++;\n    movesEl.textContent = moves;\n    \n    targetGravityAngle += direction * Math.PI / 2;\n    renderer.targetRotation = targetGravityAngle;\n    renderer.rotationProgress = 0;\n    gravityAngle = targetGravityAngle;\n    \n    canRotate = false;\n    setTimeout(() => { canRotate = true; }, 300);\n  }\n  \n  function resetLevel() {\n    audio.init();\n    loadLevel(currentLevel);\n  }\n  \n  function winLevel() {\n    gameState = 'won';\n    audio.playWin();\n    \n    const finalTime = performance.now() - startTime + elapsedTime;\n    \n    if (!highScore || finalTime < parseFloat(highScore)) {\n      highScore = finalTime.toString();\n      localStorage.setItem('orbitHighScore', highScore);\n      highScoreEl.textContent = `BEST: ${formatTime(finalTime)}`;\n      overlayTitle.textContent = 'NEW RECORD!';\n    } else {\n      overlayTitle.textContent = 'LEVEL COMPLETE';\n    }\n    \n    overlayText.textContent = `Time: ${formatTime(finalTime)} | Moves: ${moves}`;\n    overlay.style.display = 'block';\n    \n    setTimeout(() => {\n      currentLevel = (currentLevel + 1) % LEVELS.length;\n      if (currentLevel === 0) {\n        elapsedTime += performance.now() - startTime;\n      }\n      loadLevel(currentLevel);\n    }, 2500);\n  }\n  \n  function gameLoop(timestamp) {\n    if (!startTime) startTime = timestamp;\n    \n    if (gameState === 'playing') {\n      const level = LEVELS[currentLevel];\n      const result = physics.updateBall(ball, level.walls, gravityAngle);\n      \n      if (result.bounced) {\n        audio.playBounce();\n      }\n      \n      if (physics.checkWin(ball, level.exit)) {\n        winLevel();\n      }\n      \n      timerEl.textContent = formatTime(performance.now() - startTime + elapsedTime);\n    }\n    \n    const level = LEVELS[currentLevel];\n    renderer.update(16.67);\n    renderer.render(level, ball, level.exit);\n    \n    requestAnimationFrame(gameLoop);\n  }\n  \n  document.addEventListener('keydown', (e) => {\n    if (e.key === 'ArrowLeft' || e.key === 'a' || e.key === 'A') {\n      rotateWorld(-1);\n    } else if (e.key === 'ArrowRight' || e.key === 'd' || e.key === 'D') {
      rotateWorld(1);
    } else if (e.key === 'r' || e.key === 'R') {
      resetLevel();
    }
  });
  
  document.getElementById('btnLeft').addEventListener('click', () => rotateWorld(-1));
  document.getElementById('btnRight').addEventListener('click', () => rotateWorld(1));
  document.getElementById('btnReset').addEventListener('click', resetLevel);
  
  let touchStartX = 0;
  canvas.addEventListener('touchstart', (e) => {
    touchStartX = e.touches[0].clientX;
  });
  
  canvas.addEventListener('touchend', (e) => {
    const touchEndX = e.changedTouches[0].clientX;
    const diff = touchEndX - touchStartX;
    if (Math.abs(diff) > 50) {
      rotateWorld(diff > 0 ? 1 : -1);
    }
  });
  
