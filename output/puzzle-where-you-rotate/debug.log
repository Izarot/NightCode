```
// Physics update in local space
function updateBall(ball, level, dt) {
    // Transform to local space
    let localPos = rotate(ball.pos - level.center, -level.angle);
    let localVel = rotate(ball.vel, -level.angle);
    
    // Apply gravity in local space
    localVel.y += GRAVITY * dt;
    
    // Check collisions in local space
    for (wall of level.walls) {
        resolveCollision(localPos, localVel, wall);
    }
    
    // Apply friction
    localVel *= FRICTION;
    
    // Cap speed
    if (length(localVel) > MAX_SPEED) localVel = normalize(localVel) * MAX_SPEED;
    
    // Transform back to screen space
    ball.vel = rotate(localVel, level.angle);
    ball.pos = level.center + rotate(localPos, level.angle);
}
```

This is clean. Let me implement it.

