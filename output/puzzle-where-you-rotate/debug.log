00, this.ctx.currentTime + 0.15);\n    gain.gain.setValueAtTime(0.15, this.ctx.currentTime);\n    gain.gain.exponentialRampToValueAtTime(0.01, this.ctx.currentTime + 0.15);\n    osc.start(this.ctx.currentTime);\n    osc.stop(this.ctx.currentTime + 0.15);\n  }\n  \n  playBounce() {\n    if (!this.ctx) return;\n    const osc = this.ctx.createOscillator();\n    const gain = this.ctx.createGain();\n    osc.connect(gain);\n    gain.connect(this.ctx.destination);\n    osc.type = 'triangle';\n    osc.frequency.setValueAtTime(150, this.ctx.currentTime);\n    osc.frequency.exponentialRampToValueAtTime(80, this.ctx.currentTime + 0.1);\n    gain.gain.setValueAtTime(0.2, this.ctx.currentTime);\n    gain.gain.exponentialRampToValueAtTime(0.01, this.ctx.currentTime + 0.1);\n    osc.start(this.ctx.currentTime);\n    osc.stop(this.ctx.currentTime + 0.1);\n  }\n  \n  playWin() {\n    if (!this.ctx) return;\n    const notes = [523, 659, 784, 1047];\n    notes.forEach((freq, i) => {\n      const osc = this.ctx.createOscillator();\n      const gain = this.ctx.createGain();\n      osc.connect(gain);\n      gain.connect(this.ctx.destination);\n      osc.type = 'sine';\n      osc.frequency.setValueAtTime(freq, this.ctx.currentTime + i * 0.1);\n      gain.gain.setValueAtTime(0, this.ctx.currentTime + i * 0.1);\n      gain.gain.linearRampToValueAtTime(0.2, this.ctx.currentTime + i * 0.1 + 0.05);\n      gain.gain.exponentialRampToValueAtTime(0.01, this.ctx.currentTime + i * 0.1 + 0.3);\n      osc.start(this.ctx.currentTime + i * 0.1);\n      osc.stop(this.ctx.currentTime + i * 0.1 + 0.3);\n    });\n  }\n}\n\nconst audio = new AudioManager();", "js/physics.js": "class Physics {\n  constructor() {\n    this.gravity = 0.5;\n    this.terminalVelocity = 15;\n    this.friction = 0.98;\n    this.restitution = 0.2;\n  }\n  \n  updateBall(ball, walls, gravityAngle) {\n    const gx = Math.sin(gravityAngle) * this.gravity;\n    const gy = Math.cos(gravityAngle) * this.gravity;\n    \n    ball.vx += gx;\n    ball.vy += gy;\n    \n    const speed = Math.sqrt(ball.vx * ball.vx + ball.vy * ball.vy);\n    if (speed > this.terminalVelocity) {\n      ball.vx = (ball.vx / speed) * this.terminalVelocity;\n      ball.vy = (ball.vy / speed) * this.terminalVelocity;\n    }\n    \n    const nextX = ball.x + ball.vx;\n    const nextY = ball.y + ball.vy;\n    \n    let grounded = false;\n    let bounced = false;\n    \n    for (const wall of walls) {\n      const collision = this.checkCircleRect(nextX, nextY, ball.radius, wall);\n      if (collision.collided) {\n        if (collision.axis === 'x') {\n          ball.x = collision.correctedX;\n          ball.vx *= -this.restitution;\n          bounced = true;\n        } else {\n          ball.y = collision.correctedY;\n          if (collision.axis === 'y' && collision.normal === -1) {\n            grounded = true;\n          }\n          ball.vy *= -this.restitution;\n          bounced = true;\n        }\n      }\n    }\n    \n    if (!bounced) {\n      ball.x = nextX;\n      ball.y = nextY;\n    }\n    \n    if (grounded) {\n      ball.vx *= this.friction;\n    }\n    \n    return { grounded, bounced };\n  }\n  \n  checkCircleRect(cx, cy, r, rect) {\n    const closestX = Math.max(rect.x, Math.min(cx, rect.x + rect.w));\n    const closestY = Math.max(rect.y, Math.min(cy, rect.y + rect.h));\n    \n    const dx = cx - closestX;\n    const dy = cy - closestY;\n    const distSq = dx * dx + dy * dy;\n    \n    if (distSq < r * r) {\n      const dist = Math.sqrt(distSq);\n      const overlap = r - dist;\n      \n      let axis = 'y';\n      let normal = 1;\n      let correctedX = cx;\n      let correctedY = cy;\n      \n      if (dist > 0.001) {\n        const nx = dx / dist;\n        const ny = dy / dist;\n        correctedX = cx + nx * overlap;\n        correctedY = cy + ny * overlap;\n        \n        if (Math.abs(nx) > Math.abs(ny)) {\n          axis = 'x';\n          normal = nx > 0 ? 1 : -1;\n        } else {\n          axis = '