Raw: {"index.html":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<title>Maze Runner</title>\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<link rel=\"icon\" href=\"data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 32 32%22><text y=%2215%22 font-size=%2218%22>🏁</text></svg>\">\n<link rel=\"stylesheet\" href=\"style.css\">\n</head>\n<body>\n<div id=\"hud\">\n  <span id=\"timer\">00:00</span>\n  <span id=\"score\">Score: 0</span>\n  <button id=\"restart\">R</button>\n  <span id=\"highscore\">High: 0</span>\n</div>\n<canvas id=\"gameCanvas\"></canvas>\n<script type=\"module\" src=\"src/main.js\"></script>\n</body>\n</html>","style.css":"body{\n  margin:0;\n  overflow:hidden;\n  font-family:Arial, sans-serif;\n  background:#f0f0f0;\n}\n#hud{\n  position:fixed;\n  top:0;\n  left:0;\n  width:100%;\n  height:50px;\n  background:#000;\n  color:#fff;\n  display:flex;\n  align-items:center;\n  justify-content:space-between;\n  padding:0 20px;\n  box-sizing:border-box;\n  z-index:10;\n}\n#timer, #score, #highscore{\n  font-size:18px;\n}\n#restart{\n  width:16px;\n  height:16px;\n  background:#000;\n  color:#fff;\n  border:none;\n  cursor:pointer;\n  font-size:12px;\n  line-height:16px;\n  text-align:center;\n  padding:0;\n}\ncanvas{\n  display:block;\n}","src/main.js":"import {generateMaze} from './maze/generator.js';\nimport {Player} from './entities/player.js';\nimport {Exit} from './entities/exit.js';\nimport {HUD} from './ui/hud.js';\nimport {Sound} from './ui/sound.js';\nimport {movePlayer} from './physics/movement.js';\n\nconst canvas = document.getElementById('gameCanvas');\nconst ctx = canvas.getContext('2d');\nconst cellSize = 32;\nconst hud = new HUD();\nconst sound = new Sound();\n\nlet maze, player, exit;\nlet score = 0;\nlet startTime = 0;\nlet elapsed = 0;\nlet animationFrameId;\n\nfunction init(){\n  resizeCanvas();\n  maze = generateMaze(Math.floor(canvas.width / cellSize), Math.floor(canvas.height / cellSize));\n  player = new Player(0,0,16,'#0000ff',cellSize);\n  let exitCol, exitRow;\n  do{\n    exitCol = Math.floor(Math.random()*maze.cols);\n    exitRow = Math.floor(Math.random()*maze.rows);\n  }while(Math.abs(exitCol-0)+Math.abs(exitRow-0)<=1);\n  exit = new Exit(exitCol,exitRow,32,'#00ff00',cellSize);\n  score = 0;\n  startTime = performance.now();\n  elapsed = 0;\n  hud.setScore(score);\n  hud.setHighScore(parseInt(localStorage.getItem('mazeHighScore'))||0);\n  hud.setTimer(0);\n  if(animationFrameId) cancelAnimationFrame(animationFrameId);\n  animationFrameId = requestAnimationFrame(gameLoop);\n}\n\nfunction resizeCanvas(){\n  canvas.width = window.innerWidth;\n  canvas.height = window.innerHeight - 50;\n}\n\nwindow.addEventListener('resize',()=>{resizeCanvas();init();});\n\nconst directions={\n  ArrowUp:{dx:0,dy:-1,wall:'top'},\n  ArrowDown:{dx:0,dy:1,wall:'bottom'},\n  ArrowLeft:{dx:-1,dy:0,wall:'left'},\n  ArrowRight:{dx:1,dy:0,wall:'right'}\n};\n\nwindow.addEventListener('keydown',e=>{if(directions[e.key]){movePlayer(player,directions[e.key],maze,sound);}});\n\nfunction gameLoop(timestamp){\n  elapsed = timestamp - startTime;\n  update();\n  render();\n  if(player.col===exit.col && player.row===exit.row){win();return;}\n  animationFrameId = requestAnimationFrame(gameLoop);\n}\n\nfunction update(){player.update();}\n\nfunction render(){\n  ctx.clearRect(0,0,canvas.width,canvas.height);\n  ctx.strokeStyle='#333';\n  ctx.lineWidth=2;\n  for(let x=0;x<maze.cols;x++){\n    for(let y=0;y<maze.rows;y++){\n      const cell=maze.grid[x][y];\n      const px=x*cellSize,py=y*cellSize;\n      if(cell.walls.top) ctx.strokeRect(px,py,cellSize,0);\n      if(cell.walls.right) ctx.strokeRect(px+cellSize,py,0,cellSize);\n      if(cell.walls.bottom) ctx.strokeRect(px,py+cellSize,cellSize,0);\n      if(cell.walls.left) ctx.strokeRect(px,py,0,cellSize);\n    }\n  }\n  exit.draw(ctx);\n  player.draw(ctx);\n  hud.setTimer(Math.floor(elapsed/1000));\n}\n\nfunction win(){\n  score+=10;\n  hud.setScore(score);\n  const high=parseInt(localStorage.getItem('mazeHighScore'))||0;\n  if(score>high){localStorage.setItem('mazeHighScore',score);hud.setHighScore(score);}\n  sound.playWin();\n  alert('You Win! Score: '+score);\n}\n\nhud.onRestart(()=>{init();});\n\ninit();","src/physics/movement.js":"export function movePlayer(player,dir,maze,sound){\n  if(player.col===player.targetCol && player.row===player.targetRow){\n    const targetCol=player.col+dir.dx;\n    const targetRow=player.row+dir.dy;\n    if(targetCol<0||targetCol>=maze.cols||targetRow<0||targetRow>=maze.rows)return;\n    const cell=maze.grid[player.col][player.row];\n    if(cell.walls[dir.wall])return;\n    player.moveTo(targetCol,targetRow);\n    sound.playMove();\n  }\n}","src/maze/generator.js":"export function generateMaze(cols,rows){\n  const grid=Array.from({length:cols},(_,x)=>Array.from({length:rows},(_,y)=>({x,y,walls:{top:true,right:true,bottom:true,left:true},visited:false})))\n  const stack=[];\n  let current=grid[0][0];\n  current.visited=true;\n  while(true){\n    const neighbors=[];\n    const dirs=[{dx:0,dy:-1,wall:'top',opposite:'bottom'},{dx:1,dy:0,wall:'right',opposite:'left'},{dx:0,dy:1,wall:'bottom',opposite:'top'},{dx:-1,dy:0,wall:'left',opposite:'right'}];\n    for(const d of dirs){\n      const nx=current.x+d.dx,ny=current.y+d.dy;\n      if(nx>=0&&nx<cols&&ny>=0&&ny<rows&&!grid[nx][ny].visited){\n        neighbors.push({cell:grid[nx][ny],dir:d});\n      }\n    }\n    if(neighbors.length){\n      const {cell,dir}=neighbors[Math.floor(Math.random()*neighbors.length)];\n      current.walls[dir.wall]=false;\n      cell.walls[dir.opposite]=false;\n      stack.push(current);\n      current=cell;\n      current.visited=true;\n    }else if(stack.length){\n      current=stack.pop();\n    }else break;\n  }\n  return {grid,cols,rows};\n}","src/entities/player.js":"export class Player{constructor(col,row,radius,color,cellSize){this.col=col;this.row=row;this.radius=radius;this.color=color;this.cellSize=cellSize;this.x=col*cellSize+cellSize/2;this.y=row*cellSize+cellSize/2;this.targetCol=col;this.targetRow=row;this.speed=5;}moveTo(col,row){this.targetCol=col;this.targetRow=row;}update(){if(this.col===this.targetCol&&this.row===this.targetRow)return;const targetX=this.targetCol*this.cellSize+this.cellSize/2;const targetY=this.targetRow*this.cellSize+this.cellSize/2;const dx=targetX-this.x;const dy=targetY-this"src/entities/player.js":"export class Player{constructor(col,row,radius,color,cellSize){this.col=col;this.row=row;this.radius=radius;this.color=color;this.cellSize=cellSize;this.x=col*cellSize+cellSize/2;this.y=row*cellSize+cellSize/2;this.targetCol=col;this.targetRow=row;this.speed=5;}moveTo(col,row){this.targetCol=col;this.targetRow=row;}update(){if(this.col===this.targetCol&&this.row===this.targetRow)return;const targetX=this.targetCol*this.cellSize+this.cellSize/2;const targetY=this.targetRow*this.cellSize+this.cellSize/2;const dx=targetX-this.x;const dy=targetY-this.y;const dist=Math.sqrt(dx*dx+dy*dy);if(dist< this.speed){this.x=targetX;this.y=targetY;this.col=this.targetCol;this.row=this.targetRow;}else{this.x+=dx/dist*this.speed;this.y+=dy/dist*this.speed;}}draw(ctx){ctx.fillStyle=this.color;ctx.beginPath();ctx.arc(this.x,this.y,this.radius,0,Math.PI*2);ctx.fill();}}"}