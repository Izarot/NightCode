html>", "styles.css":"*{margin:0;padding:0;box-sizing:border-box}body{font-family:Inter,system-ui,sans-serif;background:radial-gradient(circle at 50% 30%,#1e293b 0%,#0d1117 100%);min-height:100vh;display:flex;justify-content:center;align-items:center;color:#f8fafc;overflow:hidden}#app{position:relative;display:flex;flex-direction:column;align-items:center;gap:8px;width:100%;max-width:500px;padding:12px}#game{border-radius:12px;background:linear-gradient(145deg,#1a2433,#0f1520);box-shadow:0 8px 32px rgba(0,0,0,.5),inset 0 1px 0 rgba(255,255,255,.05);touch-action:none;max-width:100%;height:auto}#speedrun-timer{position:fixed;top:10px;left:50%;transform:translateX(-50%);background:rgba(30,41,59,.9);padding:6px 14px;border-radius:20px;font-size:14px;font-weight:600;color:#a78bfa;border:1px solid #334155;font-variant-numeric:tabular-nums}#hud{display:flex;flex-wrap:wrap;justify-content:center;gap:10px;width:100%;padding:8px;background:rgba(30,41,59,.7);border-radius:10px;border:1px solid #334155}.hud-item{text-align:center;font-size:12px}.hud-item .label{color:#64748b;display:block;font-size:10px;text-transform:uppercase;letter-spacing:.5px}.hud-item span{font-size:18px;font-weight:700;color:#f8fafc}.hud-item.score span{color:#10b981}.hud-item.time span{color:#ffb900}.hud-item.time.warning span{color:#ef4444;animation:pulse .5s infinite}@keyframes pulse{0%,100%{opacity:1}50%{opacity:.5}}.high-score{position:fixed;top:10px;right:10px;background:rgba(16,185,129,.2);padding:4px 10px;border-radius:8px;font-size:12px;color:#10b981;border:1px solid #10b981}#equation-preview{background:rgba(30,41,59,.9);padding:6px 14px;border-radius:8px;font-size:16px;color:#cbd5e1;min-height:32px;min-width:150px;text-align:center;border:1px solid #334155;font-weight:500;letter-spacing:1px}#buttons{display:flex;gap:8px}#buttons button{width:44px;height:44px;border:none;border-radius:8px;background:#334155;color:#f8fafc;font-size:20px;cursor:pointer;transition:all .15s;display:flex;align-items: