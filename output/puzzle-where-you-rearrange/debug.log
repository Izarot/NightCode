=60;this.grid=[];this.selected=null;this.animating=false;this.hints=3;this.undoStack=[];this.speedrunStart=0;this.highScore=parseInt(localStorage.getItem('eqShiftHighScore')||'0');this.particleSystems=[];this.setupEvents();this.loadLevel(1);this.render();requestAnimationFrame(t=>this.loop(t))}\nloadLevel(n){this.level=n;const cfg=this.getLevelConfig(n);this.grid=Array(GRID_SIZE).fill(null).map(()=>Array(GRID_SIZE).fill(null).map(()=>this.randomTile(cfg.ops)));this.seedEquation(cfg.ops);this.moves=0;this.equations=0;this.timeLeft=cfg.time;this.moveLimit=cfg.moves;this.eqTarget=cfg.eqTarget;this.undoStack=[];this.selected=null;this.state='PLAYING';this.updateHUD();document.getElementById('start-screen').classList.add('hidden');if(!this.speedrunStart)this.speedrunStart=performance.now()}\ngetLevelConfig(n){const base={eqTarget:2,moves:15,time:60,ops:['+','−']};if(n<=3)return base;if(n<=6)return{eqTarget:3,moves:14,time:55,ops:['+','−','×']};if(n<=10)return{eqTarget:4,moves:13,time:50,ops:['+','−','×','÷']};return{eqTarget:Math.min(n-6,8),moves:Math.max(10,15-n%5),time:Math.max(30,60-n*2),ops:['+','−','×','÷']}}\nrandomTile(ops){if(Math.random()<.25)return{val:ops[Math.floor(Math.random()*ops.length)],isOp:true};return{val:NUMBERS[Math.floor(Math.random()*10)],isOp:false}}\nseedEquation(ops){const a=Math.floor(Math.random()*8)+1;const b=Math.floor(Math.random()*8)+1;const res=a+b;this.grid[0][0]={val:a,isOp:false};this.grid[0][1]={val:ops[0],isOp:true};this.grid[0][2]={val:b,isOp:false};this.grid[0][3]={val:'=',isOp:true};this.grid[0][4]={val:res,isOp:false}}\nsetupEvents(){this.canvas.addEventListener('click',e=>this.handleClick(e));this.canvas.addEventListener('touchend',e=>{e.preventDefault();this.handleTouch(e)});document.addEventListener('keydown',e=>{if(e.key==='z'||e.key==='Z')this.undo();if(e.key==='r'||e.key==='R')this.resetLevel();if(e.key==='h'||e.key==='H')this.showHint()});document.getElementById('undo').onclick=()=>this.undo();document.getElementById('reset').onclick=()=>this.resetLevel();document.getElementById('hint').onclick=()=>this.showHint();document.getElementById('start-btn').onclick=()=>{initAudio();this.loadLevel(1)}}\nhandleClick(e){if(this.state!=='PLAYING')return;const rect=this.canvas.getBoundingClientRect();const x=(e.clientX-rect.left)*(CANVAS_SIZE/rect.width);const y=(e.clientY-rect.top)*(CANVAS_SIZE/rect.height);const col=Math.floor(x/CELL_SIZE);const row=Math.floor(y/CELL_SIZE);this.selectTile(row,col)}\nhandleTouch(e){if(this.state!=='PLAYING')return;const touch=e.changedTouches[0];const rect=this.canvas.getBoundingClientRect();const x=(touch.clientX-rect.left)*(CANVAS_SIZE/rect.width);const y=(touch.clientY-rect.top)*(CANVAS_SIZE/rect.height);const col=Math.floor(x/CELL_SIZE);const row=Math.floor(y/CELL_SIZE);this.selectTile(row,col)}\nselectTile(r,c){if(r<0||r>=GRID_SIZE||c<0||c>=GRID_SIZE)return;if(!this.selected){this.selected={row:r,col:c};return}const dr=Math.abs(r-this.selected.row);const dc=Math.abs(c-this.selected.col);if((dr===1&&dc===0)||(dr===0&&dc===1)){this.swap(this.selected.row,this.selected.col,r,c);this.selected=null}else{this.selected={row:r,col:c}}}\nswap(r1,c1,r2,c2){this.undoStack.push(JSON.parse(JSON.stringify(this.grid)));this.moves++;playSound('swap');const tmp=this.grid[r1][c1];this.grid[r1][c1]=this.grid[r2][c2];this.grid[r2][c2]=tmp;this.animateSwap(r1,c1,r2,c2)}\nanimateSwap(r1,c1,r2,c2){this.state='SWAPPING';const duration=180;const start=performance.now();const fromX=c1*CELL_SIZE+CELL_SIZE/2,fromY=r1*CELL_SIZE+CELL_SIZE/2;const toX=c2*CELL_SIZE+CELL_SIZE/2,toY=r2*CELL_SIZE+CELL_SIZE/2;const animate=(t)=>{const p=Math.min((t-start)/duration,1);const ease=1-Math.pow(1-p,3);const tile=this.grid[r2][c2];tile.displayX=fromX+(toX-fromX)*ease;tile.displayY=fromY+(toY-fromY)*ease;if(p<1){requestAnimationFrame(animate)}else{delete tile.displayX;delete tile.displayY;this.checkEquations()}};\nrequestAnimationFrame(animate)}\ncheckEquations(){this.state='CHECKING';const equation