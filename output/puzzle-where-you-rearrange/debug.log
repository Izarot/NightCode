-1;r++){}}}}\naddParticles(eqs){eqs.forEach(eq=>{for(let c=eq.start;c<=eq.end;c++){const x=c*CELL_SIZE+CELL_SIZE/2;const y=0*CELL_SIZE+CELL_SIZE/2;for(let i=0;i<6;i++){this.particleSystems.push({x,y,vx:(Math.random()-.5)*4,vy:(Math.random()-.5)*4,life:1,color:'#10b981',size:2+Math.random()*2})}}}})}\ncheckWin(){if(this.equations>=this.eqTarget){const totalScore=this.score+Math.max(0,this.timeLeft*10);if(totalScore>this.highScore){this.highScore=totalScore;localStorage.setItem('eqShiftHighScore',totalScore)}this.showWin()}}\nshowWin(){const elapsed=(performance.now()-this.speedrunStart)/1000;this.state='WIN';document.getElementById('modal-title').textContent='🎉 Level Complete!';document.getElementById('modal-msg').innerHTML=`Score: ${this.score}<br>Time Bonus: +${Math.max(0,this.timeLeft*10)}<br>Speedrun: ${elapsed.toFixed(2)}s`;document.getElementById('modal-btns').innerHTML=`<button class=\"primary\" onclick=\"game.nextLevel()\">Next Level</button><button class=\"secondary\" onclick=\"game.showMenu()\">Menu</button>`;document.getElementById('modal').classList.remove('hidden')}\nshowFail(msg){playSound('fail');this.state='FAIL';document.getElementById('modal-title').textContent='💔 '+msg;document.getElementById('modal-msg').innerHTML=`Equations: ${this.equations}/${this.eqTarget}<br>Moves used: ${this.moves}/${this.moveLimit}`;document.getElementById('modal-btns').innerHTML=`<button class=\"primary\" onclick=\"game.retry()\">Retry</button><button class=\"secondary\" onclick=\"game.showMenu()\">Menu</button>`;document.getElementById('modal').classList.remove('hidden')}\nnextLevel(){document.getElementById('modal').classList.add('hidden');this.loadLevel(this.level+1)}\nretry(){document.getElementById('modal').classList.add('hidden');this.loadLevel(this.level)}\nshowMenu(){document.getElementById('modal').classList.add('hidden');this.speedrunStart=performance.now();document.getElementById('start-screen').classList.remove('hidden');this.state='MENU'}\nundo(){if(this.undoStack.length===0||this.state!=='PLAYING')return;this.grid=this.undoStack.pop();this.moves--;this.updateHUD()}\nresetLevel(){this.loadLevel(this.level)}\nshowHint(){if(this.state!=='PLAYING')return;const eqs=this.findAllEquations();if(eqs.length>0){const eq=eqs[0];this.hintTiles=[{row:0,col:eq.start},{row:0,col:eq.end}];setTimeout(()=>{this.hintTiles=null},2000)}}\nupdateHUD(){document.getElementById('level').textContent=this.level;document.getElementById('eq-count').textContent=this.equations;document.getElementById('eq-target').textContent=this.eqTarget;document.getElementById('moves').textContent=this.moves;document.getElementById('move-limit').textContent=this.moveLimit;document.getElementById('score').textContent=this.score;document.getElementById('time').textContent=Math.ceil(this.timeLeft);document.getElementById('high-score').textContent=this.highScore;document.getElementById('time').parentElement.classList.toggle('warning',this.timeLeft<=10)}\nloop(timestamp){if(this.state==='PLAYING'){const elapsed=(timestamp-this.lastFrame||timestamp)/1000;this.lastFrame=timestamp;this.timeLeft-=elapsed;if(this.timeLeft<=0){this.timeLeft=0;this.showFail('Time expired!')}this.updateHUD();const timer=document.getElementById('timer');const elapsed_total=(timestamp-this.speedrunStart)/1000;const mins=Math.floor(elapsed_total/60);const secs=Math.floor(elapsed_total%60);const ms=Math.floor((elapsed_total%1)*1000);timer.textContent=`${mins.toString().padStart(2,'0')}:${secs.toString().padStart(2,'0')}.${ms.toString().padStart(3,'0')}`}this.updateParticles();this.render();requestAnimationFrame(t=>this.loop(t))}\nupdateParticles(){this.particleSystems=this.particleSystems.filter(p=>{p.x+=p.vx;p.y+=p.vy;p.life-=.02;return p.life>0})}\nrender(){const ctx=this.ctx;ctx.clearRect(0,0,CANVAS_SIZE,CANVAS_SIZE);ctx.fillStyle='#0d1117';ctx.fillRect(0,0,CANVAS_SIZE,CANVAS_SIZE);for(let r=0;r<GRID_SIZE;r++){for(let c=0;c<GRID_SIZE;c++){const tile=this.grid[r][c];if(!tile)continue;const x=c*CELL_SIZE;const y=r*CELL_SIZE;const cx=tile.displayX||(x+CELL_SIZE/2);const cy=tile.displayY||(y+CELL_SIZE/2);const selected=this.selected&&this.selected.row===r&&this.selected.col===c;const hinted=this.hintTiles&&this.hintTiles.some(h=>h.row===r&&h.col===c);ctx.save();ctx.translate(cx,cy);if(selected)ctx.scale(1.12);ctx.beginPath();ctx.roundRect(-CELL_SIZE/2+4,-CELL_SIZE/2+4,CELL_SIZE-8,CELL_SIZE-8,6);if(selected){ctx.fillStyle='#2d3a4d';ctx.shadowColor='rgba(255,185,0,.5)';ctx.shadowBlur=12;ctx.strokeStyle='#ffb900'}else if(hinted){ctx.fillStyle='#1e2d3b';ctx.strokeStyle='#a78bfa'}else{ctx.fillStyle='#1e2d3b';ctx.strokeStyle='#334155'}ctx.fill();ctx.lineWidth=2;ctx.stroke();ctx.shadowBlur=0;ctx.fillStyle=tile.isOp?'#a78bfa':'#f8fafc';ctx.font=`600 ${CELL_SIZE*.5}px Inter`;ctx.textAlign='center';ctx.textBaseline='middle';ctx.fillText(tile.val,0,2);ctx.restore()}}this.particleSystems.forEach(p=>{ctx.beginPath();ctx.arc(p.x,p.y,p.size,0,Math.PI*2);ctx.fillStyle=p.color;ctx.globalAlpha=p.life;ctx.fill();ctx.globalAlpha=1});const preview=document.getElementById('equation-preview');const row0=this.grid[0].filter(t=>t).map(t=>t.val).join(' ');preview.textContent=row0||'...'}\nstartTimer(){\nthis.speedrunStart=performance.now()}}\nlet game;window.addEventListener('DOMContentLoaded',()=>{game=new Game()});window.game=game;",}}