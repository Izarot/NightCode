  "game.js": "(function(){\n'use strict';\n\nconst BASE_W = 1280;\nconst BASE_H = 720;\nlet canvas, ctx;\nlet scale = 1;\nlet resized = false;\n\n// Game state\nlet state = 'MENU'; // MENU, PLAYING, GAMEOVER\nlet startTime = 0;\nlet lastTime = 0;\nlet score = 0;\nlet highScore = 0;\nlet combo = 0;\nlet meter = 50; // 0-100\nlet timer = 0; // speedrun timer seconds\nlet groundY;\nlet player = {x:100, y:0, radius:20, vy:0, onGround:false, jumpTime:0};\nlet platforms = [];\nlet platformWidth = 64;\nlet platformHeight = 16;\nlet platformGapMin = 120;\nlet platformGapMax = 200;\nlet platformSpeed = 600; // px/s\nlet gravity = 1800;\nlet jumpSpeedBase = 800;\nlet jumpSpeed = jumpSpeedBase;\nlet bpm = 120;\nlet beatInterval = 60 / bpm; // seconds\nlet audioCtx = null;\nlet beatStart = 0;\n\n// Input\nlet jumpPressed = false;\n\n// Init\nfunction init(){\ncanvas = document.getElementById('gameCanvas');\nctx = canvas.getContext('2d');\nwindow.addEventListener('resize', onResize);\nwindow.addEventListener('keydown', onKeyDown);\nwindow.addEventListener('keyup', onKeyUp);\nwindow.addEventListener('touchstart', onTouchStart,{passive:false});\nwindow.addEventListener('touchend', onTouchEnd,{passive:false});\nhighScore = parseInt(localStorage.getItem('beatjump-highscore')||'0',10);\nresetGame();\nrequestAnimationFrame(loop);\n}\n\nfunction onResize(){\nupdateScale();\nresized = true;\n}\n\nfunction updateScale(){\nconst w = window.innerWidth;\nconst h = window.innerHeight;\nscale = Math.min(w/BASE_W, h/BASE_H);\ncanvas.width = BASE_W * scale;\ncanvas.height = BASE_H * scale;\nctx.scale(scale, scale);\ngroundY = BASE_H - 40;\nplayer.y = groundY - player.radius;\n}\n\nfunction resetGame(){\nstate = 'PLAYING';\nscore = 0;\ncombo = 0;\nmeter = 50;\ntimer = 0;\nplayer.x = 100;\nplayer.y = groundY - player.radius;\nplayer.vy = 0;\nplayer.onGround = true;\nplayer.jumpTime = 0;\njumpPressed = false;\nplatforms = [];\nlet x = BASE_W + 200;\nwhile(x < BASE_W*2){\nconst gap = platformGapMin + Math.random()*(platformGapMax-platformGapMin);\nx += gap;\nplatforms.push({x, w:platformWidth, h:platformHeight, passed:false});\nx += platformWidth;\n}\nif(!audioCtx){\naudioCtx = new (window.AudioContext||window.webkitAudioContext)();\nbeatStart = audioCtx.currentTime;\n}\n}\n\nfunction loop(timestamp){\nif(!lastTime) lastTime = timestamp;\nconst dt = (timestamp - lastTime)/1000; // seconds\nlastTime = timestamp;\n\nupdate(dt);\nrender();\n\nrequestAnimationFrame(loop);\n}\n\nfunction update(dt){\nif(state !== 'PLAYING') return;\n\n// timer\ntimer += dt;\n\n// player physics\nif(!player.onGround){\nplayer.vy += gravity * dt;\nplayer.y += player.vy * dt;\n}\n// ground collision\nif(player.y >= groundY - player.radius){\nplayer.y = groundY - player.radius;\nif(!player.onGround){\nplayer.onGround = true;\nplayer.vy = 0;\n// evaluate landing\nif(player.jumpTime > 0){\nconst beatTime = getCurrentBeatTime();\nconst cueTime = beatTime - 0.5*beatInterval;\nconst diff = Math.abs(player.jumpTime - cueTime);\nif(diff <= 0.15){ // perfect\nmeter = Math.min(100, meter + 10);\ncombo++;\nplaySound(800,0.1);\n}else{\nmeter = Math.max(0, meter - 5);\ncombo = 0;\nplaySound(200,0.1);\n}\nplayer.jumpTime = 0;\n}\n}\n}\n\n// meter decay if no jump recently\nconst timeSinceJump = player.jumpTime ? (performance.now()/1000 - player.jumpTime) : 999;\nif(timeSinceJump > 0.5){ // idle\nmeter = Math.max(0, meter - 10 * dt);\n}\nif(meter <= 0){\nstate = 'GAMEOVER';\nif(score > highScore){\nhighScore = score;\nlocalStorage.setItem('beatjump-highscore', highScore.toString());\n}\n}\n\n// update platforms\nplatforms.forEach(p=>{p.x -= platformSpeed * dt;});\n// recycle\nconst first = platforms[0];\nif(first && first.x + first.w < 0){\nplatforms.shift();\nconst last = platforms[platforms.length-1];\nlet x = last ? last.x + last.w + platformGapMin + Math.random()*(platformGapMax-platformGapMin) : BASE_W + 200;\nplatforms.push({x, w:platformWidth, h:platformHeight, passed:false});\n}\n\n// scoring\nplatforms.forEach(p=>{\nif(!p.passed && player.x > p.x + p.w){\np.passed = true;\nscore += 10 * Math.pow(combo+1,2); // combo multiplier (x1, x2...)\n}\n});\n\n// jump input\nif(jumpPressed && player.onGround){\njumpPressed = false;\nplayer.onGround = false;\nplayer.vy = -jumpSpeed;\nplayer.jumpTime = performance.now()/1000;\n}\n}\n\nfunction getCurrentBeatTime(){\nif(!audioCtx) return 0;\nconst now = audioCtx.currentTime;\nconst elapsed = now - beatStart;\nconst beatIndex = Math.floor(elapsed / beatInterval) + 1;\nreturn beatStart + beatIndex * beatInterval;\n}\n\nfunction playSound(freq, dur){\nif(!audioCtx) return;\nconst osc = audioCtx.createOscillator();\nconst gain = audioCtx.createGain();\nosc.type = 'sine';\nosc.frequency.setValueAtTime(freq, audioCtx.currentTime);\ngain.gain.setValueAtTime(0, audioCtx.currentTime);\ngain.gain.linearRampToValueAtTime(0.001, audioCtx.currentTime + 0.01);\ngain.gain.linearRampToValueAtTime(0, audioCtx.currentTime + dur);\nosc.connect(gain);\ngain.connect(audioCtx.destination);\nosc.start();\nosc.stop(audioCtx.currentTime + dur);\n}\n\nfunction render(){\nctx.clearRect(0,0,BASE_W,BASE_H);\n// background gradient\nconst grad = ctx.createLinearGradient(0,0,0,BASE_H);\ngrad.addColorStop(0,'#0a0a0a');\ngrad.addColorStop(1,'#1a1a1a');\nctx.fillStyle = grad;\nctx.fillRect(0,0,BASE_W,BASE_H);\n\n// platforms\nplatforms.forEach(p=>{\nctx.fillStyle = '#0f0';\nctx.fillRect(p.x, groundY - p.h, p.w, p.h);\nctx.strokeStyle = '#0f0';\nctx.lineWidth = 2;\nctx.strokeRect(p.x, groundY - p.h, p.w, p.h);\n});\n\n// player\nctx.fillStyle = '#0ff';\nctx.beginPath();\nctx.arc(player.x, player.y, player.radius, 0, Math.PI*2);\nctx.fill();\nctx.strokeStyle = '#fff';\nctx.lineWidth = 2;\nctx.stroke();\n\n// beat cue line\nif(audioCtx){\nconst now = audioCtx.currentTime;\nconst beatTime = getCurrentBeatTime();\nconst cueTime = beatTime - 0.5*beatInterval;\nconst timeToCue = cueTime - now;\nif(timeToCue >= 0 && timeToCue <= 0.5*beatInterval){\nconst 