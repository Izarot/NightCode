```css
* { margin: 0; padding: 0; box-sizing: border-box; }

body {
  background: #0a0a12;
  overflow: hidden;
  font-family: 'Courier New', monospace;
  color: #00FFFF;
}

#game-container {
  position: relative;
  width: 100vw;
  height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #0a0a12;
}

#game-canvas {
  max-width: 100%;
  max-height: 100%;
  width: auto;
  height: auto;
  aspect-ratio: 16/9;
  background: #0a0a12;
  border: 2px solid #1a1a2e;
  box-shadow: 0 0 40px rgba(0, 255, 255, 0.15);
  image-rendering: crisp-edges;
}

/* HUD */
#hud {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 10;
}

/* Health Bar */
#health-container {
  position: absolute;
  top: 20px;
  left: 20px;
  width: 24px;
  height: 200px;
  background: rgba(10, 10, 18, 0.6);
  backdrop-filter: blur(4px);
  border: 1px solid rgba(0, 255, 255, 0.3);
  border-radius: 4px;
  overflow: hidden;
  transform-origin: bottom;
}

#health-bar {
  width: 100%;
  height: 100%;
  background: linear-gradient(to top, #ff0040, #00ff80);
  transform: scaleX(1);
  transition: transform 0.2s ease;
}

#health-label {
  position: absolute;
  bottom: -20px;
  left: 0;
  font-size: 10px;
  color: #00FFFF;
  text-shadow: 0 0 4px #00FFFF;
}

/* Sword Meter */
#sword-meter {
  position: absolute;
  bottom: 20px;
  left: 50%;
  transform: translateX(-50%);
  width: 80px;
  height: 80px;
}

#sword-ring {
  width: 100%;
  height: 100%;
}

#sword-fill {
  transition: stroke-dashoffset 0.1s linear;
  stroke: #00FFFF;
  filter: drop-shadow(0 0 4px #00FFFF);
}

/* Score */
#score-container {
  position: absolute;
  top: 20px;
  right: 20px;
  text-align: right;
}

#score {
  font-size: 32px;
  font-weight: bold;
  color: #FF00FF;
  text-shadow: 0 0 10px #FF00FF;
  font-family: 'Courier New', monospace;
}

#combo {
  font-size: 18px;
  color: #FFFF00;
  text-shadow: 0 0 8px #FFFF00;
  margin-top: 4px;
  opacity: 0;
  transform: scale(1);
  transition: transform 0.1s, opacity 0.3s;
}

#combo.active {
  animation: comboPop 0.4s ease;
}

@keyframes comboPop {
  0% { transform: scale(1); opacity: 0; }
  30% { transform: scale(1.2); opacity: 1; }
  100% { transform: scale(1); opacity: 0; }
}

/* Timer */
#timer {
  position: absolute;
  top: 20px;
  left: 50%;
  transform: translateX(-50%);
  font-size: 20px;
  color: #00FFFF;
  text-shadow: 0 0 6px #00FFFF;
  font-family: 'Courier New', monospace;
}

/* High Score */
#highscore {
  position: absolute;
  bottom: 110px;
  right: 20px;
  font-size: 14px;
  color: #FF4500;
  text-shadow: 0 0 4px #FF4500;
  font-family: 'Courier New', monospace;
}

/* Floating Texts */
#floating-texts {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 20;
}

.float-text {
  position: absolute;
  font-size: 24px;
  font-weight: bold;
  color: #FFFF00;
  text-shadow: 0 0 10px #FFFF00, 0 0 20px #FFFF00;
  font-family: 'Courier New', monospace;
  pointer-events: none;
  animation: floatUp 0.8s ease-out forwards;
}

@keyframes floatUp {
  0% { transform: translate(-50%, 0) scale(0.5); opacity: 0; }
  20% { transform: translate(-50%, -10px) scale(1.3); opacity: 1; }
  100% { transform: translate(-50%, -60px) scale(1); opacity: 0; }
}

/* Start/Game Over Screens */
#start-screen, #game-over-screen {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: rgba(10, 10, 18, 0.9);
  backdrop-filter: blur(8px);
  z-index: 30;
  pointer-events: auto;
}

#start-screen h1, #game-over-screen h1 {
  font-size: 64px;
  color: #00FFFF;
  text-shadow: 0 0 20px #00FFFF, 0 0 40px #00FFFF;
  letter-spacing: 8px;
  margin-bottom: 20px;
}

#start-screen p, #game-over-screen p {
  color: #FF4500;
  font-size: 16px;
  margin: 4px 0;
  text-align: center;
}

#start-btn, #restart-btn {
  margin-top: 30px;
  padding: 14px 40px;
  font-size: 20px;
  font-family: 'Courier New', monospace;
  font-weight: bold;
  color: #00FFFF;
  background: transparent;
  border: 2px solid #00FFFF;
  border-radius: 4px;
  cursor: pointer;
  text-shadow: 0 0 8px #00FFFF;
  transition: all 0.2s;
}

#start-btn:hover, #restart-btn:hover {
  background: rgba(0, 255, 255, 0.1);
  box-shadow: 0 0 20px rgba(0, 255, 255, 0.3);
}

.hidden { display: none !important; }

/* Screen Shake */
@keyframes shake {
  0%, 100% { transform: translate(0, 0); }
  20% { transform: translate(-4px, 2px); }
  40% { transform: translate(4px, -2px); }
  60% { transform: translate(-3px, -1px); }
  80% { transform: translate(3px, 1px); }
}

#game-container.shake {
  animation: shake 0.15s ease;
}

/* Responsive */
@media (max-width: 768px) {
  #health-container { height: 140px; }
  #score { font-size: 24px; }
  #timer { font-size: 16px; }
  #start-screen h1 { font-size: 40px; }
}
```

