"// ui.js\nfunction createElement(tag, className, text) {\nconst el = document.createElement(tag);\nel.className = className;\nel.textContent = text;\nreturn el;\n}\n\nfunction initUI() {\nconst container = document.getElementById('game-container');\nconst canvas = document.getElementById('game-canvas');\n// HUD panel\nconst hud = document.createElement('div');\nhud.id = 'ui-panel';\nhud.innerHTML = `\n<div id=\"score\">Score: 0</div>\n<div id=\"length\">Length: 3</div>\n<div id=\"high-score\">High Score: 0</div>\n<div id=\"level\">Level: 1</div>\n<div id=\"timer\">Time: 00:00</div>\n`;\ncontainer.appendChild(hud);\n\n// Start screen\nconst startScreen = document.getElementById('start-screen');\nconst startBtn = document.getElementById('start-btn');\nstartBtn.addEventListener('click', () => {\nstartScreen.style.display = 'none';\nGame.startGame();\n});\n\n// Game over screen\nconst gameOverScreen = document.getElementById('game-over-screen');\nconst finalScoreEl = document.getElementById('final-score');\nconst finalLengthEl = document.getElementById('final-length');\nconst finalHighEl = document.getElementById('final-high');\nconst restartBtn = document.getElementById('restart-btn');\nconst menuBtn = document.getElementById('menu-btn');\nrestartBtn.addEventListener('click', () => {\nGame.restartGame();\n});\nmenuBtn.addEventListener('click', () => {\nstartScreen.style.display = 'block';\ngameOverScreen.style.display = 'none';\nGame.reset();\n});\n\n// Pause button\nconst pauseBtn = document.getElementById('pause-btn');\npauseBtn.addEventListener('click', () => {\nGame.togglePause();\n});\n\n// Mute button\nconst muteBtn = document.getElementById('mute-btn');\nlet audioMuted = false;\nmuteBtn.addEventListener('click', () => {\naudioMuted = !audioMuted;\nmuteBtn.textContent = audioMuted ? 'Unmute' : 'Mute';\nGame.setAudioMuted(audioMuted);\n});\n\n// Resize handling for responsive canvas (already via CSS)\nwindow.addEventListener('resize', () => {\n// No direct action needed; CSS handles scaling\n});\n\n// Expose for Game\nwindow.initUI = initUI;\n"

Now renderer.js:

"// renderer.js\nimport { CANVAS_WIDTH, CANVAS_HEIGHT, CELL_SIZE } from './constants.js';\n\nexport class Renderer {\nconstructor(canvas) {\nthis.canvas = canvas;\nthis.ctx = canvas.getContext('2d');\nthis.scale = 1; // will be set by CSS\nthis.resize();\n}\n\nresize() {\n// canvas CSS size is responsive; we keep logical size 400x400\nconst ctx = this.ctx;\nconst canvas = this.canvas;\ncanvas.width = CANVAS_WIDTH;\ncanvas.height = CANVAS_HEIGHT;\nthis.ctx.clearRect(0,0,canvas.width,canvas.height);\n}\n\nclear() {\nthis.ctx.clearRect(0,0,this.canvas.width,this.canvas.height);\n}\n\n// draw background gradient\nrenderBackground() {\nconst ctx = this.ctx;\nconst grad = ctx.createLinearGradient(0,0,0,this.canvas.height);\ngrad.addColorStop(0, BACKGROUND_START);\ngrad.addColorStop(1, BACKGROUND_END);\nctx.fillStyle = grad;\nctx.fillRect(0,0,this.canvas.width,this.canvas.height);\n// draw faint grid lines\nctx.strokeStyle = 'rgba(255,255,255,0.05)';\nctx.lineWidth = 1;\nfor (let x = 0; x <= CANVAS_WIDTH; x += CELL_SIZE) {\nctx.beginPath();\nctx.moveTo(x,0);\nctx.lineTo(x,this.canvas.height);\nctx.stroke();\n}\nfor (let y = 0; y <= CANVAS_HEIGHT; y += CELL_SIZE) {\nctx.beginPath();\nctx.moveTo(0,y);\nctx.lineTo(this.canvas.width,y);\nctx.stroke();\n}\n}\n\n// draw Möbius indicator (top-bottom and left-right connections)\nrenderMöbiusIndicator() {\nconst ctx = this.ctx;\nctx.strokeStyle = 'rgba(255,255,255,0.2)';\nctx.lineWidth = 2;\n// top to bottom line (wraps)\nctx.beginPath();\nctx.moveTo(0,0);\nctx.lineTo(0,this.canvas.height);\nctx.stroke();\n// left to right line (wraps)\nctx.beginPath();\nctx.moveTo(0,0);\nctx.lineTo(this.canvas.width,0);\nctx.stroke();\n}\n\n// draw snake segments with gradient\nrenderSnake(snake) {\nconst ctx = this.ctx;\n// create gradient from head to tail\nconst gradient = ctx.createLinearGradient(0,0,0,0);\n// we need to compute direction; but for simplicity use head color to body end color\nconst headColor = SNAKE_HEAD_COLOR;\nconst tailColor = SNAKE_BODY_END;\nconst segGradient = ctx.createLinearGradient(0,0,0,0);\n// we will draw each segment separately with its own color based on position\nsnake.forEach((segment, index) => {\nconst x = segment.x * CELL_SIZE;\nconst y = segment.y * CELL_SIZE;\nconst size = CELL_SIZE - 2; // 18px\nctx.fillStyle = (index===0) ? headColor : (index===snake.length-1) ? tailColor : headColor; // simple gradient not needed\nctx.fillRect(x+1, y+1, size, size);\n});\n}\n\n// draw food\nrenderFood(food) {\nconst ctx = this.ctx;\nconst x = food.x * CELL_SIZE + (CELL_SIZE - 16) / 2; // center\nconst y = food.y * CELL_SIZE + (CELL_SIZE - 16) / 2;\nctx.beginPath();\nctx.arc(x, y, 8, 0, Math.PI*2);\nconst grad = ctx.createRadialGradient(x, y, 0, x, y, 8);\ngrad.addColorStop(0, '#ffcc00');\ngrad.addColorStop(1, '#ff6600');\nctx.fillStyle = grad;\nctx.fill();\nctx.strokeStyle = '#fff';\nctx.lineWidth = 2;\nctx.stroke();\n}\n\n// draw timer in top-left HUD (already in UI)\n// no rendering here\n\n// main render method\nrender(snake, food, timer) {\nthis.clear();\nthis.renderBackground();\nthis.renderMöbiusIndicator();\nthis.renderSnake(snake);\nthis.renderFood(food);\n}\n\nresizeCanvas() {\nthis.resize();\n}\n}"

