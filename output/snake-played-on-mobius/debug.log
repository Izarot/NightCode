"// constants.js\nconst GRID_SIZE = 20; // 20x20 cells\nconst CELL_SIZE = 20; // 20px per cell\nconst CANVAS_WIDTH = 400; // logical size\nconst CANVAS_HEIGHT = 400; // logical size\nconst BASE_TICK_MS = 120; // base tick interval\nconst TICK_DECREMENT = 10; // per level\nconst MIN_TICK_MS = 60; // minimum tick\nconst SNAKE_HEAD_COLOR = '#00ffcc'; // vibrant cyan\nconst SNAKE_BODY_START = '#00ffcc'; // same as head\nconst SNAKE_BODY_END = '#006666'; // darker teal\nconst FOOD_COLOR = '#ff6600'; // bright orange\nconst BACKGROUND_START = '#111'; // dark\nconst BACKGROUND_END = '#222'; // slightly lighter\nconst HIGH_SCORE_KEY = 'snakeHighScore';\nconst SPEEDUP_PER_TICK = 10; // ms less per level\nconst FOOD_SCORE = 10;\nconst BONUS_LENGTH = 20; // bonus at multiples of 20 length\nconst AUDIO_BEEP_FREQ = 440; // A4\nconst AUDIO_DEATH_FREQ = 220; // low A3\n"

Now input.js:

"// input.js\nconst KEY_MAP = {\nArrowUp: {x:0, y:-1},\nArrowDown: {x:0, y:1},\nArrowLeft: {x:-1, y:0},\nArrowRight: {x:1, y:0},\nw: {x:0, y:-1},\nd: {x:1, y:0},\na: {x:-1, y:0},\ns: {x:0, y:1}\n};\nlet nextDirection = null; // buffered direction\nlet lastDirection = {x:1, y:0}; // initial direction right\n\nfunction handleKeyDown(e) {\nconst key = e.key;\nif (KEY_MAP[key]) {\nconst dir = KEY_MAP[key];\n// prevent reverse (180 degree)\nif (!(nextDirection && nextDirection.x === -lastDirection.x && nextDirection.y === -lastDirection.y)) {\nnextDirection = dir;\n}\n}\n// special keys\nif (e.key === 'p' || e.key === 'P') {\nwindow.dispatchEvent(new CustomEvent('pause'));\n}\nif (e.key === 'r' || e.key === 'R') {\nwindow.dispatchEvent(new CustomEvent('restart'));\n}\nif (e.key === 'm' || e.key === 'M') {\nwindow.dispatchEvent(new CustomEvent('mute'));\n}\n}\n\n// Listen for keydown on window\nwindow.addEventListener('keydown', handleKeyDown);\n\n// Expose for Game class\nwindow.nextDirection = nextDirection;\nwindow.lastDirection = lastDirection;\n\nfunction resetDirection() {\nnextDirection = null;\nlastDirection = {x:1, y:0};\n}\n\nwindow.resetDirection = resetDirection;\n"

