Now main.js:

"// main.js\nimport { Renderer } from './renderer.js';\nimport { Input } from './input.js';\nimport { UI } from './ui.js';\nimport { constants } from './constants.js';\n\nexport class Game {\nconstructor() {\nthis.state = 'menu';\nthis.snake = [];\nthis.food = null;\nthis.direction = {x:1, y:0};\nthis.nextDirection = {x:1, y:0};\nthis.ticks = 0;\nthis.tickTimer = 0;\nthis.lastTick = 0;\nthis.score = 0;\nthis.length = 3;\nthis.level = 1;\nthis.highScore = parseInt(localStorage.getItem(constants.HIGH_SCORE_KEY)) || 0;\nthis.paused = false;\nthis.audioMuted = false;\nthis.audioContext = null;\nthis.canonical = null; // for timer\nthis.renderer = new Renderer(document.getElementById('game-canvas'));\nUI.initUI();\nthis.bindUIEvents();\n}\n\nbindUIEvents() {\nwindow.addEventListener('keydown', e => {\nif (e.key in Input.KEY_MAP) {\nInput.handleKeyDown(e);\n}\n});\nwindow.addEventListener('pause', () => this.togglePause());\nwindow.addEventListener('restart', () => this.restartGame());\nwindow.addEventListener('mute', () => {\nthis.audioMuted = !this.audioMuted;\nthis.muteBtn.textContent = this.audioMuted ? 'Unmute' : 'Mute';\n});\n}\n\nstartGame() {\nthis.state = 'playing';\nthis.resetGame();\nthis.tickTimer = 0;\nthis.lastTick = performance.now();\nrequestAnimationFrame(this.loop.bind(this));\n}\n\nresetGame() {\nthis.snake = [{x:10, y:10}, {x:9, y:10}, {x:8, y:10}]; // length 3, head at (10,10) moving right\nthis.direction = {x:1, y:0};\nthis.nextDirection = {x:1, y:0};\nthis.score = 0;\nthis.length = 3;\nthis.level = 1;\nthis.ticks = 0;\nthis.food = this.generateFood();\nthis.updateHighScore();\n}\n\nupdateHighScore() {\nif (this.score > this.highScore) {\nthis.highScore = this.score;\nlocalStorage.setItem(constants.HIGH_SCORE_KEY, this.highScore);\n}\ndocument.getElementById('high-score').textContent = `High Score: ${this.highScore}`;\n}\n\ntogglePause() {\nthis.paused = !this.paused;\ndocument.getElementById('pause-btn').textContent = this.paused ? 'Resume' : 'Pause';\n}\n\nsetAudioMuted(muted) {\nthis.audioMuted = muted;\n}\n\nrestartGame() {\nthis.state = 'menu';\nthis.resetGame();\nthis.startScreen();\n}\n\nstartScreen() {\ndocument.getElementById('start-screen').style.display = 'block';\ndocument.getElementById('game-over-screen').style.display = 'none';\n}\n\nreset() {\nthis.state = 'menu';\nthis.resetGame();\nthis.startScreen();\n}\n\n// generate food on free cell\ngenerateFood() {\nlet x, y;\nlet freeCells = [];\nfor (let i = 0; i < constants.GRID_SIZE; i++) {\nfor (let j = 0; j < constants.GRID_SIZE; j++) {\nconst occupied = this.snake.some(seg => seg.x === i && seg.y === j);\nif (!occupied) freeCells.push({x:i, y:j});\n}\n}\nif (freeCells.length === 0) return null;\nconst idx = Math.floor(Math.random() * freeCells.length);\nconst cell = freeCells[idx];\nreturn {x:cell.x, y:cell.y};\n}\n\n// game loop with fixed timestep\nloop(timestamp) {\nif (!this.paused) {\nconst delta = timestamp - this.lastTick;\nthis.lastTick = timestamp;\nthis.tickTimer += delta;\nconst tickInterval = Math.max(constants.MIN_TICK_MS, constants.BASE_TICK_MS - (this.level-1)*constants.TICK_DECREMENT);\nwhile (this.tickTimer >= tickInterval) {\nthis.tick();\nthis.tickTimer -= tickInterval;\n}\n}\nrequestAnimationFrame(this.loop.bind(this));\n}\n\n tick() {\n// apply buffered direction\nthis.direction = this.nextDirection;\n// compute next head position with wrapping\nconst head = this.snake[0];\nconst newX = (head.x + this.direction.x + constants.GRID_SIZE) % constants.GRID_SIZE;\nconst newY = (head.y + this.direction.y + constants.GRID_SIZE) % constants.GRID_SIZE;\nconst newHead = {x:newX, y:newY};\n\n// check self collision (excluding tail if it moves away)\nconst willMoveTail = this.snake.length > 1 && (this.snake[1].x === head.x && this.snake[1].y === head.y);\nlet collision = false;\nfor (let i = 0; i < this.snake.length; i++) {\nif (i===0) continue; // skip head\nif (i===1 && willMoveTail) continue; // tail will move, so not collide\nif (this.snake[i].x === newHead.x && this.snake[i].y === newHead.y) {\ncollision = true;\nbreak;\n}\n}\nif (collision) {\nthis.gameOver();\nreturn;\n}\n\n// add new head\nthis.snake.unshift(newHead);\n\n// check food\nif (newHead.x === this.food.x && newHead.y === this.food.y) {\nthis.score += constants.FOOD_SCORE;\nif (this.length % constants.BONUS_LENGTH === 0) {\nthis.score += 50; // bonus\n}\nthis.length++;\nthis.ticks = 0; // reset tick counter for level up?\nthis.level = Math.floor(this.length / constants.BONUS_LENGTH) + 1;\n// speed up: decrease tick interval\nthis.tickTimer = 0; // ensure next tick uses new interval\nthis.food = this.generateFood();\nthis.renderer.renderSnake(this.snake);\nthis.updateHUD();\n// play eat sound\nthis.playBeep();\n}\n\n// move tail (remove last if not growing)\nif (this.snake.length !== this.length) {\nthis.snake.pop();\n}\n\n// update HUD\nthis.updateHUD();\nthis.lastTick = performance.now();\n}\n\nupdateHUD() {\nconst scoreEl = document.getElementById('score');\nconst lengthEl = document.getElementById('length');\nconst levelEl = document.getElementById('level');\nconst timerEl = document.getElementById('timer');\nscoreEl.textContent = `Score: ${this.score}`;\nlengthEl.textContent = `Length: ${this.length}`;\nlevelEl.textContent = `Level: ${this.level}`;\nconst seconds = Math.floor(this.canonical ? this.canonical / 1000 : 0);\nconst mins = Math.floor(seconds / 60);\nconst secs = seconds % 60;\n timerEl.textContent = `Time: ${mins.toString().padStart(2,'0')}:${secs.toString().padStart(2,'0')}`;\n}\n\n// game over\n gameOver() {\nthis.state = 'gameover';\nconst finalScoreEl = document.getElementById('final-score');\nconst finalLengthEl = document.getElementById('final-length');\nconst finalHighEl = document.getElementById('final-high');\nfinalScoreEl.textContent = this.score;\nfinalLengthEl.textContent = this.length;\nfinalHighEl.textContent = this.highScore;\ndocument.getElementById('game-over-screen').style.display = 'block';\n}\n\n// audio helpers\nplayBeep() {\nif (this.audioMuted) return;\nif (!this.audioContext) {\nthis.audioContext = new (window.AudioContext || window.webkitAudioContext)();\n}\nconst osc = this.audioContext.createOscillator();\nosc.type = 'sine';\nosc.frequency.value = constants.AUDIO_BEEP_FREQ;\nconst gain = this.audioContext.createGain();\ngain.gain.value = 0.2;\nosc.connect(gain);\ngain.connect(this.audioContext.destination);\nosc.start();\nosc.stop(this.audioContext.currentTime + 0.2);\n}\n\nplayDeathSound() {\nif (this.audioMuted) return;\nif (!this.audioContext) {\nthis.audioContext = new (window.AudioContext || window.webkitAudioContext)();\n}\nconst osc = this.audioContext.createOscillator();\nosc.type = 'sine';\nosc.frequency.value = constants.AUDIO_DEATH_FREQ;\nconst gain = this.audioContext.createGain();\ngain.gain.value = 0.5;\nosc.connect(gain);\ngain.connect(this.audioContext.destination);\nosc.start();\nosc.stop(this.audioContext.currentTime + 0.5);\n}\n\n// cleanup on game over\nresetAudio() {\nif (this.audioContext) {\nthis.audioContext.close();\nthis.audioContext = null;\n}\n}\n\n// main loop\nloop(timestamp) {\nif (this.state === 'playing') {\nthis.tick();\n}\nthis.renderer.render(this.snake, this.food, this.canonical);\nrequestAnimationFrame(this.loop.bind(this));\n}\n}\n\n// initialize\nwindow.addEventListener('load', () => {\nconst game = new Game();\n});\n"

