oMuted = false;\nmuteBtn.addEventListener('click', () => {\naudioMuted = !audioMuted;\nmuteBtn.textContent = audioMuted ? 'Unmute' : 'Mute';\nGame.setAudioMuted(audioMuted);\n});\n\n// Resize handling for responsive canvas (already via CSS)\nwindow.addEventListener('resize', () => {\n// No direct action needed; CSS handles scaling\n});\n\n// Expose for Game\nwindow.initUI = initUI;\nwindow.scoreEl = scoreEl;\nwindow.lengthEl = lengthEl;\nwindow.highScoreEl = highScoreEl;\nwindow.levelEl = levelEl;\nwindow.timerEl = timerEl;\nwindow.pauseBtn = pauseBtn;\nwindow.muteBtn = muteBtn;\n"

