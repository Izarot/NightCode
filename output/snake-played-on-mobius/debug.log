"/* style.css */\nbody { margin:0; font-family:Arial, sans-serif; background:#111; color:#fff; }\n#game-container { position:relative; width:100%; max-width:400px; margin:0 auto; }\n#game-canvas { display:block; width:100%; height:auto; background:#111; }\n#hud { position:absolute; top:0; left:0; right:0; padding:5px; background:rgba(0,0,0,0.5); color:#fff; font-size:14px; }\n#start-screen, #game-over-screen { text-align:center; margin-top:30px; }\n#ui-panel { position:absolute; top:5px; left:5px; background:rgba(0,0,0,0.5); padding:5px; border-radius:4px; }\n#controls { position:absolute; bottom:5px; right:5px; display:flex; gap:5px; }\nbutton { background:#00ffcc; color:#111; border:none; padding:8px 12px; border-radius:4px; cursor:pointer; font-size:14px; }\nbutton:hover { background:#00ccaa; }\n/* responsive scaling */\n@media (max-width: 600px) {\n#game-canvas { max-width:100vw; }\n#ui-panel, #controls { font-size:13px; }\nbutton { padding:6px 10px; font-size:13px; }\n}"

