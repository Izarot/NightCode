            document.getElementById('timer-display').textContent = '60';
            updateHUD();
        }

        // --- Main Game Loop ---
        function gameLoop(currentTime) {
            if (isPaused || isGameOver) return;
            
            const dt = currentTime - lastFrameTime;
            lastFrameTime = currentTime;
            
            // Update timer
            if (timerSeconds > 0) {
                timerSeconds--;
                updateTimerDisplay();
                if (timerSeconds <= 0) {
                    timerSeconds = 60;
                    playSound('square', 500);
                }
            }
            
            // Handle projectile lifetime
            for (let i = projectiles.length - 1; i >= 0; i--) {
                if (projectiles[i].life <= 0) {
                    projectiles.splice(i, 1);
                }
            }
            
            // Update shapes (falling)
            for (let i = shapes.length - 1; i >= 0; i--) {
                const shape = shapes[i];
                if (!shape.visible) continue;
                
                // Move shape down
                shape.y += CONFIG.baseSpeed * 0.015; // adjusted for frame rate
                
                // Check if reached ground
                if (shape.y + shape.h/2 >= height - 20) {
                    shape.visible = false;
                    // Could trigger bonus here
                }
            }
            
            // Collision detection
            checkCollisions();
            
            // Update particles
            for (let i = particles.length - 1; i >= 0; i--) {
                const p = particles[i];
                p.x += p.vx;
                p.y += p.vy;
                p.life -= p.decay;
                if (p.life <= 0) {
                    particles.splice(i, 1);
                }
            }
            
            // Update ammo
            if (charge < CONFIG.chargeCapacity) {
                chargeTimer++;
                if (chargeTimer >= CONFIG.chargeCapacity) {
                    charge = CONFIG.chargeCapacity;
                    chargeTimer = 0;
                    updateHUD();
                }
            }
            
            // Draw everything
            draw();
            
            requestAnimationFrame(gameLoop);
        }

        function draw() {
            // Clear canvas
            ctx.clearRect(0, 0, width, height);
            
            // Background gradient
            const grad = ctx.createLinearGradient(0, 0, 0, height);
            grad.addColorStop(0, '#1a1a2e');
            grad.addColorStop(1, '#16213e');
            ctx.fillStyle = grad;
            ctx.fillRect(0, 0, width, height);
            
            // Clouds (background decoration)
            drawClouds();
            
            // Shapes
            for (const shape of shapes) {
                if (!shape.visible) continue;
                
                // Shadow
                ctx.beginPath();
                ctx.ellipse(shape.x + shape.w/2, shape.y + shape.h/2, shape.w/2, shape.h/2, 0, 0, Math.PI * 2);
                ctx.fillStyle = 'rgba(0,0,0,0.3)';
                ctx.fill();
                
                // Main shape
                ctx.beginPath();
                if (shape.type === 'circle') {
                    ctx.arc(shape.x, shape.y, shape.w/2, 0, Math.PI * 2);
                } else if (shape.type === 'square') {
                    ctx.rect(shape.x, shape.y, shape.w, shape.h);
                } else if (shape.type === 'triangle') {
                    ctx.moveTo(shape.x, shape.y - shape.h/2);
                    ctx.lineTo(shape.x + shape.w, shape.y);
                    ctx.lineTo(shape.x, shape.y + shape.h/2);
                    ctx.closePath();
                } else if (shape.type === 'hexagon') {
                    const r = shape.w / 2;
                    for (let i = 0; i < 6; i++) {
                        const angle = (i * Math.PI / 3) - Math.PI / 6;
                        ctx.lineTo(
                            shape.x + Math.cos(angle) * r,
                            shape.y + Math.sin(angle) * r
                        );
                    }
                    ctx.closePath();
                } else if (shape.type === 'star') {
                    const r = shape.w / 2;
                    ctx.beginPath();
                    for (let i = 0; i < 10; i++) {
                        const angle = (i * Math.PI / 5) - Math.PI / 2;
                        const rad = Math.sqrt(Math.pow(r, 2) + Math.pow(Math.sin(angle), 2));
                        ctx.lineTo(
                            shape.x + Math.cos(angle) * rad,
                            shape.y + Math.sin(angle) * rad
                        );
                    }
                    ctx.closePath();
                }
                
                // Fill with target color
                ctx.fillStyle = shape.color;
                ctx.shadowColor = shape.color;
                ctx.shadowBlur = 8;
                ctx.fill();
                
                // Border
                ctx.strokeStyle = 'rgba(255,255,255,0.4)';
                ctx.lineWidth = 2;
