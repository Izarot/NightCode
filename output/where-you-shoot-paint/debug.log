                ctx.fillStyle = p.color;
                ctx.beginPath();
                for (let i = 0; i < p.count; i++) {
                    const angle = (i / p.count) * Math.PI * 2;
                    const dist = p.life * 15;
                    const rx = p.x + Math.cos(angle) * dist;
                    const ry = p.y + Math.sin(angle) * dist;
                    if (i === 0) ctx.moveTo(rx, ry);
                    else ctx.lineTo(rx, ry);
                }
                ctx.closePath();
                ctx.fill();
            }
            ctx.globalAlpha = 1;
            
            // Powerups
            for (const pu of powerups) {
                if (pu.active) {
                    ctx.fillStyle = pu.color;
                    ctx.shadowColor = pu.color;
                    ctx.shadowBlur = 12;
                    ctx.beginPath();
                    ctx.arc(pu.x, pu.y, 12, 0, Math.PI * 2);
                    ctx.fill();
                    ctx.shadowBlur = 0;
                }
            }
        }

        function drawClouds() {
            // Simple cloud shapes generated procedurally
            const cloudCount = 3;
            for (let c = 0; c < cloudCount; c++) {
                const cx = (c * 150 + Math.sin(Date.now() * 0.005 + c) * 50) % (width + 200);
                const cy = 80 + Math.random() * 120;
                const size = 40 + Math.random() * 30;
                
                ctx.fillStyle = 'rgba(255,255,255,0.15)';
                ctx.beginPath();
                // Two overlapping circles for cloud look
                ctx.arc(cx - size*0.8, cy - 5, size*1.2, 0, Math.PI*2);
                ctx.arc(cx + size*0.7, cy + 5, size*1.2, 0, Math.PI*2);
                ctx.fill();
            }
        }

        // --- Initialization ---
        init();
        requestAnimationFrame(gameLoop);
    </script>
</body>
</html>
```

This implementation includes all the requested features:

1. **Responsive Canvas**: The canvas dynamically resizes with `resizeCanvas()` using CSS scaling and maintains a logical 800×600 grid. It adapts to mobile screens with a minimum of 320×480.

2. **Emoji Favicon**: An SVG-based favicon (🎨) is embedded directly in the HTML `<head>` via a data URI link.

3. **Unique Color Palette**: 12 vibrant, saturated colors defined in `COLOR_PALETTE` array (orange, yellow, green, teal, pink, coral, cyan, magenta, emerald, terracotta, golden, lime).

4. **LocalStorage High Score**: The `highScore` is saved to `localStorage` upon game over and loaded on startup. The best score is displayed on the game over screen.

5. **Web Audio API Sounds**: 
   - `whooshSound()` plays on projectile release
   - `popSound()` plays on successful shape hit
   - `sparkleSound()` plays on splash effects
   - Uses oscillators with exponential ramp-out for realistic sound effects

6. **Speedrun Timer**: A top-right timer counts down from 60 seconds, updating every frame. Displays remaining time in M:SS format.

Additional features implemented:
- Player-controlled paint can with A/D or touch controls
- Projectile shooting with charge system
- Falling shapes (circle, square, triangle, hexagon, star) with target color hints
- Scoring system (10 points per correct hit, bonus for rainbow paint)
- Lives system (3 lives, loses on missing shapes)
- Power-ups (rainbow paint, speed boost, shield)
- Particle effects on hits and shots
- Responsive design with mobile-friendly touch controls

The game loops continuously with proper collision detection, particle rendering, and timer management.}