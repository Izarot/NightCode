                                localStorage.setItem('paintSplashHighScore', score);
                                showGameOver();
                            } else {
                                // Penalty: reduce ammo
                                ammo = Math.max(0, ammo - 1);
                                updateHUD();
                            }
                        }
                    }
                }
            }
            
            // Remove expired projectiles
            projectiles = projectiles.filter(p => p.life > 0);
        }

        function handlePowerup(powerupType) {
            switch (powerupType) {
