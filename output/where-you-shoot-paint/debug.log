        // --- Canvas Setup (Responsive) ---
        function resizeCanvas() {
            const container = document.getElementById(CONTAINER_ID);
            if (!container) return;
            
            // Logical resolution
            const logWidth = 800;
            const logHeight = 600;
            
            // Scale factor based on device pixel ratio
            const dpr = window.devicePixelRatio || 1;
            const scale = Math.min(logWidth / width, logHeight / height, 2); // Cap max scale
            
            width = logWidth * scale;
            height = logHeight * scale;
            
            // Set actual canvas size with DPI scaling
            canvas.width = width * dpr;
            canvas.height = height * dpr;
            canvas.style.width = width + 'px';
            canvas.style.height = height + 'px';
            
            // Update internal dimensions
            width = width * dpr;
            height = height * dpr;
            
            // Recalculate derived sizes
            const containerRect = container.getBoundingClientRect();
            const safeWidth = Math.max(320, width);
            const safeHeight = Math.max(480, height);
            
            // Adjust if container is smaller than logical size
            if (width < safeWidth && height < safeHeight) {
                // Zoom out slightly
                const zoom = safeWidth / width;
                canvas.style.transform = `scale(${zoom})`;
            }
        }

