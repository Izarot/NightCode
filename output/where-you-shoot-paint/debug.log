        function createProjectile(colorIdx, speedMult) {
            const proj = {
                x: width / 2,
                y: height - 40, // Start near bottom
                vx: CONFIG.baseSpeed * speedMult,
                vy: -CONFIG.baseSpeed * speedMult,
                color: COLOR_PALETTE[colorIdx],
                life: CONFIG.projectileLife,
                charge: speedMult
            };
            projectiles.push(proj);
        }

        function spawnShape(type, colorIdx) {
            const shapesArr = ['circle', 'square', 'triangle', 'hexagon', 'star'];
            const shapeType = shapesArr[type];
            
            // Determine target color (from palette)
            const targetColorIdx = Math.floor(Math.random() * COLOR_PALETTE.length);
            const targetColor = COLOR_PALETTE[targetColorIdx];
            
            // Spawn with slight horizontal offset
            const spawnX = Math.random() * (width - 80);
            const shape = {
                x: spawnX,
                y: -50,
                w: shapeType === 'circle' ? 30 : shapeType === 'square' ? 40 : 35,
                h: shapeType === 'circle' ? 30 : shapeType === 'square' ? 40 : 30,
                type: shapeType,
                targetColor: targetColor,
                color: targetColor,
                visible: true,
                targetColorIdx: targetColorIdx,
                speed: CONFIG.baseSpeed * (1 + (charge / 100))
            };
            shapes.push(shape);
        }

        function checkCollisions() {
            // Projectile vs shapes
            for (let i = projectiles.length - 1; i >= 0; i--) {
                const proj = projectiles[i];
                if (proj.life <= 0) continue;
                
                for (let j = shapes.length - 1; j >= 0; j--) {
                    const shape = shapes[j];
                    if (!shape.visible) continue;
                    
                    // Simple AABB for shapes (simplified bounding box)
                    const pLeft = proj.x - proj.w / 2;
                    const pRight = proj.x + proj.w / 2;
                    const pTop = proj.y + proj.h / 2;
                    const pBottom = proj.y - proj.h / 2;
                    
                    const sLeft = shape.x;
                    const sRight = shape.x + shape.w;
                    const sTop = shape.y;
                    const sBottom = shape.y + shape.h;
                    
                    if (pRight > sLeft && pLeft < sRight && pBottom > sTop && pTop < sBottom) {
                        // Hit!
                        const hitColor = shape.color;
                        
                        // Check if target color matched before reaching ground
                        if (hitColor === shape.targetColor) {
                            score += 10;
                            comboMultiplier *= 1.5;
                            addParticles(shape.x, shape.y, hitColor, 12);
                            shape.visible = false;
                            // Remove projectile
                            projectiles.splice(i, 1);
                            // Spray effect
                            createProjectile(hitColorIndex, 1.5);
                            
                            // Check win condition (all shapes cleared)
                            if (shapes.length === 0) {
                                gameState = 'LEVEL_COMPLETE';
                                showLevelComplete();
                            }
                        } else {
