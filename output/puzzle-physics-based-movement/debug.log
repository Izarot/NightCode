                    ctx.shadowBlur = 0;
                    ctx.strokeStyle = 'rgba(255,255,255,0.3)';
                    ctx.lineWidth = 2;
                    ctx.strokeRect(movable.x, movable.y, movable.width, movable.height);
                });
                
                // Draw goal
                const goalPulse = Math.sin(Date.now() / 200) * 0.2 + 0.8;
                ctx.fillStyle = colors.goal;
                ctx.shadowColor = colors.goal;
                ctx.shadowBlur = 20 * goalPulse;
                ctx.fillRect(currentLevel.goal.x, currentLevel.goal.y, currentLevel.goal.width, currentLevel.goal.height);
                ctx.shadowBlur = 0;
                ctx.strokeStyle = '#fff';
                ctx.lineWidth = 3;
                ctx.strokeRect(currentLevel.goal.x, currentLevel.goal.y, currentLevel.goal.width, currentLevel.goal.height);
                
                // Goal icon (star)
                ctx.fillStyle = '#fff';
                ctx.font = "bold 24px 'Segoe UI', sans-serif";
                ctx.textAlign = 'center';
                ctx.fillText('★', currentLevel.goal.x + currentLevel.goal.width/2, currentLevel.goal.y + currentLevel.goal.height/2 + 8);
                
                // Draw player
                ctx.fillStyle = colors.player;
                ctx.shadowColor = colors.player;
                ctx.shadowBlur = 20;
                ctx.fillRect(player.x, player.y, player.width, player.height);
                ctx.shadowBlur = 0;
                
                // Player eyes
                ctx.fillStyle = '#0a0a1a';
                const eyeOffset = player.facingRight ? 5 : -5;
                ctx.fillRect(player.x + player.width/2 + eyeOffset - 8, player.y + 10, 5, 8);
                ctx.fillRect(player.x + player.width/2 + eyeOffset + 3, player.y + 10, 5, 8);
                
                // Draw particles
                particles.forEach(p => {
                    ctx.globalAlpha = p.life;
                    ctx.fillStyle = p.color;
                    ctx.beginPath();
                    ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
                    ctx.fill();
                });
                ctx.globalAlpha = 1;
                
                // HUD
                ctx.textAlign = 'left';
                drawText(`Level ${gameState.levelIndex + 1}: ${currentLevel.name}`, 20, 40, 24, colors.text, 'left');
                drawText(`Score: ${gameState.score}`, 20, 70, 18, colors.goal, 'left');
                drawText(`Time: ${Math.ceil(gameState.timer)}s`, 20, 95, 18, colors.text, 'left');
                
                // Instruction
                if (currentLevel.instruction) {
                    ctx.font = "16px 'Segoe UI', sans-serif";
                    ctx.fillStyle = 'rgba(255,255,255,0.5)';
                    ctx.textAlign = 'center';
                    ctx.fillText(currentLevel.instruction, w/2, h - 30);
                }
                
            } else if (gameState.phase === 'levelcomplete') {
                ctx.textAlign = 'center';
                ctx.font = "bold 48px 'Segoe UI', sans-serif";
                ctx.fillStyle = colors.goal;
                ctx.shadowColor = colors.goal;
                ctx.shadowBlur = 30;
                ctx.fillText('LEVEL COMPLETE!', w/2, h/2 - 40);
                ctx.shadowBlur = 0;
                
                ctx.font = "28px 'Segoe UI', sans-serif";
                ctx.fillStyle = colors.text;
                ctx.fillText(`Score: ${gameState.score}`, w/2, h/2 + 20);
                
                const pulse = Math.sin(Date.now() / 300) * 0.3 + 0.7;
                ctx.font = "bold 24px 'Segoe UI', sans-serif";
                ctx.fillStyle = `rgba(0,255,204,${pulse})`;
                ctx.fillText('Press ENTER or TAP for next level', w/2, h/2 + 80);
                
            } else if (gameState.phase === 'gameover') {
                ctx.textAlign = 'center';
                ctx.font = "bold 48px 'Segoe UI', sans-serif";
                ctx.fillStyle = '#ff4444';
                ctx.shadowColor = '#ff4444';
                ctx.shadowBlur = 30;
                ctx.fillText('GAME OVER', w/2, h/2 - 40);
                ctx.shadowBlur = 0;
                
                ctx.font = "28px 'Segoe UI', sans-serif";
                ctx.fillStyle = colors.text;
                ctx.fillText(`Final Score: ${gameState.score}`, w/2, h/2 + 20);
                
                const pulse = Math.sin(Date.now() / 300) * 0.3 + 0.7;
                ctx.font = "bold 24px 'Segoe UI', sans-serif";
                ctx.fillStyle = `rgba(255,255,255,${pulse})`;
                ctx.fillText('Press ENTER or TAP to return to menu', w/2, h/2 + 80);
                
            } else if (gameState.phase === 'gamecomplete') {
                ctx.textAlign = 'center';
                ctx.font = "bold 48px 'Segoe UI', sans-serif";
                ctx.fillStyle = colors.goal;
                ctx.shadowColor = colors.goal;
                ctx.shadowBlur = 30;
                ctx.fillText('CONGRATULATIONS!', w/2, h/2 - 60);
                ctx.shadowBlur = 0;
                
                ctx.font = "28px 'Segoe UI', sans-serif";
                ctx.fillStyle = colors.text;
                ctx.fillText('You completed all levels!', w/2, h/2 - 10);
                ctx.fillText(`Final Score: ${gameState.score}`, w/2, h/2 + 30);
                ctx.fillText(`Time: ${gameState.speedrunTime.toFixed(1)}s`, w/2, h/2 + 70);
                
                if (gameState.score >= gameState.highScore && gameState.score > 0) {
                    ctx.font = "bold 24px 'Segoe UI', sans-serif";
                    ctx.fillStyle = colors.player;
                    ctx.fillText('NEW HIGH SCORE!', w/2, h/2 + 110);
                }
                
                const pulse = Math.sin(Date.now() / 300) * 0.3 + 0.7;
                ctx.font = "bold 24px 'Segoe UI', sans-serif";
                ctx.fillStyle = `rgba(255,255,255,${pulse})`;
                ctx.fillText('Press ENTER or TAP to return to menu', w/2, h/2 + 160);
            }
            
            ctx.restore();
        }
        
        // Game loop
        let lastTime = 0;
        function gameLoop(timestamp) {
            const dt = Math.min((timestamp - lastTime) / 1000, 0.05);
            lastTime = timestamp;
            
            update(dt);
            draw();
            
            requestAnimationFrame(gameLoop);
        }
        
        requestAnimationFrame(gameLoop);
    </script>
</body>
</html>"}