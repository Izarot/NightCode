Raw: {"index.html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\" />\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, user-scalable=no\" />\n<title>Void Weaver</title>\n<link rel=\"icon\" href=\"data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🔮</text></svg>\" />\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\" />\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin />\n<link href=\"https://fonts.googleapis.com/css2?family=Orbitron:wght@400;500;700&family=Rajdhani:wght@300;500;700&display=swap\" rel=\"stylesheet\" />\n<style>\n  :root {\n    --void: #0a0e27;\n    --void-2: #11163a;\n    --cyan: #00f0ff;\n    --magenta: #ff2bd6;\n    --amber: #ffb627;\n    --lime: #a3ff3c;\n    --red: #ff3b5c;\n    --white: #e8f0ff;\n  }\n  * { box-sizing: border-box; margin: 0; padding: 0; }\n  html, body {\n    width: 100%; height: 100%;\n    background: radial-gradient(ellipse at center, #161b4a 0%, #05071a 80%);\n    overflow: hidden;\n    font-family: 'Rajdhani', sans-serif;\n    color: var(--white);\n    user-select: none;\n    -webkit-tap-highlight-color: transparent;\n  }\n  #gameWrap {\n    position: fixed;\n    inset: 0;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n  }\n  #stage {\n    position: relative;\n    width: 100%;\n    height: 100%;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n  }\n  canvas#game {\n    background: var(--void);\n    image-rendering: pixelated;\n    box-shadow: 0 0 80px rgba(0, 240, 255, 0.15), inset 0 0 60px rgba(0,0,0,0.7);\n    border: 1px solid rgba(0, 240, 255, 0.25);\n    max-width: 100vw;\n    max-height: 100vh;\n    touch-action: none;\n  }\n  #touchUI {\n    position: absolute;\n    inset: 0;\n    pointer-events: none;\n    display: none;\n  }\n  .touchStick {\n    position: absolute;\n    width: 130px; height: 130px;\n    border-radius: 50%;\n    background: rgba(0, 240, 255, 0.08);\n    border: 2px solid rgba(0, 240, 255, 0.35);\n    pointer-events: auto;\n    touch-action: none;\n  }\n  .touchKnob {\n    position: absolute;\n    left: 50%; top: 50%;\n    width: 56px; height: 56px;\n    margin: -28px 0 0 -28px;\n    border-radius: 50%;\n    background: rgba(0, 240, 255, 0.4);\n    border: 1px solid rgba(0, 240, 255, 0.6);\n  }\n  #stickMove { left: 20px; bottom: 20px; }\n  #stickAim { right: 20px; bottom: 20px; }\n  .touchBtn {\n    position: absolute;\n    width: 70px; height: 70px;\n    border-radius: 50%;\n    background: rgba(255, 43, 214, 0.2);\n    border: 2px solid rgba(255, 43, 214, 0.6);\n    color: var(--white);\n    font-family: 'Orbitron', sans-serif;\n    font-size: 14px;\n    display: flex; align-items: center; justify-content: center;\n    pointer-events: auto;\n    touch-action: none;\n  }\n  #btnFire { right: 165px; bottom: 50px; background: rgba(0, 240, 255, 0.2); border-color: var(--cyan); }\n  #btnAbsorb { right: 50px; top: 30%; background: rgba(163, 255, 60, 0.2); border-color: var(--lime); }\n  #vignette {\n    position: absolute; inset: 0;\n    pointer-events: none;\n    box-shadow: inset 0 0 0 0 rgba(255, 59, 92, 0);\n    transition: box-shadow 0.08s linear;\n  }\n  @media (max-width: 900px), (pointer: coarse) {\n    #touchUI { display: block; }\n  }\n</style>\n</head>\n<body>\n<div id=\"gameWrap\">\n  <div id=\"stage\">\n    <canvas id=\"game\" width=\"1280\" height=\"720\"></canvas>\n    <div id=\"touchUI\">\n      <div id=\"stickMove\" class=\"touchStick\"><div class=\"touchKnob\"></div></div>\n      <div id=\"stickAim\" class=\"touchStick\"><div class=\"touchKnob\"></div></div>\n      <div id=\"btnFire\" class=\"touchBtn\">FIRE</div>\n      <div id=\"btnAbsorb\" class=\"touchBtn\">E</div>\n    </div>\n    <div id=\"vignette\"></div>\n  </div>\n</div>\n<script type=\"module\" src=\"src/main.js\"></script>\n</body>\n</html>\n", "src/main.js": "// Void Weaver - main entry, state machine, game loop\nimport { Input } from './systems/InputSystem.js';\nimport { Audio } from './audio.js';\nimport { HUD } from './ui.js';\nimport { Player } from './entities/Player.js';\nimport { Enemy } from './entities/Enemy.js';\nimport { Boss } from './entities/Boss.js';\nimport { Bullet } from './entities/Bullet.js';\nimport { ParticleSystem } from './systems/ParticleSystem.js';\nimport { PATTERNS, PATTERN_LIST } from './data/patterns.js';\nimport { mulberry32 } from './data/rng.js';\n\nconst canvas = document.getElementById('game');\nconst ctx = canvas.getContext('2d');\nconst LOGICAL_W = 1280, LOGICAL_H = 720;\n\n// Responsive scaling\nfunction resize() {\n  const ratio = LOGICAL_W / LOGICAL_H;\n  let w = window.innerWidth, h = window.innerHeight;\n  let cw = w, ch = w / ratio;\n  if (ch > h) { ch = h; cw = h * ratio; }\n  canvas.style.width = cw + 'px';\n  canvas.style.height = ch + 'px';\n}\nwindow.addEventListener('resize', resize);\nresize();\n\nconst audio = new Audio();\nconst input = new Input(canvas);\nconst particles = new ParticleSystem();\nconst hud = new HUD();\n\n// Game state\nconst STATE = { MENU:'MENU', INTRO:'INTRO', PLAYING:'PLAYING', WEAVE:'WEAVE', CLEAR:'CLEAR', BOSS_INTRO:'BOSS_INTRO', WIN:'WIN', LOSE:'LOSE', PAUSE:'PAUSE', PRACTICE:'PRACTICE' };\nlet state = STATE.MENU;\nlet stateTime = 0;\nlet chamber = 0;\nconst CHAMBER_COUNTS = [5, 8, 10, 13, 15];\n\nlet player, enemies, bullets, shards, boss;\nlet weaveTimer = 0;\nlet pendingShard = null;\nlet weaveStartedAt = 0;\nlet cameraShake = 0;\nlet zoomPunch = 1;\nlet timeScale = 1;\nlet absorbedCodex = new Set();\nlet activeSlots = []; // up to 3 pattern IDs\nlet highScore = parseInt(localStorage.getItem('voidWeaverHigh') || '0', 10);\nlet speedrunStart = 0;\nlet speedrunElapsed = 0;\nlet menuSelect = 0;\nlet practiceMode = false;\n\nlet rng = mulberry32(1);\nlet enemySpawnQueue = [];\nlet spawnedThisChamber = 0;\nlet chamberCleared = false;\n\nlet lastTimestamp = performance.now();\nlet firstFrame = true;\n\nfunction reset() {\n  player = new Player(LOGICAL_W/2, LOGICAL_H/2);\n  enemies = [];\n  bullets = [];\n  shards = [];\n  boss = null;\n  activeSlots = [];\n  absorbedCodex = new Set();\n  particles.clear();\n  cameraShake = 0;\n  zoomPunch = 1;\n  timeScale = 1;\n  pendingShard = null;\n}\n\nfunction startGame() {\n  reset();\n  chamber = 0;\n  speedrunStart = performance.now();\n  speedrunElapsed = 0;\n  startChamber();\n  state = STATE.INTRO;\n  stateTime = 0;\n}\n\nfunction startChamber() {\n  stateTime = 0;\n  spawnedThisChamber = 0;\n  chamberCleared = false;\n  enemies = [];\n  rng = mulberry32((chamber + 1) * 1337 + Date.now() % 100000);\n  // Build spawn queue\n  enemySpawnQueue = [];\n  const count = CHAMBER_COUNTS[chamber];\n  for (let i = 0; i < count; i++) {\n    let archetype;\n    if (chamber === 0) archetype = 'Cinderling';\n    else if (chamber === 1) archetype = rng.next() < 0.5 ? 'Cinderling' : 'Geometer';\n    else if (chamber === 2) archetype = ['Cinderling','Geometer','HaloWraith'][Math.floor(rng.next()*3)];\n    else if (chamber === 3) archetype = ['Cinderling','Geometer','HaloWraith','Sentinel'][Math.floor(rng.next()*4)];\n    else archetype = ['Cinderling','Geometer','HaloWraith','Sentinel'][Math.floor(rng.next()*4)];\n    enemySpawnQueue.push(archetype);\n  }\n  // Wave intro brief\n  state = STATE.INTRO;\n}\n\nfunction startBoss() {\n  boss = new Boss(LOGICAL_W/2, -120);\n  state = STATE.BOSS_INTRO;\n  stateTime = 0;\n}\n\nfunction spawnEnemy(archetype) {\n  const side = Math.floor(rng.next() * 4);\n  let x, y;\n  if (side === 0) { x = rng.next()*LOGICAL_W; y = -30; }\n  else if (side === 1) { x = LOGICAL_W+30; y = rng.next()*LOGICAL_H; }\n  else if (side === 2) { x = rng.next()*LOGICAL_W; y = LOGICAL_H+30; }\n  else { x = -30; y = rng.next()*LOGICAL_H; }\n  enemies.push(new Enemy(archetype, x, y));\n  spawnedThisChamber++;\n}\n\nfunction enterWeave(shard) {\n  state = STATE.WEAVE;\n  weaveTimer = 1.5;\n  pendingShard = shard;\n  weaveStartedAt = performance.now() / 1000;\n  audio.play('weave');\n}\n\nfunction absorbShard() {\n  if (!pendingShard) return;\n  const id = pendingShard.patternId;\n  absorbedCodex.add(id);\n  if (activeSlots.length < 3) {\n    activeSlots.push(id);\n  } else {\n    activeSlots.shift();\n    activeSlots.push(id);\n  }\n  audio.playNote(absorbedCodex.size - 1);\n  audio.play('absorb');\n  particles.absorbBurst(player.x, player.y, PATTERNS[id].color);\n  zoomPunch = 1.05;\n  // lose on loss: one pattern lost\n  state = STATE.PLAYING;\n  pendingShard = null;\n  timeScale = 1;\n}\n\nfunction onEnemyKilled(enemy) {\n  particles.killBurst(enemy.x, enemy.y, enemy.color);\n  audio.play('kill');\n  const shard = { x: enemy.x, y: enemy.y, patternId: enemy.patternId, t: 0 };\n  shards.push(shard);\n  enterWeave(shard);\n}\n\nfunction damagePlayer(dmg, kbX, kbY) {\n  if (player.iframes > 0) return;\n  player.hp -= dmg;\n  player.iframes = 1.5;\n  player.knockX = kbX * 200;\n  player.knockY = kbY * 200;\n  particles.damageVignette();\n  audio.play('damage');\n  if (player.hp <= 0) {\n    loseGame();\n  }\n}\n\nfunction loseGame() {\n  state = STATE.LOSE;\n  stateTime = 0;\n  // check high score by patterns collected + chamber\n  const score = chamber * 100 + absorbedCodex.size * 50;\n  if (score > highScore) {\n    highScore = score;\n    localStorage.setItem('voidWeaverHigh', String(highScore));\n  }\n}\n\nfunction winGame() {\n  state = STATE.WIN;\n  stateTime = 0;\n  speedrunElapsed = (performance.now() - speedrunStart) / 1000;\n  const score = 1000 + Math.floor(speedrunElapsed < 1 ? 0 : 3000 / speedrunElapsed) + absorbedCodex.size * 100;\n  if (score > highScore) {\n    highScore = score;\n    localStorage.setItem('voidWeaverHigh', String(highScore));\n  }\n}\n\nfunction update(dt) {\n  input.update();\n  stateTime += dt;\n  // Speedrun timer (always ticks in play states)\n  if (state === STATE.PLAYING || state === STATE.WEAVE || state === STATE.INTRO) {\n    speedrunElapsed = (performance.now() - speedrunStart) / 1000;\n  }\n\n  // Camera shake decay\n  cameraShake = Math.max(0, cameraShake - dt * 4);\n  zoomPunch = 1 + (zoomPunch - 1) * 0.85;\n  if (Math.abs(zoomPunch - 1) < 0.001) zoomPunch = 1;\n\n  if (state === STATE.MENU) {\n    if (input.pressed('Space') || input.pressed('Enter')) {\n      if (menuSelect === 0) startGame();\n      else if (menuSelect === 1) startPractice();\n    }\n    if (input.pressed('ArrowUp') || input.pressed('KeyW')) menuSelect = (menuSelect + 2) % 3;\n    if (input.pressed('ArrowDown') || input.pressed('KeyS')) menuSelect = (menuSelect + 1) % 3;\n    return;\n  }\n\n  if (state === STATE.PRACTICE) {\n    updatePractice(dt);\n    return;\n  }\n\n  if (state === STATE.INTRO) {\n    if (stateTime > 1.8) {\n      state = STATE.PLAYING;\n      stateTime = 0;\n    }\n    return;\n  }\n\n  if (state === STATE.CLEAR) {\n    if (stateTime > 1.5) {\n      if (chamber < 4) {\n        chamber++;\n        // lose one pattern (codex persists but a slot lost)\n        if (activeSlots.length > 0) activeSlots.shift();\n        startChamber();\n      } else {\n        startBoss();\n      }\n    }\n    return;\n  }\n\n  if (state === STATE.BOSS_INTRO) {\n    if (boss.y < 140) {\n      boss.y += dt * 60;\n    } else {\n      state = STATE.PLAYING;\n      stateTime = 0;\n    }\n    return;\n  }\n\n  if (state === STATE.LOSE || state === STATE.WIN) {\n    if (stateTime > 3 && (input.pressed('Space') || input.pressed('Enter'))) {\n      state = STATE.MENU;\n      stateTime = 0;\n      menuSelect = 0;\n    }\n    return;\n  }\n\n  // Playing / Weave\n  const ts = (state === STATE.WEAVE) ? 0.4 : 1.0;\n  timeScale = ts;\n\n  // Player\n  player.update(dt, input, bullets, activeSlots, particles, audio);\n\n  // Spawn enemies (staggered)\n  if (state === STATE.PLAYING && enemySpawnQueue.length > 0) {\n    const maxAlive = chamber < 2 ? 3 : (chamber < 4 ? 4 : 5);\n    if (enemies.length < maxAlive) {\n      spawnEnemy(enemySpawnQueue.shift());\n    }\n  }\n\n  // Enemies\n  for (const e of enemies) {\n    e.update(dt * ts, player, bullets, rng);\n  }\n\n  // Boss\n  if (boss) {\n    boss.update(dt * ts, player, bullets, rng, particles);\n  }\n\n  // Bullets\n  for (let i = bullets.length - 1; i >= 0; i--) {\n    const b = bullets[i];\n    b.update(dt * ts);\n    if (b.dead) { bullets.splice(i, 1); continue; }\n  }\n\n  // Collisions\n  collideAll();\n\n  // Clean enemies that died via bullets (not via weave trigger)\n  for (let i = enemies.length - 1; i >= 0; i--) {\n    if (enemies[i].dead && !enemies[i].weaveTriggered) {\n      onEnemyKilled(enemies[i]);\n      enemies.splice(i, 1);\n    } else if (enemies[i].dead) {\n      enemies.splice(i, 1);\n    }\n  }\n  if (boss && boss.dead) {\n    particles.killBurst(boss.x, boss.y, '#ffffff');\n    boss = null;\n    state = STATE.WIN;\n    stateTime = 0;\n    audio.play('absorb');\n  }\n\n  // Shards & weave\n  for (let i = shards.length - 1; i >= 0; i--) {\n    const s = shards[i];\n    s.t += dt;\n    if (s.t > 6) { shards.splice(i, 1); continue; }\n  }\n\n  if (state === STATE.WEAVE) {\n    weaveTimer -= dt;\n    // existing bullets dim\n    for (const b of bullets) { b.weaveDim = true; }\n    if (input.pressed('KeyE') || input.touchAbsorb) {\n      // find nearest shard within range\n      let nearest = null, nd = 60*60;\n      for (const s of shards) {\n        const dx = s.x - player.x, dy = s.y - player.y;\n        const d2 = dx*dx + dy*dy;\n        if (d2 < nd) { nearest = s; nd = d2; }\n      }\n      if (nearest) {\n        pendingShard = nearest;\n        absorbShard();\n        shards = shards.filter(s => s !== nearest);\n      } else if (weaveTimer <= 0) {\n        // expire\n        state = STATE.PLAYING;\n        pendingShard = null;\n      }\n    }\n    if (weaveTimer <= 0) {\n      state = STATE.PLAYING;\n      pendingShard = null;\n    }\n  } else {\n    for (const b of bullets) { b.weaveDim = false; }\n  }\n\n  // Chamber clear check\n  if (state === STATE.PLAYING && !chamberCleared && enemySpawnQueue.length === 0 && enemies.length === 0 && !boss) {\n    chamberCleared = true;\n    state = STATE.CLEAR;\n    stateTime = 0;\n    audio.play('clear');\n  }\n\n  // Particles\n  particles.update(dt);\n}\n\nfunction collideAll() {\n  // bullets vs player\n  for (const b of bullets) {\n    if (b.dead || b.fromPlayer) continue;\n    const dx = b.x - player.x, dy = b.y - player.y;\n    const r = b.r + 12;\n    if (dx*dx + dy*dy < r*r) {\n      damagePlayer(1, b.vx, b.vy);\n      b.dead = true;\n      particles.impact(b.x, b.y, b.color);\n    }\n  }\n  // enemies body vs player\n  for (const e of enemies) {\n    const dx = e.x - player.x, dy = e.y - player.y;\n    const r = e.r + 12;\n    if (dx*dx + dy*dy < r*r) {\n      const len = Math.hypot(dx,dy) || 1;\n      damagePlayer(1, dx/len, dy/len);\n    }\n  }\n  if (boss) {\n    const dx = boss.x - player.x, dy = boss.y - player.y;\n    const r = boss.r + 12;\n    if (dx*dx + dy*dy < r*r) {\n      const len = Math.hypot(dx,dy) || 1;\n      damagePlayer(1, dx/len, dy/len);\n    }\n  }\n  // player bullets vs enemies\n  for (const b of bullets) {\n    if (b.dead || !b.fromPlayer) continue;\n    for (const e of enemies) {\n      const dx = b.x - e.x, dy = b.y - e.y;\n      const r = b.r + e.r;\n      if (dx*dx + dy*dy < r*r) {\n        b.dead = true;\n        e.hp -= b.dmg;\n        particles.impact(b.x, b.y, b.color);\n        if (e.hp <= 0 && !e.dead) {\n          e.dead = true;\n          e.weaveTriggered = true;\n        }\n      }\n    }\n    if (boss) {\n      const dx = b.x - boss.x, dy = b.y - boss.y;\n      const r = b.r + boss.r;\n      if (dx*dx + dy*dy < r*r) {\n        b.dead = true;\n        boss.hp -= b.dmg;\n        particles.impact(b.x, b.y, b.color);\n      }\n    }\n  }\n  // player bullets vs enemy bullets (cancel)\n  for (let i = 0; i < bullets.length; i++) {\n    if (bullets[i].dead) continue;\n    if (!bullets[i].fromPlayer) continue;\n    for (let j = 0; j < bullets.length; j++) {\n      if (i === j) continue;\n      if (bullets[j].fromPlayer) continue;\n      const a = bullets[i], b = bullets[j];\n      const dx = a.x - b.x, dy = a.y - b.y;\n      const r = a.r + b.r;\n      if (dx*dx + dy*dy < r*r*0.5) {\n        a.dead = true;\n        b.dead = true;\n        particles.impact(a.x, a.y, '#ffffff');\n        break;\n      }\n    }\n  }\n}\n\nfunction startPractice() {\n  reset();\n  state = STATE.PRACTICE;\n  // Spawn each archetype in a corner\n  const archs = ['Cinderling','Geometer','HaloWraith','Sentinel'];\n  enemies = [];\n  archs.forEach((a, i) => {\n    const ang = (i / archs.length) * Math.PI * 2;\n    enemies.push(new Enemy(a, LOGICAL_W/2 + Math.cos(ang)*200, LOGICAL_H/2 + Math.sin(ang)*180));\n  });\n  boss = new Boss(LOGICAL_W/2, LOGICAL_H/2);\n  boss.hp = 200;\n}\n\nfunction updatePractice(dt) {\n  player.update(dt, input, bullets, activeSlots, particles, audio);\n  for (const e of enemies) e.update(dt, player, bullets, rng);\n  if (boss) boss.update(dt, player, bullets, rng, particles);\n  for (let i = bullets.length - 1; i >= 0; i--) {\n    bullets[i].update(dt);\n    if (bullets[i].dead) bullets.splice(i,1);\n  }\n  collideAll();\n  for (let i = enemies.length - 1; i >= 0; i--) {\n    if (enemies[i].dead) {\n      const e = enemies[i];\n      const shard = { x: e.x, y: e.y, patternId: e.patternId, t: 0 };\n      shards.push(shard);\n      // auto-absorb in practice\n      const id = shard.patternId;\n      absorbedCodex.add(id);\n      if (activeSlots.length < 3) activeSlots.push(id); else { activeSlots.shift(); activeSlots.push(id); }\n      enemies.splice(i,1);\n    }\n  }\n  if (boss && boss.hp <= 0) boss = null;\n  // respawn\n  if (enemies.length === 0) {\n    const archs = ['Cinderling','Geometer','HaloWraith','Sentinel'];\n    archs.forEach((a, i) => {\n      const ang = (i / archs.length) * Math.PI * 2;\n      enemies.push(new Enemy(a, LOGICAL_W/2 + Math.cos(ang)*200, LOGICAL_H/2 + Math.sin(ang)*180));\n    });\n  }\n  if (!boss) {\n    boss = new Boss(LOGICAL_W/2, LOGICAL_H/2);\n    boss.hp = 200;\n  }\n  particles.update(dt);\n  if (input.pressed('Escape')) { state = STATE.MENU; stateTime = 0; }\n}\n\nfunction render() {\n  // Background void\n  ctx.fillStyle = '#0a0e27';\n  ctx.fillRect(0, 0, LOGICAL_W, LOGICAL_H);\n\n  // Subtle starfield parallax\n  drawStarfield();\n\n  if (state === STATE.MENU) { drawMenu(); return; }\n  if (state === STATE.LOSE) { drawPlayfield(); drawLose(); return; }\n  if (state === STATE.WIN) { drawPlayfield(); drawWin(); return; }\n  if (state === STATE.INTRO) { drawPlayfield(); drawIntro(); return; }\n  if (state === STATE.BOSS_INTRO) { drawPlayfield(); drawBossIntro(); return; }\n  if (state === STATE.CLEAR) { drawPlayfield(); drawClear(); return; }\n\n  drawPlayfield();\n  if (state === STATE.PRACTICE) {\n    drawPracticeHUD();\n  }\n}\n\nfunction drawStarfield() {\n  // simple parallax stars\n  const offset = (performance.now() / 100) % LOGICAL_W;\n  ctx.save();\n  ctx.fillStyle = 'rgba(255,255,255,0.4)';\n  for (let i = 0; i < 80; i++) {\n    const x = ((i * 137 + offset) % LOGICAL_W);\n    const y = (i * 71) % LOGICAL_H;\n    ctx.fillRect(x, y, 2, 2);\n  }\n  // bright accents\n  ctx.fillStyle = 'rgba(0, 240, 255, 0.5)';\n  for (let i = 0; i < 20; i++) {\n    const x = ((i * 311 + offset * 0.5) % LOGICAL_W);\n    const y = (i * 191) % LOGICAL_H;\n    ctx.fillRect(x, y, 3, 3);\n  }\n  ctx.fillStyle = 'rgba(255, 43, 214, 0.4)';\n  for (let i = 0; i < 12; i++) {\n    const x = ((i * 503 + offset * 0.3) % LOGICAL_W);\n    const y = (i * 257) % LOGICAL_H;\n    ctx.fillRect(x, y, 2, 2);\n  }\n  ctx.restore();\n}\n\nfunction drawPlayfield() {\n  // Apply zoom punch\n  ctx.save();\n  const sx = (Math.random()-0.5) * cameraShake * 8;\n  const sy = (Math.random()-0.5) * cameraShake * 8;\n  ctx.translate(sx, sy);\n  ctx.translate(LOGICAL_W/2, LOGICAL_H/2);\n  ctx.scale(zoomPunch, zoomPunch);\n  ctx.translate(-LOGICAL_W/2, -LOGICAL_H/2);\n\n  // weave desaturation\n  if (state === STATE.WEAVE) {\n    ctx.fillStyle = 'rgba(0,0,0,0.25)';\n    ctx.fillRect(0,0,LOGICAL_W,LOGICAL_H);\n  }\n\n  // Shards\n  for (const s of shards) {\n    const c = PATTERNS[s.patternId].color;\n    const pulse = 0.6 + 0.4 * Math.sin(performance.now()/200 + s.t*5);\n    ctx.save();\n    ctx.translate(s.x, s.y);\n    ctx.rotate(performance.now()/400);\n    ctx.strokeStyle = c;\n    ctx.globalAlpha = pulse;\n    ctx.lineWidth = 2;\n    ctx.beginPath();\n    for (let i = 0; i < 6; i++) {\n      const a = (i/6)*Math.PI*2;\n      const r = i % 2 === 0 ? 16 : 8;\n      const x = Math.cos(a)*r, y = Math.sin(a)*r;\n      if (i === 0) ctx.moveTo(x,y); else ctx.lineTo(x,y);\n    }\n    ctx.closePath();\n    ctx.stroke();\n    ctx.fillStyle = c;\n    ctx.globalAlpha = pulse * 0.6;\n    ctx.beginPath(); ctx.arc(0,0,4,0,Math.PI*2); ctx.fill();\n    ctx.restore();\n  }\n\n  // Enemies\n  for (const e of enemies) e.draw(ctx);\n  if (boss) boss.draw(ctx);\n\n  // Bullets\n  for (const b of bullets) b.draw(ctx, state === STATE.WEAVE);\n\n  // Player\n  player.draw(ctx, activeSlots);\n\n  // Particles\n  particles.draw(ctx);\n\n  ctx.restore();\n\n  // HUD\n  hud.draw(ctx, {\n    hp: player ? player.hp : 3,\n    maxHp: 3,\n    activeSlots,\n    codex: absorbedCodex.size,\n    codexMax: 5,\n    weaveTimer: state === STATE.WEAVE ? weaveTimer : 0,\n    weaveMax: 1.5,\n    boss: boss ? { hp: boss.hp, max: boss.maxHp } : null,\n    speedrun: speedrunElapsed,\n    high: highScore,\n    state\n  });\n\n  // damage vignette\n  if (player && player.damageFlash > 0) {\n    ctx.fillStyle = `rgba(255, 59, 92, ${player.damageFlash * 0.25})`;\n    ctx.fillRect(0,0,LOGICAL_W,LOGICAL_H);\n  }\n}\n\nfunction drawIntro() {\n  ctx.fillStyle = 'rgba(0,0,0,0.5)';\n  ctx.fillRect(0,0,LOGICAL_W,LOGICAL_H);\n  ctx.fillStyle = '#00f0ff';\n  ctx.font = \"700 64px Orbitron\";\n  ctx.textAlign = 'center';\n  ctx.fillText(`CHAMBER ${chamber+1}`, LOGICAL_W/2, LOGICAL_H/2 - 20);\n  ctx.font = \"300 24px Rajdhani\";\n  ctx.fillStyle = '#a3ff3c';\n  ctx.fillText(`Absorb ${CHAMBER_COUNTS[chamber]} patterns`, LOGICAL_W/2, LOGICAL_H/2 + 20);\n}\n\nfunction drawClear() {\n  ctx.fillStyle = 'rgba(0,0,0,0.5)';\n  ctx.fillRect(0,0,LOGICAL_W,LOGICAL_H);\n  ctx.fillStyle = '#a3ff3c';\n  ctx.font = \"700 64px Orbitron\";\n  ctx.textAlign = 'center';\n  ctx.fillText('CHAMBER CLEARED', LOGICAL_W/2, LOGICAL_H/2);\n}\n\nfunction drawBossIntro() {\n  ctx.fillStyle = 'rgba(0,0,0,0.4)';\n  ctx.fillRect(0,0,LOGICAL_W,LOGICAL_H);\n  ctx.fillStyle = '#ff2bd6';
  ctx.font = "700 72px Orbitron";
  ctx.textAlign = 'center';
  ctx.fillText('VOID WEAVER', LOGICAL_W/2, LOGICAL_H/2 - 30);
  ctx.font = "300 28px Rajdhani";
  ctx.fillStyle = '#ffb627';
  ctx.fillText('The apex of the void awakens', LOGICAL_W/2, LOGICAL_H/2 + 30);
}

function drawMenu() {
  // title
  ctx.fillStyle = '#00f0ff';
  ctx.font = "700 80px Orbitron";
  ctx.textAlign = 'center';
  ctx.fillText('VOID WEAVER', LOGICAL_W/2, 160);
  ctx.font = "300 22px Rajdhani";
  ctx.fillStyle = '#a3ff3c';
  ctx.fillText('Absorb patterns. Survive the void.', LOGICAL_W/2, 200);

  // menu options
  const opts = ['START GAME', 'PRACTICE', 'CONTROLS'];
  for (let i = 0; i < opts.length; i++) {
    const sel = i === menuSelect;
    ctx.fillStyle = sel ? '#00f0ff' : 'rgba(255,255,255,0.5)';
    ctx.font = sel ? "700 36px Orbitron" : "500 28px Rajdhani";
    ctx.fillText(opts[i], LOGICAL_W/2, 340 + i * 60);
    if (sel) {
      ctx.strokeStyle = '#00f0ff';
      ctx.lineWidth = 1;
      ctx.strokeRect(LOGICAL_W/2 - 150, 310 + i * 60, 300, 40);
    }
  }

  // high score
  ctx.fillStyle = '#ffb627';
  ctx.font = "300 20px Rajdhani";
  ctx.fillText(`HIGH SCORE: ${highScore}`, LOGICAL_W/2, 580);

  // controls hint
  ctx.fillStyle = 'rgba(255,255,255,0.35)';
  ctx.font = "300 16px Rajdhani";
  ctx.fillText('WASD: Move | Mouse: Aim | Click: Fire | E: Absorb', LOGICAL_W/2, 650);
}

function drawLose() {
  ctx.fillStyle = 'rgba(0,0,0,0.7)';
  ctx.fillRect(0,0,LOGICAL_W,LOGICAL_H);
  ctx.fillStyle = '#ff3b5c';
  ctx.font = "700 72px Orbitron";
  ctx.textAlign = 'center';
  ctx.fillText('VOID CLAIMED', LOGICAL_W/2, LOGICAL_H/2 - 40);
  const score = chamber * 100 + absorbedCodex.size * 50;
  ctx.fillStyle = '#ffb627';
  ctx.font = "300 28px Rajdhani";
  ctx.fillText(`Patterns absorbed: ${absorbedCodex.size}`, LOGICAL_W/2, LOGICAL_H/2 + 10);
  ctx.fillText(`Score: ${score}`, LOGICAL_W/2, LOGICAL_H/2 + 50);
  if (score >= highScore) {
    ctx.fillStyle = '#a3ff3c';
    ctx.font = "700 24px Orbitron";
    ctx.fillText('NEW HIGH SCORE!', LOGICAL_W/2, LOGICAL_H/2 + 100);
  }
  ctx.fillStyle = 'rgba(255,255,255,0.5)';
  ctx.font = "300 20px Rajdhani";
  ctx.fillText('Press Space to continue', LOGICAL_W/2, LOGICAL_H/2 + 150);
}

function drawWin() {
  ctx.fillStyle = 'rgba(0,0,0,0.6)';
  ctx.fillRect(0,0,LOGICAL_W,LOGICAL_H);
  ctx.fillStyle = '#a3ff3c';
  ctx.font = "700 72px Orbitron";
  ctx.textAlign = 'center';
  ctx.fillText('VOID CONQUERED', LOGICAL_W/2, LOGICAL_H/2 - 60);
  const score = 1000 + Math.floor(speedrunElapsed < 1 ? 0 : 3000 / speedrunElapsed) + absorbedCodex.size * 100;
  ctx.fillStyle = '#ffb627';
  ctx.font = "300 24px Rajdhani";
  ctx.fillText(`Time: ${speedrunElapsed.toFixed(1)}s`, LOGICAL_W/2, LOGICAL_H/2);
  ctx.fillText(`Patterns: ${absorbedCodex.size}`, LOGICAL_W/2, LOGICAL_H/2 + 30);
  ctx.fillText(`Score: ${score}`, LOGICAL_W/2, LOGICAL_H/2 + 60);
  if (score >= highScore) {
    ctx.fillStyle = '#00f0ff';
    ctx.font = "700 28px Orbitron";
    ctx.fillText('NEW HIGH SCORE!', LOGICAL_W/2, LOGICAL_H/2 + 110);
  }
  ctx.fillStyle = 'rgba(255,255,255,0.5)';
  ctx.font = "300 20px Rajdhani";
  ctx.fillText('Press Space to continue', LOGICAL_W/2, LOGICAL_H/2 + 160);
}

function drawPracticeHUD() {
  ctx.fillStyle = 'rgba(0,0,0,0.4)';
  ctx.fillRect(LOGICAL_W/2 - 80, 10, 160, 30);
  ctx.fillStyle = '#ffb627';
  ctx.font = "700 18px Orbitron";
  ctx.textAlign = 'center';
  ctx.fillText('PRACTICE MODE', LOGICAL_W/2, 30);
  ctx.textAlign = 'left';
}

// Input
window.addEventListener('keydown', e => input.keydown(e));
window.addEventListener('keyup', e => input.keyup(e));
canvas.addEventListener('mousedown', e => input.mousedown(e));
canvas.addEventListener('mouseup', e => input.mouseup(e));
canvas.addEventListener('mousemove', e => input.mousemove(e));
canvas.addEventListener('contextmenu', e => e.preventDefault());
// touch controls
const stickMove = document.getElementById('stickMove');
const stickAim = document.getElementById('stickAim');
const knobMove = stickMove.querySelector('.touchKnob');
const knobAim = stickAim.querySelector('.touchKnob');
let touchMove = { active: false, id: null, ox: 0, oy: 0, nx: 0, ny: 0 };
let touchAim = { active: false, id: null, ox: 0, oy: 0, nx: 0, ny: 0 };

function handleTouchStart(e, which, knob, store) {
  e.preventDefault();
  const t = e.changedTouches[0];
  const rect = which.getBoundingClientRect();
  store.ox = rect.left + rect.width/2;
  store.oy = rect.top + rect.height/2;
  store.id = t.identifier;
  store.active = true;
  store.nx = 0; store.ny = 0;
  knob.style.transform = `translate(-50%, -50%) translate(0px, 0px)`;
}
function handleTouchMove(e, which, knob, store) {
  e.preventDefault();
  for (const t of e.changedTouches) {
    if (t.identifier === store.id) {
      const dx = t.clientX - store.ox;
      const dy = t.clientY - store.oy;
      const dist = Math.hypot(dx, dy);
      const maxDist = 40;
      const clamped = Math.min(dist, maxDist);
      const angle = Math.atan2(dy, dx);
      store.nx = Math.cos(angle) * clamped / maxDist;
      store.ny = Math.sin(angle) * clamped / maxDist;
      knob.style.transform = `translate(-50%, -50%) translate(${Math.cos(angle)*clamped}px, ${Math.sin(angle)*clamped}px)`;
    }
  }
}
function handleTouchEnd(e, which, knob, store) {
  for (const t of e.changedTouches) {
    if (t.identifier === store.id) {
      store.active = false;
      store.nx = 0; store.ny = 0;
      knob.style.transform = `translate(-50%, -50%) translate(0px, 0px)`;
    }
  }
}
stickMove.addEventListener('touchstart', e => handleTouchStart(e, stickMove, knobMove, touchMove), { passive: false });
stickAim.addEventListener('touchstart', e => handleTouchStart(e, stickAim, knobAim, touchAim), { passive: false });
document.addEventListener('touchmove', e => {
  handleTouchMove(e, stickMove, knobMove, touchMove);
  handleTouchMove(e, stickAim, knobAim, touchAim);
}, { passive: false });
document.addEventListener('touchend', e => {
  handleTouchEnd(e, stickMove, knobMove, touchMove);
  handleTouchEnd(e, stickAim, knobAim, touchAim);
});
document.addEventListener('touchcancel', e => {
  handleTouchEnd(e, stickMove, knobMove, touchMove);
  handleTouchEnd(e, stickAim, knobAim, touchAim);
});
input.touchMove = () => touchMove;
input.touchAim = () => touchAim;
const btnFire = document.getElementById('btnFire');
const btnAbsorb = document.getElementById('btnAbsorb');
btnFire.addEventListener('touchstart', e => { e.preventDefault(); input.touchFire = true; }, { passive: false });
btnFire.addEventListener('touchend', e => { e.preventDefault(); input.touchFire = false; }, { passive: false });
btnAbsorb.addEventListener('touchstart', e => { e.preventDefault(); input.touchAbsorb = true; }, { passive: false });
btnAbsorb.addEventListener('touchend', e => { e.preventDefault(); input.touchAbsorb = false; }, { passive: false });

function loop(ts) {
  let dt = (ts - lastTimestamp) / 1000;
  lastTimestamp = ts;
  if (dt > 0.1) dt = 0.016;
  if (firstFrame) { dt = 0.016; firstFrame = false; }
  update(dt);
  render();
  requestAnimationFrame(loop);
}
requestAnimationFrame(loop);
", "src/systems/InputSystem.js": "// Input handling\nconst KEYS = {};\nconst JUST_PRESSED = {};\nconst JUST_RELEASED = {};\n\nexport class Input {\n  constructor(canvas) {\n    this.canvas = canvas;\n    this.mouseX = 0;\n    this.mouseY = 0;\n    this.mouseDown = false;\n    this.touchFire = false;\n    this.touchAbsorb = false;\n    this.touchMove = () => ({ active: false, nx: 0, ny: 0 });\n    this.touchAim = () => ({ active: false, nx: 0, ny: 0 });\n  }\n  keydown(e) {\n    if (!KEYS[e.code]) JUST_PRESSED[e.code] = true;\n    KEYS[e.code] = true;\n  }\n  keyup(e) {\n    KEYS[e.code] = false;\n    JUST_RELEASED[e.code] = true;\n  }\n  mousedown(e) {\n    this.mouseDown = true;\n  }\n  mouseup(e) {\n    this.mouseDown = false;\n  }\n  mousemove(e) {\n    const rect = this.canvas.getBoundingClientRect();\n    const scaleX = 1280 / rect.width;\n    const scaleY = 720 / rect.height;\n    this.mouseX = (e.clientX - rect.left) * scaleX;\n    this.mouseY = (e.clientY - rect.top) * scaleY;\n  }\n  pressed(code) {\n    if (JUST_PRESSED[code]) { delete JUST_PRESSED[code]; return true; }\n    return false;\n  }\n  held(code) {\n    return !!KEYS[code];\n  }\n  // normalized direction -1 to 1\n  moveDir() {\n    let x = 0, y = 0;\n    if (this.held('KeyW') || this.held('ArrowUp')) y -= 1;\n    if (this.held('KeyS') || this.held('ArrowDown')) y += 1;\n    if (this.held('KeyA') || this.held('ArrowLeft')) x -= 1;\n    if (this.held('KeyD') || this.held('ArrowRight')) x += 1;\n    const tm = this.touchMove();\n    if (tm.active) { x = tm.nx; y = tm.ny; }\n    const len = Math.hypot(x, y);\n    if (len > 0) return { x: x/len, y: y/len };\n    return { x: 0, y: 0 };\n  }\n  aimDir() {\n    // mouse\n    const rect = this.canvas.getBoundingClientRect();\n    const scaleX = 1280 / rect.width;\n    const scaleY = 720 / rect.height;\n    const mx = (this.mouseX || (this.mouseX = 0));\n    const my = (this.mouseY || (this.mouseY = 0));\n    const wx = (mx) * scaleX;\n    const wy = (my) * scaleY;\n    const ta = this.touchAim();\n    if (ta.active) {\n      const angle = Math.atan2(ta.ny, ta.nx);\n      return { x: Math.cos(angle), y: Math.sin(angle), mag: Math.hypot(ta.nx, ta.ny) };\n    }\n    // If mouse hasn't moved yet, default to right\n    if (this.mouseX === 0 && this.mouseY === 0) return { x: 1, y: 0, mag: 1 };\n    const dx = wx - 640, dy = wy - 360;\n    const len = Math.hypot(dx, dy) || 1;\n    return { x: dx/len, y: dy/len, mag: 1 };\n  }\n  firing() {\n    return this.mouseDown || this.touchFire;\n  }\n  update() {\n    // clear just pressed\n    for (const k in JUST_PRESSED) delete JUST_PRESSED[k];\n    for (const k in JUST_RELEASED) delete JUST_RELEASED[k];\n  }\n}", "src/systems/ParticleSystem.js": "// Particle system for visual effects\nconst PARTICLES = [];\n\nexport class ParticleSystem {\n  constructor() {\n    this.particles = [];\n    this.vignette = document.getElementById('vignette');\n  }\n  spawn(x, y, vx, vy, color, size, life, type = 'circle') {\n    this.particles.push({ x, y, vx, vy, color, size, life, maxLife: life, type, alpha: 1, spin: (Math.random()-0.5)*4 });\n  }\n  burst(x, y, color, count = 12, speed = 120) {\n    for (let i = 0; i < count; i++) {\n      const a = (i/count)*Math.PI*2 + Math.random()*0.3;\n      const s = speed*(0.6+Math.random()*0.8);\n      this.spawn(x, y, Math.cos(a)*s, Math.sin(a)*s, color, 3+Math.random()*4, 0.4+Math.random()*0.4);\n    }\n  }\n  killBurst(x, y, color) {\n    for (let i = 0; i < 24; i++) {\n      const a = Math.random()*Math.PI*2;\n      const s = 80+Math.random()*200;\n      this.spawn(x, y, Math.cos(a)*s, Math.sin(a)*s, color, 4+Math.random()*6, 0.6+Math.random()*0.5);\n    }\n    // ring\n    for (let i = 0; i < 20; i++) {\n      const a = (i/20)*Math.PI*2;\n      this.spawn(x, y, Math.cos(a)*250, Math.sin(a)*250, color, 3, 0.3);\n    }\n  }\n  absorbBurst(x, y, color) {\n    for (let i = 0; i < 40; i++) {\n      const a = Math.random()*Math.PI*2;\n      const dist = 60+Math.random()*120;\n      const tx = x + Math.cos(a)*dist;\n      const ty = y + Math.sin(a)*dist;\n      const s = dist * (2+Math.random()*2);\n      this.spawn(tx, ty, (x-tx)*s/dist, (y-ty)*s/dist, color, 5+Math.random()*5, 0.5+Math.random()*0.3);\n    }\n    // flash\n    this.spawn(x, y, 0, 0, color, 80, 0.15, 'flash');\n  }\n  impact(x, y, color) {\n    for (let i = 0; i < 8; i++) {\n      const a = Math.random()*Math.PI*2;\n      const s = 40+Math.random()*80;\n      this.spawn(x, y, Math.cos(a)*s, Math.sin(a)*s, color, 2+Math.random()*3, 0.2+Math.random()*0.2);\n    }\n  }\n  trail(x, y, color) {\n    this.spawn(x + (Math.random()-0.5)*6, y + (Math.random()-0.5)*6, (Math.random()-0.5)*20, (Math.random()-0.5)*20, color, 2+Math.random()*2, 0.15+Math.random()*0.1);\n  }\n  damageVignette() {\n    if (this.vignette) {\n      this.vignette.style.boxShadow = 'inset 0 0 100px 20px rgba(255, 59, 92, 0.8)';\n      setTimeout(() => { if(this.vignette) this.vignette.style.boxShadow = 'inset 0 0 0 0 rgba(255, 59, 92, 0)'; }, 150);\n    }\n  }\n  update(dt) {\n    for (let i = this.particles.length - 1; i >= 0; i--) {\n      const p = this.particles[i];\n      p.life -= dt;\n      p.x += p.vx * dt;\n      p.y += p.vy * dt;\n      p.vx *= 0.95;\n      p.vy *= 0.95;\n      p.alpha = Math.max(0, p.life / p.maxLife);\n      p.size *= 0.98;\n      if (p.life <= 0) this.particles.splice(i, 1);\n    }\n  }\n  clear() { this.particles = []; }\n  draw(ctx) {\n    for (const p of this.particles) {\n      ctx.save();\n      ctx.globalAlpha = p.alpha;\n      ctx.fillStyle = p.color;\n      if (p.type === 'circle') {\n        ctx.beginPath();\n        ctx.arc(p.x, p.y, p.size, 0, Math.PI*2);\n        ctx.fill();\n      } else if (p.type === 'flash') {\n        ctx.beginPath();\n        ctx.arc(p.x, p.y, p.size, 0, Math.PI*2);\n        ctx.fill();\n      }\n      ctx.restore();\n    }\n  }\n}", "src/entities/Player.js": "// Player entity\nimport { Bullet } from './Bullet.js';\n\nconst FIRE_COOLDOWN = 0.12;\nconst MOVE_SPEED = 200;\nconst ABSORB_RANGE = 80;\n\nexport class Player {\n  constructor(x, y) {\n    this.x = x;\n    this.y = y;\n    this.r = 12;\n    this.hp = 3;\n    this.iframes = 0;\n    this.knockX = 0;\n    this.knockY = 0;\n    this.fireCooldown = 0;\n    this.angle = 0;\n    this.invTimer = 0;\n    this.damageFlash = 0;\n    this.trailTimer = 0;\n    this.absorbedPatterns = [];\n  }\n  update(dt, input, bullets, activeSlots, particles, audio) {\n    // movement\n    const dir = input.moveDir();\n    this.x += dir.x * MOVE_SPEED * dt;\n    this.y += dir.y * MOVE_SPEED * dt;\n    // knockback\n    this.x += this.knockX * dt;\n    this.y += this.knockY * dt;\n    this.knockX *= 0.8;\n    this.knockY *= 0.8;\n    // bounds\n    if (this.x < this.r) this.x = this.r;\n    if (this.x > 1280 - this.r) this.x = 1280 - this.r;\n    if (this.y < this.r) this.y = this.r;\n    if (this.y > 720 - this.r) this.y = 720 - this.r;\n\n    // aim\n    const aim = input.aimDir();\n    this.angle = Math.atan2(aim.y, aim.x);\n\n    // fire\n    this.fireCooldown -= dt;\n    if (input.firing() && this.fireCooldown <= 0) {\n      this.fireCooldown = FIRE_COOLDOWN;\n      const pattern = activeSlots.length > 0 ? activeSlots[activeSlots.length-1] : null;\n      this.shoot(bullets, pattern, aim);\n      audio.play('shoot');\n    }\n\n    // iframe\n    this.iframes -= dt;\n    if (this.iframes < 0) this.iframes = 0;\n    this.invTimer = this.iframes > 0 ? (this.invTimer || 0) + dt : 0;\n\n    // damage flash\n    this.damageFlash = Math.max(0, this.damageFlash - dt * 4);\n\n    // trail\n    this.trailTimer -= dt;\n    if (this.trailTimer <= 0) {\n      this.trailTimer = 0.03;\n      particles.trail(this.x, this.y, 'rgba(0,240,255,0.5)');\n    }\n  }\n  shoot(bullets, patternId, dir) {\n    if (!patternId) {\n      // default straight shot\n      bullets.push(new Bullet(this.x, this.y, dir.x * 500, dir.y * 500, 1, 5, '#00f0ff', true));\n      return;\n    }\n    // Pattern-based shooting\n    const sp = 450;\n    const { bullets: blt, spread, count, angleOffset } = this.getPatternConfig(patternId);\n    for (let i = 0; i < count; i++) {\n      const a = this.angle + angleOffset + (i - (count-1)/2) * spread;\n      bullets.push(new Bullet(this.x, this.y, Math.cos(a)*sp, Math.sin(a)*sp, 1, 6, blt.color, true));\n    }\n  }\n  getPatternConfig(patternId) {\n    const configs = {\n      0: { bullets: {color:'#00f0ff'}, spread: 0.15, count: 3, angleOffset: 0 },\n      1: { bullets: {color:'#ff2bd6'}, spread: 0.3, count: 5, angleOffset: 0 },\n      2: { bullets: {color:'#ffb627'}, spread: 0.5, count: 7, angleOffset: 0 },\n      3: { bullets: {color:'#a3ff3c'}, spread: 0.05, count: 2, angleOffset: 0 },\n      4: { bullets: {color:'#ff3b5c'}, spread: 0.2, count: 4, angleOffset: Math.PI/2 },\n    };\n    return configs[patternId % 5] || configs[0];\n  }\n  draw(ctx, activeSlots) {\n    ctx.save();\n    ctx.translate(this.x, this.y);\n    ctx.rotate(this.angle);\n\n    // flicker during iframes\n    if (this.iframes > 0 && Math.floor(this.invTimer * 15) % 2 === 0) {\n      ctx.globalAlpha = 0.3;\n    }\n\n    // ship body (triangle)\n    ctx.fillStyle = '#00f0ff';\n    ctx.beginPath();\n    ctx.moveTo(18, 0);\n    ctx.lineTo(-10, -10);\n    ctx.lineTo(-6, 0);\n    ctx.lineTo(-10, 10);\n    ctx.closePath();\n    ctx.fill();\n\n    // inner glow\n    ctx.fillStyle = 'rgba(0, 240, 255, 0.5)';\n    ctx.beginPath();\n    ctx.moveTo(12, 0);\n    ctx.lineTo(-4, -5);\n    ctx.lineTo(-2, 0);\n    ctx.lineTo(-4, 5);\n    ctx.closePath();\n    ctx.fill();\n\n    // active pattern slots indicator\n    ctx.rotate(-this.angle);\n    for (let i = 0; i < 3; i++) {\n      const slot = activeSlots[i];\n      const angle = -Math.PI/2 + (i-1) * 0.5;\n      const rx = Math.cos(angle) * 22;\n      const ry = Math.sin(angle) * 22;\n      ctx.fillStyle = slot !== undefined ? '#a3ff3c' : 'rgba(255,255,255,0.2)';\n      ctx.beginPath();\n      ctx.arc(rx, ry, 4, 0, Math.PI*2);\n      ctx.fill();\n    }\n\n    ctx.restore();\n  }\n}", "src/entities/Enemy.js": "// Enemy archetypes\nimport { Bullet } from './Bullet.js';\n\nexport class Enemy {\n  constructor(archetype, x, y) {\n    this.archetype = archetype;\n    this.x = x;\n    this.y = y;\n    this.hp = 3;\n    this.dead = false;\n    this.weaveTriggered = false;\n    this.shootTimer = 1 + Math.random()*2;\n    this.phase = Math.random()*Math.PI*2;\n    this.r = this.getRadius();\n    this.color = this.getColor();\n    this.patternId = this.getPatternId();\n    this.speed = this.getSpeed();\n    this.scoreValue = this.getScoreValue();\n  }\n  getRadius() {\n    const radii = { Cinderling: 14, Geometer: 16, HaloWraith: 18, Sentinel: 22 };\n    return radii[this.archetype] || 14;\n  }\n  getColor() {\n    const colors = { Cinderling: '#ff3b5c', Geometer: '#00f0ff', HaloWraith: '#ff2bd6', Sentinel: '#ffb627' };\n    return colors[this.archetype] || '#ffffff';\n  }\n  getPatternId() {\n    const ids = { Cinderling: 0, Geometer: 1, HaloWraith: 2, Sentinel: 3 };\n    return ids[this.archetype] || 0;\n  }\n  getSpeed() {\n    const speeds = { Cinderling: 90, Geometer: 60, HaloWraith: 75, Sentinel: 40 };\n    return speeds[this.archetype] || 60;\n  }\n  getScoreValue() {\n    const vals = { Cinderling: 100, Geometer: 150, HaloWraith: 200, Sentinel: 300 };\n    return vals[this.archetype] || 100;\n  }\n  update(dt, player, bullets, rng) {\n    if (this.dead) return;\n    // move toward player\n    const dx = player.x - this.x, dy = player.y - this.y;\n    const dist = Math.hypot(dx, dy) || 1;\n    if (dist > 100) {\n      this.x += (dx/dist) * this.speed * dt;\n      this.y += (dy/dist) * this.speed * dt;\n    }\n    // orbit\n    this.phase += dt * 2;\n    if (this.archetype === 'Geometer') {\n      const ox = Math.cos(this.phase) * 30;\n      const oy = Math.sin(this.phase) * 30;\n      this.x += ox * dt;\n      this.y += oy * dt;\n    }\n    // shoot\n    this.shootTimer -= dt;\n    if (this.shootTimer <= 0) {\n      this.shootTimer = this.getShootInterval() + rng.next() * 1.5;\n      this.shoot(bullets, player);\n    }\n  }\n  getShootInterval() {\n    const intervals = { Cinderling: 2.5, Geometer: 1.8, HaloWraith: 2.0, Sentinel: 1.2 };\n    return intervals[this.archetype] || 2;\n  }\n  shoot(bullets, player) {\n    const dx = player.x - this.x, dy = player.y - this.y;\n    const dist = Math.hypot(dx, dy) || 1;\n    const sp = 180 + Math.random()*80;\n    if (this.archetype === 'Cinderling') {\n      bullets.push(new Bullet(this.x, this.y, (dx/dist)*sp, (dy/dist)*sp, 1, 6, this.color, false));\n    } else if (this.archetype === 'Geometer') {\n      for (let i = 0; i < 3; i++) {\n        const a = Math.atan2(dy, dx) + (i-1)*0.3;\n        bullets.push(new Bullet(this.x, this.y, Math.cos(a)*sp, Math.sin(a)*sp, 1, 5, this.color, false));\n      }\n    } else if (this.archetype === 'HaloWraith') {\n      for (let i = 0; i < 8; i++) {\n        const a = (i/8)*Math.PI*2;\n        bullets.push(new Bullet(this.x, this.y, Math.cos(a)*sp*0.7, Math.sin(a)*sp*0.7, 1, 4, this.color, false));\n      }\n    } else if (this.archetype === 'Sentinel') {\n      for (let i = 0; i < 5; i++) {\n        const a = Math.atan2(dy, dx) + (i-2)*0.15;\n        bullets.push(new Bullet(this.x, this.y, Math.cos(a)*sp*1.2, Math.sin(a)*sp*1.2, 2, 8, this.color, false));\n      }\n    }\n  }\n  draw(ctx) {\n    ctx.save();\n    ctx.translate(this.x, this.y);\n    ctx.rotate(this.phase);\n\n    // body\n    ctx.fillStyle = this.color;\n    if (this.archetype === 'Cinderling') {\n      // diamond\n      ctx.beginPath();\n      ctx.moveTo(0, -this.r);\n      ctx.lineTo(this.r, 0);\n      ctx.lineTo(0, this.r);\n      ctx.lineTo(-this.r, 0);\n      ctx.closePath();\n      ctx.fill();\n    } else if (this.archetype === 'Geometer') {\n      // hexagon\n      ctx.beginPath();\n      for (let i = 0; i < 6; i++) {\n        const a = (i/6)*Math.PI*2;\n        const x = Math.cos(a)*this.r, y = Math.sin(a)*this.r;\n        if (i === 0) ctx.moveTo(x,y); else ctx.lineTo(x,y);\n      }\n      ctx.closePath();\n      ctx.fill();\n    } else if (this.archetype === 'HaloWraith') {\n      // star\n      ctx.beginPath();\n      for (let i = 0; i < 10; i++) {\n        const a = (i/10)*Math.PI*2 - Math.PI/2;\n        const r = i % 2 === 0 ? this.r : this.r*0.5;\n        const x = Math.cos(a)*r, y = Math.sin(a)*r;\n        if (i === 0) ctx.moveTo(x,y