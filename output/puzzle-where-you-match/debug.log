Raw: {"index.html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, user-scalable=no\">\n    <title>Cascade — Number Merge Puzzle</title>\n    <link rel=\"icon\" href=\"data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🔮</text></svg>\">\n    <style>\n        * { margin: 0; padding: 0; box-sizing: border-box; }\n        html, body {\n            width: 100%; height: 100%;\n            overflow: hidden;\n            background: #0F1729;\n            display: flex; justify-content: center; align-items: center;\n            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;\n            touch-action: none;\n            -webkit-tap-highlight-color: transparent;\n        }\n        #gameCanvas {\n            display: block;\n            max-width: 100vw;\n            max-height: 100vh;\n        }\n        #startScreen {\n            position: absolute;\n            display: flex;\n            flex-direction: column;\n            align-items: center;\n            justify-content: center;\n            color: white;\n            text-align: center;\n        }\n        #startScreen h1 {\n            font-size: 48px;\n            font-weight: 700;\n            color: #FFD93D;\n            text-shadow: 0 0 20px rgba(255,217,61,0.5);\n            margin-bottom: 20px;\n        }\n        #startScreen p {\n            font-size: 16px;\n            opacity: 0.7;\n            margin-bottom: 30px;\n        }\n        #startBtn {\n            padding: 16px 48px;\n            font-size: 20px;\n            font-weight: 700;\n            background: linear-gradient(135deg, #FFD93D, #FF8C42);\n            border: none;\n            border-radius: 12px;\n            color: #1B2440;\n            cursor: pointer;\n            transition: transform 0.2s, box-shadow 0.2s;\n        }\n        #startBtn:hover {\n            transform: scale(1.05);\n            box-shadow: 0 8px 30px rgba(255,217,61,0.4);\n        }\n        .controls-hint {\n            margin-top: 40px;\n            font-size: 14px;\n            opacity: 0.5;\n            line-height: 1.8;\n        }\n    </style>\n</head>\n<body>\n    <div id=\"startScreen\">\n        <h1>🔮 CASCADE</h1>\n        <p>Merge numbers, build combos, beat your best!</p>\n        <button id=\"startBtn\">PLAY</button>\n        <div class=\"controls-hint\">\n            ← → or Swipe to move<br>\n            ↓ or Swipe Down for soft drop<br>\n            Tap or Space for hard drop<br>\n            P or Esc to pause\n        </div>\n    </div>\n    <canvas id=\"gameCanvas\"></canvas>\n    <script type=\"module\" src=\"src/main.js\"></script>\n</body>\n</html>", "src/constants.js": "export const GRID_COLS = 6;\nexport const GRID_ROWS = 8;\nexport const CELL_SIZE = 64;\nexport const TILE_SIZE = 56;\nexport const PLAYFIELD_OFFSET_X = 48;\nexport const PLAYFIELD_OFFSET_Y = 96;\nexport const CANVAS_WIDTH = 480;\nexport const CANVAS_HEIGHT = 720;\n\nexport const TILE_COLORS = {\n    2:    { fill: '#5B7CFA', text: '#FFFFFF', border: '#3A56D9' },\n    4:    { fill: '#4FB3FF', text: '#FFFFFF', border: '#2A86D6' },\n    8:    { fill: '#3DD9C9', text: '#062B26', border: '#22A99A' },\n    16:   { fill: '#7CE07C', text: '#0A3A0A', border: '#52B252' },\n    32:   { fill: '#FFD93D', text: '#3A2E00', border: '#D6B122' },\n    64:   { fill: '#FF8C42', text: '#FFFFFF', border: '#D66B22' },\n    128:  { fill: '#FF5C8A', text: '#FFFFFF', border: '#D63D6B' },\n    256:  { fill: '#C56CF0', text: '#FFFFFF', border: '#9E4FD1' },\n    512:  { fill: '#A0A4FF', text: '#FFFFFF', border: '#787CD6' },\n    1024: { fill: '#FFE066', text: '#3A2E00', border: '#D6B14A' },\n    2048: { fill: '#FFFFFF', text: '#0F1729', border: '#FFD93D' }\n};\n\nexport const SPAWN_WEIGHTS = [\n    { value: 2, weight: 70 },\n    { value: 4, weight: 25 },\n    { value: 8, weight: 5 }\n];\n\nexport const BASE_FALL_SPEED = 700; // ms per cell\nexport const HORIZONTAL_MOVE_SPEED = 8; // cells per second\nexport const HARD_DROP_SPEED = 50; // ms per cell\nexport const SPEED_INCREASE_INTERVAL = 10; // merges\nexport const SPEED_INCREASE_FACTOR = 1.08;\nexport const MAX_SPEED_MULTIPLIER = 3.0;\n\nexport const MAX_CHAIN_DEPTH = 5;\nexport const SPAWN_DELAY = 350;\nexport const MERGE_ANIM_DURATION = 140;\nexport const TILE_TWEEN_DURATION = 90;\nexport const LANDING_SMOOTH_DURATION = 40;\n\nexport const BASE_SCORE_MULTIPLIER = 10;\nexport const CHAIN_BONUS_MULTIPLIER = 1.5;\n\nexport const STORAGE_KEY = 'cascade.highscore';\n\nexport const COMBO_NAMES = ['', '', 'DOUBLE!', 'TRIPLE!', 'QUAD!', 'MEGA!'];\n\nexport const COLORS = {\n    bgTop: '#0F1729',\n    bgBottom: '#1B2440',\n    gridLine: 'rgba(255,255,255,0.06)',\n    parallax1: '#1B2440',\n    parallax2: '#222C4D',\n    parallax3: '#2A355A',\n    hudBg: 'rgba(15, 23, 41, 0.85)',\n    hudBorder: 'rgba(255,255,255,0.1)',\n    textDim: 'rgba(255,255,255,0.5)',\n    textWhite: '#FFFFFF',\n    accent: '#FFD93D',\n    danger: '#FF5C8A'\n};", "src/storage.js": "import { STORAGE_KEY } from './constants.js';\n\nexport function loadHighScore() {\n    try {\n        const stored = localStorage.getItem(STORAGE_KEY);\n        return stored ? parseInt(stored, 10) : 0;\n    } catch {\n        return 0;\n    }\n}\n\nexport function saveHighScore(score) {\n    try {\n        localStorage.setItem(STORAGE_KEY, score.toString());\n    } catch {\n        // Storage not available\n    }\n}", "src/audio.js": "let audioCtx = null;\n\nfunction getAudioContext() {\n    if (!audioCtx) {\n        audioCtx = new (window.AudioContext || window.webkitAudioContext)();\n    }\n    return audioCtx;\n}\n\nfunction playTone(frequency, duration, type = 'sine', volume = 0.3) {\n    try {\n        const ctx = getAudioContext();\n        const osc = ctx.createOscillator();\n        const gain = ctx.createGain();\n        \n        osc.type = type;\n        osc.frequency.setValueAtTime(frequency, ctx.currentTime);\n        \n        gain.gain.setValueAtTime(volume, ctx.currentTime);\n        gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + duration / 1000);\n        \n        osc.connect(gain);\n        gain.connect(ctx.destination);\n        \n        osc.start(ctx.currentTime);\n        osc.stop(ctx.currentTime + duration / 1000);\n    } catch {\n        // Audio not available\n    }\n}\n\nexport function playDropSound() {\n    playTone(220, 80, 'sine', 0.2);\n}\n\nexport function playMergeSound(value, chainDepth = 1) {\n    const baseFreq = 440;\n    const semitones = Math.log2(value) * Math.log2(2) + 3;\n    const freq = baseFreq * Math.pow(2, semitones / 12);\n    \n    playTone(freq, 150, 'sine', 0.25);\n    \n    if (chainDepth > 1) {\n        setTimeout(() => playTone(freq * 1.25, 100, 'sine', 0.15), 50);\n    }\n    if (chainDepth > 2) {\n        setTimeout(() => playTone(freq * 1.5, 100, 'triangle', 0.1), 100);\n    }\n}\n\nexport function playGameOverSound() {\n    const ctx = getAudioContext();\n    if (!ctx) return;\n    \n    playTone(392, 200, 'sine', 0.3);\n    setTimeout(() => playTone(330, 200, 'sine', 0.25), 150);\n    setTimeout(() => playTone(262, 400, 'sine', 0.2), 300);\n}\n\nexport function resumeAudio() {\n    if (audioCtx && audioCtx.state === 'suspended') {\n        audioCtx.resume();\n    }\n}", "src/tile.js": "import { TILE_COLORS, TILE_SIZE, CELL_SIZE } from './constants.js';\n\nexport class Tile {\n    constructor(col, row, value) {\n        this.col = col;\n        this.row = row;\n        this.value = value;\n        this.targetCol = col;\n        this.targetRow = row;\n        this.x = col * CELL_SIZE;\n        this.y = row * CELL_SIZE;\n        this.scale = 1;\n        this.spawnScale = 0.6;\n        this.mergeScale = 1;\n        this.alpha = 1;\n        this.isNew = true;\n        this.isMerging = false;\n        this.mergingInto = null;\n        this.animProgress = 0;\n    }\n    \n    get colors() {\n        return TILE_COLORS[this.value] || TILE_COLORS[2048];\n    }\n    \n    getFontSize() {\n        const digits = this.value.toString().length;\n        if (this.value <= 64) return 28;\n        if (this.value <= 512) return 24;\n        return 22;\n    }\n    \n    update(dt) {\n        // Spawn animation\n        if (this.isNew) {\n            this.spawnScale = Math.min(1, this.spawnScale + dt * 8.33);\n            if (this.spawnScale >= 1) {\n                this.isNew = false;\n                this.spawnScale = 1;\n            }\n        }\n        \n        // Merge pulse animation\n        if (this.isMerging) {\n            this.animProgress += dt * 1000;\n            const t = Math.min(1, this.animProgress / 180);\n            this.mergeScale = 1 + 0.15 * Math.sin(t * Math.PI);\n            if (t >= 1) {\n                this.isMerging = false;\n                this.mergeScale = 1;\n            }\n        }\n        \n        // Position interpolation\n        const targetX = this.targetCol * CELL_SIZE;\n        const targetY = this.targetRow * CELL_SIZE;\n        const ease = 0.25;\n        this.x += (targetX - this.x) * ease;\n        this.y += (targetY - this.y) * ease;\n        \n        this.col = this.targetCol;\n        this.row = this.targetRow;\n    }\n    \n    setTarget(col, row) {\n        this.targetCol = col;\n        this.targetRow = row;\n    }\n    \n    triggerMerge() {\n        this.isMerging = true;\n        this.animProgress = 0;\n    }\n}", "src/effects.js": "import { CELL_SIZE } from './constants.js';\n\nexport class Particle {\n    constructor(x, y, color) {\n        this.x = x;\n        this.y = y;\n        this.color = color;\n        const angle = Math.random() * Math.PI * 2;\n        const speed = 80 + Math.random() * 60;\n        this.vx = Math.cos(angle) * speed;\n        this.vy = Math.sin(angle) * speed;\n        this.gravity = 220;\n        this.lifetime = 450;\n        this.age = 0;\n        this.size = 4;\n        this.alpha = 1;\n    }\n    \n    update(dt) {\n        this.age += dt * 1000;\n        const t = this.age / this.lifetime;\n        this.alpha = 1 - t;\n        this.size = 4 - 3 * t;\n        this.vy += this.gravity * dt;\n        this.x += this.vx * dt;\n        this.y += this.vy * dt;\n        return this.age < this.lifetime;\n    }\n}\n\nexport class ScorePopup {\n    constructor(x, y, value) {\n        this.x = x;\n        this.y = y;\n        this.startY = y;\n        this.value = value;\n        this.lifetime = 600;\n        this.age = 0;\n        this.alpha = 1;\n    }\n    \n    update(dt) {\n        this.age += dt * 1000;\n        const t = this.age / this.lifetime;\n        this.alpha = 1 - t;\n        this.y = this.startY - 24 * t;\n        return this.age < this.lifetime;\n    }\n}\n\nexport class ComboText {\n    constructor(text) {\n        this.text = text;\n        this.scale = 0;\n        this.alpha = 1;\n        this.phase = 'in';\n        this.age = 0;\n        this.duration = 260 + 400;\n    }\n    \n    update(dt) {\n        this.age += dt * 1000;\n        \n        if (this.phase === 'in') {\n            this.scale = Math.min(1.2, this.scale + dt * 12);\n            if (this.scale >= 1.2) {\n                this.phase = 'settle';\n            }\n        } else if (this.phase === 'settle') {\n            this.scale = Math.max(1, this.scale - dt * 4);\n            if (this.scale <= 1) {\n                this.phase = 'out';\n                this.outStart = this.age;\n            }\n        } else {\n            const outT = (this.age - this.outStart) / 400;\n            this.alpha = Math.max(0, 1 - outT);\n        }\n        \n        return this.age < this.duration;\n    }\n}\n\nexport class EffectsManager {\n    constructor() {\n        this.particles = [];\n        this.scorePopups = [];\n        this.comboTexts = [];\n    }\n    \n    spawnMergeBurst(x, y, color) {\n        for (let i = 0; i < 8; i++) {\n            this.particles.push(new Particle(x, y, color));\n        }\n    }\n    \n    spawnScorePopup(x, y, value) {\n        this.scorePopups.push(new ScorePopup(x, y, value));\n    }\n    \n    showCombo(chainDepth) {\n        if (chainDepth >= 2 && chainDepth <= 5) {\n            const names = ['', '', 'DOUBLE!', 'TRIPLE!', 'QUAD!', 'MEGA!'];\n            this.comboTexts.push(new ComboText(names[chainDepth]));\n        }\n    }\n    \n    update(dt) {\n        this.particles = this.particles.filter(p => p.update(dt));\n        this.scorePopups = this.scorePopups.filter(s => s.update(dt));\n        this.comboTexts = this.comboTexts.filter(c => c.update(dt));\n    }\n    \n    draw(ctx) {\n        // Draw particles\n        for (const p of this.particles) {\n            ctx.save();\n            ctx.globalAlpha = p.alpha;\n            ctx.fillStyle = p.color;\n            ctx.beginPath();\n            ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);\n            ctx.fill();\n            ctx.restore();\n        }\n    }\n}", "src/input.js": "export class InputHandler {\n    constructor(canvas) {\n        this.canvas = canvas;\n        this.leftPressed = false;\n        this.rightPressed = false;\n        this.downPressed = false;\n        this.moveDirection = 0;\n        this.lastMoveTime = 0;\n        this.touchStartX = 0;\n        this.touchStartY = 0;\n        this.touchStartTime = 0;\n        this.isSwiping = false;\n        this.swipeThreshold = 30;\n        this.tapTime = 0;\n        this.twoFingerTap = false;\n        \n        this.setupKeyboard();\n        this.setupTouch();\n    }\n    \n    setupKeyboard() {\n        window.addEventListener('keydown', (e) => {\n            if (e.repeat) return;\n            switch(e.code) {\n                case 'ArrowLeft':\n                    this.leftPressed = true;\n                    this.moveDirection = -1;\n                    e.preventDefault();\n                    break;\n                case 'ArrowRight':\n                    this.rightPressed = true;\n                    this.moveDirection = 1;\n                    e.preventDefault();\n                    break;\n                case 'ArrowDown':\n                    this.downPressed = true;\n                    e.preventDefault();\n                    break;\n                case 'Space':\n                    this.tapTime = performance.now();\n                    e.preventDefault();\n                    break;\n                case 'KeyP':\n                case 'Escape':\n                    this.twoFingerTap = true;\n                    e.preventDefault();\n                    break;\n            }\n        });\n        \n        window.addEventListener('keyup', (e) => {\n            switch(e.code) {\n                case 'ArrowLeft':\n                    this.leftPressed = false;\n                    if (!this.rightPressed) this.moveDirection = 0;\n                    else this.moveDirection = 1;\n                    break;\n                case 'ArrowRight':\n                    this.rightPressed = false;\n                    if (!this.leftPressed) this.moveDirection = 0;\n                    else this.moveDirection = -1;\n                    break;\n                case 'ArrowDown':\n                    this.downPressed = false;\n                    break;\n            }\n        });\n    }\n    \n    setupTouch() {\n        this.canvas.addEventListener('touchstart', (e) => {\n            if (e.touches.length === 2) {\n                this.twoFingerTap = true;\n                e.preventDefault();\n                return;\n            }\n            const touch = e.touches[0];\n            this.touchStartX = touch.clientX;\n            this.touchStartY = touch.clientY;\n            this.touchStartTime = performance.now();\n            this.isSwiping = false;\n            e.preventDefault();\n        }, { passive: false });\n        \n        this.canvas.addEventListener('touchmove', (e) => {\n            if (e.touches.length > 1) return;\n            const touch = e.touches[0];\n            const dx = touch.clientX - this.touchStartX;\n            const dy = touch.clientY - this.touchStartY;\n            \n            if (!this.isSwiping && (Math.abs(dx) > this.swipeThreshold || Math.abs(dy) > this.swipeThreshold)) {\n                this.isSwiping = true;\n            }\n            \n            if (this.isSwiping) {\n                if (Math.abs(dx) > Math.abs(dy)) {\n                    this.moveDirection = dx > 0 ? 1 : -1;\n                } else if (dy > this.swipeThreshold) {\n                    this.downPressed = true;\n                }\n            }\n            e.preventDefault();\n        }, { passive: false });\n        \n        this.canvas.addEventListener('touchend', (e) => {\n            if (e.touches.length > 0) return;\n            const elapsed = performance.now() - this.touchStartTime;\n            \n            if (!this.isSwiping && elapsed < 300) {\n                this.tapTime = performance.now();\n            }\n            \n            this.downPressed = false;\n            this.moveDirection = 0;\n            this.isSwiping = false;\n        });\n    }\n    \n    consumeHardDrop() {\n        const now = performance.now();\n        if (now - this.tapTime < 200) {\n            this.tapTime = 0;\n            return true;\n        }\n        return false;\n    }\n    \n    consumePause() {\n        if (this.twoFingerTap) {\n            this.twoFingerTap = false;\n            return true;\n        }\n        return false;\n    }\n    \n    shouldSoftDrop() {\n        return this.downPressed;\n    }\n    \n    getMoveDirection() {\n        return this.moveDirection;\n    }\n    \n    reset() {\n        this.twoFingerTap = false;\n    }\n}", "src/renderer.js": "import { GRID_COLS, GRID_ROWS, CELL_SIZE, TILE_SIZE, PLAYFIELD_OFFSET_X, PLAYFIELD_OFFSET_Y, CANVAS_WIDTH, CANVAS_HEIGHT, COLORS } from './constants.js';\nimport { TILE_COLORS } from './constants.js';\n\nexport class Renderer {\n    constructor(ctx) {\n        this.ctx = ctx;\n        this.parallaxOffset = 0;\n    }\n    \n    clear() {\n        const gradient = this.ctx.createLinearGradient(0, 0, 0, CANVAS_HEIGHT);\n        gradient.addColorStop(0, COLORS.bgTop);\n        gradient.addColorStop(1, COLORS.bgBottom);\n        this.ctx.fillStyle = gradient;\n        this.ctx.fillRect(0, 0, CANVAS_WIDTH, CANVAS_HEIGHT);\n    }\n    \n    drawParallax(dt) {\n        this.parallaxOffset = (this.parallaxOffset + 4 * dt) % 100;\n        \n        this.ctx.save();\n        this.ctx.globalAlpha = 0.3;\n        \n        // Draw diagonal stripes\n        const drawStripes = (color, offset, spacing) => {\n            this.ctx.fillStyle = color;\n            for (let i = -1; i < 15; i++) {\n                const x = (i * spacing + this.parallaxOffset + offset) % (CANVAS_WIDTH + 100) - 50;\n                this.ctx.beginPath();\n                this.ctx.moveTo(x, 0);\n                this.ctx.lineTo(x + 20, 0);\n                this.ctx.lineTo(x + 20 + CANVAS_HEIGHT * 0.3, CANVAS_HEIGHT);\n                this.ctx.lineTo(x + CANVAS_HEIGHT * 0.3, CANVAS_HEIGHT);\n                this.ctx.fill();\n            }\n        };\n        \n        drawStripes(COLORS.parallax1, 0, 80);\n        drawStripes(COLORS.parallax2, 30, 100);\n        drawStripes(COLORS.parallax3, 60, 120);\n        \n        this.ctx.restore();\n    }\n    \n    drawGrid() {\n        this.ctx.save();\n        this.ctx.translate(PLAYFIELD_OFFSET_X, PLAYFIELD_OFFSET_Y);\n        \n        // Draw cell backgrounds\n        this.ctx.strokeStyle = COLORS.gridLine;\n        this.ctx.lineWidth = 1;\n        \n        for (let row = 0; row < GRID_ROWS; row++) {\n            for (let col = 0; col < GRID_COLS; col++) {\n                const x = col * CELL_SIZE;\n                const y = row * CELL_SIZE;\n                this.ctx.strokeRect(x, y, CELL_SIZE, CELL_SIZE);\n            }\n        }\n        \n        this.ctx.restore();\n    }\n    \n    drawTile(tile, offsetX = 0, offsetY = 0) {\n        const x = PLAYFIELD_OFFSET_X + tile.x + (CELL_SIZE - TILE_SIZE) / 2 + offsetX;\n        const y = PLAYFIELD_OFFSET_Y + tile.y + (CELL_SIZE - TILE_SIZE) / 2 + offsetY;\n        const colors = tile.colors;\n        const scale = tile.spawnScale * tile.mergeScale;\n        const size = TILE_SIZE * scale;\n        \n        this.ctx.save();\n        this.ctx.globalAlpha = tile.alpha;\n        this.ctx.translate(x + TILE_SIZE / 2, y + TILE_SIZE / 2);\n        \n        // Drop shadow\n        this.ctx.shadowColor = 'rgba(0,0,0,0.35)';\n        this.ctx.shadowBlur = 6;\n        this.ctx.shadowOffsetY = 2;\n        \n        // Tile background with inner gradient\n        const gradient = this.ctx.createLinearGradient(0, -size / 2, 0, size / 2);\n        const baseColor = colors.fill;\n        gradient.addColorStop(0, this.lightenColor(baseColor, 0.08));\n        gradient.addColorStop(0.6, baseColor);\n        gradient.addColorStop(1, this.darkenColor(baseColor, 0.08));\n        \n        this.ctx.fillStyle = gradient;\n        this.roundRect(-size / 2, -size / 2, size, size, 8 * scale);\n        this.ctx.fill();\n        \n        // Border\n        this.ctx.shadowColor = 'transparent';\n        this.ctx.strokeStyle = colors.border;\n        this.ctx.lineWidth = 2;\n        this.roundRect(-size / 2, -size / 2, size, size, 8 * scale);\n        this.ctx.stroke();\n        \n        // Text\n        this.ctx.fillStyle = colors.text;\n        this.ctx.textAlign = 'center';\n        this.ctx.textBaseline = 'middle';\n        this.ctx.font = `600 ${tile.getFontSize() * scale}px -apple-system, BlinkMacSystemFont, sans-serif`;\n        this.ctx.fillText(tile.value.toString(), 0, 2);\n        \n        this.ctx.restore();\n    }\n    \n    drawHUD(score, bestScore, nextValue, speedMultiplier, gameTime) {\n        this.ctx.save();\n        \n        // Top bar background\n        this.ctx.fillStyle = COLORS.hudBg;\n        this.ctx.fillRect(0, 0, CANVAS_WIDTH, PLAYFIELD_OFFSET_Y - 4);\n        this.ctx.strokeStyle = COLORS.hudBorder;\n        this.ctx.lineWidth = 1;\n        this.ctx.beginPath();\n        this.ctx.moveTo(0, PLAYFIELD_OFFSET_Y - 4);\n        this.ctx.lineTo(CANVAS_WIDTH, PLAYFIELD_OFFSET_Y - 4);\n        this.ctx.stroke();\n        \n        // Score\n        this.ctx.fillStyle = COLORS.textDim;\n        this.ctx.font = '12px -apple-system, sans-serif';\n        this.ctx.textAlign = 'left';\n        this.ctx.letterSpacing = '2px';\n        this.ctx.fillText('SCORE', 16, 24);\n        \n        this.ctx.fillStyle = COLORS.textWhite;\n        this.ctx.font = '700 28px -apple-system, sans-serif';\n        this.ctx.fillText(score.toString(), 16, 56);\n        \n        // Best\n        this.ctx.fillStyle = COLORS.textDim;\n        this.ctx.font = '12px -apple-system, sans-serif';\n        this.ctx.textAlign = 'center';\n        this.ctx.fillText('BEST', CANVAS_WIDTH / 2, 24);\n        \n        this.ctx.fillStyle = COLORS.accent;\n        this.ctx.font = '700 28px -apple-system, sans-serif';\n        this.ctx.fillText(bestScore.toString(), CANVAS_WIDTH / 2, 56);\n        \n        // Timer\n        this.ctx.fillStyle = COLORS.textDim;\n        this.ctx.font = '10px -apple-system, sans-serif';\n        this.ctx.textAlign = 'right';\n        this.ctx.fillText('TIME', CANVAS_WIDTH - 16, 24);\n        \n        const minutes = Math.floor(gameTime / 60000);\n        const seconds = Math.floor((gameTime % 60000) / 1000);\n        const ms = Math.floor((gameTime % 1000) / 10);\n        const timeStr = `${minutes.toString().padStart(2, '0')}:${seconds.toString().padStart(2, '0')}.${ms.toString().padStart(2, '0')}`;\n        \n        this.ctx.fillStyle = '#4FB3FF';\n        this.ctx.font = '600 18px -apple-system, sans-serif';\n        this.ctx.fillText(timeStr, CANVAS_WIDTH - 16, 48);\n        \n        // Next tile preview\n        const previewX = CANVAS_WIDTH - 100;\n        const previewY = 64;\n        \n        this.ctx.fillStyle = COLORS.textDim;\n        this.ctx.font = '10px -apple-system, sans-serif';\n        this.ctx.textAlign = 'left';\n        this.ctx.fillText('NEXT', previewX, previewY);\n        \n        this.drawPreviewTile(previewX + 32, previewY + 24, nextValue);\n        \n        // Speed meter\n        const meterX = previewX;\n        const meterY = previewY + 48;\n        \n        this.ctx.fillStyle = COLORS.textDim;\n        this.ctx.font = '10px -apple-system, sans-serif';\n        this.ctx.fillText('SPEED', meterX, meterY);\n        \n        // Meter bar\n        const meterWidth = 80;\n        const meterHeight = 4;\n        const fillRatio = Math.min(1, (speedMultiplier - 1) / (3 - 1));\n        \n        this.ctx.fillStyle = 'rgba(255,255,255,0.1)';\n        this.roundRect(meterX, meterY + 4, meterWidth, meterHeight, 2);\n        this.ctx.fill();\n        \n        // Gradient fill\n        const fillGradient = this.ctx.createLinearGradient(meterX, 0, meterX + meterWidth, 0);\n        fillGradient.addColorStop(0, '#4FB3FF');\n        fillGradient.addColorStop(0.5, '#FFD93D');\n        fillGradient.addColorStop(1, '#FF5C8A');\n        \n        this.ctx.fillStyle = fillGradient;\n        this.roundRect(meterX, meterY + 4, meterWidth * fillRatio, meterHeight, 2);\n        this.ctx.fill();\n        \n        this.ctx.restore();\n    }\n    \n    drawPreviewTile(x, y, value) {\drawPreviewTile(x, y, value) {
        const colors = TILE_COLORS[value] || TILE_COLORS[2048];
        const size = 40;
        
        this.ctx.save();
        
        // Tile background
        const gradient = this.ctx.createLinearGradient(0, -size / 2, 0, size / 2);
        const baseColor = colors.fill;
        gradient.addColorStop(0, this.lightenColor(baseColor, 0.08));
        gradient.addColorStop(0.6, baseColor);
        gradient.addColorStop(1, this.darkenColor(baseColor, 0.08));
        
        this.ctx.fillStyle = gradient;
        this.roundRect(x - size / 2, y - size / 2, size, size, 6);
        this.ctx.fill();
        
        // Border
        this.ctx.strokeStyle = colors.border;
        this.ctx.lineWidth = 2;
        this.roundRect(x - size / 2, y - size / 2, size, size, 6);
        this.ctx.stroke();
        
        // Text
        this.ctx.fillStyle = colors.text;
        this.ctx.textAlign = 'center';
        this.ctx.textBaseline = 'middle';
        const fontSize = value >= 1000 ? 14 : 16;
        this.ctx.font = `600 ${fontSize}px -apple-system, BlinkMacSystemFont, sans-serif`;
        this.ctx.fillText(value.toString(), x, y);
        
        this.ctx.restore();
    }
    
    drawPauseOverlay() {
        this.ctx.save();
        this.ctx.fillStyle = 'rgba(15, 23, 41, 0.85)';
        this.ctx.fillRect(0, 0, CANVAS_WIDTH, CANVAS_HEIGHT);
        
        this.ctx.fillStyle = COLORS.textWhite;
        this.ctx.font = '700 36px -apple-system, sans-serif';
        this.ctx.textAlign = 'center';
        this.ctx.textBaseline = 'middle';
        this.ctx.shadowColor = 'rgba(255,255,255,0.3)';
        this.ctx.shadowBlur = 20;
        this.ctx.fillText('PAUSED', CANVAS_WIDTH / 2, CANVAS_HEIGHT / 2 - 20);
        
        this.ctx.shadowBlur = 0;
        this.ctx.font = '16px -apple-system, sans-serif';
        this.ctx.fillStyle = COLORS.textDim;
        this.ctx.fillText('Tap or press P to resume', CANVAS_WIDTH / 2, CANVAS_HEIGHT / 2 + 30);
        
        this.ctx.restore();
    }
    
    drawGameOverOverlay(score, bestScore, highScore, gameTime) {
        this.ctx.save();
        
        const gradient = this.ctx.createLinearGradient(0, CANVAS_HEIGHT / 2 - 150, 0, CANVAS_HEIGHT / 2 + 100);
        gradient.addColorStop(0, 'rgba(15, 23, 41, 0)');
        gradient.addColorStop(0.5, 'rgba(15, 23, 41, 0.95)');
        gradient.addColorStop(1, 'rgba(15, 23, 41, 0.98)');
        this.ctx.fillStyle = gradient;
        this.ctx.fillRect(0, 0, CANVAS_WIDTH, CANVAS_HEIGHT);
        
        const centerX = CANVAS_WIDTH / 2;
        const centerY = CANVAS_HEIGHT / 2;
        
        this.ctx.fillStyle = COLORS.danger;
        this.ctx.font = '700 42px -apple-system, sans-serif';
        this.ctx.textAlign = 'center';
        this.ctx.textBaseline = 'middle';
        this.ctx.shadowColor = 'rgba(255, 92, 138, 0.5)';
        this.ctx.shadowBlur = 30;
        this.ctx.fillText('GAME OVER', centerX, centerY - 90);
        
        this.ctx.shadowBlur = 0;
        this.ctx.fillStyle = COLORS.textDim;
        this.ctx.font = '14px -apple-system, sans-serif';
        this.ctx.fillText('SCORE', centerX, centerY - 30);
        
        this.ctx.fillStyle = COLORS.textWhite;
        this.ctx.font = '700 36px -apple-system, sans-serif';
        this.ctx.fillText(score.toString(), centerX, centerY + 10);
        
        if (highScore) {
            this.ctx.fillStyle = COLORS.accent;
            this.ctx.font = '600 18px -apple-system, sans-serif';
            this.ctx.fillText('NEW HIGH SCORE!', centerX, centerY + 55);
        } else {
            this.ctx.fillStyle = COLORS.textDim;
            this.ctx.font = '14px -apple-system, sans-serif';
            this.ctx.fillText(`BEST: ${bestScore}`, centerX, centerY + 55);
        }
        
        const minutes = Math.floor(gameTime / 60000);
        const seconds = Math.floor((gameTime % 60000) / 1000);
        this.ctx.fillStyle = '#4FB3FF';
        this.ctx.font = '600 16px -apple-system, sans-serif';
        this.ctx.fillText(`${minutes}:${seconds.toString().padStart(2, '0')}`, centerX, centerY + 90);
        
        this.ctx.fillStyle = COLORS.textDim;
        this.ctx.font = '14px -apple-system, sans-serif';
        this.ctx.globalAlpha = 0.5 + 0.5 * Math.sin(Date.now() / 300);
        this.ctx.fillText('TAP TO CONTINUE', centerX, centerY + 140);
        
        this.ctx.restore();
    }
    
    drawComboTexts() {
        const centerX = CANVAS_WIDTH / 2;
        const centerY = CANVAS_HEIGHT / 2;
        
        for (const combo of this.effectsManager.comboTexts) {
            this.ctx.save();
            this.ctx.globalAlpha = combo.alpha;
            this.ctx.translate(centerX, centerY - 60);
            this.ctx.scale(combo.scale, combo.scale);
            
            this.ctx.fillStyle = COLORS.accent;
            this.ctx.font = '700 28px -apple-system, sans-serif';
            this.ctx.textAlign = 'center';
            this.ctx.textBaseline = 'middle';
            this.ctx.shadowColor = 'rgba(255, 217, 61, 0.6)';
            this.ctx.shadowBlur = 15;
            this.ctx.fillText(combo.text, 0, 0);
            
            this.ctx.restore();
        }
    }
    
    roundRect(x, y, w, h, r) {
        this.ctx.beginPath();
        this.ctx.moveTo(x + r, y);
        this.ctx.lineTo(x + w - r, y);
        this.ctx.quadraticCurveTo(x + w, y, x + w, y + r);
        this.ctx.lineTo(x + w, y + h - r);
        this.ctx.quadraticCurveTo(x + w, y + h, x + w - r, y + h);
        this.ctx.lineTo(x + r, y + h);
        this.ctx.quadraticCurveTo(x, y + h, x, y + h - r);
        this.ctx.lineTo(x, y + r);
        this.ctx.quadraticCurveTo(x, y, x + r, y);
        this.ctx.closePath();
    }
    
    lightenColor(hex, amount) {
        const num = parseInt(hex.replace('#', ''), 16);
        const r = Math.min(255, (num >> 16) + Math.round(255 * amount));
        const g = Math.min(255, ((num >> 8) & 0x00FF) + Math.round(255 * amount));
        const b = Math.min(255, (num & 0x0000FF) + Math.round(255 * amount));
        return `rgb(${r},${g},${b})`;
    }
    
    darkenColor(hex, amount) {
        const num = parseInt(hex.replace('#', ''), 16);
        const r = Math.max(0, (num >> 16) - Math.round(255 * amount));
        const g = Math.max(0, ((num >> 8) & 0x00FF) - Math.round(255 * amount));
        const b = Math.max(0, (num & 0x0000FF) - Math.round(255 * amount));
        return `rgb(${r},${g},${b})`;
    }
}", "src/game.js": "import { GRID_COLS, GRID_ROWS, CELL_SIZE, PLAYFIELD_OFFSET_X, PLAYFIELD_OFFSET_Y, CANVAS_WIDTH, CANVAS_HEIGHT, SPAWN_WEIGHTS, BASE_FALL_SPEED, HORIZONTAL_MOVE_SPEED, HARD_DROP_SPEED, SPEED_INCREASE_INTERVAL, SPEED_INCREASE_FACTOR, MAX_SPEED_MULTIPLIER, BASE_SCORE_MULTIPLIER, CHAIN_BONUS_MULTIPLIER, SPAWN_DELAY, MERGE_ANIM_DURATION, TILE_TWEEN_DURATION, LANDING_SMOOTH_DURATION } from './constants.js';\nimport { Tile } from './tile.js';\nimport { loadHighScore, saveHighScore } from './storage.js';\nimport { playDropSound, playMergeSound, playGameOverSound, resumeAudio } from './audio.js';\n\nexport class Game {\n    constructor(canvas) {\n        this.canvas = canvas;\n        this.grid = [];\n        this.tiles = [];\n        this.currentTile = null;\n        this.score = 0;\n        this.bestScore = loadHighScore();\n        this.highScore = false;\n        this.gameState = 'idle';\n        this.gameTime = 0;\n        this.spawnTime = 0;\n        this.lastTime = 0;\n        this.speedMultiplier = 1;\n        this.mergeCount = 0;\n        this.chainDepth = 0;\n        this.nextValue = 2;\n        this.pendingDrop = false;\n        this.fallSpeed = BASE_FALL_SPEED;\n        this.tileFallProgress = 0;\n        this.moveDirection = 0;\n        this.lastMoveTime = 0;\n    }\n    \n    init() {\n        this.grid = Array.from({ length: GRID_ROWS }, () => Array(GRID_COLS).fill(null));\n        this.tiles = [];\n        this.currentTile = null;\n        this.score = 0;\n        this.gameTime = 0;\n        this.spawnTime = 0;\n        this.highScore = false;\n        this.speedMultiplier = 1;\n        this.mergeCount = 0;\n        this.chainDepth = 0;\n        this.nextValue = this.getNextSpawnValue();\n        this.pendingDrop = false;\n        this.fallSpeed = BASE_FALL_SPEED;\n        this.tileFallProgress = 0;\n        this.moveDirection = 0;\n        this.lastMoveTime = 0;\n        this.scheduleSpawn();\n    }\n    \n    getNextSpawnValue() {\n        const total = SPAWN_WEIGHTS.reduce((sum, w) => sum + w.weight, 0);\n        let rand = Math.random() * total;\n        for (const w of SPAWN_WEIGHTS) {\n            rand -= w.weight;\n            if (rand <= 0) return w.value;\n        }\n        return SPAWN_WEIGHTS[0].value;\n    }\n    \n    canMove(tile, targetCol) {\n        if (targetCol < 0 || targetCol >= GRID_COLS) return false;\n        const targetRow = tile.targetRow;\n        const existing = this.grid[targetRow][targetCol];\n        if (existing && existing !== tile) return false;\n        return true;\n    }\n    \n    scheduleSpawn() {\n        this.spawnTime = this.gameTime + SPAWN_DELAY;\n    }\n    \n    trySpawnTile() {\n        const col = Math.floor(GRID_COLS / 2);\n        const value = this.nextValue;\n        this.nextValue = this.getNextSpawnValue();\n        const tile = new Tile(col, -1, value);\n        tile.x = col * CELL_SIZE;\n        tile.y = -1 * CELL_SIZE;\n        \n        if (this.grid[0][col]) {\n            this.gameOver();\n            return;\n        }\n        \n        this.currentTile = tile;\n        this.tiles.push(tile);\n        this.tileFallProgress = 0;\n    }\n    \n    placeTile(tile) {\n        const col = tile.targetCol;\n        const row = tile.targetRow;\n        \n        this.grid[row][col] = tile;\n        tile.col = col;\n        tile.row = row;\n        tile.x = col * CELL_SIZE;\n        tile.y = row * CELL_SIZE;\n        tile.spawnScale = 1;\n        \n        playDropSound();\n        \n        this.currentTile = null;\n        this.chainDepth = 0;\n        this.checkMerges(tile);\n    }\n    \n    checkMerges(tile) {\n        const row = tile.row;\n        const col = tile.col;\n        const value = tile.value;\n        \n        const directions = [[0, 1], [1, 0], [0, -1], [-1, 0]];\n        const neighbors = [];\n        \n        for (const [dr, dc] of directions) {\n            const nr = row + dr;\n            const nc = col + dc;\n            if (nr >= 0 && nr < GRID_ROWS && nc >= 0 && nc < GRID_COLS) {\n                const neighbor = this.grid[nr][nc];\n                if (neighbor && neighbor.value === value) {\n                    neighbors.push(neighbor);\n                }\n            }\n        }\n        \n        if (neighbors.length > 0) {\n            this.chainDepth++;\n            \n            for (const neighbor of neighbors) {\n                const mergedValue = value * 2;\n                \n                this.grid[neighbor.row][neighbor.col] = null;\n                neighbor.alpha = 0;\n                neighbor.mergingInto = tile;\n                \n                tile.value = mergedValue;\n                tile.triggerMerge();\n                \n                const px = PLAYFIELD_OFFSET_X + neighbor.x + CELL_SIZE / 2;\n                const py = PLAYFIELD_OFFSET_Y + neighbor.y + CELL_SIZE / 2;\n                \n                this.spawnMergeParticles(px, py, tile.colors.fill);\n                \n                const bonus = Math.floor(mergedValue * BASE_SCORE_MULTIPLIER * Math.pow(CHAIN_BONUS_MULTIPLIER, this.chainDepth - 1));\n                this.score += bonus;\n                this.mergeCount++;\n                \n                if (this.score > this.bestScore) {\n                    this.bestScore = this.score;\n                    saveHighScore(this.bestScore);\n                }\n                \n                if (this.mergeCount % SPEED_INCREASE_INTERVAL === 0) {\n                    this.speedMultiplier = Math.min(MAX_SPEED_MULTIPLIER, this.speedMultiplier * SPEED_INCREASE_FACTOR);\n                }\n                \n                this.fallSpeed = BASE_FALL_SPEED / this.speedMultiplier;\n                \n                const popupX = PLAYFIELD_OFFSET_X + tile.x + CELL_SIZE / 2;\n                const popupY = PLAYFIELD_OFFSET_Y + tile.y + CELL_SIZE / 2;\n                \n                playMergeSound(mergedValue, this.chainDepth);\n                \n                this.scheduleSpawn();\n            }\n            \n            if (this.chainDepth >= 2) {\n                this.showCombo();\n            }\n        } else {\n            this.scheduleSpawn();\n        }\n    }\n    \n    spawnMergeParticles(x, y, color) {\n        // Implementation in effects manager\n    }\n    \n    showCombo() {\n        // Implementation in effects manager\n    }\n    \n    applyGravity() {\n        let moved = false;\n        for (let row = GRID_ROWS - 2; row >= 0; row--) {\n            for (let col = 0; col < GRID_COLS; col++) {\n                const tile = this.grid[row][col];\n                if (tile) {\n                    let targetRow = row;\n                    while (targetRow < GRID_ROWS - 1 && !this.grid[targetRow + 1][col]) {\n                        targetRow++;\n                        moved = true;\n                    }\n                    if (targetRow !== row) {\n                        this.grid[row][col] = null;\n                        this.grid[targetRow][col] = tile;\n                        tile.setTarget(col, targetRow);\n                    }\n                }\n            }\n        }\n        return moved;\n    }\n    \n    gameOver() {\n        this.gameState = 'gameover';\n        if (this.score >= this.bestScore) {\n            this.highScore = true;\n        }\n        playGameOverSound();\n    }\n    \n    update(dt) {\n        if (this.gameState !== 'playing') return;\n        \n        this.gameTime += dt * 1000;\n        \n        if (this.currentTile) {\n            this.tileFallProgress += dt * 1000;\n            const progress = this.tileFallProgress / this.fallSpeed;\n            const targetRow = Math.floor(progress);\n            const fractional = progress - targetRow;\n            \n            let finalRow = -1;\n            for (let r = -1; r <= targetRow; r++) {\n                if (r >= 0 && r < GRID_ROWS && this.grid[r][this.currentTile.targetCol]) {\n                    finalRow = r - 1;\n                    break;\n                }\n                finalRow = r;\n            }\n            \n            if (finalRow < -1) finalRow = -1;\n            if (finalRow >= GRID_ROWS) finalRow = GRID_ROWS - 1;\n            \n            this.currentTile.targetRow = finalRow;\n            this.currentTile.y = finalRow * CELL_SIZE + fractional * CELL_SIZE * 0.1;\n        }\n        \n        if (this.gameTime >= this.spawnTime && !this.currentTile) {\n            this.applyGravity();\n            \n            setTimeout(() => {\n                this.trySpawnTile();\n            }, 50);\n            this.spawnTime = Infinity;\n        }\n        \n        for (const tile of this.tiles) {\n            tile.update(dt);\n        }\n        \n        this.tiles = this.tiles.filter(t => t.alpha > 0);\n    }\n    \n    moveHorizontal(dir) {\n        if (!this.currentTile || this.gameState !== 'playing') return;\n        \n        const newCol = this.currentTile.targetCol + dir;\n        if (this.canMove(this.currentTile, newCol)) {\n            this.currentTile.setTarget(newCol, this.currentTile.targetRow);\n        }\n    }\n    \n    softDrop() {\n        if (!this.currentTile || this.gameState !== 'playing') return;\n        this.tileFallProgress += (BASE_FALL_SPEED / HARD_DROP_SPEED) * 16.67;\n    }\n    \n    hardDrop() {\n        if (!this.currentTile || this.gameState !== 'playing') return;\n        \n        while (!this.pendingDrop) {\n            const newRow = this.currentTile.targetRow + 1;\n            if (newRow >= GRID_ROWS || (this.grid[newRow] && this.grid[newRow][this.currentTile.targetCol])) {\n                this.pendingDrop = true;\n                break;\n            }\n            this.currentTile.targetRow = newRow;\n            this.tileFallProgress = this.fallSpeed;\n        }\n    }\n    \n    checkLanding() {\n        if (!this.currentTile || this.gameState !== 'playing') return;\n        \n        if (this.pendingDrop || this.tileFallProgress >= this.fallSpeed) {\n            const targetRow = this.currentTile.targetRow;\n            \n            if (targetRow < 0) {\n                this.gameOver();\n                return;\n            }\n            \n            if (targetRow >= GRID_ROWS || this.grid[targetRow][this.currentTile.targetCol]) {\n                const landRow = targetRow - 1;\n                if (landRow >= 0 && !this.grid[landRow][this.currentTile.targetCol]) {\n                    this.currentTile.setTarget(this.currentTile.targetCol, landRow);\n                    this.placeTile(this.currentTile);\n                } else {\n                    this.gameOver();\n                }\n            } else {\n                this.placeTile(this.currentTile);\n            }\n            \n            this.pendingDrop = false;\n        }\n    }\n}", "src/main.js": "import { CANVAS_WIDTH, CANVAS_HEIGHT } from './constants.js';\nimport { Game } from './game.js';\nimport { InputHandler } from './input.js';\nimport { Renderer } from './renderer.js';\nimport { EffectsManager } from './effects.js';\nimport { loadHighScore } from './storage.js';\nimport { resumeAudio, playMergeSound } from './audio.js';\n\nconst canvas = document.getElementById('gameCanvas');\nconst ctx = canvas.getContext('2d');\nconst startScreen = document.getElementById('startScreen');\nconst startBtn = document.getElementById('startBtn');\n\ncanvas.width = CANVAS_WIDTH;\ncanvas.height = CANVAS_HEIGHT;\n\nconst input = new InputHandler(canvas);\nconst renderer = new Renderer(ctx);\nconst effectsManager = new EffectsManager();\nconst game = new Game(canvas);\n\ngame.bestScore = loadHighScore();\n\nlet lastTime = 0;\nlet gameStarted = false;\n\nfunction gameLoop(timestamp) {\n    const dt = Math.min((timestamp - lastTime) / 1000, 0.1);\n    lastTime = timestamp;\n    \n    if (game.gameState === 'playing') {\n        if (input.consumePause()) {\n            game.gameState = game.gameState === 'paused' ? 'playing' : 'paused';\n            if (game.gameState === 'playing') resumeAudio();\n        }\n        \n        const dir = input.getMoveDirection();\n        if (dir !== 0) {\n            const now = performance.now();\n            if (now - game.lastMoveTime > 1000 / 12) {\n                game.moveHorizontal(dir);\n                game.lastMoveTime = now;\n            }\n        }\n        \n        if (input.shouldSoftDrop()) {\n            game.softDrop();\n        }\n        \n        if (input.consumeHardDrop()) {\n            game.hardDrop();\n        }\n        \n        game.update(dt);\n        game.checkLanding();\n        effectsManager.update(dt);\n    }\n    \n    renderer.clear();\n    renderer.drawParallax(dt);\n    renderer.drawGrid();\n    \n    for (const tile of game.tiles) {\n        renderer.drawTile(tile);\n    }\n    \n    effectsManager.draw(ctx);\n    \n    if (game.gameState === 'playing' || game.gameState === 'paused') {\n        renderer.drawHUD(game.score, game.bestScore, game.nextValue, game.speedMultiplier, game.gameTime);\n    }\n    \n    if (game.gameState === 'paused') {\n        renderer.drawPauseOverlay();\n    }\n    \n    if (game.gameState === 'gameover') {\n        renderer.drawGameOverOverlay(game.score, game.bestScore, game.highScore, game.gameTime);\n    }\n    \n    if (game.gameState === 'playing') {\n        renderer.drawComboTexts();\n    }\n    \n    requestAnimationFrame(gameLoop);\n}\n\nfunction startGame() {\n    if (!gameStarted) {\n        resumeAudio();\n        gameStarted = true;\n    }\n    \n    startScreen