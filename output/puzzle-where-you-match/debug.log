inPath();\n            ctx.arc(0, 0, radius, 0, 2 * Math.PI);\n            ctx.strokeStyle = '#2A3558';\n            ctx.lineWidth = 3;\n            ctx.stroke();\n            \n            for (let s = 0; s < S; s++) {\n                if (locked[s]) continue;\n                const ang = (ring.angle + s * 2 * Math.PI / S) % (2 * Math.PI);\n                const x = Math.cos(ang) * radius;\n                const y = Math.sin(ang) * radius;\n                drawToken(x, y, ring.tokens[s], r, s, ang);\n            }\n        }\n        \n        ctx.beginPath();\n        ctx.arc(0, 0, hubR, 0, 2 * Math.PI);\n        ctx.fillStyle = '#FFE9A8';\n        ctx.fill();\n        \n        ctx.restore();\n    }\n    \n    function drawToken(x, y, type, ringIdx, slotIdx, ang) {\n        const size = 16;\n        ctx.save();\n        ctx.translate(x, y);\n        ctx.rotate(ang);\n        \n        if (type === 'void') {\n            ctx.strokeStyle = colors.void;\n            ctx.lineWidth = 2;\n            ctx.setLineDash([4, 4]);\n            ctx.beginPath();\n            ctx.arc(0, 0, size/2, 0, 2 * Math.PI);\n            ctx.stroke();\n            ctx.setLineDash([]);\n        } else {\n            ctx.fillStyle = colors[type];\n            ctx.strokeStyle = lighten(colors[type], 20);\n            ctx.lineWidth = 2;\n            \n            if (type === 'triangle') {\n                ctx.beginPath();\n                ctx.moveTo(0, -size/2);\n                ctx.lineTo(-size/2, size/2);\n                ctx.lineTo(size/2, size/2);\n                ctx.closePath();\n                ctx.fill();\n                ctx.stroke();\n            } else if (type === 'square') {\n                ctx.fillStyle = colors[type];\n                ctx.fillRect(-size/2, -size/2, size, size);\n                ctx.strokeStyle = lighten(colors[type], 20);\n                ctx.strokeRect(-size/2, -size/2, size, size);\n            } else if (type === 'pentagon') {\n                ctx.beginPath();\n                for (let i = 0; i < 5; i++) {\n                    const a = i * 2 * Math.PI / 5 - Math.PI/2;\n                    const px = Math.cos(a) * size/2;\n                    const py = Math.sin(a) * size/2;\n                    if (i === 0) ctx.moveTo(px, py);\n                    else ctx.lineTo(px, py);\n                }\n                ctx.closePath();\n                ctx.fill();\n                ctx.stroke();\n            } else if (type === 'hexagon') {\n                ctx.beginPath();\n                for (let i = 0; i < 6; i++) {\n                    const a = i * 2 * Math.PI / 6 - Math.PI/2;\n                    const px = Math.cos(a) * size/2;\n                    const py = Math.sin(a) * size/2;\n                    if (i === 0) ctx.moveTo(px, py);\n                    else ctx.lineTo(px, py);\n                }\n                ctx.closePath();\n                ctx.fill();\n                ctx.stroke();\n            } else if (type === 'circle') {\n                ctx.beginPath();\n                ctx.arc(0, 0, size/2, 0, 2 * Math.PI);\n                ctx.fill();\n                ctx.stroke();\n            }\n        }\n        ctx.restore();\n    }\n    \n    function lighten(c, amt) {\n        const rgb = c.match(/\\w{2}\\w{2}\\w{2}/);\n        if (!rgb) return c;\n        let r = parseInt(rgb[0], 16) + amt;\n        let g = parseInt(rgb[1], 16) + amt;\n        let b = parseInt(rgb[2], 16) + amt;\n        r = Math.min(255, Math.max(0, r));\n        g = Math.min(255, Math.max(0, g));\n        b = Math.min(255, Math.max(0, b));\n        return '#' + ((1 << 24) + (r << 16) + (g << 8) + b).toString(16).slice(1);\n    }\n    \n    function update(dt) {\n        if (paused) return;\n        timer += dt;\n        const mins = Math.floor(timer / 60);\n        const secs = Math.floor(timer % 60);\n        document.getElementById('timer').textContent = `TIME: ${mins.toString().padStart(2,'0')}:${secs.toString().padStart(2,'0')}`;\n        \n        for (let r = 0; r < rings.length; r++) {\n            if (rings[r].drift && rings[r].settled) {\n                rings[r].angle += rings[r].driftDir * 0.15 * dt;\n            }\n        }\n        \n        checkMatches();\n    }\n    \n    function checkMatches() {\n        for (let r = 0; r < rings.length; r++) {\n            const ring = rings[r];\n            if (ring.settled) continue;\n            let matchLen = 1;\n            for (let s = 1; s < S; s++) {\n                const prev = (ring.tokens[(s - 1 + S) % S] === 'void') ? null : ring.tokens[(s - 1 + S) % S];\n                const curr = (ring.tokens[s] === 'void') ? null : ring.tokens[s];\n                if (prev && curr && prev === curr) {\n                    matchLen++;\n                } else {\n                    if (matchLen >= 3) {\n                        const start = (s - matchLen + S) % S;\n                        for (let i = 0; i < matchLen; i++) {\n                            const idx = (start + i + S) % S;\n                            ring.tokens[idx] = 'void';\n                        }\n                        score += Math.pow(10, combo++) * matchLen;\n                        playSound('match', { freq: 440 + matchLen * 110, dur: 0.15 * matchLen });\n                        document.getElementById('score').textContent = `SCORE: ${score}`;\n                    }\n                    matchLen = 1;\n                }\n            }\n            if (matchLen >= 3) {\n                const start = (S - matchLen + S) % S;\n                for (let i = 0; i < matchLen; i++) {\n                    const idx = (start + i + S) % S;\n                    ring.tokens[idx] = 'void';\n                }\n                score += Math.pow(10, combo++) * matchLen;\n                playSound('match', { freq: 440 + matchLen * 110, dur: 0.15 * matchLen });\n                document.getElementById('score').textContent = `SCORE: ${score}`;\n            }\n            ring.settled = true;\n            for (let s = 0; s < S; s++) {\n                if (ring.tokens[s] !== 'void') ring.settled = false;\n            }\n        }\n        \n        let allSettled = true;\n        for (let r = 0; r < rings.length; r++) {\n            if (!rings[r].settled) allSettled = false;\n        }\n        \n        if (allSettled) {\n            const levelData = loadLevel(level);\n            let won = true;\n            for (let r = 0; r < rings.length; r++) {\n                for (let s = 0; s < S; s++) {\n                    if (rings[r].tokens[s] !== levelData.tokens[r][s]) won = false;\n                }\n            }\n            if (won) {\n                score += 1000 * Math.pow(2, level - 1);\n                document.getElementById('score').textContent = `SCORE: ${score}`;\n                playSound('win', { freq: 880, dur: 0.3 });\n                level++;\n                if (level > 10) {\n                    alert('CONGRATULATIONS! YOU COMPLETED ALL LEVELS!');\n                    level = 1;\n                }\n                genLevel();\n            } else {\n                for (let r = 0; r < rings.length; r++) {\n                    rings[r].settled = true;\n                }\n            }\n        }\n    }\n    \n    function mouseDown(e) {\n        if (paused) return;\n        const rect = canvas.getBoundingClientRect();\n        const mx = (e.clientX - rect.left) / dpr;\n        const my = (e.clientY - rect.top) / dpr;\n        const dx = mx - W/2;\n        const dy = my - H/2;\n        const dist = Math.sqrt(dx * dx + dy * dy);\n        if (dist > RB * 1.1) return;\n        dragging = 0;\n        dragStart = Math.atan2(dy, dx);\n        dragAngle = dragStart;\n    }\n    \n    function mouseMove(e) {\n        if (dragging < 0 || paused) return;\n        const rect = canvas.getBoundingClientRect();\n        const mx = (e.clientX - rect.left) / dpr;\n        const my = (e.clientY - rect.top) / dpr;\n        const dx = mx - W/2;\n        const dy = my - H/2;\n        const newAngle = Math.atan2(dy, dx);\n        const delta = ((newAngle - dragStart + Math.PI * 3) % (Math.PI * 2)) - Math.PI;\n        for (let r = 0; r < rings.length; r++) {\n            rings[r].angle += delta;\n            rings[r].angle = ((rings[r].angle + Math.PI * 2) % (Math.PI * 2));\n        }\n        dragAngle = newAngle;\n    }\n    \n    function mouseUp(e) {\n        if (dragging < 0 || paused) return;\n        moves++;\n        document.getElementById('moves').textContent = `MOVES: ${moves} / PAR: ${par}`;\n        for (let r = 0; r < rings.length; r++) {\n            rings[r].settled = false;\n        }\n        dragging = -1;\n        playSound('rotate', { freq: 220, dur: 0.1 });\n    }\n    \n    function touchStart(e) {\n        if (paused) return;\n        const touch = e.touches[0];\n        const rect = canvas.getBoundingClientRect();\n        const mx = (touch.clientX - rect.left) / dpr;\n        const my = (touch.clientY - rect.top) / dpr;\n        const dx = mx - W/2;\n        const dy = my - H/2;\n        const dist = Math.sqrt(dx * dx + dy * dy);\n        if (dist > RB * 1.1) return;\n        dragging = 0;\n        dragStart = Math.atan2(dy, dx);\n        dragAngle = dragStart;\n    }\n    \n    function touchMove(e) {\n        if (dragging < 0 || paused) return;\n        const touch = e.touches[0];\n        const rect = canvas.getBoundingClientRect();\n        const mx = (touch.clientX - rect.left) / dpr;\n        const my = (touch.clientY - rect.top) / dpr;\n        const dx = mx - W/2;\n        const dy = my - H/2;\n        const newAngle = Math.atan2(dy, dx);\n        const delta = ((newAngle - dragStart + Math.PI * 3) % (Math.PI * 2)) - Math.PI;\n        for (let r = 0; r < rings.length; r++) {\n            rings[r].angle += delta;\n            rings[r].angle = ((rings[r].angle + Math.PI * 2) % (Math.PI * 2));\n        }\n        dragAngle = newAngle;\n    }\n    \n    function touchEnd(e) {\n        if (dragging < 0 || paused) return;\n        moves++;\n        document.getElementById('moves').textContent = `MOVES: ${moves} / PAR: ${par}`;\n        for (let r = 0; r < rings.length; r++) {\n            rings[r].settled = false;\n        }\n        dragging = -1;\n        playSound('rotate', { freq: 220, dur: 0.1 });\n    }\n    \n    function togglePause() {\n        paused = !paused;\n        document.getElementById('pauseBtn').textContent = paused ? '▶' : '⏸';\n        if (!audioCtx) initAudio();\n        musicGain.gain.value = paused ? 0 : (soundOn ? 0.3 : 0);\n    }\n    \n    function undo() {\n        if (save.history && save.history.length > 0) {\n            const prev = save.history.pop();\n            rings = prev.rings;\n            moves = prev.moves;\n            timer = prev.timer;\n            score = prev.score;\n            combo = prev.combo;\n            document.getElementById('moves').textContent = `MOVES: ${moves} / PAR: ${par}`;\n            document.getElementById('score').textContent = `SCORE: ${score}`;\n            document.getElementById('timer').textContent = `TIME: ${Math.floor(timer/60).toString().padStart(2,'0')}:${Math.floor(timer%60).toString().padStart(2,'0')}`;\n        }\n    }\n    \n    function restart() {\n        moves = 0;\n        timer = 0;\n        score = 0;\n        combo = 0;\n        genLevel();\n    }\n    \n    function hint() {\n        if (rings.length > 0) {\n            const ring = rings[Math.floor(Math.random() * rings.length)];\n            const targetAng = Math.random() * 2 * Math.PI;\n            ring.target = targetAng;\n            playSound('hint', { freq: 660, dur: 0.2 });\n        }\n    }\n    \n    function toggleSound() {\n        soundOn = !soundOn;\n        sfxGain.gain.value = soundOn ? 0.7 : 0;\n        musicGain.gain.value = soundOn ? 0.3 : 0;\n        document.getElementById('buttons').children[3].textContent = soundOn ? '🔊' : '🔇';\n    }\n    \n    function gameLoop(timestamp) {\n        if (!lastFrame) lastFrame = timestamp;\n        const dt = (timestamp - lastFrame) / 1000;\n        lastFrame = timestamp;\n        accumulator += dt;\n        while (accumulator >= 1/60) {\n            update(1/60);\n            accumulator -= 1/60;\n        }\n        draw();\n        if (running) requestAnimationFrame(gameLoop);\n    }\n    \n    function saveState() {\n        if (!save.history) save.history = [];\n        save.history.push({\n            rings: JSON.parse(JSON.stringify(rings)),\n            moves: moves,\n            timer: timer,\n            score: score,\n            combo: combo\n        });\n        if (save.history.length > 50) save.history.shift();\n        localStorage.setItem('orbitalis.save.v1', JSON.stringify(save));\n    }\n    \n    canvas.addEventListener('mousedown', mouseDown);\n    canvas.addEventListener('mousemove', mouseMove);\n    canvas.addEventListener('mouseup', mouseUp);\n    canvas.addEventListener('mouseleave', mouseUp);\n    canvas.addEventListener('touchstart', touchStart);\n    canvas.addEventListener('touchmove', touchMove);\n    canvas.addEventListener('touchend', touchEnd);\n    \n    resize();\n    window.addEventListener('resize', resize);\n    genLevel();\n    gameLoop(0);\n})();\n    </script>\n</body>\n</html>"}