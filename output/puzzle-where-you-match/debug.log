  "index.html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Chromatic Velocity</title>\n    <link rel=\"icon\" href=\"data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ccircle cx='50' cy='50' r='40' fill='%23FF5555'/%3E%3Ctext x='50' y='58' font-size='36' text-anchor='middle' fill='white' font-family='Arial' font-weight='bold'%3E⚡%3C/text%3E%3C/svg%3E\">\n    <style>\n        * { margin: 0; padding: 0; box-sizing: border-box; }\n        body { \n            background: linear-gradient(135deg, #0a0a1a, #1a0a2a); \n            font-family: 'Courier New', monospace; \n            overflow: hidden; \n            height: 100vh; \n            display: flex; \n            justify-content: center; \n            align-items: center; \n        }\n        #gameCanvas { \n            border: 2px solid #4a4a6a; \n            border-radius: 8px; \n            background: #121212;\n            box-shadow: 0 0 30px rgba(100, 200, 255, 0.3);\n        }\n        .loading { \n            position: absolute; \n            color: #88ffff; \n            font-size: 14px; \n            text-align: center; \n        }\n    </style>\n</head>\n<body>\n    <canvas id=\"gameCanvas\"></canvas>\n    <div class=\"loading\" id=\"loadingText\">Loading...</div>\n    <script type=\"module\" src=\"main.js\"></script>\n</body>\n</html>",
  "main.js": "import { Game } from './src/core/Game.js';\nimport { Engine } from './src/core/Engine.js';\nimport { Renderer } from './src/core/Renderer.js';\nimport { Physics } from './src/core/Physics.js';\nimport { Input } from './src/core/Input.js';\nimport { Player } from './src/entities/Player.js';\nimport { Obstacle } from './src/entities/Obstacle.js';\nimport { Particle } from './src/entities/Particle.js';\nimport { SpawnSystem } from './src/systems/SpawnSystem.js';\nimport { CollisionSystem } from './src/systems/CollisionSystem.js';\nimport { ScoreSystem } from './src/systems/ScoreSystem.js';\nimport { HUD } from './src/ui/HUD.js';\nimport { Menu } from './src/ui/Menu.js';\n\nconst canvas = document.getElementById('gameCanvas');\nconst loadingText = document.getElementById('loadingText');\n\nconst config = {\n    COLORS: ['#FF5555', '#55FF55', '#5555FF', '#FFFF55'],\n    COLOR_NAMES: ['RED', 'GREEN', 'BLUE', 'YELLOW'],\n    PLAYER_RADIUS: 12,\n    OBSTACLE_SIZES: [15, 20, 25],\n    MAX_OBSTACLES: 50,\n    INITIAL_SPEED: 2,\n    SPEED_MULTIPLIER: 0.05,\n    SPAWN_INTERVAL: 1200,\n    SPAWN_VARIANCE: 400,\n    DRAG_COEFFICIENT: 0.98,\n    INPUT_LOCK: 200,\n    LIVES: 3,\n    COMBO_MAX: 10,\n    PARTICLE_COUNT: 15,\n    GRID_SIZE: 50,\n    CHROMATIC_ABERRATION_INTENSITY: 2,\n    SCREEN_SHAKE_DURATION: 150,\n    FPS_TARGET: 60\n};\n\nclass GameManager {\n    constructor() {\n        this.engine = new Engine(canvas, config);\n        this.renderer = new Renderer(canvas, config);\n        this.physics = new Physics(config);\n        this.input = new Input(config);\n        this.hud = new HUD(canvas, config);\n        this.menu = new Menu(canvas, config);\n        \n        this.player = new Player(400, 300, config);\n        this.obstacles = [];\n        this.particles = [];\n        \n        this.spawnSystem = new SpawnSystem(this.obstacles, config);\n        this.collisionSystem = new CollisionSystem(this.physics, config);\n        this.scoreSystem = new ScoreSystem(config);\n        \n        this.gameState = 'loading';\n        this.lastTime = 0;\n        this.highScore = parseInt(localStorage.getItem('chromaticVelocityHighScore') || '0');\n        \n        this.audio = new AudioManager();\n        \n        this.init();\n    }\n    \n    init() {\n        this.loadAssets().then(() => {\n            this.gameState = 'menu';\n            loadingText.textContent = 'Ready!';\n            setTimeout(() => loadingText.style.opacity = '0', 1000);\n            this.gameLoop(0);\n        });\n    }\n    \n    async loadAssets() {\n        return new Promise(resolve => {\n            setTimeout(resolve, 500);\n        });\n    }\n    \n    gameLoop(timestamp) {\n        if (this.gameState === 'loading') {\n            requestAnimationFrame(this.gameLoop.bind(this));\n            return;\n        }\n        \n        const deltaTime = Math.min((timestamp - this.lastTime) / 1000, 1/30);\n        this.lastTime = timestamp;\n        \n        if (this.gameState === 'playing') {\n            this.update(deltaTime);\n        }\n        \n        this.render();\n        requestAnimationFrame(this.gameLoop.bind(this));\n    }\n    \n    update(deltaTime) {\n        this.input.update();\n        this.player.update(deltaTime, this.input, this.physics);\n        \n        this.spawnSystem.update(deltaTime, this.player, this.obstacles);\n        \n        for (let i = this.obstacles.length - 1; i >= 0; i--) {\n            const obstacle = this.obstacles[i];\n            obstacle.update(deltaTime, this.physics);\n            \n            if (this.collisionSystem.checkCollision(this.player, obstacle)) {\n                if (this.collisionSystem.handleMatch(this.player, obstacle, this.scoreSystem)) {\n                    this.audio.playSound('match');\n                    this.spawnParticles(obstacle.x, obstacle.y, obstacle.color, 15);\n                } else {\n                    this.audio.playSound('mismatch');\n                    this.renderer.shakeScreen(150);\n                }\n                this.obstacles.splice(i, 1);\n            }\n        }\n        \n        for (let i = this.particles.length - 1; i >= 0; i--) {\n            this.particles[i].update(deltaTime);\n            if (this.particles[i].life <= 0) {\n                this.particles.splice(i, 1);\n            }\n        }\n        \n        this.hud.update(this.player, this.scoreSystem, deltaTime);\n        \n        if (this.scoreSystem.lives <= 0) {\n            this.gameState = 'gameover';\n            if (this.scoreSystem.score > this.highScore) {\n                this.highScore = this.scoreSystem.score;\n                localStorage.setItem('chromaticVelocityHighScore', this.highScore.toString());\n            }\n        }\n    }\n    \n    render() {\n        this.renderer.clear();\n        this.renderer.drawGrid();\n        \n        if (this.gameState === 'menu') {\n            this.menu.render();\n        } else if (this.gameState === 'playing' || this.gameState === 'gameover') {\n            this.player.render(this.renderer.ctx);\n            \n            this.obstacles.forEach(obs => obs.render(this.renderer.ctx));\n            this.particles.forEach(p => p.render(this.renderer.ctx));\n            \n            this.hud.render(this.renderer.ctx);\n            \n            if (this.gameState === 'gameover') {\n                this.menu.renderGameOver(this.scoreSystem.score, this.highScore);\n            }\n        }\n    }\n    \n    spawnParticles(x, y, color, count) {\n        for (let i = 0; i < count; i++) {\n            const angle = Math.random() * Math.PI * 2;\n            const speed = Math.random() * 100 + 50;\n            this.particles.push(new Particle(\n                x + Math.cos(angle) * 5,\n                y + Math.sin(angle) * 5,\n                Math.cos(angle) * speed,\n                Math.sin(angle) * speed,\n                color,\n                config\n            ));\n        }\n    }\n}\n\nclass AudioManager {\n    constructor() {\n        this.audioCtx = new (window.AudioContext || window.webkitAudioContext)();\n        this.sounds = {};\n        this.initSounds();\n    }\n    \n    initSounds() {\n        this.sounds.match = this.createBeep(440, 0.1, 0.8);\n        this.sounds.mismatch = this.createBeep(110, 0.2, 0.6);\n    }\n    \n    createBeep(freq, duration, volume) {\n        return (x, y) => {\n            const oscillator = this.audioCtx.createOscillator();\n            const gainNode = this.audioCtx.createGain();\n            \n            oscillator.connect(gainNode);\n            gainNode.connect(this.audioCtx.destination);\n            \n            oscillator.frequency.setValueAtTime(freq, this.audioCtx.currentTime);\n            gainNode.gain.setValueAtTime(volume, this.audioCtx.currentTime);\n            gainNode.gain.exponentialRampToValueAtTime(0.01, this.audioCtx.currentTime + duration);\n            \n            oscillator.start();\n            oscillator.stop(this.audioCtx.currentTime + duration);\n        };\n    }\n    \n    playSound(name) {\n        if (this.sounds[name]) {\n            this.sounds[name]();\n        }\n    }\n}\n\nwindow.addEventListener('load', () => {\n    const game = new GameManager();\n    window.gameInstance = game;\n});\n\nwindow.addEventListener('resize', () => {\n    if (window.gameInstance) {\n        window.gameInstance.engine.resize();\n    }\n});",
  "src/core/Engine.js": "export class Engine {\n    constructor(canvas, config) {\n        this.canvas = canvas;\n        this.config = config;\n        this.ctx = canvas.getContext('2d');\n        this.width = window.innerWidth;\n        this.height = window.innerHeight;\n        this.scale = 1;\n        this.updateDimensions();\n    }\n    \n    updateDimensions() {\n        const targetAspect = 16 / 9;\n        const windowAspect = this.width / this.height;\n        \n        if (windowAspect > targetAspect) {\n            this.scale = this.height / 900;\n            this.canvas.width = 1600 * this.scale;\n            this.canvas.height = 900 * this.scale;\n        } else {\n            this.scale = this.width / 1600;\n            this.canvas.width = 1600 * this.scale;\n            this.canvas.height = 900 * this.scale;\n        }\n        \n        this.canvas.style.width = this.width + 'px';\n        this.canvas.style.height = this.height + 'px';\n    }\n    \n    resize() {\n        this.width = window.innerWidth;\n        this.height = window.innerHeight;\n        this.updateDimensions();\n    }\n    \n    getScaledX(x) {\n        return x * this.scale;\n    }\n    \n    getScaledY(y) {\n        return y * this.scale;\n    }\n}",
  "src/core/Renderer.js": "export class Renderer {\n    constructor(canvas, config) {\n        this.canvas = canvas;\n        this.config = config;\n        this.ctx = canvas.getContext('2d');\n        this.shakeIntensity = 0;\n        this.shakeTime = 0;\n        this. aberrationOffset = 0;\n    }\n    \n    clear() {\n        this.ctx.fillStyle = '#121212';\n        this.ctx.fillRect(0, 0, this.canvas.width, this.canvas.height);\n    }\n    \n    drawGrid() {\n        this.ctx.strokeStyle = 'rgba(255, 255, 255, 0.05)';\n        this.ctx.lineWidth = 1;\n        \n        const gridSize = this.config.GRID_SIZE;\n        const width = this.canvas.width;\n        const height = this.canvas.height;\n        \n        for (let x = 0; x < width; x += gridSize) {\n            this.ctx.beginPath();\n            this.ctx.moveTo(x, 0);\n            this.ctx.lineTo(x, height);\n            this.ctx.stroke();\n        }\n        \n        for (let y = 0; y < height; y += gridSize) {\n            this.ctx.beginPath();\n            this.ctx.moveTo(0, y);\n            this.ctx.lineTo(width, y);\n            this.ctx.stroke();\n        }\n    }\n    \n    applyEffects() {\n        if (this.shakeTime > 0) {\n            const shakeX = (Math.random() - 0.5) * this.shakeIntensity;\n            const shakeY = (Math.random() - 0.5) * this.shakeIntensity;\n            this.ctx.translate(shakeX, shakeY);\n        }\n    }\n    \n    shakeScreen(duration) {\n        this.shakeTime = duration / 16.67;\n        this.shakeIntensity = 15;\n    }\n    \n    updateShake(deltaTime) {\n        if (this.shakeTime > 0) {\n            this.shakeTime -= deltaTime;\n            this.shakeIntensity = Math.max(0, this.shakeIntensity * 0.95);\n        }\n    }\n}",
  "src/core/Physics.js": "export class Physics {\n    constructor(config) {\n        this.config = config;\n    }\n    \n    clampVelocity(velocity, maxSpeed) {\n        const speed = Math.sqrt(velocity.x * velocity.x + velocity.y * velocity.y);\n        if (speed > maxSpeed) {\n            velocity.x = (velocity.x / speed) * maxSpeed;\n            velocity.y = (velocity.y / speed) * maxSpeed;\n        }\n        return velocity;\n    }\n    \n    applyDrag(velocity) {\n        velocity.x *= this.config.DRAG_COEFFICIENT;\n        velocity.y *= this.config.DRAG_COEFFICIENT;\n        return velocity;\n    }\n}",
  "src/core/Input.js": "export class Input {\n    constructor(config) {\n        this.config = config;\n        this.keys = {};\n        this.touchStart = { x: 0, y: 0 };\n        this.lastColorChange = 0;\n        this.colorIndex = 0;\n        this.virtualJoystick = { x: 0, y: 0, active: false };\n        \n        this.setupEventListeners();\n    }\n    \n    setupEventListeners() {\n        window.addEventListener('keydown', (e) => {\n            this.keys[e.code] = true;\n        });\n        \n        window.addEventListener('keyup', (e) => {\n            this.keys[e.code] = false;\n        });\n        \n        window.addEventListener('touchstart', (e) => {\n            e.preventDefault();\n            const touch = e.touches[0];\n            this.touchStart = { x: touch.clientX, y: touch.clientY };\n            \n            const canvas = document.getElementById('gameCanvas');\n            const rect = canvas.getBoundingClientRect();\n            const isRightSide = touch.clientX > rect.left + rect.width / 2;\n            \n            if (isRightSide) {\n                this.changeColor();\n            } else {\n                this.virtualJoystick.active = true;\n            }\n        });\n        \n        window.addEventListener('touchmove', (e) => {\n            e.preventDefault();\n            if (!this.virtualJoystick.active) return;\n            \n            const touch = e.touches[0];\n            const dx = touch.clientX - this.touchStart.x;\n            const dy = touch.clientY - this.touchStart.y;\n            \n            this.virtualJoystick.x = Math.max(-1, Math.min(1, dx / 100));\n            this.virtualJoystick.y = Math.max(-1, Math.min(1, dy / 100));\n        });\n        \n        window.addEventListener('touchend', () => {\n            this.virtualJoystick.active = false;\n            this.virtualJoystick.x = 0;\n            this.virtualJoystick.y = 0;\n        });\n    }\n    \n    update() {\n        this.lastColorChange += 16;\n    }\n    \n    changeColor() {\n        const now = Date.now();\n        if (now - this.lastColorChange > this.config.INPUT_LOCK) {\n            this.colorIndex = (this.colorIndex + 1) % this.config.COLORS.length;\n            this.lastColorChange = now;\n        }\n    }\n    \n    getColorIndex() {\n        return this.colorIndex;\n    }\n    \n    getMovement() {\n        const move = { x: 0, y: 0 };\n        \n        if ('w' in this.keys || 'ArrowUp' in this.keys) move.y -= 1;\n        if ('s' in this.keys || 'ArrowDown' in this.keys) move.y += 1;\n        if ('a' in this.keys || 'ArrowLeft' in this.keys) move.x -= 1;\n        if ('d' in this.keys || 'ArrowRight' in this.keys) move.x += 1;\n        \n        if (this.virtualJoystick.active) {\n            move.x += this.virtualJoystick.x;\n            move.y += this.virtualJoystick.y;\n        }\n        \n        const length = Math.sqrt(move.x * move.x + move.y * move.y);\n        if (length > 0) {\n            move.x = move.x / length;\n            move.y = move.y / length;\n        }\n        \n        return move;\n    }\n}",
  "src/core/Game.js": "export class Game {\n    constructor(canvas, config) {\n        this.canvas = canvas;\n        this.config = config;\n        this.ctx = canvas.getContext('2d');\n        this.running = false;\n        this.startTime = 0;\n        this.elapsedTime = 0;\n    }\n    \n    start() {\n        this.running = true;\n        this.startTime = performance.now();\n    }\n    \n    stop() {\n        this.running = false;\n    }\n    \n    getElapsedTime() {\n        return (performance.now() - this.startTime) / 1000;\n    }\n}",
  "src/entities/Player.js": "export class Player {\n    constructor(x, y, config) {\n        this.x = x;\n        this.y = y;\n        this.radius = config.PLAYER_RADIUS;\n        this.colorIndex = 0;\n        this.velocity = { x: 0, y: 0 };\n        this.acceleration = { x: 0, y: 0 };\n        this.maxSpeed = 300;\n        this.shadowBlur = 20;\n    }\n    \n    update(deltaTime, input, physics) {\n        const move = input.getMovement();\n        const colorIndex = input.getColorIndex();\n        \n        this.acceleration.x = move.x * 200;\n        this.acceleration.y = move.y * 200;\n        \n        this.velocity.x += this.acceleration.x * deltaTime;\n        this.velocity.y += this.acceleration.y * deltaTime;\n        \n        physics.applyDrag(this.velocity);\n        physics.clampVelocity(this.velocity, this.maxSpeed);\n        \n        this.x += this.velocity.x * deltaTime;\n        this.y += this.velocity.y * deltaTime;\n        \n        this.x = Math.max(this.radius, Math.min(780, this.x));\n        this.y = Math.max(this.radius, Math.min(540, this.y));\n        \n        this.colorIndex = colorIndex;\n        \n        this.acceleration.x *= 0.9;\n        this.acceleration.y *= 0.9;\n    }\n    \n    render(ctx) {\n        const color = ['#FF5555', '#55FF55', '#5555FF', '#FFFF55'][this.colorIndex];\n        \n        ctx.save();\n        ctx.shadowColor = color;\n        ctx.shadowBlur = this.shadowBlur;\n        ctx.fillStyle = color;\n        ctx.beginPath();\n        ctx.arc(this.x, this.y, this.radius, 0, Math.PI * 2);\n        ctx.fill();\n        ctx.restore();\n    }\n    \n    getColor() {\n        return ['#FF5555', '#55FF55', '#5555FF', '#FFFF55'][this.colorIndex];\n    }\n}\n",
  "src/entities/Obstacle.js": "export class Obstacle {\n    constructor(x, y, type, config) {\n        this.x = x;\n        this.y = y;\n        this.type = type;\n        this.size = config.OBSTACLE_SIZES[Math.floor(Math.random() * config.OBSTACLE_SIZES.length)];\n        this.colorIndex = Math.floor(Math.random() * config.COLORS.length);\n        this.color = config.COLORS[this.colorIndex];\n        this.velocity = { x: 0, y: 0 };\n        this.speed = config.INITIAL_SPEED;\n        this.ghostPositions = [];\n        this.maxGhostPositions = 10;\n        this.sinePhase = Math.random() * Math.PI * 2;\n        this.sineAmplitude = 20;\n        this.sineFrequency = 2 + Math.random() * 3;\n        this.chaseTarget = null;\n    }\n    \n    update(deltaTime, physics) {\n        if (this.type === 'erratic') {\n            this.y += Math.sin(this.sinePhase) * this.sineAmplitude * deltaTime;\n            this.sinePhase += this.sineFrequency * deltaTime;\n        }\n        \n        if (this.type === 'chaser') {\n            this.x += this.velocity.x * deltaTime;\n            this.y += this.velocity.y * deltaTime;\n        } else {\n            this.x += this.velocity.x * deltaTime;\n            this.y += this.velocity.y * deltaTime;\n        }\n        \n        this.ghostPositions.unshift({ x: this.x, y: this.y });\n        if (this.ghostPositions.length > this.maxGhostPositions) {\n            this.ghostPositions.pop();\n        }\n    }\n    \n    render(ctx) {\n        const colors = ['#FF5555', '#55FF55', '#5555FF', '#FFFF55'];\n        const color = colors[this.colorIndex];\n        \n        for (let i = this.ghostPositions.length - 1; i >= 0; i--) {\n            const alpha = (i + 1) / this.ghostPositions.length * 0.3;\n            ctx.globalAlpha = alpha;\n            this.drawShape(ctx, this.ghostPositions[i].x, this.ghostPositions[i].y, this.size * (0.7 + i * 0.03), color);\n        }\n        \n        ctx.globalAlpha = 1;\n        this.drawShape(ctx, this.x, this.y, this.size, color);\n    }\n    \n    drawShape(ctx, x, y, size, color) {\n        ctx.fillStyle = color;\n        ctx.strokeStyle = '#ffffff';\n        ctx.lineWidth = 2;\n        \n        const rand = Math.random();\n        if (rand < 0.33) {\n            ctx.beginPath();\n            ctx.moveTo(x, y - size);\n            ctx.lineTo(x - size * 0.866, y + size * 0.5);\n            ctx.lineTo(x + size * 0.866, y + size * 0.5);\n            ctx.fill();\n            ctx.stroke();\n        } else if (rand < 0.66) {\n            ctx.beginPath();\n            ctx.rect(x - size, y - size, size * 2, size * 2);\n            ctx.fill();\n            ctx.stroke();\n        } else {\n            ctx.beginPath();\n            for (let i = 0; i < 6; i++) {\n                const angle = i * Math.PI / 3;\n                const px = x + Math.cos(angle) * size;\n                const py = y + Math.sin(angle) * size;\n                if (i === 0) ctx.moveTo(px, py);\n                else ctx.lineTo(px, py);\n            }\n            ctx.fill();\n            ctx.stroke();\n        }\n    }\n    \n    getBounds() {\n        return {\n            x: this.x - this.size,\n            y: this.y - this.size,\n            width: this.size * 2,\n            height: this.size * 2\n        };\n    }\n}\n",
  "src/entities/Particle.js": "export class Particle {\n    constructor(x, y, vx, vy, color, config) {\n        this.x = x;\n        this.y = y;\n        this.vx = vx;\n        this.vy = vy;\n        this.color = color;\n        this.life = 1;\n        this.size = Math.random() * 3 + 2;\n        this.config = config;\n    }\n    \n    update(deltaTime) {\n        this.x += this.vx * deltaTime;\n        this.y += this.vy * deltaTime;\n        this.life -= deltaTime;\n        this.vy += 500 * deltaTime;\n    }\n    \n    render(ctx) {\n        const alpha = Math.max(0, this.life);\n        ctx.globalAlpha = alpha;\n        ctx.fillStyle = this.color;\n        ctx.beginPath();\n        ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);\n        ctx.fill();\n        ctx.globalAlpha = 1;\n    }\n}\n",
  "src/systems/SpawnSystem.js": "export class SpawnSystem {\n    constructor(obstacles, config) {\n        this.obstacles = obstacles;\n        this.config = config;\n        this.spawnTimer = 0;\n        this.spawnVariance = config.SPAWN_VARIANCE;\n        this.lastSpawnTime = 0;\n    }\n    \n    update(deltaTime, player, obstacles) {\n        this.spawnTimer += deltaTime * 1000;\n        \n        const baseInterval = this.config.SPAWN_INTERVAL;\n        const interval = baseInterval * Math.pow(0.95, player.score / 100);\n        \n        if (this.spawnTimer > interval + Math.random() * this.spawnVariance) {\n            this.spawnObstacle(player);\n            this.spawnTimer = 0;\n        }\n    }\n    \n    spawnObstacle(player) {\n        if (this.obstacles.length >= this.config.MAX_OBSTACLES) return;\n        \n        const types = ['static', 'erratic', 'chaser'];\n        const type = types[Math.floor(Math.random() * types.length)];\n        \n        const edges = ['left', 'right', 'top'];\n        const edge = edges[Math.floor(Math.random() * edges.length)];\n        \n        let x, y;\n        \n        switch (edge) {\n            case 'left':\n                x = -20;\n                y = Math.random() * 600 + 50;\n                break;\n            case 'right':\n                x = 820;\n                y = Math.random() * 600 + 50;\n                break;\n            case 'top':\n                x = Math.random() * 800 + 50;\n                y = -20;\n                break;\n        }\n        \n        const obstacle = new (await import('../entities/Obstacle.js')).Obstacle(x, y, type, this.config);\n        \n        let vx = 0, vy = 0;\n        const speed = this.config.INITIAL_SPEED + player.score * this.config.SPEED_MULTIPLIER;\n        \n        if (edge === 'left') {\n            vx = speed;\n        } else if (edge === 'right') {\n            vx = -speed;\n        } else {\n            vy = speed;\n        }\n        \n        obstacle.velocity.x = vx;\n        obstacle.velocity.y = vy;\n        obstacle.speed = speed;\n        \n        if (type === 'chaser') {\n            obstacle.chaseTarget = player;\n        }\n        \n        obstacles.push(obstacle);\n    }\n}\n",
  "src/systems/CollisionSystem.js": "export class CollisionSystem {\n    constructor(physics, config) {\n        this.physics = physics;\n        this.config = config;\n    }\n    \n    checkCollision(player, obstacle) {\n        const dx = obstacle.x - player.x;\n        const dy = obstacle.y - player.y;\n        const distance = Math.sqrt(dx * dx + dy * dy);\n        const minDistance = player.radius + obstacle.size;\n        \n        return distance < minDistance;\n    }\n    \n    handleMatch(player, obstacle, scoreSystem) {\n        if (player.getColor() === obstacle.color) {\n            scoreSystem.incrementScore(10);\n            scoreSystem.incrementCombo();\n            return true;\n        } else {\n            scoreSystem.miss();\n            return false;\n        }\n    }\n}\n",
  "src/systems/ScoreSystem.js": "export class ScoreSystem {\n    constructor(config) {\n        this.config = config;\n        this.score = 0;\n        this.combo = 0;\n        this.comboTimer = 0;\n        this.lives = config.LIVES;\n        this.multiplier = 1;\n    }\n    \n    incrementScore(points) {\n        this.score += points * this.multiplier;\n    }\n    \n    incrementCombo() {\n        this.combo++;\n        this.comboTimer = 1000;\n        this.multiplier = Math.min(this.config.COMBO_MAX, Math.floor(this.combo / 5) + 1);\n    }\n    \n    miss() {\n        this.lives--;\n        this.combo = 0;\n        this.multiplier = 1;\n    }\n    \n    reset() {\n        this.score = 0;\n        this.combo = 0;\n        this.lives = this.config.LIVES;\n        this.multiplier = 1;\n    }\n}\n",
  "src/ui/HUD.js": "export class HUD {\n    constructor(canvas, config) {\n        this.canvas = canvas;\n        this.config = config;\n        this.startTime = 0;\n        this.elapsedTime = 0;\n        this.opacity = 1;\n    }\n    \n    update(player, scoreSystem, deltaTime) {\n        this.elapsedTime += deltaTime;\n        this.comboTimer -= deltaTime;\n        \n        if (this.comboTimer <= 0 && scoreSystem.combo > 0) {\n            scoreSystem.combo = 0;\n            scoreSystem.multiplier = 1;\n        }\n    }\n    \n    render(ctx) {\n        const width = this.canvas.width;\n        const height = this.canvas.height;\n        \n        ctx.save();\n        ctx.globalAlpha = this.opacity;\n        \n        ctx.fillStyle = 'rgba(0, 0, 0, 0.5)';\n        ctx.fillRect(0, 0, width, 40);\n        \n        ctx.fillStyle = '#88ffff';\n        ctx.font = 'bold 24px \"Courier New\", monospace';\n        ctx.textAlign = 'center';\n        ctx.fillText('SCORE: ' + Math.floor(window.gameInstance?.scoreSystem?.score || 0), width / 2, 28);\n        \n        ctx.textAlign = 'left';\n        ctx.fillText('COMBO: x' + (window.gameInstance?.scoreSystem?.multiplier || 1), width / 2 + 100, 28);\n        \n        const lives = window.gameInstance?.scoreSystem?.lives || 3;\n        const colors = ['#FF5555', '#55FF55', '#5555FF'];\n        for (let i = 0; i < 3; i++) {\n            ctx.fillStyle = i < lives ? colors[i] : 'rgba(255, 255, 255, 0.3)';
            ctx.fillRect(width - 150 + i * 50, 15, 30, 10);
        }
        
        ctx.textAlign = 'right';
        ctx.fillText('LIVES: ' + lives, width - 100, 28);
        
        ctx.restore();
    }
}

export class Menu {
    constructor(canvas, config) {
        this.canvas = canvas;
        this.config = config;
        this.opacity = 1;
    }
    
    render() {
        const width = this.canvas.width;
        const height = this.canvas.height;
        
        this.canvas.style.opacity = this.opacity;
        
        const gradient = this.canvas.getContext('2d').createLinearGradient(0, 0, 0, height);
        gradient.addColorStop(0, 'rgba(0, 0, 0, 0)');
        gradient.addColorStop(1, 'rgba(0, 0, 0, 0.7)');
        
        const ctx = this.canvas.getContext('2d');
        ctx.save();
        ctx.fillStyle = gradient;
        ctx.fillRect(0, 0, width, height);
        ctx.restore();
        
        ctx.fillStyle = '#88ffff';
        ctx.font = 'bold 48px "Courier New", monospace';
        ctx.textAlign = 'center';
        ctx.fillText('CHROMATIC VELOCITY', width / 2, height / 3);
        
        ctx.font = '24px "Courier New", monospace';
        ctx.fillText('Touch RIGHT side to change color', width / 2, height / 2);
        ctx.fillText('Use WASD or Arrow keys to move', width / 2, height / 2 + 40);
        ctx.fillText('Match colors to collect obstacles', width / 2, height / 2 + 80);
        ctx.fillText('Press ENTER to start', width / 2, height / 2 + 140);
    }
    
    renderGameOver(score, highScore) {
        const width = this.canvas.width;
        const height = this.canvas.height;
        const ctx = this.canvas.getContext('2d');
        
        ctx.save();
        ctx.fillStyle = 'rgba(0, 0, 0, 0.8)';
        ctx.fillRect(0, 0, width, height);
        ctx.restore();
        
        ctx.fillStyle = '#FF5555';
        ctx.font = 'bold 64px "Courier New", monospace';
        ctx.textAlign = 'center';
        ctx.fillText('GAME OVER', width / 2, height / 3);
        
        ctx.fillStyle = '#88ffff';
        ctx.font = '32px "Courier New", monospace';
        ctx.fillText('Score: ' + score, width / 2, height / 2);
        ctx.fillText('High Score: ' + highScore, width / 2, height / 2 + 50);
        ctx.fillText('Press ENTER to restart', width / 2, height / 2 + 100);
    }
}"