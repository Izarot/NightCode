  "style.css": ":root {\n  --bg: #0A0E17;\n  --fg: #E8EAF0;\n  --accent: #00FFAA;\n  --warn: #FF6B35;\n  --ink: #FFFFFF;\n  --panel: rgba(15, 20, 30, 0.85);\n  --border: rgba(0, 255, 170, 0.2);\n  --font-main: 'Space Grotesk', sans-serif;\n  --font-mono: 'JetBrains Mono', monospace;\n}\n\n* { margin: 0; padding: 0; box-sizing: border-box; }\n\nbody {\n  background: var(--bg);\n  color: var(--fg);\n  font-family: var(--font-main);\n  height: 100vh;\n  overflow: hidden;\n  display: flex;\n  justify-content: center;\n  align-items: center;\n}\n\n#game-container {\n  width: 100%;\n  max-width: 1920px;\n  height: 100%;\n  max-height: 1080px;\n  display: flex;\n  flex-direction: column;\n}\n\n#top-bar, #bottom-bar {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  padding: 0.5rem 1rem;\n  background: var(--panel);\n  backdrop-filter: blur(12px) saturate(150%);\n  border-bottom: 1px solid var(--border);\n  gap: 1rem;\n}\n\n#top-bar {\n  border-bottom: none;\n}\n\n#timer {\n  font-family: var(--font-mono);\n  font-weight: 700;\n  font-size: 1.2rem;\n}\n\n#prompt {\n  font-weight: 600;\n  text-transform: uppercase;\n  letter-spacing: 0.5px;\n}\n\n#prompt-text {\n  text-transform: capitalize;\n}\n\n#ai-status {\n  display: flex;\n  flex-direction: column;\n  gap: 0.25rem;\n}\n\n#ai-confidence-bar {\n  height: 8px;\n  background: rgba(255,255,255,0.1);\n  border-radius: 4px;\n  overflow: hidden;\n  width: 150px;\n}\n\n#ai-confidence-fill {\n  height: 100%;\n  background: linear-gradient(90deg, var(--accent), var(--warn));\n  transition: width 0.2s ease;\n}\n\n#score {\n  font-weight: 600;\n}\n\n#canvas-container {\n  flex: 1;\n  position: relative;\n  background: #000;\n  overflow: hidden;\n}\n\n#game-canvas {\n  width: 100%;\n  height: 100%;\n  display: block;\n}\n\n#bottom-bar {\n  border-top: 1px solid var(--border);\n}\n\n.drawer, .guesser {\n  display: flex;\n  align-items: center;\n  gap: 0.5rem;\n}\n\nbutton {\n  background: var(--panel);\n  border: 1px solid var(--border);\n  color: var(--fg);\n  padding: 0.5rem 1rem;\n  border-radius: 4px;\n  cursor: pointer;\n  font-family: inherit;\n  font-size: 1rem;\n  transition: all 0.2s ease;\n}\n\nbutton:hover {\n  background: rgba(0,255,170,0.1);\n  box-shadow: 0 0 8px var(--accent);\n}\n\nbutton:active {\n  transform: scale(0.95);\n}\n\ninput[type=range] {\n  width: 100px;\n  height: 4px;\n  background: rgba(255,255,255,0.1);\n  border-radius: 2px;\n  outline: none;\n  -webkit-appearance: none;\n}\n\ninput[type=range]::-webkit-slider-thumb {\n  -webkit-appearance: none;\n  width: 12px;\n  height: 12px;\n  background: var(--accent);\n  border-radius: 50%;\n  cursor: pointer;\n}\n\n#size-value {\n  min-width: 25px;\n  text-align: right;\n}\n\n#guesser-tools {\n  flex: 1;\n}\n\n#guess-input {\n  flex: 1;\n  padding: 0.5rem;\n  background: var(--panel);\n  border: 1px solid var(--border);\n  border-radius: 4px;\n  color: var(--fg);\n  font-family: inherit;\n}\n\n#guess-input:focus {\n  outline: none;\n  border-color: var(--accent);\n  box-shadow: 0 0 0 2px rgba(0,255,170,0.2);\n}\n\n#side-panel {\n  width: 280px;\n  background: var(--panel);\n  backdrop-filter: blur(12px) saturate(150%);\n  border-left: 1px solid var(--border);\n  padding: 1rem;\n  overflow-y: auto;\n}\n\n#player-list {\n  display: flex;\n  flex-direction: column;\n  gap: 0.75rem;\n}\n\n.player-row {\n  display: flex;\n  align-items: center;\n  gap: 0.75rem;\n  padding: 0.5rem;\n  background: rgba(0,0,0,0.2);\n  border-radius: 4px;\n}\n\n.avatar {\n  font-size: 1.5rem;\n  min-width: 36px;\n  text-align: center;\n}\n\n.info {\n  flex: 1;\n}\n\n.name {\n  font-weight: 600;\n}\n\n.score {\n  font-family: var(--font-mono);\n  font-weight: 700;\n}\n\n.ai-predictions {\n  display: flex;\n  gap: 0.5rem;\n  flex-wrap: wrap;\n}\n\n.ai-predictions span {\n  background: rgba(0,255,170,0.2);\n  border: 1px solid var(--border);\n  padding: 0.25rem 0.5rem;\n  border-radius: 4px;\n  font-size: 0.875rem;\n}\n\n.streak {\n  font-family: var(--font-mono);\n  font-size: 1.5rem;\n  letter-spacing: -2px;\n}\n\n.streak .gold {\n  color: var(--accent);\n}\n\n#overlay {\n  position: fixed;\n  top: 0;\n  left: 0;\n  width: 100%;\n  height: 100%;\n  background: rgba(0,0,0,0.85);\n  display: flex;\n  justify-content: center;\n  align-items: center;\n  z-index: 1000;\n}\n\n#replay-modal {\n  background: var(--panel);\n  backdrop-filter: blur(12px) saturate(150%);\n  border: 1px solid var(--border);\n  border-radius: 8px;\n  padding: 2rem;\n  width: 90%;\n  max-width: 500px;\n  max-height: 80vh;\n  overflow-y: auto;\n}\n\n#replay-modal h2 {\n  text-align: center;\n  margin-bottom: 1.5rem;\n  color: var(--accent);\n}\n\n#replay-controls {\n  display: flex;\n  justify-content: center;\n  gap: 1rem;\n  margin-bottom: 1.5rem;\n}\n\n#replay-canvas-container {\n  width: 100%;\n  height: 200px;\n  background: #000;\n  margin-bottom: 1.5rem;\n  border-radius: 4px;\n  overflow: hidden;\n}\n\n#replay-canvas {\n  width: 100%;\n  height: 100%;\n  display: block;\n}\n\n#ai-graph {\n  height: 100px;\n  background: rgba(0,0,0,0.3);\n  border-radius: 4px;\n  margin-top: 1rem;\n  position: relative;\n}\n\n@media (max-width: 768px) {\n  #side-panel {\n    width: 100%;\n    height: 200px;\n    order: 3;\n  }\n  #top-bar, #bottom-bar {\n    flex-wrap: wrap;\n  }\n  #top-bar > div, #bottom-bar > div {\n    margin: 0.5rem 0;\n  }\n  #guess-input {\n    width: 100%;\n  }\n}\n\n@media (max-height: 500px) {\n  #side-panel {\n    display: none;\n  }\n}\n",
  "game.js": "// Neural Sketch - Simplified Client Implementation\n// This is a simplified version focusing on the sneaky features and core loop\n\n// Configuration\nconst CONFIG = {\n  ROUND_TIME: 90, // seconds\n  PROMPT: 'CAT',\n  AI_INFERENCE_INTERVAL: 500, // ms\n  LOCK_CONFIDENCE: 0.92,\n  LOGICAL_WIDTH: 1920,\n  LOGICAL_HEIGHT: 1080\n};\n\nlet canvas, ctx;\nlet replayCanvas, replayCtx;\nlet isDrawing = false;\nlet lastPoint = null;\nlet pointsBuffer = [];\nlet strokes = []; // { points: [], color, size }\nlet aiGuesses = []; // { guess, confidence, timestamp }\nlet roundStartTime = null;\nlet timerInterval = null;\nlet timeLeft = CONFIG.ROUND_TIME;\nlet score = 0;\nlet highScore = loadHighScore();\nlet gameState = 'LOBBY'; // LOBBY, DRAWING, ROUND_END, RESULTS\nlet isDrawer = true; // In this simplified version, we're always the drawer\nlet aiLocked = false;\nlet replayIndex = 0;\nlet replayStartTime = null;\n\n// Audio context for sound effects\nlet audioContext = null;\n\n// Initialize the game\nfunction init() {\n  canvas = document.getElementById('game-canvas');\n  ctx = canvas.getContext('2d');\n  replayCanvas = document.getElementById('replay-canvas');\n  replayCtx = replayCanvas.getContext('2d');\n  \n  setupCanvas();\n  setupEventListeners();\n  setupAudio();\n  \n  // Start in lobby\n  showLobby();\n  \n  // Resize handler\n  window.addEventListener('resize', setupCanvas);\n}\n\n// Setup canvas size based on device pixel ratio and container\nfunction setupCanvas() {\n  const container = document.getElementById('canvas-container');\n  const dpr = window.devicePixelRatio || 1;\n  \n  // Set logical size\n  canvas.width = CONFIG.LOGICAL_WIDTH;\n  canvas.height = CONFIG.LOGICAL_HEIGHT;\n  replayCanvas.width = CONFIG.LOGICAL_WIDTH;\n  replayCanvas.height = CONFIG.LOGICAL_HEIGHT;\n  \n  // Scale context\n  ctx.scale(dpr, dpr);\n  replayCtx.scale(dpr, dpr);\n  \n  // Set CSS size to fit container\n  canvas.style.width = '100%';\n  canvas.style.height = '100%';\n  replayCanvas.style.width = '100%';\n  replayCanvas.style.height = '100%';\n}\n\n// Setup event listeners for input and UI\nfunction setupEventListeners() {\n  // Drawing events\n  canvas.addEventListener('pointerdown', startDrawing);\n  canvas.addEventListener('pointermove', draw);\n  canvas.addEventListener('pointerup', stopDrawing);\n  canvas.addEventListener('pointerleave', stopDrawing);\n  \n  // UI events\n  document.getElementById('clear-btn').addEventListener('click', clearCanvas);\n  document.getElementById('size-slider').addEventListener('input', updateSizeDisplay);\n  document.getElementById('guess-btn').addEventListener('click', submitGuess);\n  document.getElementById('guess-input').addEventListener('keypress', e => {\n    if (e.key === 'Enter') submitGuess();\n  });\n  document.getElementById('play-replay').addEventListener('click', playReplay);\n  document.getElementById('next-round').addEventListener('click', nextRound);\n}\n\n// Setup Web Audio API for sound effects\nfunction setupAudio() {\n  audioContext = new (window.AudioContext || window.webkitAudioContext)();\n}\n\n// Play a simple beep sound\nfunction playSound(frequency, duration) {\n  if (!audioContext) return;\n  const oscillator = audioContext.createOscillator();\n  const gainNode = audioContext.createGain();\n  \n  oscillator.connect(gainNode);\n  gainNode.connect(audioContext.destination);\n  \n  oscillator.frequency.value = frequency;\n  gainNode.gain.setValueAtTime(0, audioContext.currentTime);\n  gainNode.gain.linearRampToValueAtTime(0.5, audioContext.currentTime + 0.01);\n  gainNode.gain.exponentialRampToValueAtTime(0.001, audioContext.currentTime + duration);\n  \n  oscillator.start();\n  oscillator.stop(audioContext.currentTime + duration);\n}\n\n// Start drawing on pointer down\nfunction startDrawing(e) {\n  if (gameState !== 'DRAWING') return;\n  isDrawing = true;\n  lastPoint = getPointerPos(e);\n  pointsBuffer = [lastPoint];\n}\n\n// Draw on pointer move\nfunction draw(e) {\n  if (!isDrawing) return;\n  const currentPoint = getPointerPos(e);\n  pointsBuffer.push(currentPoint);\n  \n  // Render immediately for zero-lag feel\n  renderStrokeSegment(lastPoint, currentPoint);\n  lastPoint = currentPoint;\n}\n\n// Stop drawing on pointer up\nfunction stopDrawing() {\n  if (!isDrawing) return;\n  isDrawing = false;\n  \n  // Save the completed stroke\n  if (pointsBuffer.length > 1) {\n    strokes.push({\n      points: [...pointsBuffer],\n      color: CONFIG.INK,\n      size: parseInt(document.getElementById('size-slider').value)\n    });\n    pointsBuffer = [];\n  }\n  \n  // Play ink bloom sound\n  playSound(800, 0.1);\n}\n\n// Get pointer position relative to canvas\nfunction getPointerPos(e) {\n  const rect = canvas.getBoundingClientRect();\n  const scaleX = canvas.width / rect.width;\n  const scaleY = canvas.height / rect.height;\n  \n  return {\n    x: (e.clientX - rect.left) * scaleX,\n    y: (e.clientY - rect.top) * scaleY\n  };\n}\n\n// Render a stroke segment between two points\nfunction renderStrokeSegment(p1, p2) {\n  ctx.beginPath();\n  ctx.moveTo(p1.x, p1.y);\n  ctx.lineTo(p2.x, p2.y);\n  ctx.strokeStyle = CONFIG.INK;\n  ctx.lineWidth = getBrushSize();\n  ctx.lineCap = 'round';\n  ctx.lineJoin = 'round';\n  ctx.stroke();\n}\n\n// Calculate brush size based on slider\nfunction getBrushSize() {\n  return parseInt(document.getElementById('size-slider').value);\n}\n\n// Update size display\nfunction updateSizeDisplay() {\n  document.getElementById('size-value').textContent = `${this.value}px`;\n}\n\n// Clear the canvas\nfunction clearCanvas() {\n  ctx.clearRect(0, 0, canvas.width, canvas.height);\n  strokes = [];\n  pointsBuffer = [];\n  playSound(200, 0.1);\n}\n\n// Submit a guess (for guesser role)\nfunction submitGuess() {\n  const input = document.getElementById('guess-input');\n  const guess = input.value.trim();\n  if (!guess) return;\n  \n  // In a real game, this would be sent to server\n  console.log('Guess submitted:', guess);\n  input.value = '';\n  \n  // For demo, check if correct\n  if (guess.toLowerCase() === CONFIG.PROMPT.toLowerCase()) {\n    endRound(true);\n  }\n}\n\n// Start a new round\nfunction startRound() {\n  gameState = 'DRAWING';\n  timeLeft = CONFIG.ROUND_TIME;\n  score = 0;\n  aiLocked = false;\n  aiGuesses = [];\n  strokes = [];\n  clearCanvas();\n  \n  // Update UI\n  document.getElementById('prompt-text').textContent = CONFIG.PROMPT;\n  document.getElementById('drawer-tools').style.display = isDrawer ? 'flex' : 'none';\n  document.getElementById('guesser-tools').style.display = isDrawer ? 'none' : 'flex';\n  document.getElementById('guess-input').disabled = !isDrawer;\n  document.getElementById('guess-btn').disabled = !isDrawer;\n  \n  // Start timer\n  updateTimerDisplay();\n  timerInterval = setInterval(() => {\n    timeLeft--;\n    updateTimerDisplay();\n    \n    if (timeLeft <= 0) {\n      endRound(false);\n    }\n  }, 1000);\n  \n  // Start AI inference simulation\n  startAISimulation();\n}\n\n// Update timer display\nfunction updateTimerDisplay() {\n  const minutes = Math.floor(timeLeft / 60).toString().padStart(2, '0');\n  const seconds = (timeLeft % 60).toString().padStart(2, '0');\n  document.getElementById('timer').textContent = `${minutes}:${seconds}`;\n  \n  // Color shift based on time\n  const timerEl = document.getElementById('timer');\n  if (timeLeft <= 10) {\n    timerEl.style.color = CONFIG.WARN;\n    timerEl.style.animation = 'pulse 1s infinite';\n  } else if (timeLeft <= 20) {\n    timerEl.style.color = CONFIG.WARN;\n    timerEl.style.animation = 'none';\n  } else {\n    timerEl.style.color = CONFIG.FG;\n    timerEl.style.animation = 'none';\n  }\n}\n\n// Simulate AI inference every 500ms\nfunction startAISimulation() {\n  // Clear any existing interval\n  if (window.aiInterval) clearInterval(window.aiInterval);\n  \n  window.aiInterval = setInterval(() => {\n    if (gameState !== 'DRAWING' || aiLocked) return;\n    \n    // Simulate AI confidence based on drawing progress\n    const confidence = Math.min(0.95, (strokes.length * 0.05) + (Math.random() * 0.1));\n    const guess = Math.random() > 0.5 ? CONFIG.PROMPT : 'DOG'; // Sometimes wrong\n    \n    aiGuesses.push({ guess, confidence, timestamp: Date.now() });\n    \n    // Update UI\n    document.getElementById('ai-guess').textContent = guess;\n    document.getElementById('ai-confidence-fill').style.width = `${confidence * 100}%`;\n    \n    // Update AI predictions in side panel\n    updateAIPredictions();\n    \n    // Check for lock\n    if (guess.toLowerCase() === CONFIG.PROMPT.toLowerCase() && confidence >= CONFIG.LOCK_CONFIDENCE) {\n      aiLocked = true;\n      clearInterval(window.aiInterval);\n      endRound(true);\n    }\n  }, CONFIG.AI_INFERENCE_INTERVAL);\n}\n\n// Update AI predictions display\nfunction updateAIPredictions() {\n  const predictionsEl = document.getElementById('ai-predictions');\n  predictionsEl.innerHTML = '';\n  \n  // Get unique guesses from last 5 inferences\n  const recent = aiGuesses.slice(-5);\n  const guessCounts = {};\n  recent.forEach(g => {\n    guessCounts[g.guess] = (guessCounts[g.guess] || 0) + 1;\n  });\n  \n  // Sort by count\n  const sorted = Object.entries(guessCounts)\n    .sort(([,a], [,b]) => b - a)\n    .slice(0, 3);\n  \n  sorted.forEach(([guess, count]) => {\n    const conf = recent.filter(g => g.guess === guess).reduce((sum, g) => sum + g.confidence, 0) / count;\n    const el = document.createElement('span');\n    el.textContent = `${guess}: ${Math.round(conf * 100)}%`;\n    predictionsEl.appendChild(el);\n  });\n}\n\n// End the round\nfunction endRound(success) {\n  gameState = 'ROUND_END';\n  clearInterval(timerInterval);\n  if (window.aiInterval) clearInterval(window.aiInterval);\n  \n  // Calculate score\n  let roundScore = 0;\n  if (success && aiLocked) {\n    // AI Early Lock bonus\n    roundScore += 75;\n    // Time bonus\n    roundScore += timeLeft * 2;\n    playSound(1000, 0.3"game.js": "// Neural Sketch - Simplified Client Implementation\n// This is a simplified version focusing on the sneaky features and core loop\n\n// Configuration\nconst CONFIG = {\n  ROUND_TIME: 90, // seconds\n  PROMPT: 'CAT',\n  AI_INFERENCE_INTERVAL: 500, // ms\n  LOCK_CONFIDENCE: 0.92,\n  LOGICAL_WIDTH: 1920,\n  LOGICAL_HEIGHT: 1080\n};\n\nlet canvas, ctx;\nlet replayCanvas, replayCtx;\nlet isDrawing = false;\nlet lastPoint = null;\nlet pointsBuffer = [];\nlet strokes = []; // { points: [], color, size }\nlet aiGuesses = []; // { guess, confidence, timestamp }\nlet roundStartTime = null;\nlet timerInterval = null;\nlet timeLeft = CONFIG.ROUND_TIME;\nlet score = 0;\nlet highScore = loadHighScore();\nlet gameState = 'LOBBY'; // LOBBY, DRAWING, ROUND_END, RESULTS\nlet isDrawer = true; // In this simplified version, we're always the drawer\nlet aiLocked = false;\nlet replayIndex = 0;\nlet replayStartTime = null;\n\n// Audio context for sound effects\nlet audioContext = null;\n\n// Initialize the game\nfunction init() {\n  canvas = document.getElementById('game-canvas');\n  ctx = canvas.getContext('2d');\n  replayCanvas = document.getElementById('replay-canvas');\n  replayCtx = replayCanvas.getContext('2d');\n  \n  setupCanvas();\n  setupEventListeners();\n  setupAudio();\n  \n  // Start in lobby\n  showLobby();\n  \n  // Resize handler\n  window.addEventListener('resize', setupCanvas);\n}\n\n// Setup canvas size based on device pixel ratio and container\nfunction setupCanvas() {\n  const container = document.getElementById('canvas-container');\n  const dpr = window.devicePixelRatio || 1;\n  \n  // Set logical size\n  canvas.width = CONFIG.LOGICAL_WIDTH;\n  canvas.height = CONFIG.LOGICAL_HEIGHT;\n  replayCanvas.width = CONFIG.LOGICAL_WIDTH;\n  replayCanvas.height = CONFIG.LOGICAL_HEIGHT;\n  \n  // Scale context\n  ctx.scale(dpr, dpr);\n  replayCtx.scale(dpr, dpr);\n  \n  // Set CSS size to fit container\n  canvas.style.width = '100%';\n  canvas.style.height = '100%';\n  replayCanvas.style.width = '100%';\n  replayCanvas.style.height = '100%';\n}\n\n// Setup event listeners for input and UI\nfunction setupEventListeners() {\n  // Drawing events\n  canvas.addEventListener('pointerdown', startDrawing);\n  canvas.addEventListener('pointermove', draw);\n  canvas.addEventListener('pointerup', stopDrawing);\n  canvas.addEventListener('pointerleave', stopDrawing);\n  \n  // UI events\n  document.getElementById('clear-btn').addEventListener('click', clearCanvas);\n  document.getElementById('size-slider').addEventListener('input', updateSizeDisplay);\n  document.getElementById('guess-btn').addEventListener('click', submitGuess);\n  document.getElementById('guess-input').addEventListener('keypress', e => {\n    if (e.key === 'Enter') submitGuess();\n  });\n  document.getElementById('play-replay').addEventListener('click', playReplay);\n  document.getElementById('next-round').addEventListener('click', nextRound);\n}\n\n// Setup Web Audio API for sound effects\nfunction setupAudio() {\n  audioContext = new (window.AudioContext || window.webkitAudioContext)();\n}\n\n// Play a simple beep sound\nfunction playSound(frequency, duration) {\n  if (!audioContext) return;\n  const oscillator = audioContext.createOscillator();\n  const gainNode = audioContext.createGain();\n  \n  oscillator.connect(gainNode);\n  gainNode.connect(audioContext.destination);\n  \n  oscillator.frequency.value = frequency;\n  gainNode.gain.setValueAtTime(0, audioContext.currentTime);\n  gainNode.gain.linearRampToValueAtTime(0.5, audioContext.currentTime + 0.01);\n  gainNode.gain.exponentialRampToValueAtTime(0.001, audioContext.currentTime + duration);\n  \n  oscillator.start();\n  oscillator.stop(audioContext.currentTime + duration);\n}\n\n// Start drawing on pointer down\nfunction startDrawing(e) {\n  if (gameState !== 'DRAWING') return;\n  isDrawing = true;\n  lastPoint = getPointerPos(e);\n  pointsBuffer = [lastPoint];\n}\n\n// Draw on pointer move\nfunction draw(e) {\n  if (!isDrawing) return;\n  const currentPoint = getPointerPos(e);\n  pointsBuffer.push(currentPoint);\n  \n  // Render immediately for zero-lag feel\n  renderStrokeSegment(lastPoint, currentPoint);\n  lastPoint = currentPoint;\n}\n\n// Stop drawing on pointer up\nfunction stopDrawing() {\n  if (!isDrawing) return;\n  isDrawing = false;\n  \n  // Save the completed stroke\n  if (pointsBuffer.length > 1) {\n    strokes.push({\n      points: [...pointsBuffer],\n      color: CONFIG.INK,\n      size: parseInt(document.getElementById('size-slider').value)\n    });\n    pointsBuffer = [];\n  }\n  \n  // Play ink bloom sound\n  playSound(800, 0.1);\n}\n\n// Get pointer position relative to canvas\nfunction getPointerPos(e) {\n  const rect = canvas.getBoundingClientRect();\n  const scaleX = canvas.width / rect.width;\n  const scaleY = canvas.height / rect.height;\n  \n  return {\n    x: (e.clientX - rect.left) * scaleX,\n    y: (e.clientY - rect.top) * scaleY\n  };\n}\n\n// Render a stroke segment between two points\nfunction renderStrokeSegment(p1, p2) {\n  ctx.beginPath();\n  ctx.moveTo(p1.x, p1.y);\n  ctx.lineTo(p2.x, p2.y);\n  ctx.strokeStyle = CONFIG.INK;\n  ctx.lineWidth = getBrushSize();\n  ctx.lineCap = 'round';\n  ctx.lineJoin = 'round';\n  ctx.stroke();\n}\n\n// Calculate brush size based on slider\nfunction getBrushSize() {\n  return parseInt(document.getElementById('size-slider').value);\n}\n\n// Update size display\nfunction updateSizeDisplay() {\n  document.getElementById('size-value').textContent = `${this.value}px`;\n}\n\n// Clear the canvas\nfunction clearCanvas() {\n  ctx.clearRect(0, 0, canvas.width, canvas.height);\n  strokes = [];\n  pointsBuffer = [];\n  playSound(200, 0.1);\n}\n\n// Submit a guess (for guesser role)\nfunction submitGuess() {\n  const input = document.getElementById('guess-input');\n  const guess = input.value.trim();\n  if (!guess) return;\n  \n  // In a real game, this would be sent to server\n  console.log('Guess submitted:', guess);\n  input.value = '';\n  \n  // For demo, check if correct\n  if (guess.toLowerCase() === CONFIG.PROMPT.toLowerCase()) {\n    endRound(true);\n  }\n}\n\n// Start a new round\nfunction startRound() {\n  gameState = 'DRAWING';\n  timeLeft = CONFIG.ROUND_TIME;\n  score = 0;\n  aiLocked = false;\n  aiGuesses = [];\n  strokes = [];\n  clearCanvas();\n  \n  // Update UI\n  document.getElementById('prompt-text').textContent = CONFIG.PROMPT;\n  document.getElementById('drawer-tools').style.display = isDrawer ? 'flex' : 'none';\n  document.getElementById('guesser-tools').style.display = isDrawer ? 'none' : 'flex';\n  document.getElementById('guess-input').disabled = !isDrawer;\n  document.getElementById('guess-btn').disabled = !isDrawer;\n  \n  // Start timer\n  updateTimerDisplay();\n  timerInterval = setInterval(() => {\n    timeLeft--;\n    updateTimerDisplay();\n    \n    if (timeLeft <= 0) {\n      endRound(false);\n    }\n  }, 1000);\n  \n  // Start AI inference simulation\n  startAISimulation();\n}\n\n// Update timer display\nfunction updateTimerDisplay() {\n  const minutes = Math.floor(timeLeft / 60).toString().padStart(2, '0');\n  const seconds = (timeLeft % 60).toString().padStart(2, '0');\n  document.getElementById('timer').textContent = `${minutes}:${seconds}`;\n  \n  // Color shift based on time\n  const timerEl = document.getElementById('timer');\n  if (timeLeft <= 10) {\n    timerEl.style.color = CONFIG.WARN;\n    timerEl.style.animation = 'pulse 1s infinite';\n  } else if (timeLeft <= 20) {\n    timerEl.style.color = CONFIG.WARN;\n    timerEl.style.animation = 'none';\n  } else {\n    timerEl.style.color = CONFIG.FG;\n    timerEl.style.animation = 'none';\n  }\n}\n\n// Simulate AI inference every 500ms\nfunction startAISimulation() {\n  // Clear any existing interval\n  if (window.aiInterval) clearInterval(window.aiInterval);\n  \n  window.aiInterval = setInterval(() => {\n    if (gameState !== 'DRAWING' || aiLocked) return;\n    \n    // Simulate AI confidence based on drawing progress\n    const confidence = Math.min(0.95, (strokes.length * 0.05) + (Math.random() * 0.1));\n    const guess = Math.random() > 0.5 ? CONFIG.PROMPT : 'DOG'; // Sometimes wrong\n    \n    aiGuesses.push({ guess, confidence, timestamp: Date.now() });\n    \n    // Update UI\n    document.getElementById('ai-guess').textContent = guess;\n    document.getElementById('ai-confidence-fill').style.width = `${confidence * 100}%`;\n    \n    // Update AI predictions in side panel\n    updateAIPredictions();\n    \n    // Check for lock\n    if (guess.toLowerCase() === CONFIG.PROMPT.toLowerCase() && confidence >= CONFIG.LOCK_CONFIDENCE) {\n      aiLocked = true;\n      clearInterval(window.aiInterval);\n      endRound(true);\n    }\n  }, CONFIG.AI_INFERENCE_INTERVAL);\n}\n\n// Update AI predictions display\nfunction updateAIPredictions() {\n  const predictionsEl = document.getElementById('ai-predictions');\n  predictionsEl.innerHTML = '';\n  \n  // Get unique guesses from last 5 inferences\n  const recent = aiGuesses.slice(-5);\n  const guessCounts = {};\n  recent.forEach(g => {\n    guessCounts[g.guess] = (guessCounts[g.guess] || 0) + 1;\n  });\n  \n  // Sort by count\n  const sorted = Object.entries(guessCounts)\n    .sort(([,a], [,b]) => b - a)\n    .slice(0, 3);\n  \n  sorted.forEach(([guess, count]) => {\n    const conf = recent.filter(g => g.guess === guess).reduce((sum, g) => sum + g.confidence, 0) / count;\n    const el = document.createElement('span');\n    el.textContent = `${guess}: ${Math.round(conf * 100)}%`;\n    predictionsEl.appendChild(el);\n  });\n}\n\n// End the round\nfunction endRound(success) {\n  gameState = 'ROUND_END';\n  clearInterval(timerInterval);\n  if (window.aiInterval) clearInterval(window.aiInterval);\n  \n  // Calculate score\n  let roundScore = 0;\n  if (success && aiLocked) {\n    // AI Early Lock bonus\n    roundScore += 75;\n    // Time bonus\n    roundScore += timeLeft * 2;\n    playSound(1000, 0.3);\n  } else if (success && !aiLocked) {\n    // Guesser got it first\n    roundScore += 50;\n    playSound(600, 0.2);\n  } else {\n    // Time ran out\n    roundScore += Math.floor(timeLeft);\n    playSound(300, 0.2);\n  }\n  \n  score += roundScore;\n  if (score > highScore) {\n    highScore = score;\n    saveHighScore(highScore);\n  }\n  \n  document.getElementById('score-value').textContent = score;\n  document.getElementById('human-score').textContent = score;\n  \n  // Show results overlay\n  showResults(success, roundScore);\n}\n\n// Show results overlay\nfunction showResults(success, roundScore) {\n  const overlay = document.getElementById('overlay');\n  overlay.style.display = 'flex';\n  \n  // Setup replay canvas\n  setupReplay();\n}\n\n// Setup replay\nfunction setupReplay() {\n  replayCtx.clearRect(0, 0, replayCanvas.width, replayCanvas.height);\n  replayIndex = 0;\n  replayStartTime = null;\n}\n\n// Play replay\nfunction playReplay() {\n  if (replayStartTime === null) {\n    replayStartTime = Date.now();\n  }\n  \n  const elapsed = Date.now() - replayStartTime;\n  const targetTime = elapsed * 0.5; // Speed up 2x\n  \n  // Draw strokes up to current replay index\n  while (replayIndex < strokes.length) {\n    const stroke = strokes[replayIndex];\n    renderStrokeToReplay(stroke);\n    replayIndex++;\n  }\n}\n\n// Render a stroke to replay canvas\nfunction renderStrokeToReplay(stroke) {\n  if (stroke.points.length < 2) return;\n  \n  replayCtx.beginPath();\n  replayCtx.moveTo(stroke.points[0].x, stroke.points[0].y);\n  \n  for (let i = 1; i < stroke.points.length; i++) {\n    replayCtx.lineTo(stroke.points[i].x, stroke.points[i].y);\n  }\n  \n  replayCtx.strokeStyle = stroke.color;\n  replayCtx.lineWidth = stroke.size;\n  replayCtx.lineCap = 'round';\n  replayCtx.lineJoin = 'round';\n  replayCtx.stroke();\n}\n\n// Next round\nfunction nextRound() {\n  document.getElementById('overlay').style.display = 'none';\n  startRound();\n}\n\n// Show lobby\nfunction showLobby() {\n  gameState = 'LOBBY';\n  document.getElementById('score-value').textContent = score;\n  \n  // Auto-start after a brief delay\n  setTimeout(() => {\n    startRound();\n  }, 1000);\n}\n\n// Load high score from localStorage\nfunction loadHighScore() {\n  return parseInt(localStorage.getItem('neural-sketch-highscore') || '0');\n}\n\n// Save high score to localStorage\nfunction saveHighScore(score) {\n  localStorage.setItem('neural-sketch-highscore', score.toString());\n}\n\n// Initialize when DOM is ready\ndocument.addEventListener('DOMContentLoaded', init);\n    </script>\n  </body>\n</html>",
  "style.css": ":root {\n  --bg: #0A0E17;\n  --fg: #E8EAF0;\n  --accent: #00FFAA;\n  --warn: #FF6B35;\n  --ink: #FFFFFF;\n  --panel: rgba(15, 20, 30, 0.85);\n  --border: rgba(0, 255, 170, 0.2);\n  --font-main: 'Space Grotesk', sans-serif;\n  --font-mono: 'JetBrains Mono', monospace;\n}\n\n* { margin: 0; padding: 0; box-sizing: border-box; }\n\nbody {\n  background: var(--bg);\n  color: var(--fg);\n  font-family: var(--font-main);\n  height: 100vh;\n  overflow: hidden;\n  display: flex;\n  justify-content: center;\n  align-items: center;\n}\n\n#game-container {\n  width: 100%;\n  max-width: 1920px;\n  height: 100%;\n  max-height: 1080px;\n  display: flex;\n  flex-direction: column;\n}\n\n#top-bar, #bottom-bar {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  padding: 0.5rem 1rem;\n  background: var(--panel);\n  backdrop-filter: blur(12px) saturate(150%);\n  border-bottom: 1px solid var(--border);\n  gap: 1rem;\n}\n\n#top-bar {\n  border-bottom: none;\n}\n\n#timer {\n  font-family: var(--font-mono);\n  font-weight: 700;\n  font-size: 1.2rem;\n}\n\n#prompt {\n  font-weight: 600;\n  text-transform: uppercase;\n  letter-spacing: 0.5px;\n}\n\n#prompt-text {\n  text-transform: capitalize;\n}\n\n#ai-status {\n  display: flex;\n  flex-direction: column;\n  gap: 0.25rem;\n}\n\n#ai-confidence-bar {\n  height: 8px;\n  background: rgba(255,255,255,0.1);\n  border-radius: 4px;\n  overflow: hidden;\n  width: 150px;\n}\n\n#ai-confidence-fill {\n  height: 100%;\n  background: linear-gradient(90deg, var(--accent), var(--warn));\n  transition: width 0.2s ease;\n}\n\n#score {\n  font-weight: 600;\n}\n\n#canvas-container {\n  flex: 1;\n  position: relative;\n  background: #000;\n  overflow: hidden;\n}\n\n#game-canvas {\n  width: 100%;\n  height: 100%;\n  display: block;\n}\n\n#bottom-bar {\n  border-top: 1px solid var(--border);\n}\n\n.drawer, .guesser {\n  display: flex;\n  align-items: center;\n  gap: 0.5rem;\n}\n\nbutton {\n  background: var(--panel);\n  border: 1px solid var(--border);\n  color: var(--fg);\n  padding: 0.5rem 1rem;\n  border-radius: 4px;\n  cursor: pointer;\n  font-family: inherit;\n  font-size: 1rem;\n  transition: all 0.2s ease;\n}\n\nbutton:hover {\n  background: rgba(0,255,170,0.1);\n  box-shadow: 0 0 8px var(--accent);\n}\n\nbutton:active {\n  transform: scale(0.95);\n}\n\ninput[type=range] {\n  width: 100px;\n  height: 4px;\n  background: rgba(255,255,255,0.1);\n  border-radius: 2px;\n  outline: none;\n  -webkit-appearance: none;\n}\n\ninput[type=range]::-webkit-slider-thumb {\n  -webkit-appearance: none;\n  width: 12px;\n  height: 12px;\n  background: var(--accent);\n  border-radius: 50%;\n  cursor: pointer;\n}\n\n#size-value {\n  min-width: 25px;\n  text-align: right;\n}\n\n#guesser-tools {\n  flex: 1;\n}\n\n#guess-input {\n  flex: 1;\n  padding: 0.5rem;\n  background: var(--panel);\n  border: 1px solid var(--border);\n  border-radius: 4px;\n  color: var(--fg);\n  font-family: inherit;\n}\n\n#guess-input:focus {\n  outline: none;\n  border-color: var(--accent);\n  box-shadow: 0 0 0 2px rgba(0,255,170,0.2);\n}\n\n#side-panel {\n  width: 280px;\n  background: var(--panel);\n  backdrop-filter: blur(12px) saturate(150%);\n  border-left: 1px solid var(--border);\n  padding: 1rem;\n  overflow-y: auto;\n}\n\n#player-list {\n  display: flex;\n  flex-direction: column;\n  gap: 0.75rem;\n}\n\n.player-row {\n  display: flex;\n  align-items: center;\n  gap: 0.75rem;\n  padding: 0.5rem;\n  background: rgba(0,0,0,0.2);\n  border-radius: 4px;\n}\n\n.avatar {\n  font-size: 1.5rem;\n