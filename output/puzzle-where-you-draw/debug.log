  "index.html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no\">\n  <title>ShapeShift – Physics Puzzle</title>\n  <link rel=\"icon\" href=\"data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🎮</text></svg>\">\n  <style>\n    * { margin: 0; padding: 0; box-sizing: border-box; }\n    body { background: #1a1a2e; font-family: 'Segoe UI', sans-serif; color: #eee; overflow: hidden; height: 100vh; display: flex; flex-direction: column; }\n    #game-container { flex: 1; position: relative; display: flex; justify-content: center; align-items: center; }\n    canvas { display: block; max-width: 100%; max-height: 100%; touch-action: none; }\n    #ui-overlay { position: absolute; top: 0; left: 0; width: 100%; height: 100%; pointer-events: none; display: flex; flex-direction: column; }\n    .hud-row { display: flex; justify-content: space-between; padding: 10px 20px; pointer-events: auto; }\n    .hud-item { background: rgba(0,0,0,0.6); padding: 8px 16px; border-radius: 8px; font-size: 14px; font-weight: 600; backdrop-filter: blur(4px); border: 1px solid rgba(255,255,255,0.1); }\n    .hud-center { display: flex; gap: 20px; }\n    .btn { background: linear-gradient(135deg, #3498db, #2980b9); border: none; color: white; padding: 10px 20px; border-radius: 6px; cursor: pointer; font-weight: 600; transition: transform 0.1s; }\n    .btn:active { transform: scale(0.95); }\n    .btn.secondary { background: linear-gradient(135deg, #e74c3c, #c0392b); }\n    .btn.hint { background: linear-gradient(135deg, #f1c40f, #f39c12); color: #1a1a2e; }\n    .bottom-controls { display: flex; justify-content: space-between; padding: 10px 20px; pointer-events: auto; margin-top: auto; }\n    .control-group { display: flex; gap: 10px; align-items: center; }\n    .mode-toggle { width: 50px; height: 50px; border-radius: 50%; background: rgba(0,0,0,0.7); border: 2px solid #3498db; display: flex; align-items: center; justify-content: center; font-size: 24px; cursor: pointer; transition: all 0.2s; }\n    .mode-toggle.active { background: #3498db; box-shadow: 0 0 20px #3498db; }\n    .progress-container { width: 200px; height: 10px; background: rgba(0,0,0,0.5); border-radius: 5px; overflow: hidden; border: 1px solid rgba(255,255,255,0.1); }\n    .progress-bar { height: 100%; background: linear-gradient(90deg, #2ecc71, #27ae60); width: 0%; transition: width 0.3s; }\n    #menu-screen, #level-select, #game-over { position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: rgba(26,26,46,0.95); display: flex; flex-direction: column; align-items: center; justify-content: center; z-index: 10; backdrop-filter: blur(8px); }\n    .hidden { display: none !important; }\n    h1 { font-size: 3rem; background: linear-gradient(135deg, #3498db, #e74c3c, #2ecc71, #f1c40f); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; margin-bottom: 1rem; text-shadow: 0 0 30px rgba(52,152,219,0.5); }\n    .menu-btn { margin: 10px; padding: 15px 40px; font-size: 1.2rem; min-width: 200px; }\n    .level-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 20px; padding: 20px; max-width: 800px; }\n    .level-card { background: rgba(255,255,255,0.05); border: 2px solid transparent; border-radius: 12px; padding: 20px; cursor: pointer; transition: all 0.3s; position: relative; }\n    .level-card:hover { border-color: #3498db; transform: translateY(-4px); box-shadow: 0 10px 30px rgba(52,152,219,0.3); }\n    .level-card.completed { border-color: #2ecc71; }\n    .level-card.locked { opacity: 0.5; cursor: not-allowed; }\n    .level-number { font-size: 2rem; font-weight: bold; color: #3498db; }\n    .level-preview { width: 100%; height: 80px; margin-top: 10px; background: rgba(0,0,0,0.3); border-radius: 4px; }\n    .score-breakdown { text-align: left; width: 80%; max-width: 400px; margin-top: 20px; }\n    .score-row { display: flex; justify-content: space-between; padding: 8px 0; border-bottom: 1px solid rgba(255,255,255,0.1); }\n    .score-total { font-size: 1.5rem; font-weight: bold; color: #f1c40f; text-align: right; margin-top: 15px; }\n    @media (max-width: 600px) { h1 { font-size: 2rem; } .hud-row { flex-wrap: wrap; gap: 10px; } .hud-center { order: 3; width: 100%; justify-content: center; } .progress-container { width: 150px; } }\n  </style>\n</head>\n<body>\n  <div id=\"game-container\">\n    <canvas id=\"game-canvas\"></canvas>\n    <div id=\"ui-overlay\">\n      <div class=\"hud-row\">\n        <div class=\"hud-item\" id=\"level-indicator\">LEVEL: L01</div>\n        <div class=\"hud-center\">\n          <div class=\"hud-item\" id=\"timer\">00:00</div>\n          <div class=\"hud-item\" id=\"move-counter\">MOVES: 0/30</div>\n        </div>\n        <div class=\"hud-item\">\n          <button class=\"btn\" id=\"pause-btn\">⏸</button>\n          <button class=\"btn secondary\" id=\"restart-btn\">↻</button>\n          <button class=\"btn hint\" id=\"hint-btn\">💡 HINT (3)</button>\n        </div>\n      </div>\n      <div class=\"bottom-controls\">\n        <div class=\"control-group\">\n          <button class=\"mode-toggle\" id=\"draw-mode-btn\" title=\"Draw Mode (E)\">✏️</button>\n        </div>\n        <div class=\"control-group\">\n          <div class=\"progress-container\"><div class=\"progress-bar\" id=\"progress-bar\"></div></div>\n        </div>\n      </div>\n    </div>\n    <div id=\"menu-screen\">\n      <h1>ShapeShift</h1>\n      <p style=\"color: #888; margin-bottom: 2rem;\">Physics Puzzle — Draw Shapes, Bend Reality</p>\n      <button class=\"btn menu-btn\" id=\"play-btn\">PLAY</button>\n      <button class=\"btn menu-btn secondary\" id=\"settings-btn\">SETTINGS</button>\n      <button class=\"btn menu-btn\" id=\"leaderboard-btn\">LEADERBOARD</button>\n    </div>\n    <div id=\"level-select\" class=\"hidden\">\n      <h1>SELECT LEVEL</h1>\n      <div class=\"level-grid\" id=\"level-grid\"></div>\n      <button class=\"btn menu-btn secondary\" id=\"back-btn\">BACK</button>\n    </div>\n    <div id=\"game-over\" class=\"hidden\">\n      <h1 id=\"result-title\">LEVEL COMPLETE</h1>\n      <div class=\"score-breakdown\" id=\"score-breakdown\"></div>\n      <div class=\"score-total\" id=\"score-total\">TOTAL: 0</div>\n      <button class=\"btn menu-btn\" id=\"next-level-btn\">NEXT LEVEL</button>\n      <button class=\"btn menu-btn secondary\" id=\"retry-btn\">RETRY</button>\n      <button class=\"btn menu-btn\" id=\"menu-btn\">MENU</button>\n    </div>\n  </div>\n  <script src=\"src/main.js\"></script>\n</body>\n</html>",
  "src/main.js": "// ShapeShift – Physics Puzzle Main Entry Point\nimport { PhysicsEngine } from './physics.js';\nimport { InputManager } from './input.js';\nimport { LevelManager } from './levels.js';\nimport { UIManager } from './ui.js';\n\nclass Game {\n  constructor() {\n    this.canvas = document.getElementById('game-canvas');\n    this.ctx = this.canvas.getContext('2d');\n    this.resize();\n    window.addEventListener('resize', () => this.resize());\n\n    this.physics = new PhysicsEngine();\n    this.input = new InputManager(this.canvas);\n    this.levels = new LevelManager();\n    this.ui = new UIManager(this);\n\n    this.state = 'menu'; // menu, levelSelect, playing, paused, gameOver\n    this.currentLevel = null;\n    this.levelData = null;\n    \n    this.avatar = null;\n    this.shapes = [];\n    this.particles = [];\n    \n    this.timer = 0;\n    this.movesUsed = 0;\n    this.moveLimit = 30;\n    this.timeLimit = 60;\n    \n    this.drawMode = false;\n    this.drawing = false;\n    this.currentShape = null;\n    this.shapeVertices = [];\n    \n    this.hintsUsed = 0;\n    this.maxHints = 3;\n    \n    this.audioCtx = null;\n    this.sounds = {};\n    this.initAudio();\n    \n    this.lastTime = 0;\n    this.gameSpeed = 1;\n    \n    this.ui.showMenu();\n    requestAnimationFrame(this.loop.bind(this));\n  }\n\n  initAudio() {\n    try {\n      this.audioCtx = new (window.AudioContext || window.webkitAudioContext)();\n      // Create simple oscillator-based sounds\n      this.sounds = {\n        draw: () => this.playTone(440, 0.1, 'sine', 0.3),\n        place: () => this.playTone(660, 0.15, 'square', 0.2),\n        undo: () => this.playTone(330, 0.1, 'sawtooth', 0.2),\n        collision: () => this.playTone(220, 0.05, 'triangle', 0.15),\n        win: () => this.playMelody([523, 659, 784, 1047], 0.15),\n        fail: () => this.playTone(150, 0.5, 'sawtooth', 0.3),\n        click: () => this.playTone(800, 0.05, 'sine', 0.1)\n      };\n    } catch (e) {\n      console.warn('Web Audio API not supported');\n      this.sounds = { draw:()=>{}, place:()=>{}, undo:()=>{}, collision:()=>{}, win:()=>{}, fail:()=>{}, click:()=>{} };\n    }\n  }\n\n  playTone(freq, dur, type='sine', vol=0.2) {\n    if (!this.audioCtx) return;\n    const osc = this.audioCtx.createOscillator();\n    const gain = this.audioCtx.createGain();\n    osc.type = type;\n    osc.frequency.value = freq;\n    gain.gain.value = vol;\n    osc.connect(gain);\n    gain.connect(this.audioCtx.destination);\n    osc.start();\n    gain.gain.exponentialRampToValueAtTime(0.001, this.audioCtx.currentTime + dur);\n    osc.stop(this.audioCtx.currentTime + dur);\n  }\n\n  playMelody(notes, noteDur) {\n    notes.forEach((freq, i) => setTimeout(() => this.playTone(freq, noteDur), i * noteDur * 1000));\n  }\n\n  resize() {\n    const container = document.getElementById('game-container');\n    const rect = container.getBoundingClientRect();\n    const dpr = window.devicePixelRatio || 1;\n    this.canvas.width = rect.width * dpr;\n    this.canvas.height = rect.height * dpr;\n    this.canvas.style.width = rect.width + 'px';\n    this.canvas.style.height = rect.height + 'px';\n    this.ctx.scale(dpr, dpr);\n    this.logicalWidth = rect.width;\n    this.logicalHeight = rect.height;\n    this.scale = Math.min(this.logicalWidth / 1920, this.logicalHeight / 1080);\n    this.offsetX = (this.logicalWidth - 1920 * this.scale) / 2;\n    this.offsetY = (this.logicalHeight - 1080 * this.scale) / 2;\n  }\n\n  startLevel(levelId) {\n    this.state = 'playing';\n    this.levelData = this.levels.getLevel(levelId);\n    this.currentLevel = levelId;\n    this.timer = 0;\n    this.movesUsed = 0;\n    this.moveLimit = this.levelData.moveLimit || 30;\n    this.timeLimit = this.levelData.timeLimit || 60;\n    this.hintsUsed = 0;\n    \n    this.physics.reset();\n    this.shapes = [];\n    this.particles = [];\n    \n    // Create static level objects\n    this.levelData.objects.forEach(obj => {\n      if (obj.type === 'static') {\n        this.createStaticShape(obj);\n      } else if (obj.type === 'dynamic') {\n        this.createDynamicShape(obj);\n      } else if (obj.type === 'ball') {\n        this.createBall(obj);\n      } else if (obj.type === 'zone') {\n        this.goalZone = obj;\n      }\n    });\n    \n    // Create avatar\n    this.avatar = {\n      x: 100,\n      y: 100,\n      radius: 12,\n      vx: 0,\n      vy: 0,\n      onGround: false,\n      color: '#fff',\n      outline: '#3498db',\n      pulse: 0\n    };\n    \n    this.ui.updateLevelIndicator(levelId);\n    this.ui.updateMoveCounter(this.movesUsed, this.moveLimit);\n    this.ui.updateTimer(this.timeLimit);\n    this.ui.updateHintButton(this.maxHints - this.hintsUsed);\n    this.ui.hideAllScreens();\n  }\n\n  createStaticShape(obj) {\n    let vertices = [];\n    if (obj.shape === 'rect') {\n      const [x, y] = obj.position;\n      const [w, h] = obj.size;\n      vertices = [[x, y], [x+w, y], [x+w, y+h], [x, y+h]];\n    } else if (obj.shape === 'polygon') {\n      vertices = [];\n      for (let i=0; i<obj.vertices.length; i+=2) {\n        vertices.push([obj.vertices[i], obj.vertices[i+1]]);\n      }\n    }\n    const body = this.physics.createBody({\n      vertices,\n      mass: 0, // static\n      restitution: 0.2,\n      friction: 0.5,\n      color: obj.color || '#3498db',\n      isStatic: true\n    });\n    this.shapes.push(body);\n  }\n\n  createDynamicShape(obj) {\n    let vertices = [];\n    for (let i=0; i<obj.vertices.length; i+=2) {\n      vertices.push([obj.vertices[i], obj.vertices[i+1]]);\n    }\n    const area = this.polygonArea(vertices);\n    const mass = Math.max(1, area / 100);\n    const body = this.physics.createBody({\n      vertices,\n      mass,\n      restitution: 0.2,\n      friction: 0.5,\n      color: obj.color || '#e74c3c',\n      isStatic: false\n    });\n    this.shapes.push(body);\n  }\n\n  createBall(obj) {\n    const [x, y] = obj.position;\n    this.ball = this.physics.createBody({\n      vertices: this.circleVertices(x, y, obj.radius),\n      mass: 1,\n      restitution: 0.4,\n      friction: 0.3,\n      color: '#f1c40f',\n      isStatic: false,\n      isCircle: true,\n      radius: obj.radius\n    });\n    this.ball.target = obj.target;\n    this.shapes.push(this.ball);\n  }\n\n  circleVertices(cx, cy, r, segments=16) {\n    const verts = [];\n    for (let i=0; i<segments; i++) {\n      const angle = (i / segments) * Math.PI * 2;\n      verts.push([cx + Math.cos(angle) * r, cy + Math.sin(angle) * r]);\n    }\n    return verts;\n  }\n\n  polygonArea(verts) {\n    let area = 0;\n    for (let i=0; i<verts.length; i++) {\n      const j = (i+1) % verts.length;\n      area += verts[i][0] * verts[j][1] - verts[j][0] * verts[i][1];\n    }\n    return Math.abs(area) / 2;\n  }\n\n  loop(timestamp) {\n    const dt = Math.min((timestamp - this.lastTime) / 1000, 1/30) * this.gameSpeed;\n    this.lastTime = timestamp;\n    \n    if (this.state === 'playing') {\n      this.update(dt);\n    }\n    this.render();\n    requestAnimationFrame(this.loop.bind(this));\n  }\n\n  update(dt) {\n    this.timer += dt;\n    this.ui.updateTimer(this.timeLimit - this.timer);\n    \n    // Check time limit\n    if (this.timer >= this.timeLimit) {\n      this.failLevel('Time limit exceeded!');\n      return;\n    }\n    \n    // Update avatar physics\n    this.updateAvatar(dt);\n    \n    // Update physics engine\n    this.physics.step(dt);\n    \n    // Check win condition\n    if (this.checkWin()) {\n      this.completeLevel();\n      return;\n    }\n    \n    // Check avatar fall\n    if (this.avatar.y > this.levelData.height + 100) {\n      this.failLevel('Avatar fell off!');\n      return;\n    }\n    \n    // Update particles\n    this.particles = this.particles.filter(p => p.life > 0);\n    this.particles.forEach(p => {\n      p.x += p.vx * dt;\n      p.y += p.vy * dt;\n      p.vy += 200 * dt; // gravity\n      p.life -= dt;\n      p.alpha = p.life / p.maxLife;\n    });\n    \n    // Avatar pulse animation\n    this.avatar.pulse = (this.avatar.pulse + dt * 5) % (Math.PI * 2);\n  }\n\n  updateAvatar(dt) {\n    const accel = 800;\n    const maxSpeed = 8;\n    const friction = 0.9;\n    \n    // Input\n    let ax = 0, ay = 0;\n    if (this.input.keys['ArrowLeft'] || this.input.keys['KeyA']) ax -= 1;\n    if (this.input.keys['ArrowRight'] || this.input.keys['KeyD']) ax += 1;\n    if (this.input.keys['ArrowUp'] || this.input.keys['KeyW']) ay -= 1;\n    if (this.input.keys['ArrowDown'] || this.input.keys['KeyS']) ay += 1;\n    \n    // Touch swipe handled in input manager\n    if (this.input.swipeDir) {\n      ax += this.input.swipeDir.x;\n      ay += this.input.swipeDir.y;\n      this.input.swipeDir = null;\n    }\n    \n    if (ax !== 0 || ay !== 0) {\n      const len = Math.hypot(ax, ay);\n      ax /= len; ay /= len;\n      this.avatar.vx += ax * accel * dt;\n      this.avatar.vy += ay * accel * dt;\n    }\n    \n    // Gravity\n    this.avatar.vy += 9.8 * 60 * dt; // px/s^2\n    \n    // Clamp velocity\n    const speed = Math.hypot(this.avatar.vx, this.avatar.vy);\n    if (speed > maxSpeed) {\n      this.avatar.vx = (this.avatar.vx / speed) * maxSpeed;\n      this.avatar.vy = (this.avatar.vy / speed) * maxSpeed;\n    }\n    \n    // Apply velocity\n    this.avatar.x += this.avatar.vx * dt * 60;\n    this.avatar.y += this.avatar.vy * dt * 60;\n    \n    // Collision with shapes\n    this.avatar.onGround = false;\n    this.shapes.forEach(shape => {\n      if (shape.isStatic) {\n        const collision = this.physics.checkCirclePoly(this.avatar, shape);\n        if (collision) {\n          this.avatar.x += collision.nx * collision.depth;\n          this.avatar.y += collision.ny * collision.depth;\n          \n          // Bounce\n          const dot = this.avatar.vx * collision.nx + this.avatar.vy * collision.ny;\n          if (dot < 0) {\n            this.avatar.vx -= (1 + shape.restitution) * dot * collision.nx;\n            this.avatar.vy -= (1 + shape.restitution) * dot * collision.ny;\n          }\n          \n          // Friction\n          const tangentX = -collision.ny;\n          const tangentY = collision.nx;\n          const tangentVel = this.avatar.vx * tangentX + this.avatar.vy * tangentY;\n          this.avatar.vx -= tangentVel * tangentX * shape.friction;\n          this.avatar.vy -= tangentVel * tangentY * shape.friction;\n          \n          if (collision.ny < -0.5) this.avatar.onGround = true;\n          \n          // Collision particles\n          if (Math.abs(dot) > 2) {\n            this.sounds.collision();\n            this.spawnParticles(this.avatar.x, this.avatar.y, '#fff', 5);\n          }\n        }\n      }\n    });\n    \n    // Ground friction\n    if (this.avatar.onGround) {\n      this.avatar.vx *= 0.9;\n    }\n  }\n\n  checkWin() {\n    if (!this.ball || !this.goalZone) return false;\n    const dx = this.ball.x - (this.goalZone.position[0] + this.goalZone.size[0]/2);\n    const dy = this.ball.y - (this.goalZone.position[1] + this.goalZone.size[1]/2);\n    return Math.hypot(dx, dy) < 20;\n  }\n\n  completeLevel() {\n    this.state = 'gameOver';\n    this.sounds.win();\n    \n    const timeBonus = Math.max(0, (this.timeLimit - this.timer) * 10);\n    const moveBonus = Math.max(0, (this.moveLimit - this.movesUsed) * 50);\n    const baseScore = 1000;\n    const total = baseScore + timeBonus + moveBonus;\n    \n    // Save high score\n    const key = `shapeshift_${this.currentLevel}_score`;\n    const highScore = parseInt(localStorage.getItem(key) || '0');\n    if (total > highScore) {\n      localStorage.setItem(key, total.toString());\n    }\n    \n    // Unlock next level\n    const levelIndex = this.levels.levelOrder.indexOf(this.currentLevel);\n    if (levelIndex >= 0 && levelIndex < this.levels.levelOrder.length - 1) {\n      const nextLevel = this.levels.levelOrder[levelIndex + 1];\n      localStorage.setItem(`shapeshift_${nextLevel}_unlocked`, 'true');\n    }\n    \n    this.ui.showGameOver({\n      baseScore,\n      timeBonus: Math.round(timeBonus),\n      moveBonus,\n      total: Math.round(total),\n      highScore: Math.max(highScore, Math.round(total))\n    });\n  }\n\n  failLevel(reason) {\n    this.state = 'gameOver';\n    this.sounds.fail();\n    this.ui.showGameOver({ failed: true, reason });\n  }\n\n  render() {\n    this.ctx.setTransform(1, 0, 0, 1, 0, 0);\n    this.ctx.clearRect(0, 0, this.canvas.width, this.canvas.height);\n    \n    // Apply game transform\n    this.ctx.save();\n    this.ctx.translate(this.offsetX, this.offsetY);\n    this.ctx.scale(this.scale, this.scale);\n    \n    // Background\n    this.ctx.fillStyle = '#0f0f1a';\n    this.ctx.fillRect(0, 0, 1920, 1080);\n    \n    // Draw grid\n    this.ctx.strokeStyle = 'rgba(255,255,255,0.02)';\n    this.ctx.lineWidth = 1;\n    for (let x=0; x<1920; x+=50) {\n      this.ctx.beginPath();\n      this.ctx.moveTo(x, 0);\n      this.ctx.lineTo(x, 1080);\n      this.ctx.stroke();\n    }\n    for (let y=0; y<1080; y+=50) {\n      this.ctx.beginPath();\n      this.ctx.moveTo(0, y);\n      this.ctx.lineTo(1920, y);\n      this.ctx.stroke();\n    }\n    \n    // Draw shapes\n    this.shapes.forEach(shape => {\n      this.ctx.beginPath();\n      this.ctx.moveTo(shape.vertices[0][0], shape.vertices[0][1]);\n      for (let i=1; i<shape.vertices.length; i++) {\n        this.ctx.lineTo(shape.vertices[i][0], shape.vertices[i][1]);\n      }\n      this.ctx.closePath();\n      \n      // Fill\n      this.ctx.fillStyle = shape.color;\n      this.ctx.globalAlpha = shape.isStatic ? 0.8 : 0.6;\n      this.ctx.fill();\n      \n      // Stroke\n      this.ctx.strokeStyle = '#222';\n      this.ctx.lineWidth = 2;\n      this.ctx.globalAlpha = 1;\n      this.ctx.stroke();\n      \n      // Pattern for color-blind\n      if (shape.isStatic) {\n        this.ctx.save();\n        this.ctx.clip();\n        this.ctx.strokeStyle = 'rgba(255,255,255,0.1)';\n        this.ctx.lineWidth = 1;\n        for (let x=-1920; x<1920*2; x+=20) {\n          this.ctx.beginPath();\n          this.ctx.moveTo(x, -1080);\n          this.ctx.lineTo(x+1080, 1080);\n          this.ctx.stroke();\n        }\n        this.ctx.restore();\n      }\n    });\n    \n    // Draw goal zone\n    if (this.goalZone) {\n      const [x, y] = this.goalZone.position;\n      const [w, h] = this.goalZone.size;\n      this.ctx.strokeStyle = '#2ecc71';\n      this.ctx.lineWidth = 4;\n      this.ctx.setLineDash([20, 10]);\n      this.ctx.strokeRect(x, y, w, h);\n      this.ctx.setLineDash([]);\n      this.ctx.fillStyle = 'rgba(46, 204, 113, 0.1)';\n      this.ctx.fillRect(x, y, w, h);\n      this.ctx.font = '24px Arial';\n      this.ctx.fillStyle = '#2ecc71';\n      this.ctx.textAlign = 'center';\n      this.ctx.fillText('GOAL', x + w/2, y + h/2 + 8);\n    }\n    \n    // Draw current drawing shape\n    if (thisrawing) {\n      this.ctx.beginPath();\n      this.ctx.moveTo(this.shapeVertices[0][0], this.shapeVertices[0][1]);\n      for (let i=1; i<this.shapeVertices.length; i++) {\n        this.ctx.lineTo(this.shapeVertices[i][0], this.shapeVertices[i][1]);\n      }\n      this.ctx.closePath();\n      this.ctx.fillStyle = 'rgba(52, 152, 219, 0.3)';\n      this.ctx.fill();\n      this.ctx.strokeStyle = '#3498db';\n      this.ctx.lineWidth = 2;\n      this.ctx.setLineDash([10, 5]);\n      this.ctx.stroke();\n      this.ctx.setLineDash([]);\n      \n      // Draw vertices\n      this.ctx.fillStyle = '#3498db';\n      this.shapeVertices.forEach(v => {\n        this.ctx.beginPath();\n        this.ctx.arc(v[0], v[1], 6, 0, Math.PI * 2);\n        this.ctx.fill();\n      });\n    }\n    \n    // Draw avatar\n    if (this.avatar) {\n      const pulseScale = 1 + Math.sin(this.avatar.pulse) * 0.1;\n      this.ctx.beginPath();\n      this.ctx.arc(this.avatar.x, this.avatar.y, this.avatar.radius * pulseScale, 0, Math.PI * 2);\n      this.ctx.fillStyle = this.avatar.color;\n      this.ctx.fill();\n      this.ctx.strokeStyle = this.avatar.outline;\n      this.ctx.lineWidth = 3;\n      this.ctx.stroke();\n      \n      // Eyes\n      this.ctx.fillStyle = '#1a1a2e';\n      const eyeOffset = 4;\n      this.ctx.beginPath();\n      this.ctx.arc(this.avatar.x - eyeOffset, this.avatar.y - 2, 3, 0, Math.PI * 2);\n      this.ctx.fill();\n      this.ctx.beginPath();\n      this.ctx.arc(this.avatar.x + eyeOffset, this.avatar.y - 2, 3, 0, Math.PI * 2);\n      this.ctx.fill();\n    }\n    \n    // Draw particles\n    this.particles.forEach(p => {\n      this.ctx.globalAlpha = p.alpha;\n      this.ctx.fillStyle = p.color;\n      this.ctx.beginPath();\n      this.ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);\n      this.ctx.fill();\n    });\n    this.ctx.globalAlpha = 1;\n    \n    this.ctx.restore();\n  }\n\n  spawnParticles(x, y, color, count) {\n    for (let i=0; i<count; i++) {\n      const angle = Math.random() * Math.PI * 2;\n      const speed = 50 + Math.random() * 150;\n      this.particles.push({\n        x, y,\n        vx: Math.cos(angle) * speed,\n        vy: Math.sin(angle) * speed,\n        size: 2 + Math.random() * 4,\n        color,\n        life: 0.5 + Math.random() * 0.5,\n        maxLife: 1,\n        alpha: 1\n      });\n    }\n  }\n\n  placeShape() {\n    if (this.shapeVertices.length < 3) return;\n    \n    // Check if shape is valid (not self-intersecting, reasonable area)\n    const area = this.polygonArea(this.shapeVertices);\n    if (area < 50) return;\n    \n    // Check move limit\n    if (this.movesUsed >= this.moveLimit) {\n      this.ui.showMessage('Move limit reached!');\n      return;\n    }\n    \n    // Create physics body\n    const body = this.physics.createBody({\n      vertices: this.shapeVertices.map(v => [...v]),\n      mass: Math.max(1, area / 100),\n      restitution: 0.2,\n      friction: 0.5,\n      color: '#3498db',\n      isStatic: false\n    });\n    \n    this.shapes.push(body);\n    this.movesUsed++;\n    this.ui.updateMoveCounter(this.movesUsed, this.moveLimit);\n    this.sounds.place();\n    this.spawnParticles(this.shapeVertices[0][0], this.shapeVertices[0][1], '#3498db', 10);\n    \n    this.drawing = false;\n    this.shapeVertices = [];\n    this.drawMode = false;\n    this.ui.setDrawMode(false);\n  }\n\n  undoLastShape() {\n    // Find last placed dynamic shape\n    for (let i = this.shapes.length - 1; i >= 0; i--) {\n      if (!this.shapes[i].isStatic && this.shapes[i].color === '#3498db') {\n        this.physics.removeBody(this.shapes[i]);\n        this.shapes.splice(i, 1);\n        if (this.movesUsed > 0) this.movesUsed--;\n        this.ui.updateMoveCounter(this.movesUsed, this.moveLimit);\n        this.sounds.undo();\n        break;\n      }\n    }\n  }\n\n  useHint() {\n    if (this.hintsUsed >= this.maxHints) return;\n    \n    const hint = this.levelData.hints[this.hintsUsed];\n    if (hint) {\n      this.ui.showMessage(hint, 4000);\n      this.hintsUsed++;\n      this.ui.updateHintButton(this.maxHints - this.hintsUsed);\n      this.sounds.click();\n    }\n  }\n\n  togglePause() {\n    if (this.state === 'playing') {\n      this.state = 'paused';\n      this.ui.showMessage('PAUSED', 0);\n    } else if (this.state === 'paused') {\n      this.state = 'playing';\n      this.ui.hideMessage();\n    }\n  }\n}\n\n// Start game when DOM ready\ndocument.addEventListener('DOMContentLoaded', () => {\n  window.game = new Game();\n});\n",
  "src/physics.js": "// Physics Engine - SAT-based collision detection\n\nexport class PhysicsEngine {\n  constructor() {\n    this.bodies = [];\n    this.gravity = { x: 0, y: 9.8 * 60 }; // px/s^2\n    this.iterations = 8;\n  }\n\n  createBody(options) {\n    const body = {\n      vertices: options.vertices,\n      mass: options.mass,\n      invMass: options.mass > 0 ? 1 / options.mass : 0,\n      restitution: options.restitution || 0.2,\n      friction: options.friction || 0.5,\n      color: options.color || '#fff',\n      isStatic: options.isStatic || false,\n      isCircle: options.isCircle || false,\n      radius: options.radius || 0,\n      x: 0,\n      y: 0,\n      vx: 0,\n      vy: 0,\n      angle: 0,\n      angularVel: 0,\n      inertia: 0,\n      invInertia: 0\n    };\n    \n    // Calculate center of mass\n    this.updateBodyGeometry(body);\n    this.bodies.push(body);\n    return body;\n  }\n\n  updateBodyGeometry(body) {\n    if (body.isCircle) {\n      body.x = body.vertices[0][0];\n      body.y = body.vertices[0][1];\n      body.inertia = 0.5 * body.mass * body.radius * body.radius;\n    } else {\n      // Polygon centroid\n      let cx = 0, cy = 0, area = 0;\n      const verts = body.vertices;\n      for (let i = 0; i < verts.length; i++) {\n        const j = (i + 1) % verts.length;\n        const cross = verts[i][0] * verts[j][1] - verts[j][0] * verts[i][1];\n        area += cross;\n        cx += (verts[i][0] + verts[j][0]) * cross;\n        cy += (verts[i][1] + verts[j][1]) * cross;\n      }\n      area *= 0.5;\n      if (Math.abs(area) > 0.001) {\n        cx /= (6 * area);\n        cy /= (6 * area);\n      } else {\n        cx = verts[0][0];\n        cy = verts[0][1];\n      }\n      body.x = cx;\n      body.y = cy;\n      \n      // Moment of inertia\n      let I = 0;\n      for (let i = 0; i < verts.length; i++) {\n        const j = (i + 1) % verts.length;\n        const x1 = verts[i][0] - cx, y1 = verts[i][1] - cy;\n        const x2 = verts[j][0] - cx, y2 = verts[j][1] - cy;\n        const cross = x1 * y2 - x2 * y1;\n        I += (x1*x1 + y1*y1 + x1*x2 + y1*y2 + x2*x2 + y2*y2) * cross;\n      }\n      body.inertia = Math.abs(I / 6) * (body.mass / Math.abs(area));\n    }\n    body.invInertia = body.inertia > 0 ? 1 / body.inertia : 0;\n  }\n\n  removeBody(body) {\n    const idx = this.bodies.indexOf(body);\n    if (idx !== -1) this.bodies.splice(idx, 1);\n  }\n\n  reset() {\n    this.bodies = [];\n  }\n\n  step(dt) {\n    // Apply gravity\n    this.bodies.forEach(body => {\n      if (!body.isStatic && body.invMass > 0) {\n        body.vx += this.gravity.x * dt;\n        body.vy += this.gravity.y * dt;\n      }\n    });\n    \n    // Broad phase - simple O(n^2) for small number of bodies\n    const contacts = [];\n    for (let i = 0; i < this.bodies.length; i++) {\n      for (let j = i + 1; j < this.bodies.length; j++) {\n        const a = this.bodies[i];\n        const b = this.bodies[j];\n        if (a.isStatic && b.isStatic) continue;\n        \n        let contact = null;\n        if (a.isCircle && b.isCircle) {\n          contact = this.circleCircle(a, b);\n        } else if (a.isCircle) {\n          contact = this.circlePoly(b, a);\n          if (contact) { contact.nx = -contact.nx; contact.ny = -contact.ny; }\n        } else if (b.isCircle) {\n          contact = this.circlePoly(a, b);\n        } else {\n          contact = this.polyPoly(a, b);\n        }\n        \n        if (contact) contacts.push({ a, b, ...contact });\n      }\n    }\n    \n    // Resolve contacts\n    for (let iter = 0; iter < this.iterations; iter++) {\n      contacts.forEach(c => this.resolveContact(c));\n    }\n    \n    // Integrate velocities\n    this.bodies.forEach(body => {\n      if (!body.isStatic && body.invMass > 0) {\n        body.x += body.vx * dt;\n        body.y += body.vy * dt;\n        body.angle += body.angularVel * dt;\n        \n        // Update vertices positions\n        if (!body.isCircle) {\n          const cos = Math.cos(body.angle);\n          const sin = Math.sin(body.angle);\n          body.vertices = body.vertices.map(v => {\n            const dx = v[0] - body.x;\n            const dy = v[1] - body.y;\n            return [\n              body.x + dx * cos - dy * sin,\n              body.y + dx * sin + dy * cos\n            ];\n          });\n        }\n      }\n    });\n  }\n\n  circleCircle(a, b) {\n    const dx = b.x - a.x;\n    const dy = b.y - a.y;\n    const dist = Math.hypot(dx, dy);\n    const minDist = a.radius + b.radius;\n    \n    if (dist < minDist && dist > 0.001) {\n      return {\n        nx: dx / dist,\n        ny: dy / dist,\n        depth: minDist - dist\n      };\n    }\n    return null;\n  }\n\n  circlePoly(circle, poly) {\n    let minDist = Infinity;\n    let closest = null;\n    \n    // Check distance to each edge\n    for (let i = 0; i < poly.vertices.length; i++) {\n      const j = (i + 1) % poly.vertices.length;\n      const edge = [poly.vertices[j][0] - poly.vertices[i][0], poly.vertices[j][1] - poly.vertices[i][1]];\n      const len2 = edge[0]*edge[0] + edge[1]*edge[1];\n      \n      let t = ((circle.x - poly.vertices[i][0]) * edge[0] + (circle.y - poly.vertices[i][1]) * edge[1]) / len2;\n      t = Math.max(0, Math.min(1, t));\n      \n      const closestX = poly.vertices[i][0] + edge[0] * t;\n      const closestY = poly.vertices[i][1] + edge[1] * t;\n      \n      const dx = circle.x - closestX;\n      const dy = circle.y - closestY;\n      const dist = Math.hypot(dx, dy);\n      \n      if (dist < minDist) {\n        minDist = dist;\n        closest = { nx: dx / (dist || 1), ny: dy / (dist || 1), depth: circle.radius - dist, point: [closestX, closestY] };\n      }\n    }\n    \n    if (closest && closest.depth > 0) return closest;\n    return null;\n  }\n\n  checkCirclePoly(circle, poly) {\n    // Same as circlePoly but for avatar collision\n    let minDist = Infinity;\n    let closest = null;\n    \n    for (let i = 0; i < poly.vertices.length; i++) {\n      const j = (i + 1) % poly.vertices.length;\n      const edge = [poly.vertices[j][0] - poly.vertices[i][0], poly.vertices[j][1] - poly.vertices[i][1]];\n      const len2 = edge[0]*edge[0] + edge[1]*edge[1];\n      \n      let t = ((circle.x - poly.vertices[i][0]) * edge[0] + (circle.y - poly.vertices[i][1]) * edge[1]) / len2;\n      t = Math.max(0, Math.min(1, t));\n      \n      const closestX = poly.vertices[i][0] + edge[0] * t;\n      const closestY = poly.vertices[i][1] + edge[1] * t;\n      \n      const dx = circle.x - closestX;\n      const dy = circle.y - closestY;\n      const dist = Math.hypot(dx, dy);\n      \n      if (dist < minDist) {\n        minDist = dist;\n        closest = { nx: dx / (dist || 1), ny: dy / (dist || 1), depth: circle.radius - dist };\n      }\n    }\n    \n    if (closest && closest.depth > 0) return closest;\n    return null;\n  }\n\n  polyPoly(a, b) {\n    // SAT collision detection\n    let minOverlap = Infinity;\n    let axis = null;\n    \n    const checkAxes = (vertsA, vertsB) => {\n      for (let i = 0; i < vertsA.length; i++) {\n        const j = (i + 1) % vertsA.length;\n        const edge = [vertsA[j][0] - vertsA[i][0], vertsA[j][1] - vertsA[i][1]];\n        const len = Math.hypot(edge[0], edge[1]);\n        if (len < 0.001) continue;\n        const nx = -edge[1] / len;\n        const ny = edge[0] / len;\n        \n        let minA = Infinity, maxA = -Infinity;\n        let minB = Infinity, maxB = -Infinity;\n        \n        vertsA.forEach(v => {\n          const proj = v[0] * nx + v[1] * ny;\n          minA = Math.min(minA, proj);\n          maxA = Math.max(maxA, proj);\n        });\n        vertsB.forEach(v => {\n          const proj = v[0] * nx + v[1] * ny;\n          minB = Math.min(minB, proj);\n          maxB = Math.max(maxB, proj);\n        });\n        \n        if (maxA < minB || maxB < minA) return { separated: true };\n        \n        const overlap = Math.min(maxA, maxB) - Math.max(minA, minB);\n        if (overlap < minOverlap) {\n          minOverlap = overlap;\n          axis = { nx, ny };\n        }\n      }\n      return { separated: false };\n    };\n    \n    const res1 = checkAxes(a.vertices, b.vertices);\n    if (res1.separated) return null;\n    const res2 = checkAxes(b.vertices, a.vertices);\n    if (res2.separated) return null;\n    \n    // Ensure normal points from a to b\n    const centerA = { x: a.x, y: a.y };\n    const centerB = { x: b.x, y: b.y };\n    const dx = centerB.x - centerA.x;\n    const dy = centerB.y - centerA.y;\n    if (dx * axis.nx + dy * axis.ny < 0) {\n      axis.nx = -axis.nx;\n      axis.ny = -axis.ny;\n    }\n    \n    return { nx: axis.nx, ny: axis.ny, depth: minOverlap };\n  }\n\n  resolveContact(contact) {\n    const { a, b, nx, ny, depth } = contact;\n    \n    // Positional correction\n    const totalInvMass = a.invMass + b.invMass;\n    if (totalInvMass > 0) {\n      const correction = depth / totalInvMass * 0.8;\n      a.x -= nx * correction * a.invMass;\n      a.y -= ny * correction * a.invMass;\n      b.x += nx * correction * b.invMass;\n      b.y += ny * correction * b.invMass;\n    }\n    \n    // Velocity resolution\n    const rvx = b.vx - a.vx;\n    const rvy = b.vy - a.vy;\n    const velAlongNormal = rvx * nx + rvy * ny;\n    \n    if (velAlongNormal > 0) return;\n    \n    const e = Math.min(a.restitution, b.restitution);\n    const j = -(1 + e) * velAlongNormal / (a.invMass + b.invMass);\n    \n    a.vx -= j * nx * a.invMass;\n    a.vy -= j * ny * a.invMass;\n    b.vx += j * nx * b.invMass;\n    b.vy += j * ny * b.invMass;\n    \n    // Friction\n    const tangentX = rvx - velAlongNormal * nx;\n    const tangentY = rvy - velAlongNormal * ny;\n    const tangentSpeed = Math.hypot(tangentX, tangentY);\n    \n    if (tangentSpeed > 0.001) {\n      const friction = Math.sqrt(a.friction * b.friction);\n      const jt = -tangentSpeed * friction / (a.invMass + b.invMass);\n      const tx = tangentX / tangentSpeed;\n      const ty = tangentY / tangentSpeed;\n      \n      a.vx += jt * tx * a.invMass;\n      a.vy += jt * ty * a.invMass;\n      b.vx -= jt * tx * b.invMass;\n      b.vy -= jt * ty * b.invMass;\n    }\n  }\n}\n",
  "src/input.js": "// Input Manager - Handles keyboard, mouse, and touch\n\nexport class InputManager {\n  constructor(canvas) {\n    this.canvas = canvas;\n    this.keys = {};\n    this.mouse = { x: 0, y: 0, down: false, startX: 0, startY: 0 };\n    this.touch = { x: 0, y: 0, startX: 0, startY: 0, active: false };\n    this.swipeDir = null;\n    this.swipeThreshold = 30;\n    \n    this.bindEvents();\n  }\n\n  bindEvents() {\n    // Keyboard\n    window.addEventListener('keydown', (e) => {\n      this.keys[e.code] = true;\n      \n      // Global shortcuts\n      if (e.code === 'KeyE') {\n        e.preventDefault();\n        if (window.game) window.game.drawMode = !window.game.drawMode;\n        if (window.game) window.game.ui.setDrawMode(window.game.drawMode);\n      }\n      if (e.code === 'KeyZ' && (e.ctrlKey || e.metaKey)) {\n        e.preventDefault();\n        if (window.game) window.game.undoLastShape();\n      }\n      if (e.code === 'KeyH') {\n        e.preventDefault();\n        if (window.game) window.game.useHint();\n      }\n      if (e.code === 'Escape') {\n        if (window.game) window.game.togglePause();\n      }\n      if (e.code === 'KeyR') {\n        if (window.game && window.game.state === 'playing') window.game.startLevel(window.game.currentLevel);\n      }\n    });\n    \n    window.addEventListener('keyup', (e) => {\n      this.keys[e.code] = false;\n    });\n    \n    // Mouse\n    this.canvas.addEventListener('mousedown', (e) => this.onPointerDown(e.clientX, e.clientY));\n    window.addEventListener('mousemove', (e) => this.onPointerMove(e.clientX, e.clientY));\n    window.addEventListener('mouseup', (e) => this.onPointerUp(e.clientX, e.clientY));\n    \n    // Touch\n    this.canvas.addEventListener('touchstart', (e) => {\n      e.preventDefault();\n      if (e.touches.length > 0) {\n        this.onPointerDown(e.touches[0].clientX, e.touches[0].clientY);\n      }\n    }, { passive: false });\n    \n    this.canvas.addEventListener('touchmove', (e) => {\n      e.preventDefault();\n      if (e.touches.length > 0) {\n        this.onPointerMove(e.touches[0].clientX, e.touches[0].clientY);\n      }\n    }, { passive: false });\n    \n    this.canvas.addEventListener('touchend', (e) => {\n      e.preventDefault();\n      this.onPointerUp(this.touch.x, this.touch.y);\n    }, { passive: false });\n    \n    // Context menu\n    this.canvas.addEventListener('contextmenu', (e) => e.preventDefault());\n  }\n\n  getCanvasPoint(clientX, clientY) {\n    const rect = this.canvas.getBoundingClientRect();\n    const scaleX = this.canvas.width / rect.width;\n    const scaleY = this.canvas.height / rect.height;\n    return {\n      x: (clientX - rect.left) * scaleX,\n      y: (clientY - rect.top) * scaleY\n    };\n  }\n\n  onPointerDown(clientX, clientY) {\n    const point = this.getCanvasPoint(clientX, clientY);\n    \n    // Convert to game coordinates\n    if (window.game) {\n      const gx = (point.x - window.game.offsetX) / window.game.scale;\n      const gy = (point.y - window.game.offsetY) / window.game.scale;\n      \n      this.mouse.down = true;\n      this.mouse.startX = gx;\n      this.mouse.startY = gy;\n      this.mouse.x = gx;\n      this.mouse.y = gy;\n      \n      this.touch.active = true;\n      this.touch.startX = gx;\n      this.touch.startY = gy;\n      this.touch.x = gx;\n      this.touch.y = gy;\n      \n      if (window.game.drawMode && window.game.state === 'playing') {\n        window.game.drawing = true;\n        window.game.shapeVertices = [[gx, gy]];\n        window.game.sounds.draw();\n      }\n    }\n  }\n\n  onPointerMove(clientX, clientY) {\n    const point = this.getCanvasPoint(clientX, clientY);\n    \n    if (window.game) {\n      const gx = (point.x - window.game.offsetX) / window.game.scale;\n      const gy = (point.y - window.game.offsetY) / window.game.scale;\n      \n      this.mouse.x = gx;\n      this.mouse.y = gy;\n      this.touch.x = gx;\n      this.touch.y = gy;\n      \n      if (window.game.drawing && window.game.drawMode) {\n        // Add vertex if far enough from last\n        const last = window.game.shapeVertices[window.game.shapeVertices.length - 1];\n        const dist = Math.hypot(gx - last[0], gy - last[1]);\n        if (dist > 15) {\n          window.game.shapeVertices.push([gx, gy]);\n        }\n      }\n    }\n  }\n\n  onPointerUp(clientX, clientY) {\n    if (this.mouse.down) {\n      const dx = this.mouse.x - this.mouse.startX;\n      const dy = this.mouse.y - this.mouse.startY;\n      const dist = Math.hypot(dx, dy);\n      \n      // Detect swipe for avatar control\n      if (dist > this.swipeThreshold && !window.game?.drawMode) {\n        this.swipeDir = { x: dx / dist, y: dy / dist };\n      }\n    }\n    \n    if (window.game && window.game.drawing) {\n      // Close shape if near start\n      const first = window.game.shapeVertices[0];\n      const last = window.game.shapeVertices[window.game.shapeVertices.length - 1];\n      const dist = Math.hypot(last[0] - first[0], last[1] - first[1]);\n      \n      if (dist < 30 && window.game.shapeVertices.length >= 3) {\n        window.game.shapeVertices.push([...first]);\n        window.game.placeShape();\n      } else if (window.game.shapeVertices.length >= 3) {\n        // Auto-close\n        window.game.shapeVertices.push([...first]);\n        window.game.placeShape();\n      } else {\n        window.game.drawing = false;\n        window.game.shapeVertices = [];\n      }\n    }\n    \n    this.mouse.down = false;\n    this.touch.active = false;\n  }\n}\n",
  "src/levels.js": "// Level Manager - Defines all puzzle levels\n\nexport class LevelManager {\n  constructor() {\n    this.levelOrder = [];\n    this.levels = {};\n    this.initLevels();\n  }\n\n  initLevels() {\n    // Level 1: Tutorial - Simple ramp\n    this.addLevel('L01', {\n      name: 'First Steps',\n      width: 1920,\n      height: 1080,\n      moveLimit: 3,\n      timeLimit: 60,\n      objects: [\n        { type: 'static', shape: 'rect', position: [0, 900], size: [1920, 180], color: '#2c3e50' },\n        { type: 'static', shape: 'rect', position: [300, 600], size: [400, 20], color: '#34495e' },\n        { type: 'ball', position: [500, 500], radius: 20, target: [1600, 880] },\n        { type: 'zone', position: [1550, 800], size: [100, 100] }\n      ],\n      hints: [\n        'Draw a ramp to guide the ball to the goal!',\n        'Click and drag to draw, release to place.',\n        'You have 3 moves - make them count!'\n      ]\n    });\n\n    // Level 2: Bridge building\n    this.addLevel('L02', {\n      name: 'Bridge Builder',\n      width: 1920,\n      height: 1080,\n      moveLimit: 4,\n      timeLimit: 60,\n      objects: [\n        { type: 'static', shape: 'rect', position: [0, 900], size: [1920, 180], color: '#2c3e50' },\n        { type: 'static', shape: 'rect', position: [0, 600], size: [600, 20], color: '#34495e' },\n        { type: 'static', shape: 'rect', position: [1320, 600], size: [600, 20], color: '#34495e' },\n        { type: 'ball', position: [300, 500], radius: 20, target: [1600, 580] },\n        { type: 'zone', position: [1550, 500], size: [100, 100] }\n      ],\n      hints: [\n        'Build a bridge across the gap!',\n        'Triangles are stronger than flat shapes.',\n        'The ball needs a smooth path.'\n      ]\n    });\n\n    // Level 3: Seesaw\n    this.addLevel('L03', {\n      name: 'Balance Act',\n      width: 1920,\n      height: 1080,\n      moveLimit: 3,\n      timeLimit: 60,\n      objects: [\n        { type: 'static', shape: 'rect', position: [0, 900], size: [1920, 180], color: '#2c3e50' },\n        { type: 'static', shape: 'polygon', vertices: [960, 700, 910, 750, 1010, 750], color: '#34495e' }, // fulcrum\n        { type: 'dynamic', vertices: [810, 680, 1110, 680, 1110, 700, 810, 700], color: '#e74c3c' }, // plank\n        { type: 'ball', position: [300, 500], radius: 20, target: [1600, 680] },\n        { type: 'zone', position: [1550, 600], size: [100, 100] }\n      ],\n      hints: [\n        'Drop a weight on the left side to launch the ball!',\n        'Heavier shapes create more force.',\n        'Time your drop carefully.'\n      ]\n    });\n\n    // Level 4: Pinball\n    this.addLevel('L04', {\n      name: 'Pinball Wizard',\n      width: 1920,\n      height: 1080,\n      moveLimit: 5,\n      timeLimit: 90,\n      objects: [\n        { type: 'static', shape: 'rect', position: [0, 900], size: [1920, 180], color: '#2c3e50' },\n        { type: 'static