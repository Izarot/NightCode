}

function draw(){
    ctx.fillStyle=COLORS.bg;
    ctx.fillRect(0,0,width,height);
    
    // vignette
    ctx.save();
    ctx.fillStyle=COLORS.vignette;
    ctx.fillRect(0,0,width,height);
    ctx.restore();
    
    wind.draw();
    player.draw();
    for(const b of bullets) b.draw();
    for(const t of targets) t.draw();
    
    // HUD
    ctx.fillStyle=COLORS.hud;
    ctx.font='20px sans-serif';
    ctx.textAlign='left';
    ctx.fillText(`Score: ${score}`,10,30);
    ctx.fillText(`Health: ${player.health}`,10,50);
    ctx.fillText(`Ammo: ${player.ammo}/${player.maxAmmo}`,10,70);
    ctx.fillText(`Wind: ${wind.getWind().x.toFixed(1)}, ${wind.getWind().y.toFixed(1)}`,10,90);
    
    // wind compass
    const compassSize=60;
    const compassX=width-compassSize-10;
    const compassY=height-compassSize-10;
    ctx.save();
    ctx.translate(compassX+compassSize/2,compassY+compassSize/2);
    ctx.beginPath();
    ctx.arc(0,0,compassSize/2,0,Math.PI*2);
    ctx.strokeStyle=COLORS.hud;
    ctx.lineWidth=2;
    ctx.stroke();
    // wind direction
    const windDir=wind.getWind();
    const windLen=Math.min(windDir.mag()*10,compassSize/2-5);
    ctx.beginPath();
    ctx.moveTo(0,0);
    ctx.lineTo(windDir.x*windLen/(windDir.mag()||0), windDir.y*windLen/(windDir.mag()||0));
    ctx.strokeStyle=windDir.mag()<1?COLORS.windCompassCalm:windDir.mag()<2?COLORS.windCompassMod:COLORS.windCompassGale;
    ctx.lineWidth=3;
    ctx.stroke();
    ctx.restore();
    
    if(gameOver){
        ctx.fillStyle='rgba(0,0,0,0.75)';
        ctx.fillRect(0,0,width,height);
        ctx.fillStyle=COLORS.hud;
        ctx.font='40px sans-serif';
        ctx.textAlign='center';
        ctx.fillText('Game Over',width/2,height/2-40);
        ctx.font='20px sans-serif';
        ctx.fillText(`Survived: ${survived.toFixed(1)}s`,width/2,height/2);
        ctx.fillText(`Score: ${score}`,width/2,height/2+30);
        ctx.fillText(`High Score: ${highScore.toFixed(1)}s`,width/2,height/2+60);
        ctx.fillText('Press R to Restart',width/2,height/2+100);
    }
}

function loop(timestamp){
    const dt=timestamp-(lastRender||timestamp);
    lastRender=timestamp;
    update(dt);
    draw();
    if(!gameOver)requestAnimationFrame(loop);
    else{
        // listen for restart
    }
}

window.addEventListener('keydown',e=>{
    if(e.key.toLowerCase()==='r'&&gameOver){
        // reset game
        player=new Player();
        wind=new WindSystem();
        bullets=[];
        targets=[];
        score=0;
        gameOver=false;
        startTime=performance.now();
        requestAnimationFrame(loop);
    }
});

requestAnimationFrame(loop);
"}
