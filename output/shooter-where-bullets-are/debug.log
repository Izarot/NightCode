  "game.js": "const canvas=document.getElementById('gameCanvas');\nconst ctx=canvas.getContext('2d');\nlet width=window.innerWidth;\nlet height=window.innerHeight;\ncanvas.width=width;\ncanvas.height=height;\nwindow.addEventListener('resize',()=>{\n    width=window.innerWidth;\n    height=window.innerHeight;\n    canvas.width=width;\n    canvas.height=height;\n});\n\nconst COLORS={\n    bg:'#0a0a2a',\n    player:'#00ffff',\n    windParticle:'#00ff00',\n    bullet:'#ffff00',\n    target:'#ff0000',\n    windCompassCalm:'#00ff00',\n    windCompassMod:'#ffff00',\n    windCompassGale:'#ff0000',\n    hud:'#ffffff',\n    hudAmmoLow:'#ff0000',\n    vignette:'rgba(0,0,0,0.7)'\n};\n\nclass Vector{\n    constructor(x=0,y=0){\n        this.x=x;\n        this.y=y;\n    }\n    add(v){return new Vector(this.x+v.x,this.y+v.y);}\n    sub(v){return new Vector(this.x-v.x,this.y-v.y);}\n    mult(s){return new Vector(this.x*s,this.y*s);}\n    mag(){return Math.sqrt(this.x*this.x+this.y*this.y);}\n    normalize(){const m=this.mag();return m?new Vector(this.x/m,this.y/m):new Vector(0,0);}\n    static lerp(a,b,t){return new Vector(a.x+(b.x-a.x)*t,a.y+(b.y-a.y)*t);}\n}\n\nclass Player{\n    constructor(){\n        this.pos=new Vector(width/2,height/2);\n        this.vel=new Vector(0,0);\n        this.acc=new Vector(0,0);\n        this.size=20;\n        this.maxSpeed=8;\n        this.accRate=0.5;\n        this.friction=0.85;\n        this.health=100;\n        this.ammo=10;\n        this.maxAmmo=10;\n        this.reloadRate=1;\n        this.reloadTimer=0;\n        this.scarf=[];\n        this.scarfLength=10;\n        for(let i=0;i<this.scarfLength;i++)this.scarf.push(new Vector(this.pos.x,this.pos.y));\n    }\n    update(keys,wind,dt){\n        this.acc=new Vector(0,0);\n        if(keys['w']||keys['ArrowUp'])this.acc.y-=this.accRate;\n        if(keys['s']||keys['ArrowDown'])this.acc.y+=this.accRate;\n        if(keys['a']||keys['ArrowLeft'])this.acc.x-=this.accRate;\n        if(keys['d']||keys['ArrowRight'])this.acc.x+=this.accRate;\n        \n        this.vel=this.vel.add(this.acc.mult(dt)); \n        if(!(keys['w']||keys['s']||keys['a']||keys['d']||keys['ArrowUp']||keys['ArrowDown']||keys['ArrowLeft']||keys['ArrowRight'])){\n            this.vel=this.vel.mult(this.friction);\n        }\n        const speed=this.vel.mag();\n        if(speed>this.maxSpeed){\n            this.vel=this.vel.normalize().mult(this.maxSpeed);\n        }\n        \n        this.pos=this.pos.add(this.vel.mult(dt));\n        \n        if(this.pos.x<0){this.pos.x=0;this.vel.x=0;}\n        if(this.pos.x>width){this.pos.x=width;this.vel.x=0;}\n        if(this.pos.y<0){this.pos.y=0;this.vel.y=0;}\n        if(this.pos.y>height){this.pos.y=height;this.vel.y=0;}\n        \n        this.scarf.pop();\n        this.scarf.unshift(new Vector(this.pos.x,this.pos.y));\n        \n        this.reloadTimer+=dt;\n        if(this.reloadTimer>1000/this.reloadRate&&this.ammo<this.maxAmmo){\n            this.ammo++;\n            this.reloadTimer=0;\n        }\n    }\n    draw(){\n        ctx.save();\n        ctx.translate(this.pos.x,this.pos.y);\n        ctx.beginPath();\n        ctx.moveTo(0,-this.size);\n        ctx.lineTo(this.size*0.6,0);\n        ctx.lineTo(0,this.size*0.6);\n        ctx.lineTo(-this.size*0.6,0);\n        ctx.closePath();\n        ctx.fillStyle=COLORS.player;\n        ctx.fill();\n        ctx.restore();\n        \n        ctx.save();\n        ctx.beginPath();\n        ctx.moveTo(this.scarf[0].x,this.scarf[0].y);\n        for(let i=1;i<this.scarf.length;i++){\n            const p=this.scarf[i];\n            ctx.lineTo(p.x,p.y);\n        }\n        ctx.strokeStyle=COLORS.windParticle;\n        ctx.lineWidth=2;\n        ctx.stroke();\n        ctx.restore();\n    }\n}\n\nclass WindSystem{\n    constructor(){\n        this.wind=new Vector(0,0);\n        this.targetWind=new Vector(0,0);\n        this.timeUntilChange=5000+Math.random()*5000;\n        this.lerpTime=1000;\n        this.lerpStart=0;\n        this.isLerping=false;\n        this.particles=[];\n        this.particleCount=30;\n        for(let i=0;i<this.particleCount;i++){\n            this.particles.push(new Particle(Math.random()*width,Math.random()*height));\n        }\n    }\n    update(dt){\n        this.timeUntilChange-=dt;\n        if(this.timeUntilChange<=0){\n            this.isLerping=true;\n            this.lerpStart=performance.now();\n            this.targetWind=new Vector((Math.random()-0.5)*4,(Math.random()-0.5)*4);\n            this.timeUntilChange=5000+Math.random()*5000;\n        }\n        if(this.isLerping){\n            const elapsed=performance.now()-this.lerpStart;\n            const t=Math.min(elapsed/this.lerpTime,1);\n            this.wind=Vector.lerp(this.wind,this.targetWind,t);\n            if(t>=1)this.isLerping=false;\n        }\n        \n        for(const p of this.particles){\n            p.update(this.wind,dt);\n            if(p.x<0||p.x>width||p.y<0||p.y>height){\n                p.x=Math.random()*width;\n                p.y=Math.random()*height;\n            }\n        }\n    }\n    draw(){\n        for(const p of this.particles){\n            p.draw();\n        }}\n    getWind(){return this.wind;}\n}\n\nclass Particle{\n    constructor(x,y){\n        this.x=x;\n        this.y=y;\n        this.size=2+Math.random()*3;\n        this.life=1;\n        this.maxLife=1;\n        this.color=COLORS.windParticle;\n    }\n    update(wind,dt){\n        this.x+=wind.x*0.5*dt;\n        this.y+=wind.y*0.5*dt;\n    }\n    draw(){\n        ctx.beginPath();\n        ctx.arc(this.x,this.y,this.size,0,Math.PI*2);\n        ctx.fillStyle=this.color;\n        ctx.fill();\n    }\n}\n\nclass Bullet{\n    constructor(x,y,angle,wind){\n        this.pos=new Vector(x,y);\n        this.vel=new Vector(Math.cos(angle)*5,Math.sin(angle)*5);\n        this.wind=wind;\n        this.life=3000;\n        this.maxLife=3000;\n        this.size=2;\n        this.trail=[];\n        this.trailLe