s.ctx.destination);\n        osc.frequency.value=400;\n        gain.gain.setValueAtTime(0,this.ctx.currentTime);\n        gain.gain.linearRampToValueAtTime(0.2,this.ctx.currentTime+0.01);\n        gain.gain.exponentialRampToValueAtTime(0.001,this.ctx.currentTime+0.2);\n        osc.start();\n        osc.stop(this.ctx.currentTime+0.2);\n    }\n    playHit(){\n        const osc=this.ctx.createOscillator();\n        const gain=this.ctx.createGain();\n        osc.connect(gain);\n        gain.connect(this.ctx.destination);\n        osc.frequency.value=800;\n        gain.gain.setValueAtTime(0,this.ctx.currentTime);\n        gain.gain.linearRampToValueAtTime(0.3,this.ctx.currentTime+0.01);\n        gain.gain.exponentialRampToValueAtTime(0.001,this.ctx.currentTime+0.15);\n        osc.start();\n        osc.stop(this.ctx.currentTime+0.15);\n    }\n}\n\nconst keys={};\nwindow.addEventListener('keydown',e=>{keys[e.key.toLowerCase()]=true;});\nwindow.addEventListener('keyup',e=>{keys[e.key.toLowerCase()]=false;});\n\nlet player=new Player();\nlet wind=new WindSystem();\nlet bullets=[];\nlet targets=[];\nlet audio=new AudioManager();\nlet lastTargetSpawn=0;\nlet targetSpawnRate=2000;\nlet score=0;\nlet highScore=localStorage.getItem('zephyrStrikeHighScore')||0;\nlet startTime=performance.now();\nlet gameOver=false;\n\nfunction spawnTarget(){\n    if(performance.now()-lastTargetSpawn>targetSpawnRate){\n        targets.push(new Target());\n        lastTargetSpawn=performance.now();\n    }\n}\n\nfunction update(dt){\n    if(gameOver)return;\n    player.update(keys,wind.getWind(),dt);\n    wind.update(dt);\n    spawnTarget();\n    \n    for(let i=bullets.length-1;i>=0;i--){\n        if(!bullets[i].update(dt))bullets.splice(i,1);\n    }\n    \n    for(let i=bullets.length-1;i>=0;i--){\n        const b=bullets[i];\n        for(let j=targets.length-1;j>=0;j--){\n            const t=targets[j];\n            const dx=b.pos.x-t.pos.x;\n            const dy=b.pos.y-t.pos.y;\n            const dist=Math.sqrt(dx*dx+dy*dy);\n            if(dist<player.size+t.size){\n                targets.splice(j,1);\n                bullets.splice(i,1);\n                score+=10;\n                audio.playHit();\n                break;\n            }\n        }\n    }\n    \n    if(targets.length>0){\n        for(const t of targets){\n            const dx=t.pos.x-player.pos.x;\n            const dy=t.pos.y-player.pos.y;\n            const dist=Math.sqrt(dx*dx+dy*dy);\n            if(dist<player.size+t.size){\n                player.health-=1;\n                if(player.health<=0){\n                    gameOver=true;\n                    const survived=(performance.now()-startTime)/1000;\n                    if(survived > highScore){
