Raw: {"index.html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no\">\n    <title>Chronos Descent</title>\n    <link rel=\"icon\" href=\"data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>⏳</text></svg>\">\n    <style>\n        * {\n            margin: 0;\n            padding: 0;\n            box-sizing: border-box;\n        }\n        html, body {\n            width: 100%;\n            height: 100%;\n            overflow: hidden;\n            background: #1a1a2e;\n            font-family: 'Courier New', monospace;\n        }\n        #gameContainer {\n            display: flex;\n            justify-content: center;\n            align-items: center;\n            width: 100%;\n            height: 100%;\n            background: linear-gradient(180deg, #1a1a2e 0%, #16213e 50%, #0f0f23 100%);\n        }\n        #gameCanvas {\n            background: #0d0d0d;\n            image-rendering: pixelated;\n            max-width: 100%;\n            max-height: 100%;\n            touch-action: none;\n        }\n        #instructions {\n            position: fixed;\n            bottom: 10px;\n            left: 50%;\n            transform: translateX(-50%);\n            color: rgba(255,220,180,0.6);\n            font-size: 11px;\n            text-align: center;\n            pointer-events: none;\n            text-shadow: 0 2px 4px rgba(0,0,0,0.8);\n        }\n        @media (max-width: 600px) {\n            #instructions {\n                font-size: 9px;\n            }\n        }\n    </style>\n</head>\n<body>\n    <div id=\"gameContainer\">\n        <canvas id=\"gameCanvas\"></canvas>\n    </div>\n    <div id=\"instructions\">⬅️ ➡️ / WASD: Move | SPACE: Jump | R: Restart</div>\n\n    <script>\n// ============================================\n// CHRONOS DESCENT - A 2D HTML5 Canvas Platformer\n// ============================================\n\nconst canvas = document.getElementById('gameCanvas');\nconst ctx = canvas.getContext('2d');\n\n// Base dimensions\nconst BASE_WIDTH = 800;\nconst BASE_HEIGHT = 600;\nconst TILE_SIZE = 32;\n\n// Set canvas size\ncanvas.width = BASE_WIDTH;\ncanvas.height = BASE_HEIGHT;\n\n// Scale for responsive display\nfunction resizeCanvas() {\n    const container = document.getElementById('gameContainer');\n    const containerWidth = container.clientWidth;\n    const containerHeight = container.clientHeight;\n    \n    const scaleX = containerWidth / BASE_WIDTH;\n    const scaleY = containerHeight / BASE_HEIGHT;\n    const scale = Math.min(scaleX, scaleY, 1.5);\n    \n    canvas.style.width = (BASE_WIDTH * scale) + 'px';\n    canvas.style.height = (BASE_HEIGHT * scale) + 'px';\n}\nwindow.addEventListener('resize', resizeCanvas);\nresizeCanvas();\n\n// ============================================\n// GAME CONSTANTS\n// ============================================\n\nconst GRAVITY = 0.8;\nconst MAX_AGE = 100;\nconst AGE_RATE = 1 / 300;\nconst DEATH_AGE = 100;\nconst TOTAL_FLOORS = 50;\nconst FLOOR_HEIGHT = 10;\n\nconst BASE_WALK_SPEED = 8;\nconst MIN_WALK_SPEED = 2;\nconst BASE_JUMP_FORCE = -15;\nconst BASE_AIR_CONTROL = 0.8;\nconst BASE_DECEL = 0.5;\nconst MAX_COYOTE_TIME = 6;\nconst MIN_COYOTE_TIME = 2;\nconst MAX_JUMP_BUFFER = 5;\nconst MIN_JUMP_BUFFER = 2;\nconst MAX_STAGGER_FRAMES = 8;\n\n// Tile types\nconst TILE_EMPTY = 0;\nconst TILE_SOLID = 1;\nconst TILE_EXIT = 2;\n\n// ============================================\n// LOCAL STORAGE - High Score\n// ============================================\n\nconst HighScore = {\n    KEY: 'chronos_descent_highscore',\n    \n    get() {\n        const data = localStorage.getItem(this.KEY);\n        return data ? parseFloat(data) : null;\n    },\n    \n    set(score) {\n        const current = this.get();\n        if (!current || score > current) {\n            localStorage.setItem(this.KEY, score.toString());\n            return true;\n        }\n        return false;\n    }\n};\n\n// ============================================\n// SPEEDRUN TIMER\n// ============================================\n\nclass SpeedrunTimer {\n    constructor() {\n        this.startTime = 0;\n        this.elapsed = 0;\n        this.running = false;\n    }\n    \n    start() {\n        this.startTime = performance.now();\n        this.running = true;\n        this.elapsed = 0;\n    }\n    \n    stop() {\n        this.running = false;\n    }\n    \n    update() {\n        if (this.running) {\n            this.elapsed = (performance.now() - this.startTime) / 1000;\n        }\n        return this.elapsed;\n    }\n    \n    format() {\n        const mins = Math.floor(this.elapsed / 60);\n        const secs = Math.floor(this.elapsed % 60);\n        const ms = Math.floor((this.elapsed % 1) * 100);\n        return `${mins.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}.${ms.toString().padStart(2, '0')}`;\n    }\n}\n\nconst timer = new SpeedrunTimer();\n\n// ============================================\n// AUDIO SYSTEM (Web Audio API)\n// ============================================\n\nclass AudioSystem {\n    constructor() {\n        this.ctx = null;\n        this.initialized = false;\n    }\n\n    init() {\n        if (this.initialized) return;\n        try {\n            this.ctx = new (window.AudioContext || window.webkitAudioContext)();\n            this.initialized = true;\n        } catch (e) {\n            console.log('Audio not supported');\n        }\n    }\n\n    playTone(freq, duration, type = 'sine', volume = 0.1) {\n        if (!this.initialized) return;\n        const osc = this.ctx.createOscillator();\n        const gain = this.ctx.createGain();\n        osc.connect(gain);\n        gain.connect(this.ctx.destination);\n        osc.frequency.value = freq;\n        osc.type = type;\n        gain.gain.setValueAtTime(volume, this.ctx.currentTime);\n        gain.gain.exponentialRampToValueAtTime(0.001, this.ctx.currentTime + duration);\n        osc.start();\n        osc.stop(this.ctx.currentTime + duration);\n    }\n\n    playFootstep(age) {\n        if (!this.initialized) return;\n        const freq = 60 + (1 - age / MAX_AGE) * 80;\n        this.playTone(freq, 0.05 + age / MAX_AGE * 0.08, 'sine', 0.08);\n    }\n\n    playJump(age) {\n        if (!this.initialized) return;\n        const freq = 180 + (1 - age / MAX_AGE) * 120;\n        this.playTone(freq, 0.12, 'triangle', 0.12);\n        setTimeout(() => this.playTone(freq * 0.5, 0.08, 'sine', 0.06), 50);\n    }\n\n    playCollect() {\n        if (!this.initialized) return;\n        [523, 659, 784, 1047].forEach((f, i) => {\n            setTimeout(() => this.playTone(f, 0.2, 'sine', 0.15), i * 60);\n        });\n    }\n\n    playDeath() {\n        if (!this.initialized) return;\n        [200, 150, 100, 50].forEach((f, i) => {\n            setTimeout(() => this.playTone(f, 0.3, 'sawtooth', 0.15), i * 100);\n        });\n    }\n\n    playVictory() {\n        if (!this.initialized) return;\n        [523, 659, 784, 1047, 1319].forEach((f, i) => {\n            setTimeout(() => this.playTone(f, 0.4, 'sine', 0.12), i * 120);\n        });\n    }\n\n    playLanding(age) {\n        if (!this.initialized) return;\n        this.playTone(40 + (1 - age / MAX_AGE) * 40, 0.1, 'sine', 0.1);\n    }\n}\n\nconst audio = new AudioSystem();\n\n// ============================================\n// INPUT HANDLER\n// ============================================\n\nconst Input = {\n    keys: {},\n    buffer: { jump: 0 },\n    justPressed: {},\n    \n    init() {\n        window.addEventListener('keydown', (e) => {\n            if (!this.keys[e.code]) {\n                this.justPressed[e.code] = true;\n            }\n            this.keys[e.code] = true;\n            if (['Space', 'ArrowUp', 'KeyW'].includes(e.code)) {\n                this.buffer.jump = MAX_JUMP_BUFFER;\n                audio.init();\n            }\n            if (['ArrowLeft', 'ArrowRight', 'KeyA', 'KeyD'].includes(e.code)) {\n                audio.init();\n            }\n            if (e.code === 'KeyR') {\n                audio.init();\n            }\n        });\n        window.addEventListener('keyup', (e) => {\n            this.keys[e.code] = false;\n        });\n        \n        // Touch controls\n        canvas.addEventListener('touchstart', (e) => {\n            e.preventDefault();\n            audio.init();\n            this.justPressed.touch = true;\n            this.buffer.jump = MAX_JUMP_BUFFER;\n        });\n    },\n\n    isDown(key) {\n        return this.keys[key] === true;\n    },\n\n    wasJustPressed(key) {\n        return this.justPressed[key] === true;\n    },\n\n    consumeJumpBuffer() {\n        if (this.buffer.jump > 0) {\n            this.buffer.jump--;\n            return true;\n        }\n        return false;\n    },\n\n    update() {\n        this.justPressed = {};\n        if (this.buffer.jump > 0) this.buffer.jump--;\n    }\n};\n\n// ============================================\n// PARTICLE SYSTEM\n// ============================================\n\nclass Particle {\n    constructor(x, y, vx, vy, life, color, size) {\n        this.x = x;\n        this.y = y;\n        this.vx = vx;\n        this.vy = vy;\n        this.life = life;\n        this.maxLife = life;\n        this.color = color;\n        this.size = size;\n    }\n\n    update() {\n        this.x += this.vx;\n        this.y += this.vy;\n        this.vy += 0.15;\n        this.life--;\n        return this.life > 0;\n    }\n\n    draw(ctx, camera) {\n        const alpha = this.life / this.maxLife;\n        ctx.globalAlpha = alpha;\n        ctx.fillStyle = this.color;\n        ctx.fillRect(this.x - camera.x, this.y - camera.y, this.size, this.size);\n        ctx.globalAlpha = 1;\n    }\n}\n\nclass ParticleSystem {\n    constructor() {\n        this.particles = [];\n    }\n\n    emit(x, y, count, config) {\n        for (let i = 0; i < count; i++) {\n            const angle = config.angle + (Math.random() - 0.5) * config.spread;\n            const speed = config.speed * (0.5 + Math.random() * 0.5);\n            this.particles.push(new Particle(\n                x, y,\n                Math.cos(angle) * speed,\n                Math.sin(angle) * speed,\n                config.life * (0.5 + Math.random() * 0.5),\n                config.colors[Math.floor(Math.random() * config.colors.length)],\n                config.size * (0.5 + Math.random() * 0.5)\n            ));\n        }\n    }\n\n    update() {\n        this.particles = this.particles.filter(p => p.update());\n    }\n\n    draw(ctx, camera) {\n        this.particles.forEach(p => p.draw(ctx, camera));\n    }\n\n    clear() {\n        this.particles = [];\n    }\n}\n\nconst particles = new ParticleSystem();\n\n// ============================================\n// CAMERA\n// ============================================\n\nclass Camera {\n    constructor() {\n        this.x = 0;\n        this.y = 0;\n        this.targetY = 0;\n        this.smoothing = 0.1;\n    }\n\n    follow(player, levelHeight) {\n        this.targetY = player.y - BASE_HEIGHT / 2 + player.height;\n        this.targetY = Math.max(0, Math.min(this.targetY, levelHeight - BASE_HEIGHT));\n        this.y += (this.targetY - this.y) * this.smoothing;\n    }\n\n    reset() {\n        this.x = 0;\n        this.y = 0;\n        this.targetY = 0;\n    }\n}\n\nconst camera = new Camera();\n\n// ============================================\n// LEVEL GENERATOR\n// ============================================\n\nclass Level {\n    constructor() {\n        this.tiles = [];\n        this.width = Math.floor(BASE_WIDTH / TILE_SIZE) + 4;\n        this.height = TOTAL_FLOORS * FLOOR_HEIGHT * 18;\n        this.memoryShards = [];\n        this.exitPosition = { x: 0, y: 0 };\n        this.hazards = [];\n        this.crumblePlatforms = [];\n        this.generate();\n    }\n\n    generate() {\n        // Initialize empty\n        for (let y = 0; y < this.height; y++) {\n            this.tiles[y] = [];\n            for (let x = 0; x < this.width; x++) {\n                this.tiles[y][x] = TILE_EMPTY;\n            }\n        }\n\n        // Generate floors\n        for (let floor = 0; floor < TOTAL_FLOORS; floor++) {\n            const floorBaseY = this.height - (floor + 1) * FLOOR_HEIGHT * 18;\n            const platformCount = 3 + Math.floor(Math.random() * 4);\n            const platforms = [];\n            \n            for (let p = 0; p < platformCount; p++) {\n                const platWidth = 4 + Math.floor(Math.random() * 8);\n                const platX = Math.floor(Math.random() * (this.width - platWidth - 4)) + 2;\n                const platY = floorBaseY + Math.floor(Math.random() * (FLOOR_HEIGHT * 18 - 6)) + 2;\n                \n                platforms.push({ x: platX, y: platY, width: platWidth });\n                \n                for (let tx = platX; tx < platX + platWidth && tx < this.width - 2; tx++) {\n                    if (platY >= 0 && platY < this.height) {\n                        this.tiles[platY][tx] = TILE_SOLID;\n                    }\n                }\n            }\n\n            // Hazards based on depth\n            const hazardChance = 0.15 + (floor / TOTAL_FLOORS) * 0.35;\n            \n            // Gears\n            if (Math.random() < hazardChance * 0.6) {\n                const gearX = Math.floor(Math.random() * (this.width - 8)) + 4;\n                const gearY = floorBaseY + FLOOR_HEIGHT * 9 + Math.floor(Math.random() * FLOOR_HEIGHT * 4);\n                this.hazards.push({\n                    type: 'gear',\n                    x: gearX * TILE_SIZE,\n                    y: gearY * TILE_SIZE,\n                    radius: 35,\n                    speed: 0.02 + Math.random() * 0.025,\n                    angle: Math.random() * Math.PI * 2,\n                    width: 70,\n                    height: 70\n                });\n            }\n\n            // Pendulums\n            if (Math.random() < hazardChance * 0.5) {\n                const pendX = Math.floor(Math.random() * (this.width - 10)) + 5;\n                const pendY = floorBaseY;\n                this.hazards.push({\n                    type: 'pendulum',\n                    x: pendX * TILE_SIZE,\n                    y: pendY * TILE_SIZE,\n                    length: 100 + Math.random() * 80,\n                    angle: Math.PI / 4,\n                    speed: 0.025 + Math.random() * 0.015,\n                    width: 20,\n                    height: 140\n                });\n            }\n\n            // Memory shards\n            if (Math.random() < 0.12 && platforms.length > 0) {\n                const shardPlatform = platforms[Math.floor(Math.random() * platforms.length)];\n                this.memoryShards.push({\n                    x: (shardPlatform.x + shardPlatform.width / 2) * TILE_SIZE,\n                    y: shardPlatform.y * TILE_SIZE - TILE_SIZE * 1.5,\n                    collected: false,\n                    bobOffset: Math.random() * Math.PI * 2\n                });\n            }\n\n            // Exit at bottom\n            if (floor === TOTAL_FLOORS - 1) {\n                const exitX = Math.floor(this.width / 2) - 2;\n                const exitY = this.height - 5;\n                this.exitPosition = { x: exitX * TILE_SIZE, y: exitY * TILE_SIZE };\n                for (let ex = exitX - 2; ex <= exitX + 4; ex++) {\n                    for (let ey = exitY - 2; ey <= exitY + 1; ey++) {\n                        if (ey >= 0 && ey < this.height && ex >= 0 && ex < this.width) {\n                            this.tiles[ey][ex] = TILE_EXIT;\n                        }\n                    }\n                }\n            }\n        }\n\n        // Starting ground\n        const startY = this.height - 3;\n        for (let x = 0; x < this.width; x++) {\n            this.tiles[startY][x] = TILE_SOLID;\n        }\n    }\n\n    getTile(x, y) {\n        const tx = Math.floor(x / TILE_SIZE);\n        const ty = Math.floor(y / TILE_SIZE);\n        if (tx < 0 || tx >= this.width || ty < 0 || ty >= this.height) {\n            return ty >= this.height ? TILE_SOLID : TILE_EMPTY;\n        }\n        return this.tiles[ty][tx];\n    }\n\n    isSolid(x, y) {\n        const tile = this.getTile(x, y);\n        return tile === TILE_SOLID || tile === TILE_EXIT;\n    }\n\n    update(dt) {\n        this.hazards.forEach(h => {\n            if (h.type === 'gear') {\n                h.angle += h.speed * dt;\n            } else if (h.type === 'pendulum') {\n                h.angle += Math.sin(h.angle) * h.speed * dt;\n            }\n        });\n\n        this.memoryShards.forEach(shard => {\n            shard.bobOffset += 0.05;\n        });\n    }\n\n    checkHazardCollision(player) {\n        const px = player.x + player.width / 2;\n        const py = player.y + player.height / 2;\n        const pr = player.width / 2 - 4;\n\n        for (const h of this.hazards) {\n            if (h.type === 'gear') {\n                const dx = px - (h.x + h.radius);\n                const dy = py - (h.y + h.radius);\n                const dist = Math.sqrt(dx * dx + dy * dy);\n                if (dist < h.radius + pr) {\n                    return true;\n                }\n            } else if (h.type === 'pendulum') {\n                const baseX = h.x + 10;\n                const baseY = h.y;\n                const tipX = baseX + Math.sin(h.angle) * h.length;\n                const tipY = baseY + Math.cos(h.angle) * h.length;\n                const lineDist = this.pointToLineDistance(px, py, baseX, baseY, tipX, tipY);\n                if (lineDist < 20 + pr) {\n                    return true;\n                }\n            }\n        }\n        return false;\n    }\n\n    pointToLineDistance(px, py, x1, y1, x2, y2) {\n        const A = px - x1;\n        const B = py - y1;\n        const C = x2 - x1;\n        const D = y2 - y1;\n        const dot = A * C + B * D;\n        const lenSq = C * C + D * D;\n        let param = lenSq !== 0 ? dot / lenSq : -1;\n        let xx, yy;\n        if (param < 0) { xx = x1; yy = y1; }\n        else if (param > 1) { xx = x2; yy = y2; }\n        else { xx = x1 + param * C; yy = y1 + param * D; }\n        return Math.sqrt((px - xx) ** 2 + (py - yy) ** 2);\n    }\n\n    getCurrentFloor(playerY) {\n        const depth = 1 - (playerY / this.height);\n        return Math.max(1, Math.min(TOTAL_FLOORS, Math.ceil(depth * TOTAL_FLOORS)));\n    }\n\n    draw(ctx, camera, age) {\n        const startX = Math.max(0, Math.floor(camera.x / TILE_SIZE) - 1);\n        const endX = Math.min(this.width, startX + Math.ceil(BASE_WIDTH / TILE_SIZE) + 4);\n        const startY = Math.max(0, Math.floor(camera.y / TILE_SIZE) - 1);\n        const endY = Math.min(this.height, startY + Math.ceil(BASE_HEIGHT / TILE_SIZE) + 4);\n\n        // Draw tiles\n        for (let y = startY; y < endY; y++) {\n            for (let x = startX; x < endX; x++) {\n                const tile = this.tiles[y][x];\n                const screenX = x * TILE_SIZE - camera.x;\n                const screenY = y * TILE_SIZE - camera.y;\n\n                if (tile === TILE_SOLID) {\n                    const depth = y / this.height;\n                    const r = Math.floor(55 + depth * 50);\n                    const g = Math.floor(45 + depth * 35);\n                    const b = Math.floor(35 + depth * 25);\n                    ctx.fillStyle = `rgb(${r},${g},${b})`;\n                    ctx.fillRect(screenX, screenY, TILE_SIZE, TILE_SIZE);\n                    ctx.strokeStyle = `rgba(255,235,210,0.08)`;\n                    ctx.strokeRect(screenX + 0.5, screenY + 0.5, TILE_SIZE - 1, TILE_SIZE - 1);\n                } else if (tile === TILE_EXIT) {\n                    const pulse = Math.sin(Date.now() * 0.004) * 0.3 + 0.7;\n                    ctx.fillStyle = `rgba(255,255,180,${pulse * 0.4})`;\n                    ctx.fillRect(screenX, screenY, TILE_SIZE, TILE_SIZE);\n                    ctx.strokeStyle = `rgba(255,255,140,${pulse})`;\n                    ctx.lineWidth = 2;\n                    ctx.strokeRect(screenX + 1, screenY + 1, TILE_SIZE - 2, TILE_SIZE - 2);\n                    ctx.lineWidth = 1;\n                }\n            }\n        }\n\n        // Draw hazards\n        this.hazards.forEach(h => {\n            if (h.type === 'gear') {\n                const screenX = h.x - camera.x;\n                const screenY = h.y - camera.y;\n                \n                ctx.save();\n                ctx.translate(screenX + h.radius, screenY + h.radius);\n                ctx.rotate(h.angle);\n                \n                ctx.fillStyle = '#4a4540';\n                ctx.beginPath();\n                ctx.arc(0, 0, h.radius * 0.65, 0, Math.PI * 2);\n                ctx.fill();\n                \n                ctx.fillStyle = '#5a5550';\n                for (let i = 0; i < 8; i++) {\n                    ctx.save();\n                    ctx.rotate((i / 8) * Math.PI * 2);\n                    ctx.fillRect(-6, h.radius * 0.45, 12, h.radius * 0.4);\n                    ctx.restore();\n                }\n                \n                ctx.fillStyle = '#2a2520';\n                ctx.beginPath();\n                ctx.arc(0, 0, h.radius * 0.18, 0, Math.PI * 2);\n                ctx.fill();\n                \n                ctx.restore();\n            } else if (h.type === 'pendulum') {\n                const baseX = h.x - camera.x + 10;\n                const baseY = h.y - camera.y;\n                const tipX = baseX + Math.sin(h.angle) * h.length;\n                const tipY = baseY + Math.cos(h.angle) * h.length;\n                \n                ctx.strokeStyle = '#5a5550';\n                ctx.lineWidth = 3;\n                ctx.beginPath();\n                ctx.moveTo(baseX, baseY);\n                ctx.lineTo(tipX, tipY);\n                ctx.stroke();\n                \n                ctx.fillStyle = '#6a6560';\n                ctx.beginPath();\n                ctx.arc(tipX, tipY, 12, 0, Math.PI * 2);\n                ctx.fill();\n                \n                ctx.strokeStyle = '#7a7570';\n                ctx.lineWidth = 5;\n                ctx.beginPath();\n                ctx.moveTo(tipX - 25, tipY);\n                ctx.lineTo(tipX + 25, tipY);\n                ctx.stroke();\n                ctx.lineWidth = 1;\n            }\n        });\n\n        // Draw memory shards\n        this.memoryShards.forEach(shard => {\n            if (shard.collected) return;\n            \n            const bobY = Math.sin(shard.bobOffset) * 6;\n            const screenX = shard.x - camera.x;\n            const screenY = shard.y - camera.y + bobY;\n            \n            const glow = Math.sin(Date.now() * 0.006) * 0.3 + 0.7;\n            ctx.fillStyle = `rgba(180,210,255,${glow * 0.25})`;\n            ctx.beginPath();\n            ctx.arc(screenX, screenY, 22, 0, Math.PI * 2);\n            ctx.fill();\n            \n            ctx.fillStyle = `rgba(200,230,255,${glow})`;\n            ctx.beginPath();\n            ctx.moveTo(screenX, screenY - 14);\n            ctx.lineTo(screenX + 9, screenY);\n            ctx.lineTo(screenX, screenY + 14);\n            ctx.lineTo(screenX - 9, screenY);\n            ctx.closePath();\n            ctx.fill();\n            \n            ctx.strokeStyle = `rgba(255,255,255,${glow})`;\n            ctx.lineWidth = 2;\n            ctx.stroke();\n            ctx.lineWidth = 1;\n        });\n\n        // Ambient dust\n        ctx.fillStyle = 'rgba(180,160,130,0.25)';\n        for (let i = 0; i < 25; i++) {\n            const dustX = ((i * 73 + Date.now() * 0.015) % BASE_WIDTH);\n            const dustY = ((i * 47 - Date.now() * 0.025) % BASE_HEIGHT + camera.y * 0.3) % BASE_HEIGHT;\n            ctx.fillRect(dustX, dustY, 2, 2);\n        }\n    }\n}\n\n// ============================================\n// PLAYER CLASS\n// ============================================\n\nclass Player {\n    constructor(x, y) {\n        this.x = x;\n        this.y = y;\n        this.width = 22;\n        this.height = 44;\n        this.vx = 0;\n        this.vy = 0;\n        \n        this.age = 0;\n        this.state = 'Idle';\n        this.facing = 1;\n        this.grounded = false;\n        this.coyoteTimer = 0;\n        this.staggerTimer = 0;\n        this.speedBoostTimer = 0;\n        this.footstepTimer = 0;\n        this.jumpBuffered = false;\n        \n        this.animFrame = 0;\n        this.animTimer = 0;\n        this.trembleOffset = 0;\n    }\n\n    get walkSpeed() {\n        const factor = 1 - (this.age / MAX_AGE);\n        let speed = MIN_WALK_SPEED + (BASE_WALK_SPEED - MIN_WALK_SPEED) * factor;\n        if (this.speedBoostTimer > 0) speed *= 1.5;\n        return speed;\n    }\n\n    get jumpForce() {\n        return BASE_JUMP_FORCE * (1 - (this.age / MAX_AGE) * 0.5);\n    }\n\n    get airControl() {\n        return BASE_AIR_CONTROL * (1 - (this.age / MAX_AGE) * 0.65);\n    }\n\n    get deceleration() {\n        return BASE_DECEL + (this.age / MAX_AGE) * 0.35;\n    }\n\n    get coyoteTime() {\n        return Math.floor(MIN_COYOTE_TIME + (MAX_COYOTE_TIME - MIN_COYOTE_TIME) * (1 - this.age / MAX_AGE));\n    }\n\n    get jumpBufferTime() {\n        return Math.floor(MIN_JUMP_BUFFER + (MAX_JUMP_BUFFER - MIN_JUMP_BUFFER) * (1 - this.age / MAX_AGE));\n    }\n\n    get staggerFrames() {\n        return Math.floor((MAX_STAGGER_FRAMES) * (this.age / MAX_AGE));\n    }\n\n    get ageBracket() {\n        if (this.age <= 30) return 'young';\n        if (this.age <= 60) return 'middle';\n        if (this.age <= 85) return 'elderly';\n        return 'ancient';\n    }\n\n    update(input, level, dt) {\n        this.age += AGE_RATE * dt;\n        if (this.age >= DEATH_AGE) {\n            this.state = 'Dead';\n            return;\n        }\n\n        if (this.speedBoostTimer > 0) {\n            this.speedBoostTimer -= dt / 60;\n        }\n\n        if (this.staggerTimer > 0) {\n            this.staggerTimer--;\n            this.vx *= 0.88;\n            this.state = 'Stagger';\n            return;\n        }\n\n        let moveX = 0;\n        if (input.isDown('ArrowLeft') || input.isDown('KeyA')) moveX = -1;\n        if (input.isDown('ArrowRight') || input.isDown('KeyD')) moveX = 1;\n\n        if (moveX !=={"index.html": "{"gameWon": function() {\n        const elapsed = timer.update();\n        const isNewBest = HighScore.set(elapsed);\n        if (isNewBest) {\n            game.highScore = elapsed;\n        }\n        \n        ctx.fillStyle = 'rgba(10,10,30,0.85)';\n        ctx.fillRect(0, 0, BASE_WIDTH, BASE_HEIGHT);\n        \n        ctx.font = 'bold 42px \"Courier New\"';\n        ctx.fillStyle = '#ffd700';\n        ctx.textAlign = 'center';\n        ctx.fillText('DESCENT COMPLETE!', BASE_WIDTH / 2, BASE_HEIGHT / 2 - 60);\n        \n        ctx.font = '28px \"Courier New\"';\n        ctx.fillStyle = '#aaaacc';\n        ctx.fillText('Time: ' + timer.format(), BASE_WIDTH / 2, BASE_HEIGHT / 2);\n        ctx.fillStyle = '#888866';\n        ctx.fillText('Best: ' + (game.highScore ? new SpeedrunTimer().constructor.prototype.format.call({elapsed: game.highScore}) : '--:--.--'), BASE_WIDTH / 2, BASE_HEIGHT / 2 + 35);\n        \n        ctx.font = '18px \"Courier New\"';\n        ctx.fillStyle = '#666644';\n        ctx.fillText('Press SPACE to descend again', BASE_WIDTH / 2, BASE_HEIGHT / 2 + 100);\n        ctx.textAlign = 'left';\n    }\n}\n\nfunction updateGame(dt) {\n    if (!Input.initialized) {\n        Input.init();\n        audio.init();\n    }\n    \n    if (game.state === 'menu') {\n        if (Input.wasJustPressed('Space') || Input.justPressed.touch) {\n            audio.init();\n            game.start();\n        }\n    } else if (game.state === 'playing') {\n        game.player.update(Input, level, dt);\n        \n        if (game.player.state === 'Dead' || game.player.y > level.height * TILE_SIZE + 200) {\n            game.state = 'dead';\n            timer.stop();\n            audio.playDeath();\n            setTimeout(() => game.restart(), 2000);\n        }\n        \n        const result = game.player.checkState(level);\n        if (result === 'Won') {\n            game.state = 'won';\n            timer.stop();\n            audio.playVictory();\n        }\n        \n        game.player.move(Input);\n        camera.follow(game.player, level.height * TILE_SIZE);\n        level.update(dt);\n        particles.update();\n        Input.update();\n    }\n}\n\nfunction drawGame() {\n    ctx.clearRect(0, 0, BASE_WIDTH, BASE_HEIGHT);\n    \n    if (game.state === 'menu') {\n        const gradient = ctx.createLinearGradient(0, 0, 0, BASE_HEIGHT);\n        gradient.addColorStop(0, '#1a1a2e');\n        gradient.addColorStop(0.5, '#16213e');\n        gradient.addColorStop(1, '#0f0f23');\n        ctx.fillStyle = gradient;\n        ctx.fillRect(0, 0, BASE_WIDTH, BASE_HEIGHT);\n        \n        ctx.font = 'bold 52px \"Courier New\"';\n        ctx.fillStyle = '#ffd700';\n        ctx.textAlign = 'center';\n        ctx.shadowColor = 'rgba(0,0,0,0.8)';\n        ctx.shadowBlur = 8;\n        ctx.shadowOffsetY = 4;\n        ctx.fillText('CHRONOS DESCENT', BASE_WIDTH / 2, 160);\n        ctx.shadowBlur = 0;\n        \n        ctx.fillStyle = '#aaa'; ctx.font = 'italic 20px \"Courier New\"';\n        ctx.fillText('Time waits for no one...', BASE_WIDTH / 2, 200);\n        \n        ctx.fillStyle = '#ddccaa';\n        ctx.font = '14px \"Courier New\"';\n        ctx.fillText('Arrow Keys / WASD - Move', BASE_WIDTH / 2, 340);\n        ctx.fillText('SPACE - Jump', BASE_WIDTH / 2, 365);\n        ctx.fillText('R - Restart', BASE_WIDTH / 2, 390);\n        ctx.fillStyle = '#88aacc';\n        ctx.fillText('Collect memory crystals for a speed boost!', BASE_WIDTH / 2, 425);\n        ctx.fillStyle = '#666688';\n        ctx.fillText('Reach the golden exit at the bottom!', BASE_WIDTH / 2, 450);\n        \n        const pulse = Math.sin(Date.now() * 0.005) * 0.3 + 0.7;\n        ctx.fillStyle = `rgba(255,215,0,${pulse})`;\n        ctx.font = '18px \"Courier New\"';\n        ctx.fillText('Press SPACE to begin your descent', BASE_WIDTH / 2, 520);\n        ctx.textAlign = 'left';\n    } else if (game.state === 'playing' || game.state === 'dead') {\n        level.draw(ctx, camera, game.player.age / MAX_AGE);\n        particles.draw(ctx, camera);\n        game.player.draw(ctx, camera);\n        game.player.drawUI(ctx, level);\n        game.player.drawSpeedBoost();\n    }\n    \n    if (game.state === 'dead') {\n        const elapsed = timer.update();\n        const isNewBest = HighScore.set(elapsed);\n        if (isNewBest) game.highScore = elapsed;\n        \n        ctx.fillStyle = 'rgba(20,10,10,0.85)';\n        ctx.fillRect(0, 0, BASE_WIDTH, BASE_HEIGHT);\n        \n        ctx.font = 'bold 36px \"Courier New\"';\n        ctx.fillStyle = '#ccaaaa';\n        ctx.textAlign = 'center';\n        ctx.fillText('YOUR TIME CATCHES UP TO YOU...', BASE_WIDTH / 2, BASE_HEIGHT / 2 - 40);\n        \n        ctx.font = '28px \"Courier New\"';\n        ctx.fillStyle = '#ffd700';\n        ctx.fillText('Time: ' + timer.format(), BASE_WIDTH / 2, BASE_HEIGHT / 2 + 10);\n        \n        if (isNewBest) {\n            const pulse = Math.sin(Date.now() * 0.01) * 0.3 + 0.7;\n            ctx.fillStyle = `rgba(255,100,100,${pulse})`;\n            ctx.font = '20px \"Courier New\"';\n            ctx.fillText('NEW BEST!', BASE_WIDTH / 2, BASE_HEIGHT / 2 + 50);\n        }\n        \n        ctx.font = '16px \"Courier New\"';\n        ctx.fillStyle = '#666666';\n        ctx.fillText('Restarting...', BASE_WIDTH / 2, BASE_HEIGHT / 2 + 100);\n        ctx.textAlign = 'left';\n    }\n    \n    if (game.state === 'won') {\n        gameWon();\n    }\n}\n\nfunction gameLoop(timestamp) {\n    const dt = Math.min(32, timestamp - (game.lastTime || timestamp)) / 16.67;\n    game.lastTime = timestamp;\n    updateGame(dt);\n    drawGame();\n    requestAnimationFrame(gameLoop);\n}\n\nrequestAnimationFrame(gameLoop);\n</script>\n</body>\n</html>"}