  "ui.js": "// UI module for Punctuations game\n\nclass UIManager {\n    constructor() {\n        this.scoreEl = document.getElementById('score');\n        this.timerEl = document.getElementById('timer');\n        this.pauseBtn = document.getElementById('pauseBtn');\n        this.gameOverOverlay = document.getElementById('game-over-overlay');\n        this.gameOverText = document.getElementById('gameOverText');\n        this.finalScoreEl = document.getElementById('finalScore');\n        this.restartBtn = document.getElementById('restartBtn');\n        \n        this.init();\n    }\n\n    init() {\n        // Set initial values\n        this.scoreEl.textContent = '0';\n        this.timerEl.textContent = '120';\n        this.pauseBtn.textContent = 'Pause';\n        this.gameOverOverlay.classList.remove('active');\n        this.restartBtn.disabled = true;\n    }\n\n    updateScore() {\n        const scoreEl = this.scoreEl;\n        scoreEl.textContent = this.score;\n    }\n\n    updateTimer() {\n        const timerEl = this.timerEl;\n        timerEl.textContent = this.timer;\n    }\n\n    togglePause() {\n        const pauseBtn = this.pauseBtn;\n        if (this.pauseBtn.textContent === 'Pause') {\n            this.pauseBtn.textContent = 'Resume';\n            this.startPause();\n        } else {\n            this.pauseBtn.textContent = 'Pause';\n            this.stopPause();\n        }\n    }\n\n    startPause() {\n        // In a real implementation, this would pause the game loop\n        // For now, we just update the button text\n    }\n\n    stopPause() {\n        // In a real implementation, this would resume the game loop\n    }\n\n    showGameOver() {\n        this.gameOverText.textContent = 'Game Over!';\n        this.fthis.finalScoreEl.textContent = `High Score: ${this.highScore}`;
