  "renderer.js": "// Rendering module for Punctuations game\n\nclass Renderer {\n    constructor(canvas) {\n        this.canvas = canvas;\n        this.ctx = canvas.getContext('2d');\n        this.resize();\n    }\n\n    resize() {\n        // Set canvas size to match container\n        const container = this.canvas.parentElement;\n        if (container) {\n            this.canvas.width = container.clientWidth;\n            this.canvas.height = container.clientHeight;\n        }\n    }\n\n    clear() {\n        this.ctx.fillStyle = '#1a2a4a';\n        this.ctx.fillRect(0, 0, this.canvas.width, this.canvas.height);\n    }\n\n    drawWord(word) {\n        const { x, y } = word.getPosition();\n        const w = word.width;\n        const h = word.height;\n        \n        // Shadow\n        this.ctx.shadowColor = word.color;\n        this.ctx.shadowBlur = 15;\n        this.ctx.shadowOffsetX = 4;\n        this.ctx.shadowOffsetY = 4;\n        \n        // Word body with vibrant gradient\n        const grad = this.ctx.createLinearGradient(x, y - h/2, x, y + h/2);\n        grad.addColorStop(0, word.color + '88');\n        grad.addColorStop(1, word.color + '00');\n        this.ctx.fillStyle = grad;\n        this.ctx.fillRect(x - w/2, y - h/2, w, h);\n        \n        // Outline\n        this.ctx.strokeStyle = word.color + '555';\n        this.ctx.lineWidth = 2;\n        this.ctx.strokeRect(x - w/2, y - h/2, w, h);\n        \n        // Inner highlight\n        this.ctx.fillStyle = 'rgba(255, 255, 255, 0.3)';\n        this.ctx.fillRect(x + 2, y + 2, w - 4, h - 4);\n        \n        // Glow effect for period\n        if (word.isPeriodActive) {\n            this.ctx.shadowBlur = 20;\n            this.ctx.shadowColor = word.color;\n            this.ctx.fillStyle = word.color + 'cc';\n            this.ctx.fillRect(x - w/2, y - h/2, w, h);\n            this.ctx.shadowBlur = 0;\n        }\n    }\n\n    drawPunctuation(punct) {\n        const { x, y } = punct.getPosition();\n   