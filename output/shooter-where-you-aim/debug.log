    ctx.beginPath();
    ctx.arc(p.x, p.y, 2, 0, Math.PI*2);
    ctx.fill();
    ctx.globalAlpha = 1;
  }

  // HUD
  // crosshair
  const crossSize = 5 + Math.abs(mouse.x - player.x) + Math.abs(mouse.y - player.y) * 0.1;
  ctx.strokeStyle = UI_COLOR;
  ctx.lineWidth = 2;
  ctx.beginPath();
