ton>\n        </div>\n        \n        <!-- Victory Screen -->\n        <div class=\"screen\" id=\"victory-screen\">\n            <div class=\"title\">Level Complete!</div>\n            <div id=\"victory-stars\" style=\"font-size: 2rem; margin: 20px;\">⭐⭐⭐</div>\n            <div id=\"victory-stats\" style=\"margin: 10px; color: var(--text-secondary);\"></div>\n            <div style=\"margin: 10px; color: var(--accent);\">\n                Time: <span id=\"victory-time\">00:00</span>\n            </div>\n            <button class=\"btn btn-primary\" id=\"next-level-btn\">Next Level</button>\n            <button class=\"btn btn-secondary\" id=\"replay-btn\">Replay</button>\n            <button class=\"btn btn-secondary\" id=\"level-select-victory-btn\">Level Select</button>\n        </div>\n        \n        <!-- Game Over (All Complete) -->\n        <div class=\"screen\" id=\"complete-screen\">\n            <div class=\"title\">🎉 All Levels Complete!</div>\n            <div style=\"margin: 20px; text-align: center;\">\n                <p>You mastered the Block Tower!</p>\n                <p style=\"margin-top: 10px;\">Total Stars: <span id=\"final-stars\">0</span>/30</p>\n            </div>\n            <button class=\"btn btn-primary\" id=\"play-again-btn\">Play Again</button>\n            <button class=\"btn btn-secondary\" id=\"level-select-complete-btn\">Level Select</button>\n        </div>\n    </div>\n    \n    <script>\n        // ==================== GAME CONFIGURATION ====================\n        const CONFIG = {\n            CELL_SIZE: 60,\n            GRID_COLS: 5,\n            GRID_OFFSET_X: 150,\n            GRID_OFFSET_Y: 100,\n            COLORS: {\n                bgPrimary: '#1a1a2e',\n                bgSecondary: '#16213e',\n                gridLine: '#0f3460',\n                blockFill: '#e94560',\n                blockStroke: '#ff6b6b',\n                accent: '#ffd93d',\n                textPrimary: '#eaeaea',\n                textSecondary: '#a0a0a0',\n                validGhost: '#4ecca3',\n                invalidGhost: '#ff4757',\n                ground: '#16213e'\n            }\n        };\n\n        // ==================== BLOCK DEFINITIONS ====================\n        const BLOCK_TYPES = {\n            square: {\n                name: 'Square',\n                cells: [[0, 0]],\n                color: CONFIG.COLORS.blockFill\n            },\n            domino: {\n                name: 'Domino',\n                cells: [[0, 0], [1, 0]],\n                color: '#e94560'\n            },\n            tBlock: {\n                name: 'T-Block',\n                cells: [[0, 0], [1, 0], [2, 0], [1, 1]],\n                color: '#e94560'\n            },\n            lBlock: {\n                name: 'L-Block',\n                cells: [[0, 0], [0, 1], [0, 2], [1, 2]],\n                color: '#e94560'\n            },\n            long: {\n                name: 'Long',\n                cells: [[0, 0], [0, 1], [0, 2]],\n                color: '#e94560'\n            }\n        };\n\n        // ==================== LEVEL DATA ====================\n        const LEVELS = [\n            { target: 4, blocks: { square: 4 }, name: 'Tutorial' },\n            { target: 6, blocks: { square: 2, domino: 2 }, name: 'Easy' },\n            { target: 7, blocks: { square: 3, lBlock: 2 }, name: 'Easy' },\n            { target: 8, blocks: { domino: 2, lBlock: 2, square: 2 }, name: 'Medium' },\n            { target: 9, blocks: { tBlock: 2, square: 3 }, name: 'Medium' },\n            { target: 10, blocks: { tBlock: 1, lBlock: 2, domino: 2, square: 2 }, name: 'Hard' },\n            { target: 12, blocks: { tBlock: 2, lBlock: 1, domino: 2, long: 1 }, name: 'Hard' },\n            { target: 14, blocks: { tBlock: 2, lBlock: 2, domino: 2, long: 2 }, name: 'Expert' },\n            { target: 15, blocks: { tBlock: 3, lBlock: 2, domino: 2, long: 1 }, name: 'Expert' },\n            { target: 16, blocks: { tBlock: 3, lBlock: 3, domino: 2, long: 2 }, name: 'Master' }\n        ];\n\n        // ==================== GAME STATE ====================\n        const state = {\n            currentScreen: 'title',\n            currentLevel: 0,\n            placedBlocks: [],\n            palette: {},\n            selectedBlockType: null,\n            mousePos: { x: 0, y: 0 },\n            ghostPosition: null,\n            isValidPlacement: false,\n            gameStarted: false,\n            startTime: 0,\n            elapsedTime: 0,\n            paused: false,\n            starsEarned: new Array(10).fill(0),\n            levelStars: new Array(10).fill(0),\n            history: []\n        };\n\n        // ==================== AUDIO SYSTEM ====================\n        const AudioSystem = {\n            ctx: null,\n            \n            init() {\n                try {\n                    this.ctx = new (window.AudioContext || window.webkitAudioContext)();\n                } catch (e) {\n                    console.log('Web Audio not supported');\n                }\n            },\n            \n            play(type) {\n                if (!this.ctx) return;\n                \n                const oscillator = this.ctx.createOscillator();\n                const gainNode = this.ctx.createGain();\n                \n                oscillator.connect(gainNode);\n                gainNode.connect(this.ctx.destination);\n                \n                switch(type) {\n                    case 'place':\n                        oscillator.frequency.value = 440;\n                        oscillator.type = 'sine';\n                        gainNode.gain.setValueAtTime(0.2, this.ctx.currentTime);\n                        gainNode.gain.exponentialRampToValueAtTime(0.01, this.ctx.currentTime + 0.1);\n                        oscillator.start();\n                        oscillator.stop(this.ctx.currentTime + 0.1);\n                        break;\n                    case 'select':\n                        oscillator.frequency.value = 523;\n                        oscillator.type = 'sine';\n                        gainNode.gain.setValueAtTime(0.15, this.ctx.currentTime);\n                        gainNode.gain.exponentialRampToValueAtTime(0.01, this.ctx.currentTime + 0.08);\n                        oscillator.start();\n                        oscillator.stop(this.ctx.currentTime + 0.08);\n                        break;\n                    case 'error':\n                        oscillator.frequency.value = 200;\n                        oscillator.type = 'square';\n                        gainNode.gain.setValueAtTime(0.15, this.ctx.currentTime);\n                        gainNode.gain.exponentialRampToValueAtTime(0.01, this.ctx.currentTime + 0.15);\n                        oscillator.start();\n                        oscillator.stop(this.ctx.currentTime + 0.15);\n                        break;\n                    case 'victory':\n                        const notes = [523, 659, 784, 1047];\n                        notes.forEach((freq, i) => {\n                            const osc = this.ctx.createOscillator();\n                            const gain = this.ctx.createGain();\n                            osc.connect(gain);\n                            gain.connect(this.ctx.destination);\n                            osc.frequency.value = freq;\n                            osc.type = 'sine';\n                            gain.gain.setValueAtTime(0.2, this.ctx.currentTime + i * 0.1);\n                            gain.gain.exponentialRampToValueAtTime(0.01, this.ctx.currentTime + i * 0.1 + 0.3);\n                            osc.start(this.ctx.currentTime + i * 0.1);\n                            osc.stop(this.ctx.currentTime + i * 0.1 + 0.3);\n                        });\n                        break;\n                    case 'levelup':\n                        oscillator.frequency.value = 880;\n                        oscillator.type = 'sine';\n                        gainNode.gain.setValueAtTime(0.15, this.ctx.currentTime);\n                        gainNode.gain.exponentialRampToValueAtTime(0.01, this.ctx.currentTime + 0.2);\n                        oscillator.start();\n                        oscillator.stop(this.ctx.currentTime + 0.2);\n                        break;\n                }\n            }\n        };\n\n        // ==================== PARTICLE SYSTEM ====================\n        const particles = [];\n        \n        function createParticles(x, y, count, color) {\n            for (let i = 0; i < count; i++) {\n                particles.push({\n                    x: x,\n                    y: y,\n                    vx: (Math.random() - 0.5) * 8,\n                    vy: -Math.random() * 6 - 2,\n                    life: 1,\n                    color: color,\n                    size: Math.random() * 6 + 2\n                });\n            }\n        }\n        \n        function updateParticles(dt) {\n            for (let i = particles.length - 1; i >= 0; i--) {\n                const p = particles[i];\n                p.x += p.vx;\n                p.y += p.vy;\n                p.vy += 0.3;\n                p.life -= dt * 2;\n                if (p.life <= 0) {\n                    particles.splice(i, 1);\n                }\n            }\n        }\n        \n        function renderParticles(ctx) {\n            particles.forEach(p => {\n                ctx.globalAlpha = p.life;\n                ctx.fillStyle = p.color;\n                ctx.beginPath();\n                ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);\n                ctx.fill();\n                ctx.globalAlpha = 1;\n            });\n        }\n\n        // ==================== CANVAS SETUP ====================\n        const canvas = document.getElementById('game-canvas');\n        const ctx = canvas.getContext('2d');\n        \n        function resizeCanvas() {\n            const container = document.getElementById('game-container');\n            const rect = container.getBoundingClientRect();\n            canvas.width = rect.width;\n            canvas.height = rect.height;\n        }\n        \n        window.addEventListener('resize', resizeCanvas);\n        resizeCanvas();\n\n        // ==================== UI MANAGEMENT ====================\n        function showScreen(screenId) {\n            document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));\n            const screen = document.getElementById(screenId + '-screen');\n            if (screen) screen.classList.add('active');\n            state.currentScreen = screenId;\n            \n            // Show/hide game UI\n            const hud = document.getElementById('hud');\n            const palette = document.getElementById('palette');\n            const objectives = document.getElementById('objectives');\n            const stabilityBar = document.getElementById('stability-bar');\n            const controlsHint = document.getElementById('controls-hint');\n            const highScore = document.getElementById('high-score');\n            \n            if (screenId === 'game') {\n                hud.classList.add('active');\n                palette.classList.add('active');\n                objectives.classList.add('active');\n                stabilityBar.classList.add('active');\n                controlsHint.classList.add('active');\n            } else {\n                hud.classList.remove('active');\n                palette.classList.remove('active');\n                objectives.classList.remove('active');\n                stabilityBar.classList.remove('active');\n                controlsHint.classList.remove('active');\n                highScore.style.display = 'none';\n            }\n        }\n        \n        function updatePaletteUI() {\n            const container = document.getElementById('palette-items');\n            container.innerHTML = '';\n            \n            const blockOrder = ['square', 'domino', 'tBlock', 'lBlock', 'long'];\n            blockOrder.forEach((type, index) => {\n                if (!state.palette[type]) return;\n                \n                const count = state.palette[type];\n                const item = document.createElement('div');\n                item.className = 'palette-item' + (count === 0 ? ' depleted' : '') + \n                                (state.selectedBlockType === type ? ' selected' : '');\n                item.dataset.type = type;\n                \n                const blockDiv = document.createElement('div');\n                blockDiv.className = 'palette-block';\n                \n                const cells = BLOCK_TYPES[type].cells;\n                const maxX = Math.max(...cells.map(c => c[0])) + 1;\n                const maxY = Math.max(...cells.map(c => c[1])) + 1;\n                blockDiv.style.gridTemplateColumns = `repeat(${maxX}, 1fr)`;\n                blockDiv.style.gridTemplateRows = `repeat(${maxY}, 1fr)`;\n                \n                cells.forEach(cell => {\n                    const cellDiv = document.createElement('div');\n                    cellDiv.style.background = CONFIG.COLORS.blockFill;\n                    cellDiv.style.borderRadius = '2px';\n                    blockDiv.appendChild(cellDiv);\n                });\n                \n                item.appendChild(blockDiv);\n                \n                const countSpan = document.createElement('span');
                countSpan.className = 'palette-count';
                countSpan.textContent = `×${count}`;
                item.appendChild(countSpan);
                
                item.addEventListener('click', () => {
                    if (count > 0) {
                        state.selectedBlockType = type;
                        AudioSystem.play('select');
                        updatePaletteUI();
                    }
                });
                
                container.appendChild(item);
            });
        }
        
        function updateObjectivesUI() {
            const level = LEVELS[state.currentLevel];
            const currentHeight = calculateTowerHeight();
            
            document.getElementById('target-height').textContent = level.target;
            document.getElementById('current-height').textContent = currentHeight;
            
            const progress = Math.min(100, (currentHeight / level.target) * 100);
            document.getElementById('progress-fill').style.width = `${progress}%`;
        }
        
        function updateStabilityUI() {
            const stability = calculateStability();
            document.getElementById('stab-fill').style.width = `${stability}%`;
            
            let status = 'STABLE';
            let color = CONFIG.COLORS.validGhost;
            
            if (stability < 30) {
                status = 'UNSTABLE!';
                color = CONFIG.COLORS.invalidGhost;
            } else if (stability < 60) {
                status = 'TILTING';
                color = CONFIG.COLORS.accent;
            }
            
            document.getElementById('stab-status').textContent = status;
            document.getElementById('stab-status').style.color = color;
            document.getElementById('stab-fill').style.background = color;
        }
        
        function updateTimerUI() {
            const elapsed = state.paused ? state.elapsedTime : 
                           (Date.now() - state.startTime + state.elapsedTime);
            
            const totalSeconds = Math.floor(elapsed / 1000);
            const minutes = Math.floor(totalSeconds / 60);
            const seconds = totalSeconds % 60;
            const tenths = Math.floor((elapsed % 1000) / 100);
            
            document.getElementById('timer').textContent = 
                `${String(minutes).padStart(2, '0')}:${String(seconds).padStart(2, '0')}.${tenths}`;
        }
        
        function updateLevelSelectUI() {
            const grid = document.getElementById('level-grid');
            grid.innerHTML = '';
            
            LEVELS.forEach((level, index) => {
                const btn = document.createElement('button');
                btn.className = 'level-btn';
                
                const stars = state.levelStars[index];
                const unlocked = index === 0 || state.levelStars[index - 1] > 0;
                
                if (!unlocked) {
                    btn.classList.add('locked');
                } else if (stars > 0) {
                    btn.classList.add('completed');
                }
                
                btn.textContent = index + 1;
                
                if (stars > 0) {
                    const starsDisplay = document.createElement('div');
                    starsDisplay.className = 'stars-display';
                    starsDisplay.textContent = '⭐'.repeat(stars);
                    btn.appendChild(starsDisplay);
                }
                
                if (unlocked) {
                    btn.addEventListener('click', () => {
                        startLevel(index);
                    });
                }
                
                grid.appendChild(btn);
            });
        }
        
        function updateTotalStarsUI() {
            const total = state.levelStars.reduce((a, b) => a + b, 0);
            document.getElementById('total-stars').textContent = total;
        }
        
        function updateStarsHUD() {
            const level = LEVELS[state.currentLevel];
            const blocksUsed = state.placedBlocks.length;
            const optimal = Math.ceil(level.target / 2);
            
            let stars = 1;
            if (blocksUsed <= optimal) stars = 3;
            else if (blocksUsed <= optimal + 2) stars = 2;
            
            document.getElementById('stars-hud').textContent = `⭐ ${stars}/3`;
        }
        
        function updateHighScoreUI() {
            const highScoreEl = document.getElementById('high-score');
            const timeSpan = document.getElementById('high-score-time');
            
            if (state.levelStars[state.currentLevel] > 0) {
                highScoreEl.style.display = 'block';
                const bestTime = getHighScore(state.currentLevel);
                if (bestTime !== null) {
                    const totalSeconds = Math.floor(bestTime / 1000);
                    const minutes = Math.floor(totalSeconds / 60);
                    const seconds = totalSeconds % 60;
                    timeSpan.textContent = `${String(minutes).padStart(2, '0')}:${String(seconds).padStart(2, '0')}`;
                }
            }
        }

        // ==================== GAME LOGIC ====================\n        function calculateTowerHeight() {\n            if (state.placedBlocks.length === 0) return 0;\n            \n            let maxHeight = 0;\n            state.placedBlocks.forEach(block => {\n                block.cells.forEach(cell => {\n                    const height = cell.y + 1;\n                    if (height > maxHeight) maxHeight = height;\n                });\n            });\n            \n            return maxHeight;\n        }\n        \n        function calculateStability() {\n            if (state.placedBlocks.length === 0) return 100;\n            \n            // Simple stability based on tower width vs height\n            const height = calculateTowerHeight();\n            const occupiedCells = new Set();\n            \n            state.placedBlocks.forEach(block => {\n                block.cells.forEach(cell => {\n                    occupiedCells.add(`${cell.x},${cell.y}`);\n                });\n            });\n            \n            const uniqueCells = occupiedCells.size;\n            const width = Math.max(...[...occupiedCells].map(c => parseInt(c.split(',')[0]))) + 1;\n            \n            // Wider base = more stable\n            const stability = Math.min(100, (width / height) * 50 + (uniqueCells / (height * width)) * 50);\n            \n            return Math.max(0, Math.min(100, stability));\n        }\n        \n        function checkVictory() {\n            const level = LEVELS[state.currentLevel];\n            const currentHeight = calculateTowerHeight();\n            \n            if (currentHeight >= level.target) {\n                return true;\n            }\n            return false;\n        }\n        \n        function calculateStars() {\n            const level = LEVELS[state.currentLevel];\n            const blocksUsed = state.placedBlocks.length;\n            const optimal = Math.ceil(level.target / 2);\n            \n            if (blocksUsed <= optimal) return 3;\n            if (blocksUsed <= optimal + 2) return 2;\n            return 1;\n        }
        
        function getHighScore(level) {
            const key = `blocktower_highscore_${level}`;
            const stored = localStorage.getItem(key);
            return stored ? parseInt(stored) : null;
        }
        
        function setHighScore(level, time) {
            const key = `blocktower_highscore_${level}`;
            const current = getHighScore(level);
            if (!current || time < current) {
                localStorage.setItem(key, time.toString());
            }
        }
        
        function saveProgress() {\n            localStorage.setItem('blocktower_progress', JSON.stringify(state.levelStars));\n        }
        
        function loadProgress() {
            const stored = localStorage.getItem('blocktower_progress');
            if (stored) {
                state.levelStars = JSON.parse(stored);\n                state.starsEarned = [...state.levelStars];\n            }\n        }

        // ==================== GAME ACTIONS ====================\n        function startLevel(levelIndex) {\n            state.currentLevel = levelIndex;\n            state.placedBlocks = [];\n            state.selectedBlockType = null;\n            state.palette = { ...LEVELS[levelIndex].blocks };\n            state.history = [];\n            state.gameStarted = true;\n            state.startTime = Date.now();\n            state.elapsedTime = 0;\n            state.paused = false;\n            \n            showScreen('game');\n            updatePaletteUI();\n            updateObjectivesUI();\n            updateStabilityUI();\n            updateStarsHUD();\n            updateHighScoreUI();\n            updateLevelInfo();\n        }
        
        function updateLevelInfo() {\n            document.getElementById('level-info').textContent = \n                `LEVEL ${state.currentLevel + 1}`;\n        }
        
        function placeBlock(gridX, gridY) {\n            if (!state.selectedBlockType || !state.isValidPlacement) return;\n            \n            // Save state for undo\n            state.history.push({\n                blocks: JSON.parse(JSON.stringify(state.placedBlocks)),\n                palette: { ...state.palette },\n                selectedType: state.selectedBlockType\n            });\n            \n            const blockType = BLOCK_TYPES[state.selectedBlockType];\n            const cells = blockType.cells.map(cell => ({\n                x: cell[0] + gridX,\n                y: cell[1] + gridY\n            }));\n            \n            state.placedBlocks.push({\n                type: state.selectedBlockType,\n                cells: cells,\n                color: blockType.color\n            });\n            \n            state.palette[state.selectedBlockType]--;\n            \n            // Create particles\n            const centerX = CONFIG.GRID_OFFSET_X + (gridX + 1) * CONFIG.CELL_SIZE;\n            const centerY = CONFIG.GRID_OFFSET_Y + (gridY + 1) * CONFIG.CELL_SIZE;\n            createParticles(centerX, centerY, 10, CONFIG.COLORS.accent);\n            \n            AudioSystem.play('place');\n            \n            updatePaletteUI();\n            updateObjectivesUI();\n            updateStabilityUI();\n            updateStarsHUD();\n            \n            // Check victory\n            if (checkVictory()) {\n                setTimeout(() => showVictory(), 500);\n            }\n        }
        
        function undoLastBlock() {\n            if (state.history.length === 0) return;\n            \n            const prev = state.history.pop();\n            state.placedBlocks = prev.blocks;\n            state.palette = prev.palette;\n            state.selectedBlockType = prev.selectedType;\n            \n            updatePaletteUI();\n            updateObjectivesUI();\n            updateStabilityUI();\n            updateStarsHUD();\n        }
        
        function restartLevel() {\n            startLevel(state.currentLevel);\n        }
        
        function showVictory() {\n            state.paused = true;\n            const elapsed = Date.now() - state.startTime + state.elapsedTime;\n            state.elapsedTime = elapsed;\n            \n            const stars = calculateStars();\n            state.levelStars[state.currentLevel] = Math.max(state.levelStars[state.currentLevel], stars);\n            saveProgress();\n            \n            setHighScore(state.currentLevel, elapsed);\n            \n            const victoryStars = document.getElementById('victory-stars');\n            victoryStars.textContent = '⭐'.repeat(stars) + (stars < 3 ? '☆'.repeat(3 - stars) : '');\n            \n            const totalSeconds = Math.floor(elapsed / 1000);\n            const minutes = Math.floor(totalSeconds / 60);\n            const seconds = totalSeconds % 60;\n            document.getElementById('victory-time').textContent = \n                `${String(minutes).padStart(2, '0')}:${String(seconds).padStart(2, '0')}`;\n            \n            const blocksUsed = state.placedBlocks.length;\n            const level = LEVELS[state.currentLevel];\n            document.getElementById('victory-stats').textContent = \n                `Blocks: ${blocksUsed} | Target: ${level.target} | Height: ${calculateTowerHeight()}`;\n            \n            AudioSystem.play('victory');\n            \n            // Show/hide next level button\n            const nextBtn = document.getElementById('next-level-btn');\n            if (state.currentLevel >= LEVELS.length - 1) {\n                nextBtn.style.display = 'none';\n            } else {\n                nextBtn.style.display = 'block';\n            }\n            \n            showScreen('victory');\n            updateTotalStarsUI();\n        }

        // ==================== INPUT HANDLING ====================\n        function getGridPosition(clientX, clientY) {\n            const rect = canvas.getBoundingClientRect();\n            const x = clientX - rect.left;\n            const y = clientY - rect.top;\n            \n            const gridX = Math.floor((x - CONFIG.GRID_OFFSET_X) / CONFIG.CELL_SIZE);\n            const gridY = Math.floor((y - CONFIG.GRID_OFFSET_Y) / CONFIG.CELL_SIZE);\n            \n            return { gridX, gridY };\n        }
        
        function isValidPlacement(gridX, gridY) {\n            if (!state.selectedBlockType) return false;\n            \n            const blockType = BLOCK_TYPES[state.selectedBlockType];\n            const cells = blockType.cells;\n            \n            for (const cell of cells) {\n                const x = cell[0] + gridX;\n                const y = cell[1] + gridY;\n                \n                // Check bounds\n                if (x < 0 || x >= CONFIG.GRID_COLS || y < 0) {\n                    return false;\n                }\n                \n                // Check collision with existing blocks\n                for (const block of state.placedBlocks) {\n                    for (const existingCell of block.cells) {\n                        if (existingCell.x === x && existingCell.y === y) {\n                            return false;\n                        }\n                    }\n                }\n            }\n            \n            // Must be on ground or on top of another block\n            let onGround = false;\n            let onBlock = false;\n            \n            for (const cell of cells) {\n                const x = cell[0] + gridX;\n                const y = cell[1] + gridY;\n                \n                if (y === 0) {\n                    onGround = true;\n                }\n                \n                // Check if there's a block directly below\n                if (y > 0) {\n                    for (const block of state.placedBlocks) {\n                        for (const existingCell of block.cells) {\n                            if (existingCell.x === x && existingCell.y === y - 1) {\n                                onBlock = true;\n                            }\n                        }\n                    }\n                }\n            }\n            \n            return onGround || onBlock;\n        }
        
        canvas.addEventListener('mousemove', (e) => {\n            if (state.currentScreen !== 'game') return;\n            \n            const { gridX, gridY } = getGridPosition(e.clientX, e.clientY);\n            state.ghostPosition = { gridX, gridY };\n            state.isValidPlacement = isValidPlacement(gridX, gridY);\n        });
        
        canvas.addEventListener('click', (e) => {\n            if (state.currentScreen !== 'game' || state.paused) return;\n            \n            const { gridX, gridY } = getGridPosition(e.clientX, e.clientY);\n            \n            if (state.selectedBlockType && isValidPlacement(gridX, gridY)) {\n                placeBlock(gridX, gridY);\n            } else if (state.selectedBlockType) {\n                AudioSystem.play('error');\n            }\n        });
        
        canvas.addEventListener('contextmenu', (e) => {\n            e.preventDefault();\n            state.selectedBlockType = null;\n            updatePaletteUI();\n        });
        
        document.addEventListener('keydown', (e) => {\n            if (state.currentScreen === 'game' && !state.paused) {\n                if (e.key === 'Escape') {\n                    state.selectedBlockType = null;\n                    updatePaletteUI();\n                } else if (e.key === 'r' || e.key === 'R') {\n                    restartLevel();\n                } else if (e.key >= '1' && e.key <= '5') {\n                    const types = ['square', 'domino', 'tBlock', 'lBlock', 'long'];\n                    const type = types[parseInt(e.key) - 1];\n                    if (state.palette[type] && state.palette[type] > 0) {\n                        state.selectedBlockType = type;\n                        AudioSystem.play('select');\n                        updatePaletteUI();\n                    }\n                } else if (e.key === 'z' && (e.ctrlKey || e.metaKey)) {\n                    undoLastBlock();\n                }\n            }\n        });

        // ==================== RENDERING ====================\n        function render() {\n            ctx.fillStyle = CONFIG.COLORS.bgPrimary;\n            ctx.fillRect(0, 0, canvas.width, canvas.height);\n            \n            if (state.currentScreen === 'game') {\n                drawGrid();\n                drawPlacedBlocks();\n                \n                if (state.selectedBlockType && state.ghostPosition) {\n                    drawGhostBlock();\n                }\n                \n                renderParticles(ctx);\n            }\n        }\n        \n        function drawGrid() {\n            const startY = CONFIG.GRID_OFFSET_Y;\n            const gridHeight = 20 * CONFIG.CELL_SIZE;\n            \n            // Draw background grid area\n            ctx.fillStyle = CONFIG.COLORS.bgSecondary;\n            ctx.fillRect(\n                CONFIG.GRID_OFFSET_X - 10,\n                startY - 10,\n                CONFIG.GRID_COLS * CONFIG.CELL_SIZE + 20,\n                gridHeight + 20\n            );\n            \n            // Draw grid lines\n            ctx.strokeStyle = CONFIG.COLORS.gridLine;\n            ctx.lineWidth = 1;\n            \n            for (let col = 0; col <= CONFIG.GRID_COLS; col++) {\n                const x = CONFIG.GRID_OFFSET_X + col * CONFIG.CELL_SIZE;\n                ctx.beginPath();\n                ctx.moveTo(x, startY);\n                ctx.lineTo(x, startY + gridHeight);\n                ctx.stroke();\n            }\n            \n            for (let row = 0; row <= 20; row++) {\n                const y = startY + row * CONFIG.CELL_SIZE;\n                ctx.beginPath();\n                ctx.moveTo(CONFIG.GRID_OFFSET_X, y);\n                ctx.lineTo(CONFIG.GRID_OFFSET_X + CONFIG.GRID_COLS * CONFIG.CELL_SIZE, y);\n                ctx.stroke();\n            }\n            \n            // Draw ground\n            ctx.fillStyle = CONFIG.COLORS.ground;\n            ctx.fillRect(\n                CONFIG.GRID_OFFSET_X - 10,\n                startY + 20 * CONFIG.CELL_SIZE,\n                CONFIG.GRID_COLS * CONFIG.CELL_SIZE + 20,\n                50\n            );\n            \n            // Draw height markers\n            ctx.fillStyle = CONFIG.COLORS.textSecondary;\n            ctx.font = '12px monospace';\n            for (let row = 1; row <= 20; row += 2) {\n                ctx.fillText(\n                    row.toString(),\n                    CONFIG.GRID_OFFSET_X - 30,\n                    startY + row * CONFIG.CELL_SIZE - CONFIG.CELL_SIZE / 2 + 4\n                );\n            }\n            \n            // Draw target line\n            const level = LEVELS[state.currentLevel];\n            const targetY = startY + (20 - level.target) * CONFIG.CELL_SIZE;\n            \n            ctx.strokeStyle = CONFIG.COLORS.accent;\n            ctx.lineWidth = 2;\n            ctx.setLineDash([5, 5]);\n            ctx.beginPath();\n            ctx.moveTo(CONFIG.GRID_OFFSET_X, targetY);\n            ctx.lineTo(CONFIG.GRID_OFFSET_X + CONFIG.GRID_COLS * CONFIG.CELL_SIZE, targetY);\n            ctx.stroke();\n            ctx.setLineDash([]);\n            \n            // Target label\n            ctx.fillStyle = CONFIG.COLORS.accent;\n            ctx.font = 'bold 14px sans-serif';\n            ctx.fillText(\n                `TARGET: ${level.target}`,\n                CONFIG.GRID_OFFSET_X,\n                targetY - 5\n            );\n        }
        
        function drawPlacedBlocks() {\n            state.placedBlocks.forEach(block => {\n                block.cells.forEach(cell => {\n                    const x = CONFIG.GRID_OFFSET_X + cell.x * CONFIG.CELL_SIZE;\n                    const y = CONFIG.GRID_OFFSET_Y + (19 - cell.y) * CONFIG.CELL_SIZE;\n                    \n                    // Block body\n                    ctx.fillStyle = block.color;\n                    ctx.fillRect(\n                        x + 2,\n                        y + 2,\n                        CONFIG.CELL_SIZE - 4,\n                        CONFIG.CELL_SIZE - 4\n                    );\n                    \n                    // Block highlight\n                    ctx.fillStyle = 'rgba(255, 255, 255, 0.2)';\n                    ctx.fillRect(\n                        x + 2,\n                        y + 2,\n                        CONFIG.CELL_SIZE - 4,\n                        8\n                    );\n                    \n                    // Block shadow\n                    ctx.fillStyle = 'rgba(0, 0, 0, 0.2)';\n                    ctx.fillRect(\n                        x + 2,\n                        y + CONFIG.CELL_SIZE - 10,\n                        CONFIG.CELL_SIZE - 4,\n                        8\n                    );\n                    \n                    // Block stroke\n                    ctx.strokeStyle = CONFIG.COLORS.blockStroke;\n                    ctx.lineWidth = 2;\n                    ctx.strokeRect(\n                        x + 2,\n                        y + 2,\n                        CONFIG.CELL_SIZE - 4,\n                        CONFIG.CELL_SIZE - 4\n                    );\n                });\n            });\n        }
        
        function drawGhostBlock() {\n            const blockType = BLOCK_TYPES[state.selectedBlockType];\n            const color = state.isValidPlacement ? \n                CONFIG.COLORS.validGhost : CONFIG.COLORS.invalidGhost;\n            \n            blockType.cells.forEach(cell => {\n                const x = CONFIG.GRID_OFFSET_X + (cell[0] + state.ghostPosition.gridX) * CONFIG.CELL_SIZE;\n                const y = CONFIG.GRID_OFFSET_Y + (19 - (cell[1] + state.ghostPosition.gridY)) * CONFIG.CELL_SIZE;\n                \n                ctx.fillStyle = color;\n                ctx.globalAlpha = 0.5;\n                ctx.fillRect(\n                    x + 2,\n                    y + 2,\n                    CONFIG.CELL_SIZE - 4,\n                    CONFIG.CELL_SIZE - 4\n                );\n                ctx.globalAlpha = 1;\n                \n                ctx.strokeStyle = color;\n                ctx.lineWidth = 2;\n                ctx.setLineDash([5, 5]);\n                ctx.strokeRect(\n                    x + 2,\n                    y + 2,\n                    CONFIG.CELL_SIZE - 4,\n                    CONFIG.CELL_SIZE - 4\n                );\n                ctx.setLineDash([]);\n            });\n        }

        // ==================== GAME LOOP ====================\n        let lastTime = 0;\n        \n        function gameLoop(timestamp) {\n            const dt = (timestamp - lastTime) / 1000;\n            lastTime = timestamp;\n            \n            updateParticles(dt);\n            render();\n            \n            if (state.currentScreen === 'game' && !state.paused) {\n                updateTimerUI();\n            }\n            \n            requestAnimationFrame(gameLoop);\n        }

        // ==================== EVENT LISTENERS ====================\n        document.getElementById('play-btn').addEventListener('click', () => {\n            AudioSystem.init();\n            updateLevelSelectUI();\n            showScreen('level-select');\n        });\n        \n        document.getElementById('how-to-play-btn').addEventListener('click', () => {\n            showScreen('how-to-play');\n        });\n        \n        document.getElementById('back-from-help-btn').addEventListener('click', () => {\n            showScreen('title');\n        });\n        \n        document.getElementById('back-btn').addEventListener('click', () => {\n            showScreen('title');\n        });\n        \n        document.getElementById('undo-btn').addEventListener('click', undoLastBlock);\n        document.getElementById('restart-btn').addEventListener('click', restartLevel);\n        \n        document.getElementById('menu-btn').addEventListener('click', () => {\n            state.paused = true;\n            state.elapsedTime = Date.now() - state.startTime + state.elapsedTime;\n            showScreen('pause');\n        });\n        \n        document.getElementById('resume-btn').addEventListener('click', () => {\n            state.paused = false;\n            state.startTime = Date.now();\n            showScreen('game');\n        });\n        \n        document.getElementById('restart-pause-btn').addEventListener('click', () => {\n            restartLevel();\n        });\n        \n        document.getElementById('level-select-pause-btn').addEventListener('click', () => {\n            updateLevelSelectUI();\n            showScreen('level-select');\n        });\n        \n        document.getElementById('next-level-btn').addEventListener('click', () => {\n            if (state.currentLevel < LEVELS.length - 1) {\n                startLevel(state.currentLevel + 1);\n            } else {\n                showScreen('complete');\n            }\n        });\n        \n        document.getElementById('replay-btn').addEventListener('click', restartLevel);\n        \n        document.getElementById('level-select-victory-btn').addEventListener('click', () => {\n            updateLevelSelectUI();\n            showScreen('level-select');\n        });\n        \n        document.getElementById('play-again-btn').addEventListener('click', () => {\n            state.currentLevel = 0;\n            startLevel(0);\n        });\n        \n        document.getElementById('level-select-complete-btn').addEventListener('click', () => {\n            updateLevelSelectUI();\n            showScreen('level-select');\n        });

        // ==================== INITIALIZATION ====================\n        loadProgress();\n        updateTotalStarsUI();\n        showScreen('title');\n        requestAnimationFrame(gameLoop);\n    </script>\n</body>\n</html>