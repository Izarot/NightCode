                oscillator.type = 'sawtooth';
                gainNode.gain.setValueAtTime(0.1, audioContext.currentTime);
                gainNode.gain.exponentialRampToValueAtTime(0.01, audioContext.currentTime + 0.3);
                oscillator.start();
                oscillator.stop(audioContext.currentTime + 0.3);
            } else if (type === 'rotate') {
                oscillator.frequency.value = 800;
                gainNode.gain.setValueAtTime(0.05, audioContext.currentTime);
                gainNode.gain.exponentialRampToValueAtTime(0.01, audioContext.currentTime + 0.05);
                oscillator.start();
                oscillator.stop(audioContext.currentTime + 0.05);
            }
        }

        function createParticle(x, y, color) {
            particles.push({
                x, y,
                vx: (Math.random() - 0.5) * 4,
                vy: (Math.random() - 0.5) * 4,
                life: 1,
                color: color,
                size: Math.random() * 4 + 2
            });
        }

        function updateParticles() {
            for (let i = particles.length - 1; i >= 0; i--) {
                const p = particles[i];
                p.x += p.vx;
                p.y += p.vy;
                p.life -= 0.02;
                if (p.life <= 0) {
                    particles.splice(i, 1);
                }
            }
        }

        function drawParticles() {
            particles.forEach(p => {
                ctx.beginPath();
                ctx.arc(p.x, p.y, p.size * p.life, 0, Math.PI * 2);
                ctx.fillStyle = p.color;
                ctx.globalAlpha = p.life;
                ctx.fill();
                ctx.globalAlpha = 1;
            });
        }

        function addPulseAnimation(x, y, color) {
            pulseAnimations.push({
                x, y,
                radius: 0,
                maxRadius: 40,
                color: color,
                life: 1
            });
        }

        function updatePulseAnimations() {
            for (let i = pulseAnimations.length - 1; i >= 0; i--) {
                const p = pulseAnimations[i];
                p.radius += 2;
                p.life -= 0.03;
                if (p.life <= 0) {
                    pulseAnimations.splice(i, 1);
                }
            }
        }

        function drawPulseAnimations() {
            pulseAnimations.forEach(p => {
                ctx.beginPath();
                ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
                ctx.strokeStyle = p.color;
                ctx.lineWidth = 3 * p.life;
                ctx.globalAlpha = p.life;
                ctx.stroke();
                ctx.globalAlpha = 1;
            });
        }

        function initGame() {
            canvas = document.getElementById('gameCanvas');
            ctx = canvas.getContext('2d');
            
            loadProgress();
            loadLevel(gameState.currentLevel);
            
            setupEventListeners();
            setupUI();
            
            requestAnimationFrame(gameLoop);
        }

        function loadProgress() {
            try {
                const saved = localStorage.getItem('circuitLogicProgress');
                if (saved) {
                    const data = JSON.parse(saved);
                    gameState.bestTimes = data.bestTimes || {};
                    gameState.levelStars = data.levelStars || {};
                    gameState.completedLevels = new Set(data.completedLevels || []);
                }
            } catch (e) {
                console.log('Could not load progress');
            }
        }

        function saveProgress() {
            try {
                localStorage.setItem('circuitLogicProgress', JSON.stringify({
                    bestTimes: gameState.bestTimes,
                    levelStars: gameState.levelStars,
                    completedLevels: Array.from(gameState.completedLevels)
                }));
            } catch (e) {
                console.log('Could not save progress');
            }
        }

        function loadLevel(levelIndex) {
            const level = LEVELS[levelIndex];
            
            canvas.width = level.gridWidth * CELL_SIZE;
            canvas.height = level.gridHeight * CELL_SIZE;
            
            gameState.board = [];
            for (let y = 0; y < level.gridHeight; y++) {
                gameState.board[y] = [];
                for (let x = 0; x < level.gridWidth; x++) {
                    gameState.board[y][x] = null;
                }
            }
            
            level.blocked.forEach(b => {
                gameState.board[b.y][b.x] = { type: 'blocked' };
            });
            
            gameState.inventory = { ...level.inventory };
            gameState.inputs = JSON.parse(JSON.stringify(level.inputs));
            gameState.simulationResult = null;
            gameState.isSimulating = false;
            gameState.startTime = Date.now();
            gameState.elapsedTime = 0;
            
            Object.values(gameState.inputs).forEach(input => {
                input.active = true;
            });
            
            updateUI();
            updateInventoryUI();
            updateHighScore();
        }

        function setupEventListeners() {
            canvas.addEventListener('mousedown', handleMouseDown);
            canvas.addEventListener('mousemove', handleMouseMove);
            canvas.addEventListener('mouseup', handleMouseUp);
            canvas.addEventListener('mouseleave', handleMouseUp);
            canvas.addEventListener('contextmenu', e => e.preventDefault());
            
            canvas.addEventListener('touchstart', handleTouchStart, { passive: false });
            canvas.addEventListener('touchmove', handleTouchMove, { passive: false });
            canvas.addEventListener('touchend', handleTouchEnd, { passive: false });
            
            document.addEventListener('keydown', handleKeyDown);
        }

        function handleTouchStart(e) {
            e.preventDefault();
            const touch = e.touches[0];
            const rect = canvas.getBoundingClientRect();
            const x = touch.clientX - rect.left;
            const y = touch.clientY - rect.top;
            
            initAudio();
            
            if (touch.touches.length === 2) {
                const touch2 = e.touches[1];
                const x2 = touch2.clientX - rect.left;
                const y2 = touch2.clientY - rect.top;
                const centerX = (x + x2) / 2;
                const centerY = (y + y2) / 2;
                handleClick(centerX, centerY, true);
            } else {
                handleMouseDown({ offsetX: x, offsetY: y, button: 0 });
            }
        }

        function handleTouchMove(e) {
            e.preventDefault();
            if (gameState.dragState && gameState.dragState.type === 'inventory') {
                const touch = e.touches[0];
                const rect = canvas.getBoundingClientRect();
                const x = touch.clientX - rect.left;
                const y = touch.clientY - rect.top;
                handleMouseMove({ offsetX: x, offsetY: y });
            }
        }

        function handleTouchEnd(e) {
            e.preventDefault();
            handleMouseUp({});
        }

        function handleKeyDown(e) {
            if (e.key === 'r' || e.key === 'R') {
                const rect = canvas.getBoundingClientRect();
                const x = gameState.dragState?.x ?? rect.width / 2;
                const y = gameState.dragState?.y ?? rect.height / 2;
                rotateComponentAt(x, y);
            }
        }

        function handleMouseDown(e) {
            initAudio();
            
            const rect = canvas.getBoundingClientRect();
            const x = e.offsetX;
            const y = e.offsetY;
            const gridX = Math.floor(x / CELL_SIZE);
            const gridY = Math.floor(y / CELL_SIZE);
            
            if (e.button === 2 || e.ctrlKey) {
                rotateComponentAt(x, y);
                return;
            }
            
            if (checkInputClick(gridX, gridY)) {
                return;
            }
            
            const cell = gameState.board[gridY]?.[gridX];
            if (cell && cell.type !== 'blocked') {
                gameState.dragState = {
                    type: 'placed',
                    gridX: gridX,
                    gridY: gridY,
                    component: cell,
                    startX: gridX,
                    startY: gridY
                };
                playSound('click');
                return;
            }
            
            if (gameState.inventory[getInventoryItemAt(x, y)] > 0) {
                gameState.dragState = {
                    type: 'inventory',
                    itemType: getInventoryItemAt(x, y),
                    offsetX: x % CELL_SIZE,
                    offsetY: y % CELL_SIZE,
                    x: x,
                    y: y
                };
                playSound('click');
            }
        }

        function handleMouseMove(e) {
            if (!gameState.dragState) return;
            
            const rect = canvas.getBoundingClientRect();
            const x = e.offsetX;
            const y = e.offsetY;
            
            if (gameState.dragState.type === 'inventory') {
                gameState.dragState.x = x;
                gameState.dragState.y = y;
            } else if (gameState.dragState.type === 'placed') {
                const gridX = Math.floor(x / CELL_SIZE);
                const gridY = Math.floor(y / CELL_SIZE);
                
                if (gridX >= 0 && gridX < LEVELS[gameState.currentLevel].gridWidth &&
                    gridY >= 0 && gridY < LEVELS[gameState.currentLevel].gridHeight) {
                    
                    const targetCell = gameState.board[gridY]?.[gridX];
                    if (!targetCell || targetCell.type === 'blocked') {
                        gameState.board[gameState.dragState.gridY][gameState.dragState.gridX] = null;
                        gameState.board[gridY][gridX] = gameState.dragState.component;
                        gameState.dragState.gridX = gridX;
                        gameState.dragState.gridY = gridY;
                    }
                }
            }
        }

        function handleMouseUp(e) {
            if (!gameState.dragState) return;
            
            if (gameState.dragState.type === 'inventory') {
                const rect = canvas.getBoundingClientRect();
                const x = e.offsetX ?? gameState.dragState.x;
                const y = e.offsetY ?? gameState.dragState.y;
                const gridX = Math.floor(x / CELL_SIZE);
                const gridY = Math.floor(y / CELL_SIZE);
                
                if (gridX >= 0 && gridX < LEVELS[gameState.currentLevel].gridWidth &&
                    gridY >= 0 && gridY < LEVELS[gameState.currentLevel].gridHeight) {
                    
                    const cell = gameState.board[gridY]?.[gridX];
                    if (!cell || cell.type === 'blocked') {
                        placeComponent(gridX, gridY, gameState.dragState.itemType);
                    }
                }
            }
            
            gameState.dragState = null;
        }

        function handleClick(x, y, isLongPress = false) {
            const gridX = Math.floor(x / CELL_SIZE);
            const gridY = Math.floor(y / CELL_SIZE);
            
            if (checkInputClick(gridX, gridY)) {
                return;
            }
            
            if (isLongPress) {
                rotateComponentAt(x, y);
            }
        }

        function rotateComponentAt(x, y) {
            const gridX = Math.floor(x / CELL_SIZE);
            const gridY = Math.floor(y / CELL_SIZE);
            const cell = gameState.board[gridY]?.[gridX];
            
            if (cell && cell.type !== 'blocked' && !isInputAt(gridX, gridY)) {
                cell.rotation = ((cell.rotation || 0) + 90) % 360;
                playSound('rotate');
            }
        }

        function checkInputClick(gridX, gridY) {
            for (const key in gameState.inputs) {
                const input = gameState.inputs[key];
                if (input.x === gridX && input.y === gridY) {
                    input.active = !input.active;
                    playSound('click');
                    return true;
                }
            }
            return false;
        }

        function isInputAt(x, y) {
            for (const key in gameState.inputs) {
                const input = gameState.inputs[key];
                if (input.x === x && input.y === y) {
                    return true;
                }
            }
            return false;
        }

        function isOutputAt(x, y) {
            const level = LEVELS[gameState.currentLevel];
            for (const key in level.outputs) {
                const output = level.outputs[key];
                if (output.x === x && output.y === y) {
                    return true;
                }
            }
            return false;
        }

        function getInventoryItemAt(x, y) {
            const inventoryItems = document.querySelectorAll('.inventory-item');
            const panelRect = document.getElementById('inventoryList').getBoundingClientRect();
            
            for (const item of inventoryItems) {
                const rect = item.getBoundingClientRect();
                if (x >= rect.left && x <= rect.right && y >= rect.top && y <= rect.bottom) {
                    return item.dataset.type;
                }
            }
            return null;
        }

        function placeComponent(gridX, gridY, type) {
            if (gameState.inventory[type] > 0) {
                gameState.board[gridY][gridX] = {
                    type: type,
                    rotation: 0,
                    powered: false
                };
                gameState.inventory[type]--;
                playSound('click');
                updateInventoryUI();
                
                const centerX = gridX * CELL_SIZE + CELL_SIZE / 2;
                const centerY = gridY * CELL_SIZE + CELL_SIZE / 2;
                createParticle(centerX, centerY, COMPONENT_COLORS[type]);
                addPulseAnimation(centerX, centerY, COMPONENT_COLORS[type]);
            }
        }

        function removeComponent(gridX, gridY) {
            const cell = gameState.board[gridY][gridX];
            if (cell && cell.type !== 'blocked') {
                gameState.inventory[cell.type]++;
                gameState.board[gridY][gridX] = null;
                updateInventoryUI();
            }
        }

        function updateInventoryUI() {
            const list = document.getElementById('inventoryList');
            list.innerHTML = '';
            
            for (const [type, count] of Object.entries(gameState.inventory)) {
                if (count > 0 || isComponentUsedInLevel(type)) {
                    const item = document.createElement('div');
                    item.className = 'inventory-item' + (count === 0 ? ' disabled' : '');
                    item.dataset.type = type;
                    
                    const displayName = type.replace(/_/g, ' ');
                    item.innerHTML = `
                        <div class=\"item-icon\">${COMPONENT_EMOJI[type]}</div>
                        <div class=\"item-info\">
                            <div class=\"item-name\">${displayName}</div>
                            <div class=\"item-count\">${count} left</div>
                        </div>
                    `;
                    
                    if (count > 0) {
                        item.addEventListener('mousedown', e => {
                            e.preventDefault();
                            const rect = item.getBoundingClientRect();
                            gameState.dragState = {
                                type: 'inventory',
                                itemType: type,
                                offsetX: e.clientX - rect.left,
                                offsetY: e.clientY - rect.top,
                                x: e.clientX,
                                y: e.clientY
                            };
                            initAudio();
                            playSound('click');
                        });
                    }
                    
                    list.appendChild(item);
                }
            }
        }

        function isComponentUsedInLevel(type) {
            const level = LEVELS[gameState.currentLevel];
            return level.inventory[type] > 0;
        }

        function setupUI() {
            document.getElementById('testBtn').addEventListener('click', testCircuit);
            document.getElementById('resetBtn').addEventListener('click', resetLevel);
            document.getElementById('levelSelectBtn').addEventListener('click', showLevelSelect);
            document.getElementById('pauseBtn').addEventListener('click', togglePause);
            document.getElementById('replayBtn').addEventListener('click', replayLevel);
            document.getElementById('nextLevelBtn').addEventListener('click', nextLevel);
            
            document.getElementById('level-select-modal').addEventListener('click', e => {
                if (e.target.id === 'level-select-modal') {
                    hideLevelSelect();
                }
            });
        }

        function updateUI() {
            const level = LEVELS[gameState.currentLevel];
            document.getElementById('levelNumber').textContent = `Level ${level.chapter}-${level.chapterTitle === LEVELS.slice(0, gameState.currentLevel + 1).filter(l => l.chapter === level.chapter).length}`;
            document.getElementById('chapterTitle').textContent = level.chapterTitle;
            document.getElementById('goalDescription').textContent = `Goal: ${level.goal}`;
        }

        function updateHighScore() {
            const key = `level_${gameState.currentLevel}`;
            const best = gameState.bestTimes[key];
            if (best) {
                document.getElementById('highScore').textContent = formatTime(best);
            } else {
                document.getElementById('highScore').textContent = '--:--';
            }
        }

        function formatTime(ms) {
            const totalSeconds = Math.floor(ms / 1000);
            const minutes = Math.floor(totalSeconds / 60);
            const seconds = totalSeconds % 60;
            return `${minutes.toString().padStart(2, '0')}:${seconds.toString().padStart(2, '0')}`;
        }

        function formatTimeDetailed(ms) {
            const totalSeconds = ms / 1000;
            const minutes = Math.floor(totalSeconds / 60);
            const seconds = Math.floor(totalSeconds % 60);
            const centiseconds = Math.floor((ms % 1000) / 10);
            return `${minutes.toString().padStart(2, '0')}:${seconds.toString().padStart(2, '0')}.${centiseconds.toString().padStart(2, '0')}`;
        }

        function testCircuit() {
            initAudio();
            gameState.isSimulating = true;
            
            const level = LEVELS[gameState.currentLevel];
            const inputStates = {};
            
            for (const key in gameState.inputs) {
                inputStates[key] = gameState.inputs[key].active;
            }
            
            const result = simulateCircuit(inputStates, level);
            
            gameState.simulationResult = result;
            
            const statusText = document.getElementById('statusText');
            
            if (result.success) {
                statusText.textContent = 'Circuit working!';
                statusText.className = 'status-text success';
                playSound('success');
                
                for (let i = 0; i < 20; i++) {
                    setTimeout(() => {
                        const centerX = level.outputs.B.x * CELL_SIZE + CELL_SIZE / 2;
                        const centerY = level.outputs.B.y * CELL_SIZE + CELL_SIZE / 2;
                        createParticle(centerX, centerY, '#4CAF50');
                    }, i * 50);
                }
                
                showWinModal();
            } else {
                statusText.textContent = result.message;
                statusText.className = 'status-text error';
                playSound('error');
            }
        }

        function simulateCircuit(inputStates, level) {
            const powered = new Set();
            const queue = [];
            
            for (const [key, input] of Object.entries(gameState.inputs)) {
                const inputKey = `${input.x},${input.y}`;
                if (inputStates[key]) {
                    powered.add(inputKey);
                    queue.push({ x: input.x, y: input.y, direction: null, fromInput: true });
                }
            }
            
            while (queue.length > 0) {
                const current = queue.shift();
                const { x, y, direction } = current;
                
                const cell = gameState.board[y]?.[x];
                
                if (x < 0 || x >= level.gridWidth || y < 0 || y >= level.gridHeight) continue;
                
                if (cell && cell.type === 'blocked') continue;
                
                const cellKey = `${x},${y}`;
                
                if (cell && cell.type && cell.type !== 'blocked') {
                    const ports = getComponentPorts(cell);
                    
                    if (direction && !ports.includes(direction)) continue;
                    
                    if (cell.type.startsWith('wire')) {
                        powered.add(cellKey);
                        
                        for (const port of ports) {
                            const offset = DIRECTION_OFFSETS[port];
                            const nextX = x + offset.dx;
                            const nextY = y + offset.dy;
                            const nextKey = `${nextX},${nextY}`;
                            
                            if (!powered.has(nextKey) || cellKey !== nextKey) {
                                queue.push({ x: nextX, y: nextY, direction: OPPOSITE_DIR[port] });
                            }
                        }
                    } else if (['and_gate', 'or_gate', 'xor_gate', 'nand_gate'].includes(cell.type)) {
                        const inputPorts = ports.filter(p => p !== 'S');
                        const outputPort = 'S';
                        
                        let allInputsPowered = true;
                        let anyInputPowered = false;
                        
                        for (const inputPort of inputPorts) {
                            const inputCellX = x + DIRECTION_OFFSETS[inputPort].dx;
                            const inputCellY = y + DIRECTION_OFFSETS[inputPort].dy;
                            const inputKey = `${inputCellX},${inputCellY}`;
                            
                            if (powered.has(inputKey)) {
                                anyInputPowered = true;
                            } else {
                                allInputsPowered = false;
                            }
                        }
                        
                        let shouldPowerOutput = false;
                        
                        if (cell.type === 'and_gate') {
                            shouldPowerOutput = allInputsPowered && inputPorts.length > 0;
                        } else if (cell.type === 'or_gate') {
                            shouldPowerOutput = anyInputPowered;
                        } else if (cell.type === 'xor_gate') {
                            let poweredCount = 0;
                            for (const inputPort of inputPorts) {
                                const inputCellX = x + DIRECTION_OFFSETS[inputPort].dx;
                                const inputCellY = y + DIRECTION_OFFSETS[inputPort].dy;
                                if (powered.has(`${inputCellX},${inputCellY}`)) {
                                    poweredCount++;
                                }
                            }
                            shouldPowerOutput = poweredCount === 1;
                        } else if (cell.type === 'nand_gate') {
                            shouldPowerOutput = !(allInputsPowered && inputPorts.length > 0);
                        }
                        
                        if (shouldPowerOutput) {
                            powered.add(cellKey);
                            
                            const offset = DIRECTION_OFFSETS[outputPort];
                            const nextX = x + offset.dx;
                            const nextY = y + offset.dy;
                            queue.push({ x: nextX, y: nextY, direction: OPPOSITE_DIR[outputPort] });
                        }
                    } else if (cell.type === 'not_gate') {
                        const inputPort = 'W';
                        const inputCellX = x + DIRECTION_OFFSETS[inputPort].dx;
                        const inputCellY = y + DIRECTION_OFFSETS[inputPort].dy;
                        const inputKey = `${inputCellX},${inputCellY}`;
                        
                        const inputPowered = powered.has(inputKey);
                        
                        if (!inputPowered) {
                            powered.add(cellKey);
                            
                            const outputPort = 'E';
                            const offset = DIRECTION_OFFSETS[outputPort];
                            const nextX = x + offset.dx;
                            const nextY = y + offset.dy;
                            queue.push({ x: nextX, y: nextY, direction: OPPOSITE_DIR[outputPort] });
                        }
                    }
                } else if (direction && !isInputAt(x, y) && !isOutputAt(x, y)) {
                    const neighborX = x + DIRECTION_OFFSETS[direction].dx;
                    const neighborY = y + DIRECTION_OFFSETS[direction].dy;
                    
                    if (neighborX >= 0 && neighborX < level.gridWidth &&
                        neighborY >= 0 && neighborY < level.gridHeight) {
                        queue.push({ x: neighborX, y: neighborY, direction: direction });
                    }
                }
                
                if (direction && isOutputAt(x, y)) {
                    continue;
                }
            }
            
            const outputKey = `${level.outputs.B.x},${level.outputs.B.y}`;
            const outputPowered = powered.has(outputKey);
            
            let success = false;
            let message = '';
            
            if (outputPowered) {
                success = true;
                message = 'Circuit complete!';
            } else {
                const hasAnyInput = Object.values(inputStates).some(v => v);
                
                if (!hasAnyInput) {
                    message = 'Turn on at least one input';
                } else {
                    message = 'Signal not reaching output';
                }
            }
            
            gameState.board.forEach(row => {
                row.forEach(cell => {
                    if (cell && cell.type !== 'blocked') {
                        const key = `${getCellX(cell)},${getCellY(cell)}`;
                        cell.powered = powered.has(key);
                    }
                });
            });
            
            return { success, message, powered };
        }

        function getCellX(cell) {
            for (let y = 0; y < gameState.board.length; y++) {
                const idx = gameState.board[y].indexOf(cell);
                if (idx !== -1) return idx;
            }
            return -1;
        }

        function getCellY(cell) {
            for (let y = 0; y < gameState.board.length; y++) {
                const idx = gameState.board[y].indexOf(cell);
                if (idx !== -1) return y;
            }
            return -1;
        }

        function getComponentPorts(component) {
            const basePorts = PORT_CONFIGS[component.type]?.ports || [];
            const rotation = component.rotation || 0;
            const rotations = Math.floor(rotation / 90) % 4;
            
            const dirOrder = ['N', 'E', 'S', 'W'];
            const baseIndex = dirOrder.indexOf(basePorts[0]);
            
            return basePorts.map(port => {
                const portIndex = dirOrder.indexOf(port);
                const newIndex = (portIndex + rotations) % 4;
                return dirOrder[newIndex];
            });
        }

        function resetLevel() {
            initAudio();
            loadLevel(gameState.currentLevel);
            playSound('click');
        }

        function showLevelSelect() {
            initAudio();
            const modal = document.getElementById('level-select-modal');
            const content = document.getElementById('levelSelectContent');
            
            const chapters = {};
            LEVELS.forEach((level, index) => {
                if (!chapters[level.chapter]) {
                    chapters[level.chapter] = {
                        title: level.chapterTitle,
                        levels: []
                    };
                }
                chapters[level.chapter].levels.push({ ...level, index });
            });
            
            let html = '';
            for (const chapterNum in chapters) {
                const chapter = chapters[chapterNum];
                html += `<div class=\"chapter\">
                    <div class=\"chapter-title\">Chapter ${chapterNum}: ${chapter.title}</div>
                    <div class=\"level-grid\">`;
                
                chapter.levels.forEach(level => {
                    const stars = gameState.levelStars[`level_${level.index}`] || 0;
                    const completed = gameState.completedLevels.has(`level_${level.index}`);
                    const starDisplay = '★'.repeat(stars) + '☆'.repeat(3 - stars);
                    
                    html += `<button class=\"level-btn ${completed ? 'completed' : ''}\" data-level=\"${level.index}\">
                        ${level.index + 1}
                        <div class=\"level-stars\">${starDisplay}</div>
                    </button>`;
                });
                
                html += '</div></div>';
            }
            
            content.innerHTML = html;
            
            content.querySelectorAll('.level-btn').forEach(btn => {
                btn.addEventListener('click', () => {
                    const levelIndex = parseInt(btn.dataset.level);
                    hideLevelSelect();
                    loadLevel(levelIndex);
                    gameState.currentLevel = levelIndex;
                    playSound('click');
                });
            });
            
            modal.style.display = 'flex';
        }

        function hideLevelSelect() {
            document.getElementById('level-select-modal').style.display = 'none';
        }

        function togglePause() {
            initAudio();
            gameState.paused = !gameState.paused;
            document.getElementById('pauseBtn').textContent = gameState.paused ? 'Resume' : 'Pause';
            playSound('click');
        }

        function showWinModal() {
            const elapsed = gameState.elapsedTime || (Date.now() - gameState.startTime);
            const key = `level_${gameState.currentLevel}`;
            
            let stars = 1;
            if (elapsed < 30000) stars = 3;
            else if (elapsed < 60000) stars = 2;
            
            if (!gameState.bestTimes[key] || elapsed < gameState.bestTimes[key]) {
                gameState.bestTimes[key] = elapsed;
            }
            
            gameState.levelStars[key] = stars;
            gameState.completedLevels.add(key);
            saveProgress();
            
            document.getElementById('timeResult').textContent = `Time: ${formatTime(elapsed)}`;
            
            let starsHtml = '';
            for (let i = 0; i < 3; i++) {
                const filled = i < stars ? 'filled' : '';
                starsHtml += `<span class=\"star ${filled}\">${i < stars ? '★' : '☆'}</span>`;
            }
            document.getElementById('starsDisplay').innerHTML = starsHtml;
            
            const nextBtn = document.getElementById('nextLevelBtn');
            if (gameState.currentLevel >= LEVELS.length - 1) {
                nextBtn.textContent = 'All Complete!';
                nextBtn.disabled = true;
            } else {
                nextBtn.textContent = 'Next Level';
                nextBtn.disabled = false;
            }
            
            document.getElementById('win-modal').style.display = 'flex';
        }

        function hideWinModal() {
            document.getElementById('win-modal').style.display = 'none';
        }

        function replayLevel() {
            hideWinModal();
            resetLevel();
        }

        function nextLevel() {
            hideWinModal();
            if (gameState.currentLevel < LEVELS.length - 1) {
                gameState.currentLevel++;
                loadLevel(gameState.currentLevel);
            }
        }

        function gameLoop(timestamp) {
            if (!gameState.paused) {
                update();
                draw();
            }
            requestAnimationFrame(gameLoop);
        }

        function update() {
            if (!gameState.paused) {
                gameState.elapsedTime = Date.now() - gameState.startTime;
                document.getElementById('timer').textContent = formatTimeDetailed(gameState.elapsedTime);
            }
            
            updateParticles();
            updatePulseAnimations();
        }

        function draw() {
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            
            drawBoard();
            drawGrid();
            drawComponents();
            drawInputs();
            drawOutputs();
            drawDragPreview();
            drawParticles();
            drawPulseAnimations();
        }

        function drawBoard() {
            ctx.fillStyle = '#1A3A3A';
            ctx.fillRect(0, 0, canvas.width, canvas.height);
        }

        function drawGrid() {
            ctx.strokeStyle = '#152E2E';
            ctx.lineWidth = 1;
            
            for (let x = 0; x <= canvas.width; x += CELL_SIZE) {
                ctx.beginPath();
                ctx.moveTo(x, 0);
                ctx.lineTo(x, canvas.height);
                ctx.stroke();
            }
            
            for (let y = 0; y <= canvas.height; y += CELL_SIZE) {
                ctx.beginPath();
                ctx.moveTo(0, y);
                ctx.lineTo(canvas.width, y);
                ctx.stroke();
            }
        }

        function drawComponents() {
            for (let y = 0; y < gameState.board.length; y++) {
                for (let x = 0; x < gameState.board[y].length; x++) {
                    const cell = gameState.board[y][x];
                    if (cell && cell.type === 'blocked') {
                        drawBlockedCell(x, y);
                    } else if (cell && cell.type) {
                        drawComponent(cell, x, y);
                    }
                }
            }
        }

        function drawBlockedCell(x, y) {
            const cx = x * CELL_SIZE;
            const cy = y * CELL_SIZE;
            
            ctx.fillStyle = '#0D1F1F';
            ctx.fillRect(cx + 2, cy + 2, CELL_SIZE - 4, CELL_SIZE - 4);
            
            ctx.strokeStyle = '#2A4A4A';
            ctx.lineWidth = 2;
            ctx.setLineDash([5, 5]);
            ctx.strokeRect(cx + 4, cy + 4, CELL_SIZE - 8, CELL_SIZE - 8);
            ctx.setLineDash([]);
        }

        function drawComponent(component, gridX, gridY) {
            const cx = gridX * CELL_SIZE + CELL_SIZE / 2;
            const cy = gridY * CELL_SIZE + CELL_SIZE / 2;
            
            ctx.save();
            ctx.translate(cx, cy);
            ctx.rotate((component.rotation || 0) * Math.PI / 180);
            
            const isPowered = component.powered && gameState.isSimulating;
            const color = COMPONENT_COLORS[component.type];
            const glowColor = isPowered ? '#FFEB3B' : color;
            
            if (isPowered) {
                ctx.shadowColor = glowColor;
                ctx.shadowBlur = 15;
            }
            
            if (component.type === 'wire_straight') {
                drawWireStraight(color, isPowered);
            } else if (component.type === 'wire_corner') {
                drawWireCorner(color, isPowered);
            } else if (component.type === 'and_gate') {
                drawAndGate(color, isPowered);
            } else if (component.type === 'or_gate') {
                drawOrGate(color, isPowered);
            } else if (component.type === 'not_gate') {
                drawNotGate(color, isPowered);
            } else if (component.type === 'xor_gate') {
                drawXorGate(color, isPowered);
            } else if (component.type === 'nand_gate') {
                drawNandGate(color, isPowered);
            }
            
            ctx.restore();
        }

        function drawWireStraight(color, isPowered) {
            ctx.strokeStyle =