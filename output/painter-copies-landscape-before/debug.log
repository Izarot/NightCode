- Canvas{"chroma-drift.html":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, user-scalable=no\">\n<title>CHROMA DRIFT — Painter's Race</title>\n<link rel=\"icon\" href=\"data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🎨</text></svg>\">\n<style>\n  *{margin:0;padding:0;box-sizing:border-box}\n  html,body{width:100%;height:100%;overflow:hidden;background:#0b0d12;font-family:\"Trebuchet MS\",system-ui,sans-serif;-webkit-user-select:none;user-select:none}\n  #wrap{position:fixed;inset:0;display:flex;align-items:center;justify-content:center;background:#0b0d12}\n  #game{display:block;background:#000;touch-action:none;image-rendering:auto}\n  .hint{position:fixed;left:8px;bottom:8px;color:#7a8194;font-size:12px;pointer-events:none;opacity:.7}\n</style>\n</head>\n<body>\n<div id=\"wrap\"><canvas id=\"game\" width=\"1280\" height=\"720\"></canvas></div>\n<div class=\"hint\">WASD move · Shift dash · E paint · Esc pause · click to start</div>\n<script>\n\"use strict\";\n/* ============================================================
   CHROMA DRIFT — Painter's Race
   Single-file HTML5 Canvas game. Vanilla JS, fixed timestep, 1280×720 logical res scaled to fit window.
   ============================================================ */\n\nconst W=1280,H=720;\nconst canvas=document.getElementById('game');\nconst ctx=canvas.getContext('2d');\nlet DPR=Math.min(window.devicePixelRatio||1,2);\nfunction resize(){ DPR=Math.min(window.devicePixelRatio||1,2); const s=Math.min(innerWidth/W,innerHeight/H); canvas.style.width=(W*s)+'px'; canvas.style.height=(H*s)+'px'; }\naddEventListener('resize',resize);\nresize();\n\n/* ---------- math helpers ---------- */\nconst clamp=(v,a,b)=>v<a?a:v>b?b:v;\nconst lerp=(a,b,t)=>a+(b-a)*t;\nconst TAU=Math.PI*2;\nfunction hsvToRgb(h,s,v){\n  h=((h%360)+360)%360;\n  const c=v*s, hp=h/60, x=c*(1-Math.abs((hp%2)-1)), m=v-c;\n  let r,g,b;\n  if(hp<1){r=c;g=x;b=0;} else if(hp<2){r=x;g=c;b=0;} else if(hp<3){r=0;g=c;b=x;} else if(hp<4){r=0;g=x;b=c;} else if(hp<5){r=x;g=0;b=c;} else {r=c;g=0;b=x;}\n  return [Math.round((r+m)*255),Math.round((g+m)*255),Math.round((b+m)*255)];\n}\nfunction rgbToHsv(r,g,b){\n  r/=255;g/=255;b/=255;\n  const mx=Math.max(r,g,b),mn=Math.min(r,g,b),d=mx-mn;\n  let h=0;\n  if(d!==0){ if(mx===r)h=((g-b)/d)%6; else if(mx===g)h=(b-r)/d+2; else h=(r-g)/d+4;\n    h*=60; if(h<0)h+=360;\n  }\n  const s=mx===0?0:(d/mx);\n  return [h,s,mx];\n}\nfunction hueDiff(a,b){ let d=Math.abs(a-b)%360; return Math.min(d,360-d); }\nfunction colorAccuracy(cur,tgt){\n  const dh=hueDiff(cur[0],tgt[0]);\n  const ds=Math.abs(cur[1]-tgt[1]);\n  const dv=Math.abs(cur[2]-tgt[2]);\n  const hueN=dh/180, satN=ds, valN=dv;\n  const acc=(hueN*0.6+satN*0.2+valN*0.2)*100;\n  return clamp(acc,0,100);\n}\nfunction pointInPoly(x,y,poly){\n  let inside=false;\n  for(let i=0,j=poly.length-1;i<poly.length;j=i++){ const xi=poly[i].x,yi=poly[i].y,xj=poly[j].x,yj=poly[j].y;\n    if(((yi>y)!==(yj>y)) && (x<(xj-xi)*(y-yi)/(yj-yi)+xi)) inside=!inside; }\n  return inside;\n}\nfunction polyCentroid(poly){ let x=0,y=0; poly.forEach(p=>{x+=p.x;y+=p.y}); return {x:x/poly.length,y:y/poly.length}; }\n\n/* ---------- levels ---------- */\nconst LEVELS=[\n  {name:'First Strokes',zones:[{type:'hill',x:300,y:430,th:120,ts:.55,tv:.72},{type:'lake',x:900,y:560,th:205,ts:.45,tv:.6},{type:'sky',x:640,y:150,th:205,ts:.35,tv:.92},{type:'flowers',x:150,y:600,th:330,ts:.75,tv:.8}],timer:90,drift:5,obstacles:[]},\n  {name:'Drift Run',zones:[{type:'hill',x:260,y:420,th:95,ts:.4,tv:.6},{type:'lake',x:1000,y:580,th:210,ts:.5,tv:.55},{type:'sky',x:640,y:130,th:210,ts:.3,tv:.95},{type:'flowers',x:180,y:620,th:30,ts:.8,tv:.85},{type:'tree',x:1100,y:470,th:70,ts:.45,tv:.65}],timer:82,drift:10,obstacles:[{x:520,y:540,r:26},{x:760,y:300,r:22}]},\n  {name:'Chromatic Storm',zones:[{type:'hill',x:300,y:400,th:140,ts:.5,tv:.7},{type:'lake',x:980,y:560,th:260,ts:.55,tv:.5},{type:'sky',x:640,y:110,th:260,ts:.35,tv:.95},{type:'flowers',x:200,y:600,th:200,ts:.8,tv:.8},{type:'tree',x:1120,y:460,th:150,ts:.4,tv:.6}],timer:72,drift:15,obstacles:[{x:560,y:520,r:30},{x:820,y:320,r:24},{x:400,y:250,r:20}]},\n  {name:'The Grand Canvas',zones:[{type:'hill',x:250,y:380,th:110,ts:.5,tv:.72},{type:'lake',x:1020,y:580,th:200,ts:.45,tv:.55},{type:'sky',x:640,y:100,th:200,ts:.3,tv:.96},{type:'flowers',x:160,y:620,th:330,ts:.78,tv:.82},{type:'tree',x:1140,y:440,th:65,ts:.42,tv:.62},{type:'hill',x:700,y:560,th:30,ts:.5,tv:.6}],timer:66,drift:20,obstacles:[{x:500,y:500,r:28},{x:780,y:300,r:26},{x:360,y:260,r:22},{x:900,y:250,r:20}]},\n  {name:'Final Chroma',zones:[{type:'hill',x:220,y:360,th:130,ts:.55,tv:.7},{type:'lake',x:1040,y:590,th:210,ts:.5,tv:.5},{type:'sky',x:640,y:90,th:210,ts:.32,tv:.97},{type:'flowers',x:140,y:630,th:300,ts:.82,tv:.84},{type:'tree',x:1160,y:420,th:55,ts:.45,tv:.6},{type:'hill',x:720,y:570,th:20,ts:.55,tv:.58}],timer:60,drift:25,obstacles:[{x:480,y:520,r:30},{x:760,y:280,r:26},{x:340,y:240,r:22},{x:880,y:230,r:20},{x:600,y:380,r:20}]}\n];\n\n/* ---------- procedural organic shapes ---------- */\nfunction makeShape(cx,cy,seed,kind){\n  const pts=[]; const n=kind==='lake'?14:kind==='sky'?10:kind==='flowers'?12:kind==='tree'?10:kind==='hill'?16:14;\n  let rnd=mulberry32(seed);\n  for(let i=0;i<n;i++){ const ang=i/n*TAU; const rad=kind==='lake'?0.55+rnd()*0.5:kind==='sky'?0.3+rnd()*0.5:0.5+rnd()*0.75;\n    pts.push({x:cx+Math.cos(ang)*rad*150, y:cy+Math.sin(ang)*rad*90}); }\n  return pts;\n}\nfunction mulberry32(a){ return function(){a|=0;a=a+0x6D2B79F5|0;let t=Math.imul(a^a>>>15,1|a);t=t+Math.imul(t^t>>>7,61|t)^0;return ((t^t>>>14)>>>0)/4294967296; }; }\n\n/* ---------- particle system ---------- */\nconst MAXP=300;\nconst particles=[];\nfunction spawnParticle(p){ if(particles.length>MAXP) particles.shift(); particles.push(p); }\nfunction burst(x,y,color,n,spd,life,grav,size){ for(let i=0;i<n;i++){ const a=Math.random()*TAU, s=spd*(0.4+Math.random()); spawnParticle({x,y,vx:Math.cos(a)*s,vy:Math.sin(a)*s,life:life*(0.6+Math.random()*0.6),age:0,color,size:size*(0.6+Math.random()*0.8),grav:grav||0}); } }\nfunction updateParticles(dt){ for(let i=particles.length-1;i>=0;i--){ const p=particles[i]; p.age+=dt; p.x+=p.vx; p.y+=p.vy; p.vy+=p.grav; p.vx*=0.98; if(p.life<=0) particles.splice(i,1); } }\nfunction renderParticles(){ for(const p of particles){ const a=clamp(1-p.age/p.life,0,1); ctx.globalAlpha=a; ctx.fillStyle=p.color; ctx.beginPath(); ctx.arc(p.x,p.y,p.size,0,TAU); ctx.fill(); } ctx.globalAlpha=1; }\n\n/* ---------- audio ---------- */\nconst Audio={ctx:null,master:null,ambient:null,ready:false};\nfunction initAudio(){ if(Audio.ready) return; try{ Audio.ctx=new (window.AudioContext||window.webkitAudioContext)(); Audio.master=Audio.ctx.createGain(); Audio.master.gain.value=0.5; Audio.master.connect(Audio.ctx.destination); Audio.ready=true; startAmbient(); }catch(e){} }\nfunction startAmbient(){ if(!Audio.ctx) return; const o1=Audio.ctx.createOscillator(),o2=Audio.ctx.createOscillator(),g=Audio.ctx.createGain();\n  o1.type='sine';o1.frequency.value=110;o2.type='sine';o2.frequency.value=165;\n  g.gain.value=0; o1.connect(g);o2.connect(g);g.connect(Audio.master);\n  const lfo=Audio.ctx.createOscillator(),lfoG=Audio.ctx.createGain(); lfo.frequency.value=0.12; lfoG.gain.value=0.06; lfo.connect(lfoG);lfoG.connect(g.gain);\n  o1.start();o2.start();lfo.start(); Audio.ambient={o1,o2,lfo,g};\n}\nfunction tone(freq,dur,type,vol,slide){ if(!Audio.ctx) return; const t=Audio.ctx.currentTime; const o=Audio.ctx.createOscillator(),g=Audio.ctx.createGain(); o.type=type||'sine'; o.frequency.setValueAtTime(freq,t); if(slide) o.frequency.exponentialRampToValueAtTime(Math.max(1,freq*slide),t+dur); g.gain.setValueAtTime(vol||0.2,t); g.gain.exponentialRampToValueAtTime(0.001,t+dur); o.connect(g);g.connect(Audio.master); o.start(t); o.stop(t+dur+0.02); }\nfunction noiseBurst(dur,vol,filterFreq){ if(!Audio.ctx) return; const t=Audio.ctx.currentTime; const buf=Audio.ctx.createBuffer(1,Audio.ctx.sampleRate*dur,Audio.ctx.sampleRate); const d=buf.getChannelData(0); for(let i=0;i<d.length;i++) d[i]=Math.random()*2-1; const src=Audio.ctx.createBufferSource(); src.buffer=buf; const f=Audio.ctx.createBiquadFilter(); f.type='lowpass'; f.frequency.value=filterFreq||1200; const g=Audio.ctx.createGain(); g.gain.setValueAtTime(vol||0.3,t); g.gain.exponentialRampToValueAtTime(0.001,t+dur); src.connect(f);f.connect(g);g.connect(Audio.master); src.start(t); src.stop(t+dur); }\nfunction playBrush(){ noiseBurst(0.18,0.18,900); tone(220,0.12,'triangle',0.08,1.4); }\nfunction playPerfect(){ tone(880,0.1,'sine',0.25); setTimeout(()=>tone(1320,0.12,'sine',0.22),70); setTimeout(()=>tone(1760,0.14,'sine',0.18),150); }\nfunction playMuddy(){ tone(90,0.22,'sawtooth',0.18,0.5); noiseBurst(0.2,0.12,400); }\nfunction playDash(){ noiseBurst(0.16,0.16,1800); tone(440,0.1,'square',0.06,2); }\nfunction playClick(){ tone(660,0.05,'square',0.12); }\nfunction playWin(){ [523,659,784,1046].forEach((f,i)=>setTimeout(()=>tone(f,0.22,'triangle',0.22),i*120)); }\nfunction playLose(){ [330,247,196,147].forEach((f,i)=>setTimeout(()=>tone(f,0.28,'sawtooth',0.16),i*140)); }\n\n/* ---------- input ---------- */\nconst keys={};\naddEventListener('keydown',e=>{ keys[e.code]=true; if(['ArrowUp','ArrowDown','ArrowLeft','ArrowRight','Space'].includes(e.code)) e.preventDefault(); });\naddEventListener('keyup',e=>{ keys[e.code]=false;