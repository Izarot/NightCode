Let me define ColorZone:
```
class ColorZone {
  constructor(cfg){ this.id=cfg.id; this.type=cfg.type; this.cx=cfg.x; this.cy=cfg.y; this.target={h:cfg.th,s:cfg.ts,v:cfg.tv}; this.current={h:cfg.th,s:cfg.ts,v:cfg.tv}; this.driftRate=cfg.drift; this.dir=1; this.dirTimer=3+Math.random()*2; this.points=cfg.shape; this.strokes=[]; this.painted=false; this.pulse=0; this.swatchY=0; this.arrowDir=0; }
  update(dt, t){
    // drift hue
    this.current.h += this.dir * this.driftRate * dt;
    // occasionally reverse
    this.dirTimer -= dt;
    if(this.dirTimer<=0){ this.dir *= -1; this.dirTimer = 3+Math.random()*2; }
    // sat/val oscillation
    this.current.s = clamp(this.target.s + Math.sin(t*2)*0.03 + (this.driftRate>15?0.02:0), 0,1);
    this.current.v = clamp(this.target.v + Math.cos(t*1.5)*0.03, 0,1);
    // drift magnitude
    const dh = hueDiff(this.current.h, this.target.h);
    this.driftMag = dh;
    this.pulse += dt;
    this.swatchY = Math.sin(t*3)*3;
  }
  stroke(color, accuracy, muddy){
    this.strokes.push({color, accuracy, muddy});
    this.painted = true;
  }
  get avgAcc(){ if(!this.strokes.length) return 50; return this.strokes.reduce((a,b)=>a+b.accuracy,0)/this.strokes.length; }
  get bestAcc(){ ... }
}
```

