Let me make sure the game loop uses fixed timestep:
```
let acc = 0; const STEP = 1/60;
function frame(t){
  const dt = Math.min((t - last)/1000, 0.1); last = t;
  acc += dt;
  while(acc >= STEP){ update(STEP); acc -= STEP; }
  render();
  requestAnimationFrame(frame);
}
```

