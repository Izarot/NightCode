  "style.css": ":root {\n    --void: #0B0C10;\n    --grid: #1F2833;\n    --source: #66FCF1;\n    --consumer: #F4A261;\n    --transformer: #45A29E;\n    --wire-active: #45A29E;\n    --wire-conflict: #E63946;\n    --text: #C5C6C7;\n    --glow: #FFFFFF;\n    --accent: #FF6B6B;\n    --bg-glass: rgba(11, 12, 16, 0.85);\n    --border-glass: rgba(102, 252, 241, 0.2);\n}\n\n* {\n    margin: 0;\n    padding: 0;\n    box-sizing: border-box;\n    -webkit-tap-highlight-color: transparent;\n}\n\nhtml, body {\n    height: 100%;\n    width: 100%;\n    overflow: hidden;\n    background: var(--void);\n    font-family: 'Space Mono', monospace;\n    color: var(--text);\n    touch-action: none;\n}\n\n#game-container {\n    position: relative;\n    width: 100%;\n    height: 100%;\n    display: flex;\n    justify-content: center;\n    align-items: center;\n}\n\n#game-canvas {\n    display: block;\n    max-width: 100%;\n    max-height: 100%;\n    image-rendering: crisp-edges;\n    image-rendering: pixelated;\n}\n\n#ui-overlay {\n    position: absolute;\n    top: 0;\n    left: 0;\n    width: 100%;\n    height: 100%;\n    pointer-events: none;\n    display: flex;\n    flex-direction: column;\n    justify-content: space-between;\n    padding: 1rem;\n}\n\n.hud {\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    pointer-events: auto;\n    padding: 0.5rem 1rem;\n    background: var(--bg-glass);\n    backdrop-filter: blur(10px);\n    border: 1px solid var(--border-glass);\n    border-radius: 8px;\n    font-family: 'Orbitron', sans-serif;\n    font-size: 0.9rem;\n    min-width: 300px;\n    max-width: 90vw;\n    margin: 0 auto;\n}\n\n.hud-item {\n    display: flex;\n    align-items: center;\n    gap: 0.5rem;\n}\n\n.hud-label {\n    color: var(--source);\n    font-weight: 700;\n    letter-spacing: 1px;\n}\n\n.hud-value {\n    color: var(--text);\n    font-variant-numeric: tabular-nums;\n}\n\n.timer {\n    color: var(--consumer);\n    font-weight: 700;\n    text-shadow: 0 0 10px var(--consumer);\n}\n\n.btn-pause {\n    background: transparent;\n    border: 1px solid var(--border-glass);\n    color: var(--text);\n    padding: 0.5rem 1rem;\n    border-radius: 4px;\n    cursor: pointer;\n    font-family: 'Orbitron', sans-serif;\n    font-size: 0.8rem;\n    transition: all 0.2s ease;\n    pointer-events: auto;\n}\n\n.btn-pause:hover, .btn-pause:focus {\n    background: var(--source);\n    color: var(--void);\n    border-color: var(--source);\n    box-shadow: 0 0 15px var(--source);\n}\n\n.screen {\n    position: absolute;\n    top: 50%;\n    left: 50%;\n    transform: translate(-50%, -50%) scale(0.9);\n    opacity: 0;\n    visibility: hidden;\n    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);\n    background: var(--bg-glass);\n    backdrop-filter: blur(20px);\n    border: 1px solid var(--border-glass);\n    border-radius: 16px;\n    padding: 3rem 4rem;\n    text-align: center;\n    min-width: 320px;\n    max-width: 90vw;\n    z-index: 10;\n    pointer-events: auto;\n}\n\n.screen.active {\n    opacity: 1;\n    visibility: visible;\n    transform: translate(-50%, -50%) scale(1);\n}\n\n.screen h1 {\n    font-family: 'Orbitron', sans-serif;\n    font-size: 2.5rem;\n    font-weight: 900;\n    margin-bottom: 0.5rem;\n    background: linear-gradient(135deg, var(--source), var(--consumer));\n    -webkit-background-clip: text;\n    -webkit-text-fill-color: transparent;\n    background-clip: text;\n}\n\n.screen p {\n    color: var(--text);\n    opacity: 0.8;\n    margin-bottom: 2rem;\n    line-height: 1.6;\n}\n\n.menu-grid {\n    display: grid;\n    grid-template-columns: repeat(auto-fill, minmax(80px, 1fr));\n    gap: 1rem;\n    margin-top: 1rem;\n}\n\n.level-btn {\n    aspect-ratio: 1;\n    background: var(--void);\n    border: 2px solid var(--border-glass);\n    border-radius: 8px;\n    color: var(--text);\n    font-family: 'Orbitron', sans-serif;\n    font-size: 1.2rem;\n    font-weight: 700;\n    cursor: pointer;\n    transition: all 0.2s;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n}\n\n.level-btn:hover:not(.locked), .level-btn:focus:not(.locked) {\n    border-color: var(--source);\n    box-shadow: 0 0 15px var(--source);\n    transform: scale(1.05);\n}\n\n.level-btn.locked {\n    opacity: 0.4;\n    cursor: not-allowed;\n}\n\n.level-btn.locked::after {\n    content: '🔒';\n    font-size: 1.5rem;\n}\n\n.level-btn.completed {\n    border-color: var(--transformer);\n    background: rgba(69, 162, 158, 0.1);\n}\n\n.btn-primary {\n    background: linear-gradient(135deg, var(--source), var(--transformer));\n    border: none;\n    color: var(--void);\n    padding: 1rem 2.5rem;\n    border-radius: 8px;\n    font-family: 'Orbitron', sans-serif;\n    font-size: 1rem;\n    font-weight: 700;\n    cursor: pointer;\n    transition: all 0.2s;\n    text-transform: uppercase;\n    letter-spacing: 2px;\n    margin: 0.5rem;\n}\n\n.btn-primary:hover, .btn-primary:focus {\n    transform: translateY(-2px);\n    box-shadow: 0 10px 30px rgba(102, 252, 241, 0.4);\n}\n\n.btn-secondary {\n    background: transparent;\n    border: 1px solid var(--border-glass);\n    color: var(--text);\n    padding: 1rem 2rem;\n    border-radius: 8px;\n    font-family: 'Orbitron', sans-serif;\n    font-size: 0.9rem;\n    cursor: pointer;\n    transition: all 0.2s;\n    margin: 0.5rem;\n}\n\n.btn-secondary:hover, .btn-secondary:focus {\n    border-color: var(--consumer);\n    color: var(--consumer);\n}\n\n.toast {\n    position: fixed;\n    bottom: 2rem;\n    left: 50%;\n    transform: translateX(-50%) translateY(100px);\n    opacity: 0;\n    background: var(--wire-conflict);\n    color: var(--void);\n    padding: 1rem 2rem;\n    border-radius: 8px;\n    font-family: 'Orbitron', sans-serif;\n    font-size: 0.9rem;\n    font-weight: 700;\n    z-index: 100;\n    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);\n    pointer-events: none;\n}\n\n.toast.show {\n    transform: translateX(-50%) translateY(0);\n    opacity: 1;\n}\n\n.toast.success {\n    background: var(--transformer);\n}\n\n.settings-row {\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    padding: 1rem 0;\n    border-bottom: 1px solid var(--border-glass);\n}\n\n.settings-row:last-child {\n    border-bottom: none;\n}\n\n.toggle {\n    position: relative;\n    width: 60px;\n    height: 30px;\n    background: var(--void);\n    border: 2px solid var(--border-glass);\n    border-radius: 15px;\n    cursor: pointer;\n    appearance: none;\n}\n\n.toggle:checked {\n    background: var(--source);\n    border-color: var(--source);\n}\n\n.toggle::after {\n    content: '';\n    position: absolute;\n    top: 2px;\n    left: 2px;\n    width: 22px;\n    height: 22px;\n    background: var(--text);\n    border-radius: 50%;\n    transition: transform 0.2s;\n}\n\n.toggle:checked::after {\n    transform: translateX(30px);\n    background: var(--void);\n}\n\n@media (max-width: 600px) {\n    .hud {\n        font-size: 0.75rem;\n        padding: 0.5rem;\n        min-width: auto;\n    }\n    .screen {\n        padding: 2rem 1.5rem;\n    }\n    .screen h1 {\n        font-size: 1.8rem;\n    }\n    .btn-primary, .btn-secondary {\n        padding: 0.8rem 1.5rem;\n        font-size: 0.85rem;\n        width: 100%;\n        box-sizing: border-box;\n    }\n}",
  "src/main.js": "import { Game } from './game.js';\nimport { Input } from './input.js';\nimport { UI } from './ui.js';\nimport { Assets } from './assets.js';\nimport { Levels } from './levels.js';\n\nclass App {\n    constructor() {\n        this.canvas = document.getElementById('game-canvas');\n        this.ctx = this.canvas.getContext('2d');\n        this.ui = new UI();\n        this.assets = new Assets();\n        this.levels = new Levels();\n        this.input = new Input(this.canvas);\n        this.game = new Game(this.ctx, this.input, this.ui, this.assets, this.levels);\n        \n        this.lastTime = 0;\n        this.resize();\n        window.addEventListener('resize', () => this.resize());\n        requestAnimationFrame(this.loop.bind(this));\n    }\n\n    resize() {\n        const container = document.getElementById('game-container');\n        const rect = container.getBoundingClientRect();\n        const dpr = window.devicePixelRatio || 1;\n        \n        this.canvas.width = rect.width * dpr;\n        this.canvas.height = rect.height * dpr;\n        this.canvas.style.width = rect.width + 'px';\n        this.canvas.style.height = rect.height + 'px';\n        this.ctx.scale(dpr, dpr);\n        \n        this.game.resize(rect.width, rect.height);\n    }\n\n    loop(timestamp) {\n        const dt = (timestamp - this.lastTime) / 1000;\n        this.lastTime = timestamp;\n        \n        this.game.update(dt);\n        this.game.render();\n        \n        requestAnimationFrame(this.loop.bind(this));\n    }\n}\n\nnew App();",
  "src/game.js": "import { Renderer } from './renderer.js';\nimport { Physics } from './physics.js';\n\nconst STATE = {\n    MENU: 'menu',\n    PLAYING: 'playing',\n    PAUSED: 'paused',\n    VICTORY: 'victory',\n    LEVEL_SELECT: 'level_select'\n};\n\nexport class Game {\n    constructor(ctx, input, ui, assets, levels) {\n        this.ctx = ctx;\n        this.input = input;\n        this.ui = ui;\n        this.assets = assets;\n        this.levels = levels;\n        \n        this.state = STATE.MENU;\n        this.currentLevel = 0;\n        this.gridSize = 10;\n        this.cellSize = 50;\n        this.offsetX = 0;\n        this.offsetY = 0;\n        \n        this.nodes = [];\n        this.wires = [];\n        this.walls = [];\n        \n        this.draggingWire = null;\n        this.selectedNode = null;\n        \n        this.moves = 0;\n        this.startTime = 0;\n        this.elapsedTime = 0;\n        this.bestTimes = JSON.parse(localStorage.getItem('overload_best_times') || '{}');\n        \n        this.renderer = new Renderer(this.ctx);\n        this.physics = new Physics();\n        \n        this.ui.on('start', () => this.startGame());\n        this.ui.on('levelSelect', (idx) => this.loadLevel(idx));\n        this.ui.on('restart', () => this.loadLevel(this.currentLevel));\n        this.ui.on('nextLevel', () => this.loadLevel(this.currentLevel + 1));\n        this.ui.on('menu', () => this.showMenu());\n        this.ui.on('pause', () => this.togglePause());\n        \n        this.showMenu();\n    }\n\n    resize(width, height) {\n        this.screenWidth = width;\n        this.screenHeight = height;\n        this.calculateLayout();\n    }\n\n    calculateLayout() {\n        const padding = 40;\n        const availableW = this.screenWidth - padding * 2;\n        const availableH = this.screenHeight - padding * 2 - 80;\n        \n        this.cellSize = Math.min(availableW / this.gridSize, availableH / this.gridSize);\n        this.cellSize = Math.max(30, Math.min(80, this.cellSize));\n        \n        this.offsetX = (this.screenWidth - this.gridSize * this.cellSize) / 2;\n        this.offsetY = (this.screenHeight - this.gridSize * this.cellSize) / 2 + 40;\n    }\n\n    showMenu() {\n        this.state = STATE.MENU;\n        this.ui.showScreen('menu');\n    }\n\n    showLevelSelect() {\n        this.state = STATE.LEVEL_SELECT;\n        const unlocked = parseInt(localStorage.getItem('overload_unlocked') || '1');\n        this.ui.showLevelSelect(this.levels.data.length, unlocked);\n    }\n\n    startGame() {\n        this.showLevelSelect();\n    }\n\n    loadLevel(index) {\n        if (index >= this.levels.data.length) {\n            this.ui.showToast('No more levels!', true);\n            return;\n        }\n        \n        this.currentLevel = index;\n        const level = this.levels.data[index];\n        this.gridSize = level.width;\n        \n        this.nodes = level.nodes.map(n => ({\n            ...n,\n            id: n.id,\n            connections: [],\n            rotation: n.rotation || 0\n        }));\n        \n        this.walls = level.walls || [];\n        this.wires = [];\n        this.moves = 0;\n        this.startTime = performance.now();\n        this.elapsedTime = 0;\n        \n        this.calculateLayout();\n        this.state = STATE.PLAYING;\n        this.ui.hideScreens();\n        this.ui.updateHUD(this);\n    }\n\n    togglePause() {\n        if (this.state === STATE.PLAYING) {\n            this.state = STATE.PAUSED;\n            this.ui.showScreen('pause');\n        } else if (this.state === STATE.PAUSED) {\n            this.state = STATE.PLAYING;\n            this.ui.hideScreens();\n        }\n    }\n\n    update(dt) {\n        if (this.state !== STATE.PLAYING) return;\n        \n        this.elapsedTime = (performance.now() - this.startTime) / 1000;\n        \n        this.handleInput();\n        this.updateWires();\n        this.checkWinCondition();\n        this.ui.updateHUD(this);\n    }\n\n    handleInput() {\n        const pointer = this.input.getPointer();\n        const gridPos = this.screenToGrid(pointer.x, pointer.y);\n        \n        if (this.input.justPressed()) {\n            this.onPointerDown(pointer, gridPos);\n        }\n        \n        if (this.input.isPressed()) {\n            this.onPointerMove(pointer, gridPos);\n        }\n        \n        if (this.input.justReleased()) {\n            this.onPointerUp(pointer, gridPos);\n        }\n        \n        if (this.input.justClicked()) {\n            this.onClick(gridPos);\n        }\n    }\n\n    screenToGrid(x, y) {\n        return {\n            x: Math.floor((x - this.offsetX) / this.cellSize),\n            y: Math.floor((y - this.offsetY) / this.cellSize)\n        };\n    }\n\n    gridToScreen(gx, gy) {\n        return {\n            x: this.offsetX + gx * this.cellSize + this.cellSize / 2,\n            y: this.offsetY + gy * this.cellSize + this.cellSize / 2\n        };\n    }\n\n    onPointerDown(pointer, gridPos) {\n        const node = this.getNodeAt(gridPos.x, gridPos.y);\n        if (node && (node.type === 'source' || node.type === 'transformer' || node.type === 'consumer')) {\n            if (node.type === 'consumer' && node.connections.length > 0) return;\n            if (node.type === 'source' && node.connections.length >= 4) return;\n            if (node.type === 'transformer' && node.connections.length >= 2) return;\n            \n            this.draggingWire = {\n                startNode: node,\n                startPos: this.gridToScreen(node.x, node.y),\n                endPos: { x: pointer.x, y: pointer.y },\n                path: []\n            };\n            this.assets.playSound('wire_start');\n        }\n    }\n\n    onPointerMove(pointer, gridPos) {\n        if (this.draggingWire) {\n            this.draggingWire.endPos = { x: pointer.x, y: pointer.y };\n        }\n    }\n\n    onPointerUp(pointer, gridPos) {\n        if (!this.draggingWire) return;\n        \n        const endNode = this.getNodeAt(gridPos.x, gridPos.y);\n        const startNode = this.draggingWire.startNode;\n        \n        if (endNode && endNode !== startNode && this.canConnect(startNode, endNode)) {\n            this.createWire(startNode, endNode);\n            this.assets.playSound('wire_connect');\n            this.moves++;\n        } else {\n            this.assets.playSound('wire_cancel');\n        }\n        \n        this.draggingWire = null;\n    }\n\n    onClick(gridPos) {\n        const node = this.getNodeAt(gridPos.x, gridPos.y);\n        if (node && node.type === 'transformer') {\n            node.rotation = (node.rotation + 90) % 360;\n            this.assets.playSound('rotate');\n            this.moves++;\n            this.validateConnections();\n        }\n    }\n\n    getNodeAt(gx, gy) {\n        return this.nodes.find(n => n.x === gx && n.y === gy);\n    }\n\n    canConnect(a, b) {\n        if (a.type === 'consumer' && b.type === 'consumer') return false;\n        if (a.type === 'source' && b.type === 'source') return false;\n        if (a.connections.includes(b.id) || b.connections.includes(a.id)) return false;\n        \n        if (a.type === 'consumer' && a.connections.length > 0) return false;\n        if (b.type === 'consumer' && b.connections.length > 0) return false;\n        if (a.type === 'source' && a.connections.length >= 4) return false;\n        if (b.type === 'source' && b.connections.length >= 4) return false;\n        if (a.type === 'transformer' && a.connections.length >= 2) return false;\n        if (b.type === 'transformer' && b.connections.length >= 2) return false;\n        \n        return true;\n    }\n\n    createWire(a, b) {\n        const wire = {\n            id: Date.now() + Math.random(),\n            a: a.id,\n            b: b.id,\n            path: this.calculatePath(a, b),\n            conflict: false,\n            flowOffset: Math.random()\n        };\n        \n        this.wires.push(wire);\n        a.connections.push(b.id);\n        b.connections.push(a.id);\n        \n        this.validateConnections();\n    }\n\n    calculatePath(a, b) {\n        const start = this.gridToScreen(a.x, a.y);\n        const end = this.gridToScreen(b.x, b.y);\n        \n        const dx = end.x - start.x;\n        const dy = end.y - start.y;\n        const dist = Math.sqrt(dx * dx + dy * dy);\n        \n        const midX = start.x + dx / 2;\n        const midY = start.y + dy / 2;\n        \n        const perpX = -dy / dist * 30;\n        const perpY = dx / dist * 30;\n        \n        return [\n            { x: start.x, y: start.y },\n            { x: midX + perpX, y: midY + perpY },\n            { x: end.x, y: end.y }\n        ];\n    }\n\n    updateWires() {\n        this.wires.forEach(wire => {\n            wire.flowOffset = (wire.flowOffset + 0.001) % 1;\n            wire.conflict = this.checkWireConflict(wire);\n        });\n    }\n\n    checkWireConflict(wire) {\n        const segments = this.getWireSegments(wire);\n        \n        for (const other of this.wires) {\n            if (other === wire) continue;\n            const otherSegments = this.getWireSegments(other);\n            \n            for (const s1 of segments) {\n                for (const s2 of otherSegments) {\n                    if (this.physics.segmentsIntersect(s1.p1, s1.p2, s2.p1, s2.p2)) {\n                        const sharedNode = (s1.p1.x === s2.p1.x && s1.p1.y === s2.p1.y) ||\n                                         (s1.p1.x === s2.p2.x && s1.p1.y === s2.p2.y) ||\n                                         (s1.p2.x === s2.p1.x && s1.p2.y === s2.p1.y) ||\n                                         (s1.p2.x === s2.p2.x && s1.p2.y === s2.p2.y);\n                        if (!sharedNode) return true;\n                    }\n                }\n            }\n        }\n        \n        for (const wall of this.walls) {\n            const wallRect = {\n                x: this.offsetX + wall.x * this.cellSize,\n                y: this.offsetY + wall.y * this.cellSize,\n                w: this.cellSize,\n                h: this.cellSize\n            };\n            for (const seg of segments) {\n                if (this.physics.segmentRectIntersect(seg.p1, seg.p2, wallRect)) return true;\n            }\n        }\n        \n        return false;\n    }\n\n    getWireSegments(wire) {\n        const segments = [];\n        const path = wire.path;\n        for (let i = 0; i < path.length - 1; i++) {\n            segments.push({ p1: path[i], p2: path[i + 1] });\n        }\n        return segments;\n    }\n\n    validateConnections() {\n        const visited = new Set();\n        const powered = new Set();\n        \n        const sources = this.nodes.filter(n => n.type === 'source');\n        \n        sources.forEach(source => {\n            this.dfsPower(source, powered, visited);\n        });\n        \n        this.nodes.forEach(node => {\n            node.powered = powered.has(node.id);\n            node.overloaded = false;\n        });\n        \n        this.wires.forEach(wire => {\n            const nodeA = this.nodes.find(n => n.id === wire.a);\n            const nodeB = this.nodes.find(n => n.id === wire.b);\n            wire.powered = nodeA?.powered && nodeB?.powered;\n        });\n    }\n\n    dfsPower(node, powered, visited) {\n        if (visited.has(node.id)) return;\n        visited.add(node.id);\n        powered.add(node.id);\n        \n        node.connections.forEach(connId => {\n            const next = this.nodes.find(n => n.id === connId);\n            if (next) this.dfsPower(next, powered, visited);\n        });\n    }\n\n    checkWinCondition() {\n        const consumers = this.nodes.filter(n => n.type === 'consumer');\n        const allPowered = consumers.every(c => c.powered);\n        const noConflicts = this.wires.every(w => !w.conflict);\n        const noOverloads = this.nodes.every(n => !n.overloaded);\n        \n        if (allPowered && noConflicts && noOverloads && consumers.length > 0) {\n            this.onVictory();\n        }\n    }\n\n    onVictory() {\n        this.state = STATE.VICTORY;\n        \n        const unlocked = parseInt(localStorage.getItem('overload_unlocked') || '1');\n        if (this.currentLevel + 1 >= unlocked) {\n            localStorage.setItem('overload_unlocked', (this.currentLevel + 2).toString());\n        }\n        \n        const best = this.bestTimes[this.currentLevel] || Infinity;\n        if (this.elapsedTime < best) {\n            this.bestTimes[this.currentLevel] = this.elapsedTime;\n            localStorage.setItem('overload_best_times', JSON.stringify(this.bestTimes));\n        }\n        \n        this.assets.playSound('victory');\n        this.ui.showVictory(this);\n    }\n\n    render() {\n        this.renderer.clear();\n        \n        if (this.state === STATE.PLAYING || this.state === STATE.PAUSED || this.state === STATE.VICTORY) {\n            this.renderer.drawGrid(this.offsetX, this.offsetY, this.gridSize, this.cellSize);\n            this.renderer.drawWalls(this.walls, this.offsetX, this.offsetY, this.cellSize);\n            this.renderer.drawWires(this.wires, this.nodes);\n            this.renderer.drawNodes(this.nodes, this.offsetX, this.offsetY, this.cellSize);\n            \n            if (this.draggingWire) {\n                this.renderer.drawDraggingWire(this.draggingWire);\n            }\n        }\n    }\n}",
  "src/input.js": "export class Input {\n    constructor(canvas) {\n        this.canvas = canvas;\n        this.pointer = { x: 0, y: 0 };\n        this.pressed = false;\n        this.justPressedFlag = false;\n        this.justReleasedFlag = false;\n        this.clickThreshold = 5;\n        this.dragStart = null;\n        \n        this.bindEvents();\n    }\n\n    bindEvents() {\n        this.canvas.addEventListener('mousedown', e => this.onDown(e.clientX, e.clientY));\n        this.canvas.addEventListener('mousemove', e => this.onMove(e.clientX, e.clientY));\n        window.addEventListener('mouseup', e => this.onUp(e.clientX, e.clientY));\n        \n        this.canvas.addEventListener('touchstart', e => {\n            e.preventDefault();\n            const t = e.touches[0];\n            this.onDown(t.clientX, t.clientY);\n        }, { passive: false });\n        \n        this.canvas.addEventListener('touchmove', e => {\n            e.preventDefault();\n            const t = e.touches[0];\n            this.onMove(t.clientX, t.clientY);\n        }, { passive: false });\n        \n        window.addEventListener('touchend', e => {\n            const t = e.changedTouches[0];\n            this.onUp(t.clientX, t.clientY);\n        });\n        \n        window.addEventListener('keydown', e => {\n            if (e.code === 'Escape' || e.code === 'KeyP') {\n                this.pausePressed = true;\n            }\n        });\n    }\n\n    onDown(x, y) {\n        this.pointer.x = x;\n        this.pointer.y = y;\n        this.pressed = true;\n        this.justPressedFlag = true;\this.dragStart = { x: this.pointer.x, y: this.pointer.y };\n    }\n\n    onMove(x, y) {\n        this.pointer.x = x;\n        this.pointer.y = y;\n    }\n\n    onUp(x, y) {\n        this.pointer.x = x;\n        this.pointer.y = y;\n        this.pressed = false;\n        this.justReleasedFlag = true;\n        \n        if (this.dragStart) {\n            const dx = x - this.dragStart.x;\n            const dy = y - this.dragStart.y;\n            const dist = Math.sqrt(dx * dx + dy * dy);\n            this.justClickedFlag = dist < this.clickThreshold;\n            this.dragStart = null;\n        }\n    }\n\n    getPointer() {\n        const rect = this.canvas.getBoundingClientRect();\n        return {\n            x: this.pointer.x - rect.left,\n            y: this.pointer.y - rect.top\n        };\n    }\n\n    justPressed() {\n        if (this.justPressedFlag) {\n            this.justPressedFlag = false;\n            return true;\n        }\n        return false;\n    }\n\n    isPressed() {\n        return this.pressed;\n    }\n\n    justReleased() {\n        if (this.justReleasedFlag) {\n            this.justReleasedFlag = false;\n            return true;\n        }\n        return false;\n    }\n\n    justClicked() {\n        if (this.justClickedFlag) {\n            this.justClickedFlag = false;\n            return true;\n        }\n        return false;\n    }\n\n    consumePause() {\n        if (this.pausePressed) {\n            this.pausePressed = false;\n            return true;\n        }\n        return false;\n    }\n}",
  "src/renderer.js": "export class Renderer {\n    constructor(ctx) {\n        this.ctx = ctx;\n    }\n\n    clear() {\n        this.ctx.fillStyle = '#0B0C10';\n        this.ctx.fillRect(0, 0, this.ctx.canvas.width, this.ctx.canvas.height);\n    }\n\n    drawGrid(offsetX, offsetY, gridSize, cellSize) {\n        const ctx = this.ctx;\n        ctx.strokeStyle = '#1F2833';\n        ctx.lineWidth = 1;\n        \n        for (let i = 0; i <= gridSize; i++) {\n            ctx.beginPath();\n            ctx.moveTo(offsetX + i * cellSize, offsetY);\n            ctx.lineTo(offsetX + i * cellSize, offsetY + gridSize * cellSize);\n            ctx.stroke();\n            \n            ctx.beginPath();\n            ctx.moveTo(offsetX, offsetY + i * cellSize);\n            ctx.lineTo(offsetX + gridSize * cellSize, offsetY + i * cellSize);\n            ctx.stroke();\n        }\n    }\n\n    drawWalls(walls, offsetX, offsetY, cellSize) {\n        const ctx = this.ctx;\n        walls.forEach(wall => {\n            const x = offsetX + wall.x * cellSize;\n            const y = offsetY + wall.y * cellSize;\n            \n            ctx.fillStyle = 'rgba(31, 40, 51, 0.9)';\n            ctx.fillRect(x, y, cellSize, cellSize);\n            \n            ctx.strokeStyle = '#0B0C10';\n            ctx.lineWidth = 2;\n            ctx.strokeRect(x + 2, y + 2, cellSize - 4, cellSize - 4);\n            \n            ctx.fillStyle = '#0B0C10';\n            for (let i = 0; i < 3; i++) {\n                for (let j = 0; j < 3; j++) {\n                    ctx.fillRect(x + 8 + i * (cellSize - 16) / 2, y + 8 + j * (cellSize - 16) / 2, 4, 4);\n                }\n            }\n        });\n    }\n\n    drawWires(wires, nodes) {\n        const ctx = this.ctx;\n        \n        wires.forEach(wire => {\n            const nodeA = nodes.find(n => n.id === wire.a);\n            const nodeB = nodes.find(n => n.id === wire.b);\n            if (!nodeA || !nodeB) return;\n            \n            const powered = wire.powered && !wire.conflict;\n            const conflict = wire.conflict;\n            \n            ctx.lineWidth = 4;\n            ctx.lineCap = 'round';\n            ctx.lineJoin = 'round';\n            \n            if (conflict) {\n                ctx.strokeStyle = '#E63946';\n                ctx.shadowColor = '#E63946';\n                ctx.shadowBlur = 10;\n            } else if (powered) {\n                ctx.strokeStyle = '#45A29E';\n                ctx.shadowColor = '#45A29E';\n                ctx.shadowBlur = 8;\n            } else {\n                ctx.strokeStyle = 'rgba(69, 162, 158, 0.4)';\n                ctx.shadowBlur = 0;\n            }\n            \n            const path = wire.path;\n            ctx.beginPath();\n            ctx.moveTo(path[0].x, path[0].y);\n            \n            if (path.length === 3) {\n                ctx.quadraticCurveTo(path[1].x, path[1].y, path[2].x, path[2].y);\n            } else {\n                for (let i = 1; i < path.length; i++) {\n                    ctx.lineTo(path[i].x, path[i].y);\n                }\n            }\n            ctx.stroke();\n            \n            if (powered && !conflict) {\n                this.drawFlow(ctx, path, wire.flowOffset);\n            }\n            \n            ctx.shadowBlur = 0;\n        });\n    }\n\n    drawFlow(ctx, path, offset) {\n        const totalLength = this.getPathLength(path);\n        const particleCount = Math.max(3, Math.floor(totalLength / 30));\n        \n        for (let i = 0; i < particleCount; i++) {\n            const t = (offset + i / particleCount) % 1;\n            const pos = this.getPointOnPath(path, t);\n            \n            ctx.fillStyle = '#66FCF1';\n            ctx.shadowColor = '#66FCF1';\n            ctx.shadowBlur = 6;\n            ctx.beginPath();\n            ctx.arc(pos.x, pos.y, 3, 0, Math.PI * 2);\n            ctx.fill();\n        }\n        ctx.shadowBlur = 0;\n    }\n\n    getPathLength(path) {\n        let length = 0;\n        for (let i = 0; i < path.length - 1; i++) {\n            const dx = path[i + 1].x - path[i].x;\n            const dy = path[i + 1].y - path[i].y;\n            length += Math.sqrt(dx * dx + dy * dy);\n        }\n        return length;\n    }\n\n    getPointOnPath(path, t) {\n        const totalLength = this.getPathLength(path);\n        const targetLength = t * totalLength;\n        \n        let accumulated = 0;\n        for (let i = 0; i < path.length - 1; i++) {\n            const dx = path[i + 1].x - path[i].x;\n            const dy = path[i + 1].y - path[i].y;\n            const segLength = Math.sqrt(dx * dx + dy * dy);\n            \n            if (accumulated + segLength >= targetLength) {\n                const localT = (targetLength - accumulated) / segLength;\n                return {\n                    x: path[i].x + dx * localT,\n                    y: path[i].y + dy * localT\n                };\n            }\n            accumulated += segLength;\n        }\n        return path[path.length - 1];\n    }\n\n    drawNodes(nodes, offsetX, offsetY, cellSize) {\n        const ctx = this.ctx;\n        const radius = cellSize * 0.35;\n        \n        nodes.forEach(node => {\n            const screenX = offsetX + node.x * cellSize + cellSize / 2;\n            const screenY = offsetY + node.y * cellSize + cellSize / 2;\n            \n            ctx.save();\n            ctx.translate(screenX, screenY);\n            \n            if (node.type === 'transformer') {\n                ctx.rotate((node.rotation || 0) * Math.PI / 180);\n            }\n            \n            const powered = node.powered;\n            const overloaded = node.overloaded;\n            \n            let fillColor, glowColor;\n            switch (node.type) {\n                case 'source':\n                    fillColor = powered ? '#66FCF1' : '#1F2833';\n                    glowColor = '#66FCF1';\n                    break;\n                case 'consumer':\n                    fillColor = powered ? '#F4A261' : '#1F2833';\n                    glowColor = '#F4A261';\n                    break;\n                case 'transformer':\n                    fillColor = powered ? '#45A29E' : '#1F2833';\n                    glowColor = '#45A29E';\n                    break;\n                default:\n                    fillColor = '#1F2833';\n                    glowColor = '#66FCF1';\n            }\n            \n            if (overloaded) {\n                fillColor = '#E63946';\n                glowColor = '#E63946';\n            }\n            \n            ctx.shadowColor = glowColor;\n            ctx.shadowBlur = powered || overloaded ? 15 : 0;\n            \n            ctx.fillStyle = fillColor;\n            ctx.beginPath();\n            \n            if (node.type === 'source') {\n                for (let i = 0; i < 6; i++) {\n                    const angle = (i * Math.PI / 3) - Math.PI / 2;\n                    const r = i % 2 === 0 ? radius : radius * 0.5;\n                    const x = Math.cos(angle) * r;\n                    const y = Math.sin(angle) * r;\n                    if (i === 0) ctx.moveTo(x, y);\n                    else ctx.lineTo(x, y);\n                }\n                ctx.closePath();\n            } else if (node.type === 'consumer') {\n                ctx.arc(0, 0, radius, 0, Math.PI * 2);\n            } else if (node.type === 'transformer') {\n                ctx.moveTo(-radius, -radius);\n                ctx.lineTo(radius, -radius);\n                ctx.lineTo(radius, radius);\n                ctx.lineTo(-radius, radius);\n                ctx.closePath();\n                \n                ctx.strokeStyle = '#0B0C10';\n                ctx.lineWidth = 3;\n                ctx.beginPath();\n                ctx.moveTo(-radius * 0.5, 0);\n                ctx.lineTo(radius * 0.5, 0);\n                ctx.moveTo(0, -radius * 0.5);\n                ctx.lineTo(0, radius * 0.5);\n                ctx.stroke();\n            }\n            \n            ctx.fill();\n            \n            ctx.strokeStyle = '#0B0C10';\n            ctx.lineWidth = 2;\n            ctx.stroke();\n            \n            if (node.type === 'source') {\n                ctx.fillStyle = '#0B0C10';\n                ctx.font = 'bold 14px Orbitron';\n                ctx.textAlign = 'center';\n                ctx.textBaseline = 'middle';\n                ctx.fillText('+', 0, 1);\n            } else if (node.type === 'consumer') {\n                ctx.fillStyle = '#0B0C10';\n                ctx.font = 'bold 14px Orbitron';\n                ctx.textAlign = 'center';\n                ctx.textBaseline = 'middle';\n                ctx.fillText('−', 0, 2);\n            }\n            \n            ctx.restore();\n            \n            if (node.connections.length > 0) {\n                ctx.fillStyle = powered ? glowColor : '#66FCF1';\n                ctx.font = '10px Orbitron';\n                ctx.textAlign = 'center';\n                ctx.fillText(node.connections.length.toString(), screenX, screenY - radius - 5);\n            }\n        });\n    }\n\n    drawDraggingWire(draggingWire) {\n        const ctx = this.ctx;\n        ctx.strokeStyle = 'rgba(102, 252, 241, 0.6)';\n        ctx.lineWidth = 3;\n        ctx.lineCap = 'round';\n        ctx.setLineDash([10, 5]);\n        \n        ctx.beginPath();\n        ctx.moveTo(draggingWire.startPos.x, draggingWire.startPos.y);\n        ctx.lineTo(draggingWire.endPos.x, draggingWire.endPos.y);\n        ctx.stroke();\n        \n        ctx.setLineDash([]);\n    }\n}",
  "src/physics.js": "export class Physics {\n    segmentsIntersect(p1, p2, p3, p4) {\n        const denom = (p4.y - p3.y) * (p2.x - p1.x) - (p4.x - p3.x) * (p2.y - p1.y);\n        if (denom === 0) return false;\n        \n        const ua = ((p4.x - p3.x) * (p1.y - p3.y) - (p4.y - p3.y) * (p1.x - p3.x)) / denom;\n        const ub = ((p2.x - p1.x) * (p1.y - p3.y) - (p2.y - p1.y) * (p1.x - p3.x)) / denom;\n        \n        return ua > 0 && ua < 1 && ub > 0 && ub < 1;\n    }\n\n    segmentRectIntersect(p1, p2, rect) {\n        const left = rect.x;\n        const right = rect.x + rect.w;\n        const top = rect.y;\n        const bottom = rect.y + rect.h;\n        \n        if (this.lineIntersectsLine(p1, p2, { x: left, y: top }, { x: right, y: top })) return true;\n        if (this.lineIntersectsLine(p1, p2, { x: right, y: top }, { x: right, y: bottom })) return true;\n        if (this.lineIntersectsLine(p1, p2, { x: right, y: bottom }, { x: left, y: bottom })) return true;\n        if (this.lineIntersectsLine(p1, p2, { x: left, y: bottom }, { x: left, y: top })) return true;\n        \n        if (p1.x > left && p1.x < right && p1.y > top && p1.y < bottom) return true;\n        if (p2.x > left && p2.x < right && p2.y > top && p2.y < bottom) return true;\n        \n        return false;\n    }\n\n    lineIntersectsLine(p1, p2, p3, p4) {\n        const denom = (p4.y - p3.y) * (p2.x - p1.x) - (p4.x - p3.x) * (p2.y - p1.y);\n        if (denom === 0) return false;\n        \n        const ua = ((p4.x - p3.x) * (p1.y - p3.y) - (p4.y - p3.y) * (p1.x - p3.x)) / denom;\n        const ub = ((p2.x - p1.x) * (p1.y - p3.y) - (p2.y - p1.y) * (p1.x - p3.x)) / denom;\n        \n        return ua >= 0 && ua <= 1 && ub >= 0 && ub <= 1;\n    }\n}",
  "src/ui.js": "export class UI {\n    constructor() {\n        this.listeners = {};\n        this.toastEl = null;\n        this.init();\n    }\n\n    init() {\n        this.createScreens();\n        this.bindEvents();\n    }\n\n    createScreens() {\n        const overlay = document.getElementById('ui-overlay');\n        \n        const menuScreen = document.createElement('div');\n        menuScreen.id = 'screen-menu';\n        menuScreen.className = 'screen';\n        menuScreen.innerHTML = `\n            <h1>OVERLOAD</h1>\n            <p>Connect sources to consumers. Avoid wire crossings and walls.</p>\n            <div class=\"menu-grid\" id=\"level-grid\"></div>\n            <button class=\"btn-secondary\" id=\"btn-settings\">Settings</button>\n        `;\n        \n        const pauseScreen = document.createElement('div');\n        pauseScreen.id = 'screen-pause';\n        pauseScreen.className = 'screen';\n        pauseScreen.innerHTML = `\n            <h1>PAUSED</h1>\n            <button class=\"btn-primary\" id=\"btn-resume\">Resume</button>\n            <button class=\"btn-secondary\" id=\"btn-restart-pause\">Restart</button>\n            <button class=\"btn-secondary\" id=\"btn-menu-pause\">Main Menu</button>\n        `;\n        \n        const victoryScreen = document.createElement('div');\n        victoryScreen.id = 'screen-victory';\n        victoryScreen.className = 'screen';\n        victoryScreen.innerHTML = `\n            <h1>CIRCUIT COMPLETE</h1>\n            <p id=\"victory-stats\"></p>\n            <button class=\"btn-primary\" id=\"btn-next\">Next Level</button>\n            <button class=\"btn-secondary\" id=\"btn-replay\">Replay</button>\n            <button class=\"btn-secondary\" id=\"btn-menu-victory\">Level Select</button>\n        `;\n        \n        const settingsScreen = document.createElement('div');\n        settingsScreen.id = 'screen-settings';\n        settingsScreen.className = 'screen';\n        settingsScreen.innerHTML = `\n            <h1>SETTINGS</h1>\n            <div class=\"settings-row\">\n                <span>Sound Effects</span>\n                <input type=\"checkbox\" class=\"toggle\" id=\"toggle-sfx\" checked>\n            </div>\n            <div class=\"settings-row\">\n                <span>Music</span>\n                <input type=\"checkbox\" class=\"toggle\" id=\"toggle-music\" checked>\n            </div>\n            <div class=\"settings-row\">\n                <span>Particle Effects</span>\n                <input type=\"checkbox\" class=\"toggle\" id=\"toggle-particles\" checked>\n            </div>\n            <div class=\"settings-row\">\n                <span>High Contrast</span>\n                <input type=\"checkbox\" class=\"toggle\" id=\"toggle-contrast\">\n            </div>\n            <button class=\"btn-secondary\" id=\"btn-back-settings\">Back</button>\n        `;\n        \n        const levelSelectScreen = document.createElement('div');\n        levelSelectScreen.id = 'screen-level-select';\n        levelSelectScreen.className = 'screen';\n        levelSelectScreen.innerHTML = `\n            <h1>SELECT LEVEL</h1>\n            <div class=\"menu-grid\" id=\"level-select-grid\"></div>\n            <button class=\"btn-secondary\" id=\"btn-back-levels\">Back</button>\n        `;\n        \n        overlay.appendChild(menuScreen);\n        overlay.appendChild(pauseScreen);\n        overlay.appendChild(victoryScreen);\n        overlay.appendChild(settingsScreen);\n        overlay.appendChild(levelSelectScreen);\n        \n        this.screens = {\n            menu: menuScreen,\n            pause: pauseScreen,\n            victory: victoryScreen,\n            settings: settingsScreen,\n            level_select: levelSelectScreen\n        };\n        \n        this.toastEl = document.createElement('div');\n        this.toastEl.className = 'toast';\n        document.body.appendChild(this.toastEl);\n    }\n\n    bindEvents() {\n        document.getElementById('btn-start').addEventListener('click', () => this.emit('start'));\n        document.getElementById('btn-resume').addEventListener('click', () => this.emit('pause'));\n        document.getElementById('btn-restart-pause').addEventListener('click', () => this.emit('restart'));\n        document.getElementById('btn-menu-pause').addEventListener('click', () => this.emit('menu'));\n        document.getElementById('btn-next').addEventListener('click', () => this.emit('nextLevel'));\n        document.getElementById('btn-replay').addEventListener('click', () => this.emit('restart'));\n        document.getElementById('btn-menu-victory').addEventListener('click', () => this.emit('menu'));\n        document.getElementById('btn-settings').addEventListener('click', () => this.showScreen('settings'));\n        document.getElementById('btn-back-settings').addEventListener('click', () => this.showScreen('menu'));\n        document.getElementById('btn-back-levels').addEventListener('click', () => this.showScreen('menu'));\n        \n        document.getElementById('toggle-sfx').addEventListener('change', e => {\n            localStorage.setItem('overload_sfx', e.target.checked);\n        });\n        document.getElementById('toggle-music').addEventListener('change', e => {\n            localStorage.setItem('overload_music', e.target.checked);\n        });\n        document.getElementById('toggle-particles').addEventListener('change', e => {\n            localStorage.setItem('overload_particles', e.target.checked);\n        });\n        document.getElementById('toggle-contrast').addEventListener('change', e => {\n            document.body.classList.toggle('high-contrast', e.target.checked);\n            localStorage.setItem('overload_contrast', e.target.checked);\n        });\n        \n        const savedContrast = localStorage.getItem('overload_contrast') === 'true';\n        if (savedContrast) {\n            document.body.classList.add('high-contrast');\n            document.getElementById('toggle-contrast').checked = true;\n        }\n    }\n\n    on(event, callback) {\n        if (!this.listeners[event]) this.listeners[event] = [];\n        this.listeners[event].push(callback);\n    }\n\n    emit(event, data) {\n        if (this.listeners[event]) {\n            this.listeners[event].forEach(cb => cb(data));\n        }\n    }\n\n    showScreen(name) {\n        this.hideScreens();\n        if (this.screens[name]) {\n            this.screens[name].classList.add('active');\n        }\n    }\n\n    hideScreens() {\n        Object.values(this.screens).forEach(s => s.classList.remove('active'));\n    }\n\n    showLevelSelect(totalLevels, unlocked) {\n        const grid = document.getElementById('level-select-grid');\n        grid.innerHTML = '';\n        \n        for (let i = 0; i < totalLevels; i++) {\n            const btn = document.createElement('button');\n            btn.className = 'level-btn';\n            btn.textContent = i + 1;\n            \n            if (i + 1 > unlocked) {\n                btn.classList.add('locked');\n            } else {\n                const best = JSON.parse(localStorage.getItem('overload_best_times') || '{}')[i];\n                if (best) {\n                    btn.classList.add('completed');\n                    btn.title = `Best: ${best.toFixed(1)}s`;\n                }\n                btn.addEventListener('click', () => this.emit('levelSelect', i));\n            }\n            \n            grid.appendChild(btn);\n        }\n        \n        this.showScreen('level_select');\n    }\n\n    showVictory(game) {\n        const stats = document.getElementById('victory-stats');\n        const best = game.bestTimes[game.currentLevel] || game.elapsedTime;\n        stats.innerHTML = `\n            Time: <strong>${game.elapsedTime.toFixed(1)}s</strong><br>\n            Best: <strong>${best.toFixed(1)}s</strong><br>\n            Moves: <strong>${game.moves}</strong>\n        `;\n        \n        const nextBtn = document.getElementById('btn-next');\n        if (game.currentLevel + 1 >= game.levels.data.length) {\n            nextBtn.style.display = 'none';\n        } else {\n            nextBtn.style.display = 'inline-block';\n        }\n        \n        this.showScreen('victory');\n    }\n\n    updateHUD(game) {\n        let hud = document.getElementById('hud');\n        if (!hud) {\n            hud = document.createElement('div');\n            hud.id = 'hud';\n            hud.className = 'hud';\n            document.getElementById('ui-overlay').prepend(hud);\n        }\n        \n        hud.innerHTML = `\n            <div class=\"hud-item\">\n                <span class=\"hud-label\">LEVEL</span>\n                <span class=\"hud-value\">${game.currentLevel + 1} / ${game.levels.data.length}</span>\n            </div>\n            <div class=\"hud-item\">\n                <span class=\"hud-label timer\" id=\"timer\">${game.elapsedTime.toFixed(1)}s</span>\n            </div>\n            <div class=\"hud-item\">\n                <span class=\"hud-label\">MOVES</span>\n                <span class=\"hud-value\">${game.moves}</span>\n            </div>\n            <button class=\"btn-pause\" id=\"btn-pause\">⏸</button>\n        `;\n        \n        document.getElementById('btn-pause').addEventListener('click', () => this.emit('pause'));\n    }\n\n    showToast(message, success = false) {\n        this.toastEl.textContent = message;\n        this.toastEl.className = 'toast' + (success ? ' success' : '');\n        this.toastEl.classList.add('show');\n        \n        setTimeout(() => {\n            this.toastEl.classList.remove('show');\n        }, 3000);\n    }\n}",
  "src/assets.js": "export class Assets {\n    constructor() {\n        this.audioCtx = null;\n        this.sounds = {};\n        this.enabled = localStorage.getItem('overload_sfx') !== 'false';\n        this.initAudio();\n    }\n\n    initAudio() {\n        try {\n            this.audioCtx = new (window.AudioContext || window.webkitAudioContext)();\n            this.createSounds();\n        } catch (e) {\n            console.warn('Web Audio API not supported');\n        }\n    }\n\n    createSounds() {\n        this.sounds = {\n            wire_start: this.createTone(440, 0.1, 'sine', 0.3),\n            wire_connect: this.createTone(660, 0.2, 'sine', 0.4),\n            wire_cancel: this.createTone(220, 0.15, 'sawtooth', 0.3),\n            rotate: this.createTone(550, 0.1, 'square', 0.2),\n            victory: this.createVictorySound(),\n            error: this.createTone(150, 0.3, 'sawtooth', 0.4)\n        };\n    }\n\n    createTone(frequency, duration, type = 'sine', volume = 0.3) {\n        return () => {\n            if (!this.enabled || !this.audioCtx) return;\n            \n            const oscillator = this.audioCtx.createOscillator();\n            const gainNode = this.audioCtx.createGain();\n            \n            oscillator.type = type;\n            oscillator.frequency.value = frequency;\n            \n            gainNode.gain.setValueAtTime(volume, this.audioCtx.currentTime);\n            gainNode.gain.exponentialRampToValueAtTime(0.01, this.audioCtx.currentTime + duration);\n            \n            oscillator.connect(gainNode);\n            gainNode.connect(this.audioCtx.destination);\n            \n            oscillator.start();\n            oscillator.stop(this.audioCtx.currentTime + duration);\n        };\n    }\n\n    createVictorySound() {\n        return () => {\n            if (!this.enabled || !this.audioCtx) return;\n            \n            const notes = [523.25, 659.25, 783.99, 1046.50];\n            notes.forEach((freq, i) => {\n                const osc = this.audioCtx.createOscillator();\n                const gain = this.audioCtx.createGain();\n                \n                osc.type = 'sine';\n                osc.frequency.value = freq;\n                \n                const time = this.audioCtx.currentTime + i * 0.1;\n                gain.gain.setValueAtTime(0.3, time);\n                gain.gain.exponentialRampToValueAtTime(0.01, time + 0.4);\n                \n                osc.connect(gain);\n                gain.connect(this.audioCtx.destination);\n                \n                osc.start(time);\n                osc.stop(time + 0.5);\n            });\n        };\n    }\n\n    playSound(name) {\n        if (this.sounds[name]) {\n            this.sounds[name]();\n        }\n    }\n\n    resumeAudio() {\n        if (this.audioCtx && this.audioCtx.state === 'suspended') {\n            this.audioCtx.resume();\n        }\n    }\n\n    setEnabled(enabled) {\n        this.enabled = enabled;\n        localStorage.setItem('overload_sfx', enabled);\n    }\n}",
  "src/levels.js": "export class Levels {\n    constructor() {\n        this.data = [\n            {\n                width: 6,\n                height: 6,\n                nodes: [\n                    { id: 0, x: 0, y: 2, type: 'source' },\n                    { id: 1, x: 5, y: 2, type: 'consumer' }\n                ],\n                walls: []\n            },\n            {\n                width: 6,\n                height: 6,\n                nodes: [\n                    { id: 0, x: 0, y: 1, type: 'source' },\n                    { id: 1, x: 0, y: 4, type: 'source' },\n                    { id: 2, x: 5, y: 1, type: 'consumer' },\n                    { id: 3, x: 5, y: 4, type: 'consumer' }\n                ],\n                walls: []\n            },\n            {\n                width: 7,\n                height: 7,\n                nodes: [\n                    { id: 0, x: 0, y: 3, type: 'source' },\n                    { id: 1, x: 6, y: 3, type: 'consumer' },\n                    { id: 2, x: 3, y: 0, type: 'consumer' },\n                    { id: 3, x: 3, y: 6, type: 'consumer' }\n                ],\n                walls: []\n            },\n            {\n                width: 8,\n                height: 6,\n                nodes: [\n                    { id: 0, x: 1, y: 1, type: 'source' },\n                    { id: 1, x: 1, y: 4, type: 'source' },\n                    { id: 2, x: 6, y: 1, type: 'consumer' },\n                    { id: 3, x: 6, y: 4, type: 'consumer' }\n                ],\n                walls: [\n                    { x: 3, y: 2 },\n                    { x: 3