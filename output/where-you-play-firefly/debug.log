  width: 40px;\n            height: 40px;\n            border-radius: 50%;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            font-size: 20px;\n            opacity: 0.4;\n            transition: all 0.3s ease;\n            border: 2px solid currentColor;\n        }\n        \n        .section-icon.active {\n            opacity: 1;\n            box-shadow: 0 0 15px currentColor;\n        }\n        \n        .section-icon.strings { color: #ff9500; }\n        .section-icon.woodwinds { color: #20b2aa; }\n        .section-icon.brass { color: #ffd700; }\n        .section-icon.percussion { color: #e0e0e0; }\n        \n        .title-screen, .results-screen {\n            position: absolute;\n            top: 0;\n            left: 0;\n            width: 100%;\n            height: 100%;\n            display: flex;\n            flex-direction: column;\n            align-items: center;\n            justify-content: center;\n            background: radial-gradient(ellipse at center, rgba(26, 26, 46, 0.95) 0%, rgba(10, 10, 26, 0.98) 100%);\n            pointer-events: auto;\n            z-index: 100;\n        }\n        \n        .title-screen h1 {\n            font-family: 'Cormorant Garamond', serif;\n            font-size: 64px;\n            font-weight: 600;\n            color: #ffcc00;\n            text-shadow: 0 0 30px rgba(255, 204, 0, 0.6), 0 0 60px rgba(255, 204, 0, 0.3);\n            margin-bottom: 10px;\n            letter-spacing: 4px;\n        }\n        \n        .title-screen .subtitle {\n            font-size: 18px;\n            color: rgba(255, 255, 255, 0.6);\n            margin-bottom: 50px;\n            letter-spacing: 6px;\n            text-transform: uppercase;\n        }\n        \n        .start-btn {\n            padding: 15px 50px;\n            font-family: 'Quicksand', sans-serif;\n            font-size: 18px;\n            color: #0a0a1a;\n            background: linear-gradient(135deg, #ff