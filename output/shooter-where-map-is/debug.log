export class CombatSystem {
  constructor(game) {
    this.game = game;
  }
  
  update(dt) {
    // Player bullets vs enemies
    for (const proj of this.game.projectiles) {
      if (proj.dead) continue;
      for (const enemy of this.game.enemies) {
        if (enemy.dead) continue;
        const dx = proj.x - enemy.x;
        const dy = proj.y - enemy.y;
        const dist = Math.sqrt(dx * dx + dy * dy);
        if (dist < enemy.radius + proj.radius) {
          enemy.takeDamage(10);
          proj.dead = true;
          this.game.addParticles(proj.x, proj.y, '#00ffff', 5);
          if (enemy.dead) {
            this.game.score += enemy.scoreValue;
            this.game.addParticles(enemy.x, enemy.y, enemy.color, 15);
            this.game.audio.play('explosion');
            // Chance to drop powerup
            if (Math.random() < 0.15) {
              const types = ['health', 'rapidFire', 'shield'];
              this.game.powerups.push(new PowerUp(enemy.x, enemy.y, types[Math.floor(Math.random() * 3)]));
            }
          }
          break;
        }
      }
    }
    
    // Enemy bullets vs player (handled in enemy update via enemy shooting)
    // Enemy contact damage
    for (const enemy of this.game.enemies) {
      if (enemy.dead) continue;
      const dx = enemy.x - this.game.player.x;
      const dy = enemy.y - this.game.player.y;
      const dist = Math.sqrt(dx * dx + dy * dy);
      if (dist < enemy.radius + this.game.player.radius) {
        this.game.player.takeDamage(enemy.type === 'tank' ? 20 : 10);
        // Knockback
        const knockDir = { x: dx / dist, y: dy / dist };
        this.game.player.vx += knockDir.x * 200;
        this.game.player.vy += knockDir.y * 200;
      }
    }
    
    // Clean up dead entities
    this.game.enemies = this.game.enemies.filter(e => !e.dead);
    this.game.projectiles = this.game.projectiles.filter(p => !p.dead);
  }
}


