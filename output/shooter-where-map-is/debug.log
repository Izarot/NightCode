// src/entities/player.js
import { Physics } from '../core/physics.js';

export class Player {
  constructor(game) {
    this.game = game;
    this.x = 500;
    this.y = 500;
    this.vx = 0;
    this.vy = 0;
    this.radius = 12;
    this.health = 100;
    this.maxHealth = 100;
    this.fireRate = 0.15; // seconds between shots
    this.fireCooldown = 0;
    this.rapidFire = false;
    this.rapidFireTimer = 0;
    this.shield = false;
    this.shieldTimer = 0;
    this.trail = []; // motion blur trail
    this.aimAngle = 0;
  }
  
  update(dt) {
    // Input
    const input = this.game.input;
    let ax = 0, ay = 0;
    if (input.isDown('w') || input.isDown('arrowup')) ay -= 1;
    if (input.isDown('s') || input.isDown('arrowdown')) ay += 1;
    if (input.isDown('a') || input.isDown('arrowleft')) ax -= 1;
    if (input.isDown('d') || input.isDown('arrowright')) ax += 1;
    
    // Normalize diagonal
    if (ax !== 0 && ay !== 0) {
      ax *= 0.707;
      ay *= 0.707;
    }
    
    // Acceleration
    const accel = 1500;
    this.vx += ax * accel * dt;
    this.vy += ay * accel * dt;
    
    // Friction
    const friction = 0.85;
    const frictionFactor = Math.pow(friction, dt * 60); // frame-rate independent
    this.vx *= frictionFactor;
    this.vy *= frictionFactor;
    
    // Cap speed
    const maxSpeed = 320;
    const speed = Math.sqrt(this.vx * this.vx + this.vy * this.vy);
    if (speed > maxSpeed) {
      this.vx = (this.vx / speed) * maxSpeed;
      this.vy = (this.vy / speed) * maxSpeed;
    }
    
    // Update position
    this.x += this.vx * dt;
    this.y += this.vy * dt;
    
    // Collision with square bounds
    const collision = Physics.resolveSquareCollision(
      this.x, this.y,
      this.game.centerX, this.game.centerY,
      this.game.playArea, this.game.centerX, this.game.centerY,
      this.game.playArea,
      this.radius);
    if (collision) {
      this.x = collision.x;
      this.y = collision.y;
    }
    
    // Update trail
    this.trail.push({ x: this.x, y: this.y });
    if (this.trail.length > 8) this.trail.shift();
    
    // Aiming
    const mouseX = this.game.input.mouseX;
    const mouseY = this.game.input.mouseY;
    this.aimAngle = Math.atan2(mouseY - this.y, mouseX - this.x);
    
    // Shooting
    this.fireCooldown -= dt;
    if (this.fireCooldown <= 0 && (input.isDown(' ') || input.isDown('j'))) {
      this.shoot();
      this.fireCooldown = this.rapidFire ? 0.06 : this.fireRate;
    }
    
    // Timers
    if (this.rapidFireTimer > 0) {
      this.rapidFireTimer -= dt;
      if (this.rapidFireTimer <= 0) this.rapidFire = false;
    }
    if (this.shieldTimer > 0) {
      this.shieldTimer -= dt;
      if (this.shieldTimer <= 0) this.shield = false;
    }
  }
  
  shoot() {
    const spread = this.rapidFire ? 12 : 15;
    const angleOffset = (Math.random() - 0.5) * (spread * Math.PI / 180);
    const baseAngle = this.aimAngle + angleOffset;
    
    for (let i = -1; i <= 1; i++) {
      const a = baseAngle + i * (5 * Math.PI / 180);
      this.game.projectiles.push(new Projectile(
        this.x + Math.cos(a) * 20,
        this.y + Math.sin(a) * 20,
        Math.cos(a) * 600,
        Math.sin(a) * 600
      ));
    }
    
    this.game.audio.play('shoot');
  }
  
  takeDamage(amount) {
    if (this.shield) {
      this.game.audio.play('shield');
      this.game.addParticles(this.x, this.y, '#00ffff', 8);
      return;
    }
    this.health -= amount;
    this.game.audio.play('hit');
    this.game.screenShake.trigger(5);
    this.game.addParticles(this.x, this.y, '#ff0044', 10);
  }
  
  render(ctx) {
    // Trail
    for (let i = 0; i < this.trail.length; i++) {
      const t = this.trail[i];
      const alpha = (i / this.trail.length) * 0.3;
      ctx.fillStyle = `rgba(0, 255, 255, ${alpha})`;
      ctx.beginPath();
      ctx.arc(t.x, t.y, this.radius * (i / this.trail.length), 0, Math.PI * 2);
      ctx.fill();
    }
    
    // Shield
    if (this.shield) {
      ctx.strokeStyle = 'rgba(0, 255, 255, 0.5)';
      ctx.lineWidth = 2;
      ctx.beginPath();
      ctx.arc(this.x, this.y, this.radius + 6, 0, Math.PI * 2);
      ctx.stroke();
    }
    
    // Player body
    ctx.save();
    ctx.translate(this.x, this.y);
    ctx.rotate(this.aimAngle);
    
    ctx.fillStyle = '#00ffff';
    ctx.strokeStyle = '#ffffff';
    ctx.lineWidth = 1.5;
    ctx.shadowColor = '#00ffff';
    ctx.shadowBlur = 10;
    
    ctx.beginPath();
    ctx.moveTo(this.radius, 0);
    ctx.lineTo(-this.radius * 0.7, -this.radius * 0.7);
    ctx.lineTo(-this.radius * 0.4, 0);
    ctx.lineTo(-this.radius * 0.7, this.radius * 0.7);
    ctx.closePath();
    ctx.fill();
    ctx.stroke();
    
    ctx.restore();
  }
}


