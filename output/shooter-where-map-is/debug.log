// src/systems/spawning.js
export class SpawningSystem {
  constructor(game) {
    this.game = game;
    this.spawnTimer = 3;
    this.spawnInterval = 2.5;
    this.maxEnemies = 8;
  }
  
  update(dt) {
    this.spawnTimer -= dt;
    if (this.spawnTimer <= 0 && this.game.enemies.length < this.maxEnemies) {
      this.spawnWave();
      this.spawnTimer = this.spawnInterval;
    }
  }
  
  spawnWave() {
    const count = Math.floor(Math.random() * 3) + 2;
    for (let i = 0; i < count; i++) {
      const side = Math.floor(Math.random() * 4);
      let x, y;
      switch (side) {
        case 0: x = -20; y = Math.random() * 800 + 100; break;
        case 1: x = 1020; y = Math.random() * 800 + 100; break;
        case 2: x = Math.random() * 800 + 100; y = -20; break;
        case 3: x = Math.random() * 800 + 100; y = 1020; break;
      }
      const type = Math.random() < 0.6 ? 'drone' : 'tank';
      this.game.enemies.push(new Enemy(x, y, type));
    }
  }
}


