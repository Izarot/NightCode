// src/core/rotation.js
export class RotationManager {
  constructor() {
    this.cycleDuration = 8; // seconds between rotations
    this.warningDuration = 1.5; // seconds before rotation
    this.rotationDuration = 0.5; // seconds for rotation transition
    this.currentAngle = 0;
    this.targetAngle = 0;
    this.warningTimer = 0;
    this.rotationTimer = 0;
    this.isWarning = false;
    this.isRotating = false;
    this.nextRotationTime = this.cycleDuration;
  }
  
  update(dt) {
    if (!this.isRotating) {
      this.nextRotationTime -= dt;
      if (this.nextRotationTime <= 0) {
        this.isWarning = true;
        this.warningTimer = this.warningDuration;
      }
      if (this.isWarning) {
        this.warningTimer -= dt;
        if (this.warningTimer <= 0) {
          this.isRotating = true;
          this.rotationTimer = this.rotationDuration;
          this.currentAngle += Math.PI / 2; // 90 degrees clockwise
          this.targetAngle = this.currentAngle;
        }
      }
    } else {
      this.rotationTimer -= dt;
      // Interpolate angle
      const t = 1 - (this.rotationTimer / this.rotationDuration);
      this.currentAngle = this.lerp(this.startAngle, this.targetAngle, t);
      if (this.rotationTimer <= 0) {
        this.isRotating = false;
        this.isWarning = false;
        this.nextRotationTime = this.cycleDuration;
      }
    }
  }
  
  get progress() {
    // 0 to 1 progress through the warning phase
    if (this.isWarning) {
      return 1 - (this.warningTimer / this.warningDuration);
    }
    return 0;
  }
  
  get rotationProgress() {
    // 0 to 1 progress through the rotation phase
    if (this.isRotating) {
      return 1 - (this.rotationTimer / this.rotationDuration);
    }
    return 0;
  }
  
  get countdown() {
    // Time remaining until rotation (for HUD)
    if (this.isWarning) {
      return this.warningTimer;
    }
    return this.nextRotationTime;
  }
}
