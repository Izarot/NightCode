// src/systems/rendering.js
export class RenderingSystem {
  constructor(game) {
    this.game = game;
  }
  
  render(ctx) {
    const { canvas, ctx: c, rotation, screenShake } = this.game;
    
    // Background grid
    this.renderBackground(c);
    
    // Apply screen shake
    const shakeX = screenShake.offsetX;
    const shakeY = screenShake.offsetY;
    
    c.save();
    c.translate(shakeX, shakeY);
    
    // Render cube face
    this.renderCubeFace(c);
    
    // Render spawn points
    this.renderSpawnPoints(c);
    
    // Render enemies
    for (const enemy of this.game.enemies) {
      enemy.render(c);
    }
    
    // Render powerups
    for (const pu of this.game.powerups) {
      pu.render(c);
    }
    
    // Render player
    this.game.player.render(c);
    
    // Render projectiles
    for (const proj of this.game.projectiles) {
      proj.render(c);
    }
    for (const proj of this.game.enemyProjectiles) {
      proj.render(c);
    }
    
    // Render particles
    for (const p of this.game.particles) {
      p.render(c);
    }
    
    // Render warning arc
    if (rotation.isWarning) {
      this.renderWarningArc(c);
    }
    
    // Render rotation progress
    if (rotation.isRotating) {
      this.renderRotationProgress(c);
    }
    
    c.restore();
    
    // HUD (no shake)
    this.renderHUD(c);
  }
  
  renderBackground(ctx) {
    ctx.fillStyle = '#050508';
    ctx.fillRect(0, 0, 1000, 1000);
    
    // Grid
    ctx.strokeStyle = 'rgba(0, 255, 255, 0.05)';
    ctx.lineWidth = 1;
    for (let x = 0; x <= 1000; x += 50) {
      ctx.beginPath();
      ctx.moveTo(x, 0);
      ctx.lineTo(x, 1000);
      ctx.stroke();
    }
    for (let y = 0; y <= 1000; y += 50) {
      ctx.beginPath();
      ctx.moveTo(0, y);
      ctx.lineTo(1000, y);
      ctx.stroke();
    }
  }
  
  renderCubeFace(ctx) {
    const cx = this.game.centerX;
    const cy = this.game.centerY;
    const size = this.game.playArea;
    const half = size / 2;
    const angle = this.game.rotation.angle;
    
    ctx.save();
    ctx.translate(cx, cy);
    ctx.rotate(angle);
    
    // Fill interior
    ctx.fillStyle = 'rgba(0, 20, 40, 0.6)';
    ctx.fillRect(-half, -half, size, size);
    
    // Border
    ctx.strokeStyle = '#00ffff';
    ctx.lineWidth = 2;
    ctx.shadowColor = '#00ffff';
    ctx.shadowBlur = 10;
    ctx.strokeRect(-half, -half, size, size);
    
    //