// src/entities/enemy.js
import { Physics } from '../core/physics.js';

export class Enemy {
  constructor(x, y, type) {
    this.x = x;
    this.y = y;
    this.type = type;
    this.vx = 0;
    this.vy = 0;
    this.angle = 0;
    this.hitFlash = 0;
    this.dead = false;
    
    switch (type) {
      case 'drone':
        this.health = 20;
        this.maxHealth = 20;
        this.speed = 180;
        this.radius = 10;
        this.scoreValue = 100;
        this.color = '#ff4466';
        break;
      case 'tank':
        this.health = 60;
        this.maxHealth = 60;
        this.speed = 60;
        this.radius = 18;
        this.scoreValue = 300;
        this.color = '#ff8800';
        break;
    }
  }
  
  update(dt, player) {
    const dx = player.x - this.x;
    const dy = player.y - this.y;
    const dist = Math.sqrt(dx * dx + dy * dy);
    
    switch (this.type) {
      case 'drone':
        if (dist > 0) {
          this.vx = (dx / dist) * this.speed;
          this.vy = (dy / dist) * this.speed;
        }
        break;
      case 'tank':
        const targetDist = 250;
        if (dist > targetDist) {
          this.vx = (dx / dist) * this.speed;
          this.vy = (dy / dist) * this.speed;
        } else if (dist < targetDist - 50) {
          this.vx = -(dx / dist) * this.speed;
          this.vy = -(dy / dist) * this.speed;
        } else {
          const wobble = Math.sin(Date.now() * 0.003) * 0.5;
          this.vx = (dx / dist) * this.speed * 0.3 + Math.cos(wobble) * 30;
          this.vy = (dy / dist) * this.speed * 0.3 + Math.sin(wobble) * 30;
        }
        break;
    }
    
    this.x += this.vx * dt;
    this.y += this.vy * dt;
    
    this.angle = Math.atan2(this.vy, this.vx);
    
    if (this.hitFlash > 0) this.hitFlash -= dt;
  }
  
  takeDamage(amount) {
    this.health -= amount;
    this.hitFlash = 0.1;
    if (this.health <= 0) {
      this.dead = true;
    }
  }
  
  render(ctx) {
    ctx.save();
    ctx.translate(this.x, this.y);
    ctx.rotate(this.angle);
    
    if (this.hitFlash > 0) {
      ctx.fillStyle = '#ffffff';
    } else {
      ctx.fillStyle = this.color;
    }
    ctx.strokeStyle = '#ffffff';
    ctx.lineWidth = 1;
    ctx.shadowColor = this.color;
    ctx.shadowBlur = 8;
    
    switch (this.type) {
      case 'drone':
        ctx.beginPath();
        ctx.moveTo(this.radius, 0);
        ctx.lineTo(0, -this.radius * 0.6);
        ctx.lineTo(-this.radius * 0.6, 0);
        ctx.lineTo(0, this.radius * 0.6);
        ctx.closePath();
        ctx.fill();
        ctx.stroke();
        break;
      case 'tank':
        ctx.beginPath();
        ctx.rect(-this.radius, -this.radius * 0.7, this.radius * 2, this.radius * 1.4);
        ctx.fill();
        ctx.stroke();
        // Turret
        ctx.beginPath();
        ctx.moveTo(0, 0);
        ctx.lineTo(this.radius * 0.8, 0);
        ctx.stroke();
        break;
    }
    
    ctx.restore();
    
    // Health bar
    if (this.health < this.maxHealth) {
      const barW = this.radius * 2;
      const barH = 3;
      ctx.fillStyle = 'rgba(0, 0, 0, 0.5)';
      ctx.fillRect(this.x - barW / 2, this.y - this.radius - 8, barW, barH);
      ctx.fillStyle = '#00ff88';
      ctx.fillRect(this.x - barW / 2, this.y - this.radius - 8, barW * (this.health / this.maxHealth), barH);
    }
  }
}


