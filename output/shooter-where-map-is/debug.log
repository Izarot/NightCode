Actually, for a simple approach: transform to local frame, clamp to [-halfSize, halfSize], transform back. This gives smooth sliding behavior.

```javascript
static resolveSquareCollision(px, py, cx, cy, halfSize, angle, radius) {
  const cos = Math.cos(-angle);
  const sin = Math.sin(-angle);
  const dx = px - cx;
  const dy = py - cy;
  const localX = dx * cos - dy * sin;
  const localY = dx * sin + dy * cos;
  
  const limit = halfSize - radius; // Account for player radius
  let newLocalX = localX;
  let newLocalY = localY;
  
  if (localX > limit) newLocalX = limit;
  else if (localX < -limit) newLocalX = -limit;
  
  if (localY > limit) newLocalY = limit;
  else if (localY < -limit) newLocalY = -limit;
  
  // Transform back
  const worldCos = Math.cos(angle);
  const worldSin = Math.sin(angle);
  const worldX = cx + newLocalX * worldCos - newLocalY * worldSin;
  const worldY = cy + newLocalX * worldSin + newLocalY * worldCos;
  
  return { x: worldX, y: worldY };
}
```

