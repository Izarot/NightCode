export class RotationManager {
  constructor() {
    this.cycleDuration = 8;
    this.warningDuration = 1.5;
    this.rotationDuration = 0.5;
    this.angle = 0;
    this.phase = 'normal'; // 'normal', 'warning', 'rotating'
    this.phaseTimer = this.cycleDuration;
    this.warningStart = 0;
    this.warningEnd = 0;
    this.rotationStart = 0;
    this.rotationEnd = 0;
  }
  
  update(dt) {
    this.phaseTimer -= dt;
    
    switch (this.phase) {
      case 'normal':
        if (this.phaseTimer <= this.cycleDuration - this.warningDuration) {
          this.phase = 'warning';
          this.warningStart = this.phaseTimer;
          this.warningEnd = this.warningStart + this.warningDuration;
        }
        break;
      case 'warning':
        if (this.phaseTimer <= 0) {
          this.phase = 'rotating';
          this.rotationStart = this.angle;
          this.rotationEnd = this.angle + Math.PI / 2;
          this.phaseTimer = this.rotationDuration;
        }
        break;
      case 'rotating':
        const t = 1 - (this.phaseTimer / this.rotationDuration);
        this.angle = this.lerp(this.rotationStart, this.rotationEnd, t);
        if (this.phaseTimer <= 0) {
          this.phase = 'normal';
          this.phaseTimer = this.cycleDuration;
        }
        break;
    }
  }
  
  get warningProgress() {
    if (this.phase === 'warning') {
      return 1 - (this.phaseTimer / this.warningDuration);
    }
    return 0;
  }
  
  get rotationProgress() {
    if (this.phase === 'rotating') {
      return 1 - (this.phaseTimer / this.rotationDuration);
    }
    return 0;
  }
  
  get countdown() {
    if (this.phase === 'warning') return this.phaseTimer;
    return this.phaseTimer;
  }
  
  get isWarning() { return this.phase === 'warning'; }
  get isRotating() { return this.phase === 'rotating'; }
}
