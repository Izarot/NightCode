```javascript
// src/core/physics.js
export class Physics {
  static clamp(value, min, max) {
    return Math.max(min, Math.min(max, value));
  }
  
  static lerp(a, b, t) {
    return a + (b - a) * t;
  }
  
  static distance(x1, y1, x2, y2) {
    const dx = x2 - x1;
    const dy = y2 - y1;
    return Math.sqrt(dx * dx + dy * dy);
  }
  
  static checkSquareBounds(px, py, cx, cy, halfSize, angle) {
    // Transform player position into square's local frame
    const cos = Math.cos(-angle);
    const sin = Math.sin(-angle);
    const dx = px - cx;
    const dy = py - cy;
    const localX = dx * cos - dy * sin;
    const localY = dx * sin + dy * cos;
    return Math.abs(localX) <= halfSize && Math.abs(localY) <= halfSize;
  }
  
  static resolveSquareCollision(px, py, cx, cy, halfSize, angle, playerRadius) {
    // Returns adjusted position if collision, null otherwise
    if (!this.checkSquareBounds(px, py, cx, cy, halfSize, angle)) {
      // Transform to local frame
      const cos = Math.cos(-angle);
      const sin = Math.sin(-angle);
      const dx = px - cx;
      const dy = py - cy;
      const localX = dx * cos - dy * sin;
      const localY = dx * sin + dy * cos;
      
      // Push out of the square
      const pushDist = halfSize + playerRadius;
      let newLocalX = localX;
      let newLocalY = localY;
      
      if (Math.abs(localX) > pushDist) {
        newLocalX = Math.sign(localX) * pushDist;
      }
      if (Math.abs(localY) > pushDist) {
        newLocalY = Math.sign(localY) * pushDist;
      }
      
      // Transform back to world frame
      const worldCos = Math.cos(angle);
      const worldSin = Math.sin(angle);
      const worldX = cx + newLocalX * worldCos - newLocalY * worldSin;
      const worldY = cy + newLocalX * worldSin + newLocalY * worldCos;
      
      return { x: worldX, y: worldY };
    }
    return null;
  }
}
```

