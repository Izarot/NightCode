            ctx.shadowColor = CONFIG.TARGET_COLOR;
            ctx.shadowBlur = 10;
            ctx.fillRect(target.x, target.y, 1, 1);
            ctx.shadowBlur = 0;
        }
        
        // Draw walls
        for (const wall of this.walls) {
