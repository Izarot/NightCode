  "game.js": "// BoxWorld - 2D HTML5 Canvas Puzzle Game\n// Features: Responsive canvas, emoji favicon, vibrant color palette,\n// LocalStorage high score saving, Web Audio API sound effects, speedrun timer.\n\n// --- Configuration ---\nconst CONFIG = {\n    GRID_SIZE: 32,           // Cells per row/column\n    CANVAS_WIDTH: 960,\n    CANVAS_HEIGHT: 540,\n    PLAYER_SPEED: 1,         // Cells per second\n    MOVE_DISTANCE: 1,\n    TARGET_COLOR: '#FF6B35', // Vibrant orange for targets\n    PLAYER_COLOR: '#FF6B35',\n    BOX_COLOR: '#00D2FF',    // Cyan for boxes\n    BOX_HEAVY: '#FF6B35',    // Heavy box variant\n    BOX_LIGHT: '#00BFA5',    // Light box variant\n    WALL_COLOR: '#2C3E50',\n    BACKGROUND_COLOR: '#F5E8D0',\n    UI_COLOR: '#3B2F2F',\n    EMOTE_FAVICON: '🎲'\n};\n\n// --- Audio System (Web Audio API) ---\nconst AudioSystem = {\n    ctx: null,\n    init() {\n        this.ctx = new (window.AudioContext || window.webkitAudioContext)();\n    },\n    playTone(freq, duration, type = 'square', volume = 0.1) {\n        if (!this.ctx) return;\n        const osc = this.ctx.createOscillator();\n        const gain = this.ctx.createGain();\n        osc.type = type;\n        osc.frequency.value = freq;\n        gain.gain.setValueAtTime(volume, this.ctx.currentTime);\n        gain.gain.exponentialRampToValueAtTime(0.001, this.ctx.currentTime + duration);\n        osc.connect(gain);\n        gain.connect(this.ctx.destination);\n        osc.start(this.ctx.currentTime);\n        osc.stop(this.ctx.currentTime + duration);\n    },\n    footstep() {\n        if (!this.ctx) return;\n        const osc = this.ctx.createOscillator();\n        const gain = this.ctx.createGain();\n        osc.frequency.setValueAtTime(150, this.ctx.currentTime);\n        osc.frequency.exponentialRampToValueAtTime(100, this.ctx.currentTime + 0.1);\n        gain.gain.setValueAtTime(0.2, this.ctx.currentTime);\n        gain.gain.exponentialRampToValueAtTime(0.01, this.ctx.currentTime + 0.1);\n        osc.connect(gain);\n        gain.connect(this.ctx.destination);\n        osc.start(this.ctx.currentTime);\n        osc.stop(this.ctx.currentTime + 0.1);\n    },\n    boxPush() {\n        if (!this.ctx) return;\n        const osc = this.ctx.createOscillator();\n        const gain = this.ctx.createGain();\n        osc.type = 'triangle';\n        osc.frequency.setValueAtTime(300, this.ctx.currentTime);\n        osc.frequency.exponentialRampToValueAtTime(600, this.ctx.currentTime + 0.3);\n        gain.gain.setValueAtTime(0.15, this.ctx.currentTime);\n        gain.gain.exponentialRampToValueAtTime(0.01, this.ctx.currentTime + 0.3);\n        osc.connect(gain);\n        gain.connect(this.ctx.destination);\n        osc.start(this.ctx.currentTime);\n        osc.stop(this.ctx.currentTime + 0.3);\n    },\n    targetReached() {\n        if (!this.ctx) return;\n        const osc = this.ctx.createOscillator();\n        const gain = this.ctx.createGain();\n        osc.type = 'sine';\n        osc.frequency.setValueAtTime(440, this.ctx.currentTime);\n        gain.gain.setValueAtTime(0.2, this.ctx.currentTime);\n        gain.gain.exponentialRampToValueAtTime(0.01, this.ctx.currentTime + 0.4);\n        osc.connect(gain);\n        gain.connect(this.ctx.destination);\n        osc.start(this.ctx.currentTime);\n        osc.stop(this.ctx.currentTime + 0.4);\n    },\n    gameOver() {\n        if (!this.ctx) return;\n        const osc = this.ctx.createOscillator();\n        const gain = this.ctx.createGain();\n        osc.type = 'sawtooth';\n        osc.frequency.setValueAtTime(220, this.ctx.currentTime);\n        gain.gain.setValueAtTime(0.3, this.ctx.currentTime);\n        gain.gain.exponentialRampToValueAtTime(0.01, this.ctx.currentTime + 1.5);\n        osc.connect(gain);\n        gain.connect(this.ctx.destination);\n        osc.start(this.ctx.currentTime);\n        osc.stop(this.ctx.currentTime + 1.5);\n    },\n    victory() {\n        if (!this.ctx) return;\n        const osc = this.ctx.createOscillator();\n        const gain = this.ctx.createGain();\n        osc.type = 'sine';\n        osc.frequency.setValueAtTime(880, this.ctx.currentTime);\n        gain.gain.setValueAtTime(0.3, this.ctx.currentTime);\n        gain.gain.exponentialRampToValueAtTime(0.01, this.ctx.currentTime + 1.2);\n        osc.connect(gain);\n        gain.connect(this.ctx.destination);\n        osc.start(this.ctx.currentTime);\n        osc.stop(this.ctx.currentTime + 1.2);\n    }\n};\n\n// --- Game State ---\nclass Entity {\n    constructor(x, y, w, h, color, isStatic = false) {\n        this.x = x;\n        this.y = y;\n        this.w = w;\n        this.h = h;\n        this.color = color;\n        this.isStatic = isStatic;\n    }\n}\n\nclass Player extends Entity {\n    constructor() {\n        super(160, 140, 28, 28, CONFIG.PLAYER_COLOR);\n    }\n}\n\nclass Box extends Entity {\n    constructor(x, y) {\n        super(x, y, CONFIG.GRID_SIZE, CONFIG.GRID_SIZE, CONFIG.BOX_COLOR);\n    }\n}\n\nclass Target extends Entity {\n    constructor(x, y) {\n        super(x, y, 1, 1, CONFIG.TARGET_COLOR, true);\n    }\n}\n\nclass Wall extends Entity {\n    constructor(x, y) {\n        super(x, y, 1, 1, CONFIG.WALL_COLOR);\n    }\n}\n\n// --- Game Engine ---\nconst Game = {\n    canvas: null,\n    ctx: null,\n    width: 0,\n    height: 0,\n    gridWidth: CONFIG.GRID_SIZE,\n    gridHeight: CONFIG.GRID_SIZE,\n    player: null,\n    boxes: [],\n    targets: [],\n    walls: [],\n    currentLevel: 1,\n    moves: 0,\n    timeElapsed: 0,\n    highScore: 0,\n    paused: false,\n    running: false,\n    animationId: null,\n    \n    // Initialize\n    init() {\n        this.canvas = document.getElementById('boxworld-canvas');\n        this.ctx = this.canvas.getContext('2d');\n        this.resize();\n        this.loadHighScore();\n        this.setupEventListeners();\n        this.audio.init();\n        this.startGame();\n    },\n    \n    resize() {\n        this.width = CONFIG.CANVAS_WIDTH;\n        this.height = CONFIG.CANVAS_HEIGHT;\n        this.canvas.width = this.width;\n        this.canvas.height = this.height;\n        // Update grid dimensions based on canvas size\n        this.gridWidth = Math.floor(this.width / CONFIG.GRID_SIZE);\n        this.gridHeight = Math.floor(this.height / CONFIG.GRID_SIZE);\n    },\n    \n    loadHighScore() {\n        try {\n            const saved = localStorage.getItem('boxworld_highscore');\n            this.highScore = saved ? parseInt(saved, 10) : 0;\n        } catch (e) {\n            this.highScore = 0;\n        }\n    },\n    \n    saveHighScore() {\n        try {\n            localStorage.setItem('boxworld_highscore', String(this.highScore));\n        } catch (e) {\n            // Ignore storage errors\n        }\n    },\n    \n    setupEventListeners() {\n        // Keyboard controls\n        document.addEventListener('keydown', (e) => {\n            if (this.paused || !this.running) return;\n            switch(e.key) {\n                case 'ArrowUp': case 'w': case 'W':\n                    e.preventDefault();\n                    this.move(-1, 0);\n                    break;\n                case 'ArrowDown': case 's': case 'S':\n                    e.preventDefault();\n                    this.move(0, 1);\n                    break;\n                case 'ArrowLeft': case 'a': case 'A':\n                    e.preventDefault();\n                    this.move(0, -1);\n                    break;\n                case 'ArrowRight': case 'd': case 'D':\n                    e.preventDefault();\n                    this.move(1, 0);\n                    break;\n                case ' ':\n                    e.preventDefault();\n                    if (this.paused) this.togglePause();\n                    break;\n                case 'p':\n                    e.preventDefault();\n                    this.togglePause();\n                    break;\n                case 'm':\n                    e.preventDefault();\n                    this.showSettings();\n                    break;\n            }\n        });\n        \n        // Click to toggle fullscreen\n        document.addEventListener('click', () => {\n            if (document.fullscreenElement) {\n                document.exitFullscreen();\n            } else {\n                document.body.requestFullscreen();\n            }\n        });\n    },\n    \n    togglePause() {\n        this.paused = !this.paused;\n        if (this.paused) {\n            this.overlay.classList.add('active');\n            this.overlay.classList.remove('overlay-gameover');\n        } else {\n            this.overlay.classList.remove('active');\n        }\n    },\n    \n    showSettings() {\n        const panel = document.querySelector('.settings-panel');\n        if (panel) panel.style.display = 'block';\n    },\n    \n    hideSettings() {\n        const panel = document.querySelector('.settings-panel');\n        if (panel) panel.style.display = 'none';\n    }\n    \n    // --- Core Logic ---\n    move(dx, dy) {\n        if (this.paused || !this.running) return;\n        \n        // Check if we can move to the target cell\n        const nx = this.player.x + dx;\n        const ny = this.player.y + dy;\n        \n        // Boundary check\n        if (nx < 0 || nx >= this.gridWidth || ny < 0 || ny >= this.gridHeight) return;\n        \n        // Get the cell below the player (where we'd push)\n        const targetCell = this.getCellBelow(nx, ny);\n        \n        // If there's a box directly behind us, we might be able to push it\n        const behindCell = this.getCellBehind(this.player.x, this.player.y);\n        \n        // Try to move\n        if (targetCell && !targetCell.isWall && !behindCell.isWall) {\n            this.player.x = nx;\n            this.player.y = ny;\n            this.moves++;\n            this.updateHUD();\n            this.checkWinCondition();\n            return;\n        }\n    },\n    \n    getCellBelow(cx, cy) {\n        // Cell just below the given coordinate (cx, cy)\n        const cellX = cx + CONFIG.GRID_SIZE;\n        const cellY = cy;\n        if (cellY >= this.gridHeight) return null;\n        return this.entities[cellY][cellX];\n    },\n    \n    getCellBehind(cx, cy) {\n        // Cell directly behind the player (relative to movement direction)\n        // This determines what we're pushing\n        const dir = this.getDirectionVector(cx, cy);\n        const behindX = cx + dir.x * CONFIG.GRID_SIZE;\n        const behindY = cy + dir.y * CONFIG.GRID_SIZE;\n        return this.entities[behindY][behindX];\n    },\n    \n    getDirectionVector(cx, cy) {\n        // Returns (-1,0) for up, (0,-1) for down, (1,0) for right, (0,1) for left\n        const dirMap = {\n            ArrowUp: [-1, 0], ArrowDown: [1, 0],\n            ArrowLeft: [0, -1], ArrowRight: [0, 1],\n            w: [-1, 0], s: [1, 0],\n            a: [0, -1], d: [0, 1]\n        };\n        return dirMap[this.key === 'ArrowUp' ? 'ArrowUp' : this.key] || [0, 0];\n    },\n    \n    addEntity(type, x, y, color, isStatic = false) {\n        const entity = type === 'player' ? new Player() : new Box();\n        entity.x = x;\n        entity.y = y;\n        entity.color = color;\n        entity.isStatic = isStatic;\n        this.entities.push(entity);\n        if (type === 'player') this.player = entity;\n    },\n    \n    removeEntity(entity) {\n        this.entities = this.entities.filter(e => e !== entity);\n        if (entity === this.player) this.player = null;\n    }\n    \n    spawnLevel(levelNum) {\n        // Clear existing entities except player\n        this.boxes = [];\n        this.targets = [];\n        this.walls = [];\n        \n        // Create player\n        this.addEntity('player', CONFIG.GRID_SIZE / 2, CONFIG.GRID_SIZE / 2, CONFIG.PLAYER_COLOR);\n        \n        // Spawn boxes and targets based on level design\n        // Level 1: Simple setup\n        if (levelNum === 1) {\n            // Player at (128, 256)\n            // Box at (96, 192)\n            // Target at (96, 208)\n            this.addEntity('box', 96, 192, CONFIG.BOX_COLOR);\n            this.addEntity('target', 96, 208, CONFIG.TARGET_COLOR);\n            // Additional boxes/targets for more complexity\n            this.addEntity('box', 112, 168, CONFIG.BOX_COLOR);\n            this.addEntity('target', 112, 184, CONFIG.TARGET_COLOR);\n            this.addEntity('box', 176, 144, CONFIG.BOX_COLOR);\n            this.addEntity('target', 176, 160, CONFIG.TARGET_COLOR);\n            // Walls around edges\n            this.addEntity('wall', 0, 0, CONFIG.WALL_COLOR);\n            this.addEntity('wall', CONFIG.GRID_SIZE-1, 0, CONFIG.WALL_COLOR);\n            this.addEntity('wall', 0, CONFIG.GRID_SIZE-1, CONFIG.WALL_COLOR);\n            this.addEntity('wall', CONFIG.GRID_SIZE-1, CONFIG.GRID_SIZE-1, CONFIG.WALL_COLOR);\n            this.addEntity('wall', 0, CONFIG.GRID_SIZE-1, CONFIG.WALL_COLOR);\n        } else if (levelNum <= 3) {\n            // More complex levels\n            for (let i = 0; i < 4; i++) {\n                const bx = 64 + i * 32;\n                const by = 64 + i * 32;\n                this.addEntity('box', bx, by, CONFIG.BOX_COLOR);\n                if (i % 2 === 0) {\n                    this.addEntity('target', bx + 16, by + 16, CONFIG.TARGET_COLOR);\n                }\n            }\n            // Add some walls\n            this.addEntity('wall', 0, 0, CONFIG.WALL_COLOR);\n            this.addEntity('wall', CONFIG.GRID_SIZE-1, 0, CONFIG.WALL_COLOR);\n            this.addEntity('wall', 0, CONFIG.GRID_SIZE-1, CONFIG.WALL_COLOR);\n            this.addEntity('wall', CONFIG.GRID_SIZE-1, CONFIG.GRID_SIZE-1, CONFIG.WALL_COLOR);\n            this.addEntity('wall', 32, 32, CONFIG.WALL_COLOR);\n            this.addEntity('wall', 288, 288, CONFIG.WALL_COLOR);\n        } else {\n            // Higher difficulty levels\n            for (let i = 0; i < 6; i++) {\n                const bx = 64 + i * 32;\n                const by = 64 + i * 32;\n                this.addEntity('box', bx, by, CONFIG.BOX_COLOR);\n                if (i > 1) {\n                    this.addEntity('target', bx + 16, by + 16, CONFIG.TARGET_COLOR);\n                }\n            }\n            this.addEntity('wall', 0, 0, CONFIG.WALL_COLOR);\n            this.addEntity('wall', CONFIG.GRID_SIZE-1, 0, CONFIG.WALL_COLOR);\n            this.addEntity('wall', 0, CONFIG.GRID_SIZE-1, CONFIG.WALL_COLOR);\n            this.addEntity('wall', CONFIG.GRID_SIZE-1, CONFIG.GRID_SIZE-1, CONFIG.WALL_COLOR);\n            this.addEntity('wall', 32, 32, CONFIG.WALL_COLOR);\n            this.addEntity('wall', 288, 288, CONFIG.WALL_COLOR);\n        }\n        \n        this.currentLevel = levelNum;\n        this.updateLevelCounter();\n    },\n    \n    updateLevelCounter() {\n        const totalBoxes = this.boxes.length;\n        document.getElementById('level-counter').textContent = `Level ${this.currentLevel} / ${this.currentLevel}`;\n    },\n    \n    updateHUD() {\n        document.getElementById('moves').textContent = this.moves;\n        const timeStr = this.formatTime(this.timeElapsed);\n        document.getElementById('time').textContent = timeStr;\n        document.getElementById('stars').textContent = this.starCount();\n    },\n    \n    starCount() {\n        // Simple star system: 0-3 stars based on level completion\n        const completed = this.completedLevels >= this.currentLevel;\n        return completed ? 3 : Math.min(Math.floor((this.currentLevel - 1) / 2), 3);\n    },\n    \n    formatTime(seconds) {\n        const mins = Math.floor(seconds / 60);\n        const secs = seconds % 60;\n        return `${mins.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}`;\n    },\n    \n    checkWinCondition() {\n        // Check if all boxes are on targets\n        let allSolved = true;\n        for (const box of this.boxes) {\n            const cell = this.getCellAt(box.x, box.y);\n            if (!cell || cell.isWall || cell.isTarget) {\n                allSolved = false;\n                break;\n            }\n        }\n        \n        if (allSolved && !this.paused && !this.gameOver) {\n            this.completeLevel();\n        }\n    },\n    \n    completeLevel() {\n        this.gameOver = true;\n        this.paused = true;\n        \n        // Show victory overlay\n        const overlay = document.getElementById('overlay-victory');\n        if (overlay) overlay.classList.add('active');\n        \n        // Play victory sound\n        AudioSystem.victory();\n        \n        // Update stars\n        this.starCount = 3;\n        document.getElementById('stars').textContent = '★ ★ ★ ★';\n        \n        // Save high score\n        if (this.currentLevel > this.highScore) {\n            this.highScore = this.currentLevel;\n            this.saveHighScore();\n        }\n        \n        // Show overlay after brief delay\n        setTimeout(() => {\n            document.getElementById('overlay-victory').classList.remove('active');\n        }, 4000);\n    },\n    \n    gameOver() {\n        this.gameOver = true;\n        this.paused = true;\n        \n        // Show game over overlay\n        const overlay = document.getElementById('overlay-gameover');\n        if (overlay) overlay.classList.add('active');\n        \n        AudioSystem.gameOver();\n    },\n    \n    startGame() {\n        this.running = true;\n        this.paused = false;\n        this.overlay.classList.remove('active');\n        this.overlay.classList.remove('overlay-gameover');\n        \n        // Reset state\n        this.moves = 0;\n        this.timeElapsed = 0;\n        this.boxes = [];\n        this.targets = [];\n        this.walls = [];\n        \n        // Load level\n        this.spawnLevel(this.currentLevel);\n        \n        // Draw initial state\n        this.draw();\n        \n        // Start animation loop\n        this.loop();\n    },\n    \n    draw() {\n        const { ctx, width, height } = this;\n        \n        // Clear canvas\n        ctx.fillStyle = CONFIG.BACKGROUND_COLOR;\n        ctx.fillRect(0, 0, width, height);\n        \n        // Draw grid lines (subtle)\n        ctx.strokeStyle = '#CCCCCC';\n        ctx.lineWidth = 1;\n        for (let i = 0; i <= this.gridWidth; i++) {\n            ctx.beginPath();\n            ctx.moveTo(i * CONFIG.GRID_SIZE, 0);\n            ctx.lineTo(i * CONFIG.GRID_SIZE, height);\n            ctx.stroke();\nctx.lineTo(this.gridWidth * CONFIG.GRID_SIZE, height);
        }
        
        // Draw player
