export class UI {
  constructor(ctx) {
    this.ctx = ctx;
    this.font = '18px Arial';
    this.speed = 0;
    this.gears = 0;
    this.lapTime = 0;
    this.highScore = 0;
    this.paused = false;
  }
  update(dt) {
    // timer
    if (!this.paused) {
      this.lapTime += dt;
    }
    // format timer
    const ms = Math.floor(this.lapTime * 100);
    const seconds = Math.floor(ms / 1000);
    const minutes = Math.floor(seconds / 60);
    const sec = seconds % 60;
    const hundredths = ms % 100;
    this.timerDisplay = `${minutes.toString().padStart(2,'0')}:${sec.toString().padStart(2,'0')}:${hundredths.toString().padStart(2,'0')}`;
  }
  draw() {
    this.ctx.save();
    this.ctx.font = this.font;
    this.ctx.fillStyle = '#fff';
    // speedometer
    this.ctx.fillText(`Speed: ${Math.round(this.speed)} px/frame`, canvas.width - 150, 30);
    // gear counter
    this.ctx.fillText(`Gears: ${this.gears}`, canvas.width - 150, 50);
    // lap timer
    this.ctx.fillText(`Lap: ${this.timerDisplay}`, canvas.width/2 - 60, 30);
    // high score
    if (this.highScore > 0) {
      this.ctx.fillText(`Best: ${this.highScore}`, canvas.width/2 - 60, 50);
    }
    this.ctx.restore();
  }
  setSpeed(s) { this.speed = s; }
  setGearCount(n) { this.gears = n; }
  setHighScore(score) { this.highScore = score; }
  togglePause(show) {
    this.paused = show;
  }
}
