import { createVector } from './utils.js';
export class Car {
  constructor() {
    this.pos = createVector(100, canvas.height - 80);
    this.vel = createVector(0, 0);
    this.angle = 0;
    this.speed = 0;
    this.maxSpeed = 4;
    this.accel = 0.3;
    this.brake = 0.4;
    this.turnSpeed = 0.04;
    this.width = 64;
    this.height = 32;
  }
  update(input, dt) {
    // throttle
    if (input.throttle) this.vel.mul(1).add(createVector(this.accel * dt, 0));
    // brake
    if (input.brake) this.vel.mul(1).add(createVector(-this.brake * dt, 0));
    // friction
    this.vel.mul(0.99);
    // apply velocity
    this.pos.add(this.vel.clone().multiplyScalar(dt));
    // wrap around screen edges (optional)
    if (this.pos.x < -this.width) this.pos.x += canvas.width + this.width;
    if (this.pos.x > canvas.width) this.pos.x -= canvas.width + this.width;
    if (this.pos.y < -this.height) this.pos.y += canvas.height + this.height;
    if (this.pos.y > canvas.height) this.pos.y -= canvas.height + this.height;
    // speed cap
    const speed = Math.sqrt(this.vel.x**2 + this.vel.y**2);
    if (speed > this.maxSpeed + this.gearBonus) {
      const factor = (this.maxSpeed + this.gearBonus) / speed;
      this.vel.x *= factor;
      this.vel.y *= factor;
    }
  }
  render(ctx) {
    ctx.save();
    ctx.translate(this.pos.x, this.pos.y);
    ctx.rotate(this.angle);
    // draw car sprite (placeholder rectangle)
    ctx.fillStyle = '#ff6600';
    ctx.fillRect(-this.width/2, -this.height/2, this.width, this.height);
    ctx.restore();
  }
}
