Now core.js: game loop, state.

```js
import { Car } from './car.js';
import { Gear } from './gear.js';
import { ParticleSystem } from './particle.js';
import { Input } from './input.js';
import { UI } from './ui.js';
import { loadImages, loadAudio } from './utils.js';
import { tilemap } from './level.js';

export class Game {
  constructor(canvas) {
    this.canvas = canvas;
    this.ctx = canvas.getContext('2d');
    this.width = canvas.width;
    this.height = canvas.height;
    this.car = new Car();
    this.gears = [];
    this.particles = new ParticleSystem();
    this.input = new Input();
    this.ui = new UI(this.ctx);
    this.lastTime = 0;
    this.isRunning = false;
    this.paused = false;
    this.highScore = parseFloat(loadHighScore()) || 0;
    this.lapComplete = false;
    this.init();
  }
  init() {
    // set canvas size for high DPI
    const dpr = window.devicePixelRatio || 1;
    this.canvas.width = this.canvas.clientWidth * dpr;
    this.canvas.height = this.canvas.clientHeight * dpr;
    this.ctx.scale(dpr, dpr);
    this.ctx.fillStyle = '#111';
    this.ctx.fillRect(0,0,this.width,this.height);
    // load assets
    const imgSources = {
      car: 'assets/car.png',
      gear: 'assets/gear.png',
      track: 'assets/track.png'
    };
    const audioSources = {
      engine: 'assets/engine.wav',
      gear: 'assets/gear.wav',
      brake: 'assets/brake.wav',
      collision: 'assets/collision.wav',
      lap: 'assets/lap.wav'
    };
    Promise.all([loadImages(imgSources), loadAudio(audioSources)])
      .then(([images, audioData]) => {
        this.images = images;
        this.audio = audioData;
        this.audio.load(audioSources);
        this.startGame();
      })
      .catch(err => console.error(err));
  }
  startGame() {
    this.isRunning = true;
    this.paused = false;
    this.lapComplete = false;
    this.car = new Car(); // reset car
    this.gears = [];
    this.particles = new ParticleSystem();
    this.ui = new UI(this.ctx);
    this.highScore = parseFloat(loadHighScore()) || 0;
    this.startTime = performance.now();
    this.updateLoop();
  }
  updateLoop(timestamp) {
    const dt = (timestamp - this.lastTime) / 1000; // seconds
    this.lastTime = timestamp;
    if (this.isRunning && !this.paused) {
      this.update(dt);
      this.render();
    }
    requestAnimationFrame(this.updateLoop.bind(this));
  }
  update(dt) {
    // timer
    this.ui.update(dt);
    // input
    this.car.update(this.input, dt);
    // gear collection
    for (let i = this.gears.length - 1; i >= 0; i--) {
      const gear = this.gears[i];
      if (gear.isColliding(this.car.pos, this.car.width/2)) {
        // collect gear
        this.gears.splice(i,1);
        this.ui.setGearCount(this.ui.gears + 1);
        this.car.maxSpeed += gear.speedBonus;
        // play sound
        this.audio.play('gear');
        // add particles
        this.particles.emit(5, this.car.pos.x, this.car.pos.y);
      }
    }
    // track collision (simple boundary)
    if (this.car.pos.x < 0 || this.car.pos.x > this.width || this.car.pos.y < 0 || this.car.pos.y > this.height) {
      // stop
      this.isRunning = false;
      this.endLap();
    }
    // speed display
    const speed = Math.sqrt(this.car.vel.x**2 + this.car.vel.y**2);
    this.ui.setSpeed(speed);
  }
  render() {
    // clear
    this.ctx.clearRect(0,0,this.width,this.height);
    // draw background (simple gradient)
    const gradient = this.ctx.createLinearGradient(0,0,this.width, this.height);
    gradient.addColorStop(0, '#0a0a2a');
    gradient.addColorStop(1, '#111');
    this.ctx.fillStyle = gradient;
    this.ctx.fillRect(0,0,this.width,this.height);
    // draw track (placeholder)
    this.ctx.fillStyle = '#555';
    this.ctx.fillRect(0, this.height-20, this.width, 20);
    // draw car
    this.car.render(this.ctx);
    // draw gears
    this.gears.forEach(g => g.render(this.ctx));
    // draw particles
    this.particles.update(dt);
    this.particles.draw(this.ctx);
    // HUD
    this.ui.draw();
    // pause menu
    if (this.paused) {
      this.ctx.fillStyle = 'rgba(0,0,0,0.6)';
      this.ctx.fillRect(0,0,this.width,this.height);
      this.ctx.fillStyle = '#fff';
      this.ctx.font = '24px Arial';
      this.ctx.textAlign = 'center';
      this.ctx.fillText('PAUSED', this.width/2, this.height/2 - 20);
    }
  }
  endLap() {
    const lapTime = this.lapTime;
    this.lapComplete = true;
    // stop timer
    const best = this.highScore;
    if (lapTime < best) {
      this.highScore = lapTime;
      saveHighScore(this.highScore);
    }
    // show pause menu with options
    this.ui.togglePause(true);
    // add resume button handler
    const resumeBtn = document.getElementById('resumeBtn');
    const restartBtn = document.getElementById('restartBtn');
    resumeBtn.onclick = () => {
      this.paused = false;
      this.ui.togglePause(false);
    };
    restartBtn.onclick = () => {
      this.startGame();
    };
  }
}
```

