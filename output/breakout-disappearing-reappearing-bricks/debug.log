Raw: {"index.html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no\">\n<link rel=\"icon\" href=\"data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🚀</text></svg>\">\n<title>BREAKOUT: Phase Shift</title>\n<style>\n*{margin:0;padding:0;box-sizing:border-box}\nbody{background:#000;display:flex;justify-content:center;align-items:center;min-height:100vh;overflow:hidden;font-family:'Segoe UI',system-ui,-apple-system,sans-serif;touch-action:none}\n#gameCanvas{display:block;max-width:100vw;max-height:100vh}\n#ui{position:absolute;top:0;left:0;width:100%;height:100%;pointer-events:none;color:#fff}\n#score{position:absolute;top:15px;left:20px;font-size:28px;font-weight:700;text-shadow:0 0 10px #4ecdc4}\n#timer{position:absolute;top:15px;left:50%;transform:translateX(-50%);font-size:18px;color:#ffd700;font-weight:600;text-shadow:0 0 8px #ffd700}\n#combo{position:absolute;top:50px;left:20px;font-size:18px;color:#ff6b9d;opacity:0;transition:opacity .3s}\n#level{position:absolute;top:50px;left:50%;transform:translateX(-50%);font-size:16px;color:#aaa}\n#lives{position:absolute;top:15px;right:20px;display:flex;gap:8px}\n.life{width:16px;height:16px;border-radius:50%;background:#4ecdc4;box-shadow:0 0 10px #4ecdc4;transition:opacity .3s}\n.life.lost{opacity:.2}\n#powerups{position:absolute;top:50px;right:20px;display:flex;gap:10px}\n.powerup{font-size:24px;opacity:.3;transition:opacity .3s}\n.powerup.active{opacity:1;animation:pulse 1s infinite}\n#cooldown{position:absolute;bottom:20px;right:20px;font-size:14px;color:#4ecdc4}\n#minimap{position:absolute;bottom:20px;left:20px;display:grid;grid-template-columns:repeat(10,8px);gap:2px}\n.minibrick{width:8px;height:6px;border-radius:2px;transition:background .2s}\n.minibrick.solid{background:#ff6b9d}\n.minibrick.ghost{background:#2a3f5f;opacity:.5}\n.minibrick.destroyed{background:transparent}\n#overlay{position:absolute;top:0;left:0;width:100%;height:100%;display:flex;flex-direction:column;justify-content:center;align-items:center;background:rgba(10,14,39,.95);transition:opacity .4s}\n#overlay.hidden{opacity:0;pointer-events:none}\n#overlay h1{font-size:clamp(32px,8vw,56px);font-weight:900;letter-spacing:4px;background:linear-gradient(135deg,#4ecdc4,#c44dff);-webkit-background-clip:text;-webkit-text-fill-color:transparent;margin-bottom:20px;text-shadow:none}\n#overlay p{font-size:clamp(14px,3vw,18px);color:#aaa;margin-bottom:30px;text-align:center;padding:0 20px}\n#overlay .prompt{font-size:clamp(16px,4vw,22px);color:#4ecdc4;animation:blink 1.5s infinite}\n#overlay .final-score{font-size:clamp(24px,6vw,36px);color:#ff6b9d;margin:15px 0}\n#overlay .highscore{font-size:clamp(16px,4vw,20px);color:#c44dff}\n#overlay .new-record{font-size:clamp(18px,4vw,24px);color:#ffd700;animation:flash 0.5s infinite alternate;margin-top:10px}\n@keyframes blink{0%,100%{opacity:1}50%{opacity:.3}}\n@keyframes pulse{0%,100%{transform:scale(1)}50%{transform:scale(1.1)}}\n@keyframes flash{from{text-shadow:0 0 10px #ffd700}to{text-shadow:0 0 30px #ffd700,0 0 50px #ffd700}}\n@media(max-width:600px){\n#score{font-size:20px;top:10px;left:10px}\n#timer{font-size:14px;top:10px}\n#combo{font-size:14px;top:40px;left:10px}\n#level{font-size:12px;top:40px}\n#lives{top:10px;right:10px}\n#powerups{top:40px;right:10px}\n#cooldown{font-size:12px;bottom:10px;right:10px}\n#minimap{transform:scale(0.8);transform-origin:bottom left}\n}\n</style>\n</head>\n<body>\n<canvas id=\"gameCanvas\"></canvas>\n<div id=\"ui\">\n    <div id=\"score\">0</div>\n    <div id=\"timer\">00:00.00</div>\n    <div id=\"combo\"></div>\n    <div id=\"level\"></div>\n    <div id=\"lives\"><div class=\"life\"></div><div class=\"life\"></div><div class=\"life\"></div></div>\n    <div id=\"powerups\"></div>\n    <div id=\"cooldown\"></div>\n    <div id=\"minimap\"></div>\n    <div id=\"overlay\">\n        <h1>PHASE SHIFT</h1>\n        <p>Break bricks during their solid phase<br>Hold SPACE to extend paddle | Hold SHIFT for phase shift</p>\n        <div class=\"prompt\">PRESS SPACE TO START</div>\n    </div>\n</div>\n<script>\nconst canvas=document.getElementById('gameCanvas');\nconst ctx=canvas.getContext('2d');\nconst W=1280,H=720;\ncanvas.width=W;\ncanvas.height=H;\nconst ui=document.getElementById('ui');\nconst scoreEl=document.getElementById('score');\nconst timerEl=document.getElementById('timer');\nconst comboEl=document.getElementById('combo');\nconst levelEl=document.getElementById('level');\nconst livesEl=document.getElementById('lives');\nconst powerupsEl=document.getElementById('powerups');\nconst cooldownEl=document.getElementById('cooldown');\nconst minimapEl=document.getElementById('minimap');\nconst overlay=document.getElementById('overlay');\n\n// Audio Context\nlet audioCtx=null;\nfunction initAudio(){\n    if(!audioCtx){\n        audioCtx=new(window.AudioContext||window.webkitAudioContext)();\n    }\n}\n\nfunction playSound(type){\n    if(!audioCtx)return;\n    const osc=audioCtx.createOscillator();\n    const gain=audioCtx.createGain();\n    osc.connect(gain);\n    gain.connect(audioCtx.destination);\n    const now=audioCtx.currentTime;\n    switch(type){\n        case 'hit':\n            osc.frequency.setValueAtTime(440+combo*50,now);\n            osc.type='square';\n            gain.gain.setValueAtTime(0.1,now);\n            gain.gain.exponentialDecayTo=0.01;\n            gain.gain.setTargetAtTime(0.01,now,0.05);\n            osc.start(now);\n            osc.stop(now+0.1);\n            break;\n        case 'phase':\n            osc.frequency.setValueAtTime(200,now);\n            osc.frequency.exponentialRampToValueAtTime(600,now+0.15);\n            osc.type='sine';\n            gain.gain.setValueAtTime(0.08,now);\n            gain.gain.setTargetAtTime(0.01,now,0.1);\n            osc.start(now);\n            osc.stop(now+0.2);\n            break;\n        case 'powerup':\n            [523,659,784].forEach((f,i)=>{\n                const o=audioCtx.createOscillator();\n                const g=audioCtx.createGain();\n                o.connect(g);g.connect(audioCtx.destination);\n                o.frequency.value=f;\n                o.type='sine';\n                g.gain.setValueAtTime(0.1,now+i*0.08);\n                g.gain.setTargetAtTime(0.01,now+i*0.08,0.05);\n                o.start(now+i*0.08);\n                o.stop(now+i*0.08+0.15);\n            });\n            return;\n        case 'lose':\n            osc.frequency.setValueAtTime(400,now);\n            osc.frequency.exponentialRampToValueAtTime(100,now+0.5);\n            osc.type='sawtooth';\n            gain.gain.setValueAtTime(0.15,now);\n            gain.gain.setTargetAtTime(0.01,now,0.2);\n            osc.start(now);\n            osc.stop(now+0.6);\n            break;\n        case 'combo':\n            osc.frequency.setValueAtTime(880,now);\n            osc.type='triangle';\n            gain.gain.setValueAtTime(0.12,now);\n            gain.gain.setTargetAtTime(0.01,now,0.1);\n            osc.start(now);\n            osc.stop(now+0.15);\n            break;\n    }\n}\n\n// Game state\nlet gameState='menu';\nlet score=0,level=1,lives=3,combo=1;\nlet highScore=parseInt(localStorage.getItem('phaseShiftHighScore'))||0;\nlet gameTime=0;\nlet bricks=[],balls=[],particles=[],powerups=[];\nlet stars=[];\nlet screenShake={x:0,y:0,dur:0};\nlet lastTime=0;\nlet deltaTime=0;\nlet accumulator=0;\nconst FIXED_DT=1/60;\n\n// Paddle\nconst paddle={x:W/2,y:H-60,w:140,h:18,vx:0,baseW:140,charged:false,charging:false,chargeTime:0,phaseShift:false,phaseTime:0,expandTime:0,shield:false};\nconst keys={};\nlet mouseX=W/2,mouseActive=false;\n\n// Input\ndocument.addEventListener('keydown',e=>{\n    if(e.repeat)return;\n    keys[e.code]=true;\n    if(e.code==='Space'){\n        e.preventDefault();\n        initAudio();\n        if(gameState==='menu'||gameState==='gameover')startGame();\n        else if(gameState==='playing')paddle.charging=true;\n    }\n    if(e.code==='ShiftLeft'||e.code==='ShiftRight'){\n        if(gameState==='playing'&&paddle.phaseTime<=0){\n            paddle.phaseShift=true;\n            playSound('phase');\n        }\n    }\n    if(e.code==='Escape'&&gameState==='playing')gameState='paused';\n    else if(e.code==='Escape'&&gameState==='paused')gameState='playing';\n});\ndocument.addEventListener('keyup',e=>{\n    keys[e.code]=false;\n    if(e.code==='Space')paddle.charging=false;\n    if(e.code==='ShiftLeft'||e.code==='ShiftRight')paddle.phaseShift=false;\n});\ndocument.addEventListener('mousemove',e=>{\n    const rect=canvas.getBoundingClientRect();\n    const scaleX=W/rect.width;\n    mouseX=(e.clientX-rect.left)*scaleX;\n    mouseActive=true;\n});\ndocument.addEventListener('touchstart',e=>{\n    e.preventDefault();\n    initAudio();\n    if(gameState==='menu'||gameState==='gameover')startGame();\n    const rect=canvas.getBoundingClientRect();\n    const scaleX=W/rect.width;\n    mouseX=(e.touches[0].clientX-rect.left)*scaleX;\n    mouseActive=true;\n},{passive:false});\ndocument.addEventListener('touchmove',e=>{\n    e.preventDefault();\n    const rect=canvas.getBoundingClientRect();\n    const scaleX=W/rect.width;\n    mouseX=(e.touches[0].clientX-rect.left)*scaleX;\n},{passive:false});\ndocument.addEventListener('touchend',e=>{\n    if(gameState==='playing'){\n        paddle.charging=true;\n        setTimeout(()=>paddle.charging=false,100);\n    }\n});\ncanvas.addEventListener('mousedown',()=>{\n    initAudio();\n    if(gameState==='menu'||gameState==='gameover')startGame();\n});\n\n// Resize handler\nfunction resize(){\n    const ratio=W/H;\n    let w=window.innerWidth,h=window.innerHeight;\n    if(w/h>ratio){w=h*ratio}else{h=w/ratio}\n    canvas.style.width=w+'px';\n    canvas.style.height=h+'px';\n    canvas.style.position='absolute';\n    canvas.style.left=((window.innerWidth-w)/2)+'px';\n    canvas.style.top=((window.innerHeight-h)/2)+'px';\n}\nwindow.addEventListener('resize',resize);\nresize();\n\n// Stars\nfunction initStars(){\n    stars=[];\n    for(let i=0;i<150;i++){\n        stars.push({x:Math.random()*W,y:Math.random()*H,z:Math.random()*3+1,size:Math.random()*1.5+0.5,brightness:Math.random()});\n    }\n}\ninitStars();\n\n// Brick creation\nfunction createBricks(){\n    bricks=[];\n    const cols=10,rows=8,bW=100,bH=30,gap=8;\n    const totalW=cols*bW+(cols-1)*gap;\n    const startX=(W-totalW)/2;\n    const colors=[['#ff6b9d','#ff3366'],['#c44dff','#9933ff'],['#4a6fcf','#3366cc']];\n    for(let r=0;r<rows;r++){\n        let solidT,ghostT,pts,colorIdx;\n        if(r<2){solidT=1.2;ghostT=1.8;pts=30;colorIdx=0}\n        else if(r<5){solidT=2.0;ghostT=2.0;pts=20;colorIdx=1}\n        else{solidT=3.0;ghostT=1.0;pts=10;colorIdx=2}\n        for(let c=0;c<cols;c++){\n            bricks.push({\n                x:startX+c*(bW+gap),\n                y:80+r*(bH+gap),\n                w:bW,h:bH,\n                solid:true,phaseTime:Math.random()*2,\n                solidT,ghostT,pts,\n                destroyed:false,\n                transitioning:false,\n                transTime:0,\n                colors:colors[colorIdx]\n            });\n        }\n    }\n    updateMinimap();\n}\n\nfunction updateMinimap(){\n    minimapEl.innerHTML='';\n    bricks.forEach(b=>{\n        const d=document.createElement('div');\n        d.className='minibrick';\n        if(b.destroyed)d.classList.add('destroyed');\n        else if(b.solid)d.classList.add('solid');\n        else d.classList.add('ghost');\n        minimapEl.appendChild(d);\n    });\n}\n\n// Ball creation\nfunction createBall(x,y,dx,dy){\n    return{\n        x:x||W/2,y:y||H-100,\n        vx:dx||(Math.random()-0.5)*200,\n        vy:dy||(-1)*Math.sqrt(480*480-(dx||0)*(dx||0)),\n        r:12,trail:[],\n        slowMo:false\n    };\n}\n\nfunction launchBall(){\n    const angle=(Math.random()*60+60)*Math.PI/180;\n    balls=[createBall(paddle.x, paddle.y-paddle.h/2-12, Math.cos(angle)*480, -Math.sin(angle)*480)];\n}\n\n// Particles\nfunction spawnParticles(x,y,color,count=12){\n    for(let i=0;i<count;i++){\n        const a=Math.random()*Math.PI*2;\n        const s=Math.random()*150+50;\n        particles.push({x,y,vx:Math.cos(a)*s,vy:Math.sin(a)*s,life:1,color,maxLife:1,size:Math.random()*4+2});\n    }\n}\n\nfunction spawnPowerup(x,y){\n    if(Math.random()>0.15)return;\n    const types=['expand','multi','slow','lock','shield'];\n    const w=[0.4,0.35,0.15,0.03,0.07];\n    let r=Math.random(),t=0;\n    for(let i=0;i<types.length;i++){\n        t+=w[i];\n        if(r<t){powerups.push({x,y,vy:200,type:types[i]});return}\n    }\n}\n\n// Powerup effects\nfunction applyPowerup(type){\n    playSound('powerup');\n    switch(type){\n        case 'expand':paddle.expandTime=8;break;\n        case 'multi':\n            if(balls.length<4){\n                const b=balls[0];\n                balls.push(createBall(b.x,b.y,b.vx+100,b.vy-100));\n                balls.push(createBall(b.x,b.y,b.vx-100,b.vy-100));\n            }break;\n        case 'slow':\n            balls.forEach(b=>b.slowMo=true);\n            setTimeout(()=>balls.forEach(b=>b.slowMo=false),6000);\n            break;\n        case 'lock':\n            bricks.forEach(b=>{if(!b.destroyed){b.solidT=999;b.ghostT=999}});\n            setTimeout(()=>bricks.forEach(b=>{if(!b.destroyed){b.solidT=b.ghostT=2}}),4000);\n            break;\n        case 'shield':paddle.shield=true;break;\n    }\n    updatePowerupUI();\n}\n\n// Collision\nfunction circleRect(cx,cy,r,rx,ry,rw,rh){\n    const nx=Math.max(rx,Math.min(cx,rx+rw));\n    const ny=Math.max(ry,Math.min(cy,ry+rh));\n    const dx=cx-nx,dy=cy-ny;\n    return dx*dx+dy*dy<r*r;\n}\n\nfunction hitBrick(ball,brick){\n    const cx=Math.max(brick.x,Math.min(ball.x,brick.x+brick.w));\n    const cy=Math.max(brick.y,Math.min(ball.y,brick.y+brick.h));\n    const dx=b