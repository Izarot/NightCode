              b.transitioning=true;\n                b.transTime=0.2;\n                b.phaseTime=0;\n            }\n        }else{\n            if(b.phaseTime>=b.ghostT){\n                b.solid=true;\n                b.transitioning=true;\n                b.transTime=0.2;\n                b.phaseTime=0;\n            }\n        }\n    });\n    bricks.forEach(b=>{\n        if(b.transitioning){\n            b.transTime-=dt2;\n            if(b.transTime<=0)b.transitioning=false;\n        }\n    });\n    \n    // Ball update\n    const speedScale=1+(level-1)*0.1;\n    balls.forEach((ball,bi)=>{\n        const spd=ball.slowMo?0.5:1;\n        ball.trail.unshift({x:ball.x,y:ball.y});\n        if(ball.trail.length>8)ball.trail.pop();\n        \n        ball.x+=ball.vx*dt2*spd*speedScale;\n        ball.y+=ball.vy*dt2*spd*speedScale;\n        \n        // Wall collision\n        if(ball.x-ball.r<0){ball.x=ball.r;ball.vx=Math.abs(ball.vx)}\n        if(ball.x+ball.r>W){ball.x=W-ball.r;ball.vx=-Math.abs(ball.vx)}\n        if(ball.y-ball.r<0){ball.y=ball.r;ball.vy=Math.abs(ball.vy)}\n        \n        // Paddle collision\n        if(ball.vy>0&&circleRect(ball.x,ball.y,ball.r,paddle.x-paddle.w/2,paddle.y-paddle.h/2,paddle.w,paddle.h)){\n            if(paddle.phaseShift){\n                ball.vy=-Math.abs(ball.vy);\n                ball.vx*=-1;\n            }else{\n                const hitX=(ball.x-paddle.x)/(paddle.w/2);\n                const angle=hitX*60*Math.PI/180;\n                const spd=Math.sqrt(ball.vx*ball.vx+ball.vy*ball.vy);\n                ball.vx=Math.sin(angle)*spd;\n                ball.vy=-Math.abs(Math.cos(angle)*spd);\n                ball.y=paddle.y-paddle.h/2-ball.r;\n                spawnParticles(ball.x,paddle.y,'#4ecdc4',5);\n                playSound('hit');\n            }\n        }\n        \n        // Brick collision\n        bricks.forEach(brick=>{\n            if(brick.destroyed||brick.transitioning)return;\n            if(brick.solid&&circleRect(ball.x,ball.y,ball.r,brick.x,brick.y,brick.w,brick.h)){\n                const hit=hitBrick(ball,brick);\n                switch(hit){\n                    case'left':case'right':ball.vx*=-1.1;ball.x+=ball.vx>0?10:-10;break;\n                    case'top':case'bottom':ball.vy*=-1.1;ball.y+=ball.vy>0?10:-10;break;\n                }\n                const rand=(Math.random()-0.5)*10*Math.PI/180;\n                const cos=Math.cos(rand),sin=Math.sin(rand);\n                const nx=ball.vx*cos-ball.vy*sin,ny=ball.vx*sin+ball.vy*cos;\n                ball.vx=nx*0.9;ball.vy=ny*0.9;\n                brick.destroyed=true;\n                const bonus=brick.phaseTime<0.3?5:0;\n                const prevCombo=combo;\n                score+=brick.pts*combo+bonus;\n                combo=Math.min(8,combo+1);\n                if(prevCombo<combo)playSound('combo');\n                if(Math.random()<0.05&&bonus>0)spawnPowerup(brick.x+brick.w/2,brick.y+brick.h/2);\n                spawnParticles(brick.x+brick.w/2,brick.y+brick.h/2,brick.colors[0]);\n                screenShake={x:3,y:3,dur:0.15};\n                playSound('hit');\n                updateMinimap();\n                updateUI();\n            }\n        });\n        \n        // Ball lost\n        if(ball.y>H+50){\n            balls.splice(bi,1);\n            if(balls.length===0){\n                if(paddle.shield){\n                    paddle.shield=false;\n                    balls=[createBall(paddle.x,paddle.y-50)];\n                    updatePowerupUI();\n                }else{\n                    lives--;\n                    updateLives();\n                    combo=1;\n                    playSound('lose');\n                    if(lives<=0){\n                        endGame();\n                    }else{\n                        balls=[createBall(paddle.x,paddle.y-50)];\n                    }\n                }\n            }\n        }\n    });\n    \n    // Powerups\n    powerups.forEach((p,pi)=>{\n        p.y+=p.vy*dt2;\n        if(p.y>H)powerups.splice(pi,1);\n        if(p.y>paddle.y-paddle.h/2&&p.y<paddle.y+paddle.h/2&&Math.abs(p.x-paddle.x)<paddle.w){\n            applyPowerup(p.type);\n            powerups.splice(pi,1);\n        }\n    });\n    \n    // Particles\n    particles.forEach((p,pi)=>{\n        p.x+=p.vx*dt2;\n        p.y+=p.vy*dt2;\n        p.vy+=200*dt2;\n        p.life-=dt2;\n        if(p.life<=0)particles.splice(pi,1);\n    });\n    \n    // Screen shake\n    if(screenShake.dur>0){\n        screenShake.dur-=dt2;\n        screenShake.x=(Math.random()-0.5)*6;\n        screenShake.y=(Math.random()-0.5)*6;\n    }else{screenShake.x=0;screenShake.y=0}\n    \n    // Level complete\n    if(bricks.every(b=>b.destroyed)){\n        score=Math.floor(score*1.5);\n        level++;\n        if(level>5)endGame();\n        else{\n            createBricks();\n            launchBall();\n            updateUI();\n        }\n    }\n}\n\n// Render\nfunction render(){\n    ctx.save();\n    ctx.translate(screenShake.x,screenShake.y);\n    \n    // Background\n    const grad=ctx.createLinearGradient(0,0,0,H);\n    grad.addColorStop(0,'#0a0e27');\n    grad.addColorStop(0.5,'#1a1f4e');\n    grad.addColorStop(1,'#2a1f5e');\n    ctx.fillStyle=grad;\n    ctx.fillRect(-10,-10,W+20,H+20);\n    \n    // Stars\n    stars.forEach(s=>{\n        s.y+=0.15*s.z;\n        if(s.y>H)s.y=0;\n        s.brightness+=Math.sin(Date.now()*0.001+s.x)*0.01;\n        const b=Math.max(0.2,Math.min(1,s.brightness));\n        ctx.fillStyle=`rgba(${180+Math.sin(s.x)*50},${200+Math.cos(s.y)*30},${255},${b*0.7})`;\n        ctx.beginPath();\n        ctx.arc(s.x,s.y,s.size,0,Math.PI*2);\n        ctx.fill();\n    });\n    \n    // Bricks\n    bricks.forEach(brick=>{\n        if(brick.destroyed)return;\n        ctx.save();\n        const alpha=brick.transitioning?0.5:brick.solid?1:0.25;\n        if(brick.solid){\n            const g=ctx.createLinearGradient(brick.x,brick.y,brick.x,brick.y+brick.h);\n            g.addColorStop(0,brick.colors[0]);\n            g.addColorStop(1,brick.colors[1]);\n            ctx.globalAlpha=alpha;\n            ctx.fillStyle=g;\n            ctx.shadowColor=brick.colors[0];\n            ctx.shadowBlur=10;\n            ctx.fillRect(brick.x,brick.y,brick.w,brick.h);\n            ctx.strokeStyle='rgba(255,255,255,0.4)';\n            ctx.lineWidth=2;\n            ctx.strokeRect(brick.x,brick.y,brick.w,brick.h);\n        }else{\n            ctx.globalAlpha=alpha;\n            ctx.fillStyle='#2a3f5f';\n            ctx.fillRect(brick.x,brick.y,brick.w,brick.h);\n            ctx.setLineDash([8,4]);\n            ctx.lineDashOffset=Date.now()*0.02;\n            ctx.strokeStyle='#4a6f9f';\n            ctx.lineWidth=2;\n            ctx.strokeRect(brick.x,brick.y,brick.w,brick.h);\n            ctx.setLineDash([]);\n        }\n        // Phase bar\n        if(!brick.transitioning){\n            const t=brick.solid?brick.phaseTime/brick.solidT:brick.phaseTime/brick.ghostT;\n            ctx.globalAlpha=0.8;\n            ctx.fillStyle=brick.solid?'rgba(78,205,196,0.8)':'rgba(74,111,159,0.8)';\n            ctx.fillRect(brick.x,brick.y-5,brick.w*t,3);\n        }\n        ctx.restore();\n    });\n    \n    // Powerups\n    powerups.forEach(p=>{\n        ctx.save();\n        const colors={'expand':'#4ecdc4','multi':'#4ecdc4','slow':'#ffd700','lock':'#c44dff','shield':'#ff6b9d'};\n        const icons={'expand':'E','multi':'M','slow':'S','lock':'L','shield':'🛡'};\n        ctx.shadowColor=colors[p.type];\n        ctx.shadowBlur=15;\n        ctx.fillStyle=colors[p.type];\n       `}</function updateUI(){scoreEl.textContent=score;timerEl.textContent=formatTime(gameTime);levelEl.textContent=`Level ${level}`;if(combo>1){comboEl.textContent=`Combo x${combo}`;comboEl.style.opacity='1'}else{comboEl.style.opacity='0'}if(paddle.phaseTime>0){cooldownEl.textContent=`Phase: ${paddle.phaseTime.toFixed(1)}s`}else{cooldownEl.textContent=''}}function updateLives(){const lifeEls=livesEl.querySelectorAll('.life');lifeEls.forEach((l,i)=>{l.classList.toggle('lost',i>=lives)})}function updatePowerupUI(){powerupsEl.innerHTML='';const pwrs=[{id:'expand',icon:'↔',active:paddle.expandTime>0},{id:'multi',icon:'*',active:balls.length>1},{id:'slow',icon:'◷',active:balls.some(b=>b.slowMo)},{id:'lock',icon:'⊘',active:bricks.some(b=>b.solidT===999)},{id:'shield',icon:'●',active:paddle.shield}];pwrs.forEach(p=>{const el=document.createElement('span');el.className='powerup'+(p.active?' active':'');el.textContent=p.icon;el.title=p.id;powerupsEl.appendChild(el)})}function startGame(){gameState='playing';score=0;level=1;lives=3;combo=1;gameTime=0;balls=[];particles=[];powerups=[];paddle.x=W/2;paddle.w=paddle.baseW;paddle.charged=false;paddle.charging=false;paddle.chargeTime=0;paddle.phaseShift=false;paddle.phaseTime=0;paddle.expandTime=0;paddle.shield=false;paddle.vx=0;createBricks();launchBall();updateUI();updateLives();updatePowerupUI();overlay.classList.add('hidden')}function endGame(){gameState='gameover';if(score>highScore){highScore=score;localStorage.setItem('phaseShiftHighScore',highScore)}overlay.innerHTML=`<h1>GAME OVER</h1><p class="final-score">Score: ${score}</p><p class="highscore">Best: ${highScore}</p>${score>=highScore&&score>0?'<p class="new-record">NEW RECORD!</p>':''}<p class="prompt">PRESS SPACE TO RETRY</p>`;overlay.classList.remove('hidden')}function gameLoop(timestamp){if(!lastTime)lastTime=timestamp;deltaTime=Math.min((timestamp-lastTime)/1000,0.1);lastTime=timestamp;accumulator+=deltaTime;while(accumulator>=FIXED_DT){update(FIXED_DT);accumulator-=FIXED_DT}render();updatePowerupUI();requestAnimationFrame(gameLoop)}requestAnimationFrame(gameLoop);</script></body></html>}