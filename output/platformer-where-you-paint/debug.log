  "index.html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Chromatic Path</title>\n    <!-- Sneaky Feature 2: Cool emoji favicon -->\n    <link rel=\"icon\" href=\"data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22><text y=%220.9em%22 font-size=%2232%22>🎨</text></svg>\">\n    <style>\n        * { margin: 0; padding: 0; box-sizing: border-box; }\n        body, html { overflow: hidden; width: 100%; height: 100%; background: #1a1a2e; }\n        #gameCanvas { display: block; margin: 0 auto; background: linear-gradient(135deg, #0f0c29, #302b63, #24243e); }\n    </style>\n</head>\n<body>\n    <canvas id=\"gameCanvas\"></canvas>\n    <script type=\"module\" src=\"/src/main.js\"></script>\n</body>\n</html>",
  "src/main.js": "import { initInput } from './input.js';\\nimport { Player } from './player.js';\\nimport { PaintManager } from './paint.js';\\nimport { LevelManager } from './level.js';\\nimport { UI } from './ui.js';\\nimport { loadAssets } from './utils.js';\\n\\nconst canvas = document.getElementById('gameCanvas');\\nconst ctx = canvas.getContext('2d');\\nlet lastTime = 0;\\n\\n// Sneaky Feature 1: Responsive canvas\\nfunction resizeCanvas() {\\n    const scale = Math.min(window.innerWidth / 1280, window.innerHeight / 720);\\n    canvas.width = 1280 * scale;\\n    canvas.height = 720 * scale;\\n    ctx.scale(scale, scale);\\n}\\nwindow.addEventListener('resize', resizeCanvas);\\nresizeCanvas();\\n\\n// Sneaky Feature 4: High Score from localStorage\\nlet highScore = parseInt(localStorage.getItem('chromaticPathHighScore') || '0');\\n\\nasync function init() {\\n    await loadAssets();\\n    initInput();\\n   \\n    const player = new Player();\\n    const paint = new PaintManager();\\n    const level = new LevelManager();\\n    const ui = new UI();\\n   \\n    function gameLoop(timestamp) {\\n        const delta = (timestamp - lastTime) / 1000;\\n        lastTime = timestamp;\\n       \\n        ctx.clearRect(0, 0, canvas.width, canvas.height);\\n        \\n        level.update(delta);\\n        player.update(delta, level, paint);\\n        paint.update(delta);\\n        \\n        level.render(ctx);\\n        paint.render(ctx);\\n        player.render(ctx);\\n        ui.render(ctx, player, paint, level, highScore);\\n        \\n        if (level.isCompleted(player)) {\\n            const currentLevel = level.getCurrentIndex();\\n            if (currentLevel > highScore) {\\n                highScore = currentLevel;\\n                localStorage.setItem('chromaticPathHighScore', highScore.toString());\\n            }\\n            level.nextLevel();\\n            player.reset();\\n        }\\n        \\n        requestAnimationFrame(gameLoop);\\n    }\\n    \\n    requestAnimationFrame(gameLoop);\\n}\\n\\ninit();",
  "src/input.js": "export const keys = {};\\nexport const mouse = { x: 0, y: 0, down: false };\\nexport let touchJoystick = { x: 0, y: 0, active: false };\\n\\nexport function initInput() {\\n    window.addEventListener('keydown', e => { keys[e.key] = true; });\\n    window.addEventListener('keyup', e => { keys[e.key] = false; });\\n    \\n    const canvas = document.getElementById('gameCanvas');\\n    canvas.addEventListener('mousedown', e => {\\n        const rect = canvas.getBoundingClientRect();\\n        mouse.x = (e.clientX - rect.left) / (canvas.width / 1280);\\n        mouse.y = (e.clientY - rect.top) / (canvas.height / 720);\\n        mouse.down = true;\\n    });\\n    canvas.addEventListener('mouseup', e => { mouse.down = false; });\\n    canvas.addEventListener('mousemove', e => {\\n        const rect = canvas.getBoundingClientRect();\\n        mouse.x = (e.clientX - rect.left) / (canvas.width / 1280);\\n        mouse.y = (e.clientY - rect.top) / (canvas.height / 720);\\n    });\\n    \\n    // Touch joystick\\n    canvas.addEventListener('touchstart', e => {\\n        e.preventDefault();\\n        const touch = e.touches[0];\\n        const rect = canvas.getBoundingClientRect();\\n        touchJoystick.x = (touch.clientX - rect.left) / (canvas.width / 1280);\\n        touchJoystick.y = (touch.clientY - rect.top) / (canvas.height / 720);\\n        touchJoystick.active = true;\\n    });\\n    canvas.addEventListener('touchend', e => { touchJoystick.active = false; });\\n    canvas.addEventListener('touchmove', e => {\\n        e.preventDefault();\\n        const touch = e.touches[0];\\n        const rect = canvas.getBoundingClientRect();\\n        touchJoystick.x = (touch.clientX - rect.left) / (canvas.width / 1280);\\n        touchJoystick.y = (touch.clientY - rect.top) / (canvas.height / 720);\\n    });\\n}",
  "src/player.js": "export class Player {\\n    constructor() {\\n        this.reset();\\n    }\\n    \\n    reset() {\\n        this.x = 100;\\n        this.y = 500;\\n        this.vx = 0;\\n        this.vy = 0;\\n        this.width = 32;\\n        this.height = 48;\\n        this.onGround = false;\\n        this.coyoteTimer = 0;\\n        this.jumpBuffer = 0;\\n        this.paintType = 0; // 0:normal,1:sticky,2:bouncy,3:slippery\\n        this.colorTimer = 0;\\n    }\\n    \\n    update(delta, level, paint) {\\n        // Input\\n        const left = keys['a'] || keys['ArrowLeft'] || (touchJoystick.active && touchJoystick.x < -0.2);\\n        const right = keys['d'] || keys['ArrowRight'] || (touchJoystick.active && touchJoystick.x > 0.2);\\n        const jump = keys[' '] || keys['ArrowUp'] || keys['w'];\\n\\n        // Horizontal movement\\n        const acc = 800 * (this.paintType === 1 ? 1.3 : this.paintType === 3 ? 0.4 : 1);\\n        const maxSpeed = 200 * (this.paintType === 1 ? 0.9 : this.paintType === 3 ? 1.4 : 1);\\n        const friction = this.onGround ? 1200 : 900;\\n        \\n        if (left) this.vx -= acc * delta;\\n        if (right) this.vx += acc * delta;\\n        if (!left && !right) {\\n            const sign = Math.sign(this.vx);\\n            this.vx -= sign * friction * delta * (this.onGround ? 1 : 0.5);\\n            if (Math.abs(this.vx) < 10 * delta) this.vx = 0;\\n        }\\n        this.vx = Math.max(-maxSpeed, Math.min(maxSpeed, this.vx));\\n        \\n        // Jump\\n        this.coyoteTimer = this.onGround ? 0.12 : Math.max(0, this.coyoteTimer - delta);\\n        this.jumpBuffer = jump ? 0.1 : Math.max(0, this.jumpBuffer - delta);\\n        if (this.jumpBuffer > 0 && this.coyoteTimer > 0) {\\n            this.vy = -520;\\n            this.onGround = false;\\n            this.coyoteTimer = 0;\\n            this.jumpBuffer = 0;\\n            // Paint jump boost\\n            if (paint.justPainted && Date.now() - paint.lastPaintTime < 50) {\\n                this.vy -= 80;\\n            }\\n            playSound('jump');\\n        }\\n        \\n        // Gravity\\n        const gravity = 1500;\\n        const terminalVel = this.vy < 0 ? 600 : 450;\\n        this.vy = Math.min(this.vy + gravity * delta, terminalVel);\\n        \\n        // Apply movement\\n        this.x += this.vx * delta;\\n        this.y += this.vy * delta;\\n        \\n        // Collision\\n        this.onGround = false;\\n        level.getPlatforms().forEach(p => {\\n            if (this.x < p.x + p.width && this.x + this.width > p.x &&\\n                this.y < p.y + p.height && this.y + this.height > p.y) {\\n                if (this.vy > 0 && this.y + this.height - this.vy * delta <= p.y + 5) {\\n                    this.y = p.y - this.height;\\n                    this.vy = 0;\\n                    this.onGround = true;\\n                    // Bouncy surface\\n                    if (p.type === 2) this.vy = -150;\\n                }\\n                if (this.vx > 0 && this.x + this.width - this.vx * delta >= p.x) this.x = p.x - this.width;\\n                if (this.vx < 0 && this.x - this.vx * delta <= p.x + p.width) this.x = p.x + p.width;\\n            }\\n        });\\n        \\n        // Paint interaction\\n        paint.getPlatforms().forEach(p => {\\n            if (this.x < p.x + p.width && this.x + this.width > p.x &&\\n                this.y < p.y + p.height && this.y + this.height > p.y) {\\n                this.paintType = p.type;\\n                this.colorTimer = 0.6;\\n                if (this.vy > 0 && this.y + this.height - this.vy * delta <= p.y + 5) {\\n                    this.y = p.y - this.height;\\n                    this.vy = 0;\\n                    this.onGround = true;\\n                }\\n            }\\n        });\\n        \\n        // Update color timer\\n        if (this.colorTimer > 0) this.colorTimer -= delta;\\n        else this.paintType = 0;\\n    }\\n    \\n    render(ctx) {\\n        ctx.save();\\n        ctx.translate(this.x + this.width/2, this.y + this.height/2);\\n        \\n// Simple player sprite\\n        ctx.fillStyle = this.colorTimer > 0 ?\\n            ['#4FC3F7','#81C784','#FFB74D','#CE93D8'][this.paintType] : '#ffffff';\\n        ctx.fillRect(-this.width/2, -this.height/2, this.width, this.height);\\n        ctx.strokeStyle = '#000000';\\n        ctx.lineWidth = 2;\\n        ctx.strokeRect(-this.width/2, -this.height/2, this.width, this.height);\\n        \\n        // Particle trail\\n        if (Math.abs(this.vx) > 50 || Math.abs(this.vy) > 50) {\\n            ctx.beginPath();\\n            ctx.moveTo(-this.width/2 * Math.sign(this.vx), -this.height/2);\\n            ctx.lineTo(-this.width/2 * Math.sign(this.vx) * 2, -this.height/2 * 1.5);\\n            ctx.strokeStyle = this.colorTimer > 0 ?\\n                ['#4FC3F7','#81C784','#FFB74D','#CE93D8'][this.paintType] : 'rgba(255,255,255,0.5)';\\n            ctx.lineWidth = 3;\\n            ctx.stroke();\\n        }\\n        \\n        ctx.restore();\\n    }\\n}",
  "src/paint.js": "export class PaintManager {\\n    constructor() {\\n        this.platforms = [];\\n        this.meter = 100;\\n        this.maxMeter = 100;\\n        this.regenRate = 4;\\n        this.cooldown = 0;\\n        this.baseCooldown = 0.35;\\n        this.consecutive = 0;\\n        this.preview = null;\\n        this.justPainted = false;\\n        this.lastPaintTime = 0;\\n        this.currentType = 0;\\n    }\\n    \\n    update(delta) {\\n        // Meter regen\\n        if (!mouse.down && this.meter < this.maxMeter) {\\n            this.meter = Math.min(this.maxMeter, this.meter + this.regenRate * delta);\\n        }\\n        \\n        // Cooldown\\n        if (this.cooldown > 0) this.cooldown -= delta;\\n        \\n        // Preview\\n        if (mouse.down && this.meter >= 8 && this.cooldown <= 0) {\\n            const dx = mouse.x - player.x - 16;\\n            const dy = mouse.y - player.y - 24;\\n            const dist = Math.sqrt(dx*dx + dy*dy);\\n            if (dist > 250) {\\n                const scale = 250 / dist;\\n                this.preview = {\\n                    x: player.x + 16 + dx * scale * 0.5,\\n                    y: player.y + 24 + dy * scale * 0.5,\\n                    width: Math.min(200, dist * 0.5),\\n                    height: Math.min(150, dist * 0.3),\\n                    angle: Math.atan2(dy, dx)\\n                };\\n            } else {\\n                this.preview = {\\n                    x: player.x + 16 + dx * 0.5,\\n                    y: player.y + 24 + dy * 0.5,\\n                    width: Math.min(200, dist * 0.5),\\n                    height: Math.min(150, dist * 0.3),\\n                    angle: Math.atan2(dy, dx)\\n                };\\n            }\\n        } else {\\n            this.preview = null;\\n        }\\n        \\n        // Create platform on release\\n        if (!mouse.down && this.preview && this.meter >= 8 && this.cooldown <= 0) {\\n            this.createPlatform(this.preview);\\n            this.meter -= 8;\\n            this.justPainted = true;\\n            this.lastPaintTime = Date.now();\\n            setTimeout(() => this.justPainted = false, 100);\\n            playSound('paint');\\n            \\n            // Update cooldown\\n            this.consecutive = Math.min(10, this.consecutive + 1);\\n            this.cooldown = Math.max(0.15, this.baseCooldown - 0.02 * this.consecutive);\\n            this.preview = null;\\n        } else if (!mouse.down) {\\n            this.consecutive = 0;\\n            this.cooldown = 0;\\n            this.preview = null;\\n        }\\n    }\\n    \\n    createPlatform(p) {\\n        this.platforms.push({\\n            x: p.x - p.width/2,\\n            y: p.y - p.height/2,\\n            width: p.width,\\n            height: p.height,\\n            type: this.currentType,\\n            created: Date.now()\\n        });\\n    }\\n    \\n    setType(type) {\\n        this.currentType = type;\\n    }\\n    \\n    getPlatforms() { return this.platforms; }\\n    \\n    render(ctx) {\\n        // Paint platforms\\n        this.platforms.forEach(p => {\\n            const age = (Date.now() - p.created) / 1000;\\n            const alpha = Math.max(0, 1 - age / 30);\\n            ctx.fillStyle = hexToRgba(['#4FC3F7','#81C784','#FFB74D','#CE93D8'][p.type], 0.3 * alpha);\\n            ctx.fillRect(p.x, p.y, p.width, p.height);\\n            ctx.strokeStyle = hexToRgba(['#4FC3F7','#81C784','#FFB74D','#CE93D8'][p.type], 0.6 * alpha);\\n            ctx.lineWidth = 2;\\n            ctx.strokeRect(p.x, p.y, p.width, p.height);\\n        });\\n        \\n        // Preview\\n        if (this.preview) {\\n            ctx.save();\\n            ctx.translate(this.preview.x, this.preview.y);\\n            ctx.rotate(this.preview.angle);\\n            ctx.fillStyle = 'rgba(255,255,255,0.1)';\\n            ctx.fillRect(-this.preview.width/2, -this.preview.height/2, this.preview.width, this.preview.height);\\n            ctx.strokeStyle = 'rgba(255,255,255,0.3)';\\n            ctx.lineWidth = 2;\n            ctx.strokeRect(-this.preview.width/2, -this.preview.height/2, this.preview.width, this.preview.height);\n            ctx.restore();\n        }\n        \n        // Meter\\n        const meterX = canvas.width - 120;\n        const meterY = 20;\n        ctx.fillStyle = 'rgba(0,0,0,0.4)';\n        ctx.fillRect(meterX, meterY, 100, 12);\n        const gradient = ctx.createLinearGradient(meterX, meterY, meterX + 100, meterY);\n        gradient.addColorStop(0, '#4FC3F7');\n        gradient.addColorStop(0.33, '#81C784');\n        gradient.addColorStop(0.66, '#FFB74D');\n        gradient.addColorStop(1, '#CE93D8');\n        ctx.fillStyle = gradient;\n        ctx.fillRect(meterX, meterY, (this.meter / this.maxMeter) * 100, 12);\n        ctx.fillStyle = '#ffffff';\n        ctx.font = '12px monospace';\n        ctx.textAlign = 'right';\n        ctx.fillText(`${Math.floor(this.meter)}/${this.maxMeter}`, meterX + 100, meterY + 10);\n    }\n}\n\nfunction hexToRgba(hex, alpha) {\n    const r = parseInt(hex.slice(1,3), 16);\n    const g = parseInt(hex.slice(3,5), 16);\n    const b = parseInt(hex.slice(5,7), 16);\n    return `rgba(${r},${g},${b},${alpha})`;\n}",
  "src/level.js": "export class LevelManager {\\n    constructor() {\\n        this.levels = [\\n            { platforms: [ {x: 0, y: 600, width: 1280, height: 40, type: 0} ], exit: {x: 1100, y: 100} },\\n            { platforms: [ \\n                {x: 0, y: 600, width: 200, height: 20, type: 0},\\n                {x: 300, y: 500, width: 200, height: 20, type: 0},\\n                {x: 600, y: 400, width: 200, height: 20, type: 0},\\n                {x: 900, y: 300, width: 200, height: 20, type: 0},\\n                {x: 1200, y: 200, width: 80, height: 20, type: 0}\\n            ], exit: {x: 1240, y: 100} },\\n            { platforms: [ \\n                {x: 0, y: 600, width: 1280, height: 40, type: 0},\\n                {x: 200, y: 500, width: 100, height: 20, type: 1},\\n                {x: 400, y: 400, width: 100, height: 20, type: 2},\\n                {x: 600, y: 300, width: 100, height: 20, type: 3}\\n            ], exit: {x: 1000, y: 150} }\\n        ];\\n        this.sandbox = { platforms: [], exit: {x: 1200, y: 100} };\\n        this.current = 0;\\n        this.mode = 'level'; // 'level' or 'sandbox'\\n    }\n    \\n    getCurrentIndex() { return this.current + 1; }\\n    \\n    getPlatforms() {\\n        if (this.mode === 'level') return this.levels[this.current].platforms;\\n        return this.sandbox.platforms;\n    }\n    \\n    update(delta) {\\n        // Sandbox: generate random platforms\\n        if (this.mode === 'sandbox' && Math.random() < 0.02) {\\n            this.sandbox.platforms.push({\\n                x: Math.random() * 1000 + 100,\\n                y: Math.random() * 500 + 100,\\n                width: Math.random() * 100 + 50,\\n                height: Math.random() * 50 + 20,\\n                type: Math.floor(Math.random() * 4)\\n            });\\n            if (this.sandbox.platforms.length > 50) this.sandbox.platforms.shift();\\n        }\n    }\n    \\n    render(ctx) {\\n        const platforms = this.getPlatforms();\\n        platforms.forEach(p => {\\n            ctx.fillStyle = '#555555';\n            ctx.fillRect(p.x, p.y, p.width, p.height);\n            ctx.strokeStyle = '#ffffff';\n            ctx.lineWidth = 2;\n            ctx.strokeRect(p.x, p.y, p.width, p.height);\n        });\n        \\n        // Exit flag\\n        const exit = this.mode === 'level' ? this.levels[this.current].exit : this.sandbox.exit;\n        ctx.fillStyle = '#ff0000';\n        ctx.fillRect(exit.x - 10, exit.y - 30, 20, 30);\n        ctx.fillStyle = '#ffff00';\n        ctx.beginPath();\n        ctx.moveTo(exit.x, exit.y - 30);\n        ctx.lineTo(exit.x - 15, exit.y - 10);\n        ctx.lineTo(exit.x + 15, exit.y - 10);\n        ctx.closePath();\n        ctx.fill();\n    }\n    \\n    isCompleted(player) {\\n        const exit = this.mode === 'level' ? this.levels[this.current].exit : this.sandbox.exit;\n        return player.y > exit.y - 50 && \\\n               player.x > exit.x - 20 && player.x < exit.x + 20;\n    }\n    \\n    nextLevel() {\\n        if (this.mode === 'level') {\\n            this.current = (this.current + 1) % this.levels.length;\n        }\n    }\n    \\n    reset() {\\n        this.current = 0;\n        this.mode = 'level';\n    }\n}",
  "src/ui.js": "export class UI {\\n    constructor() {\\n        this.showMinimap = false;\n    }\n    \\n    render(ctx, player, paint, level, highScore) {\\n        // Level indicator\\n        ctx.fillStyle = 'rgba(255,255,255,0.7)';\n        ctx.font = '18px sans-serif';\n        ctx.textAlign = 'left';\n        ctx.fillText(`${level.getCurrentIndex()}/${level.mode === 'level' ? 30 : '∞'}`, 20, 30);\n        \\n        // Paint meter (handled in paint.js)\n        \\n        // Color palette\\n        const paletteY = canvas.height - 60;\n        ['#4FC3F7','#81C784','#FFB74D','#CE93D8'].forEach((color, i) => {\\n            const x = 20 + i * 40;\n            ctx.fillStyle = i === paint.currentType ? '#ffffff' : color;\n            ctx.fillRect(x, paletteY, 30, 30);\n            ctx.strokeStyle = '#000000';\n            ctx.lineWidth = 2;\n            ctx.strokeRect(x, paletteY, 30, 30);\n        });\n        \n        // High score\n        ctx.fillStyle = 'rgba(255,255,255,0.7)';\n        ctx.textAlign = 'right';\n        ctx.fillText(`High Score: ${highScore}`, canvas.width - 20, 30);\n        \n        // Controls hint\n        if (level.mode === 'level') {\n            ctx.textAlign = 'left';\n            ctx.font = '14px sans-serif';\n            ctx.fillStyle = 'rgba(255,255,255,0.5)';\n            ctx.fillText('Press M for minimap', 20, canvas.height - 20);\n        }\n    }\n}