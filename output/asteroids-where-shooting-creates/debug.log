angle));\n}\n\nfunction createWell(bulletPos) {\n    const x = bulletPos.x;\n    const y = bulletPos.y;\n    \n    // Limit well spawn to avoid too many overlapping wells\n    if (wellCount >= 5) return;\n    \n    wells.push({\n        x: x,\n        y: y,\n        radius: CONFIG.WELL_RADIUS,\n        strength: CONFIG.WELL_STRENGTH_INITIAL,\n        lifetime: CONFIG.WELL_LIFETIME,\n        decayRate: CONFIG.WELL_DECAY_RATE\n    });\n    wellCount++;\n}\n\nfunction shipUpdate() {\n    // Rotation from thrust direction\n    if (ship.thrusting) {\n        ship.angle += CONFIG.ROTATION_SPEED;\n        ship.thrusting = false;\n    }\n    \n    // Thrust\n    if (ship.keysDown['ArrowUp'] || ship.keysDown['KeyW']) {\n        ship.velocity.y -= CONFIG.SHIP_THRUST;\n        ship.thrusting = true;\n    }\n    \n    // Rotation from left/right\n    if (ship.keysDown['ArrowLeft'] || ship.keysDown['KeyA']) {\n        ship.angle -= CONFIG.ROTATION_SPEEDjavascript
