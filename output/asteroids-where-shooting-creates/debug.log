  "main.js": "// Asteroid Grav - Main Entry Point\nconst canvas = document.getElementById('gameCanvas');\nconst ctx = canvas.getContext('2d');\n\n// --- Configuration ---\nconst CONFIG = {\n    SHIP_THRUST: 0.15,\n    ROTATION_SPEED: 0.04,\n    RETRO_THROW_FORCE: 0.5,\n    WELL_MULTIPLIER: 2.0,\n    WELL_STRENGTH_INITIAL: 0.02,\n    WELL_DECAY_RATE: 0.0005,\n    WELL_LIFETIME: 300,\n    WELL_MAX_STRENGTH: 0.1,\n    BULLET_SPEED: 12,\n    BULLET_LIFETIME: 60,\n    ASTEROID_SIZES: [10, 20, 35],\n    WELL_RADIUS: 80,\n    WELL_DECAY_RATE_PER_FRAME: 0.0005,\n};\n\n// --- State Management ---\nconst STATE = {\n    MENU: 0,\n    PLAYING: 1,\n    PAUSED: 2,\n    GAMEOVER: 3,\n};\nlet currentState = STATE.MENU;\nlet gameState = null;\n\n// --- Game Objects ---\nlet ship, asteroids, bullets, wells, particles, score = 0, highScore = 0;\nlet wellCount = 0;\n\n// --- Audio Manager (Web Audio API) ---\nconst AudioManager = {\n    ctx: null,\n    init() {\n        this.ctx = new (window.AudioContext || window.webkitAudioContext)();\n    },\n    play(type) {\n        if (!this.ctx) return;\n        const source = this.ctx.createBufferSource();\n        const gainNode = this.ctx.createGain();\n        \n        switch(type) {\n            case 'thrust':\n                // Low humming thrust sound\n                const osc = this.ctx.createOscillator();\n                const env = this.ctx.createGain();\n                osc.frequency.value = 120;\n                env.gain.setValueAtTime(0.1, this.ctx.currentTime);\n                env.gain.exponentialRampToValueAtTime(0.01, this.ctx.currentTime + 0.3);\n                source.connect(env);\n                source.connect(this.ctx.destination);\n                osc.start(this.ctx.currentTime);\n                osc.stop(this.ctx.currentTime + 0.3);\n                break;\n            case 'bullet':\n                // Short beep\n                const osc = this.ctx.createOscillator();\n                const env = this.ctx.createGain();\n                osc.type = 'square';\n                osc.frequency.setValueAtTime(800, this.ctx.currentTime);\n                env.gain.setValueAtTime(0.15, this.ctx.currentTime);\n                env.gain.exponentialRampToValueAtTime(0.001, this.ctx.currentTime + 0.08);\n                source.connect(env);\n                source.connect(this.ctx.destination);\n                osc.start(this.ctx.currentTime);\n                osc.stop(this.ctx.currentTime + 0.08);\n                break;\n            case 'explosion':\n                // Multi-tone explosion\n                const freqs = [200, 300, 400, 600];\n                freqs.forEach(f => {\n                    const osc = this.ctx.createOscillator();\n                    const env = this.ctx.createGain();\n                    osc.frequency.value = f;\n                    env.gain.setValueAtTime(0.2, this.ctx.currentTime + i * 0.03);\n                    env.gain.exponentialRampToValueAtTime(0.001, this.ctx.currentTime + i * 0.03 + 0.06);\n                    source.connect(env);\n                    source.connect(this.ctx.destination);\n                    osc.start(this.ctx.currentTime + i * 0.03);\n                    osc.stop(this.ctx.currentTime + i * 0.03 + 0.06);\n                });\n                break;\n            case 'well':\n                // Low pulsing hum\n                const osc = this.ctx.createOscillator();\n                const env = this.ctx.createGain();\n                osc.frequency.value = 40 + Math.random() * 30;\n                env.gain.setValueAtTime(0.05, this.ctx.currentTime);\n                env.gain.exponentialRampToValueAtTime(0.005, this.ctx.currentTime + 0.5);\n                source.connect(env);\n                source.connect(this.ctx.destination);\n                osc.start(this.ctx.currentTime);\n                osc.stop(this.ctx.currentTime + 0.5);\n                break;\n            case 'click':\n                // UI click\n                const osc = this.ctx.createOscillator();\n                const env = this.ctx.createGain();\n                osc.frequency.value = 500;\n                env.gain.setValueAtTime(0.1, this.ctx.currentTime);\n                env.gain.exponentialRampToValueAtTime(0.001, this.ctx.currentTime + 0.1);\n                source.connect(env);\n                source.connect(this.ctx.destination);\n                osc.start(this.ctx.currentTime);\n                osc.stop(this.ctx.currentTime + 0.1);\n                break;\n        }\n    },\n    reset() {\n        if (this.ctx) this.ctx.close();\n    }\n};\n\n// --- Initialization ---\nfunction initGame() {\n    // Load high score from localStorage\n    try {\n        const saved = localStorage.getItem('asteroid_grav_highscore');\n        if (saved) highScore = parseInt(saved, 10);\n    } catch (e) {\n        highScore = 0;\n    }\n    \n    // Reset game state\n    score = 0;\n    wellCount = 0;\n    gameState = null;\n    \n    // Create ship\n    ship = new Ship();\n    \n    // Create initial asteroids\n    asteroids = [];\n    for (let i = 0; i < 8; i++) {\n        asteroids.push(new Asteroid());\n    }\n    \n    // Create initial bullets\n    bullets = [];\n    \n    // Create initial wells\n    wells = [];\n    \n    // Setup HUD\n    updateHUD();\n}\n\nfunction setupResponsiveCanvas() {\n    function resize() {\n        const container = document.getElementById('gameContainer');\n        const rect = container.getBoundingClientRect();\n        canvas.width = rect.width * devicePixelRatio;\n        canvas.height = rect.height * devicePixelRatio;\n        canvas.style.width = rect.width + 'px';\n        canvas.style.height = rect.height + 'px';\n        ctx.setTransform(devicePixelRatio, 0, 0, devicePixelRatio, 0, 0);\n    }\n    window.addEventListener('resize', resize);\n    resize(); // Initial call\n    \n    // Also handle initial sizing\n    const dpr = window.devicePixelRatio || 1;\n    const w = window.innerWidth;\n    const h = window.innerHeight;\n    resize(w, h);\n}\n\n// --- Game Loop ---\nfunction gameLoop(timestamp) {\n    if (currentState === STATE.PLAYING || currentState === STATE.GAMEOVER) {\n        update();\n        draw();\n    }\n    requestAnimationFrame(gameLoop);\n}\n\nfunction update() {\n    if (currentState !== STATE.PLAYING && currentState !== STATE.GAMEOVER) return;\n    \n    // Apply gravity to ship\n    ship.update();\n    \n    // Update asteroids\n    for (let i = asteroids.length - 1; i >= 0; i--) {\n        const ast = asteroids[i];\n        ast.update();\n        // Remove if off-screen\n        if (ast.x < -50 || ast.x > canvas.width + 50 || ast.y < -50 || ast.y > canvas.height + 50) {\n            asteroids.splice(i, 1);\n            continue;\n        }\n    }\n    \n    // Update bullets\n    for (let i = bullets.length - 1; i >= 0; i--) {\n        const b = bullets[i];\n        b.update();\n        if (b.lifetime <= 0) {\n            bullets.splice(i, 1);\n        }\n    }\n    \n    // Update wells\n    for (let i = wells.length - 1; i >= 0; i--) {\n        const w = wells[i];\n        w.update();\n        if (w.lifetime <= 0) {\n            wells.splice(i, 1);\n        }\n    }\n    \n    // Update particles\n    for (let i = particles.length - 1; i >= 0; i--) {\n        particles[i].update();\n        if (particles[i].life <= 0) {\n            particles.splice(i, 1);\n        }\n    }\n    \n    // Update score\n    score += calculateScore();\n    \n    // Update well indicator\n    updateWellIndicator();\n    \n    // Update speedrun timer\n    if (currentState === STATE.PLAYING) {\n        speedrunTimer--;\n        if (speedrunTimer <= 0) {\n            endGame();\n        }\n    }\n}\n\nfunction calculateScore() {\n    let points = 0;\n    for (const ast of asteroids) {\n        if (ast.size > 25) points += 60;\n        else if (ast.size > 15) points += 30;\n        else points += 10;\n    }\n    return points;\n}\n\nfunction updateWellIndicator() {\n    const strength = wells.reduce((sum, w) => sum + w.strength, 0);\n    const maxStrength = wells.length * CONFIG.WELL_MAX_STRENGTH;\n    const progress = Math.min(strength / maxStrength, 1);\n    const indicator = document.getElementById('wellIndicator');\n    indicator.className = 'well-indicator ' + (progress > 0.5 ? 'active' : '');\n    indicator.style.background = progress > 0.5 ? '#00ff00' : '#000033';\n}\n\n// --- Rendering ---\nfunction draw() {\n    // Clear canvas\n    ctx.clearRect(0, 0, canvas.width / devicePixelRatio, canvas.height / devicePixelRatio);\n    \n    // Draw stars background\n    drawStars();\n    \n    // Draw wells\n    for (const well of wells) {\n        drawWell(well);\n    }\n    \n    // Draw asteroids\n    for (const ast of asteroids) {\n        drawAsteroid(ast);\n    }\n    \n    // Draw ship\n    drawShip(ship);\n    \n    // Draw bullets\n    for (const b of bullets) {\n        drawBullet(b);\n    }\n    \n    // Draw particles\n    for (const p of particles) {\n        drawParticle(p);\n    }\n    \n    // Draw HUD\n    drawHUD();\n}\n\nfunction drawStars() {\n    const numStars = 200;\n    for (let i = 0; i < numStars; i++) {\n        const x = Math.random() * canvas.width;\n        const y = Math.random() * canvas.height;\n        const size = Math.random() * 2 + 0.5;\n        ctx.fillStyle = `rgba(200, 230, 255, ${0.3 + Math.random() * 0.5})`;\n        ctx.beginPath();\n        ctx.arc(x, y, size, 0, Math.PI * 2);\n        ctx.fill();\n    }\n}\n\nfunction drawWell(well) {\n    const cx = well.x;\n    const cy = well.y;\n    const radius = CONFIG.WELL_RADIUS;\n    \n    // Gradient for well glow\n    const grad = ctx.createRadialGradient(cx, cy, 0, cx, cy, radius * 1.5);\n    grad.addColorStop(0, `rgba(0, 255, 0, 0.3)`);\n    grad.addColorStop(0.5, `rgba(0, 255, 0, 0.1)`);\n    grad.addColorStop(1, `rgba(0, 0, 0, 0)`);\n    \n    ctx.fillStyle = grad;\n    ctx.beginPath();\n    ctx.arc(cx, cy, radius * 1.5, 0, Math.PI * 2);\n    ctx.fill();\n    \n    // Inner bright ring\n    ctx.strokeStyle = '#00ff00';\n    ctx.lineWidth = 2;\n    ctx.beginPath();\n    ctx.arc(cx, cy, radius, 0, Math.PI * 2);\n    ctx.stroke();\n}\n\nfunction drawAsteroid(ast) {\n    const x = ast.x;\n    const y = ast.y;\n    const size = ast.size;\n    const angle = ast.angle;\n    \n    ctx.save();\n    ctx.translate(x, y);\n    ctx.rotate(angle);\n    \n    // Draw asteroid shape (polygonal)\n    const vertices = 6 + Math.floor(size / 10); // More vertices for larger asteroids\n    const radius = size / 2;\n    const points = [];\n    for (let i = 0; i < vertices; i++) {\n        const rx = Math.cos(i * Math.PI / vertices) * radius;\n        const ry = Math.sin(i * Math.PI / vertices) * radius;\n        points.push(rx, ry);\n    }\n    \n    ctx.beginPath();\n    ctx.moveTo(points[0][0], points[0][1]);\n    for (let i = 1; i < points.length; i++) {\n        ctx.lineTo(points[i][0], points[i][1]);\n    }\n    ctx.closePath();\n    \n    // Fill with warm orange-brown\n    ctx.fillStyle = '#b35a00';\n    ctx.fill();\n    \n    // Highlight edge\n    ctx.strokeStyle = '#ff8c00';\n    ctx.lineWidth = 1;\n    ctx.stroke();\n    \n    ctx.restore();\n}\n\nfunction drawShip(ship) {\n    const x = ship.x;\n    const y = ship.y;\n    const angle = ship.angle;\n    \n    ctx.save();\n    ctx.translate(x, y);\n    ctx.rotate(angle);\n    \n    // Ship body (star shape)\n    ctx.beginPath();\n    ctx.moveTo(0, -CONFIG.SHIP_THRUST * 0.5);\n    ctx.lineTo(CONFIG.SHIP_THRUST * 0.8, 0);\n    ctx.lineTo(0, CONFIG.SHIP_THRUST * 0.6);\n    ctx.lineTo(-CONFIG.SHIP_THRUST * 0.8, 0);\n    ctx.closePath();\n    \n    // Glow\n    ctx.shadowColor = '#00ffff';\n    ctx.shadowBlur = 15;\n    ctx.fillStyle = '#00ffff';\n    ctx.fill();\n    ctx.shadowBlur = 0;\n    \n    // Thruster flame\n    const flameAngle = angle + Math.PI / 2;\n    const flameLen = CONFIG.SHIP_THRUST * 1.5;\n    ctx.beginPath();\n    ctx.moveTo(0,