Raw: {"index.html":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, user-scalable=no\">\n    <title>Neon Road Runner</title>\n    <link href=\"https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&display=swap\" rel=\"stylesheet\">\n    <link rel=\"icon\" href=\"data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🏎️</text></svg>\">\n    <style>\n        * { margin: 0; padding: 0; box-sizing: border-box; }\n        body {\n            background: #0a0a0f;\n            display: flex;\n            justify-content: center;\n            align-items: center;\n            min-height: 100vh;\n            overflow: hidden;\n            font-family: 'Orbitron', monospace;\n        }\n        #gameCanvas { display: block; max-width: 100%; touch-action: none; }\n        .scanlines {\n            position: absolute;\n            top: 0;\n            left: 0;\n            width: 100%;\n            height: 100%;\n            pointer-events: none;\n            background: repeating-linear-gradient(0deg, transparent, transparent 2px, rgba(0,0,0,0.03) 2px, rgba(0,0,0,0.03) 4px);\n            z-index: 10;\n        }\n        .container { position: relative; }\n    </style>\n</head>\n<body>\n    <div class=\"container\">\n        <canvas id=\"gameCanvas\"></canvas>\n        <div class=\"scanlines\"></div>\n    </div>\n    <script>\n    (function() {\n        'use strict';\n        const canvas = document.getElementById('gameCanvas');\n        const ctx = canvas.getContext('2d');\n        \n        const CONFIG = {\n            GRAVITY: 0.6,\n            JUMP_VELOCITY: -15,\n            MAX_FALL_SPEED: 18,\n            GROUND_Y: 420,\n            CAR_WIDTH: 80,\n            CAR_HEIGHT: 35,\n            BASE_SPEED: 8,\n            MAX_SPEED: 15,\n            SPEED_INCREMENT: 0.001,\n            COYOTE_TIME: 6,\n            JUMP_BUFFER: 8,\n            MAX_PARTICLES: 100\n        };\n        \n        const COLORS = {\n            BG_TOP: '#0a0a0f',\n            BG_BOTTOM: '#1a1a2e',\n            ROAD: '#1a1a2e',\n            LANE: '#ff00ff',\n            CAR_BODY: '#00ffff',\n            CAR_ACCENT: '#ff6b35',\n            OBSTACLE: '#ff0055',\n            HUD: '#00ff88',\n            SCORE: '#ffff00',\n            SPEED_START: '#00ffff',\n            SPEED_END: '#ff00ff'\n        };\n        \n        let gameState = 'MENU';\n        let score = 0;\n        let highScore = parseInt(localStorage.getItem('neonRunnerHighScore')) || 0;\n        let distance = 0;\n        let currentSpeed = CONFIG.BASE_SPEED;\n        let screenShake = { x: 0, y: 0, duration: 0 };\n        let screenFlash = 0;\n        let startTime = 0;\n        let elapsedTime = 0;\n        \n        const car = {\n            x: 150,\n            y: CONFIG.GROUND_Y - CONFIG.CAR_HEIGHT,\n            width: CONFIG.CAR_WIDTH,\n            height: CONFIG.CAR_HEIGHT,\n            velocityY: 0,\n            isGrounded: true,\n            coyoteCounter: 0,\n            jumpBufferCounter: 0,\n            rotation: 0,\n            scale: 1,\n            squashPhase: -1,\n            squashTimer: 0\n        };\n        \n        const obstacles = [];\n        let obstacleTimer = 0;\n        const MIN_GAP = 300;\n        const MIN_GAP_DIFFICULTY = 200;\n        \n        const particles = [];\n        const parallaxLayers = [];\n        \n        const audioCtx = new (window.AudioContext || window.webkitAudioContext)();\n        \n        function playSound(type) {\n            const osc = audioCtx.createOscillator();\n            const gain = audioCtx.createGain();\n            osc.connect(gain);\n            gain.connect(audioCtx.destination);\n            \n            if (type === 'jump') {\n                osc.type = 'square';\n                osc.frequency.setValueAtTime(200, audioCtx.currentTime);\n                osc.frequency.exponentialRampToValueAtTime(600, audioCtx.currentTime + 0.1);\n                gain.gain.setValueAtTime(0.15, audioCtx.currentTime);\n                gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.15);\n                osc.start();\n                osc.stop(audioCtx.currentTime + 0.15);\n            } else if (type === 'land') {\n                osc.type = 'triangle';\n                osc.frequency.setValueAtTime(150, audioCtx.currentTime);\n                osc.frequency.exponentialRampToValueAtTime(80, audioCtx.currentTime + 0.1);\n                gain.gain.setValueAtTime(0.2, audioCtx.currentTime);\n                gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.1);\n                osc.start();\n                osc.stop(audioCtx.currentTime + 0.1);\n            } else if (type === 'hit') {\n                osc.type = 'sawtooth';\n                osc.frequency.setValueAtTime(100, audioCtx.currentTime);\n                osc.frequency.exponentialRampToValueAtTime(30, audioCtx.currentTime + 0.3);\n                gain.gain.setValueAtTime(0.25, audioCtx.currentTime);\n                gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.3);\n                osc.start();\n                osc.stop(audioCtx.currentTime + 0.3);\n            } else if (type === 'score') {\n                osc.type = 'sine';\n                osc.frequency.setValueAtTime(800, audioCtx.currentTime);\n                osc.frequency.setValueAtTime(1000, audioCtx.currentTime + 0.05);\n                gain.gain.setValueAtTime(0.1, audioCtx.currentTime);\n                gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.1);\n                osc.start();\n                osc.stop(audioCtx.currentTime + 0.1);\n            }\n        }\n        \n        function initCanvas() {\n            const width = Math.min(window.innerWidth, 1200);\n            canvas.width = width;\n            canvas.height = 500;\n            initParallax();\n        }\n        \n        function initParallax() {\n            parallaxLayers.length = 0;\n            for (let layer = 0; layer < 3; layer++) {\n                const elements = [];\n                const count = layer === 0 ? 8 : (layer === 1 ? 12 : 20);\n                const baseY = layer === 0 ? 100 : (layer === 1 ? 180 : 280);\n                for (let i = 0; i < count; i++) {\n                    elements.push({\n                        x: (canvas.width / count) * i + Math.random() * 50,\n                        y: baseY + Math.random() * 40,\n                        width: 20 + Math.random() * 60,\n                        height: 30 + Math.random() * 80,\n                        type: Math.floor(Math.random() * 3)\n                    });\n                }\n                parallaxLayers.push({ elements, speed: (layer + 1) * 0.3 });\n            }\n        }\n        \n        function resetGame() {\n            score = 0;\n            distance = 0;\n            currentSpeed = CONFIG.BASE_SPEED;\n            car.y = CONFIG.GROUND_Y - CONFIG.CAR_HEIGHT;\n            car.velocityY = 0;\n            car.isGrounded = true;\n            car.rotation = 0;\n            car.scale = 1;\n            car.coyoteCounter = 0;\n            car.jumpBufferCounter = 0;\n            car.squashPhase = -1;\n            obstacles.length = 0;\n            particles.length = 0;\n            obstacleTimer = 0;\n            screenShake = { x: 0, y: 0, duration: 0 };\n            screenFlash = 0;\n            startTime = Date.now();\n        }\n        \n        function spawnObstacle() {\n            const types = ['barrier', 'spike', 'hurdle', 'gap'];\n            const weights = [0.4, 0.25, 0.25, 0.1];\n            const rand = Math.random();\n            let cumulative = 0;\n            let type = 'barrier';\n            for (let i = 0; i < types.length; i++) {\n                cumulative += weights[i];\n                if (rand < cumulative) { type = types[i]; break; }\n            }\n            const obstacle = { x: canvas.width + 50, type: type, passed: false };\n            switch(type) {\n                case 'barrier':\n                    obstacle.width = 40; obstacle.height = 50; obstacle.y = CONFIG.GROUND_Y - 50; break;\n                case 'spike':\n                    obstacle.width = 30; obstacle.height = 40; obstacle.y = CONFIG.GROUND_Y - 40; break;\n                case 'hurdle':\n                    obstacle.width = 60; obstacle.height = 20; obstacle.y = CONFIG.GROUND_Y - 20; break;\n                case 'gap':\n                    obstacle.width = 100; obstacle.height = 80; obstacle.y = CONFIG.GROUND_Y; break;\n            }\n            obstacles.push(obstacle);\n        }\n        \n        function spawnParticle(x, y, color, type) {\n            if (particles.length >= CONFIG.MAX_PARTICLES) return;\n            particles.push({\n                x, y,\n                vx: (Math.random() - 0.5) * (type === 'spark' ? 8 : 3),\n                vy: (Math.random() - 0.5) * (type === 'spark' ? 8 : 3) - (type === 'trail' ? 2 : 0),\n                life: 1,\n                decay: type === 'spark' ? 0.05 : 0.03,\n                size: type === 'spark' ? 4 : 6,\n                color\n            });\n        }\n        \n        function spawnLandingParticles() {\n            for (let i = 0; i < 15; i++) {\n                spawnParticle(car.x + car.width / 2, CONFIG.GROUND_Y, COLORS.CAR_BODY, 'burst');\n            }\n        }\n        \n        function updateParticles() {\n            for (let i = particles.length - 1; i >= 0; i--) {\n                const p = particles[i];\n                p.x += p.vx;\n                p.y += p.vy;\n                p.life -= p.decay;\n                p.vy += 0.1;\n                if (p.life <= 0) particles.splice(i, 1);\n            }\n        }\n        \n        function drawParticles() {\n            particles.forEach(p => {\n                ctx.save();\n                ctx.globalAlpha = p.life;\n                ctx.fillStyle = p.color;\n                ctx.shadowColor = p.color;\n                ctx.shadowBlur = 10;\n                ctx.beginPath();\n                ctx.arc(p.x, p.y, p.size * p.life, 0, Math.PI * 2);\n                ctx.fill();\n                ctx.restore();\n            });\n        }\n        \n        function jump() {\n            if (car.isGrounded || car.coyoteCounter > 0) {\n                car.velocityY = CONFIG.JUMP_VELOCITY;\n                car.isGrounded = false;\n                car.coyoteCounter = 0;\n                car.jumpBufferCounter = 0;\n                screenFlash = 0.3;\n                playSound('jump');\n                for (let i = 0; i < 8; i++) {\n                    spawnParticle(car.x + 20, car.y + car.height, COLORS.CAR_BODY, 'trail');\n                }\n            } else {\n                car.jumpBufferCounter = CONFIG.JUMP_BUFFER;\n            }\n        }\n        \n        function updateCar() {\n            if (!car.isGrounded) {\n                car.velocityY += CONFIG.GRAVITY;\n                if (car.velocityY > CONFIG.MAX_FALL_SPEED) car.velocityY = CONFIG.MAX_FALL_SPEED;\n                car.y += car.velocityY;\n                car.rotation = car.velocityY < 0 ? -0.26 : 0.17;\n                if (Math.random() < 0.3) {\n                    spawnParticle(car.x + 20, car.y + car.height, COLORS.CAR_ACCENT, 'spark');\n                }\n            } else {\n                car.rotation = Math.sin(Date.now() * 0.01) * 0.02;\n                if (Math.random() < 0.2) {\n                    spawnParticle(car.x + 30, CONFIG.GROUND_Y, COLORS.CAR_BODY, 'trail');\n                }\n            }\n            if (car.y >= CONFIG.GROUND_Y - car.height) {\n                if (!car.isGrounded) {\n                    car.squashPhase = 0;\n                    spawnLandingParticles();\n                    playSound('land');\n                }\n                car.y = CONFIG.GROUND_Y - car.height;\n                car.velocityY = 0;\n                car.isGrounded = true;\n                car.coyoteCounter = CONFIG.COYOTE_TIME;\n            }\n            if (car.coyoteCounter > 0) car.coyoteCounter--;\n            if (car.jumpBufferCounter > 0) {\n                car.jumpBufferCounter--;\n                if (car.isGrounded) jump();\n            }\n            if (car.squashPhase >= 0) {\n                car.squashTimer++;\n                const squashDuration = 10;\n                const t = car.squashTimer / squashDuration;\n                if (t < 0.33) car.scale = 1 - t * 0.3;\n                else if (t < 0.66) car.scale = 0.9 + (t - 0.33) * 0.6;\n                else if (t < 1) car.scale = 1.1 - (t - 0.66) * 0.3;\n                else { car.scale = 1; car.squashPhase = -1; car.squashTimer = 0; }\n            }\n        }\n        \n        function updateObstacles() {\n            obstacleTimer++;\n            const difficultyReduction = Math.floor(score / 1000) * 5;\n            const currentMinGap = Math.max(MIN_GAP_DIFFICULTY, MIN_GAP - difficultyReduction);\n            if (obstacles.length === 0 || (obstacles[obstacles.length - 1].x < canvas.width - currentMinGap && obstacleTimer > 60)) {\n                if (obstacleTimer > 120) { spawnObstacle(); obstacleTimer = 0; }\n            }\n            for (let i = obstacles.length - 1; i >= 0; i--) {\n                const obs = obstacles[i];\n                obs.x -= currentSpeed;\n                const hitboxShrink = 10;\n                const carHitbox = {\n                    x: car.x + hitboxShrink,\n                    y: car.y + hitboxShrink,\n                    width: car.width - hitboxShrink * 2,\n                    height: car.height - hitboxShrink * 2\n                };\n                if (obs.type === 'gap') {\n                    const carCenter = car.x + car.width / 2;\n                    const carBottom = car.y + car.height;\n                    if (carCenter > obs.x && carCenter < obs.x + obs.width) {\n                        if (carBottom >= CONFIG.GROUND_Y - 5) { gameOver(); return; }\n                    }\n                } else {\n                    if (carHitbox.x < obs.x + obs.width && carHitbox.x + carHitbox.width > obs.x &&\n                        carHitbox.y < obs.y + obs.height && carHitbox.y + carHitbox.height > obs.y) {\n                        gameOver(); return;\n                    }\n                }\n                if (!obs.passed && obs.x + obs.width < car.x) {\n                    obs.passed = true;\n                    score += 50;\n                    playSound('score');\n                }\n                if (obs.x + obs.width < -50) obstacles.splice(i, 1);\n            }\n        }\n        \n        function gameOver() {\n            gameState = 'GAME_OVER';\n            screenShake.duration = 12;\n            playSound('hit');\n            for (let i = 0; i < 30; i++) {\n                spawnParticle(car.x + car.width / 2, car.y + car.height / 2, COLORS.OBSTACLE, 'burst');\n            }\n            if (score > highScore) {\n                highScore = score;\n                localStorage.setItem('neonRunnerHighScore', highScore);\n            }\n        }\n        \n        function updateParallax() {\n            parallaxLayers.forEach(layer => {\n                layer.elements.forEach(el => {\n                    el.x -= currentSpeed * layer.speed;\n                    if (el.x + el.width < 0) el.x = canvas.width + Math.random() * 100;\n                });\n            });\n        }\n        \n        function updateScreenEffects() {\n            if (screenShake.duration > 0) {\n                screenShake.x = (Math.random() - 0.5) * 10;\n                screenShake.y = (Math.random() - 0.5) * 10;\n                screenShake.duration--;\n            } else { screenShake.x = 0; screenShake.y = 0; }\n            if (screenFlash > 0) screenFlash -= 0.05;\n        }\n        \n        function drawBackground() {\n            const gradient = ctx.createLinearGradient(0, 0, 0, canvas.height);\n            gradient.addColorStop(0, COLORS.BG_TOP);\n            gradient.addColorStop(1, COLORS.BG_BOTTOM);\n            ctx.fillStyle = gradient;\n            ctx.fillRect(0, 0, canvas.width, canvas.height);\n            parallaxLayers.forEach((layer, idx) => {\n                const alpha = idx === 0 ? 0.3 : (idx === 1 ? 0.15 : 0.08);\n                ctx.fillStyle = `rgba(255, 0, 255, ${alpha})`;\n                layer.elements.forEach(el => {\n                    ctx.save();\n                    ctx.shadowColor = COLORS.LANE;\n                    ctx.shadowBlur = 5;\n                    if (el.type === 0) ctx.fillRect(el.x, el.y, el.width, el.height);\n                    else if (el.type === 1) {\n                        ctx.beginPath();\n                        ctx.moveTo(el.x + el.width / 2, el.y);\n                        ctx.lineTo(el.x + el.width, el.y + el.height);\n                        ctx.lineTo(el.x, el.y + el.height);\n                        ctx.closePath();\n                        ctx.fill();\n                    } else {\n                        ctx.beginPath();\n                        ctx.arc(el.x + el.width / 2, el.y + el.height / 2, el.width / 2, 0, Math.PI * 2);\n                        ctx.fill();\n                    }\n                    ctx.restore();\n                });\n            });\n            ctx.fillStyle = 'rgba(255, 255, 255, 0.02)';\n            for (let i = 0; i < 50; i++) {\n                const x = (i * 73 + distance * 0.2) % canvas.width;\n                const y = (i * 37) % 400;\n                ctx.fillRect(x, y, 1, 1);\n            }\n        }\n        \n        function drawRoad() {\n            ctx.fillStyle = COLORS.ROAD;\n            ctx.fillRect(0, CONFIG.GROUND_Y, canvas.width, 80);\n            ctx.strokeStyle = COLORS.LANE;\n            ctx.lineWidth = 3;\n            ctx.shadowColor = COLORS.LANE;\n            ctx.shadowBlur = 15;\n            const dashLength = 50;\n            const gapLength = 30;\n            const totalLength = dashLength + gapLength;\n            const offset = (distance * currentSpeed) % totalLength;\n            ctx.beginPath();\n            ctx.moveTo(-offset, CONFIG.GROUND_Y + 40);\n            ctx.lineTo(canvas.width, CONFIG.GROUND_Y + 40);\n            ctx.stroke();\n            ctx.beginPath();\n            ctx.moveTo(0, CONFIG.GROUND_Y);\n            ctx.lineTo(canvas.width, CONFIG.GROUND_Y);\n            ctx.stroke();\n            ctx.beginPath();\n            ctx.moveTo(0, CONFIG.GROUND_Y + 80);\n            ctx.lineTo(canvas.width, CONFIG.GROUND_Y + 80);\n            ctx.stroke();\n            ctx.shadowBlur = 0;\n            ctx.fillStyle = 'rgba(255, 255, 255, 0.05)';\n            ctx.fillRect(0, CONFIG.GROUND_Y, canvas.width, 2);\n        }\n        \n        function drawCar() {\n            ctx.save();\n            ctx.translate(car.x + car.width / 2, car.y + car.height / 2);\n            ctx.rotate(car.rotation);\n            ctx.scale(1, car.scale);\n            ctx.shadowColor = COLORS.CAR_BODY;\n            ctx.shadowBlur = 20;\n            ctx.fillStyle = COLORS.CAR_BODY;\n            ctx.beginPath();\n            ctx.moveTo(-40, 10);\n            ctx.lineTo(-35, -5);\n            ctx.lineTo(-20, -15);\n            ctx.lineTo(10, -15);\n            ctx.lineTo(25, -10);\n            ctx.lineTo(40, -5);\n            ctx.lineTo(40, 10);\n            ctx.lineTo(-40, 10);\n            ctx.closePath();\n            ctx.fill();\n            ctx.fillStyle = COLORS.CAR_ACCENT;\n            ctx.fillRect(-15, -8, 25, 6);\n            ctx.fillStyle = '#000';\n            ctx.fillRect(30, -5, 8, 5);\n            ctx.fillRect(-35, -2, 8, 4);\n            ctx.fillStyle = COLORS.CAR_BODY;\n            ctx.shadowBlur = 10;\n            ctx.beginPath();\n            ctx.arc(-25, 12, 8, 0, Math.PI * 2);\n            ctx.arc(25, 12, 8, 0, Math.PI * 2);\n            ctx.fill();\n            ctx.fillStyle = '#333';\n            ctx.beginPath();\n            ctx.arc(-25, 12, 5, 0, Math.PI * 2);\n            ctx.arc(25, 12, 5, 0, Math.PI * 2);\n            ctx.fill();\n            ctx.restore();\n        }\n        \n        function drawObstacles() {\n            obstacles.forEach(obs => {\n                ctx.save();\n                ctx.shadowColor = COLORS.OBSTACLE;\n                ctx.shadowBlur = 15;\n                const offsetX = (Math.random() - 0.5) * 2;\n                const offsetY = (Math.random() - 0.5) * 2;\n                ctx.fillStyle = COLORS.OBSTACLE;\n                if (obs.type === 'spike') {\n                    ctx.beginPath();\n                    ctx.moveTo(obs.x + obs.width / 2 + offsetX, obs.y + offsetY);\n                    ctx.lineTo(obs.x + obs.width + offsetX, obs.y + obs.height + offsetY);\n                    ctx.lineTo(obs.x + offsetX, obs.y + obs.height + offsetY);\n                    ctx.closePath();\n                    ctx.fill();\n                    ctx.fillStyle = '#fff';\n                    ctx.beginPath();\n                    ctx.moveTo(obs.x + obs.width / 2, obs.y + 10);\n                    ctx.lineTo(obs.x + obs.width - 5, obs.y + obs.height - 5);\n                    ctx.lineTo(obs.x + 5, obs.y + obs.height - 5);\n                    ctx.closePath();\n                    ctx.fill();\n                } else if (obs.type === 'gap') {\n                    ctx.fillStyle = '#000';\n                    ctx.fillRect(obs.x, obs.y, obs.width, obs.height);\n                    ctx.strokeStyle = COLORS.OBSTACLE;\n                    ctx.lineWidth = 3;\n                    ctx.beginPath();\n                    ctx.moveTo(obs.x, obs.y);\n                    ctx.lineTo(obs.x, obs.y + obs.height);\n                    ctx.stroke();\n                    ctx.beginPath();\n                    ctx.moveTo(obs.x + obs.width, obs.y);\n                    ctx.lineTo(obs.x + obs.width, obs.y + obs.height);\n                    ctx.stroke();\n                } else {\n                    ctx.fillRect(obs.x + offsetX, obs.y + offsetY, obs.width, obs.height);\n                    ctx.fillStyle = '#fff';\n                    const stripeCount = obs.type === 'hurdle' ? 2 : 3;\n                    const stripeWidth = obs.width / (stripeCount * 2);\n                    for (let i = 0; i < stripeCount; i++) {\n                        ctx.fillRect(obs.x + stripeWidth * (i * 2 + 0.5) + offsetX, obs.y + 5 + offsetY, stripeWidth, obs.height - 10);\n                    }\n                }\n                ctx.shadowColor = '#ff0055';\n                ctx.shadowBlur = 20;\n                ctx.strokeStyle = 'rgba(255, 255, 255, 0.3)';\n                ctx.lineWidth = 1;\n                if (obs.type !== 'gap') {\n                    ctx.strokeRect(obs.x + offsetX, obs.y + offsetY, obs.width, obs.height);\n                }\n                ctx.restore();\n            });\n        }\n        \n        function formatTime(ms) {\n            const minutes = Math.floor(ms / 60000);\n            const seconds = Math.floor((ms % 60000) / 1000);\n            const centis = Math.floor((ms % 1000) / 10);\n            return `${String(minutes).padStart(2, '0')}:${String(seconds).padStart(2, '0')}.${String(centis).padStart(2, '0')}`;\n        }\n        \n        function drawHUD() {\n            ctx.save();\n            ctx.shadowBlur = 0;\n            ctx.font = '14px Orbitron';\n            ctx.fillStyle = COLORS.SCORE;\n            ctx.shadowColor = COLORS.SCORE;\n            ctx.shadowBlur = 8;\n            ctx.fillText('TIME ' + formatTime(elapsedTime), 20, 25);\n            ctx.font = '24px Orbitron';\n            ctx.fillStyle = COLORS.HUD;\n            ctx.shadowColor = COLORS.HUD;\n            ctx.shadowBlur = 10;\n            ctx.fillText('SCORE: ' + String(score).padStart(5, '0'), 20, 55);\n            ctx.font = '14px Orbitron';\n            ctx.fillStyle = '#888';\n            ctx.shadowBlur = 5;\n            ctx.fillText('HI: ' + String(highScore).padStart(5, '0'), 20, 80);\n            const speedPercent = (currentSpeed - CONFIG.BASE_SPEED) / (CONFIG.MAX_SPEED - CONFIG.BASE_SPEED);\n            const meterWidth = 120;\n            const meterHeight = 16;\n            const meterX = canvas.width - meterWidth - 20;\n            const meterY = 25;\n            ctx.fillStyle = '#222';\n            ctx.fillRect(meterX, meterY, meterWidth, meterHeight);\n            const gradient = ctx.createLinearGradient(meterX, 0, meterX + meterWidth, 0);\n            gradient.addColorStop(0, COLORS.SPEED_START);\n            gradient.addColorStop(1, COLORS.SPEED_END);\n            ctx.fillStyle = gradient;\n            ctx.fillRect(meterX, meterY, meterWidth * speedPercent, meterHeight);\n            ctx.strokeStyle = COLORS.CAR_BODY;\n            ctx.lineWidth = 2;\n            ctx.strokeRect(meterX, meterY, meterWidth, meterHeight);\n            ctx.font = '10px Orbitron';\n            ctx.fillStyle = COLORS.CAR_BODY;\n            ctx.fillText('SPEED', meterX, meterY - 4);\n            ctx.font = '16px Orbitron';\n            ctx.fillStyle = COLORS.HUD;\n            ctx.shadowColor = COLORS.HUD;\n            ctx.fillText(String(Math.floor(distance / 10)) + 'm', 20, canvas.height - 25);\n            ctx.restore();\n        }\n        \n        function drawMenu() {\n            ctx.save();\n            ctx.fillStyle = 'rgba(0, 0, 0, 0.7)';\n            ctx.fillRect(0, 0, canvas.width, canvas.height);\n            ctx.font = '42px Orbitron';\n            ctx.fillStyle = COLORS.LANE;\n            ctx.shadowColor = COLORS.LANE;\n            ctx.shadowBlur = 30;\n            ctx.textAlign = 'center';\n            ctx.fillText('NEON ROAD RUNNER', canvas.width / 2, canvas.height / 2 - 60);\n            ctx.font = '16px Orbitron';\n            ctx.fillStyle = COLORS.CAR_BODY;\n            ctx.shadowColor = COLORS.CAR_BODY;\n            ctx.shadowBlur = 15;\n            ctx.fillText('JUMP TO SURVIVE', canvas.width / 2, canvas.height / 2 - 20);\n            const pulse = Math.sin(Date.now() * 0.005) * 0.3 + 0.7;\n            ctx.globalAlpha = pulse;\n            ctx.font = '18px Orbitron';\n            ctx.fillStyle = COLORS.HUD;\n            ctx.shadowColor = COLORS.HUD;\n            ctx.fillText('PRESS SPACE TO START', canvas.width / 2, canvas.height / 2 + 40);\n            ctx.globalAlpha = 1;\n            ctx.font = '12px Orbitron';\n            ctx.fillStyle = '#666';\n            ctx.shadowBlur = 0;\n            ctx.fillText('SPACE / W / UP / TAP', canvas.width / 2, canvas.height / 2 + 80);\n            ctx.restore();\n        }\n        \n        function drawGameOver() {\n            ctx.save();\n            ctx.fillStyle = 'rgba(0, 0, 0, 0.7)';\n            ctx.fillRect(0, 0, canvas.width, canvas.height);\n            ctx.font = '32px Orbitron';\n            ctx.fillStyle = COLORS.OBSTACLE;\n            ctx.shadowColor = COLORS.OBSTACLE;\n            ctx.shadowBlur = 20;\n            ctx.textAlign = 'center';\n            ctx.fillText('GAME OVER', canvas.width / 2, canvas.height / 2 - 80);\n            ctx.font = '20px Orbitron';\n            ctx.fillStyle = COLORS.SCORE;\n            ctx.shadowColor = COLORS.SCORE;\n            ctx.shadowBlur = 15;\n            ctx.fillText('SCORE: ' + score, canvas.width / 2, canvas.height / 2 - 30);\n            ctx.fillText('TIME: ' + formatTime(elapsedTime), canvas.width / 2, canvas.height / 2);\n            if (score >= highScore && score > 0) {\n                ctx.font = '16px Orbitron';\n                ctx.fillStyle = COLORS.HUD;\n                ctx.shadowColor = COLORS.HUD;\n                ctx.fillText('NEW HIGH SCORE!', canvas.width / 2, canvas.height / 2 + 30);\n            }\n            ctx.font = '14px Orbitron';\n            ctx.fillStyle = '#888';\n            ctx.shadowBlur = 0;\n            ctx.fillText('BEST: ' + highScore, canvas.width / 2, canvas.height / 2 + 55);\n            const pulse = Math.sin(Date.now() * 0.005) * 0.3 + 0.7;\n            ctx.globalAlpha = pulse;\n            ctx.font = '18px Orbitron';\n            ctx.fillStyle = COLORS.CAR_BODY;\n            ctx.shadowColor = COLORS.CAR_BODY;\n            ctx.shadowBlur = 10;\n            ctx.fillText('PRESS SPACE TO RESTART', canvas.width / 2, canvas.height / 2 + 100);\n            ctx.restore();\n        }\n        \n        function drawScreenFlash() {\n            if (screenFlash > 0) {\n                ctx.fillStyle = 'rgba(255, 255, 255, ' + screenFlash + ')';\n                ctx.fillRect(0, 0, canvas.width, canvas.height);
            }
        }
        
        function update() {
            if (gameState === 'PLAYING') {
                elapsedTime = Date.now() - startTime;
                distance += currentSpeed;
                score = Math.floor(distance / 10);
                if (currentSpeed < CONFIG.MAX_SPEED) {
                    currentSpeed += CONFIG.SPEED_INCREMENT;
                }
                updateCar();
                updateObstacles();
                updateParticles();
                updateParallax();
                updateScreenEffects();
            }
        }
        
        function draw() {
            ctx.save();
            ctx.translate(screenShake.x, screenShake.y);
            drawBackground();
            drawRoad();
            drawParticles();
            drawObstacles();
            drawCar();
            ctx.restore();
            drawHUD();
            drawScreenFlash();
            if (gameState === 'MENU') drawMenu();
            if (gameState === 'GAME_OVER') drawGameOver();
        }
        
        function gameLoop() {
            update();
            draw();
            requestAnimationFrame(gameLoop);
        }
        
        function startGame() {
            if (audioCtx.state === 'suspended') {
                audioCtx.resume();
            }
            resetGame();
            gameState = 'PLAYING';
        }
        
        function handleInput() {
            if (gameState === 'MENU' || gameState === 'GAME_OVER') {
                startGame();
            } else if (gameState === 'PLAYING') {
                jump();
            }
        }
        
        document.addEventListener('keydown', (e) => {
            if (e.code === 'Space' || e.code === 'KeyW' || e.code === 'ArrowUp') {
                e.preventDefault();
                handleInput();
            }
        });
        
        canvas.addEventListener('touchstart', (e) => {
            e.preventDefault();
            handleInput();
        });
        
        canvas.addEventListener('click', handleInput);
        
        window.addEventListener('resize', initCanvas);
        
        initCanvas();
        gameLoop();
    })();
    </script>
</body>
</html>"}