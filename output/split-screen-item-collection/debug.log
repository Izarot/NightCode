  entity.addComponent('dashState', 'idle');
  entity.addComponent('dashTimer', 0);
  entity.addComponent('dashCooldown', 0);
  entity.addComponent('dashInvulnTimer', 0);
  entity.addComponent('facingDir', 1); // 1 for right, -1 for left
  entity.addComponent('onGround', true);
  world.addEntity(entity);
  return entity;
}
