// Timer
let startTime = performance.now();
function getElapsed() {
  return (performance.now() - startTime) / 1000;
}

// High score
let highScore = parseInt(localStorage.getItem('dualityDriftHighScore')) || 0;

// Game loop
function gameLoop(timestamp) {
  const delta = (timestamp - (world.lastTime || timestamp)) / 1000;
  world.lastTime = timestamp;
  world.tick(delta);
  // Render
  ctx.clearRect(0, 0, canvas.width, canvas.height);
  // Draw split screen: top half for p1, bottom for p2
  const halfHeight = height / 2;
  // Player 1 viewport
  ctx.save();
  ctx.translate(0, 0);
  // draw world for p1 (y from 0 to halfHeight)
  world.render(ctx);
  ctx.restore();
  // Player 2 viewport
  ctx.save();
  ctx.translate(0, halfHeight);
  world.render(ctx);
  ctx.restore();
  // Draw HUD
  drawHUD();
  // Draw timer
  ctx.fillStyle = COLORS.white;
  ctx.font = '20px JetBrains Mono';
  ctx.fillText(`Time: ${getElapsed().toFixed(2)}s`, 10, 30);
  // High score
  ctx.fillText(`High: ${highScore}`, 10, 50);
  // Request next frame
  requestAnimationFrame(gameLoop);
}
requestAnimationFrame(gameLoop);

