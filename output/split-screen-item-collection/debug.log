class World {
  constructor() {
    this.entities = [];
    this.systems = [];
    this.inputState = {};
  }
  addEntity(entity) { this.entities.push(entity); }
  addSystem(system) { this.systems.push(system); }
  tick(delta) {
    this.systems.forEach(s => s.update(this, delta));
  }
  render(ctx) {
    this.systems.forEach(s => s.render(ctx));
  }
}
export default World;

