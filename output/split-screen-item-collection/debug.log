"const canvas = document.getElementById('gameCanvas');\nconst ctx = canvas.getContext('2d');\nlet width, height;\nfunction resize(){ width = window.innerWidth; height = window.innerHeight; canvas.width = width * window.devicePixelRatio; canvas.height = height * window.devicePixelRatio; ctx.scale(window.devicePixelRatio, window.devicePixelRatio); }\nwindow.addEventListener('resize', resize);\nresize();\n\nconst COLORS = {\n  deepVoid: '#050510',\n  cyan: '#00FFFF',\n  magenta: '#FF00FF',\n  gold: '#FFD700',\n  white: '#FFFFFF'\n};\n\nconst audioCtx = new (window.AudioContext || window.webkitAudioContext)();\nfunction playSound(freq, dur, type='sine'){\n  const osc = audioCtx.createOscillator();\n  const gain = audioCtx.createGain();\n  osc.type = type;\n  osc.frequency.value = freq;\n  gain.gain.setValueAtTime(0, audioCtx.currentTime);\n  gain.gain.linearRampToValueAtTime(0.2, audioCtx.currentTime + 0.01);\n  gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + dur);\n  osc.connect(gain);\n  gain.connect(audioCtx.destination);\n  osc.start();\n  osc.stop(audioCtx.currentTime + dur);\n}\n\nconst world = new World();\nworld.inputState = { p1: {}, p2: {} };\n\nwindow.addEventListener('keydown', e => {\n  const player = e.key === 'w' || e.key === 'ArrowUp' ? 'p1' : e.key === 's' || e.key === 'ArrowDown' ? 'p1' : e.key === 'a' || e.key === 'ArrowLeft' ? 'p1' : e.key === 'd' || e.key === 'ArrowRight' ? 'p1' : e.key === 'Shift' || e.key === 'rShift' ? 'p1' : e.key === 'Enter' || e.key === 'e' ? 'p1' : null;\n  if (!player) return;\n  const state = world.inputState[player];\n  if (e.key === 'w' || e.key === 'ArrowUp') state.jump = true;\n  if (e.key === 's' || e.key === 'ArrowDown') state.moveDown = true;\n  if (e.key === 'a' || e.key === 'ArrowLeft') state.moveLeft = true;\n  if (e.key === 'd' || e.key === 'ArrowRight') state.moveRight = true;\n  if (e.key === 'Shift' || e.key === 'rShift') state.dash = true;\n  if (e.key === 'Enter' || e.key === 'e') state.bank = true;\n});\nwindow.addEventListener('keyup', e => {\n  const player = e.key === 'w' || e.key === 'ArrowUp' ? 'p1' : e.key === 's' || e.key === 'ArrowDown' ? 'p1' : e.key === 'a' || e.key === 'ArrowLeft' ? 'p1' : e.key === 'd' || e.key === 'ArrowRight' ? 'p1' : e.key === 'Shift' || e.key === 'rShift' ? 'p1' : e.key === 'Enter' || e.key === 'e' ? 'p1' : null;\n  if (!player) return;\n  const state = world.inputState[player];\n  if (e.key === 'w' || e.key === 'ArrowUp') state.jump = false;\n  if (e.key === 's' || e.key === 'ArrowDown') state.moveDown = false;\n  if (e.key === 'a' || e.key === 'ArrowLeft') state.moveLeft = false;\n  if (e.key === 'd' || e.key === 'ArrowRight') state.moveRight = false;\n  if (e.key === 'Shift' || e.key === 'rShift') state.dash = false;\n  if (e.key === 'Enter' || e.key === 'e') state.bank = false;\n});\nconst gp = navigator.getGamepads()[0];\nif (gp) {\n  const player = gp.id % 2 === 0 ? 'p1' : 'p2';\n  const state = world.inputState[player];\n  state.left = gp.axes[0] < -0.5;\n  state.right = gp.axes[0] > 0.5;\n  state.jump = gp.buttons[0].pressed;\n  state.dash = gp.buttons[1].pressed;\n  state.bank = gp.buttons[2].pressed;\n}\n\nlet startTime = performance.now();\nlet highScore = parseInt(localStorage.getItem('dualityDriftHighScore')) || 0;\n\nfunction gameLoop(timestamp) {\n  const delta = (timestamp - (world.lastTime || timestamp)) / 1000;\n  world.lastTime = timestamp;\n  world.tick(delta);\n  // Render split-screen\n  const halfHeight = height / 2;\n  ctx.clearRect(0, 0, canvas.width, canvas.height);\n  // top half (p1)\n  ctx.save();\n  ctx.translate(0, 0);\n  world.render(ctx);\n  ctx.restore();\n  // bottom half (p2)\n  ctx.save();\n  ctx.translate(0, halfHeight);\n  world.render(ctx);\n  ctx.restore();\n  // HUD\n  drawHUD();\n  // timer\n  ctx.fillStyle = COLORS.white;\n  ctx.font = '20px JetBrains Mono';\n  ctx.fillText(`Time: ${(getElapsed()).toFixed(2)}s`, 10, 30);\n  ctx.fillText(`High: ${highScore}`, 10, 50);\n  requestAnimationFrame(gameLoop);\n}\nfunction getElapsed(){ return (performance.now() - startTime) / 1000; }\n\n// HUD drawing\nfunction drawHUD(){\n  const hud = document.getElementById('hud');\n  // stability bars\n  const p1StabBar = document.getElementById('p1-stab') || document.createElement('div');\n  p1StabBar.id = 'p1-stab';\n  p1StabBar.style.position = 'absolute';\n  p1StabBar.style.top = '10px';\n  p1StabBar.style.left = '10px';\n  p1StabBar.style.width = '200px';\n  p1StabBar.style.height = '20px';\n  p1StabBar.style.background = 'rgba(0,0,0,0.6)';\n  p1StabBar.style.border = '1px solid ' + COLORS.cyan;\n  p1StabBar.style.borderRadius = '4px';\n  hud.appendChild(p1StabBar);\n  const p2StabBar = document.getElementById('p2-stab') || document.createElement('div');\n  p2StabBar.id = 'p2-stab';\n  p2StabBar.style.position = 'absolute';\n  p2StabBar.style.top = '10px';\n  p2StabBar.style.left = '220px';\n  p2StabBar.style.width = '200px';\n  p2StabBar.style.height = '20px';\n  p2StabBar.style.background = 'rgba(0,0,0,0.6)';\n  p2StabBar.style.border = '1px solid ' + COLORS.magenta;\n  p2StabBar.style.borderRadius = '4px';\n  hud.appendChild(p2StabBar);\n  // carry indicators\n  const p1Carry = document.getElementById('p1-carry') || document.createElement('div');\n  p1Carry.id = 'p1-carry';\n  p1Carry.style.position = 'absolute';\n  p1Carry.style.top = '30px';\n  p1Carry.style.left = '10px';\n  p1Carry.style.width = '100px';\n  p1Carry.style.height = '20px';\n  p1Carry.style.display = 'flex';\n  p1Carry.style.justifyContent = 'space-between';\n  p1Carry.style.color = '#FFF';\n  hud.appendChild(p1Carry);\n  // similar for p2\n}\n\n// Player creation\nfunction createPlayer(id, x, y) {\n  const entity = new Entity();\n  entity.addComponent('position', { x, y, w: 32, h: 48 });\n  entity.addComponent('velocity', { vx: 0, vy: 0 });\n  entity.addComponent('stability', 0);\n  entity.addComponent('carry', []);\n  entity.addComponent('input', { jump: false, moveLeft: false, moveRight: false, dash: false, bank: false });\n  entity.addComponent('coyote', 0);\n  entity.addComponent('jumpBuffer', 0);\n  entity.addComponent('dashState', 'idle');\n  entity.addComponent('dashTimer', 0);\n  entity.addComponent('dashCooldown', 0);\n  entity.addComponent('dashInvulnTimer', 0);\n  entity.addComponent('facingDir', 1);\n  entity.addComponent('onGround', true);\n  entity.addComponent('color', id === 'p1' ? COLORS.cyan : COLORS.magenta);\n  world.addEntity(entity);\n  return entity;\n}\nconst player1 = createPlayer('p1', 100, 100);\nconst player2 = createPlayer('p2', 100, 400);\n\n// Shard creation\nfunction createShard(type, x, y) {\n  const entity = new Entity();\n  entity.addComponent('type', type); // 'stable' or 'volatile'\n  entity.addComponent('position', { x, y, w: 14, h: 14 });\n  entity.addComponent('collected', false);\n  entity.addComponent('orbitAngle', Math.random() * Math.PI * 2);\n  entity.addComponent('orbitRadius', type === 'stable' ? 36 : 30);\n  entity.addComponent('orbitSpeed', type === 'stable' ? 0.5 : 0.8);\n  world.addEntity(entity);\n  return entity;\n}\n\n// Spawn system\nfunction spawnShards(world, delta) {\n  if (Math.random() < 0.02) {\n    const x = Math.random() * (width - 200) + 100;\n    const y = Math.random() * (height / 2 - 100) + 50;\n    const shard = createShard('stable', x, y);\n  }\n  if (Math.random() < 0.005) {\n    const x = Math.random() * (width - 200) + 100;\n    const y = Math.random() * (height / 2 - 100) + 50;\n    const shard = createShard('volatile', x, y);\n  }\n}\n\n// Add systems\nworld.addSystem(new PhysicsSystem(world));\nworld.addSystem(new InputSystem(world));\nworld.addSystem(new RenderSystem(world));\nworld.addSystem(new UISetupSystem(world));\nworld.addSystem(new AudioSystem(world));\nworld.addSystem(new SpawnSystem(world));\n\nrequestAnimationFrame(gameLoop);"

Now we need to write the other files.

World.js:

"class World {\n  constructor() {\n    this.entities = [];\n    this.systems = [];\n    this.inputState = {};\n  }\n  addEntity(entity) { this.entities.push(entity); }\n  addSystem(system) { this.systems.push(system); }\n  tick(delta) { this.systems.forEach(s => s.update(this, delta)); }\n  render(ctx) { this.systems.forEach(s => s.render(ctx)); }\n}\n\nexport default World;"

Entity.js:

"class Entity {\n  constructor() {\n    this.components = {};\n  }\n  addComponent(name, data) { this.components[name] = data; }\n  getComponent(name) { return this.components[name]; }\n}\n\nexport default Entity;"

System.js:

"class System {\n  constructor(world) { this.world = world; }\n  update(world, delta) { }\n  render(ctx) { }\n}\n\nexport default System;"

PhysicsSystem.js:

"class PhysicsSystem {\n  constructor(world) { this.world = world; }\n  update(world, delta) {\n    const PHYS = {\n      MAX_SPEED: 420,\n      ACCEL_GROUND: 2800,\n      ACCEL_AIR: 1400,\n      DECEL_GROUND: 3200,\n      DECEL_AIR: 200,\n      JUMP_VELOCITY: -580,\n      JUMP_VARIABLE_GRAVITY: 1.8,\n      GRAVITY: 1600,\n      COYOTE_TIME: 0.08,\n      JUMP_BUFFER: 0.12,\n      WALL_SLIDE_SPEED: 180,\n      WALL_JUMP_FORCE_X: 450,\n      WALL_JUMP_FORCE_Y: -520,\n      DASH_SPEED: 1100,\n      DASH_DURATION: 0.14,\n      DASH_COOLDOWN: 0.85,\n      DASH_INVULN_FRAMES: 0.10\n    };\n    world.entities.forEach(entity => {\n      const comp = entity.getComponent('player');\n      if (!comp) return;\n      const { x, y, w, h, vx, vy, input, coyote, jumpBuffer, dashState, dashTimer, dashCooldown, dashInvulnTimer, facingDir, onGround } = comp;\n      // Jump buffer\n      if (input.jump && jumpBuffer <= 0) {\n        vy = PHYS.JUMP_VELOCITY;\n        jumpBuffer = PHYS.JUMP_BUFFER;\n      }\n      // Dash\n      if (input.dash && dashState === 'idle' && dashCooldown <= 0 && dashTimer <= 0) {\n        const dir = comp.facingDir || 1;\n        vx = dir * PHYS.DASH_SPEED;\n        vy = 0;\n        dashState = 'dash';\n        dashTimer = PHYS.DASH_DURATION;\n        dashCooldown = PHYS.DASH_COOLDOWN;\n        dashInvulnTimer = PHYS.DASH_INVULN_FRAMES;\n      }\n      // Gravity\n      if (vy >= 0 || !onGround) {\n        vy += PHYS.GRAVITY * delta;\n      }\n      // Deceleration\n      if (onGround) {\n        vx *= 1 - PHYS.DECEL_GROUND * delta;\n        if (vx < 0) vx = 0;\n      } else {\n        vx *= 1 - PHYS.DECEL_AIR * delta;\n      }\n      // Acceleration\n      if (input.left) {\n        comp.facingDir = -1;\n        vx -= PHYS.ACCEL_GROUND * delta;\n      } else if (input.right) {\n        comp.facingDir = 1;\n        vx += PHYS.ACCEL_GROUND * delta;\n      }\n      // Clamp speed\n      if (vx > PHYS.MAX_SPEED) vx = PHYS.MAX_SPEED;\n      if (vx < -PHYS.MAX_SPEED) vx = -PHYS.MAX_SPEED;\n      // Update position\n      x += vx * delta;\n      y += vy * delta;\n      // Update dash timer\n      if (dashState === 'dash') {\n        dashTimer -= delta;\n        if (dashTimer <= 0) dashState = 'idle';\n      }\n      // Update coyote timer\n      if (onGround) {\n        coyote = PHYS.COYOTE_TIME;\n      } else {\n        coyote -= delta;\n      }\n      // Jump buffer\n      if (jumpBuffer > 0) jumpBuffer -= delta;\n      // Save components\n      entity.addComponent('position', { x, y, w, h });\n      entity.addComponent('velocity', { vx, vy });\n      entity.addComponent('input', input);\n      entity.addComponent('coyote', coyote);\n      entity.addComponent('jumpBuffer', jumpBuffer);\n      entity.addComponent('dashState', dashState);\n      entity.addComponent('dashTimer', dashTimer);\n      entity.addComponent('dashCooldown', dashCooldown);\n      entity.addComponent('dashInvulnTimer', dashInvulnTimer);\n    });\n  }\n}\n\nexport default PhysicsSystem;"

InputSystem.js:

"class InputSystem {\n  constructor(world) { this.world = world; }\n  update(world, delta) {\n    world.inputState = { p1: {}, p2: {} };\n    // Keyboard\n    window.addEventListener('keydown', e => {\n      const player = e.key === 'w' || e.key === 'ArrowUp' ? 'p1' : e.key === 's' || e.key === 'ArrowDown' ? 'p1' : e.key === 'a' || e.key === 'ArrowLeft' ? 'p1' : e.key === 'd' || e.key === 'ArrowRight' ? 'p1' : e.key === 'Shift' || e.key === 'rShift' ? 'p1' : e.key === 'Enter' || e.key === 'e' ? 'p1' : null;\n      if (!player) return;\n      const state = world.inputState[player];\n      if (e.key === 'w' || e.key === 'ArrowUp') state.jump = true;\n      if (e.key === 's' || e.key === 'ArrowDown') state.moveDown = true;\n      if (e.key === 'a' || e.key === 'ArrowLeft') state.moveLeft = true;\n      if (e.key === 'd' || e.key === 'ArrowRight') state.moveRight = true;\n      if (e.key === 'Shift' || e.key === 'rShift') state.dash = true;\n      if (e.key === 'Enter' || e.key === 'e') state.bank = true;\n    });\n    window.addEventListener('keyup', e => {\n      const player = e.key === 'w' || e.key === 'ArrowUp' ? 'p1' : e.key === 's' || e.key === 'ArrowDown' ? 'p1' : e.key === 'a' || e.key === 'ArrowLeft' ? 'p1' : e.key === 'd' || e.key === 'ArrowRight' ? 'p1' : e.key === 'Shift' || e.key === 'rShift' ? 'p1' : e.key === 'Enter' || e.key === 'e' ? 'p1' : null;\n      if (!player) return;\n      const state = world.inputState[player];\n      if (e.key === 'w' || e.key === 'ArrowUp') state.jump = false;\n      if (e.key === 's' || e.key === 'ArrowDown') state.moveDown = false;\n      if (e.key === 'a' || e.key === 'ArrowLeft') state.moveLeft = false;\n      if (e.key === 'd' || e.key === 'ArrowRight') state.moveRight = false;\n      if (e.key === 'Shift' || e.key === 'rShift') state.dash = false;\n      if (e.key === 'Enter' || e.key === 'e') state.bank = false;\n    });\n    // Gamepad\n    const gp = navigator.getGamepads()[0];\n    if (gp) {\n      const player = gp.id % 2 === 0 ? 'p1' : 'p2';\n      const state = world.inputState[player];\n      state.left = gp.axes[0] < -0.5;\n      state.right = gp.axes[0] > 0.5;\n      state.jump = gp.buttons[0].pressed;\n      state.dash = gp.buttons[1].pressed;\n      state.bank = gp.buttons[2].pressed;\n    }\n  }\n}\n\nexport default InputSystem;"

RenderSystem.js:

"class RenderSystem {\n  constructor(world) { this.world = world; }\n  render(ctx) {\n    // Clear\n    ctx.clearRect(0, 0, ctx.canvas.width, ctx.canvas.height);\n    // Draw players (split-screen)\n    this.world.entities.forEach(entity => {\n      const comp = entity.getComponent('player');\n      if (comp) {\n        const { x, y, w, h } = comp.position;\n        const offsetY = comp.id.startsWith('p1') ? 0 : ctx.canvas.height / 2;\n        ctx.save();\n        ctx.translate(0, offsetY);\n        ctx.fillStyle = comp.color || ctx.canvas.style.backgroundColor;\n        ctx.fillRect(x, y, w, h);\n        ctx.restore();\n      }\n    });\n    // Draw shards\n    this.world.entities.forEach(entity => {\n      const comp = entity.getComponent('type');\n      if (comp) {\n        const { x, y } = comp.position;\n        ctx.fillStyle = comp.type === 'stable' ? ctx.canvas.style.backgroundColor : '#FF00FF';\n        ctx.beginPath();\n        ctx.arc(x, y, 8, 0, Math.PI * 2);\n        ctx.fill();\n      }\n    });\n  }\n}\n\nexport default RenderSystem;"

UISetupSystem.js:

"class UISetupSystem {\n  constructor(world) { this.world = world; this.createHUD(); }\n  createHUD() {\n    const hud = document.getElementById('hud');\n    // P1 stability bar\n    const p1Stab = document.createElement('div');\n    p1Stab.id = 'p1-stab';\n    p1Stab.style.position = 'absolute';\n    p1Stab.style.top = '10px';\n    p1Stab.style.left = '10px';\n    p1Stab.style.width = '200px';\n    p1Stab.style.height = '20px';\n    p1Stab.style.background = 'rgba(0,0,0,0.6)';\n    p1Stab.style.border = '1px solid ' + COLORS.cyan;\n    p1Stab.style.borderRadius = '4px';\n    hud.appendChild(p1Stab);\n    // P2 stability bar\n    const p2Stab = document.createElement('div');\n    p2Stab.id = 'p2-stab';\n    p2Stab.style.position = 'absolute';\n    p2Stab.style.top = '10px';\n    p2Stab.style.left = '220px';\n    p2Stab.style.width = '200px';\n    p2Stab.style.height = '20px';\n    p2Stab.style.background = 'rgba(0,0,0,0.6)';\n    p2Stab.style.border = '1px solid ' + COLORS.magenta;\n    p2Stab.style.borderRadius = '4px';\n    hud.appendChild(p2Stab);\n    // Carry indicators\n    const p1Carry = document.createElement('div');\n    p1Carry.id = 'p1-carry';\n    p1Carry.style.position = 'absolute';\n    p1Carry.style.top = '30px';\n    p1Carry.style.left = '10px';\n    p1Carry.style.width = '100px';\n    p1Carry.style.height = '20px';\n    p1Carry.style.display = 'flex';\n    p1Carry.style.justifyContent = 'space-between';\n    p1Carry.style.color = '#FFF';\n    hud.appendChild(p1Carry);\n    // P2 carry\n    const p2Carry = document.createElement('div');\n    p2Carry.id = 'p2-carry';\n    p2Carry.style.position = 'absolute';\n    p2Carry.style.top = '30px';\n    p2Carry.style.left = '220px';\n    p2Carry.style.width = '100px';\n    p2Carry.style.height = '20px';\n    p2Carry.style.display = 'flex';\n    p2Carry.style.justifyContent = 'space-between';\n    p2Carry.style.color = '#FFF';\n    hud.appendChild(p2Carry);\n  }\n  update(world, delta) {\n    const p1 = this.world.entities.find(e => e.getComponent('player').id === 'p1');\n    const p2 = this.world.entities.find(e => e.getComponent('player').id === 'p2');\n    if (p1) {\n      const stab = p1.getComponent('stability');\n      const width = (stab / 100) * 200;\n      document.getElementById('p1-stab').style.width = `${width}px`;\n    }\n    if (p2) {\n      const stab = p2.getComponent('stability');\n      const width = (stab / 100) * 200;\n      document.getElementById('p2-stab').style.width = `${width}px`;\n    }\n  }\n}\n\nexport default UISetupSystem;"

AudioSystem.js:

"class AudioSystem {\n  constructor(world) { this.world = world; this.ctx = new (window.AudioContext || window.webkitAudioContext)(); }\n  playSound(frequency, duration, type='sine') {\n    const osc = this.ctx.createOscillator();\n    const gain = this.ctx.createGain();\n    osc.type = type;\n    osc.frequency.value = frequency;\n    gain.gain.setValueAtTime(0, this.ctx.currentTime);\n    gain.gain.linearRampToValueAtTime(0.2, this.ctx.currentTime + 0.01);\n    gain.gain.exponentialRampToValueAtTime(0.001, this.ctx.currentTime + duration);\n    osc.connect(gain);\n    gain.connect(this.ctx.destination);\n    osc.start();\n    osc.stop(this.ctx.currentTime + duration);\n  }\n  init() {\n    // Bind sound events\n    this.playSound = (type) => {\n      switch (type) {\n        case 'jump': this.playSound(440, 0.1, 'sine'); break;\n        case 'dash': this.playSound(300, 0.2, 'sawtooth'); break;\n        case 'collect': this.playSound(523, 0.3, 'triangle'); break;\n        case 'hit': this.playSound(200, 0.15, 'square'); break;\n        default: break;\n      }\n    };\n  }\n}\n\nexport default AudioSystem;"

SpawnSystem.js:

"class SpawnSystem {\n  constructor(world) { this.world = world; }\n  update(world, delta) {\n    // Stable shard spawn\n    if (Math.random() < 0.02) {\n      const x = Math.random() * (world.canvas.width - 200) + 100;\n      const y = Math.random() * (world.canvas.height / 2 - 100) + 50;\n      const shard = new Shard('stable', x, y);\n      shard.setWorld(world);\n      world.addEntity(shard.entity);\n    }\n    // Volatile shard spawn\n    if (Math.random() < 0.005) {\n      const x = Math.random() * (world.canvas.width - 200) + 100;\n      const y = Math.random() * (world.canvas.height / 2 - 100) + 50;\n      const shard = new Shard('volatile', x, y);\n      shard.setWorld(world);\n      world.addEntity(shard.entity);\n    }\n  }\n}\n\nexport default SpawnSystem;"

Now we need to ensure that the files are correctly named and paths match.

Now we need to ensure that the JSON object includes all these files.

Now we need to ensure that the JSON is valid: each key is a string, each value is a string with proper escaping of newlines (\n) and quotes.

We need to escape backslashes and double quotes.

Let's construct the JSON.

We'll start with index.html string. Need to escape double quotes inside the string. The HTML string contains double quotes in attributes like href="...". Those need to be escaped as \". Also need to escape backslashes (but there are none). Also need to escape the single quotes inside the SVG data URI? The SVG uses single quotes for attributes, which are fine inside double-quoted string. However, the data URI itself contains single quotes, but the outer string is double-quoted, so single quotes are fine.

But we need to escape the double quotes inside the string. For example, in the href attribute: href="data:image/svg+xml;utf8,<svg ...>". The double quotes inside the href need to be escaped as \". Also the <script> tag has src="main.js" which also contains double quotes.

Thus we need to escape all double quotes.

Let's write index.html string with proper escaping.

We'll write it as a single line with \n for newlines.

But we need to ensure that the string is properly escaped.

Let's construct index.html content:

"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<title>Duality Drift</title>\n<style>\nhtml,body{margin:0;padding:0;height:100%;overflow:hidden;background:#050510;color:#fff;font-family:JetBrains Mono;}\ncanvas{display:block;width:100vw;height:100vh;background:#050510;}\n#hud{position:absolute;top:0;left:0;width:100%;height:100%;pointer-events:none;}\n</style>\n<link rel=\"icon\" href=\"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='0.9em' font-size='80'>🕹️</text></svg>\">\n<script src=\"main.js\" defer></script>\n</head>\n<body>\n<canvas id=\"gameCanvas\"></canvas>\n<div id=\"hud\"></div>\n</body>\n</html>"

Now we need to escape the double quotes inside the string. Let's go through:

- <!DOCTYPE html> - no double quotes.
- <html lang=\"en\"> - we need to escape the double quotes around en? Actually the string is <html lang="en">, but in JSON we need to escape the double quotes, so we write \"en\". So the string should be <html lang=\"en\">. That's already escaped.

- <meta charset=\"UTF-8\"> - escaped.

