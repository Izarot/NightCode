class InputSystem {
  constructor(world) { this.world = world; }
  update(world, delta) {
    // Reset input state each frame
    this.world.inputState = { p1: {}, p2: {} };
    // Keyboard handling (global)
    window.addEventListener('keydown', e => {
      const player = e.key === 'w' || e.key === 'ArrowUp' ? 'p1' : e.key === 's' || e.key === 'ArrowDown' ? 'p1' : e.key === 'a' || e.key === 'ArrowLeft' ? 'p1' : e.key === 'd' || e.key === 'ArrowRight' ? 'p1' : e.key === 'Shift' || e.key === 'rShift' ? 'p1' : e.key === 'Enter' ? 'p1' : null;
      if (!player) return;
      const state = this.world.inputState[player];
      if (e.key === 'w' || e.key === 'ArrowUp') state.jump = true;
      if (e.key === 's' || e.key === 'ArrowDown') state.moveDown = true;
      if (e.key === 'a' || e.key === 'ArrowLeft') state.moveLeft = true;
      if (e.key === 'd' || e.key === 'ArrowRight') state.moveRight = true;
      if (e.key === 'Shift' || e.key === 'rShift') state.dash = true;
      if (e.key === 'Enter' || e.key === 'e') state.bank = true;
    });
    window.addEventListener('keyup', e => {
      const player = e.key === 'w' || e.key === 'ArrowUp' ? 'p1' : e.key === 's' || e.key === 'ArrowDown' ? 'p1' : e.key === 'a' || e.key === 'ArrowLeft' ? 'p1' : e.key === 'd' || e.key === 'ArrowRight' ? 'p1' : e.key === 'Shift' || e.key === 'rShift' ? 'p1' : e.key === 'Enter' || e.key === 'e' ? 'p1' : null;
      if (!player) return;
      const state = this.world.inputState[player];
      if (e.key === 'w' || e.key === 'ArrowUp') state.jump = false;
      if (e.key === 's' || e.key === 'ArrowDown') state.moveDown = false;
      if (e.key === 'a' || e.key === 'ArrowLeft') state.moveLeft = false;
      if (e.key === 'd' || e.key === 'ArrowRight') state.moveRight = false;
      if (e.key === 'Shift' || e.key === 'rShift') state.dash = false;
      if (e.key === 'Enter' || e.key === 'e') state.bank = false;
    });
    // Gamepad handling (simplified)
    const gp = navigator.getGamepads()[0];
    if (gp) {
      const player = gp.id % 2 === 0 ? 'p1' : 'p2'; // assume even id p1
      const state = this.world.inputState[player];
      state.left = gp.axes[0] < -0.5;
      state.right = gp.axes[0] > 0.5;
      state.jump = gp.buttons[0].pressed; // A button
      state.dash = gp.buttons[1].pressed; // B button
      state.bank = gp.buttons[2].pressed; // X button
    }
  }
}
export default InputSystem;

