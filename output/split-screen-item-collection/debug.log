class RenderSystem {
  constructor(world) { this.world = world; this.ctx = null; }
  render(ctx) {
    this.ctx = ctx;
    // Clear
    this.ctx.clearRect(0, 0, this.ctx.canvas.width, this.ctx.canvas.height);
    // Draw background layers (simple)
    this.drawBackground();
    // Draw players
    this.world.entities.forEach(entity => {
      const comp = entity.getComponent('player');
      if (!comp) return;
      const { x, y, w, h, color } = comp;
      // Apply viewport offset based on player id
      const offsetY = comp.id.startsWith('p1') ? 0 : this.world.canvas.height / 2;
      this.ctx.save();
      this.ctx.translate(0, offsetY);
      this.ctx.fillStyle = color;
      this.ctx.fillRect(x, y, w, h);
      this.ctx.restore();
    });
