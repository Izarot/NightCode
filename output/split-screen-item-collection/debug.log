src/systems/Physics.js:

class PhysicsSystem {
  constructor(world) { this.world = world; }
  update(world, delta) {
    const PHYS = {
      MAX_SPEED: 420,
      ACCEL_GROUND: 2800,
      ACCEL_AIR: 1400,
      DECEL_GROUND: 3200,
      DECEL_AIR: 200,
      JUMP_VELOCITY: -580,
      JUMP_VARIABLE_GRAVITY: 1.8,
      GRAVITY: 1600,
      COYOTE_TIME: 0.08,
      JUMP_BUFFER: 0.12,
      WALL_SLIDE_SPEED: 180,
      WALL_JUMP_FORCE_X: 450,
      WALL_JUMP_FORCE_Y: -520,
      DASH_SPEED: 1100,
      DASH_DURATION: 0.14,
      DASH_COOLDOWN: 0.85,
      DASH_INVULN_FRAMES: 0.10
    };
    // Assume each player entity has components: position, velocity, input, coyote, jumpBuffer, dashState, etc.
    // For simplicity, we will iterate over all entities and process those with 'player' component.
    world.entities.forEach(entity => {
      const comp = entity.getComponent('player');
      if (!comp) return;
      const { x, y, w, h, vx, vy, input, coyote, jumpBuffer, dashState, dashTimer, dashCooldown, dashInvulnTimer } = comp;
      const dt = delta;
      // Input handling
      if (input.jump && jumpBuffer <= 0) {
        vy = PHYS.JUMP_VELOCITY;
        jumpBuffer = PHYS.JUMP_BUFFER;
      }
      if (input.dash && dashState === 'idle' && dashCooldown <= 0 && dashTimer <= 0) {
        // Determine direction: if moving, use facing direction else default forward (right)
        const dir = comp.facingDir || 1;
        vx = dir * PHYS.DASH_SPEED;
        vy = 0;
        dashState = 'dash';
        dashTimer = PHYS.DASH_DURATION;
        dashCooldown = PHYS.DASH_COOLDOWN;
        dashInvulnTimer = PHYS.DASH_INVULN_FRAMES;
      }
      // Apply gravity
      if (vy >= 0 || !comp.onGround) {
        vy += PHYS.GRAVITY * dt;
      }
      // Apply deceleration
      if (comp.onGround) {
        vx *= 1 - PHYS.DECEL_GROUND * dt;
        if (vx < 0) vx = 0;
      } else {
        vx *= 1 - PHYS.DECEL_AIR * dt;
      }
      // Apply acceleration
      if (input.left) {
        comp.facingDir = -1;
        vx -= PHYS.ACCEL_GROUND * dt;
      } else if (input.right) {
        comp.facingDir = 1;
        vx += PHYS.ACCEL_GROUND * dt;
      }
      // Clamp speed
      if (vx > PHYS.MAX_SPEED) vx = PHYS.MAX_SPEED;
      if (vx < -PHYS.MAX_SPEED) vx = -PHYS.MAX_SPEED;
      // Update position
      x += vx * dt;
      y += vy * dt;
      // Update dash timer
      if (dashState === 'dash') {
        dashTimer -= dt;
        if (dashTimer <= 0) {
          dashState = 'idle';
        }
      }
      // Update coyote timer
      if (comp.onGround) {
        coyote = PHYS.COYOTE_TIME;
      } else {
        coyote -= dt;
      }
      // Jump buffering
      if (jumpBuffer > 0) jumpBuffer -= dt;
      // Wall slide
      // For simplicity, assume wall detection not implemented; skip.
      // Update velocity components
      comp.vx = vx;
      comp.vy = vy;
      // Save back
      entity.addComponent('position', { x, y, w, h });
      entity.addComponent('velocity', { vx, vy });
      entity.addComponent('input', input);
      entity.addComponent('coyote', coyote);
      entity.addComponent('jumpBuffer', jumpBuffer);
      entity.addComponent('dashState', dashState);
      entity.addComponent('dashTimer', dashTimer);
      entity.addComponent('dashCooldown', dashCooldown);
      entity.addComponent('dashInvulnTimer', dashInvulnTimer);
    });
  }
}
export default PhysicsSystem;

