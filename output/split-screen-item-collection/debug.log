// Player creation
function createPlayer(id, x, y) {
  const entity = new Entity();
  entity.addComponent('position', { x, y, w: 32, h: 48 });
  entity.addComponent('velocity', { vx: 0, vy: 0 });
  entity.addComponent('stability', 0);
  entity.addComponent('carry', []); // list of shard ids
