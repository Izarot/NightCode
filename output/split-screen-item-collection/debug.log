class AudioSystem {
  constructor(world) { this.world = world; this.ctx = new (window.AudioContext || window.webkitAudioContext)(); }
  playSound(frequency, duration, type='sine') {
    const osc = this.ctx.createOscillator();
    const gain = this.ctx.createGain();
    osc.type = type;
    osc.frequency.value = frequency;
    gain.gain.setValueAtTime(0, this.ctx.currentTime);
    gain.gain.linearRampToValueAtTime(0.2, this.ctx.currentTime + 0.01);
    gain.gain.exponentialRampToValueAtTime(0.001, this.ctx.currentTime + duration);
    osc.connect(gain);
    gain.connect(this.ctx.destination);
    osc.start();
    osc.stop(this.ctx.currentTime + duration);
  }
  init() {
    // bind some sounds
    this.playSound = (type) => {
      switch (type) {
        case 'jump': this.playSound(440, 0.1, 'sine'); break;
        case 'dash': this.playSound(300, 0.2, 'sawtooth'); break;
        case 'collect': this.playSound(523, 0.3, 'triangle'); break;
        case 'hit': this.playSound(200, 0.15, 'square'); break;
        default: break;
      }
    };
  }
}
export default AudioSystem;

