class InputSystem {
  constructor(world) { this.world = world; }
  update(world, delta) {
    // Reset input state each frame
    world.inputState = { p1: {}, p2: {} };
    // Keyboard
    window.addEventListener('keydown', e => {
      const player = e.key === 'w' || e.key === 'ArrowUp' ? 'p1' : e.key === 's' || e.key === 'ArrowDown' ? 'p1' : e.key === 'a' || e.key === 'ArrowLeft' ? 'p1' : e.key === 'd' || e.key === 'ArrowRight' ? 'p1' : e.key === 'Shift' || e.key === 'rShift' ? 'p1' : e.key === 'Enter' || e.key === 'e' ? 'p1' : null;
      if (!player) return;
      const state = world.inputState[player];
      if (e.key === 'w' || e.key === 'ArrowUp') state.jump = true;
      if (e.key === 's' || e.key === 'ArrowDown') state.moveDown = true;
      if (e.key === 'a' || e.key === 'ArrowLeft') state.moveLeft = true;
      if (e.key === 'd' || e.key === 'ArrowRight') state.moveRight = true;
      if (e.key === 'Shift' || e.key === 'rShift') state.dash = true;
      if (e.key === 'Enter' || e.key === 'e') state.bank = true;
    });
    window.addEventListener('keyup', e => {
      const player = e.key === 'w' || e.key === 'ArrowUp' ? 'p1' : e.key === 's' || e.key === 'ArrowDown' ? 'p1' : e.key === 'a' || e.key === 'ArrowLeft' ? 'p1' : e.key === 'd' || e.key === 'ArrowRight' ? 'p1' : e.key === 'Shift' || e.key === 'rShift' ? 'p1' : e.key === 'Enter' || e.key === 'e' ? 'p1' : null;
      if (!player) return;
      const state = world.inputState[player];
      if (e.key === 'w' || e.key === 'ArrowUp') state.jump = false;
      if (e.key === 's' || e.key === 'ArrowDown') state.moveDown = false;
      if (e.key === 'a' || e.key === 'ArrowLeft') state.moveLeft = false;
      if (e.key === 'd' || e.key === 'ArrowRight') state.moveRight = false;
      if (e.key === 'Shift' || e.key === 'rShift') state.dash = false;
      if (e.key === 'Enter' || e.key === 'e') state.bank = false;
    });
    // Gamepad
    const gp = navigator.getGamepads()[0];
    if (gp) {
      const player = gp.id % 2 === 0 ? 'p1' : 'p2';
      const state = world.inputState[player];
      state.left = gp.axes[0] < -0.5;
      state.right = gp.axes[0] > 0.5;
      state.jump = gp.buttons[0].pressed;
      state.dash = gp.buttons[1].pressed;
      state.bank = gp.buttons[2].pressed;
    }
  }
}
export default InputSystem;

Now src/systems/Render.js:

class RenderSystem {
  constructor(world) { this.world = world; }
  render(ctx) {
    // Clear
    ctx.clearRect(0, 0, ctx.canvas.width, ctx.canvas.height);
    // Draw players
    this.world.entities.forEach(entity => {
      const comp = entity.getComponent('player');
      if (comp) {
        const { x, y, w, h } = comp.position;
        // Apply viewport offset
        const offsetY = comp.id.startsWith('p1') ? 0 : ctx.canvas.height / 2;
        ctx.save();
        ctx.translate(0, offsetY);
        ctx.fillStyle = comp.color || ctx.canvas.style.backgroundColor;
        ctx.fillRect(x, y, w, h);
        ctx.restore();
      }
    });
    // Draw shards
    this.world.entities.forEach(entity => {
      const comp = entity.getComponent('type');
      if (comp) {
        const { x, y } = comp.position;
        ctx.fillStyle = comp.type === 'stable' ? ctx.canvas.style.backgroundColor : '#FF00FF';
        ctx.beginPath();
        ctx.arc(x, y, 8, 0, Math.PI * 2);
        ctx.fill();
      }
    });
  }
}
export default RenderSystem;

