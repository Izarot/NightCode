, 'square', 0.3],\n      cannon: [120, 0.12, 'sawtooth', 0.6]\n    };\n    const p = presets[towerType] || presets.blaster;\n    this.blip(...p);\n  }\n  hit() { this.blip(220, 0.1, 'sine', 0.4); }\n  enemyDeath() {\n    if (!this.enabled) return;\n    this.init(); this.resume();\n    const t = this.ctx.currentTime;\n    const o = this.ctx.createOscillator();\n    const g = this.ctx.createGain();\n    o.type = 'triangle';\n    o.frequency.setValueAtTime(440, t);\n    o.frequency.exponentialRampToValueAtTime(110, t + 0.25);\n    g.gain.setValueAtTime(0.5, t);\n    g.gain.exponentialRampToValueAtTime(0.001, t + 0.3);\n    o.connect(g); g.connect(this.masterGain);\n    o.start(t); o.stop(t + 0.3);\n  }\n  towerDestroy() {\n    if (!this.enabled) return;\n    this.init(); this.resume();\n    const t = this.ctx.currentTime;\n    const bufferSize = this.ctx.sampleRate * 0.3;\n    const buffer = this.ctx.createBuffer(1, bufferSize, this.ctx.sampleRate);\n    const data = buffer.getChannelData(0);\n    for (let i = 0; i < bufferSize; i++) data[i] = (Math.random() * 2 - 1) * (1 - i / bufferSize);\n    const src = this.ctx.createBufferSource();\n    const g = this.ctx.createGain();\n    src.buffer = buffer;\n    g.gain.value = 0.5;\n    src.connect(g); g.connect(this.masterGain);\n    src.start(t);\n  }\n  absorb() {\n    if (!this.enabled) return;\n    this.init(); this.resume();\n    const t = this.ctx.currentTime;\n    const o = this.ctx.createOscillator();\n    const g = this.ctx.createGain();\n    o.type = 'triangle';\n    o.frequency.setValueAtTime(200, t);\n    o.frequency.exponentialRampToValueAtTime(600, t + 0.4);\n    g.gain.setValueAtTime(0.5, t);\n    g.gain.exponentialRampToValueAtTime(0.001, t + 0.4);\n    o.connect(g); g.connect(this.masterGain);\n    o.start(t); o.stop(t + 0.4);\n  }\n  waveComplete() {\n    const notes = [261.63, 329.63, 392.00]; // C-E-G\n    notes.forEach((f, i) => {\n      setTimeout(() => this.blip(f, 0.12, 'triangle', 0.4), i * 110);\n    });\n  }\n  gameOver() {\n    const notes = [392, 311, 233, 196]; // descending minor\n    notes.forEach((f, i) => {\n      setTimeout(() => this.blip(f, 0.18, 'sawtooth', 0.45), i * 130);\n    });\n  }\n  click() { this.blip(880, 0.05, 'square', 0.25); }\n}\nexport const audio = new AudioEngine();\n", "particles.js": "// particles.js — Particle pool and effects\nimport { audio } from './audio.js';\nexport class Particle {\n  constructor() {\n    this.active = false;\n    this.x = 0; this.y = 0;\n    this.vx = 0; this.vy = 0;\n    this.life = 0; this.maxLife = 1;\n    this.color = '#fff';\n    this.radius = 2;\n    this.gravity = 0;\n    this.targetX = 0; this.targetY = 0;\n    this.startX = 0; this.startY = 0;\n    this.type = 'normal';\n  }\n  init(x, y, vx, vy, life, color, radius = 2, gravity = 0, type = 'normal') {\n    this.active = true;\n    this.x = this.startX = x; this.y = this.startY = y;\n    this.vx = vx; this.vy = vy;\n    this.life = this.maxLife = life;\n    this.color = color;\n    this.radius = radius;\n    this.gravity = gravity;\n    this.type = type;\n    this.targetX = x; this.targetY = y;\n  }\n  update(dt) {\n    if (!this.active) return;\n    this.life -= dt;\n    if (this.life <= 0) { this.active = false; return; }\n    const t = 1 - this.life / this.maxLife;\n    if (this.type === 'absorb') {\n      // ease-out cubic toward target\n      const eo = 1 - Math.pow(1 - t, 3);\n      // approximate target by storing offset\n      this.x = this.startX + (this._tx - this.startX) * eo;\n      this.y = this.startY + (this._ty - this.startY) * eo;\n    } else {\n      this.vy += this.gravity * dt;\n      this.x += this.vx * dt;\n      this.y += this.vy * dt;\n    }\n  }\n  render(ctx) {\n    if (!this.active) return;\n    const alpha = Math.max(0, this.life / this.maxLife);\n    ctx.globalAlpha = alpha;\n    ctx.fillStyle = this.color;\n    ctx.beginPath();\n    ctx.arc(this.x, this.y, this.radius, 0, Math.PI * 2);\n    ctx.fill();\n    ctx.globalAlpha = 1;\n  }\n}\nexport class ParticleSystem {\n  constructor(size = 400) {\n    this.pool = [];\n    for (let i = 0; i < size; i++) this.pool.push(new Particle());\n  }\n  spawn(x, y, vx, vy, life, color, radius, gravity, type) {\n    for (const p of this.pool) {\n      if (!p.active) {\n        p.init(x, y, vx, vy, life, color, radius, gravity, type);\n        if (type === 'absorb') { p._tx = x + vx * life; p._ty = y + vy * life; }\n        return p;\n      }\n    }\n    return null;\n  }\n  update(dt) {\n    for (const p of this.pool) if (p.active) p.update(dt);\n  }\n  render(ctx) {\n    for (const p of this.pool) if (p.active) p.render(ctx);\n  }\n  burstAbsorb(tx, ty) {\n    for (let i = 0; i < 12; i++) {\n      const angle = Math.random() * Math.PI * 2;\n      const dist = 60 + Math.random() * 60;\n      const tx2 = tx + Math.cos(angle) * dist;\n      const ty2 = ty + Math.sin(angle) * dist;\n      const vx = (tx2 - tx) * 2;\n      const vy = (ty2 - ty) * 2;\n      this.spawn(tx, ty, vx, vy, 0.5, '#a371f7', 3, 0, 'absorb')._tx = tx2;\n      this.spawn(tx, ty, vx, vy, 0.5, '#a371f7', 3, 0, 'absorb')._ty = ty2;\n    }\n  }\n  burstDeath(x, y) {\n    for (let i = 0; i < 8; i++) {\n      const a = (i / 8) * Math.PI * 2;\n      this.spawn(x, y, Math.cos(a) * 80, Math.sin(a) * 80, 0.5, '#da3633', 3, 0);\n    }\n    for (let i = 0; i < 8; i++) {\n      const vx = (Math.random() - 0.5) * 40;\n      const vy = -60 - Math.random() * 60;\n      this.spawn(x, y, vx, vy, 0.8, '#d29922', 2.5, 100);\n    }\n  }\n  burstImpact(x, y) {\n    for (let i = 0; i < 4; i++) {\n      const a = Math.random() * Math.PI * 2;\n      const v = 60 + Math.random() * 40;\n      this.spawn(x, y, Math.cos(a) * v, Math.sin(a) * v, 0.2, '#ffffff', 1.5, 0);\n    }\n  }\n  burstTowerDestroy(x, y) {\n    for (let i = 0; i < 14; i++) {\n      const a = Math.random() * Math.PI * 2;\n      const v = 50 + Math.random() * 100;\n      this.spawn(x, y, Math.cos(a) * v, Math.sin(a) * v, 0.7, '#f0883e', 3, 0);\n    }\n    audio.towerDestroy();\n  }\n}\n", "path.js": "// path.js — S-curve waypoint generation & tile utilities\nexport function generatePath() {\n  const waypoints = [];\n  // S-curve across 30x20 grid\n  let x = 0, y = 4;\n  waypoints.push({ x, y });\n  // Segment 1: right to col 10\n  x = 10;\n  waypoints.push({ x, y });\n  // down to row 10\n  y = 10;\n  waypoints.push({ x, y });\n  // right to col 18\n  x = 18;\n  waypoints.push({ x, y });\n  // up to row 4\n  y = 4;\n  waypoints.push({ x, y });\n  // right to col 24\n  x = 24;\n  waypoints.push({ x, y });\n  // down to row 14\n  y = 14;\n  waypoints.push({ x, y });\n  // right to col 29\n  x = 29;\n  waypoints.push({ x, y });\n  return waypoints;\n}\n// Convert waypoint grid coords to continuous world pixels (centers)\nexport function waypointsToWorld(waypoints) {\n  return waypoints.map(w => ({ x: w.x * 32 + 16, y: w.y * 32 + 16 }));\n}\n// Build set of path tile keys for fast lookup\nexport function buildPathTileSet(waypoints) {\n  const set = new Set();\n  for (let i = 0; i < waypoints.length - 1; i++) {\n    const a = waypoints[i], b = waypoints[i + 1];\n    if (a.x === b.x) {\n      const step = a.y < b.y ? 1 : -1;\n      for (let y = a.y; y !== b.y + step; y += step) set.add(`${a.x},${y}`);\n    } else if (a.y === b.y) {\n      const step = a.x < b.x ? 1 : -1;\n      for (let x = a.x; x !== b.x + step; x += step) set.add(`${x},${a.y}`);\n    }\n  }\n  return set;\n}\nexport function tileKey(col, row) { return `${col},${row}`; }\n", "entities/enemy.js": "// entities/enemy.js — Parasite enemy class\nimport { CFG } from '../config.js';\nimport { audio } from '../audio.js';\nimport { ParticleSystem } from '../particles.js';\nexport class Enemy {\n  constructor(waypoints, wave, idx, totalTowerValue) {\n    this.waypoints = waypoints;\n    this.pathIndex = 0;\n    this.x = waypoints[0].x;\n    this.y = waypoints[0].y;\n    this.speed = CFG.BASE_ENEMY_SPEED + (wave - 1) * 0.05; // tiles/sec\n    this.speed *= 32; // pixels/sec\n    this.wave = wave;\n    this.reward = CFG.BASE_REWARD + (wave - 1) * 2;\n    this.maxHp = CFG.BASE_ENEMY_HP + totalTowerValue * 0.5;\n    this.hp = this.maxHp;\n    this.radius = 12;\n    this.alive = true;\n    this.state = 'spawning';\n    this.stateTime = 0;\n    this.pulsePhase = Math.random() * Math.PI * 2;\n    this.absorbTarget = null;\n    this.absorbAmount = 0;\n    this.dying = false;\n    this.dyingTime = 0;\n    this.reachedEnd = false;\n    this.spawnedAt = performance.now() + idx * CFG.SPAWN_INTERVAL_MS;\n    this.spawned = false;\n    this.flashTime = 0;\n    this.spawnDelay = 0;\n    this.particles = null;\n  }\n  attachParticles(p) { this.particles = p; }\n  startSpawn(now) {\n    this.spawned = true;\n    this.state = 'spawning';\n    this.stateTime = 0;\n  }\n  update(dt, towers) {\n    if (!this.spawned) {\n      // waiting to spawn\n      return;\n    }\n    if (this.state === 'dying') {\n      this.dyingTime += dt;\n      if (this.dyingTime >= 0.3) this.alive = false;\n      return;\n    }\n    if (this.state === 'absorbing') {\n      this.stateTime += dt;\n      if (this.stateTime >= 0.5) {\n        // Gain HP\n        this.maxHp += this.absorbAmount;\n        this.hp = Math.min(this.hp + this.absorbAmount, this.maxHp);\n        this.absorbAmount = 0;\n        this.absorbTarget = null;\n        this.state = 'walking';\n        this.stateTime = 0;\n        audio.absorb();\n      }\n      return;\n    }\n    if (this.state === 'spawning') {\n      this.stateTime += dt;\n      if (this.stateTime >= 0.3) {\n        this.state = 'walking';\n        this.stateTime = 0;\n      }\n    }\n    if (this.state === 'walking' || this.state === 'spawning') {\n      // Check for tower attacks\n      for (const tower of towers) {\n        if (!tower.alive) continue;\n        const dx = tower.x - this.x;\n        const dy = tower.y - this.y;\n        const dist = Math.hypot(dx, dy);\n        if (dist < 18) {\n          tower.takeDamage(5 * dt);\n          if (!tower.alive && tower.killer === null) {\n            tower.killer = this;\n          }\n        }\n      }\n      // Move toward waypoint\n      if (this.pathIndex < this.waypoints.length - 1) {\n        const target = this.waypoints[this.pathIndex + 1];\n        const dx = target.x - this.x;\n        const dy = target.y - this.y;\n        const dist = Math.hypot(dx, dy);\n        if (dist < this.speed * dt) {\n          this.x = target.x;\n          this.y = target.y;\n          this.pathIndex++;\n        } else {\n          this.x += (dx / dist) * this.speed * dt;\n          this.y += (dy / dist) * this.speed * dt;\n        }\n      } else {\n        this.reachedEnd = true;\n        this.dyingTime = 0;\n        this.state = 'dying';\n      }\n    }\n    this.flashTime = Math.max(0, this.flashTime - dt);\n  }\n  takeDamage(amount) {\n    this.hp -= amount;\n    this.flashTime = 0.1;\n    audio.hit();\n    if (this.hp <= 0) {\n      this.hp = 0;\n      this.state = 'dying';\n      this.dyingTime = 0;\n      audio.enemyDeath();\n    }\n  }\n  beginAbsorb(amount, targetTower) {\n    this.absorbAmount = amount;\n    this.absorbTarget = targetTower;\n    this.state = 'absorbing';\n    this.stateTime = 0;\n  }\n  render(ctx) {\n    if (!this.spawned) return;\n    if (this.state === 'dying') {\n      const t = this.dyingTime / 0.3;\n      const r = this.radius * (1 - t);\n      ctx.globalAlpha = 1 - t;\n      ctx.fillStyle = '#da3633';\n      ctx.beginPath();\n      ctx.arc(this.x, this.y, Math.max(0, r), 0, Math.PI * 2);\n      ctx.fill();\n      ctx.globalAlpha = 1;\n      return;\n    }\n    const pulse = 0.85 + Math.sin(performance.now() * 0.006 + this.pulsePhase) * 0.15;\n    const stateAlpha = this.state === 'spawning' ? Math.min(1, this.stateTime / 0.3) : 1;\n    ctx.globalAlpha = stateAlpha * pulse;\n    // Body\n    ctx.fillStyle = '#da3633';\n    ctx.beginPath();\n    ctx.arc(this.x, this.y, this.radius, 0, Math.PI * 2);\n    ctx.fill();\n    // Inner glow when absorbing\n    if (this.state === 'absorbing') {\n      ctx.fillStyle = '#a371f7';\n      ctx.beginPath();\n      ctx.arc(this.x, this.y, this.radius * 0.6, 0, Math.PI * 2);\n      ctx.fill();\n    } else {\n      // Eyes\n      ctx.fillStyle = '#ffd7d5';\n      ctx.beginPath();\n      ctx.arc(this.x - 4, this.y - 3, 2, 0, Math.PI * 2);\n      ctx.arc(this.x + 4, this.y - 3, 2, 0, Math.PI * 2);\n      ctx.fill();\n    }\n    // Flash on damage\n    if (this.flashTime > 0) {\n      ctx.fillStyle = `rgba(255,255,255,${this.flashTime * 5})`;\n      ctx.beginPath();\n      ctx.arc(this.x, this.y, this.radius, 0, Math.PI * 2);\n      ctx.fill();\n    }\n    ctx.globalAlpha = 1;\n    // Health bar\n    const barW = 24, barH = 4;\n    const bx = this.x - barW / 2, by = this.y - this.radius - 10;\n    ctx.fillStyle = 'rgba(0,0,0,0.6)';\n    ctx.fillRect(bx - 1, by - 1, barW + 2, barH + 2);\n    const pct = this.hp / this.maxHp;\n    let col = '#3fb950';\n    if (pct < 0.6) col = '#d29922';\n    if (pct < 0.3) col = '#da3633';\n    ctx.fillStyle = col;\n    ctx.fillRect(bx, by, barW * pct, barH);\n  }\n}\n", "entities/tower.js": "// entities/tower.js — Tower classes (Blaster / Zapper / Cannon)\nimport { CFG } from '../config.js';\nimport { audio } from '../audio.js';\nimport { Projectile } from './projectile.js';\nclass TowerBase {\n  constructor(col, row, def, state) {\n    this.col = col; this.row = row;\n    this.x = col * 32 + 16;\n    this.y = row * 32 + 16;\n    this.def = def;\n    this.level = 1;\n    this.alive = true;\n    this.hp = 200;\n    this.maxHp = 200;\n    this.angle = 0;\n    this.targetAngle = 0;\n    this.fireCooldown = 0;\n    this.target = null;\n    this.killer = null;\n    this.recoil = 0;\n    this.hover = false;\n    this.state = state;\n    this.dyingTime = 0;\n    this.arcTimer = 0;\n  }\n  totalCost() {\n    let total = this.def.cost;\n    for (let i = 2; i <= this.level; i++) total += this.def.cost * 0.5;\n    return total;\n  }\n  upgradeCost() { return Math.floor(this.def.cost * 0.5); }\n  sellValue() { return Math.floor(this.totalCost() * 0.6); }\n  get damage() { return this.def.damage * Math.pow(1.3, this.level - 1); }\n  get range() { return this.def.range * 32 * Math.pow(1.1, this.level - 1); }\n  get fireRate() { return this.def.fireRate * Math.pow(1.1, this.level - 1); }\n  takeDamage(amount) { this.hp -= amount; if (this.hp <= 0) this.hp = 0; }\n  upgrade(state) {\n    const cost = this.upgradeCost();\n    if (state.gold >= cost && this.level < 3) {\n      state.gold -= cost;\n      this.level++;\n      audio.click();\n      return true;\n    }\n    return false;\n  }\n  findTarget(enemies, mode) {\n    let best = null, bestScore = -Infinity;\n    for (const e of enemies) {\n      if (!e.alive || !e.spawned || e.state === 'dying') continue;\n      const dx = e.x - this.x, dy = e.y - this.y;\n      const d = Math.hypot(dx, dy);\n      if (d > this.range) continue;\n      let score = 0;\n      if (mode === 'closest_exit') {\n        // highest progress along path = closest to exit\n        const progress = e.pathIndex + (e.x !== 0 || e.y !== 0 ? 1 - (Math.hypot(e.x - e.waypoints[e.pathIndex].x, e.y - e.waypoints[e.pathIndex].y) / 32) : 0);\n        score = progress * 1000 - d * 0.01;\n      } else if (mode === 'strongest') {\n        score = e.hp;\n      } else { // closest\n        score = -d;\n      }\n      if (score > bestScore) { bestScore = score; best = e; }\n    }\n    return best;\n  }\n  destroy(particles) {\n    this.alive = false;\n    this.dyingTime = 0;\n    particles.burstTowerDestroy(this.x, this.y);\n    if (this.killer && this.killer.alive) {\n      this.killer.beginAbsorb(this.totalCost(), this);\n      particles.burstAbsorb(this.killer.x, this.killer.y);\n    }\n  }\n  update(dt, state) {\n    if (!this.alive) {\n      this.dyingTime += dt;\n      if (this.dyingTime >= 0.3) this.state.removeTower(this);\n      return;\n    }\n    this.fireCooldown = Math.max(0, this.fireCooldown - dt);\n    if (this.recoil > 0) this.recoil -= dt;\n    const enemies = state.enemies;\n    // Acquire target\n    if (!this.target || !this.target.alive || this.target.state === 'dying' ||\n        Math.hypot(this.target.x - this.x, this.target.y - this.y) > this.range) {\n      this.target = this.findTarget(enemies, state.targetingMode);\n    }\n    if (this.target) {\n      this.targetAngle = Math.atan2(this.target.y - this.y, this.target.x - this.x);\n      // Rotate smoothly\n      let diff = this.targetAngle - this.angle;\n      while (diff > Math.PI) diff -= Math.PI * 2;\n      while (diff < -Math.PI) diff += Math.PI * 2;\n      this.angle += diff * Math.min(1, dt * 10);\n      // Fire\n      if (this.fireCooldown <= 0) {\n        this.fire(state);\n        this.fireCooldown = 1 / this.fireRate;\n      }\n    }\n    this.arcTimer += dt;\n    if (this.hp <= 0) this.destroy(state.particles);\n  }\n}\nexport class Blaster extends TowerBase {\n  fire(state) {\n    audio.shoot('blaster');\n    this.recoil = 0.1;\n    state.projectiles.push(new Projectile(\n      this.x + Math.cos(this.angle) * 12,\n      this.y + Math.sin(this.angle) * 12,\n      this.angle, this.damage, 8 * 32, '#388bfd', this.target\n    ));\n  }\n  render(ctx) {\n    if (!this.alive) return;\n    ctx.save();\n    ctx.translate(this.x, this.y);\n    if (this.hover) {\n      ctx.strokeStyle = 'rgba(56, 139, 253, 0.3)';\n      ctx.setLineDash([4, 4]);\n      ctx.lineWidth = 1.5;\n      ctx.beginPath();\n      ctx.arc(0, 0, this.range, 0, Math.PI * 2);\n      ctx.stroke();\n      ctx.setLineDash([]);\n    }\n    ctx.rotate(this.angle);\n    const recoilOffset = -this.recoil * 6;\n    ctx.translate(recoilOffset, 0);\n    // Body\n    ctx.fillStyle = '#388bfd';\n    ctx.fillRect(-10, -10, 20, 20);\n    // Barrel\n    ctx.fillStyle = '#1f6feb';\n    ctx.fillRect(8, -3, 12, 6);\n    ctx.restore();\n    // Level stars\n    ctx.fillStyle = '#ffd700';\n    for (let i = 0; i < this.level; i++) {\n      ctx.fillRect(this.x - 6 + i * 6, this.y - 18, 4, 4);\n    }\n    // HP bar if damaged\n    if (this.hp < this.maxHp) {\n      const w = 20;\n      const bx = this.x - w / 2, by = this.y + 14;\n      ctx.fillStyle = '#fff';\n      ctx.fillRect(bx, by, w, 3);\n      ctx.fillStyle = '#3fb950';\n      ctx.fillRect(bx, by, w * (this.hp / this.maxHp), 3);\n    }\n  }\n}\nexport class Zapper extends TowerBase {\n  fire(state) {\n    audio.shoot('zapper');\n    // Find chain targets\n    const targets = [this.target];\n    let last = this.target;\n    for (let i = 0; i < 3; i++) {\n      let nearest = null, nd = 80;\n      for (const e of state.enemies) {\n        if (!e.alive || targets.includes(e)) continue;\n        const d = Math.hypot(e.x - last.x, e.y - last.y);\n        if (d < nd) { nd = d; nearest = e; }\n      }\n      if (nearest) { targets.push(nearest); last = nearest; }\n    }\n    // Apply damage & arcs\n    targets.forEach((t, i) => {\n      if (t).alive) t.takeDamage(this.damage * Math.pow(0.7, i));
      state.arcs.push({ x1: i === 0 ? this.x : targets[i-1].x, y1: i === 0 ? this.y : targets[i-1].y, x2: t.x, y2: t.y, life: 0.15, color: '#39d353' });
