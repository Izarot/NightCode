Raw: {"index.html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\" />\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, user-scalable=no\" />\n<meta name=\"description\" content=\"SANDFALL - A sand wall tower defense game where you build dynamic walls to stop the Erosion.\" />\n<title>SANDFALL - Tower Defense</title>\n<link rel=\"icon\" href=\"data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🏜️</text></svg>\" />\n<style>\n  * { margin: 0; padding: 0; box-sizing: border-box; user-select: none; -webkit-user-select: none; -webkit-tap-highlight-color: transparent; }\n  html, body { width: 100%; height: 100%; overflow: hidden; background: #0D0D12; font-family: 'Courier New', monospace; color: #E8E4D9; }\n  #gameContainer { position: absolute; top: 0; left: 0; width: 100%; height: 100%; }\n  canvas { display: block; width: 100% !important; height: 100% !important; cursor: crosshair; touch-action: none; }\n  #uiOverlay { position: absolute; top: 0; left: 0; width: 100%; height: 100%; pointer-events: none; font-family: 'Courier New', monospace; }\n  #uiOverlay > * { pointer-events: auto; }\n  .hud-panel { background: rgba(13,13,18,0.78); border: 1px solid #D4A574; border-radius: 4px; padding: 8px 12px; backdrop-filter: blur(4px); }\n  #integrityPanel { position: absolute; top: 16px; left: 16px; min-width: 140px; }\n  #integrityBar { width: 24px; height: 180px; background: rgba(255,255,255,0.08); border-radius: 2px; position: relative; overflow: hidden; margin-top: 6px; }\n  #integrityFill { position: absolute; bottom: 0; width: 100%; height: 100%; background: linear-gradient(to top, #8B0000, #FFD700, #00CED1); transition: height 0.2s, background 0.3s; }\n  #integrityValue { font-size: 22px; font-weight: bold; margin-top: 6px; letter-spacing: 2px; }\n  #integrityLabel { font-size: 11px; letter-spacing: 3px; opacity: 0.8; }\n  #wavePanel { position: absolute; top: 16px; left: 50%; transform: translateX(-50%); text-align: center; min-width: 200px; }\n  #waveTitle { font-size: 18px; letter-spacing: 4px; font-weight: bold; }\n  #waveProgressBar { width: 220px; height: 6px; background: rgba(255,255,255,0.1); margin-top: 8px; border-radius: 3px; overflow: hidden; }\n  #waveProgressFill { height: 100%; width: 0%; background: linear-gradient(90deg, #B8860B, #D4A574); transition: width 0.1s linear; }\n  #waveState { font-size: 11px; margin-top: 4px; letter-spacing: 2px; opacity: 0.8; }\n  #spPanel { position: absolute; top: 16px; right: 16px; text-align: right; min-width: 160px; }\n  #spValue { font-size: 26px; font-weight: bold; color: #D4A574; text-shadow: 0 0 10px rgba(212,165,116,0.5); }\n  #spLabel { font-size: 11px; letter-spacing: 3px; opacity: 0.8; }\n  #spGen { font-size: 11px; color: #B8860B; margin-top: 4px; }\n  #spGain { position: absolute; right: 0; top: -8px; color: #FFD700; opacity: 0; font-size: 14px; font-weight: bold; transition: opacity 0.3s, transform 0.6s; }\n  #timerPanel { position: absolute; top: 16px; right: 200px; padding: 6px 10px; font-size: 13px; letter-spacing: 1px; }\n  #timerValue { color: #00CED1; font-weight: bold; font-size: 16px; }\n  #toolbar { position: absolute; bottom: 20px; left: 50%; transform: translateX(-50%); display: flex; gap: 10px; align-items: center; padding: 10px 16px; border-radius: 8px; }\n  .tool { width: 56px; height: 56px; border-radius: 50%; background: rgba(13,13,18,0.85); border: 2px solid #555; display: flex; flex-direction: column; align-items: center; justify-content: center; cursor: pointer; transition: all 0.2s; position: relative; font-size: 9px; letter-spacing: 1px; }\n  .tool.active { border-color: #D4A574; box-shadow: 0 0 12px rgba(212,165,116,0.6); transform: scale(1.08); }\n  .tool.disabled { opacity: 0.4; cursor: not-allowed; }\n  .tool-icon { font-size: 22px; line-height: 1; }\n  .tool-key { font-size: 9px; opacity: 0.7; margin-top: 2px; }\n  #minimapPanel { position: absolute; top: 16px; left: 180px; padding: 4px; }\n  #minimapCanvas { display: block; background: #0D0D12; border: 1px solid #333; }\n  #intelPanel { position: absolute; top: 16px; right: 200px; max-width: 220px; max-height: 200px; overflow: hidden; padding: 8px 12px; transition: all 0.3s; }\n  #intelPanel.hidden { width: 0; padding: 0; opacity: 0; pointer-events: none; }\n  #intelTitle { font-size: 11px; letter-spacing: 3px; margin-bottom: 6px; color: #D4A574; }\n  .intel-row { font-size: 11px; margin: 2px 0; display: flex; justify-content: space-between; }\n  #menuScreen, #gameOverScreen { position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: rgba(13,13,18,0.92); display: flex; flex-direction: column; align-items: center; justify-content: center; z-index: 100; backdrop-filter: blur(6px); }\n  #gameOverScreen { display: none; }\n  .game-title { font-size: 64px; font-weight: bold; letter-spacing: 12px; color: #D4A574; text-shadow: 0 0 30px rgba(212,165,116,0.7); margin-bottom: 8px; }\n  .game-subtitle { font-size: 14px; letter-spacing: 4px; opacity: 0.7; margin-bottom: 40px; }\n  .menu-btn { padding: 14px 36px; background: transparent; border: 2px solid #D4A574; color: #D4A574; font-family: inherit; font-size: 16px; letter-spacing: 4px; cursor: pointer; transition: all 0.2s; border-radius: 4px; }\n  .menu-btn:hover { background: #D4A574; color: #0D0D12; box-shadow: 0 0 24px rgba(212,165,116,0.7); }\n  .controls-info { margin-top: 36px; font-size: 11px; letter-spacing: 2px; opacity: 0.6; text-align: center; line-height: 1.8; }\n  .end-stat { font-size: 18px; margin: 6px 0; letter-spacing: 2px; }\n  .end-stat span { color: #D4A574; font-weight: bold; font-size: 24px; }\n  #highScoreDisplay { position: absolute; bottom: 80px; left: 50%; transform: translateX(-50%); font-size: 12px; letter-spacing: 3px; opacity: 0.6; }\n  .star { color: #FFD700; font-size: 32px; margin: 12px 0; letter-spacing: 8px; }\n  #pauseOverlay { position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: rgba(13,13,18,0.7); display: none; flex-direction: column; align-items: center; justify-content: center; z-index: 50; pointer-events: none; }\n  #pauseText { font-size: 48px; letter-spacing: 12px; color: #D4A574; }\n  @media (max-width: 768px) {\n    .game-title { font-size: 36px; letter-spacing: 6px; }\n    #integrityPanel { left: 8px; top: 8px; min-width: 100px; }\n    #integrityBar { height: 120px; width: 18px; }\n    #integrityValue { font-size: 16px; }\n    #wavePanel { top: 8px; }\n    #waveProgressBar { width: 140px; }\n    #spPanel { top: 8px; right: 8px; min-width: 110px; }\n    #spValue { font-size: 18px; }\n    #toolbar { bottom: 12px; padding: 8px; gap: 6px; }\n    .tool { width: 46px; height: 46px; font-size: 7px; }\n    .tool-icon { font-size: 18px; }\n    #minimapPanel { left: 130px; top: 8px; }\n    #minimapCanvas { width: 100px; height: 70px; }\n    #intelPanel { display: none; }\n    #timerPanel { display: none; }\n  }\n</style>\n</head>\n<body>\n<div id=\"gameContainer\">\n  <canvas id=\"gameCanvas\"></canvas>\n</div>\n<div id=\"uiOverlay\">\n  <div id=\"integrityPanel\" class=\"hud-panel\">\n    <div id=\"integrityLabel\">CITADEL INTEGRITY</div>\n    <div id=\"integrityBar\"><div id=\"integrityFill\"></div></div>\n    <div id=\"integrityValue\">100%</div>\n  </div>\n  <div id=\"wavePanel\" class=\"hud-panel\">\n    <div id=\"waveTitle\">WAVE 1</div>\n    <div id=\"waveProgressBar\"><div id=\"waveProgressFill\"></div></div>\n    <div id=\"waveState\">PREPARE</div>\n  </div>\n  <div id=\"spPanel\" class=\"hud-panel\">\n    <div id=\"spGain\">+0</div>\n    <div id=\"spLabel\">SAND POINTS</div>\n    <div id=\"spValue\">100</div>\n    <div id=\"spGen\">+5/sec</div>\n  </div>\n  <div id=\"timerPanel\" class=\"hud-panel\">\n    <div>SPEEDRUN</div>\n    <div id=\"timerValue\">00:00</div>\n  </div>\n  <div id=\"minimapPanel\" class=\"hud-panel\">\n    <canvas id=\"minimapCanvas\" width=\"160\" height=\"110\"></canvas>\n  </div>\n  <div id=\"intelPanel\" class=\"hud-panel\">\n    <div id=\"intelTitle\">WAVE INTEL</div>\n    <div id=\"intelList\"></div>\n  </div>\n  <div id=\"toolbar\" class=\"hud-panel\">\n    <div class=\"tool active\" data-tool=\"standard\">\n      <div class=\"tool-icon\">▬</div>\n      <div>STANDARD</div>\n      <div class=\"tool-key\">CLICK</div>\n    </div>\n    <div class=\"tool\" data-tool=\"reinforced\">\n      <div class=\"tool-icon\">▰</div>\n      <div>REINFORCED</div>\n      <div class=\"tool-key\">SHIFT</div>\n    </div>\n    <div class=\"tool\" data-tool=\"quick\">\n      <div class=\"tool-icon\">▭</div>\n      <div>QUICK</div>\n      <div class=\"tool-key\">CTRL</div>\n    </div>\n    <div class=\"tool\" data-tool=\"excavate\">\n      <div class=\"tool-icon\">✕</div>\n      <div>EXCAVATE</div>\n      <div class=\"tool-key\">ALT</div>\n    </div>\n    <div class=\"tool\" data-tool=\"blast\" id=\"blastTool\">\n      <div class=\"tool-icon\">◎</div>\n      <div>SANDBLAST</div>\n      <div class=\"tool-key\">RMB</div>\n    </div>\n  </div>\n  <div id=\"pauseOverlay\"><div id=\"pauseText\">PAUSED</div></div>\n</div>\n<div id=\"menuScreen\">\n  <div class=\"game-title\">SANDFALL</div>\n  <div class=\"game-subtitle\">A SAND WALL TOWER DEFENSE</div>\n  <button class=\"menu-btn\" id=\"startBtn\">BEGIN DEFENSE</button>\n  <div class=\"controls-info\">\n    LEFT-DRAG: BUILD WALL &nbsp;|&nbsp; SHIFT: REINFORCED &nbsp;|&nbsp; CTRL: QUICK<br/>\n    ALT: EXCAVATE &nbsp;|&nbsp; RIGHT-CLICK: SANDBLAST<br/>\n    WASD: PAN &nbsp;|&nbsp; WHEEL: ZOOM &nbsp;|&nbsp; SPACE: PAUSE\n  </div>\n  <div id=\"highScoreDisplay\">HIGH SCORE: <span id=\"menuHighScore\">0</span></div>\n</div>\n<div id=\"gameOverScreen\">\n  <div class=\"game-title\" style=\"font-size:48px;\">CITADEL FALLEN</div>\n  <div class=\"game-subtitle\">WAVES SURVIVED: <span id=\"finalWaves\">0</span></div>\n  <div class=\"star\" id=\"finalStars\">★ ★ ★</div>\n  <div class=\"end-stat\">FINAL SCORE: <span id=\"finalScore\">0</span></div>\n  <div class=\"end-stat\">SAND EFFICIENCY: <span id=\"finalEfficiency\">0</span>%</div>\n  <div class=\"end-stat\">HIGH SCORE: <span id=\"finalHighScore\">0</span></div>\n  <button class=\"menu-btn\" id=\"restartBtn\" style=\"margin-top:24px;\">RECONSTRUCT</button>\n</div>\n<script src=\"game.js\"></script>\n</body>\n</html>\n", "game.js": "// ============================================================\n// SANDFALL - A Sand Wall Tower Defense Game\n// Complete implementation using HTML5 Canvas\n// ============================================================\n\n(() => {\n  'use strict';\n\n  // -------- Utility Functions --------\n  const clamp = (v, a, b) => Math.max(a, Math.min(b, v));\n  const lerp = (a, b, t) => a + (b - a) * t;\n  const dist = (x1, y1, x2, y2) => Math.hypot(x2 - x1, y2 - y1);\n  const distSeg = (px, py, ax, ay, bx, by) => {\n    const dx = bx - ax, dy = by - ay;\n    const len2 = dx * dx + dy * dy;\n    if (len2 === 0) return dist(px, py, ax, ay);\n    let t = ((px - ax) * dx + (py - ay) * dy) / len2;\n    t = clamp(t, 0, 1);\n    return dist(px, py, ax + t * dx, ay + t * dy);\n  };\n  const rand = (a, b) => a + Math.random() * (b - a);\n  const randInt = (a, b) => Math.floor(rand(a, b + 1));\n  const fmtTime = (s) => {\n    const m = Math.floor(s / 60);\n    const ss = Math.floor(s % 60);\n    return String(m).padStart(2, '0') + ':' + String(ss).padStart(2, '0');\n  };\n\n  // -------- Audio System (Web Audio API) --------\n  class AudioSystem {\n    constructor() {\n      this.ctx = null;\n      this.masterGain = null;\n      this.enabled = true;\n      this.muted = false;\n    }\n    init() {\n      if (this.ctx) return;\n      try {\n        this.ctx = new (window.AudioContext || window.webkitAudioContext)();\n        this.masterGain = this.ctx.createGain();\n        this.masterGain.gain.value = 0.4;\n        this.masterGain.connect(this.ctx.destination);\n      } catch (e) {\n        this.enabled = false;\n      }\n    }\n    resume() {\n      if (this.ctx && this.ctx.state === 'suspended') this.ctx.resume();\n    }\n    noiseBurst(duration, freq, vol, type = 'highpass') {\n      if (!this.ctx || this.muted) return;\n      const ctx = this.ctx;\n      const now = ctx.currentTime;\n      const buffer = ctx.createBuffer(1, ctx.sampleRate * duration, ctx.sampleRate);\n      const data = buffer.getChannelData(0);\n      for (let i = 0; i < data.length; i++) data[i] = (Math.random() * 2 - 1);\n      const src = ctx.createBufferSource();\n      src.buffer = buffer;\n      const filter = ctx.createBiquadFilter();\n      filter.type = type;\n      filter.frequency.value = freq;\n      const gain = ctx.createGain();\n      gain.gain.setValueAtTime(vol, now);\n      gain.gain.exponentialRampToValueAtTime(0.001, now + duration);\n      src.connect(filter).connect(gain).connect(this.masterGain);\n      src.start(now);\n      src.stop(now + duration);\n    }\n    build(speed) {\n      if (!this.ctx) return;\n      this.noiseBurst(0.15, 2000 + speed * 800, 0.15, 'bandpass');\n    }\n    thud(size = 1) {\n      if (!this.ctx) return;\n      this.noiseBurst(0.12, 150 / size, 0.25, 'lowpass');\n    }\n    crumble() {\n      if (!this.ctx) return;\n      this.noiseBurst(0.6, 800, 0.2, 'bandpass');\n      setTimeout(() => this.noiseBurst(0.3, 400, 0.15, 'lowpass'), 100);\n    }\n    blast() {\n      if (!this.ctx) return;\n      this.noiseBurst(0.4, 600, 0.35, 'lowpass');\n      setTimeout(() => this.noiseBurst(0.3, 1200, 0.2, 'highpass'), 80);\n    }\n    ui(freq = 800) {\n      if (!this.ctx) return;\n      const ctx = this.ctx;\n      const now = ctx.currentTime;\n      const osc = ctx.createOscillator();\n      osc.type = 'sine';\n      osc.frequency.setValueAtTime(freq, now);\n      osc.frequency.exponentialRampToValueAtTime(freq * 1.5, now + 0.08);\n      const gain = ctx.createGain();\n      gain.gain.setValueAtTime(0.15, now);\n      gain.gain.exponentialRampToValueAtTime(0.001, now + 0.1);\n      osc.connect(gain).connect(this.masterGain);\n      osc.start(now);\n      osc.stop(now + 0.1);\n    }\n    waveStart() {\n      if (!this.ctx) return;\n      this.ui(440);\n      setTimeout(() => this.ui(660), 120);\n      setTimeout(() => this.ui(880), 240);\n    }\n  }\n\n  // -------- Particle System --------\n  class Particle {\n    constructor(x, y, vx, vy, life, color, size, gravity = 0) {\n      this.x = x; this.y = y;\n      this.vx = vx; this.vy = vy;\n      this.life = life; this.maxLife = life;\n      this.color = color;\n      this.size = size;\n      this.gravity = gravity;\n    }\n    update(dt) {\n      this.x += this.vx * dt;\n      this.y += this.vy * dt;\n      this.vy += this.gravity * dt;\n      this.life -= dt;\n    }\n    draw(ctx, cam) {\n      const a = clamp(this.life / this.maxLife, 0, 1);\n      const sx = (this.x - cam.x) * cam.zoom + cam.viewW / 2;\n      const sy = (this.y - cam.y) * cam.zoom + cam.viewH / 2;\n      ctx.globalAlpha = a;\n      ctx.fillStyle = this.color;\n      ctx.fillRect(sx - this.size / 2, sy - this.size / 2, this.size, this.size);\n      ctx.globalAlpha = 1;\n    }\n    get dead() { return this.life <= 0; }\n  }\n\n  // -------- Camera --------\n  class Camera {\n    constructor(viewW, viewH, worldW, worldH) {\n      this.x = 0; this.y = 0;\n      this.viewW = viewW; this.viewH = viewH;\n      this.worldW = worldW; this.worldH = worldH;\n      this.zoom = 1; this.targetZoom = 1;\n      this.shakeX = 0; this.shakeY = 0;\n      this.shakeIntensity = 0;\n    }\n    resize(w, h) { this.viewW = w; this.viewH = h; }\n    pan(dx, dy) {\n      const lim = 600;\n      this.x = clamp(this.x + dx, -lim, this.worldW + lim);\n      this.y = clamp(this.y + dy, -lim, this.worldH + lim);\n    }\n    setTarget(zx, zy) {\n      const z = this.targetZoom;\n      this.x = clamp(zx, -lim(this.worldW, this.viewW, z), this.worldW + lim);\n      this.y = clamp(zy, -lim(this.worldH, this.viewH, z), this.worldH + lim);\n    }\n    update(dt) {\n      this.zoom = lerp(this.zoom, this.targetZoom, 0.15);\n      if (this.shakeIntensity > 0) {\n        this.shakeX = (Math.random() - 0.5) * this.shakeIntensity;\n        this.shakeY = (Math.random() - 0.5) * this.shakeIntensity;\n        this.shakeIntensity *= 0.85;\n        if (this.shakeIntensity < 0.1) this.shakeIntensity = 0;\n      } else { this.shakeX = this.shakeY = 0; }\n    }\n    shake(intensity) { this.shakeIntensity = Math.max(this.shakeIntensity, intensity); }\n    worldToScreen(x, y) {\n      return {\n        sx: (x - this.x) * this.zoom + this.viewW / 2 + this.shakeX,\n        sy: (y - this.y) * this.zoom + this.viewH / 2 + this.shakeY\n      };\n    }\n    screenToWorld(sx, sy) {\n      return {\n        x: (sx - this.viewW / 2 - this.shakeX) / this.zoom + this.x,\n        y: (sy - this.viewH / 2 - this.shakeY) / this.zoom + this.y\n      };\n    }\n  }\n\n  // -------- Wall Segment --------\n  class WallSegment {\n    constructor(ax, ay, bx, by, type) {\n      this.ax = ax; this.ay = ay; this.bx = bx; this.by = by;\n      const cfg = WALL_TYPES[type];\n      this.type = type;\n      this.maxHp = cfg.hp;\n      this.hp = cfg.hp;\n      this.thickness = cfg.thickness;\n      this.color = cfg.color;\n      this.cost = cfg.cost;\n      this.alive = true;\n      this.broken = false;\n      this.growT = 0;\n      this.growDuration = type === 'quick' ? 0.08 : 0.35;\n      this.vibration = 0;\n      this.debris = [];\n    }\n    damage(amount) {\n      this.hp -= amount;\n      this.vibration = Math.min(3, this.vibration + amount * 0.05);\n      if (this.hp <= 0 && this.alive) {\n        this.alive = false;\n        this.spawnDebris();\n      }\n    }\n    spawnDebris() {\n      const mx = (this.ax + this.bx) / 2;\n      const my = (this.ay + this.by) / 2;\n      const dx = this.bx - this.ax, dy = this.by - this.ay;\n      const len = Math.hypot(dx, dy) || 1;\n      const nx = -dy / len, ny = dx / len;\n      for (let i = 0; i < 4; i++) {\n        const t = (i - 1.5) / 2;\n        this.debris.push({\n          x: mx + nx * t * this.thickness * 1.2,\n          y: my + ny * t * this.thickness * 1.2,\n          vx: nx * rand(-60, 60) + rand(-20, 20),\n          vy: ny * rand(-60, 60) + rand(-20, 20),\n          life: 1.0,\n          size: rand(3, 6)\n        });\n      }\n    }\n    update(dt) {\n      if (this.growT < 1) this.growT = Math.min(1, this.growT + dt / this.growDuration);\n      this.vibration *= 0.85;\n      for (const d of this.debris) {\n        d.x += d.vx * dt; d.y += d.vy * dt;\n        d.vx *= 0.92; d.vy *= 0.92;\n        d.life -= dt;\n      }\n      this.debris = this.debris.filter(d => d.life > 0);\n    }\n    draw(ctx, cam) {\n      const g = this.growT;\n      const eased = 1 - Math.pow(1 - g, 3);\n      const ax = lerp(this.ax, this.bx, 0.5 - 0.5 * eased);\n      const ay = lerp(this.ay, this.by, 0.5 - 0.5 * eased);\n      const bx = lerp(this.ax, this.bx, 0.5 + 0.5 * eased);\n      const by = lerp(this.ay, this.by, 0.5 + 0.5 * eased);\n      const p1 = cam.worldToScreen(ax + (Math.random() - 0.5) * this.vibration, ay + (Math.random() - 0.5) * this.vibration);\n      const p2 = cam.worldToScreen(bx + (Math.random() - 0.5) * this.vibration, by + (Math.random() - 0.5) * this.vibration);\n      const t = this.thickness * cam.zoom * (this.alive ? 1 : 0.5);\n      const dmgRatio = this.alive ? clamp(this.hp / this.maxHp, 0, 1) : 0.5;\n      ctx.strokeStyle = this.alive ? this.color : '#555';\n      ctx.globalAlpha = this.alive ? 1 : 0.4;\n      ctx.lineWidth = t;\n      ctx.lineCap = 'round';\n      ctx.beginPath();\n      ctx.moveTo(p1.sx, p1.sy);\n      ctx.lineTo(p2.sx, p2.sy);\n      ctx.stroke();\n      if (this.alive) {\n        ctx.strokeStyle = 'rgba(255,255,255,0.3)';\n        ctx.lineWidth = t * 0.3;\n        ctx.beginPath();\n        ctx.moveTo(p1.sx, p1.sy - t * 0.2);\n        ctx.lineTo(p2.sx, p2.sy - t * 0.2);\n        ctx.stroke();\n      }\n      ctx.globalAlpha = 1;\n      for (const d of this.debris) {\n        const sp = cam.worldToScreen(d.x, d.y);\n        ctx.globalAlpha = d.life;\n        ctx.fillStyle = '#8B7355';\n        ctx.fillRect(sp.sx - d.size / 2, sp.sy - d.size / 2, d.size, d.size);\n      }\n      ctx.globalAlpha = 1;\n    }\n    containsPoint(x, y, tolerance = 8) {\n      return distSeg(x, y, this.ax, this.ay, this.bx, this.by) < this.thickness / 2 + tolerance;\n    }\n    isFortified() { return this.type === 'reinforced'; }\n  }\n\n  // -------- Enemy --------\n  class Enemy {\n    constructor(x, y, type, worldW, worldH) {\n      this.x = x; this.y = y;\n      this.type = type;\n      const cfg = ENEMY_TYPES[type];\n      this.maxHp = cfg.hp;\n      this.hp = cfg.hp;\n      this.speed = cfg.speed;\n      this.damage = cfg.damage;\n      this.size = cfg.size;\n      this.color = cfg.color;\n      this.glowColor = cfg.glow;\n      this.behavior = cfg.behavior;\n      this.targetX = worldW - 100;\n      this.targetY = worldH / 2 + (Math.random() - 0.5) * 200;\n      this.attackTimer = 0;\n      this.alive = true;\n      this.knockX = 0; this.knockY = 0;\n      this.knockTime = 0;\n      this.flowPhase = Math.random() * Math.PI * 2;\n      this.phaseTime = 0;\n      this.spawnAnim = 0;\n    }\n    update(dt, walls, citadel, particles) {\n      this.spawnAnim = Math.min(1, this.spawnAnim + dt * 2);\n      this.flowPhase += dt * 3;\n      if (this.behavior === 'phase' && this.phaseTime > 0) this.phaseTime -= dt;\n      let dx = this.targetX - this.x;\n      let dy = this.targetY - this.y;\n      const d = Math.hypot(dx, dy) || 1;\n      dx /= d; dy /= d;\n      let blocked = false;\n      let blockingWall = null;\n      let closestDist = Infinity;\n      for (const w of walls) {\n        if (!w.alive) continue;\n        if (this.behavior === 'phase' && this.phaseTime > 0 && !w.isFortified()) continue;\n        const d2 = distSeg(this.x, this.y, w.ax, w.ay, w.bx, w.by);\n        if (d2 < this.size + w.thickness / 2) {\n          blocked = true;\n          if (d2 < closestDist) {\n            closestDist = d2;\n            blockingWall = w;\n          }\n        }\n      }\n      const targetDist = dist(this.x, this.y, this.targetX, this.targetY);\n      if (this.behavior === 'sluice' && blocked) {\n        const closestEnd = dist(this.x, this.y, blockingWall.ax, blockingWall.ay) <\n          dist(this.x, this.y, blockingWall.bx, blockingWall.by) ?\n          { x: blockingWall.ax, y: blockingWall.ay } :\n          { x: blockingWall.bx, y: blockingWall.by };\n        const ex = closestEnd.x - this.x, ey = closestEnd.y - this.y;\n        const ed = Math.hypot(ex, ey) || 1;\n        dx = ex / ed; dy = ey / ed;\n        if (ed < 30) {\n          this.targetX = citadel.x;\n          this.targetY = citadel.y;\n          dx = this.targetX - this.x; dy = this.targetY - this.y;\n          const dd = Math.hypot(dx, dy) || 1; dx /= dd; dy /=dd;\n      }\n      }\n      let speedMult = 1;\n      if (this.behavior === 'surge' && blocked) speedMult = 1.4;\n      if (this.behavior === 'flow') speedMult = 0.7 + Math.sin(this.flowPhase) * 0.3;\n      this.x += (dx * this.speed * speedMult + this.knockX) * dt;\n      this.y += (dy * this.speed * speedMult + this.knockY) * dt;\n      if (this.knockTime > 0) {\n        this.knockTime -= dt;\n        this.knockX *= 0.85; this.knockY *= 0.85;\n      }\n      this.attackTimer -= dt;\n      if (blockingWall && blocked && this.attackTimer <= 0) {\n        blockingWall.damage(this.damage);\n        this.attackTimer = 0.5;\n        particles.push(new Particle(\n          (blockingWall.ax + blockingWall.bx) / 2,\n          (blockingWall.ay + blockingWall.by) / 2,\n          rand(-40, 40), rand(-80, -20), 0.6, '#D4A574', 3, 100\n        ));\n      }\n      if (blocked && blockingWall && this.behavior === 'erode' && this.attackTimer <= 0) {\n        for (let i = 0; i < 3; i++) {\n          particles.push(new Particle(\n            blockingWall.ax + rand(0, blockingWall.bx - blockingWall.ax),\n            blockingWall.ay + rand(0, blockingWall.by - blockingWall.ay),\n            rand(-30, 30), rand(-60, 0), 0.8, '#8B7355', 4, 80\n          ));\n        }\n      }\n      const cdx = citadel.x - this.x, cdy = citadel.y - this.y;\n      if (Math.hypot(cdx, cdy) < citadel.radius + this.size) {\n        if (this.attackTimer <= 0) {\n          citadel.integrity -= this.damage * 2;\n          this.attackTimer = 0.8;\n          particles.push(new Particle(this.x, this.y, rand(-50, 50), rand(-50, 50), 0.5, '#FF4500', 4));\n          audio.thud(0.5);\n          cam.shake(this.damage * 0.5);\n        }\n      }\n    }\n    damage(amount, knockX, knockY) {\n      this.hp -= amount;\n      this.knockX += knockX * 30;\n      this.knockY += knockY * 30;\n      this.knockTime = 0.2;\n      if (this.hp <= 0 && this.alive) {\n        this.alive = false;\n        for (let i = 0; i < 6; i++) {\n          particles.push(new Particle(this.x, this.y, rand(-80, 80), rand(-80, 80), 0.8, this.color, rand(3, 6)));\n        }\n        audio.thud(0.3);\n      }\n    }\n    draw(ctx, cam) {\n      const p = cam.worldToScreen(this.x, this.y);\n      const s = this.size * cam.zoom * this.spawnAnim;\n      ctx.save();\n      ctx.globalAlpha = this.behavior === 'phase' && this.phaseTime > 0 ? 0.4 : 1;\n      const grd = ctx.createRadialGradient(p.sx, p.sy, 0, p.sx, p.sy, s * 1.5);\n      grd.addColorStop(0, this.glowColor);\n      grd.addColorStop(1, 'rgba(0,0,0,0)');\n      ctx.fillStyle = grd;\n      ctx.beginPath();\n      ctx.arc(p.sx, p.sy, s * 1.5, 0, Math.PI * 2);\n      ctx.fill();\n      ctx.fillStyle = this.color;\n      ctx.beginPath();\n      ctx.arc(p.sx, p.sy, s, 0, Math.PI * 2);\n      ctx.fill();\n      ctx.fillStyle = '#000';\n      ctx.beginPath();\n      ctx.arc(p.sx - s * 0.3, p.sy - s * 0.2, s * 0.2, 0, Math.PI * 2);\n      ctx.arc(p.sx + s * 0.3, p.sy - s * 0.2, s * 0.2, 0, Math.PI * 2);\n      ctx.fill();\n      ctx.restore();\n      const hpRatio = clamp(this.hp / this.maxHp, 0, 1);\n      if (hpRatio < 1 && this.alive) {\n        ctx.fillStyle = '#333';\n        ctx.fillRect(p.sx - s, p.sy - s * 1.6, s * 2, 3);\n        ctx.fillStyle = '#D4A574';\n        ctx.fillRect(p.sx - s, p.sy - s * 1.6, s * 2 * hpRatio, 3);\n      }\n    }\n  }\n\n  // -------- Citadel --------\n  class Citadel {\n    constructor(x, y) {\n      this.x = x; this.y = y;\n      this.radius = 80;\n      this.maxIntegrity = 100;\n      this.integrity = 100;\n      this.pulseT = 0;\n    }\n    update(dt) {\n      this.pulseT += dt;\n      this.integrity = clamp(this.integrity, 0, this.maxIntegrity);\n    }\n    draw(ctx, cam) {\n      const p = cam.worldToScreen(this.x, this.y);\n      const r = this.radius * cam.zoom;\n      const pulse = Math.sin(this.pulseT * 2) * 4;\n      const grd = ctx.createRadialGradient(p.sx, p.sy, 0, p.sx, p.sy, r * 1.4);\n      const intRatio = this.integrity / this.maxIntegrity;\n      const color = intRatio > 0.6 ? '#D4A574' : intRatio > 0.3 ? '#B8860B' : '#8B0000';\n      grd.addColorStop(0, color);\n      grd.addColorStop(0.7, 'rgba(212,165,116,0.3)');\n      grd.addColorStop(1, 'rgba(0,0,0,0)');\n      ctx.fillStyle = grd;\n      ctx.beginPath();\n      ctx.arc(p.sx, p.sy, r * 1.4 + pulse, 0, Math.PI * 2);\n      ctx.fill();\n      ctx.strokeStyle = color;\n      ctx.lineWidth = 3;\n      ctx.beginPath();\n      ctx.arc(p.sx, p.sy, r, 0, Math.PI * 2);\n      ctx.stroke();\n      ctx.fillStyle = '#0D0D12';\n      ctx.beginPath();\n      ctx.arc(p.sx, p.sy, r * 0.7, 0, Math.PI * 2);\n      ctx.fill();\n      ctx.fillStyle = color;\n      ctx.font = `${Math.floor(r * 0.4)}px 'Courier New'`;\n      ctx.textAlign = 'center';\n      ctx.textBaseline = 'middle';\n      ctx.fillText('⌂', p.sx, p.sy);\n    }\n  }\n\n  // -------- Sand Blast --------\n  class SandBlast {\n    constructor(x, y, vx, vy) {\n      this.x = x; this.y = y;\n      this.vx = vx; this.vy = vy;\n      this.life = 1.5;\n      this.maxLife = 1.5;\n      this.radius = 40;\n      this.alive = true;\n    }\n    update(dt) {\n      this.x += this.vx * dt;\n      this.y += this.vy * dt;\n      this.vx *= 0.95;\n      this.vy *= 0.95;\n      this.life -= dt;\n      if (this.life <= 0) this.alive = false;\n    }\n    draw(ctx, cam) {\n      const p = cam.worldToScreen(this.x, this.y);\n      const r = this.radius * cam.zoom * (this.life / this.maxLife);\n      const grd = ctx.createRadialGradient(p.sx, p.sy, 0, p.sx, p.sy, r);\n      grd.addColorStop(0, 'rgba(212,165,116,0.6)');\n      grd.addColorStop(0.5, 'rgba(184,134,11,0.3)');\n      grd.addColorStop(1, 'rgba(0,0,0,0)');\n      ctx.fillStyle = grd;\n      ctx.beginPath();\n      ctx.arc(p.sx, p.sy, r, 0, Math.PI * 2);\n      ctx.fill();\n    }\n  }\n\n  // -------- Wall Builder --------\n  class WallBuilder {\n    constructor(worldW, worldH) {\n      this.worldW = worldW;\n      this.worldH = worldH;\n      this.startX = 0; this.startY = 0;\n      this.endX = 0; this.endY = 0;\n      this.dragging = false;\n      this.currentType = 'standard';\n    }\n    setType(t) { this.currentType = t; }\n    start(x, y) {\n      this.startX = x; this.startY = y;\n      this.endX = x; this.endY = y;\n      this.dragging = true;\n    }\n    update(x, y) {\n      if (!this.dragging) return;\n      this.endX = x; this.endY = y;\n      const d = dist(this.startX, this.startY, x, y);\n      if (d > 25) {\n        const cfg = WALL_TYPES[this.currentType];\n        if (d < cfg.maxLength + 25) {\n          this.endX = x; this.endY = y;\n        } else {\n          const a = Math.atan2(y - this.startY, x - this.startX);\n          this.endX = this.startX + Math.cos(a) * cfg.maxLength;\n          this.endY = this.startY + Math.sin(a) * cfg.maxLength;\n        }\n      }\n    }\n    cancel() { this.dragging = false; }\n    preview() {\n      if (!this.dragging) return null;\n      const cfg = WALL_TYPES[this.currentType];\n      const d = dist(this.startX, this.startY, this.endX, this.endY);\n      if (d < 12) return null;\n      const valid = this.canBuild(this.startX, this.startY, this.endX, this.endY);\n      return { ax: this.startX, ay: this.startY, bx: this.endX, by: this.endY, valid, cfg };\n    }\n    canBuild(ax, ay, bx, by) {\n      if (Math.hypot(bx - ax, by - ay) < 12) return false;\n      const margin = 80;\n      if (ax < margin || ay < margin || bx < margin || by < margin) return false;\n      if (ax > this.worldW - margin || ay > this.worldH - margin) return false;\n      if (bx > this.worldW - margin || by > this.worldH - margin) return false;\n      return true;\n    }\n    commit() {\n      if (!this.dragging) return null;\n      this.dragging = false;\n      const d = dist(this.startX, this.startY, this.endX, this.endY);\n      if (d < 12) return null;\n      if (!this.canBuild(this.startX, this.startY, this.endX, this.endY)) return null;\n      return { ax: this.startX, ay: this.startY, bx: this.endX, by: this.endY, type: this.currentType };\n    }\n    drawPreview(ctx, cam) {\n      const p = this.preview();\n      if (!p) return;\n      const sp1 = cam.worldToScreen(p.ax, p.ay);\n      const sp2 = cam.worldToScreen(p.bx, p.by);\n      ctx.strokeStyle = p.valid ? '#FFD700' : '#FF4500';\n      ctx.lineWidth = p.cfg.thickness * cam.zoom;\n      ctx.globalAlpha = 0.6;\n      ctx.setLineDash([8, 6]);\n      ctx.beginPath();\n      ctx.moveTo(sp1.sx, sp1.sy);\n      ctx.lineTo(sp2.sx, sp2.sy);\n      ctx.stroke();\n      ctx.setLineDash([]);\n      ctx.globalAlpha = 1;\n      ctx.fillStyle = '#FFD700';\n      ctx.beginPath();\n      ctx.arc(sp1.sx, sp1.sy, 5, 0, Math.PI * 2);\n      ctx.fill();\n      ctx.beginPath();\n      ctx.arc(sp2.sx, sp2.sy, 5, 0, Math.PI * 2);\n      ctx.fill();\n    }\n  }\n\n  // -------- Wave Manager --------\n  class WaveManager {\n    constructor() {\n      this.wave = 0;\n      this.subWave = 0;\n      this.enemiesPerSubWave = 8;\n      this.spawnQueue = [];\n      this.spawnTimer = 0;\n      this.spawnInterval = 0.4;\n      this.state = 'prepare';\n      this.prepareTime = 12;\n      this.prepareTimer = 0;\n      this.activeEnemies = 0;\n      this.totalToSpawn = 0;\n      this.betweenWaves = 0;\n      this.maxWaves = 20;\n    }\n    startWave(n) {\n      this.wave = n;\n      this.subWave = 0;\n      this.state = 'spawning';\n      this.prepareTimer = 0;\n      this.generateSubWave();\n      audio.waveStart();\n    }\n    generateSubWave() {\n      this.spawnQueue = [];\n      const subWaveIndex = Math.floor(this.wave / 3);\n      const subWaveCount = 2 + Math.min(4, subWaveIndex);\n      const isElite = (this.wave % 5 === 0);\n      for (let i = 0; i < this.enemiesPerSubWave + subWaveIndex * 2; i++) {\n        let type = 'flow';\n        if (this.wave >= 2 && Math.random() < 0.3) type = 'sluice';\n        if (this.wave >= 3 && Math.random() < 0.2) type = 'erode';\n        if (this.wave >= 5 && Math.random() < 0.15) type = 'surge';\n        if (this.wave >= 7 && Math.random() < 0.1) type = 'phase';\n        if (isElite && i % 5 === 0) type = ['sluice', 'erode', 'surge', 'phase'][Math.floor(Math.random() * 4)];\n        this.spawnQueue.push(type);\n      }\n      this.totalToSpawn = this.spawnQueue.length;\n    }\n    update(dt) {\n      if (this.state === 'prepare') {\n        this.prepareTimer += dt;\n        if (this.prepareTimer >= this.prepareTime) {\n          this.startWave(1);\n        }\n      } else if (this.state === 'spawning') {\n        this.spawnTimer -= dt;\n        if (this.spawnTimer <= 0 && this.spawnQueue.length > 0) {\n          this.spawnTimer = this.spawnInterval;\n          return this.spawnQueue.shift();\n        }\n      } else if (this.state === 'fighting') {\n        if (this.activeEnemies === 0 && this.spawnQueue.length === 0) {\n          this.state = 'between';\n          this.betweenWaves = 0;\n        }\n      } else if (this.state === 'between') {\n        this.betweenWaves += dt;\n        if (this.betweenWaves >= 6) {\n          if (this.wave >= this.maxWaves) {\n            this.state = 'victory';\n          } else {\n            this.startWave(this.wave + 1);\n          }\n        }\n      }\n      return null;\n    }\n    getProgress() {\n      if (this.state === 'prepare') return this.prepareTimer / this.prepareTime;\n      if (this.state === 'spawning') return (this.totalToSpawn - this.spawnQueue.length) / this.totalToSpawn;\n      if (this.state === 'fighting') return 1;\n      if (this.state === 'between') return this.betweenWaves / 6;\n      return 1;\n    }\n    getStateText() {\n      if (this.state === 'prepare') return 'PREPARE';\n      if (this.state === 'spawning') return 'INCOMING';\n      if (this.state === 'fighting') return 'ENGAGE';\n      if (this.state === 'between') return 'REST';\n      return '';\n    }\n  }\n\n  // -------- Configuration --------\n  const WALL_TYPES = {\n    standard: { hp: 30, thickness: 6, color: '#D4A574', cost: 5, maxLength: 200 },\n    reinforced: { hp: 80, thickness: 10, color: '#FFD700', cost: 18, maxLength: 150 },\n    quick: { hp: 12, thickness: 4, color: '#E0C088', cost: 2, maxLength: 250 },\n    blast: { hp: 1, thickness: 1, color: '#FFF', cost: 0, maxLength: 0 }\n  };\n  const ENEMY_TYPES = {\n    flow: { hp: 20, speed: 50, damage: 5, size: 14, color: '#B8860B', glow: 'rgba(184,134,11,0.4)', behavior: 'flow' },\n    sluice: { hp: 40, speed: 45, damage: 8, size: 16, color: '#8B4513', glow: 'rgba(139,69,19,0.4)', behavior: 'sluice' },\n    erode: { hp: 30, speed: 35, damage: 12, size: 18, color: '#A0522D', glow: 'rgba(160,82,45,0.4)', behavior: 'erode' },\n    surge: { hp: 50, speed: 80, damage: 10, size: 12, color: '#CD853F', glow: 'rgba(205,133,63,0.4)', behavior: 'surge' },\n    phase: { hp: 35, speed: 55, damage: 9, size: 15, color: '#DEB887', glow: 'rgba(222,184,135,0.5)', behavior: 'phase' }\n  };\n\n  // -------- Minimap --------\n  class Minimap {\n    constructor(canvas, worldW, worldH) {\n      this.canvas = canvas;\n      this.ctx = canvas.getContext('2d');\n      this.worldW = worldW;\n      this.worldH = worldH;\n      this.scaleX = canvas.width / worldW;\n      this.scaleY = canvas.height / worldH;\n    }\n    draw(walls, enemies, citadel, cam) {\n      const ctx = this.ctx;\n      ctx.fillStyle = '#0D0D12';\n      ctx.fillRect(0, 0, this.canvas.width, this.canvas.height);\n      ctx.strokeStyle = '#D4A574';\n      ctx.lineWidth = 1;\n      ctx.beginPath();\n      ctx.arc(citadel.x * this.scaleX, citadel.y * this.scaleY, 6, 0, Math.PI * 2);\n      ctx.stroke();\n      ctx.strokeStyle = '#555';\n      for (const w of walls) {\n        if (!w.alive) continue;\n        ctx.beginPath();\n        ctx.moveTo(w.ax * this.scaleX, w.ay * this.scaleY);\n        ctx.lineTo(w.bx * this.scaleX, w.by * this.scaleY);\n        ctx.stroke();\n      }\n      ctx.fillStyle = '#8B0000';\n      for (const e of enemies) {\n        if (!e.alive) continue;\n        ctx.beginPath();\n        ctx.arc(e.x * this.scaleX, e.y * this.scaleY, 2, 0, Math.PI * 2);\n        ctx.fill();\n      }\n      ctx.strokeStyle = '#FFD700';\n      ctx.lineWidth = 1;\n      ctx.strokeRect(\n        (cam.x - cam.viewW / (2 * cam.zoom)) * this.scaleX,\n        (cam.y - cam.viewH / (2 * cam.zoom)) * this.scaleY,\n        (cam.viewW / cam.zoom) * this.scaleX,\n        (cam.viewH / cam.zoom) * this.scaleY\n      );\n    }\n  }\n\n  // -------- Main Game --------\n  const canvas = document.getElementById('gameCanvas');\n  const ctx = canvas.getContext('2d');\n  const minimapCanvas = document.getElementById('minimapCanvas');\n  const audio = new AudioSystem();\n  const particles = [];\n  const walls = [];\n  const enemies = [];\n  const blasts = [];\n\n  const WORLD_W = 2400;\n  const WORLD_H = 1600;\n  let cam;\n  let builder;\n  let waveMgr;\n  let minimap;\n  let citadel;\n  let mouse = { x: 0, y: 0, worldX: 0, worldY: 0, down: false, rightDown: false };\n  let keys = {};\n  let sandPoints = 100;\n  let sandGen = 5;\n  let sandTotal = 0;\n  let sandSpent = 0;\n  let waveEnemiesKilled = 0;\n  let totalEnemiesKilled = 0;\n  let speedrunTime = 0;\n  let paused = false;\n  let gameState = 'menu';\n  let highScore = parseInt(localStorage.getItem('sandfall_high') || '0');\n  let lastFrame = 0;\n  let tool = 'standard';\n  let modifier = { shift: false, ctrl: false, alt: false };\n  let spGainAnim = [];\n  let lastTime = 0;\n  let frameCount = 0;\n\n  function resize() {\n    canvas.width = window.innerWidth;\n    canvas.height = window.innerHeight;\n    if (cam) {\n      cam.resize(canvas.width, canvas.height);\n    }\n  }\n  window.addEventListener('resize', resize);\n  resize();\n\n  function initGame() {\n    cam = new Camera(canvas.width, canvas.height, WORLD_W, WORLD_H);\n    cam.x = WORLD_W / 2; cam.y = WORLD_H / 2;\n    builder = new WallBuilder(WORLD_W, WORLD_H);\n    waveMgr = new WaveManager();\n    minimap = new Minimap(minimapCanvas, WORLD_W, WORLD_H);\n    citadel = new Citadel(WORLD_W - 200, WORLD_H / 2);\n    walls.length = 0; enemies.length = 0; particles.length = 0; blasts.length = 0;\n    sandPoints = 100;\n    sandTotal = 100;\n    sandSpent = 0;\n    speedrunTime = 0;\n    waveEnemiesKilled = 0;\n    totalEnemiesKilled = 0;\n    tool = 'standard';\n    paused = false;\n    gameState = 'playing';\n    document.getElementById('menuScreen').style.display = 'none';\n    document.getElementById('gameOverScreen').style.display = 'none';\n  }\n\n  function worldToScreen(x, y) {\n    return cam.worldToScreen(x, y);\n  }\n\n  function screenToWorld(sx, sy) {\n    return cam.screenToWorld(sx, sy);\n  }\n\n  function spawnEnemy(type) {\n    const startX = 50;\n    const startY = rand(100, WORLD_H - 100);\n    const e = new Enemy(startX, startY, type, WORLD_W, WORLD_H);\n    enemies.push(e);\n  }\n\n  function tryBuild(ax, ay, bx, by, type) {\n    const cfg = WALL_TYPES[type];\n    if (sandPoints < cfg.cost) {\n      audio.ui(200);\n      return false;\n    }\n    sandPoints -= cfg.cost;\n    sandSpent += cfg.cost;\n    const w = new WallSegment(ax, ay, bx, by, type);\n    walls.push(w);\n    audio.build(Math.min(1, cfg.cost / 20));\n    addSPGain(-cfg.cost);\n    return true;\n  }\n\n  function excavate(x, y) {\n    let removed = 0;\n    for (let i = walls.length - 1; i >= 0; i--) {\n      const w = walls[i];\n      if (w.containsPoint(x, y, 14)) {\n        const refund = Math.floor(w.cost * 0.3 * (w.alive ? w.hp / w.maxHp : 0));\n        sandPoints += refund;\n        addSPGain(refund);\n        walls.splice(i, 1);\n        removed++;\n        for (let j = 0; j < 6; j++) {\n          particles.push(new Particle(x, y, rand(-40, 40), rand(-40, 40), 0.7, '#8B7355', 3, 60));\n        }\n        audio.noiseBurst(0.2, 400, 0.15, 'lowpass');\n      }\n    }\n    return removed > 0;\n  }\n\n  function fireSandBlast(x, y) {\n    const tx = WORLD_W - 200, ty = WORLD_H / 2;\n    let dx = tx - x, dy = ty - y;\n    const d = Math.hypot(dx, dy) || 1;\n    dx /= d; dy /= d;\n    for (let i = 0; i < 5; i++) {\n      const spread = (i - 2) * 0.1;\n      const ca = Math.atan2(dy, dx) + spread;\n      blasts.push(new SandBlast(x, y, Math.cos(ca) * 400, Math.sin(ca) * 400));\n    }\n    audio.blast();\n    cam.shake(8);\n  }\n\n  function addSPGain(amount) {\n    const el = document.getElementById('spGain');\n    el.textContent = (amount > 0 ? '+' : '') + amount;\n    el.style.opacity = '1';\n    el.style.transform = 'translateY(-10px)';\n    setTimeout(() => {\n      el.style.opacity = '0';\n      el.style.transform = 'translateY(-30px)';\n    }, 50);\n  }\n\n  function updateSP() {\n    sandPoints = Math.floor(sandPoints + sandGen * lastDt);\n    sandTotal += sandGen * lastDt;\n  }\n\n  // -------- Input Handling --------\n  canvas.addEventListener('mousemove', (e) => {\n    const r = canvas.getBoundingClientRect();\n    mouse.x = e.clientX - r.left;\n    mouse.y = e.clientY - r.top;\n    const w = screenToWorld(mouse.x, mouse.y);\n    mouse.worldX = w.x; mouse.worldY = w.y;\n    if (builder && builder.dragging) {\n      builder.update(mouse.worldX, mouse.worldY);\n    }\n  });\n  canvas.addEventListener('mousedown', (e) => {\n    audio.init(); audio.resume();\n    if (gameState !== 'playing') return;\n    if (e.button === 0) {\n      mouse.down = true;\n      if (tool === 'excavate') {\n        excavate(mouse.worldX, mouse.worldY);\n      } else {\n        builder.start(mouse.worldX, mouse.worldY);\n      }\n    } else if (e.button === 2) {\n      mouse.rightDown = true;\n      fireSandBlast(mouse.worldX, mouse.worldY);\n    }\n  });\n  canvas.addEventListener('mouseup', (e) => {\n    if (gameState !== 'playing') return;\n    if (e.button === 0 && tool !== 'excavate' && builder.dragging) {\n      const commit = builder.commit();\n      if (commit) {\n        tryBuild(commit.ax, commit.ay, commit.bx, commit.by, commit.type);\n      }\n    }\n    mouse.down = false;\n  });\n  canvas.addEventListener('contextmenu', (e) => e.preventDefault());\n\n  canvas.addEventListener('touchstart', (e) => {\n    audio.init(); audio.resume();\n    if (gameState !== 'playing') return;\n    e.preventDefault();\n    const t = e.touches[0];\n    const r = canvas.getBoundingClientRect();\n    mouse.x = t.clientX - r.left;\n    mouse.y = t.clientY - r.top;\n    const w = screenToWorld(mouse.x, mouse.y);\n    mouse.worldX = w.x; mouse.worldY = w.y;\n    if (tool === 'excavate') {\n      excavate(mouse.worldX, mouse.worldY);\n    } else {\n      builder.start(mouse.worldX, mouse.worldY);\n    }\n  });\n  canvas.addEventListener('touchmove', (e) => {\n    if (gameState !== 'playing') return;\n    e.preventDefault();\n    const t = e.touches[0];\n    const r = canvas.getBoundingClientRect();\n    mouse.x = t.clientX - r.left;\n    mouse.y = t.clientY - r.top;\n    const w = screenToWorld(mouse.x, mouse.y);\n    mouse.worldX = w.x; mouse.worldY = w.y;\n    if (builder && builder.dragging) {\n      builder.update(mouse.worldX, mouse.worldY);\n    }\n  });\n  canvas.addEventListener('touchend', (e) => {\n    if (gameState !== 'playing') return;\n    e.preventDefault();\n    if (tool !== 'excavate' && builder.dragging) {\n      const commit = builder.commit();\n      if (commit) tryBuild(commit.ax, commit.ay, commit.bx, commit.by, commit.type);\n    }\n  });\n\n  canvas.addEventListener('wheel', (e) => {\n    if (gameState !== 'playing') return;\n    e.preventDefault();\n    const zoomDelta = -e.deltaY * 0.001;\n    cam.targetZoom = clamp(cam.targetZoom + zoomDelta, 0.4, 2);\n  }, { passive: false });\n\n  window.addEventListener('keydown', (e) => {\n    if (e.key === ' ') { e.preventDefault(); paused = !paused; document.getElementById('pauseOverlay').style.display = paused ? 'flex' : 'none'; }\n    if (gameState !== 'playing') return;\n    keys[e.key.toLowerCase()] = true;\n    if (e.key === 'Shift') modifier.shift = true;\n    if (e.key === 'Control') modifier.ctrl = true;\n    if (e.key === 'Alt') modifier.alt = true;\n    updateToolFromModifier();\n  });\n  window.addEventListener('keyup', (e) => {\n    keys[e.key.toLowerCase()] = false;\n    if (e.key === 'Shift') modifier.shift = false;\n    if (e.key === 'Control') modifier.ctrl = false;\n    if (e.key === 'Alt') modifier.alt = false;\n    if (gameState === 'playing') updateToolFromModifier();\n  });\n\n  function updateToolFromModifier() {\n    let newTool = 'standard';\n    if (modifier.alt) newTool = 'excavate';\n    else if (modifier.ctrl) newTool = 'quick';\n    else if (modifier.shift) newTool = 'reinforced';\n    tool = newTool;\n    builder.setType(newTool);\n    document.querySelectorAll('.tool').forEach(el => {\n      el.classList.toggle('active', el.dataset.tool === newTool);\n    });\n  }\n\n  document.querySelectorAll('.tool').forEach(el => {\n    el.addEventListener('click', () => {\n      const t = el.dataset.tool;\n      if (t === 'blast') {\n        fireSandBlast(mouse.worldX, mouse.worldY);\n        return;\n      }\n      modifier = { shift: false, ctrl: false, alt: false };\n      tool = t;\n      builder.setType(t);\n      document.querySelectorAll('.tool').forEach(e2 => e2.classList.remove('active'));\n      el.classList.add('active');\n    });\n  });\n\n  document.getElementById('startBtn').addEventListener('click', () => {\n    audio.init(); audio.resume();\n    initGame();\n    document.getElementById('menuHighScore').textContent = highScore;\n  });\n  document.getElementById('restartBtn').addEventListener('click', () => {\n    initGame