  "src/main.js": "class GravityShiftGame {\n    constructor() {\n        this.canvas = document.getElementById('gameCanvas');\n        this.ctx = this.canvas.getContext('2d');\n        \n        // Resize handling\n        this.resizeCanvas();\n        window.addEventListener('resize', () => this.resizeCanvas());\n        \n        // Game constants\n        this.PHASE_DURATION = 5000;\n        this.GRAVITY_STRENGTH = 980;\n        this.JUMP_FORCE = 400;\n        this.MOVE_SPEED = 250;\n        this.FRICTION = 0.85;\n        this.AIR_RESISTANCE = 0.98;\n        this.MAX_FALL_SPEED = 600;\n        \n        // Game state\n        this.state = 'menu'; // menu, playing, gameover, victory\n        this.currentPhase = 0; // 0 = normal, 1 = inverted\n        this.lastShiftTime = 0;\n        this.gameStartTime = 0;\n        this.elapsedTime = 0;\n        this.score = 0;\n        this.highScore = parseInt(localStorage.getItem('gravityShiftHighScore')) || 0;\n        this.health = 100;\n        this.invincible = 0;\n        \n        // Player\n        this.player = {\n            x: 100,\n            y: 300,\n            vx: 0,\n            vy: 0,\n            width: 30,\n            height: 40,\n            onGround: false,\n            jumpsLeft: 2,\n            maxJumps: 2,\n            isCrouching: false,\n            facingRight: true,\n            wallSliding: false,\n            doubleJumpUsed: false,\n            lastJumpTime: 0,\n            jumpCount: 0\n        };\n        \n        // Input\n        this.keys = {};\n        this.touchState = { left: false, right: false, jump: false, crouch: false };\n        \n        // Level elements\n        this.platforms = [];\n        this.spikes = [];\n        this.coins = [];\n        this.particles = [];\n        this.checkpoints = [];\n        this.currentCheckpoint = 0;\n        this.flagX = 0;\n        this.flagY = 0;\n        \n        // Audio\n        this.audioCtx = null;\n        this.initAudio();\n        \n        // Initialize level\n        this.initLevel();\n        \n        // Setup input\n        this.setupInput();\n        \n        // Setup UI\n        this.setupUI();\n        \n        // Start loop\n        this.lastTime = performance.now();\n        this.gameLoop();\n    }\n    \n    resizeCanvas() {\n        const container = document.getElementById('gameContainer');\n        this.canvas.width = container.clientWidth;\n        this.canvas.height = container.clientHeight;\n        this.scale = Math.min(this.canvas.width / 800, this.canvas.height / 600);\n        this.offsetX = (this.canvas.width - 800 * this.scale) / 2;\n        this.offsetY = (this.canvas.height - 600 * this.scale) / 2;\n    }\n    \n    initAudio() {\n        try {\n            this.audioCtx = new (window.AudioContext || window.webkitAudioContext)();\n        } catch (e) {\n            console.log('Audio not supported');\n        }\n    }\n    \n    playSound(type) {\n        if (!this.audioCtx) return;\n        if (this.audioCtx.state === 'suspended') this.audioCtx.resume();\n        \n        const osc = this.audioCtx.createOscillator();\n        const gain = this.audioCtx.createGain();\n        osc.connect(gain);\n        gain.connect(this.audioCtx.destination);\n        \n        const now = this.audioCtx.currentTime;\n        \n        switch(type) {\n            case 'jump':\n                osc.frequency.setValueAtTime(300, now);\n                osc.frequency.exponentialRampToValueAtTime(600, now + 0.1);\n                gain.gain.setValueAtTime(0.3, now);\n                gain.gain.exponentialRampToValueAtTime(0.01, now + 0.1);\n                osc.start(now);\n                osc.stop(now + 0.1);\n                break;\n            case 'land':\n                osc.frequency.setValueAtTime(150, now);\n                osc.frequency.exponentialRampToValueAtTime(50, now + 0.1);\n                gain.gain.setValueAtTime(0.2, now);\n                gain.gain.exponentialRampToValueAtTime(0.01, now + 0.1);\n                osc.start(now);\n                osc.stop(now + 0.1);\n                break;\n            case 'shift':\n                osc.type = 'sine';\n                osc.frequency.setValueAtTime(800, now);\n                osc.frequency.exponentialRampToValueAtTime(400, now + 0.3);\n                gain.gain.setValueAtTime(0.4, now);\n                gain.gain.exponentialRampToValueAtTime(0.01, now + 0.3);\n                osc.start(now);\n                osc.stop(now + 0.3);\n                // Add harmony\n                const osc2 = this.audioCtx.createOscillator();\n                const gain2 = this.audioCtx.createGain();\n                osc2.connect(gain2);\n                gain2.connect(this.audioCtx.destination);\n                osc2.type = 'triangle';\n                osc2.frequency.setValueAtTime(1200, now);\n                osc2.frequency.exponentialRampToValueAtTime(600, now + 0.3);\n                gain2.gain.setValueAtTime(0.2, now);\n                gain2.gain.exponentialRampToValueAtTime(0.01, now + 0.3);\n                osc2.start(now);\n                osc2.stop(now + 0.3);\n                break;\n            case 'coin':\n                osc.type = 'sine';\n                osc.fole('sine');\n                osc.frequency.setValueAtTime(800, now);\n                osc.frequency.exponentialRampToValueAtTime(1200, now + 0.05);\n                osc.frequency.exponentialRampToValueAtTime(1000, now + 0.15);\n                gain.gain.setValueAtTime(0.2, now);\n                gain.gain.exponentialRampToValueAtTime(0.01, now + 0.2);\n                osc.start(now);\n                osc.stop(now + 0.2);\n                break;\n            case 'death':\n                osc.type = 'sawtooth';\n                osc.frequency.setValueAtTime(400, now);\n                osc.frequency.exponentialRampToValueAtTime(50, now + 0.5);\n                gain.gain.setValueAtTime(0.3, now);\n                gain.gain.exponentialRampToValueAtTime(0.01, now + 0.5);\n                osc.start(now);\n                osc.stop(now + 0.5);\n                break;\n            case 'victory':\n                osc.type = 'sine';\n                [523, 659, 784, 1047].forEach((freq, i) => {\n                    osc.frequency.setValueAtTime(freq, now + i * 0.15);\n                });\n                gain.gain.setValueAtTime(0.3, now);\n                gain.gain.exponentialRampToValueAtTime(0.01, now + 0.7);\n                osc.start(now);\n                osc.stop(now + 0.7);\n                break;\n        }\n    }\n    \n    setupInput() {\n        window.addEventListener('keydown', (e) => {\n            this.keys[e.code] = true;\n            if (e.code === 'Space' || e.code === 'ArrowUp' || e.code === 'ArrowDown') {\n                e.preventDefault();\n            }\n        });\n        window.addEventListener('keyup', (e) => {\n            this.keys[e.code] = false;\n        });\n        \n        // Touch controls\n        const setupTouch = (id, key) => {\n            const btn = document.getElementById(id);\n            if (!btn) return;\n            btn.addEventListener('touchstart', (e) => { e.preventDefault(); this.touchState[key] = true; });\n            btn.addEventListener('touchend', (e) => { e.preventDefault(); this.touchState[key] = false; });\n            btn.addEventListener('mousedown', () => this.touchState[key] = true);\n            btn.addEventListener('mouseup', () => this.touchState[key] = false);\n            btn.addEventListener('mouseleave', () => this.touchState[key] = false);\n        };\n        setupTouch('leftBtn', 'left');\n        setupTouch('rightBtn', 'right');\n        setupTouch('jumpBtn', 'jump');\n        setupTouch('crouchBtn', 'crouch');\n    }\n    \n    setupUI() {\n        document.getElementById('startBtn').addEventListener('click', () => this.startGame());\n        document.getElementById('restartBtn').addEventListener('click', () => this.startGame());\n        document.getElementById('playAgainBtn').addEventListener('click', () => this.startGame());\n        document.getElementById('highScore').textContent = this.highScore;\n    }\n    \n    initLevel() {\n        // Platforms: [x, y, width, height]\n        this.platforms = [\n            // Ground\n            [0, 550, 400, 50],\n            [500, 550, 300, 50],\n            [900, 550, 400, 50],\n            // Platforms\n            [150, 440, 120, 20],\n            [350, 360, 120, 20],\n            [550, 300, 120, 20],\n            [750, 380, 120, 20],\n            [200, 250, 100, 20],\n            [450, 200, 100, 20],\n            [650, 150, 100, 20],\n            [850, 220, 100, 20],\n            [50, 350, 80, 20],\n            // Wall jumps\n            [0, 200, 30, 200],\n            [1170, 200, 30, 200],\n        ];\n        \n        // Spikes: [x, y, width]\n        this.spikes = [\n            [400, 540, 100],\n            [800, 540, 50],\n            [350, 350, 30],\n            [650, 140, 30],\n        ];\n        \n        // Coins: [x, y]\n        this.coins = [\n            [200, 410], [400, 330], [600, 270], [800, 350],\n            [240, 220], [500, 170], [700, 120], [900, 190],\n            [80, 320],\n        ];\n        \n        // Checkpoints\n        this.checkpoints = [\n            { x: 400, y: 530, activated: false },\n            { x: 800, y: 530, activated: false },\n            { x: 1000, y: 530, activated: false },\n        ];\n        this.currentCheckpoint = 0;\n        \n        // Flag (goal)\n        this.flagX = 1100;\n        this.flagY = 510;\n    }\n    \n    startGame() {\n        this.state = 'playing';\n        this.gameStartTime = performance.now();\n        this.elapsedTime = 0;\n        this.score = 0;\n        this.health = 100;\n        this.invincible = 0;\n        this.currentPhase = 0;\n        this.lastShiftTime = performance.now();\n        \n        // Reset player\n        this.player.x = 100;\n        this.player.y = 300;\n        this.player.vx = 0;\n        this.player.vy = 0;\n        this.player.onGround = false;\n        this.player.jumpsLeft = 2;\n        this.player.isCrouching = false;\n        this.player.doubleJumpUsed = false;\n        \n        // Reset coins and checkpoints\n        this.coins.forEach(c => c.collected = false);\n        this.checkpoints.forEach(c => c.activated = false);\n        this.currentCheckpoint = 0;\n        this.particles = [];\n        \n        document.getElementById('startScreen').classList.add('hidden');\n        document.getElementById('gameOverScreen').classList.add('hidden');\n        document.getElementById('victoryScreen').classList.add('hidden');\n        \n        this.updateHUD();\n    }\n    \n    updateHUD() {\n        const mins = Math.floor(this.elapsedTime / 60000);\n        const secs = Math.floor((this.elapsedTime % 60000) / 1000);\n        const ms = Math.floor((this.elapsedTime % 1000) / 10);\n        document.getElementById('speedrunTime').textContent = \n            `${String(mins).padStart(2,'0')}:${String(secs).padStart(2,'0')}.${String(ms).padStart(2,'0')}`;\n        document.getElementById('score').textContent = this.score;\n        document.getElementById('highScore').textContent = this.highScore;\n        document.getElementById('speed').textContent = Math.floor(Math.sqrt(this.player.vx**2 + this.player.vy**2));\n        document.getElementById('phaseText').textContent = this.currentPhase === 0 ? 'NORMAL' : 'INVERTED';\n        document.getElementById('phaseIndicator').className = this.currentPhase === 1 ? 'inverted' : '';\n        document.getElementById('healthFill').style.width = this.health + '%';\n        \n        const shiftIn = Math.max(0, (this.PHASE_DURATION - (performance.now() - this.lastShiftTime)) / 1000);\n        document.getElementById('shiftTimer').textContent = shiftIn.toFixed(1);\n    }\n    \n    triggerShift() {\n        this.currentPhase = 1 - this.currentPhase;\n        this.lastShiftTime = performance.now();\n        this.playSound('shift');\n        \n        // Show warning\n        const warning = document.getElementById('shiftWarning');\n        warning.classList.remove('hidden');\n        warning.querySelector('.shift-flash').style.animation = 'none';\n        warning.querySelector('.shift-text').style.animation = 'none';\n        void warning.offsetWidth;\n        warning.querySelector('.shift-flash').style.animation = '';\n        warning.querySelector('.shift-text').style.animation = '';\n        setTimeout(() => warning.classList.add('hidden'), 800);\n        \n        // Apply gravity flip effect\n        this.player.vy = this.currentPhase === 0 ? -this.JUMP_FORCE * 0.5 : this.JUMP_FORCE * 0.5;\n        \n        // Spawn shift particles\n        for (let i = 0; i < 30; i++) {\n            this.particles.push({\n                x: this.player.x + this.player.width/2,\n                y: this.player.y + this.player.height/2,\n                vx: (Math.random() - 0.5) * 400,\n                vy: (Math.random() - 0.5) * 400,\n                life: 1,\n                color: this.currentPhase === 0 ? '#00ffff' : '#ff00ff',\n                size: Math.random() * 6 + 2\n            });\n        }\n    }\n    \n    update(dt) {\n        if (this.state !== 'playing') return;\n        \n        const p = this.player;\n        const gravity = this.currentPhase === 0 ? this.GRAVITY_STRENGTH : -this.GRAVITY_STRENGTH;\n        \n        // Check for phase shift\n        if (performance.now() - this.lastShiftTime >= this.PHASE_DURATION) {\n            this.triggerShift();\n        }\n        \n        // Input\n        const moveLeft = this.keys['ArrowLeft'] || this.keys['KeyA'] || this.touchState.left;\n        const moveRight = this.keys['ArrowRight'] || this.keys['KeyD'] || this.touchState.right;\n        const jumpPressed = this.keys['Space'] || this.keys['ArrowUp'] || this.keys['KeyW'] || this.touchState.jump;\n        const crouchPressed = this.keys['ArrowDown'] || this.keys['KeyS'] || this.touchState.crouch;\n        \n        // Crouching\n        p.isCrouching = crouchPressed && p.onGround;\n        if (p.isCrouching) {\n            p.height = 20;\n            p.y += 20;\n        } else if (p.height === 20) {\n            p.height = 40;\n            p.y -= 20;\n        }\n        \n        // Horizontal movement\n        if (moveLeft) {\n            p.vx = -this.MOVE_SPEED;\n            p.facingRight = false;\n        } else if (moveRight) {\n            p.vx = this.MOVE_SPEED;\n            p.facingRight = true;\n        } else {\n            p.vx *= p.onGround ? this.FRICTION : this.AIR_RESISTANCE;\n        }\n        \n        // Jump\n        if (jumpPressed && performance.now() - p.lastJumpTime > 200) {\n            if (p.jumpsLeft > 0) {\n                p.vy = this.currentPhase === 0 ? -this.JUMP_FORCE : this.JUMP_FORCE;\n                p.jumpsLeft--;\n                p.lastJumpTime = performance.now();\n                p.onGround = false;\n                this.playSound('jump');\n                \n                // Jump particles\n                for (let i = 0; i < 8; i++) {\n                    this.particles.push({\n                        x: p.x + p.width/2,\n                        y: p.y + (this.currentPhase === 0 ? p.height : 0),\n                        vx: (Math.random() - 0.5) * 150,\n                        vy: this.currentPhase === 0 ? 100 : -100,\n                        life: 0.5,\n                        color: '#ffff00',\n                        size: 3\n                    });\n                }\n            }\n        }\n        \n        // Gravity\n        p.vy += gravity * dt;\n        p.vy = Math.max(-this.MAX_FALL_SPEED, Math.min(this.MAX_FALL_SPEED, p.vy));\n        \n        // Move and collide\n        // Horizontal\n        p.x += p.vx * dt;\n        this.handleCollision('horizontal');\n        \n        // Vertical\n        const prevOnGround = p.onGround;\n        p.y += p.vy * dt;\n        p.onGround = false;\n        this.handleCollision('vertical');\n        \n        // Landing detection\n        if (p.onGround && !prevOnGround) {\n            this.playSound('land');\n            for (let i = 0; i < 5; i++) {\n                this.particles.push({\n                    x: p.x + p.width/2,\n                    y: p.y + p.height,\n                    vx: (Math.random() - 0.5) * 100,\n                    vy: -50,\n                    life: 0.3,\n                    color: '#aaa',\n                    size: 3\n                });\n            }\n        }\n        \n        // Wall sliding\n        p.wallSliding = false;\n        if (!p.onGround && Math.abs(p.vy) > 50) {\n            // Check if touching wall\n            for (const plat of this.platforms) {\n                const [px, py, pw, ph] = plat;\n                if (p.x + p.width >= px && p.x <= px + 5 && p.y + p.height > py && p.y < py + ph && p.vx !== 0) {\n                    p.wallSliding = true;\n                    p.vy = Math.sign(p.vy) * 50; // Slow fall\n                    break;\n                }\n            }\n        }\n        \n        // Bounds\n        if (p.x < 0) p.x = 0;\n        if (p.x + p.width > 1200) p.x = 1200 - p.width;\n        if (this.currentPhase === 0 && p.y + p.height > 600) { p.y = 600 - p.height; p.vy = 0; }\n        if (this.currentPhase === 1 && p.y < 0) { p.y = 0; p.vy = 0; }\n        \n        // Spikes\n        if (this.invincible <= 0) {\n            for (const spike of this.spikes) {\n                const [sx, sy, sw] = spike;\n                if (p.x + p.width > sx && p.x < sx + sw && p.y + p.height > sy - 10 && p.y < sy + 10) {\n                    this.takeDamage(25);\n                    break;\n                }\n            }\n        }\n        \n        // Coins\n        for (const coin of this.coins) {\n            if (!coin.collected) {\n                const dx = (p.x + p.width/2) - coin.x;\n                const dy = (p.y + p.height/2) - coin.y;\n                if (Math.sqrt(dx*dx + dy*dy) < 25) {\n                    coin.collected = true;\n                    this.score += 100;\n                    this.playSound('coin');\n                    for (let i = 0; i < 10; i++) {\n                        this.particles.push({\n                            x: coin.x, y: coin.y,\n                            vx: (Math.random() - 0.5) * 200,\n                            vy: (Math.random() - 0.5) * 200,\n                            life: 0.5,\n                            color: '#ffff00',\n                            size: 4\n                        });\n                    }\n                }\n            }\n        }\n        \n        // Checkpoints\n        for (let i = 0; i < this.checkpoints.length; i++) {\n            const cp = this.checkpoints[i];\n            if (!cp.activated) {\n                const dx = (p.x + p.width/2) - cp.x;\n                const dy = (p.y + p.height/2) - cp.y;\n                if (Math.sqrt(dx*dx + dy*dy) < 30) {\n                    cp.activated = true;\n                    this.currentCheckpoint = i + 1;\n                    this.score += 50;\n                    for (let j = 0; j < 15; j++) {\n                        this.particles.push({\n                            x: cp.x, y: cp.y,\n                            vx: (Math.random() - 0.5) * 150,\n                            vy: (Math.random() - 0.5) * 150,\n                            life: 0.6,\n                            color: '#39ff14',\n                            size: 5\n                        });\n                    }\n                }\n            }\n        }\n        \n        // Victory flag\n        const fdx = (p.x + p.width/2) - this.flagX;\n        const fdy = (p.y + p.height/2) - this.flagY;\n        if (Math.sqrt(fdx*fdx + fdy*fdy) < 30) {\n            this.victory();\n        }\n        \n        // Fall off screen\n        if (this.currentPhase === 0 && p.y > 700 || this.currentPhase === 1 && p.y < -100) {\n            this.takeDamage(100);\n        }\n        \n        // Invincibility timer\n        if (this.invincible > 0) this.invincible -= dt * 1000;\n        \n        // Update particles\n        this.particles = this.particles.filter(part => {\n            part.x += part.vx * dt;\n            part.y += part.vy * dt;\n            part.life -= dt * 2;\n            return part.life > 0;\n        });\n        \n        // Score over time\n        this.score += dt * 10;\n        \n        this.updateHUD();\n    }\n    \n    handleCollision(dir) {\n        const p = this.player;\n        for (const plat of this.platforms) {\n            const [px, py, pw, ph] = plat;\n            if (p.x < px + pw && p.x + p.width > px && p.y < py + ph && p.y + p.height > py) {\n                if (dir === 'horizontal') {\n                    if (p.vx > 0) {\n                        p.x = px - p.width;\n                    } else if (p.vx < 0) {\n                        p.x = px + pw;\n                    }\n                    p.vx = 0;\n                } else {\n                    if (p.vy > 0) {\n                        p.y = py - p.height;\n                        p.vy = 0;\n                        p.onGround = true;\n                        p.jumpsLeft = p.maxJumps;\n                        p.doubleJumpUsed = false;\n                    } else if (p.vy < 0) {\n                        p.y = py + ph;\n                        p.vy = 0;\n                    }\n                }\n            }\n        }\n    }\n    \n    takeDamage(amount) {\n        if (this.invincible > 0) return;\n        this.health -= amount;\n        this.invincible = 1000;\n        this.playSound('death');\n        \n        // Damage particles\n        for (let i = 0; i < 15; i++) {\n            this.particles.push({\n                x: this.player.x + this.player.width/2,\n                y: this.player.y + this.player.height/2,\n                vx: (Math.random() - 0.5) * 300,\n                vy: (Math.random() - 0.5) * 300,\n                life: 0.8,\n                color: '#ff3333',\n                size: 4\n            });\n        }\n        \n        if (this.health <= 0) {\n            this.health = 0;\n            this.gameOver();\n        }\n    }\n    \n    gameOver() {\n        this.state = 'gameover';\n        const mins = Math.floor(this.elapsedTime / 60000);\n        const secs = Math.floor((this.elapsedTime % 60000) / 1000);\n        const ms = Math.floor((this.elapsedTime % 1000) / 10);\n        document.getElementById('finalTime').textContent = \n            `${String(mins).padStart(2,'0')}:${String(secs).padStart(2,'0')}.${String(ms).padStart(2,'0')}`;\n        document.getElementById('finalScore').textContent = Math.floor(this.score);\n        document.getElementById('gameOverScreen').classList.remove('hidden');\n    }\n    \n    victory() {\n        this.state = 'victory';\n        this.playSound('victory');\n        \n        if (this.score > this.highScore) {\n            this.highScore = Math.floor(this.score);\n            localStorage.setItem('gravityShiftHighScore', this.highScore);\n        }\n        \n        const mins = Math.floor(this.elapsedTime / 60000);\n        const secs = Math.floor((this.elapsedTime % 60000) / 1000);\n        const ms = Math.floor((this.elapsedTime % 1000) / 10);\n        document.getElementById('victoryTime').textContent = \n            `${String(mins).padStart(2,'0')}:${String(secs).padStart(2,'0')}.${String(ms).padStart(2,'0')}`;\n        document.getElementById('victoryScreen').classList.remove('hidden');\n    }\n    \n    render() {\n        const ctx = this.ctx;\n        ctx.clearRect(0, 0, this.canvas.width, this.canvas.height);\n        \n        ctx.save();\n        ctx.translate(this.offsetX, this.offsetY);\n        ctx.scale(this.scale, this.scale);\n        \n        // Background gradient based on phase\n        const bgGrad = ctx.createLinearGradient(0, 0, 0, 600);\n        if (this.currentPhase === 0) {\n            bgGrad.addColorStop(0, '#0a0a23');\n            bgGrad.addColorStop(0.5, '#1a1a3e');\n            bgGrad.addColorStop(1, '#0a0a23');\n        } else {\n            bgGrad.addColorStop(0, '#230a0a');\n            bgGrad.addColorStop(0.5, '#3e1a1a');\n            bgGrad.addColorStop(1, '#230a0a');\n        }\n        ctx.fillStyle = bgGrad;\n        ctx.fillRect(0, 0, 1200, 600);\n        \n        // Stars\n        ctx.fillStyle = 'rgba(255,255,255,0.3)';\n        for (let i = 0; i < 50; i++) {\n            const sx = (i * 97 + 13) % 1200;\n            const sy = (i * 53 + 7) % 600;\n            ctx.fillRect(sx, sy, 1, 1);\n        }\n        \n        // Platforms\n        for (const plat of this.platforms) {\n            const [px, py, pw, ph] = plat;\n            ctx.fillStyle = this.currentPhase === 0 ? '#00ffff' : '#ff00ff';\n            ctx.globalAlpha = 0.7;\n            ctx.fillRect(px, py, pw, ph);\n            ctx.globalAlpha = 1;\n            ctx.strokeStyle = this.currentPhase === 0 ? '#00cccc' : '#cc00cc';\n            ctx.lineWidth = 2;\n            ctx.strokeRect(px, py, pw, ph);\n        }\n        \n        // Spikes\n        for (const spike of this.spikes) {\n            const [sx, sy, sw] = spike;\n            ctx.fillStyle = '#ff3333';\n            const spikeW = 10;\n            for (let i = 0; i < sw; i += spikeW * 2) {\n                ctx.beginPath();\n                ctx.moveTo(sx + i, sy);\n                ctx.lineTo(sx + i + spikeW, sy - 15);\n                ctx.lineTo(sx + i + spikeW * 2, sy);\n                ctx.fill();\n            }\n        }\n        \n        // Coins\n        for (const coin of this.coins) {\n            if (!coin.collected) {\n                ctx.fillStyle = '#ffff00';\n                ctx.beginPath();\n                ctx.arc(coin.x, coin.y, 8, 0, Math.PI * 2);\n                ctx.fill();\n                ctx.strokeStyle = '#ccbb00';\n                ctx.lineWidth = 2;\n                ctx.stroke();\n                // Glow\n                ctx.shadowColor = '#ffff00';\n                ctx.shadowBlur = 10;\n                ctx.beginPath();\n                ctx.arc(coin.x, coin.y, 5, 0, Math.PI * 2);\n                ctx.fill();\n                ctx.shadowBlur = 0;\n            }\n        }\n        \n        // Checkpoints\n        for (const cp of this.checkpoints) {\n            ctx.fillStyle = cp.activated ? '#39ff14' : '#666';\n            ctx.fillRect(cp.x - 2, cp.y - 30, 4, 30);\n            ctx.fillStyle = cp.activated ? '#39ff14' : '#444';\n            ctx.beginPath();n            ctx.moveTo(cp.x + 2, cp.y - 30);\n            ctx.lineTo(cp.x + 20, cp.y - 22);\n            ctx.lineTo(cp.x + 2, cp.y - 14);\n            ctx.fill();\n        }\n        \n        // Flag\n        ctx.fillStyle = '#39ff14';\n        ctx.fillRect(this.flagX - 2, this.flagY - 60, 4, 60);\n        ctx.fillStyle = '#00ff88';\n        ctx.beginPath();\n        ctx.moveTo(this.flagX + 2, this.flagY - 60);\n        ctx.lineTo(this.flagX + 30, this.flagY - 50);\n        ctx.lineTo(this.flagX + 2, this.flagY - 40);\n        ctx.fill();\n        \n        // Particles\n        for (const part of this.particles) {\n            ctx.globalAlpha = part.life;\n            ctx.fillStyle = part.color;\n            ctx.fillRect(part.x - part.size/2, part.y - part.size/2, part.size, part.size);\n        }\n        ctx.globalAlpha = 1;\n        \n        // Player\n        const p = this.player;\n        const blink = this.invincible > 0 && Math.floor(this.invincible / 100) % 2 === 0;\n        if (!blink) {\n            ctx.fillStyle = this.currentPhase === 0 ? '#00ffff' : '#ff00ff';\n            ctx.fillRect(p.x, p.y, p.width, p.height);\n            \n            // Eyes\n            ctx.fillStyle = '#fff';\n            const eyeY = this.currentPhase === 0 ? p.y + 8 : p.y + p.height - 14;\n            if (p.facingRight) {\n                ctx.fillRect(p.x + 18, eyeY, 5, 5);\n                ctx.fillRect(p.x + 8, eyeY, 5, 5);\n            } else {\n                ctx.fillRect(p.x + 2, eyeY, 5, 5);\n                ctx.fillRect(p.x + 12, eyeY, 5, 5);\n            }\n            \n            // Outline\n            ctx.strokeStyle = '#fff';\n            ctx.lineWidth = 2;\n            ctx.strokeRect(p.x, p.y, p.width, p.height);\n        }\n        \n        // Gravity indicator arrow\n        ctx.fillStyle = this.currentPhase === 0 ? '#00ffff' : '#ff00ff';\n        ctx.globalAlpha = 0.5;\n        const arrowX = 50;\n        const arrowY = this.currentPhase === 0 ? 550 : 50;\n        ctx.beginPath();\n        if (this.currentPhase === 0) {\n            ctx.moveTo(arrowX, arrowY);\n            ctx.lineTo(arrowX - 10, arrowY + 20);\n            ctx.lineTo(arrowX + 10, arrowY + 20);\n        } else {\n            ctx.moveTo(arrowX, arrowY);\n            ctx.lineTo(arrowX - 10, arrowY - 20);\n            ctx.lineTo(arrowX + 10, arrowY - 20);\n        }\n        ctx.fill();\n        ctx.globalAlpha = 1;\n        \n        ctx.restore();\n    }\n    \n    gameLoop() {\n        const now = performance.now();\n        const dt = Math.min((now - this.lastTime) / 1000, 0.05);\n        this.lastTime = now;\n        \n        if (this.state === 'playing') {\n            this.elapsedTime = now - this.gameStartTime;\n        }\n        \n        this.update(dt);\n        this.render();\n        \n        requestAnimationFrame(() => this.gameLoop());\n    }\n}\n\n// Start the game\nnew GravityShiftGame();\n\n</answer>