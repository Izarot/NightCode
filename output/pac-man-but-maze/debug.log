Now Game class:


class Game {
    constructor() {
        this.player = new Player(CANVAS_WIDTH/2, CANVAS_HEIGHT/2);
        this.ghosts = [];
        this.pellets = [];
        this.powerPellets = [];
        this.maze = new BreathingMaze();
        this.lastTime = 0;
        this.gameOver = false;
        this.win = false;
        this.initEntities();
    }
    
    initEntities() {
        // Create ghosts at spawn points
        const ghostSpawns = [[5,5],[15,5],[5,15],[15,15]];
        const colors = [COLORS.ghostPink, COLORS.ghostBlue, COLORS.ghostGreen, COLORS.ghostRed];
        for (let i = 0; i < 4; i++) {
            const [col, row] = ghostSpawns[i];
            this.ghosts.push(new Ghost(col*TILE_SIZE+TILE_SIZE/2, row*TILE_SIZE+TILE_SIZE/2, colors[i]));
        }
        
        // Create pellets
        for (let r = 0; r < MAZE_ROWS; r++) {
            for (let c = 0; c < MAZE_COLS; c++) {
                if (this.maze.isWall(c, r)) continue;
                if (this.maze.isExit(c, r)) continue;
                // Skip power pellets area
                if (c >= 8 && c <= 12 && r >= 8 && r <= 12) continue;
                this.pellets.push(new Pellet(c, r));
            }
        }
        
        // Create power pellets
        for (let r = 0; r < MAZE_ROWS; r++) {
            for (let c = 0; c < MAZE_COLS; c++) {
                if (this.maze.isWall(c, r)) continue;
                if (this.maze.isExit(c, r)) continue;
                if (c >= 8 && c <= 12 && r >= 8 && r <= 12) {
                    this.powerPellets.push(new PowerPellet(c, r));
                }
            }
        }
    }
    
    update(deltaTime) {
        if (!gameState.running || this.gameOver) return;
        
        this.maze.update(deltaTime);
        this.player.update(this.maze, deltaTime);
        this.ghosts.forEach(g => g.update(this.maze, deltaTime, this.player));
        
        // Check pellet collection
        this.checkCollisions();
        
        // Power mode timer
        if (gameState.powerMode) {
            gameState.powerTimer -= deltaTime * 1000;
            if (gameState.powerTimer <= 0) {
                gameState.powerMode = false;
                document.getElementById('power-indicator').classList.remove('active');
            }
        }
        
        // Time left
        gameState.timeLeft -= deltaTime;
        document.getElementById('timer').textContent = Math.ceil(gameState.timeLeft);
        if (gameState.timeLeft <= 0) {
            endGame(false);
        }
        
        // Win condition: all pellets eaten
        const remaining = this.pellets.filter(p => !p.eaten).length;
        if (remaining === 0) {
            endGame(true);
        }
    }
    
    checkCollisions() {
        // Player vs pellets
        for (const pellet of this.pellets) {
            if (pellet.eaten) continue;
            const dist = distance(this.player.x, this.player.y, pellet.x, pellet.y);
            if (dist < this.player.radius + 4) {
                pellet.eaten = true;
                gameState.score += 10;
                document.getElementById('score').textContent = gameState.score;
                playSound('eat', 600, 0.05, 0.2);
            }
        }
        
        // Player vs power pellets
        for (const pp of this.powerPellets) {
            if (pp.eaten) continue;
            const dist = distance(this.player.x, this.player.y, pp.x, pp.y);
            if (dist < this.player.radius + 8) {
                pp.eaten = true;
                gameState.score += 50;
                gameState.powerMode = true;
                gameState.powerTimer = POWER_DURATION;
                document.getElementById('power-indicator').classList.add('active');
                playSound('power', 800, 0.3, 0.4);
            }
        }
        
        // Player vs ghosts
        for (const ghost of this.ghosts) {
            const dist = distance(this.player.x, this.player.y, ghost.x, ghost.y);
            if (dist < this.player.radius + ghost.radius) {
                if (gameState.powerMode) {
                    // Ghost frightened
                    ghost.frightened = true;
                    ghost.frightenedTimer = 3; // seconds
                    gameState.score += 200;
                    document.getElementById('score').textContent = gameState.score;
                    playSound('eat', 400, 0.1, 0.3);
                } else {
                    // Death
                    this.die();
                    return;
                }
            }
        }
    }
    
    die() {
        gameState.lives--;
        document.getElementById('lives').textContent = gameState.lives;
        playSound('death', 200, 0.5, 0.4);
        if (gameState.lives <= 0) {
            endGame(false);
        } else {
            // Respawn
            this.player.x = CANVAS_WIDTH/2;
            this.player.y = CANVAS_HEIGHT/2;
            this.ghosts.forEach(g => {
                g.x = g.homeX;
                g.y = g.homeY;
                g.frightened = false;
            });
        }
    }
    
    render() {
        ctx.clearRect(0, 0, CANVAS_WIDTH, CANVAS_HEIGHT);
        this.drawMaze();
        this.drawPellets();
        this.drawPowerPellets();
        this.drawPlayer();
        this.drawGhosts();
        this.drawEffects();
    }
    
    drawMaze() {
        for (let r = 0; r < MAZE_ROWS; r++) {
            for (let c = 0; c < MAZE_COLS; c++) {
                if (this.maze.isWall(c, r)) {
                    ctx.fillStyle = this.maze.getWallColor();
                    ctx.fillRect(c*TILE_SIZE, r*TILE_SIZE, TILE_SIZE, TILE_SIZE);
                }
            }
        }
        // Draw exit
        ctx.fillStyle = COLORS.exit;
        ctx.fillRect((MAZE_COLS-1)*TILE_SIZE, (MAZE_ROWS-1)*TILE_SIZE, TILE_SIZE, TILE_SIZE);
    }
    
    drawPellets() {
        ctx.fillStyle = COLORS.pellet;
        for (const pellet of this.pellets) {
            if (pellet.eaten) continue;
            ctx.beginPath();
            ctx.arc(pellet.x, pellet.y, 3, 0, Math.PI*2);
            ctx.fill();
        }
    }
    
    drawPowerPellets() {
        ctx.fillStyle = COLORS.pelletGlow;
        for (const pp of this.powerPellets) {
            if (pp.eaten) continue;
            ctx.beginPath();
            ctx.arc(pp.x, pp.y, 8, 0, Math.PI*2);
            ctx.fill();
        }
    }
    
    drawPlayer() {
        ctx.save();
        ctx.translate(this.player.x, this.player.y);
        // Draw pacman shape
        const angle = Math.atan2(this.player.vy, this.player.vx);
        ctx.rotate(angle);
        ctx.beginPath();
        ctx.arc(0, 0, this.player.radius, 0.2 * Math.PI, 1.8 * Math.PI);
        ctx.lineTo(0, 0);
        ctx.closePath();
        ctx.fillStyle = COLORS.pacman;
        ctx.fill();
        ctx.strokeStyle = COLORS.pacmanOutline;
        ctx.lineWidth = 2;
        ctx.stroke();
        ctx.restore();
    }
    
    drawGhosts() {
        for (const ghost of this.ghosts) {
            ctx.save();
            ctx.translate(ghost.x, ghost.y);
            // Body
            ctx.beginPath();
            ctx.arc(0, -2, ghost.radius, Math.PI, 0);
            ctx.lineTo(ghost.radius, ghost.radius);
            // Wavy bottom
            for (let i = 0; i < 3; i++) {
                ctx.quadraticCurveTo(ghost.radius - (i+1)*4, ghost.radius + 4, ghost.radius - (i+1)*4, ghost.radius);
            }
            ctx.closePath();
            ctx.fillStyle = ghost.frightened ? '#FFFFFF' : ghost.color;
            ctx.fill();
            // Eyes
            ctx.fillStyle = '#FFFFFF';
            ctx.beginPath();
            ctx.arc(-4, -4, 3, 0, Math.PI*2);
            ctx.arc(4, -4, 3, 0, Math.PI*2);
            ctx.fill();
            ctx.fillStyle = '#000000';
            ctx.beginPath();
            ctx.arc(-4, -4, 1.5, 0, Math.PI*2);
            ctx.arc(4, -4, 1.5, 0, Math.PI*2);
            ctx.fill();
            ctx.restore();
        }