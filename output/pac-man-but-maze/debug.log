class Ghost extends Entity {
    constructor(x, y, color) {
        super(x, y);
        this.color = color;
        this.speed = GHOST_BASE_SPEED;
        this.state = 'chase';
        this.frightened = false;
        this.frightenedTimer = 0;
        this.homeX = x;
        this.homeY = y;
        this.scatterTarget = null;
        this.scatterTimer = 0;
        this.changeDirTimer = 0;
    }
    
    update(maze, deltaTime, player) {
        if (this.frightened) {
            this.frightenedTimer -= deltaTime;
            if (this.frightenedTimer <= 0) {
                this.frightened = false;
            }
            // Move randomly
            this.vx = (Math.random() - 0.5) * this.speed;
            this.vy = (Math.random() - 0.5) * this.speed;
        } else {
            // Simple AI: chase player, but avoid walls
            // Determine direction towards player
            const dx = player.x - this.x;
            const dy = player.y - this.y;
            const dist = Math.sqrt(dx*dx + dy*dy);
            if (dist < 100) {
                // Chase
                if (Math.abs(dx) > Math.abs(dy)) {
                    this.vx = dx / dist * this.speed;
                    this.vy = 0;
                } else {
                    this.vx = 0;
                    this.vy = dy / dist * this.speed;
                }
            } else {
                // Wander
                this.vx = (Math.random() - 0.5) * this.speed;
                this.vy = (Math.random() - 0.5) * this.speed;
            }
        }
        this.move(maze, deltaTime);
    }
}


