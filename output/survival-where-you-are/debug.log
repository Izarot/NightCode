<body>
<canvas id="gameCanvas"></canvas>

<div id="hud">
  <div id="survival-gauges">
    <div class="gauge-row">
      <div class="gauge-circle"><canvas id="hungerCanvas" width="84" height="84"></canvas><span class="gauge-pct" id="hungerPct">100%</span></div>
      <span class="gauge-label" style="color:#FF6B6B">Hunger</span>
    </div>
    <div class="gauge-row">
      <div class="gauge-circle"><canvas id="thirstCanvas" width="84" height="84"></canvas><span class="gauge-pct" id="thirstPct">100%</span></div>
      <span class="gauge-label" style="color:#00E5FF">Thirst</span>
    </div>
    <div class="gauge-row">
      <div class="gauge-circle"><canvas id="healthCanvas" width="84" height="84"></canvas><span class="gauge-pct" id="healthPct">100%</span></div>
      <span class="gauge-label" style="color:#06D6A0">Health</span>
    </div>
    <div class="gauge-row">
      <div class="gauge-circle"><canvas id="energyCanvas" width="84" height="84"></canvas><span class="gauge-pct" id="energyPct">100%</span></div>
      <span class="gauge-label" style="color:#FFB700">Energy</span>
    </div>
  </div>
  <div id="timer">Day <span id="dayNum">1</span> · <span id="timeNum">06:00</span></div>
  <canvas id="compass" width="120" height="120"></canvas>
</div>

<div id="hotbar">
  <div class="hotbar-slot active" data-slot="0"><span class="slot-key">1</span><span class="slot-icon"></span><span class="slot-count"></span></div>
  <div class="hotbar-slot" data-slot="1"><span class="slot-key">2</span><span class="slot-icon"></span><span class="slot-count"></span></div>
  <div class="hotbar-slot" data-slot="2"><span class="slot-key">3</span><span class="slot-icon"></span><span class="slot-count"></span></div>
  <div class="hotbar-slot" data-slot="3"><span class="slot-key">4</span><span class="slot-icon"></span><span class="slot-count"></span></div>
  <div class="hotbar-slot" data-slot="4"><span class="slot-key">5</span><span class="slot-icon"></span><span class="slot-count"></span></div>
</div>

<div id="notifications"></div>

<div id="menu-screen">
  <h1>⚓ Project Drift</h1>
  <div class="sub">Ocean Survival</div>
  <button class="menu-btn" onclick="startGame()">Start Survival</button>
  <button class="menu-btn secondary" onclick="showInstructions()">How to Play</button>
</div>

<div id="gameover-screen">
  <h2>You Drifted Away</h2>
  <div class="final-score">Score: <span id="finalScore">0</span></div>
  <div class="high-score">Best: <span id="highScore">0</span></div>
  <button class="menu-btn" onclick="startGame()">Try Again</button>
  <button class="menu-btn secondary" onclick="goToMenu()">Main Menu</button>
</div>

<div class="crafting-overlay" id="crafting-overlay">
  <div class="crafting-panel">
    <button class="craft-close" onclick="closeCrafting()">✕</button>
    <h3>⚙️ Crafting</h3>
    <div class="crafting-grid" id="craftingGrid"></div>
  </div>
</div>

<div id="pause-screen">
  <div class="pause-box">
    <h2>Paused</h2>
    <button class="menu-btn" onclick="resumeGame()">Resume</button><br>
    <button class="menu-btn secondary" onclick="goToMenu()">Quit</button>
  </div>
</div>

<div id="instructions-screen">
  <div class="inst-box">
    <h2>⚓ How to Play</h2>
    <div class="inst-section"><h4>Movement</h4><p>Use <span class="key">W</span><span class="key">A</span><span class="key">S</span><span class="key">D</span> or arrow keys to move. Collect driftwood, fish, and seaweed to survive.</p></div>
    <div class="inst-section"><h4>Survival</h4><p>Manage your <span style="color:#FF6B6B">Hunger</span>, <span style="color:#00E5FF">Thirst</span>, <span style="color:#06D6A0">Health</span>, and <span style="color:#FFB700">Energy</span>. They decay over time!</p></div>
    <div class="inst-section"><h4>Crafting</h4><p>Press <span class="key">C</span> to open crafting. Build tools, shelter, and cook food to improve your chances.</p></div>
    <div class="inst-section"><h4>Day/Night</h4><p>Each day lasts 120 seconds. Nights are dangerous — stay warm and safe!</p></div>
    <div class="inst-section"><h4>Quick Keys</h4><p><span class="key">1</span>-<span class="key">5</span> select hotbar slots · <span class="key">E</span> interact · <span class="key">F</span> pick up items · <span class="key">Space</span> sprint</p></div>
  </div>
</div>

<script>
// ===== GAME ENGINE =====
const canvas = document.getElementById('gameCanvas');
const ctx = canvas.getContext('2d');
let W, H;
function resize() { W = canvas.width = window.innerWidth; H = canvas.height = window.innerHeight; }
resize();
window.addEventListener('resize', resize);

// Audio
const AudioCtx = window.AudioContext || window.webkitAudioContext;
let audioCtx;
function initAudio() { if (!audioCtx) audioCtx = new AudioCtx(); }
function playSound(freq, type, dur, vol) {
  if (!audioCtx) return;
  try {
    const o = audioCtx.createOscillator();
    const g = audioCtx.createGain();
    o.type = type || 'sine';
    o.frequency.value = freq;
    g.gain.setValueAtTime(vol || 0.1, audioCtx.currentTime);
    g.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + (dur || 0.2));
    o.connect(g); g.connect(audioCtx.destination);
    o.start(); o.stop(audioCtx.currentTime + (dur || 0.2));
  } catch(e) {}
}
function sfxPickup() { playSound(600, 'sine', 0.15, 0.12); setTimeout(() => playSound(900, 'sine', 0.1, 0.08), 80); }
function sfxCraft() { playSound(400, 'triangle', 0.1, 0.1); setTimeout(() => playSound(600, 'triangle', 0.1, 0.1), 100); setTimeout(() => playSound(800, 'triangle', 0.15, 0.08), 200); }
function sfxHurt() { playSound(200, 'sawtooth', 0.2, 0.1); }
function sfxDrink() { playSound(500, 'sine', 0.1, 0.08); setTimeout(() => playSound(700, 'sine', 0.1, 0.06), 100); }
function sfxDay() { playSound(300, 'sine', 0.5, 0.08); setTimeout(() => playSound(500, 'sine', 0.5, 0.06), 300); }
function sfxNight() { playSound(200, 'sine', 0.8, 0.06); }

// Game state
let gameState = 'menu'; // menu, playing, paused, gameover, crafting, instructions
let player, world, items, particles, dayTime, dayNum, score, highScore;
let keys = {};
let selectedSlot = 0;
let lastTime = 0;
let notificationTimer = 0;
let craftingOpen = false;

highScore = parseInt(localStorage.getItem('drift_high') || '0');

// Item types
const ITEM_TYPES = {
  driftwood: { name: 'Driftwood', icon: '🪵', color: '#8B6914', stackable: true },
  fish: { name: 'Raw Fish', icon: '🐟', color: '#4FC3F7', stackable: true },
  seaweed: { name: 'Seaweed', icon: '🌿', color: '#2E7D32', stackable: true },
  water: { name: 'Water', icon: '💧', color: '#00E5FF', stackable: true },
  stone: { name: 'Stone', icon: '🪨', color: '#78909C', stackable: true },
  flint: { name: 'Flint', icon: '🔶', color: '#FF8F00', stackable: true },
  cookedFish: { name: 'Cooked Fish', icon: '🍳', color: '#FFB700', stackable: true },
  rope: { name: 'Rope', icon: '🧶', color: '#FFF176', stackable: true },
  shelter: { name: 'Shelter', icon: '🏠', color: '#A1887F', stackable: false },
  spear: { name: 'Spear', icon: '🎯', color: '#78909C', stackable: false },
    campfire: { name: 'Campfire', icon: '🔥', color: '#FF6D00', stackable: false },
  medical: { name: 'Med Kit', icon: '💊', color: '#F48FB1', stackable: true },
  compass: { name: 'Compass', icon: '🧭', color: '#CE93D8', stackable: false }
};

// Recipes
const RECIPES = [
  { name: 'Campfire', result: 'campfire', cost: { driftwood: 3, stone: 2 } },
  { name: 'Spear', result: 'spear', cost: { driftwood: 2, flint: 1 } },
  { name: 'Cooked Fish', result: 'cookedFish', cost: { fish: 1 }, needsFire: true },
  { name: 'Water', result: 'water', cost: { stone: 1, seaweed: 1 } },
  { name: 'Rope', result: 'rope', cost: { seaweed: 3 } },
  { name: 'Shelter', result: 'shelter', cost: { driftwood: 5, rope: 2 } },
  { name: 'Medical', result: 'medical', cost: { seaweed: 2, fish: 1 } },
  { name: 'Compass', result: 'compass', cost: { flint: 2, stone: 2, rope: 1 } }
];

function createPlayer() {
  return {
    x: W / 2, y: H / 2,
    vx: 0, vy: 0,
    speed: 3,
    sprintSpeed: 5,
    radius: 14,
    facing: 0,
    selectedItem: null,
    inventory: { driftwood: 3, fish: 1, seaweed: 2 },
    hotbar: [null, null, null, null, null],
    hunger: 100, thirst: 100, health: 100, energy: 100,
    invulnerable: 0,
    building: false,
    buildProgress: 0
  };
}

function createWorld() {
  const islands = [];
  for (let i = 0; i < 8; i++) {
    islands.push({
      x: Math.random() * W * 2 - W * 0.5 + W / 2,
      y: Math.random() * H * 2 - H * 0.5 + H / 2,
      radius: 40 + Math.random() * 60,
      type: Math.random() > 0.5 ? 'small' : 'large',
      trees: Math.floor(Math.random() * 5) + 2,
      hasFlint: Math.random() > 0.6,
      hasStone: Math.random() > 0.5
    });
  }
  const fishSchools = [];
  for (let i = 0; i < 12; i++) {
    fishSchools.push({
      x: Math.random() * W,
      y: Math.random() * H,
      vx: (Math.random() - 0.5) * 1.5,
      vy: (Math.random() - 0.5) * 1.5,
      count: 3 + Math.floor(Math.random() * 5),
      radius: 15
    });
  }
  const floatingObjects = [];
  for (let i = 0; i < 15; i++) {
    floatingObjects.push({
      x: Math.random() * W,
      y: Math.random() * H,
      type: ['driftwood', 'seaweed', 'stone', 'flint'][Math.floor(Math.random() * 4)],
      radius: 8 + Math.random() * 8,
      bobPhase: Math.random() * Math.PI * 2,
      bobSpeed: 0.5 + Math.random() * 1
    });
  }
  return { islands, fishSchools, floatingObjects, currents: [] };
}

function spawnItem(x, y, type, count) {
  items.push({ x, y, type, count: count || 1, radius: 10, bobPhase: Math.random() * Math.PI * 2 });
}

function addParticle(x, y, color, count, speed) {
  for (let i = 0; i < count; i++) {
    const angle = Math.random() * Math.PI * 2;
    const spd = (speed || 2) * (0.5 + Math.random());
    particles.push({
      x, y,
      vx: Math.cos(angle) * spd,
      vy: Math.sin(angle) * spd,
      life: 1,
      decay: 0.02 + Math.random() * 0.03,
      radius: 2 + Math.random() * 3,
      color
    });
  }
}

function addNotification(text, type) {
  const container = document.getElementById('notifications');
  const toast = document.createElement('div');
  toast.className = 'toast ' + (type || 'info');
  toast.textContent = text;
  container.appendChild(toast);
  setTimeout(() => { if (toast.parentNode) toast.remove(); }, 5000);
}

// Gauge drawing
function drawGauge(canvasId, pct, colors) {
  const c = document.getElementById(canvasId);
  const g = c.getContext('2d');
  const size = c.width;
  const cx = size / 2, cy = size / 2;
  const r = size / 2 - 6;
  g.clearRect(0, 0, size, size);
  // Background
  g.beginPath();
  g.arc(cx, cy, r, 0, Math.PI * 2);
  g.strokeStyle = 'rgba(255,255,255,0.1)';
  g.lineWidth = 5;
  g.stroke();
  // Fill
  const startAngle = -Math.PI / 2;
  const endAngle = startAngle + (Math.PI * 2 * (pct / 100));
  if (pct > 0) {
    const grad = g.createLinearGradient(cx - r, cy, cx + r, cy);
    grad.addColorStop(0, colors[0]);
    grad.addColorStop(1, colors[1]);
    g.beginPath();
    g.arc(cx, cy, r, startAngle, endAngle);
    g.strokeStyle = grad;
    g.lineWidth = 5;
    g.lineCap = 'round';
    g.stroke();
  }
  // Text
  g.fillStyle = '#E0E1DD';
  g.font = 'bold 14px sans-serif';
  g.textAlign = 'center';
  g.textBaseline = 'middle';
  g.fillText(Math.round(pct) + '%', cx, cy);
}

function updateGauges() {
  drawGauge('hungerCanvas', player.hunger, ['#FF6B6B', '#FF3D3D']);
  drawGauge('thirstCanvas', player.thirst, ['#00E5FF', '#0097A7']);
  drawGauge('healthCanvas', player.health, ['#06D6A0', '#009688']);
  drawGauge('energyCanvas', player.energy, ['#FFB700', '#FF6D00']);
  document.getElementById('hungerPct').textContent = Math.round(player.hunger) + '%';
  document.getElementById('thirstPct').textContent = Math.round(player.thirst) + '%';
  document.getElementById('healthPct').textContent = Math.round(player.health) + '%';
  document.getElementById('energyPct').textContent = Math.round(player.energy) + '%';
  document.getElementById('dayNum').textContent = dayNum;
  const hours = Math.floor(dayTime / 60);
  const mins = Math.floor(dayTime % 60);
  document.getElementById('timeNum').textContent = String(hours).padStart(2, '0') + ':' + String(mins).padStart(2, '0');
}

function updateHotbar() {
  const slots = document.querySelectorAll('.hotbar-slot');
  slots.forEach((slot, i) => {
    slot.classList.toggle('active', i === selectedSlot);
    const item = player.hotbar[i];
    if (item) {
      slot.querySelector('.slot-icon').textContent = ITEM_TYPES[item].icon;
      slot.querySelector('.slot-count').textContent = player.inventory[item] > 1 ? player.inventory[item] : '';
    } else {
      slot.querySelector('.slot-icon').textContent = '';
      slot.querySelector('.slot-count').textContent = '';
    }
  });
}

// Compass
function drawCompass() {
  const c = document.getElementById('compass');
  const g = c.getContext('2d');
  const cx = 60, cy = 60, r = 50;
  g.clearRect(0, 0, 120, 120);
  g.beginPath();
  g.arc(cx, cy, r, 0, Math.PI * 2);
  g.fillStyle = 'rgba(10,22,38,0.8)';
  g.fill();
  g.strokeStyle = 'rgba(26,82,118,0.5)';
  g.lineWidth = 2;
  g.stroke();
  // N
  g.fillStyle = '#FF3D3D';
  g.font = 'bold 14px sans-serif';
  g.textAlign = 'center';
  g.fillText('N', cx, cy - r + 12);
  // Direction indicator
  const dir = player.facing;
  g.save();
  g.translate(cx, cy);
  g.rotate(dir);
  g.beginPath();
  g.moveTo(0, -r + 5);
  g.lineTo(-6, 5);
  g.lineTo(0, 0);
  g.lineTo(6, 5);
  g.closePath();
  g.fillStyle = '#00E5FF';
  g.fill();
  g.restore();
  // S
  g.fillStyle = 'rgba(224,225,221,0.5)';
  g.fillText('S', cx, cy + r - 12);
}

// World rendering
function drawWorld(time) {
  // Sky gradient based on day time
  const dayFraction = dayTime / 120;
  let skyTop, skyBottom, oceanTop, oceanBottom;
  if (dayFraction < 0.15) {
    // Dawn
    const t = dayFraction / 0.15;
    skyTop = lerpColor('#0A1628', '#1A3A5C', t);
    skyBottom = lerpColor('#0A1628', '#FFB700', t * 0.5);
    oceanTop = lerpColor('#0A2040', '#0D4A6B', t);
    oceanBottom = lerpColor('#061828', '#0A3050', t);
  } else if (dayFraction < 0.35) {
    // Day
    const t = (dayFraction - 0.15) / 0.2;
    skyTop = lerpColor('#1A3A5C', '#1E6091', t);
    skyBottom = lerpColor('#FFB700', '#87CEEB', t);
    oceanTop = lerpColor('#0D4A6B', '#1A7AB5', t);
    oceanBottom = lerpColor('#0A3050', '#0D5A8A', t);
  } else if (dayFraction < 0.65) {
    // Afternoon
    skyTop = '#1E6091';
    skyBottom = '#87CEEB';
    oceanTop = '#1A7AB5';
    oceanBottom = '#0D5A8A';
  } else if (dayFraction < 0.85) {
    // Dusk
    const t = (dayFraction - 0.65) / 0.2;
    skyTop = lerpColor('#1E6091', '#2D1B4E', t);
    skyBottom = lerpColor('#87CEEB', '#FF6D00', t);
    oceanTop = lerpColor('#1A7AB5', '#2D1B4E', t);
    oceanBottom = lerpColor('#0D5A8A', '#1A0A2E', t);
  } else {
    // Night
    const t = (dayFraction - 0.85) / 0.15;
    skyTop = lerpColor('#2D1B4E', '#050510', t);
    skyBottom = lerpColor('#FF6D00', '#0A1628', t);
    oceanTop = lerpColor('#2D1B4E', '#050510', t);
    oceanBottom = lerpColor('#1A0A2E', '#030308', t);
  }

  // Sky
  const skyGrad = ctx.createLinearGradient(0, 0, 0, H * 0.5);
  skyGrad.addColorStop(0, skyTop);
  skyGrad.addColorStop(1, skyBottom);
  ctx.fillStyle = skyGrad;
  ctx.fillRect(0, 0, W, H);

  // Stars at night
  const isNight = dayFraction > 0.7 || dayFraction < 0.15;
  if (isNight) {
    const starAlpha = dayFraction > 0.7 ? (dayFraction - 0.7) / 0.15 : (0.15 - dayFraction) / 0.15;
    ctx.fillStyle = `rgba(255,255,255,${starAlpha * 0.8})`;
    for (let i = 0; i < 100; i++) {
      const sx = (i * 7919 + 1) % W;
      const sy = (i * 6271 + 1) % (H * 0.4);
      const sr = (i * 3571 % 3) + 0.5;
      ctx.beginPath();
      ctx.arc(sx, sy, sr, 0, Math.PI * 2);
      ctx.fill();
    }
  }

  // Sun/Moon
  const sunX = W * 0.5 + Math.cos(dayTime / 120 * Math.PI * 2) * W * 0.4;
  const sunY = H * 0.3 + Math.sin(dayTime / 120 * Math.PI * 2) * H * 0.15;
  if (isNight) {
    // Moon
    ctx.fillStyle = `rgba(200,210,230,${isNight ? 0.7 : 0})`;
    ctx.beginPath();
    ctx.arc(sunX, sunY, 18, 0, Math.PI * 2);
    ctx.fill();
    ctx.fillStyle = skyTop;
    ctx.beginPath();
    ctx.arc(sunX + 6, sunY - 3, 14, 0, Math.PI * 2);
    ctx.fill();
  } else if (dayFraction > 0.15 && dayFraction < 0.85) {
    // Sun
    const sunGrad = ctx.createRadialGradient(sunX, sunY, 0, sunX, sunY, 40);
    sunGrad.addColorStop(0, 'rgba(255,255,200,0.9)');
    sunGrad.addColorStop(0.5, 'rgba(255,200,100,0.3)');
    sunGrad.addColorStop(1, 'rgba(255,200,100,0)');
    ctx.fillStyle = sunGrad;
    ctx.beginPath();
    ctx.arc(sunX, sunY, 40, 0, Math.PI * 2);
    ctx.fill();
    ctx.fillStyle = '#FFF8E1';
    ctx.beginPath();
    ctx.arc(sunX, sunY, 15, 0, Math.PI * 2);
    ctx.fill();
  }

  // Ocean
  const oceanGrad = ctx.createLinearGradient(0, H * 0.35, 0, H);
  oceanGrad.addColorStop(0, oceanTop);
  oceanGrad.addColorStop(1, oceanBottom);
  ctx.fillStyle = oceanGrad;
  ctx.fillRect(0, H * 0.35, W, H * 0.65);

  // Ocean waves
  ctx.strokeStyle = 'rgba(255,255,255,0.08)';
  ctx.lineWidth = 1.5;
  for (let layer = 0; layer < 5; layer++) {
    const baseY = H * 0.4 + layer * 25;
    ctx.beginPath();
    for (let x = 0; x <= W; x += 5) {
      const y = baseY + Math.sin(x * 0.02 + time * 0.002 + layer) * (6 + layer * 2) + Math.sin(x * 0.01 + time * 0.001) * 4;
      if (x === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);
    }
    ctx.stroke();
  }

  // Currents indicator
  world.currents.forEach(c => {
    ctx.strokeStyle = `rgba(100,180,255,${0.1 + Math.sin(time * 0.003) * 0.05})`;
    ctx.lineWidth = 2;
    ctx.beginPath();
    ctx.moveTo(c.x - 20, c.y);
    ctx.lineTo(c.x +