  "index.html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Resonant Velocity</title>\n    <!-- Emoji favicon -->\n    <link rel=\"icon\" href=\"data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='50%' font-size='90'>🚗</text></svg>\"\n          type=\"image/svg+xml\">\n    <style>\n        * { margin: 0; padding: 0; box-sizing: border-box; }\n        body {\n            background: #0a0a1a;\n            overflow: hidden;\n            font-family: 'Segoe UI', sans-serif;\n        }\n        #game-container {\n            position: relative;\n            width: 100vw;\n            height: 100vh;\n            display: flex;\n            justify-content: center;\n            align-items: center;\n        }\n        canvas {\n            display: block;\n            width: 100%;\n            height: auto;\n            max-width: 100vw;\n            max-height: 100vh;\n        }\n        .speedrun-timer {\n            position: absolute;\n            top: 10px;\n            left: 50%;\n            transform: translateX(-50%);\n            font-size: 24px;\n            color: #fff;\n            background: rgba(0, 240, 255, 0.15);\n            padding: 8px 16px;\n            border-radius: 20px;\n            backdrop-filter: blur(10px);\n            z-index: 10;\n        }\n        .hud {\n            position: absolute;\n            bottom: 30px;\n            right: 20px;\n            display: flex;\n            flex-direction: column;\n            gap: 12px;\n            z-index: 10;\n        }\n        .combo-display {\n            font-size: 48px;\n            font-weight: bold;\n            color: #ff00aa;\n            text-shadow: 0 0 20px #ff00aa;\n        }\n        .score-display {\n            font-size: 28px;\n            color: #faff00;\n        }\n        .wave-meter {\n            height: 6px;\n            background: linear-gradient(to right, #00f0ff, #ff00aa, #faff00);\n            width: 100%;\n            border-radius: 3px;\n            overflow: hidden;\n            margin-bottom: 8px;\n        }\n        .wave-bar {\n            height: 100%;\n            background: linear-gradient(90deg, #00f0ff, #ff00aa, #faff00);\n            transition: width 0.1s linear;\n        }\n        .minimap {\n            position: absolute;\n            bottom: 20px;\n            right: 20px;\n            width: 120px;\n            height: 80px;\n            border-radius: 50%;\n            background: rgba(0, 20, 40, 0.7);\n            border: 2px solid #00f0ff;\n            display: none;\n        }\n        .menu-overlay {\n            position: fixed;\n            inset: 0;\n            background: rgba(10, 10, 26, 0.95);\n            display: flex;\n            flex-direction: column;\n            align-items: center;\n            justify-content: center;\n            z-index: 100;\n            opacity: 0;\n            pointer-events: none;\n            transition: opacity 0.3s;\n        }\n        .menu-overlay.active {\n            opacity: 1;\n            pointer-events: all;\n        }\n        button {\n            background: #00f0ff;\n            color: #0a0a1a;\n            border: none;\n            padding: 12px 32px;\n            font-size: 18px;\n            cursor: pointer;\n            border-radius: 8px;\n            transition: all 0.2s;\n        }\n        button:hover {\n            background: #ff00aa;\n            box-shadow: 0 0 25px #ff00aa;\n        }\n    </style>\n</head>\n<body>\n    <div id=\"game-container\">\n        <canvas id=\"game-canvas\"></canvas>\n        <div class=\"speedrun-timer\" id=\"timer\">00:00.00</div>\n        <div class=\"hud\">\n            <div class=\"combo-display\" id=\"combo\">Combo: 0</div>\n            <div class=\"score-display\" id=\"score\">High Score: 0</div>\n            <div class=\"wave-meter\" id=\"wave-meter\">\n                <div class=\"wave-bar\" id=\"wave-bar\" style=\"width: 60%;\"></div>\n            </div>\n        </div>\n        <div class=\"minimap\" id=\"minimap\"></div>\n    </div>\n\n    <!-- Main Menu -->\n    <div class=\"menu-overlay\" id=\"menu\">\n        <h1>Resonant Velocity</h1>\n        <p>Ride the rhythm. Survive the beat.</p>\n        <button onclick=\"startGame()\">Start Race</button>\n    </div>\n\n    <script src=\"audio/AudioEngine.js\"></script>\n    <script src=\"engine/Physics.js\"></script>\n    <script src=\"engine/TrackGenerator.js\"></script>\n    <script src=\"render/CanvasRenderer.js\"></script>\n    <script src=\"systems/LapSystem.js\"></script>\n    <script src=\"ui/HUD.js\"></script>\n    <script src=\"index.js\"></script>\n</body>\n</html>"",
  "audio/AudioEngine.js": "// Audio Engine - Web Audio API for waveform analysis and sound effects\nclass AudioEngine {\n    constructor() {\n        this.audioContext = new (window.AudioContext || window.webkitAudioContext)();\n        this.analyser = this.audioContext.createAnalyser();\n        this.analyser.fftSize = 256;\n        this.analyser.smoothingTimeConstant = 0.75;\n        this.audioBuffer = null;\n        this.isPlaying = false;\n        this.resonanceBoostTimer = 0;\n    }\n\n    // Load and play an audio file (or use web audio sample)\n    loadAndPlay(sourceUrl) {\n        if (!sourceUrl) return;\n        const source = new AudioSource(sourceUrl);\n        source.playbackRate = 1;\n        source.loop = true;\n        \n        // Start analyser on first buffer\n        if (!this.audioBuffer) {\n            this.analyser.startFft();\n            this.audioBuffer = this.analyser.getFloatTimeDomainData();\n        }\n        \n        // Resize canvas to match audio context size\n        this.resizeForAudio();\n        \n        // Play the audio\n        source.onloadedmetadata = () => {\n            this.audioBuffer = this.analyser.getFloatTimeDomainData();\n            this.processWaveform();\n        };\n        \n        source.onerror = (e) => console.error('Audio error:', e);\n    }\n\n    resizeForAudio() {\n        const canvas = document.getElementById('game-canvas');\n        const dpr = window.devicePixelRatio || 1;\n        canvas.width = canvas.clientWidth * dpr;\n        canvas.height = canvas.clientHeight * dpr;\n        canvas.style.width = canvas.clientWidth + 'px';\n        canvas.style.height = canvas.clientHeight + 'px';\n        this.canvas = canvas;\n    }\n\n    processWaveform() {\n        if (!this.audioBuffer) return;\n        \n        const samples = this.audioBuffer.length;\n        const dataArray = new Uint8Array(samples);\n        this.analyser.getByteTimeDomainData(dataArray);\n        \n        // Update waveform visualization\n        updateWaveformVisualization(dataArray);\n    }\n\n    updateWaveformVisualization(dataArray) {\n        const canvas = document.getElementById('game-canvas');\n        const barWidth = canvas.width / 2;\n        const barHeight = 4;\n        \n        // Draw glowing waveform bars\n        const gradient = canvas.getContext('2d').createLinearGradient(0, 0, canvas.width, 0);\n        gradient.addColorStop(0, '#00f0ff');\n        gradient.addColorStop(1, '#ff00aa');\n        \n        const midY = canvas.height / 2;\n        for (let i = 0; i < dataArray.length; i++) {\n            const x = i * (barWidth / dataArray.length);\n            const y = midY - Math.abs(dataArray[i]) * barHeight / 2;\n            const alpha = dataArray[i] > 0 ? 180 : 0;\n            canvas.fillStyle = `rgba(0, 240, 255, ${alpha})`;\n            canvas.fillRect(x, y, barWidth / dataArray.length, barHeight);\n        }\n    }\n\n    // Create a simple sound effect (click/pop)\n    playClickSound() {\n        if (this.audioContext.state === 'suspended') {\n            this.audioContext.resume();\n        }\n        const oscillator = this.audioContext.createOscillator();\n        const gainNode = this.audioContext.createGain();\n        oscillator.connect(gainNode);\n        gainNode.connect(this.audioContext.destination);\n        \n        oscillator.frequency.value = 800;\n        oscillator.type = 'sine';\n        gainNode.gain.setValueAtTime(0.1, this.audioContext.currentTime);\n        gainNode.gain.exponentialRampToValueAtTime(0.01, this.audioContext.currentTime + 0.05);\n        \n        oscillator.start();\n        oscillator.stop(this.audioContext.currentTime + 0.05);\n        \n        // Release resonance boost after 0.5 seconds\n        setTimeout(() => {\n            if (this.resonanceBoostTimer > 0) {\n                this.resonanceBoostTimer--;\n            }\n        }, 500);\n    }\n\n    // Trigger resonance boost on high amplitude peaks\n    triggerResonanceBoost() {\n        if (this.resonanceBoostTimer <= 0) return;\n        this.resonanceBoostTimer--;\n        \n        // Increase max speed and acceleration temporarily\n        this.maxSpeed = Math.min(this.maxSpeed * 1.15, 300);\n        this.acceleration = 0.08;\n        \n        // Visual feedback via waveform intensity\n        if (this.audioBuffer) {\n            this.updateWaveformVisualization(this.audioBuffer);\n        }\n    }\n}\n\n// Global instance\nconst audioEngine = new AudioEngine();",
  "engine/Physics.js": "// Physics Engine - Player movement, velocity, and collision detection\nclass Physics {\n    constructor() {\n        this.player = {\n            x: 0,\n            y: 0,\n            vx: 0,\n            vy: 0,\n            rotation: 0,\n            radius: 15,\n            maxSpeed: 250,\n            acceleration: 0.08,\n            friction: 0.92,\n            angle: Math.PI / 2 // Facing up initially\n        };\n        this.combo = 0;\n        this.lapTime = 0;\n        this.isPaused = false;\n        this.speedRunTimer = 0;\n    }\n\n    update(dt) {\n        if (this.isPaused) return;\n        \n        // Apply friction\n        this.player.vx *= this.friction;\n        this.player.vy *= this.friction;\n        \n        // Handle input\n        const input = getInput();\n        \n        // Throttle forward/backward thrust\n        if (input.forward && this.player.vx > 0) {\n            this.player.vx += this.acceleration;\n        } else if (input.backward && this.player.vx < 0) {\n            this.player.vx -= this.acceleration;\n        }\n        \n        // Steering\n        if (input.left) {\n            this.player.rotation -= 0.08;\n        }\n        if (input.right) {\n            this.player.rotation += 0.08;\n        }\n        \n        // Normalize rotation\n        this.player.rotation = ((this.player.rotation + Math.PI * 2) % (Math.PI * 2)) - Math.PI / 2;\n        \n        // Apply angular velocity to velocity\n        const turnSpeed = 0.04;\n        this.player.vx += Math.cos(this.player.rotation) * turnSpeed * dt;\n        this.player.vy += Math.sin(this.player.rotation) * turnSpeed * dt;\n        \n        // Clamp velocity\n        const speed = Math.sqrt(this.player.vx * this.player.vx + this.player.vy * this.player.vy);\n        if (speed > this.player.maxSpeed) {\n            this.player.vx = (this.player.vx / speed) * this.player.maxSpeed;\n            this.player.vy = (this.player.vy / speed) * this.player.maxSpeed;\n        }\n        \n        // Drift mechanic - handbrake (Spacebar)\n        if (input.handbrake) {\n            // Reduce lateral friction during drift\n            this.player.friction = 0.65;\n            // Calculate drift angle\n            const velocityAngle = Math.atan2(this.player.vy, this.player.vx);\n            const driftAngle = this.player.rotation - velocityAngle;\n            // Apply drift force\n            this.player.vx += Math.cos(driftAngle) * 0.15 * dt;\n            this.player.vy += Math.sin(driftAngle) * 0.15 * dt;\n        }\n        \n        // Reset drift when not holding handbrake\n        if (!input.handbrake) {\n            this.player.friction = 0.9;\n        }\n        \n        // Update position\n        this.player.x += this.player.vx * dt;\n        this.player.y += this.player.vy * dt;\n        \n        // Speed run timer\n        if (!this.isPaused) {\n            this.speedRunTimer += dt;\n            if (this.speedRunTimer >= 90) {\n                this.lapTime++;\n                this.speedRunTimer = 0;\n            }\n        }\n        \n        // Collision detection with track obstacles\n        checkCollisions();\n    }\n\n    getInput() {\n        const keys = {\n            forward: document.querySelector('.forward-key')?.classList?.getAttribute('onclick') !== '',\n            backward: document.querySelector('.backward-key')?.classList?.getAttribute('onclick') !== '',\n            left: document.querySelector('.left-key')?.classList?.getAttribute('onclick') !== '',\n            right: document.querySelector('.right-key')?.classList?.getAttribute('onclick') !== '',\n            handbrake: document.querySelector('.handbrake-key')?.classList?.getAttribute('onclick') !== ''\n        };\n        \n        return {\n            forward: keys.forward || false,\n            backward: keys.backward || false,\n            left: keys.left || false,\n            right: keys.right || false,\n            handbrake: keys.handbrake || false\n        };\n    }\n\n    reset() {\n        this.player.x = 0;\n        this.player.y = 0;\n        this.player.vx = 0;\n        this.player.vy = 0;\n        this.player.rotation = 0;\n        this.combo = 0;\n        this.lapTime = 0;\n        this.isPaused = false;\n        this.speedRunTimer = 0;\n    }\n}\n\n// Helper function for key detection\nfunction getInput() {\n    const keys = {\n        forward: document.querySelector('.forward-key')?.classList?.getAttribute('onclick') !== '',\n        backward: document.querySelector('.backward-key')?.classList?.getAttribute('onclick') !== '',\n        left: document.querySelector('.left-key')?.classList?.getAttribute('onclick') !== '',\n        right: document.querySelector('.right-key')?.classList?.getAttribute('onclick') !== '',\n        handbrake: document.querySelector('.handbrake-key')?.classList?.getAttribute('onclick') !== ''\n    };\n    return {\n        forward: keys.forward || false,\n        backward: keys.backward || false,\n        left: keys.left || false,\n        right: keys.right || false,\n        handbrake: keys.handbrake || false\n    };\n}",

  "engine/TrackGenerator.js": "// Track Generator - Procedural track generation from audio waveform\nclass TrackGenerator {\n    constructor() {\n        this.trackPoints = [];\n        this.currentX = 0;\n        this.currentY = 0;\n        this.zoomLevel = 1;\n        this.isInfiniteLoop = true;\n    }\n\n    generateFromAudio(sourceUrl) {\n        // Initialize track at origin\n        this.trackPoints.push({ x: 0, y: 0 });\n        \n        // Generate points based on audio frequency and amplitude\n        const bufferSize = 4096;\n        const samples = this.audioEngine.analyser.getFloatTimeDomainData(bufferSize);\n        \n        for (let i = 1; i < bufferSize; i++) {\n            const idx = Math.floor(i * 0.02); // Sample rate ~50Hz for simplicity\n            const amplitude = samples[idx];\n            \n            // Map amplitude to vertical offset (depth/elevation)\n            const depthOffset = amplitude * 0.15;\n            const nextX = this.currentX + (i * 0.5);\n            const nextY = this.currentY + depthOffset;\n            \n            this.trackPoints.push({\n                x: nextX,\n                y: nextY\n            });\n        }\n        \n        // Close the loop for infinite track\n        if (this.isInfiniteLoop) {\n            this.trackPoints.push({ x: 0, y: 0 });\n        }\n    }\n\n    // Get elevation at a given x coordinate\n    getElevation(x) {\n        // Find nearest track segment\n        let minDist = Infinity;\n        for (let i = 0; i < this.trackPoints.length - 1; i++) {\n            const dx = x - this.trackPoints[i].x;\n            const dy = x - this.trackPoints[i+1].x;\n            const dist = Math.sqrt(dx*dx + dy*dy);\n            if (dist < minDist) {\n                minDist = dist;\n            }\n        }\n        \n        // Interpolate between nearest points\n        if (minDist > 0) {\n            const segIndex = Math.round((x - this.trackPoints[0].x) / (this.trackPoints[1].x - this.trackPoints[0].x));\n            const p1 = this.trackPoints[segIndex];\n            const p2 = this.trackPoints[segIndex + 1];\n            \n            const t = (x - p1.x) / (p2.x - p1.x);\n            return p1.y + t * (p2.y - p1.y);\n        }\n        return 0;\n    }\n\n    // Spawn static pit obstacles where amplitude drops below threshold\n    spawnObstacles() {\n        const threshold = 0.2;\n        for (let i = 1; i < this.trackPoints.length - 1; i++) {\n            const midY = (this.trackPoints[i].y + this.trackPoints[i+1].y) / 2;\n            const elevation = this.getElevation(this.trackPoints[i].x);\n            \n            // If current elevation is above threshold, create a pit below it\n            if (elevation > threshold) {\n                const pitDepth = (midY - elevation) * 0.3;\n                const obstacleX = this.trackPoints[i].x + (this.trackPoints[i+1].x - this.trackPoints[i].x) * 0.5;\n                \n                this.trackPoints.push({\n                    x: obstacleX,\n                    y: midY - pitDepth\n                });\n            }\n        }\n    }\n}\n\n// Global instance\nconst trackGenerator = new TrackGenerator();",
  "render/CanvasRenderer.js": "// Render Engine - Canvas 2D rendering with particles and visual effects\nclass CanvasRenderer {\n    constructor(canvasId) {\n        this.canvas = document.getElementById(canvasId);\n        this.ctx = this.canvas.getContext('2d');\n        this.resize();\n        this.lastTime = 0;\n    }\n\n    resize() {\n        const container = document.getElementById('game-container');\n        const rect = container.getBoundingClientRect();\n        this.canvas.width = rect.width * window.devicePixelRatio;\n        this.canvas.height = rect.height * window.devicePixelRatio;\n        this.canvas.style.width = rect.width + 'px';\n        this.canvas.style.height = rect.height + 'px';\n        this.ctx.setTransform(window.devicePixelRatio, 0, 0, window.devicePixelRatio, 0, 0);\n    }\n\n    // Main render loop\n    render(currentTime) {\n        requestAnimationFrame((t) => this.render(t));\n        \n        // Clear canvas\n        this.ctx.clearRect(0, 0, this.canvas.width / window.devicePixelRatio, this.canvas.height / window.devicePixelRatio);\n        \n        // Apply transformations\n        this.ctx.save();\n        this.ctx.translate(this.canvas.width / window.devicePixelRatio, this.canvas.height / window.devicePixelRatio);\n        \n        // Draw track base\n        drawTrack(this.ctx, this.trackGenerator);\n        \n        // Draw dynamic glow lines based on waveform\n        drawWaveformGlow(this.ctx, this.audioEngine);\n        \n        // Draw tire skid marks\n        drawSkidMarks(this.ctx, this.player);\n        \n        // Draw player car\n        drawPlayer(this.ctx, this.player);\n        \n        // Draw combo counter\n        drawCombo(this.ctx);\n        \n        // Draw speedometer\n        drawSpeedometer(this.ctx);\n        \n        // Update timer display\n        updateTimerDisplay();\n        \n        this.ctx.restore();\n    }\n\n    // Draw procedural track lines\n    drawTrack(ctx, trackGen) {\n        ctx.beginPath();\n        ctx.moveTo(0, 0);\n        \n        for (let i = 0; i < trackGen.trackPoints.length - 1; i++) {\n            const p1 = trackGen.trackPoints[i];\n            const p2 = trackGen.trackPoints[i + 1];\n            \n            // Smooth curve interpolation\n            const curvature = Math.abs(p2.x - p1.x) * 0.3;\n            const controlPoint = {\n                x: (p1.x + p2.x) / 2 + (curvature * (p2.x - p1.x)),\n                y: (p1.y + p2.y) / 2\n            };\n            \n            ctx.quadraticCurveTo(p1.x, p1.y, controlPoint.x, controlPoint.y);\n        }\n        \n        // Fill track with glowing neon color\n        const fillColor = '#00f0ff';\n        ctx.lineWidth = 2;\n        ctx.strokeStyle = fillColor;\n        ctx.shadowColor = fillColor;\n        ctx.shadowBlur = 15;\n        ctx.fill();\n        ctx.stroke();\n        \n        // Draw elevation depth indicator\n        for (let i = 1; i < trackGen.trackPoints.length - 1; i++) {\n            const elevation = trackGen.getElevation(trackGen.trackPoints[i].x);\n            ctx.fillStyle = `rgba(0, 20, 60, ${elevation * 0.3})`;\n            ctx.fillRect(i * 0.8, elevation * 0.5, 0.6, 2);\n        }\n    }\n\n    // Draw waveform glow effect\n    drawWaveformGlow(ctx, audioEngine) {\n        const data = audioEngine.analyser.getFloatTimeDomainData(audioEngine.analyser.fftSize);\n        const width = ctx.canvas.width / window.devicePixelRatio;\n        const height = ctx.canvas.height / window.devicePixelRatio;\n        \n        // Gradient for glow\n        const gradient = ctx.createLinearGradient(0, height/2, 0, height/2);\n        gradient.addColorStop(0, '#00f0ff');\n        gradient.addColorStop(1, '#ff00aa');\n        \n        // Draw waveform as glowing line\n        ctx.beginPath();\n        ctx.moveTo(0, height/2);\n        \n        for (let i = 0; i < data.length; i++) {\n            const x = (i / data.length) * width;\n            const y = height/2 - (data[i] * (height/2));\n            \n            // Glow effect - larger circles behind the line\n            if (data[i] > 0.1) {\n                ctx.beginPath();\n                ctx.arc(x, y, 3, 0, Math.PI * 2);\n                ctx.fillStyle = `rgba(0, 240, 255, ${data[i] * 0.3})`;\n                ctx.fill();\n            }\n            \n            if (i > 0) {\n                ctx.lineTo(x, y);\n            }\n        }\n        \n        // Waveform bar in HUD\n        const waveBar = document.getElementById('wave-bar');\n        const progress = Math.min(1, audioEngine.audioBuffer.length / 512);\n        waveBar.style.width = `${progress * 100}%`;\n        \n        // Update wave color based on progress\n        const waveColor = progress > 0.5 ? '#ff00aa' : '#00f0ff';\n        waveBar.style.background = `linear-gradient(90deg, ${waveColor}, ${waveColor})`;\n    }\n\n    // Draw tire skid marks\n    drawSkidMarks(ctx, player) {\n        const markLength = 30;\n        const markSpacing = 150;\n        \n        // Skid marks follow vehicle path\n        for (let i = 0; i < player.pathHistory.length; i++) {\n            const markX = player.x + Math.cos(player.rotation) * markLength;\n            const markY = player.y + Math.sin(player.rotation) * markLength;\n            \n            ctx.beginPath();\n            ctx.arc(markX, markY, 4, 0, Math.PI * 2);\n            ctx.fillStyle = '#ff00aa';\n            ctx.fill();\n        }\n    }\n\n    // Draw player car\n    drawPlayer(ctx, player) {\n        // Car body (neon outline)\n        ctx.save();\n        ctx.translate(player.x, player.y);\n        ctx.rotate(player.rotation);\n        \n        // Main chassis\n        ctx.fillStyle = '#faff00'; // Bright yellow\n        ctx.strokeStyle = '#ffffff';\n        ctx.lineWidth = 4;\n        \n        // Rounded rectangle body\n        const w = 40;\n        const h = 25;\n        roundRect(ctx, -w/2, -h/2, w, h, 8);\n        ctx.fill();\n        ctx.stroke();\n        \n        // Headlight\n        ctx.fillStyle = '#ffffff';\n        ctx.beginPath();\n        ctx.arc(w/2, -h/2 - 5, 6, 0, Math.PI * 2);\n        ctx.fill();\n        \n        // Wheel wells\n        ctx.fillStyle = '#000000';\n        ctx.fillRect(-w/2 + 2, -h/2 - 5, w - 4, 8);\n        ctx.fillRect(w/2 - 2, -h/2 - 5, w - 4, 8);\n        \n        // Wheels\n        ctx.fillStyle = '#333333';\n        ctx.beginPath();\n        ctx.arc(0, -h/2 - 5, 12, 0, Math.PI * 2);\n        ctx.fill();\n        \n        ctx.restore();\n    }\n\n    // Utility: rounded rectangle helper\n    roundRect(ctx, x, y, w, h, r) {\n        ctx.beginPath();\n        ctx.moveTo(x + r, y);\n        ctx.lineTo(x + w - r, y);\n        ctx.quadraticCurveTo(x + w, y, x + w, y + r);\n        ctx.lineTo(x + w, y + h - r);\n        ctx.quadraticCurveTo(x + w, y + h, x + w - r, y + h);\n        ctx.lineTo(x + r, y + h);\n        ctx.quadraticCurveTo(x, y + h, x, y + h - r);\n        ctx.closePath();\n    }\n\n    // Draw combo counter\n    drawCombo(ctx) {\n        const comboEl = document.getElementById('combo');\n        comboEl.textContent = `Combo: ${this.player.combo}`;\n        \n        // Color shift based on combo\n        const comboColor = this.player.combo > 10 ? '#ff00aa' : \n                           this.player.combo > 5 ? '#00f0ff' : '#faff00';\n        comboEl.style.color = comboColor;\n    }\n\n    // Draw speedometer\n    drawSpeedometer(ctx) {\n        const speedEl = document.getElementById('score'); // Using score element for speedo visual\n        const maxSpeed = 300;\n        const speed = this.player.vx * this.player.vy + this.player.vx * this.player.vx + this.player.vy * this.player.vy;\n        const normalizedSpeed = Math.min(1, speed / (maxSpeed * 2));\n        \n        // Circular gauge\n        const gaugeRadius = 60;\n        const gaugeCenterX = this.canvas.width / 2;\n        const gaugeCenterY = this.canvas.height / 2 - 35;\n        \n        ctx.save();\n        ctx.translate(gaugeCenterX, gaugeCenterY);\n        \n        // Background arc\n        const bgGradient = ctx.createRadialGradient(0, 0, 0, 0, 0, gaugeRadius);\n        bgGradient.addColorStop(0, '#00f0ff');\n        bgGradient.addColorStop(1, '#ffffff');\n        ctx.fillStyle = bgGradient;\n        ctx.beginPath();\n        ctx.arc(0, 0, gaugeRadius, 0, Math.PI * 2);\n        ctx.fill();\n        \n        // Speedometer needle/dot\n        const needleRadius = 12;\n        ctx.beginPath();\n        ctx.arc(0, 0, needleRadius, 0, Math.PI * 2);\n        ctx.fillStyle = '#ff00aa';\n        ctx.fill();\n        \n        // Speed value inside\n        ctx.fillStyle = '#000000';\n        ctx.font = 'bold 24px Arial';\n        ctx.textAlign = 'center';\n        ctx.fillText(`${normalizedSpeed * maxSpeed.toFixed(1)}`, 0, -10);\n        \n        ctx.restore();\n    }\n\n    // Update timer display\n    updateTimerDisplay() {\n        const elapsed = performance.now() - this.lastTime;\n        const totalSeconds = Math.floor(elapsed / 1000);\n        const minutes = Math.floor(totalSeconds / 60);\n        const seconds = totalSeconds % 60;\n        \n        const hours = Math.floor(minutes / 60);\n        \n        document.getElementById('timer').textContent =\n            `${String(hours).padStart(2, '0')}:${String(minutes).padStart(2, '0')}.${String(seconds).padStart(2, '0')}`;\n    }\n}\n\n// Global instance\nconst renderer = new CanvasRenderer('game-canvas');",

  "systems/LapSystem.js": "// Lap System - Track time tracking and lap management\nclass LapSystem {\n    constructor() {\n        this.l"systems/LapSystem.js": "// Lap System - Track time tracking and lap management\nclass LapSystem {\n    constructor() {\n        this.laps = [];\n        this.currentLapTime = 0;\n        this.isLapActive = false;\n        this.startTime = 0;\n    }\n\n    startLap() {\n        if (!this.isLapActive) {\n            this.startTime = performance.now();\n            this.currentLapTime = 0;\n            this.isLapActive = true;\n        }\n    }\n\n    stopLap() {\n        if (this.isLapActive) {\n            const lapDuration = performance.now() - this.startTime;\n            this.laps.push({\n                duration: lapDuration,\n                startTime: this.startTime\n            });\n            this.isLapActive = false;\n        }\n    }\n\n    getCurrentLapTime() {\n        return this.currentLapTime + (performance.now() - this.startTime);\n    }\n\n    reset() {\n        this.laps = [];\n        this.currentLapTime = 0;\n        this.isLapActive = false;\n        this.startTime = 0;\n    }\n}\n"