           margin-bottom: 30px;\n        }\n\n        @keyframes blink {\n            0%, 100% { opacity: 1; }\n            50% { opacity: 0.3; }\n        }\n\n        .controls-info {\n            color: var(--color-text-dim);\n            font-size: 12px;\n            text-align: center;\n            line-height: 1.8;\n        }\n\n        .controls-info span {\n            color: var(--color-primary);\n            background: rgba(0, 245, 255, 0.1);\n            padding: 2px 8px;\n            border-radius: 4px;\n            margin: 0 3px;\n        }\n\n        .high-score {\n            color: var(--color-accent);\n            font-size: 18px;\n            margin-top: 30px;\n            text-shadow: 0 0 10px var(--color-accent);\n        }\n\n        .game-over-title {\n            font-size: 36px;\n            color: var(--color-secondary);\n            text-shadow: 0 0 20px var(--color-secondary);\n            margin-bottom: 20px;\n        }\n\n        .final-score {\n            color: var(--color-accent);\n            font-size: 24px;\n            margin-bottom: 10px;\n        }\n\n        .new-record {\n            color: var(--color-success);\n            font-size: 18px;\n            animation: pulse 0.5s ease-in-out infinite;\n            margin-bottom: 20px;\n        }\n\n        #timerOverlay {\n            position: absolute;\n            top: 15px;\n            left: 50%;\n            transform: translateX(-50%);\n            background: rgba(0, 0, 0, 0.7);\n            padding: 8px 20px;\n            border-radius: 20px;\n            border: 2px solid var(--color-success);\n        }\n\n        #timerOverlay .label {\n            color: var(--color-text-dim);\n            font-size: 10px;\n            text-transform: uppercase;\n            letter-spacing: 2px;\n        }\n\n        #timerOverlay .time {\n            color: var(--color-success);\n            font-size: 20px;\n            font-weight: 700;\n            text-shadow: 0 0 10px var(--color-success);\n        }\n\n        @media (max-width: 768px) {\n            .game-title { font-size: 32px; }\n            .stat-box { font-size: 11px; padding: 6px 10px; }\n            .health-heart { font-size: 18px; }\n            .boost-bar { width: 80px; }\n        }\n    </style>\n</head>\n<body>\n    <div id=\"gameContainer\">\n        <canvas id=\"gameCanvas\"></canvas>\n        <div id=\"uiOverlay\">\n            <div class=\"hud-top\">\n                <div class=\"health-container\" id=\"healthDisplay\"></div>\n                <div class=\"checkpoint-info\" id=\"checkpointDisplay\">CHECKPOINT 0/10</div>\n                <div class=\"boost-container\">\n                    <span class=\"boost-label\">⚡</span>\n                    <div class=\"boost-bar\">\n                        <div class=\"boost-fill\" id=\"boostFill\" style=\"width: 100%\"></div>\n                    </div>\n                </div>\n            </div>\n            <div id=\"timerOverlay\">\n                <div class=\"label\">Speedrun</div>\n                <div class=\"time\" id=\"timerDisplay\">0:00.00</div>\n            </div>\n            <div class=\"hud-bottom\">\n                <div class=\"stat-box\" id=\"distanceDisplay\">DISTANCE: 0m</div>\n                <div class=\"stat-box\" id=\"bestDisplay\">BEST: 0m</div>\n                <div class=\"stat-box timer\" id=\"scoreDisplay\">SCORE: 0</div>\n            </div>\n        </div>\n        <div id=\"menuOverlay\">\n            <div class=\"game-title\">DOMINO RACER</div>\n            <div class=\"subtitle\">PHYSICS RACING</div>\n            <div class=\"start-prompt\" id=\"startPrompt\">PRESS SPACE TO START</div>\n            <div class=\"controls-info\">\n                <span>W</span><span>A</span><span>S</span><span>D</span> or <span>ARROWS</span> Move<br>\n                <span>SPACE</span> Boost | <span>R</span> Restart | <span>M</span> Mute\n            </div>\n            <div class=\"high-score\" id=\"highScoreDisplay\">HIGH SCORE: 0</div>\n        </div>\n    </div>\n\n    <script>\n        // ==================== CONFIGURATION ====================\n        const CONFIG = {\n            TRACK_LENGTH: 5000,\n            CHECKPOINT_INTERVAL: 500,\n            MAX_DOMINOES: 500,\n            DOMINO_WIDTH: 20,\n            DOMINO_HEIGHT: 60,\n            GRAVITY: 980,\n            MAX_SPEED: 400,\n            BOOST_SPEED: 600,\n            ACCELERATION: 300,\n            BRAKE_FORCE: 500,\n            BOOST_MAX: 100,\n            BOOST_CONSUME: 40,\n            BOOST_RECHARGE: 15,\n            CHAIN_REACTION_DISTANCE: 40,\n            FALL_ANGULAR_SPEED: 360,\n            CAMERA_LEAD: 200\n        };\n\n        // ==================== AUDIO MANAGER ====================\n        class AudioManager {\n            constructor() {\n                this.ctx = null;\n                this.masterGain = null;\n                this.muted = false;\n                this.initialized = false;\n            }\n\n            init() {\n                if (this.initialized) return;\n                try {\n                    this.ctx = new (window.AudioContext || window.webkitAudioContext)();\n                    this.masterGain = this.ctx.createGain();\n                    this.masterGain.gain.value = 0.3;\n                    this.masterGain.connect(this.ctx.destination);\n                    this.initialized = true;\n                } catch (e) {\n                    console.warn('Web Audio not supported');\n                }\n            }\n\n            toggleMute() {\n                this.muted = !this.muted;\n                if (this.masterGain) {\n                    this.masterGain.gain.value = this.muted ? 0 : 0.3;\n                }\n            }\n\n            playTone(frequency, duration, type = 'sine', volume = 0.5) {\n                if (!this.initialized || this.muted) return;\n                const osc = this.ctx.createOscillator();\n                const gain = this.ctx.createGain();\n                osc.type = type;\n                osc.frequency.value = frequency;\n                gain.gain.setValueAtTime(volume * 0.3, this.ctx.currentTime);\n                gain.gain.exponentialRampToValueAtTime(0.01, this.ctx.currentTime + duration);\n                osc.connect(gain);\n                gain.connect(this.masterGain);\n                osc.start();\n                osc.stop(this.ctx.currentTime + duration);\n            }\n\n            playEngine(speed) {\n                if (!this.initialized || this.muted) return;\n                const freq = 80 + (speed / CONFIG.MAX_SPEED) * 60;\n                this.playTone(freq, 0.1, 'sawtooth', 0.1);\n            }\n\n            playDominoHit() {\n                this.playTone(800 + Math.random() * 400, 0.1, 'square', 0.2);\n            }\n\n            playDominoFall() {\n                this.playTone(200 + Math.random() * 100, 0.15, 'triangle', 0.3);\n            }\n\n            playCheckpoint() {\n                this.playTone(523, 0.1, 'sine', 0.4);\n                setTimeout(() => this.playTone(659, 0.1, 'sine', 0.4), 100);\n                setTimeout(() => this.playTone(784, 0.2, 'sine', 0.5), 200);\n            }\n\n            playDamage() {\n                this.playTone(150, 0.3, 'sawtooth', 0.5);\n                this.playTone(100, 0.3, 'square', 0.3);\n            }\n\n            playBoost() {\n                this.playTone(100, 0.1, 'sawtooth', 0.4);\n                this.playTone(150, 0.1, 'sawtooth', 0.3);\n            }\n\n            playCountdown(num) {\n                if (num > 0) {\n                    this.playTone(440, 0.2, 'sine', 0.5);\n                } else {\n                    this.playTone(880, 0.4, 'sine', 0.6);\n                }\n            }\n\n            playFinish() {\n                const notes = [523, 659, 784, 1047];\n                notes.forEach((freq, i) => {\n                    setTimeout(() => this.playTone(freq, 0.3, 'sine', 0.4), i * 150);\n                });\n            }\n        }\n\n        // ==================== PARTICLE SYSTEM ====================\n        class Particle {\n            constructor(x, y, vx, vy, color, life, size) {\n                this.x = x;\n                this.y = y;\n                this.vx = vx;\n                this.vy = vy;\n                this.color = color;\n                this.life = life;\n                this.maxLife = life;\n                this.size = size;\n            }\n\n            update(dt) {\n                this.x += this.vx * dt;\n                this.y += this.vy * dt;\n                this.vy += 200 * dt;\n                this.life -= dt;\n            }\n\n            draw(ctx) {\n                const alpha = this.life / this.maxLife;\n                ctx.save();\n                ctx.globalAlpha = alpha;\n                ctx.fillStyle = this.color;\n                ctx.shadowColor = this.color;\n                ctx.shadowBlur = 10;\n                ctx.beginPath();\n                ctx.arc(this.x, this.y, this.size * alpha, 0, Math.PI * 2);\n                ctx.fill();\n                ctx.restore();\n            }\n        }\n\n        class ParticleSystem {\n            constructor() {\n                this.particles = [];\n            }\n\n            emit(x, y, count, color, speed = 100, life = 0.5, size = 3) {\n                for (let i = 0; i < count; i++) {\n                    const angle = Math.random() * Math.PI * 2;\n                    const spd = speed * (0.5 + Math.random() * 0.5);\n                    this.particles.push(new Particle(\n                        x, y,\n                        Math.cos(angle) * spd,\n                        Math.sin(angle) * spd,\n                        color, life, size\n                    ));\n                }\n            }\n\n            update(dt) {\n                this.particles = this.particles.filter(p => {\n                    p.update(dt);\n                    return p.life > 0;\n                });\n            }\n\n            draw(ctx) {\n                this.particles.forEach(p => p.draw(ctx));\n            }\n        }\n\n        // ==================== DOMINO CLASS ====================\n        class Domino {\n            constructor(x, y, angle = 0) {\n                this.x = x;\n                this.y = y;\n                this.width = CONFIG.DOMINO_WIDTH;\n                this.height = CONFIG.DOMINO_HEIGHT;\n                this.angle = angle;\n                this.angularVelocity = 0;\n                this.isFalling = false;\n                this.hasFallen = false;\n                this.velocityX = 0;\n                this.velocityY = 0;\n                this.glowIntensity = 1;\n                this.chainReactionTriggered = false;\n            }\n\n            update(dt) {\n                if (this.isFalling) {\n                    this.angularVelocity += (CONFIG.GRAVITY / 100) * dt * (this.angle > 0 ? 1 : -1);\n                    this.angularVelocity *= 0.98;\n                    this.angle += this.angularVelocity * dt;\n\n                    if (Math.abs(this.angle) > 70) {\n                        this.hasFallen = true;\n                        this.isFalling = false;\n                        this.angle = this.angle > 0 ? 90 : -90;\n                    }\n                }\n\n                this.glowIntensity = this.isFalling ? 1.5 : (this.hasFallen ? 0.3 : 1);\n            }\n\n            push(direction, force) {\n                if (this.hasFallen) return;\n                this.isFalling = true;\n                this.angularVelocity += direction * force * 2;\n                this.chainReactionTriggered = true;\n            }\n\n            draw(ctx, cameraX) {\n                const screenX = this.x - cameraX;\n                if (screenX < -100 || screenX > ctx.canvas.width + 100) return;\n\n                ctx.save();\n                ctx.translate(screenX, this.y);\n                ctx.rotate(this.angle * Math.PI / 180);\n\n                const gradient = ctx.createLinearGradient(-this.width/2, 0, this.width/2, 0);\n                if (this.hasFallen) {\n                    gradient.addColorStop(0, '#334455');\n                    gradient.addColorStop(1, '#223344');\n                } else {\n                    gradient.addColorStop(0, '#00f5ff');\n                    gradient.addColorStop(0.5, '#0088aa');\n                    gradient.addColorStop(1, '#00f5ff');\n                }\n\n                ctx.fillStyle = gradient;\n                ctx.shadowColor = this.hasFallen ? '#334455' : '#00f5ff';\n                ctx.shadowBlur = 15 * this.glowIntensity;\n\n                const w = this.width;\n                const h = this.height;\n                const r = 4;\n\n                ctx.beginPath();\n                ctx.moveTo(-w/2 + r, -h/2);\n                ctx.lineTo(w/2 - r, -h/2);\n                ctx.quadraticCurveTo(w/2, -h/2, w/2, -h/2 + r);\n                ctx.lineTo(w/2, h/2 - r);\n                ctx.quadraticCurveTo(w/2, h/2, w/2 - r, h/2);\n                ctx.lineTo(-w/2 + r, h/2);\n                ctx.quadraticCurveTo(-w/2, h/2, -w/2, h/2 - r);\n                ctx.lineTo(-w/2, -h/2 + r);\n                ctx.quadraticCurveTo(-w/2, -h/2, -w/2 + r, -h/2);\n                ctx.fill();\n\n                ctx.strokeStyle = this.hasFallen ? '#445566' : '#00ffff';\n                ctx.lineWidth = 2;\n                ctx.stroke();\n\n                ctx.fillStyle = this.hasFallen ? '#556677' : '#00ddff';\n                ctx.shadowBlur = 5;\n                ctx.fillRect(-3, -h/2 + 10, 6, 6);\n                ctx.fillRect(-3, h/2 - 16, 6, 6);\n\n                ctx.restore();\n            }\n\n            getCorners() {\n                const cos = Math.cos(this.angle * Math.PI / 180);\n                const sin = Math.sin(this.angle * Math.PI / 180);\n                const hw = this.width / 2;\n                const hh = this.height / 2;\n\n                return [\n                    { x: this.x + (-hw * cos - (-hh) * sin), y: this.y + (-hw * sin + (-hh) * cos) },\n                    { x: this.x + (hw * cos - (-hh) * sin), y: this.y + (hw * sin + (-hh) * cos) },\n                    { x: this.x + (hw * cos - hh * sin), y: this.y + (hw * sin + hh * cos) },\n                    { x: this.x + (-hw * cos - hh * sin), y: this.y + (-hw * sin + hh * cos) }\n                ];\n            }\n        }\n\n        // ==================== PLAYER CLASS ====================\n        class Player {\n            constructor(x, y) {\n                this.x = x;\n                this.y = y;\n                this.width = 80;\n                this.height = 30;\n                this.velocityX = 0;\n                this.velocityY = 0;\n                this.speed = 0;\n                this.health = 3;\n                this.maxHealth = 3;\n                this.boost = CONFIG.BOOST_MAX;\n                this.isBoosting = false;\n                this.hoverOffset = 0;\n                this.trailParticles = [];\n                this.invulnerable = 0;\n                this.damageFlash = 0;\n            }\n\n            update(dt, input, track) {\n                // Input handling\n                let accel = 0;\n                if (input.up || input.space) accel = CONFIG.ACCELERATION;\n                if (input.down) accel = -CONFIG.ACCELERATION * 0.5;\n\n                // Boost handling\n                if (input.shift && this.boost > 0) {\n                    this.isBoosting = true;\n                    this.boost -= CONFIG.BOOST_CONSUME * dt;\n                    if (this.boost < 0) this.boost = 0;\n                } else {\n                    this.isBoosting = false;\n                    this.boost += CONFIG.BOOST_RECHARGE * dt;\n                    if (this.boost > CONFIG.BOOST_MAX) this.boost = CONFIG.BOOST_MAX;\n                }\n\n                const maxSpd = this.isBoosting ? CONFIG.BOOST_SPEED : CONFIG.MAX_SPEED;\n                this.speed += accel * dt;\n                this.speed = Math.max(-100, Math.min(maxSpd, this.speed));\n\n                // Apply friction\n                this.speed *= this.isBoosting ? 0.98 : 0.995;\n\n                // Movement\n                this.x += this.speed * dt;\n                if (input.left) this.x -= 150 * dt;\n                if (input.right) this.x += 150 * dt;\n\n                // Hover animation\n                this.hoverOffset = Math.sin(Date.now() / 150) * 3;\n\n                // Trail particles\n                if (Math.random() < (this.isBoosting ? 0.8 : 0.3)) {\n                    this.trailParticles.push({\n                        x: this.x - this.width/2 - 5,\n                        y: this.y + this.hoverOffset,\n                        life: this.isBoosting ? 0.4 : 0.2,\n                        size: this.isBoosting ? 8 : 4\n                    });\n                }\n\n                this.trailParticles = this.trailParticles.filter(p => {\n                    p.x -= 50 * dt;\n                    p.life -= dt;\n                    return p.life > 0;\n                });\n\n                // Invulnerability timer\n                if (this.invulnerable > 0) this.invulnerable -= dt;\n                if (this.damageFlash > 0) this.damageFlash -= dt;\n\n                // Keep on track\n                this.y = track.getHeightAt(this.x) - 20;\n            }\n\n            takeDamage() {\n                if (this.invulnerable > 0) return;\n                this.health--;\n                this.invulnerable = 1.5;\n                this.damageFlash = 0.3;\n                return this.health <= 0;\n            }\n\n            draw(ctx, cameraX) {\n                const screenX = this.x - cameraX;\n\n                // Draw trail\n                this.trailParticles.forEach(p => {\n                    const alpha = p.life / 0.4;\n                    ctx.save();\n                    ctx.globalAlpha = alpha * 0.6;\n                    const gradient = ctx.createRadialGradient(\n                        p.x - cameraX, p.y, 0,\n                        p.x - cameraX, p.y, p.size\n                    );\n                    gradient.addColorStop(0, this.isBoosting ? '#ffffff' : '#ff6b35');\n                    gradient.addColorStop(1, 'transparent');\n                    ctx.fillStyle = gradient;\n                    ctx.fillRect(p.x - cameraX - p.size, p.y - p.size, p.size * 2, p.size * 2);\n                    ctx.restore();\n                });\n\n                ctx.save();\n                ctx.translate(screenX, this.y + this.hoverOffset);\n\n                // Flash effect when damaged\n                if (this.damageFlash > 0) {\n                    ctx.globalAlpha = 0.5 + Math.sin(Date.now() / 30) * 0.5;\n                }\n\n                // Vehicle body\n                const bodyGradient = ctx.createLinearGradient(0, -this.height/2, 0, this.height/2);\n                bodyGradient.addColorStop(0, '#ffd700');\n                bodyGradient.addColorStop(0.5, '#ff8c00');\n                bodyGradient.addColorStop(1, '#ff6600');\n\n                ctx.fillStyle = bodyGradient;\n                ctx.shadowColor = '#ffd700';\n                ctx.shadowBlur = this.isBoosting ? 30 : 15;\n\n                // Sleek hovercraft shape\n                ctx.beginPath();\n                ctx.moveTo(-this.width/2, 0);\n                ctx.lineTo(-this.width/2 + 15, -this.height/2);\n                ctx.lineTo(this.width/2 - 10, -this.height/2);\n                ctx.lineTo(this.width/2, -this.height/4);\n                ctx.lineTo(this.width/2, this.height/4);\n                ctx.lineTo(this.width/2 - 10, this.height/2);\n                ctx.lineTo(-this.width/2 + 15, this.height/2);\n                ctx.closePath();\n                ctx.fill();\n\n                // Cockpit\n                ctx.fillStyle = '#00f5ff';\n                ctx.shadowColor = '#00f5ff';\n                ctx.shadowBlur = 10;\n                ctx.beginPath();\n                ctx.ellipse(10, -2, 15, 8, 0, 0, Math.PI * 2);\n                ctx.fill();\n\n                // Engine glow\n                ctx.fillStyle = this.isBoosting ? '#ffffff' : '#ff6b35';\n                ctx.shadowColor = this.isBoosting ? '#ffffff' : '#ff6b35';\n                ctx.shadowBlur = 20;\n                ctx.beginPath();\n                ctx.ellipse(-this.width/2 - 5, 0, 8, 12, 0, 0, Math.PI * 2);\n                ctx.fill();\n\n                ctx.restore();\n            }\n\n            getBounds() {\n                return {\n                    x: this.x - this.width/2,\n                    y: this.y - this.height/2 + this.hoverOffset,\n                    width: this.width,\n                    height: this.height\n                };\n            }\n        }\n\n        // ==================== TRACK CLASS ====================\n        class Track {\n            constructor(length) {\n                this.length = length;\n                this.dominoes = [];\n                this.generate();\n            }\n\n            generate() {\n                let x = 100;\n                let baseY = 500;\n                const segmentLength = 400;\n                const dominoSpacing = 30;\n\n                while (x < this.length - 200) {\n                    // Vary track height for interesting terrain\n                    const segmentProgress = x / this.length;\n                    const wave = Math.sin(segmentProgress * Math.PI * 4) * 80;\n                    const trend = Math.sin(segmentProgress * Math.PI * 2) * 50;\n                    \n                    const targetY = 500 + wave + trend;\n                    baseY = baseY * 0.95 + targetY * 0.05;\n\n                    // Place dominoes along track\n                    const density = Math.random() > 0.3 ? 1 : 0.5;\n                    for (let i = 0; i < 3 && x + i * dominoSpacing < this.length - 200; i++) {\n                        if (this.dominoes.length < CONFIG.MAX_DOMINOES) {\n                            const offsetX = (Math.random() - 0.5) * 40;\n                            const offsetY = (Math.random() - 0.5) * 20;\n                            this.dominoes.push(new Domino(\n                                x + i * dominoSpacing + offsetX,\n                                baseY + offsetY\n                            ));\n                        }\n                    }\n                    x += 80 + Math.random() * 60;\n                }\n            }\n\n            getHeightAt(x) {\n                const segmentProgress = x / this.length;\n                const wave = Math.sin(segmentProgress * Math.PI * 4) * 80;\n                const trend = Math.sin(segmentProgress * Math.PI * 2) * 50;\n                return 500 + wave + trend;\n            }\n\n            update(dt, player) {\n                const playerBounds = player.getBounds();\n\n                this.dominoes.forEach(domino => {\n                    if (domino.hasFallen) return;

                    // Check collision with player
                    const dominoBounds = {
                        x: domino.x - domino.width/2,
                        y: domino.y - domino.height/2,
                        width: domino.width,
                        height: domino.height
                    };

                    if (this.checkCollision(playerBounds, dominoBounds)) {
                        domino.push(player.speed > 0 ? 1 : -1, Math.abs(player.speed) / 100);
                        if (!domino.chainReactionTriggered) {
                            game.particles.emit(domino.x, domino.y, 10, '#00f5ff', 150, 0.3, 4);
                            audio.playDominoHit();
                        }
                    }

                    // Chain reaction between dominoes
                    this.dominoes.forEach(other => {
                        if (other === domino || other.hasFallen) return;
                        const dist = Math.abs(domino.x - other.x);
                        if (dist < CONFIG.CHAIN_REACTION_DISTANCE && domino.hasFallen && !other.hasFallen) {
                            const direction = domino.x < other.x ? 1 : -1;
                            if (domino.hasFallen && Math.abs(domino.angle) > 45) {
                                other.push(direction, Math.abs(domino.angularVelocity) / 50);
                                game.particles.emit(other.x, other.y, 8, '#00f5ff', 100, 0.2, 3);
                                audio.playDominoFall();
                            }
                        }
                    });
                });
            }

            checkCollision(a, b) {
                return a.x < b.x + b.width &&
                       a.x + a.width > b.x &&
                       a.y < b.y + b.height &&
                       a.y + a.height > b.y;
            }

            draw(ctx, cameraX, canvasHeight) {
                // Draw track surface
                ctx.fillStyle = '#1a1a2a';
                ctx.fillRect(0, 0, ctx.canvas.width, canvasHeight);

                // Track pattern
                ctx.strokeStyle = '#2a2a3a';
                ctx.lineWidth = 1;
                for (let x = -cameraX % 50; x < ctx.canvas.width; x += 50) {
                    ctx.beginPath();
                    ctx.moveTo(x, 0);
                    ctx.lineTo(x, canvasHeight);
                    ctx.stroke();
                }

                // Draw wavy terrain
                ctx.fillStyle = '#15152a';
                ctx.beginPath();
                ctx.moveTo(0, canvasHeight);
                for (let x = 0; x <= ctx.canvas.width; x += 5) {
                    const worldX = x + cameraX;
                    const y = canvasHeight - (this.getHeightAt(worldX) - 400);
                    ctx.lineTo(x, y);
                }
                ctx.lineTo(ctx.canvas.width, canvasHeight);
                ctx.closePath();
                ctx.fill();

                // Track edge lines
                ctx.strokeStyle = '#00f5ff33';
                ctx.lineWidth = 3;
                for (let side = -1; side <= 1; side += 2) {
                    ctx.beginPath();
                    for (let x = 0; x <= ctx.canvas.width; x += 5) {
                        const worldX = x + cameraX;
                        const baseY = this.getHeightAt(worldX);
                        const y = canvasHeight - (baseY - 400) + side * 60;
                        if (x === 0) ctx.moveTo(x, y);
                        else ctx.lineTo(x, y);
                    }
                    ctx.stroke();
                }

                // Draw dominoes
                this.dominoes.forEach(domino => domino.draw(ctx, cameraX));
            }
        }

        // ==================== GAME CLASS ====================
        class Game {
            constructor() {
                this.canvas = document.getElementById('gameCanvas');
                this.ctx = this.canvas.getContext('2d');
                this.audio = new AudioManager();
                this.particles = new ParticleSystem();

                this.state = 'menu'; // menu, countdown, playing, gameover, finished
                this.score = 0;
                this.distance = 0;
                this.bestDistance = parseInt(localStorage.getItem('dominoRacerBest') || '0');
                this.checkpoints = 0;
                this.totalCheckpoints = 10;
                this.timer = 0;
                this.countdown = 3;

                this.cameraX = 0;
                this.input = {
                    up: false, down: false, left: false, right: false,
                    shift: false, space: false
                };

                this.setupCanvas();
                this.setupInput();
                this.setupUI();
                this.lastTime = performance.now();

                window.addEventListener('resize', () => this.setupCanvas());
            }

            setupCanvas() {
                const container = document.getElementById('gameContainer');
                this.canvas.width = container.clientWidth;
                this.canvas.height = container.clientHeight;
            }

            setupInput() {
                window.addEventListener('keydown', (e) => {
                    if (e.code === 'Space') {
                        e.preventDefault();
                        if (this.state === 'menu' || this.state === 'gameover' || this.state === 'finished') {
                            this.startGame();
                        } else if (this.state === 'playing') {
                            this.input.space = true;
                        }
                    }
                    if (e.code === 'ShiftLeft' || e.code === 'ShiftRight') this.input.shift = true;
                    if (e.code === 'KeyW' || e.code === 'ArrowUp') this.input.up = true;
                    if (e.code === 'KeyS' || e.code === 'ArrowDown') this.input.down = true;
                    if (e.code === 'KeyA' || e.code === 'ArrowLeft') this.input.left = true;
                    if (e.code === 'KeyD' || e.code === 'ArrowRight') this.input.right = true;
                    if (e.code === 'KeyR') this.restart();
                    if (e.code === 'KeyM') {
                        this.audio.init();
                        this.audio.toggleMute();
                    }
                    if (e.code === 'KeyP' && this.state === 'playing') {
                        this.state = 'paused';
                    } else if (e.code === 'KeyP' && this.state === 'paused') {
                        this.state = 'playing';
                    }
                });

                window.addEventListener('keyup', (e) => {
                    if (e.code === 'Space') this.input.space = false;
                    if (e.code === 'ShiftLeft' || e.code === 'ShiftRight') this.input.shift = false;
                    if (e.code === 'KeyW' || e.code === 'ArrowUp') this.input.up = false;
                    if (e.code === 'KeyS' || e.code === 'ArrowDown') this.input.down = false;
                    if (e.code === 'KeyA' || e.code === 'ArrowLeft') this.input.left = false;
                    if (e.code === 'KeyD' || e.code === 'ArrowRight') this.input.right = false;
                });

                // Touch controls
                let touchStartX = 0;
                this.canvas.addEventListener('touchstart', (e) => {
                    e.preventDefault();
                    this.audio.init();
                    if (this.state === 'menu' || this.state === 'gameover' || this.state === 'finished') {
                        this.startGame();
                    }
                    touchStartX = e.touches[0].clientX;
                });

                this.canvas.addEventListener('touchmove', (e) => {
                    e.preventDefault();
                    const touchX = e.touches[0].clientX;
                    const diff = touchX - touchStartX;
                    this.input.left = diff < -30;
                    this.input.right = diff > 30;
                });

                this.canvas.addEventListener('touchend', () => {
                    this.input.left = false;
                    this.input.right = false;
                });
            }

            setupUI() {
                document.getElementById('highScoreDisplay').textContent = `HIGH SCORE: ${this.bestDistance}`;
                this.updateHealthDisplay();
            }

            updateHealthDisplay() {
                const container = document.getElementById('healthDisplay');
                container.innerHTML = '';
                for (let i = 0; i < this.player.maxHealth; i++) {
                    const heart = document.createElement('span');
                    heart.className = 'health-heart';
                    heart.textContent = i < this.player.health ? '❤️' : '🖤';
                    container.appendChild(heart);
                }
            }

            startGame() {
                this.audio.init();
                this.state = 'countdown';
                this.countdown = 3;
                this.score = 0;
                this.distance = 0;
                this.checkpoints = 0;
                this.timer = 0;

                this.track = new Track(CONFIG.TRACK_LENGTH);
                this.player = new Player(50, 400);
                this.particles = new ParticleSystem();
                this.cameraX = 0;

                this.updateHealthDisplay();
                document.getElementById('menuOverlay').classList.add('hidden');

                // Countdown sequence
                const countdownTick = () => {
                    this.audio.playCountdown(this.countdown);
                    if (this.countdown > 0) {
                        document.getElementById('startPrompt').textContent = this.countdown;
                        this.countdown--;
                        setTimeout(countdownTick, 1000);
                    } else {
                        document.getElementById('startPrompt').textContent = 'GO!';
                        setTimeout(() => {
                            this.state = 'playing';
                            document.getElementById('startPrompt').textContent = 'PRESS SPACE TO START';
                        }, 500);
                    }
                };
                setTimeout(countdownTick, 500);
            }

            restart() {
                this.state = 'menu';
                document.getElementById('menuOverlay').classList.remove('hidden');
                this.setupUI();
            }

            gameOver() {
                this.state = 'gameover';
                this.audio.playDamage();

                const overlay = document.getElementById('menuOverlay');
                overlay.innerHTML = `
                    <div class="game-over-title">GAME OVER</div>
                    <div class="final-score">SCORE: ${this.score}</div>
                    <div class="final-score">DISTANCE: ${Math.floor(this.distance)}m</div>
                    ${this.distance > this.bestDistance ? '<div class="new-record">NEW RECORD!</div>' : ''}
                    <div class="start-prompt">PRESS SPACE TO RETRY</div>
                `;
                overlay.classList.remove('hidden');

                if (this.distance > this.bestDistance) {
                    this.bestDistance = Math.floor(this.distance);
                    localStorage.setItem('dominoRacerBest', this.bestDistance.toString());
                }
            }

            finish() {
                this.state = 'finished';
                this.audio.playFinish();

                const overlay = document.getElementById('menuOverlay');
                const isNewRecord = this.timer < this.bestTime || !this.bestTime;

                overlay.innerHTML = `
                    <div class="game-title" style="color: var(--color-success)">FINISH!</div>
                    <div class="final-score">TIME: ${this.formatTime(this.timer)}</div>
                    <div class="final-score">SCORE: ${this.score}</div>
                    ${isNewRecord ? '<div class="new-record">NEW RECORD!</div>' : ''}
                    <div class="start-prompt">PRESS SPACE TO PLAY AGAIN</div>
                `;
                overlay.classList.remove('hidden');

                if (isNewRecord) {
                    this.bestTime = this.timer;
                    localStorage.setItem('dominoRacerBestTime', this.timer.toString());
                }
            }

            formatTime(seconds) {
                const mins = Math.floor(seconds / 60);
                const secs = Math.floor(seconds % 60);
                const ms = Math.floor((seconds % 1) * 100);
                return `${mins}:${secs.toString().padStart(2, '0')}.${ms.toString().padStart(2, '0')}`;
            }

            update(dt) {
                if (this.state !== 'playing') return;

                this.timer += dt;

                // Update player
                this.player.update(dt, this.input, this.track);

                // Update camera
                this.cameraX = this.player.x - this.canvas.width * 0.3;

                // Update track (including dominoes)
                this.track.update(dt, this.player);

                // Update particles
                this.particles.update(dt);

                // Update distance and score
                this.distance = Math.max(this.distance, this.player.x);
                const dominoesFallen = this.track.dominoes.filter(d => d.hasFallen).length;
                this.score = Math.floor(this.distance) + dominoesFallen * 100;

                // Check checkpoints
                const checkpoint = Math.floor(this.player.x / CONFIG.CHECKPOINT_INTERVAL);
                if (checkpoint > this.checkpoints && checkpoint <= CONFIG.TRACK_LENGTH / CONFIG.CHECKPOINT_INTERVAL) {
                    this.checkpoints = checkpoint;
                    this.audio.playCheckpoint();
                    this.particles.emit(this.player.x, this.player.y, 30, '#ffd700', 200, 0.5, 5);
                }

                // Check win condition
                if (this.player.x >= CONFIG.TRACK_LENGTH) {
                    this.finish();
                }

                // Check death
                if (this.player.takeDamage()) {
                    this.gameOver();
                }

                // Play engine sound
                if (Math.random() < 0.1) {
                    this.audio.playEngine(this.player.speed);
                }

                // Update UI
                document.getElementById('timerDisplay').textContent = this.formatTime(this.timer);
                document.getElementById('distanceDisplay').textContent = `DISTANCE: ${Math.floor(this.distance)}m`;
                document.getElementById('bestDisplay').textContent = `BEST: ${this.bestDistance}m`;
                document.getElementById('scoreDisplay').textContent = `SCORE: ${this.score}`;
                document.getElementById('checkpointDisplay').textContent = `CHECKPOINT ${this.checkpoints}/${this.totalCheckpoints}`;
                document.getElementById('boostFill').style.width = `${this.player.boost}%`;

                this.updateHealthDisplay();
            }

            draw() {
                const ctx = this.ctx;
                const width = this.canvas.width;
                const height = this.canvas.height;

                // Clear canvas
                ctx.fillStyle = '#0a0a0f';
                ctx.fillRect(0, 0, width, height);

                // Draw background stars
                ctx.fillStyle = '#ffffff';
                for (let i = 0; i < 50; i++) {
                    const x = (i * 73 + this.cameraX * 0.1) % width;
                    const y = (i * 137) % (height * 0.6);
                    ctx.globalAlpha = 0.3 + Math.sin(Date.now() / 1000 + i) * 0.2;
                    ctx.fillRect(x, y, 2, 2);
                }
                ctx.globalAlpha = 1;

                if (this.state === 'menu' || this.state === 'gameover' || this.state === 'finished') {
                    return;
                }

                // Draw track
                this.track.draw(ctx, this.cameraX, height);

                // Draw player
                this.player.draw(ctx, this.cameraX);

                // Draw particles
                this.particles.draw(ctx);

                // Draw speed lines when boosting
                if (this.player.isBoosting) {
                    ctx.strokeStyle = '#ffd700';
                    ctx.lineWidth = 2;
                    ctx.globalAlpha = 0.5;
                    for (let i = 0; i < 5; i++) {
                        const y = Math.random() * height;
                        const lineLength = 50 + Math.random() * 100;
                        ctx.beginPath();
                        ctx.moveTo(width - 20 - Math.random() * 50, y);
                        ctx.lineTo(width - 20 - Math.random() * 50 - lineLength, y);
                        ctx.stroke();
                    }
                    ctx.globalAlpha = 1;
                }

                // Draw countdown
                if (this.state === 'countdown') {
                    ctx.fillStyle = 'rgba(0, 0, 0, 0.5)';
                    ctx.fillRect(0, 0, width, height);

                    ctx.font = 'bold 150px Orbitron';
                    ctx.textAlign = 'center';
                    ctx.textBaseline = 'middle';

                    const text = this.countdown > 0 ? this.countdown.toString() : 'GO!';
                    const color = this.countdown > 0 ? '#00f5ff' : '#ffd700';

                    ctx.fillStyle = color;
                    ctx.shadowColor = color;
                    ctx.shadowBlur = 50;
                    ctx.fillText(text, width / 2, height / 2);
                    ctx.shadowBlur = 0;
                }

                // Draw paused state
                if (this.state === 'paused') {
                    ctx.fillStyle = 'rgba(0, 0, 0, 0.7)';
                    ctx.fillRect(0, 0, width, height);

                    ctx.font = 'bold 48px Orbitron';
                    ctx.textAlign = 'center';
                    ctx.fillStyle = '#00f5ff';
                    ctx.shadowColor = '#00f5ff';
                    ctx.shadowBlur = 20;
                    ctx.fillText('PAUSED', width / 2, height / 2);
                    ctx.font = '20px Orbitron';
                    ctx.fillText('Press P to resume', width / 2, height / 2 + 50);
                    ctx.shadowBlur = 0;
                }
            }

            run() {
                const now = performance.now();
                const dt = Math.min((now - this.lastTime) / 1000, 0.05);
                this.lastTime = now;

                this.update(dt);
                this.draw();

                requestAnimationFrame(() => this.run());
            }
        }

        // ==================== INITIALIZE GAME ====================
        const audio = new AudioManager();
        const game = new Game();
        game.run();
    </script>
</body>
</html>"}