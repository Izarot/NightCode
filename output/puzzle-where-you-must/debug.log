t-size: 1.3rem;\n      font-weight: 700;\n      color: #ffd700;\n      text-shadow: 0 0 12px rgba(255, 215, 0, 0.6);\n      letter-spacing: 2px;\n    }\n\n    #timer {\n      font-family: 'Orbitron', monospace;\n      font-size: 1.1rem;\n      color: #ff6b35;\n      text-shadow: 0 0 10px rgba(255, 107, 53, 0.5);\n      padding: 6px 14px;\n      background: rgba(58, 58, 74, 0.6);\n      border-radius: 15px;\n      border: 1px solid #ff6b35;\n      min-width: 110px;\n      text-align: center;\n    }\n\n    #highScore {\n      font-family: 'Rajdhani', sans-serif;\n      font-size: 0.9rem;\n      color: #00d9ff;\n      text-shadow: 0 0 8px rgba(0, 217, 255, 0.5);\n    }\n\n    #gearStatus {\n      font-family: 'Rajdhani', sans-serif;\n      font-size: 1rem;\n      font-weight: 600;\n      color: #e8e8e8;\n      padding: 8px 18px;\n      background: rgba(58, 58, 74, 0.6);\n      border-radius: 18px;\n      border: 1px solid #4a4a5a;\n      transition: all 0.3s ease;\n    }\n\n    #gearStatus.aligned {\n      color: #00ff88;\n      border-color: #00ff88;\n      box-shadow: 0 0 15px rgba(0, 255, 136, 0.4);\n    }\n\n    #resetBtn, #volumeBtn {\n      width: 42px;\n      height: 42px;\n      border-radius: 50%;\n      background: #3a3a4a;\n      border: 2px solid #ff6b35;\n      cursor: pointer;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      transition: all 0.2s ease;\n    }\n\n    #resetBtn:hover, #volumeBtn:hover {\n      background: #ffd700;\n      transform: scale(1.1);\n      box-shadow: 0 0 20px rgba(255, 215, 0, 0.6);\n    }\n\n    #resetBtn:active, #volumeBtn:active {\n      transform: scale(0.95);\n    }\n\n    #resetBtn svg, #volumeBtn svg {\n      width: 22px;\n      height: 22px;\n      fill: #ffd700;\n      transition: fill 0.2s ease;\n    }\n\n    #resetBtn:hover svg, #volumeBtn:hover svg {\n      fill: #1a1a2e;\n    }\n\n    #volumeBtn.muted svg {\n      fill: #666;\n    }\n\n    #victoryOverlay {\n      position: absolute;\n      top: 0;\n      left: 0;\n      right: 0;\n      bottom: 0;\n      background: rgba(10, 10, 30, 0.95);\n      display: none;\n      flex-direction: column;\n      align-items: center;\n      justify-content: center;\n      border-radius: 10px;\n      z-index: 100;\n      animation: fadeIn 0.3s ease;\n    }\n\n    @keyframes fadeIn {\n      from { opacity: 0; }\n      to { opacity: 1; }\n    }\n\n    #victoryOverlay.show {\n      display: flex;\n    }\n\n    #victoryOverlay h1 {\n      font-family: 'Orbitron', monospace;\n      font-size: 3rem;\n      font-weight: 900;\n      color: #ffd700;\n      text-shadow: 0 0 30px rgba(255, 215, 0, 0.8);\n      margin-bottom: 15px;\n      letter-spacing: 4px;\n      animation: glow 1.5s ease-in-out infinite alternate;\n    }\n\n    @keyframes glow {\n      from { text-shadow: 0 0 20px rgba(255, 215, 0, 0.5); }\n      to { text-shadow: 0 0 40px rgba(255, 215, 0, 0.9), 0 0 60px rgba(255, 107, 53, 0.4); }\n    }\n\n    #victoryOverlay p {\n      font-size: 1.2rem;\n      color: #a8a8a8;\n      margin-bottom: 15px;\n    }\n\n    #victoryStats {\n      color: #00d9ff;\n      font-size: 1rem;\n      margin-bottom: 30px;\n      font-family: 'Orbitron', monospace;\n    }\n\n    #nextLevelBtn {\n      font-family: 'Orbitron', monospace;\n      font-size: 1.1rem;\n      font-weight: 600;\n      padding: 15px 45px;\n      background: linear-gradient(135deg, #ffd700 0%, #ff6b35 100%);\n      border: none;\n      border-radius: 30px;\n      color: #1a1a2e;\n      cursor: pointer;\n      transition: all 0.3s ease;\n      box-shadow: 0 5px 30px rgba(255, 107, 53, 0.5);\n      letter-spacing: 2px;\n    }\n\n    #nextLevelBtn:hover {\n      transform: translateY(-3px);\n      box-shadow: 0 8px 40px rgba(255, 215, 0, 0.7);\n    }\n\n    #tooltip {\n      position: absolute;\n      background: rgba(15, 15, 26, 0.95);\n      border: 1px solid #ffd700;\n      padding: 8px 14px;\n      border-radius: 15px;\n      font-size: 0.85rem;\n      color: #e8e8e8;\n      pointer-events: none;\n      opacity: 0;\n      transition: opacity 0.2s ease;\n      white-space: nowrap;\n      z-index: 50;\n    }\n\n    #tooltip.show {\n      opacity: 1;\n    }\n\n    #loadingScreen {\n      position: fixed;\n      top: 0;\n      left: 0;\n      right: 0;\n      bottom: 0;\n      background: linear-gradient(135deg, #0a0a1e 0%, #1a1a2e 100%);\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      justify-content: center;\n      z-index: 1000;\n      transition: opacity 0.5s ease;\n    }\n\n    #loadingScreen.hidden {\n      opacity: 0;\n      pointer-events: none;\n    }\n\n    .loading-gear {\n      width: 80px;\n      height: 80px;\n      animation: spin 2s linear infinite;\n      filter: drop-shadow(0 0 20px rgba(255, 215, 0, 0.6));\n    }\n\n    @keyframes spin {\n      from { transform: rotate(0deg); }\n      to { transform: rotate(360deg); }\n    }\n\n    #loadingScreen p {\n      font-family: 'Orbitron', monospace;\n      margin-top: 20px;\n      color: #ffd700;\n      letter-spacing: 3px;\n    }\n\n    @media (max-width: 768px) {\n      #hud {\n        padding: 0 10px;\n        height: 50px;\n      }\n      #levelIndicator {\n        font-size: 0.9rem;\n        letter-spacing: 1px;\n      }\n      #timer {\n        font-size: 0.85rem;\n        min-width: 85px;\n        padding: 4px 8px;\n      }\n      #highScore {\n        display: none;\n      }\n      #gearStatus {\n        font-size: 0.85rem;\n        padding: 5px 10px;\n      }\n      #victoryOverlay h1 {\n        font-size: 1.8rem;\n      }\n      #nextLevelBtn {\n        font-size: 0.9rem;\n        padding: 12px 30px;\n      }\n    }\n\n    @media (max-height: 600px) {\n      #hud {\n        height: 45px;\n      }\n      #levelIndicator {\n        font-size: 0.85rem;\n      }\n      #timer {\n        font-size: 0.8rem;\n      }\n    }\n  </style>\n</head>\n<body>\n  <div id=\"loadingScreen\">\n    <svg class=\"loading-gear\" viewBox=\"0 0 100 100\">\n      <path fill=\"#ffd700\" d=\"M50 10 L55 25 L70 20 L65 35 L80 40 L68 50 L80 60 L65 65 L70 80 L55 75 L50 90 L45 75 L30 80 L35 65 L20 60 L32 50 L20 40 L35 35 L30 20 L45 25 Z\"/>\n      <circle cx=\"50\" cy=\"50\" r=\"15\" fill=\"#1a1a2e\"/>\n      <circle cx=\"50\" cy=\"50\" r=\"8\" fill=\"#ffd700\"/>\n    </svg>\n    <p>INITIALIZING</p>\n  </div>\n\n  <div id=\"gameContainer\">\n    <canvas id=\"gameCanvas\"></canvas>\n    <div id=\"hud\">\n      <div class=\"hud-section\">\n        <span id=\"levelIndicator\">LEVEL 1</span>\n        <span id=\"highScore\">BEST: --</span>\n      </div>\n      <div class=\"hud-section\">\n        <span id=\"timer\">00:00.0</span>\n        <span id=\"gearStatus\">0/0 ALIGNED</span>\n      </div>\n      <div class=\"hud-section\">\n        <button id=\"volumeBtn\" title=\"Toggle Sound\">\n          <svg viewBox=\"0 0 24 24\">\n            <path d=\"M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z\"/>\n          </svg>\n        </button>\n        <button id=\"resetBtn\" title=\"Reset Level\">\n          <svg viewBox=\"0 0 24 24\">\n            <path d=\"M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z\"/>\n          </svg>\n        </button>\n      </div>\n    </div>\n    <div id=\"victoryOverlay\">\n      <h1>GATE UNLOCKED</h1>\n      <p>All gears aligned perfectly!</p>\n      <div id=\"victoryStats\">Time: 00:00.0</div>\n      <button id=\"nextLevelBtn\">NEXT LEVEL</button>\n    </div>\n    <div id=\"tooltip\">Click to select, drag to rotate</div>\n  </div>\n\n  <script>\n    // ==================== AUDIO ENGINE ====================\n    class AudioEngine {\n      constructor() {\n        this.ctx = null;\n        this.masterGain = null;\n        this.muted = false;\n        this.initialized = false;\n        this.activeSounds = new Map();\n      }\n\n      init() {\n        if (this.initialized) return;\n        try {\n          this.ctx = new (window.AudioContext || window.webkitAudioContext)();\n          this.masterGain = this.ctx.createGain();\n          this.masterGain.connect(this.ctx.destination);\n          this.masterGain.gain.value = 0.35;\n          this.initialized = true;\n        } catch (e) {\n          console.warn('Web Audio API not supported');\n        }\n      }\n\n      toggleMute() {\n        this.muted = !this.muted;\n        if (this.masterGain) {\n          this.masterGain.gain.value = this.muted ? 0 : 0.35;\n        }\n        return this.muted;\n      }\n\n      playSelect() {\n        if (!this.initialized || this.muted) return;\n        const osc = this.ctx.createOscillator();\n        const gain = this.ctx.createGain();\n        osc.connect(gain);\n        gain.connect(this.masterGain);\n        osc.frequency.value = 900;\n        osc.type = 'square';\n        gain.gain.setValueAtTime(0.15, this.ctx.currentTime);\n        gain.gain.exponentialRampToValueAtTime(0.001, this.ctx.currentTime + 0.05);\n        osc.start();\n        osc.stop(this.ctx.currentTime + 0.05);\n      }\n\n      startRotate(gearId) {\n        if (!this.initialized || this.muted) return;\n        if (this.activeSounds.has(gearId)) return;\n        \n        const osc = this.ctx.createOscillator();\n        const gain = this.ctx.createGain();\n        const filter = this.ctx.createBiquadFilter();\n        \n        osc.connect(filter);\n        filter.connect(gain);\n        gain.connect(this.masterGain);\n        \n        osc.type = 'sawtooth';\n        osc.frequency.value = 70;\n        filter.type = 'lowpass';\n        filter.frequency.value = 250;\n        gain.gain.value = 0.06;\n        \n        osc.start();\n        this.activeSounds.set(gearId, { osc, gain, filter });\n      }\n\n      updateRotate(gearId, intensity) {\n        if (!this.activeSounds.has(gearId)) return;\n        const { gain, osc } = this.activeSounds.get(gearId);\n        osc.frequency.value = 60 + intensity * 50;\n        gain.gain.value = 0.04 + intensity * 0.06;\n      }\n\n      stopRotate(gearId) {\n        if (!this.activeSounds.has(gearId)) return;\n        const { osc, gain } = this.activeSounds.get(gearId);\n        gain.gain.exponentialRampToValueAtTime(0.001, this.ctx.currentTime + 0.1);\n        osc.stop(this.ctx.currentTime + 0.1);\n        this.activeSounds.delete(gearId);\n      }\n\n      playMesh() {\n        if (!this.initialized || this.muted) return;\n        const osc = this.ctx.createOscillator();\n        const gain = this.ctx.createGain();\n        osc.connect(gain);\n        gain.connect(this.masterGain);\n        osc.frequency.value = 460;\n        osc.type = 'triangle';\n        gain.gain.setValueAtTime(0.1, this.ctx.currentTime);\n        gain.gain.exponentialRampToValueAtTime(0.001, this.ctx.currentTime + 0.08);\n        osc.start();\n        osc.stop(this.ctx.currentTime + 0.08);\n      }\n\n      playAlignment() {\n        if (!this.initialized || this.muted) return;\n        const freqs = [523.25, 659.25, 783.99];\n        freqs.forEach((freq, i) => {\n          setTimeout(() => {\n            const osc = this.ctx.createOscillator();\n            const gain = this.ctx.createGain();\n            osc.connect(gain);\n            gain.connect(this.masterGain);\n            osc.frequency.value = freq;\n            osc.type = 'sine';\n            gain.gain.setValueAtTime(0.12, this.ctx.currentTime);\n            gain.gain.exponentialRampToValueAtTime(0.001, this.ctx.currentTime + 0.3);\n            osc.start();\n            osc.stop(this.ctx.currentTime + 0.3);\n          }, i * 100);\n        });\n      }\n\n      playSuccess() {\n        if (!this.initialized || this.muted) return;\n        const notes = [523.25, 659.25, 783.99, 1046.5, 1318.5];\n        notes.forEach((freq, i) => {\n          setTimeout(() => {\n            const osc = this.ctx.createOscillator();\n            const gain = this.ctx.createGain();\n            osc.connect(gain);\n            gain.connect(this.masterGain);\n            osc.frequency.value = freq;\n            osc.type = 'sine';\n            gain.gain.setValueAtTime(0.15, this.ctx.currentTime);\n            gain.gain.exponentialRampToValueAtTime(0.001, this.ctx.currentTime + 0.5);\n            osc.start();\n            osc.stop(this.ctx.currentTime + 0.5);\n          }, i * 120);\n        });\n      }\n\n      playGateOpen() {\n        if (!this.initialized || this.muted) return;\n        const rumble = this.ctx.createOscillator();\n        const rumbleGain = this.ctx.createGain();\n        const noise = this.ctx.createBufferSource();\n        const noiseGain = this.ctx.createGain();\n        \n        rumble.connect(rumbleGain);\n        rumbleGain.connect(this.masterGain);\n        rumble.type = 'sawtooth';\n        rumble.frequency.value = 45;\n        rumbleGain.gain.setValueAtTime(0.25, this.ctx.currentTime);\n        rumbleGain.gain.exponentialRampToValueAtTime(0.001, this.ctx.currentTime + 0.8);\n        rumble.start();\n        rumble.stop(this.ctx.currentTime + 0.8);\n\n        // Creak sound using filtered noise\n        const bufferSize = this.ctx.sampleRate * 0.6;\n        const buffer = this.ctx.createBuffer(1, bufferSize, this.ctx.sampleRate);\n        const data = buffer.getChannelData(0);\n        for (let i = 0; i < bufferSize; i++) {\n          data[i] = (Math.random() * 2 - 1) * 0.5;\n        }\n        noise.buffer = buffer;\n        const noiseFilter = this.ctx.createBiquadFilter();\n        noise.connect(noiseFilter);\n        noiseFilter.connect(noiseGain);\n        noiseGain.connect(this.masterGain);\n        noiseFilter.type = 'bandpass';\n        noiseFilter.frequency.value = 800;\n        noiseGain.gain.setValueAtTime(0.15, this.ctx.currentTime);\n        noiseGain.gain.exponentialRampToValueAtTime(0.001, this.ctx.currentTime + 0.6);\n        noise.start();\n        noise.stop(this.ctx.currentTime + 0.6);\n      }\n\n      playReset() {\n        if (!this.initialized || this.muted) return;\n        const osc = this.ctx.createOscillator();\n        const gain = this.ctx.createGain();\n        osc.connect(gain);\n        gain.connect(this.masterGain);\n        osc.frequency.setValueAtTime(350, this.ctx.currentTime);\n        osc.frequency.exponentialRampToValueAtTime(80, this.ctx.currentTime + 0.15);\n        osc.type = 'square';\n        gain.gain.setValueAtTime(0.12, this.ctx.currentTime);\n        gain.gain.exponentialRampToValueAtTime(0.001, this.ctx.currentTime + 0.15);\n        osc.start();\n        osc.stop(this.ctx.currentTime + 0.15);\n      }\n\n      playComplete() {\n        if (!this.initialized || this.muted) return;\n        const notes = [261.63, 329.63, 392.00, 523.25, 659.25, 783.99, 1046.5];\n        notes.forEach((freq, i) => {\n          setTimeout(() => {\n            const osc = this.ctx.createOscillator();\n            const gain = this.ctx.createGain();\n            osc.connect(gain);\n            gain.connect(this.masterGain);\n            osc.frequency.value = freq;\n            osc.type = 'triangle';\n            gain.gain.setValueAtTime(0.15, this.ctx.currentTime);\n            gain.gain.exponentialRampToValueAtTime(0.001, this.ctx.currentTime + 0.6);\n            osc.start();\n            osc.stop(this.ctx.currentTime + 0.6);\n          }, i * 100);\n        });\n      }\n    }\n\n    // ==================== GEAR CLASS ====================\n    class Gear {\n      constructor(config) {\n        this.id = config.id;\n        this.x = config.x;\n        this.y = config.y;\n        this.radius = config.radius;\n        this.teeth = config.teeth;\n        this.startAngle = config.startAngle || 0;\n        this.targetAngle = config.targetAngle || 0;\n        this.type = config.type || 'slave';\n        this.rotationSpeed = config.rotationSpeed || 2;\n        this.angle = this.startAngle;\n        this.targetAngleNormalized = this.normalizeAngle(this.targetAngle);\n        this.isAligned = false;\n        this.isSelected = false;\n        this.rotationVelocity = 0;\n        this.meshPartners = [];\n        this.dustParticles = [];\n      }\n\n      normalizeAngle(angle) {\n        return ((angle % 360) + 360) % 360;\n      }\n\n      getAngleDifference() {\n        const diff = Math.abs(this.normalizeAngle(this.angle) - this.targetAngleNormalized);\n        return Math.min(diff, 360 - diff);\n      }\n\n      checkAlignment() {\n        const diff = this.getAngleDifference();\n        const wasAligned = this.isAligned;\n        this.isAligned = diff <= 3 || diff >= 357;\n        return !wasAligned && this.isAligned;\n      }\n\n      containsPoint(px, py) {\n        const dx = px - this.x;\n        const dy = py - this.y;\n        return Math.sqrt(dx * dx + dy * dy) <= this.radius + 18;\n      }\n\n      draw(ctx, time) {\n        ctx.save();\n        ctx.translate(this.x, this.y);\n\n        ctx.shadowColor = 'transparent';\n        ctx.shadowBlur = 0;\n\n        // Selection glow\n        if (this.isSelected) {\n          const pulse = Math.sin(time * 0.005) * 0.3 + 0.7;\n          ctx.shadowColor = '#ffd700';\n          ctx.shadowBlur = 25 * pulse;\n        }\n\n        // Alignment glow\n        if (this.isAligned) {\n          ctx.shadowColor = '#00ff88';\n          ctx.shadowBlur = 18;\n        }\n\n        const toothHeight = this.radius * 0.16;\n        let baseColor, accentColor, darkColor;\n        \n        switch (this.type) {\n          case 'master':\n            baseColor = '#ff6b35';\n            accentColor = '#ffd700';\n            darkColor = '#8b3a1a';\n            break;\n          case 'locked':\n            baseColor = '#8b4513';\n            accentColor = '#cd853f';\n            darkColor = '#5a2e0c';\n            break;\n          case 'lever':\n            baseColor = '#00d9ff';\n            accentColor = '#7dffff';\n            darkColor = '#006a7a';\n            break;\n          default:\n            baseColor = '#5a5a7a';\n            accentColor = '#8a8aaa';\n            darkColor = '#3a3a5a';\n        }\n\n        const gradient = ctx.createRadialGradient(-this.radius * 0.3, -this.radius * 0.3, 0, 0, 0, this.radius);\n        gradient.addColorStop(0, accentColor);\n        gradient.addColorStop(0.5, baseColor);\n        gradient.addColorStop(1, darkColor);\n\n        // Draw teeth\n        ctx.fillStyle = gradient;\n        ctx.beginPath();\n        const toothWidth = (2 * Math.PI) / (this.teeth * 2);\n        \n        for (let i = 0; i < this.teeth; i++) {\n          const a1 = (i / this.teeth) * Math.PI * 2 + this.angle;\n          const a2 = a1 + toothWidth * 0.4;\n          const a3 = a1 + toothWidth;\n          \n          ctx.lineTo(\n            Math.cos(a1 - toothWidth * 0.3) * this.radius,\n            Math.sin(a1 - toothWidth * 0.3) * this.radius\n          );\n          ctx.lineTo(\n            Math.cos(a1 - toothWidth * 0.1) * (this.radius + toothHeight),\n            Math.sin(a1 - toothWidth * 0.1) * (this.radius + toothHeight)\n          );\n          ctx.lineTo(\n            Math.cos(a1 + toothWidth * 0.5) * (this.radius + toothHeight),\n            Math.sin(a1 + toothWidth * 0.5) * (this.radius + toothHeight)\n          );\n          ctx.lineTo(\n            Math.cos(a1 + toothWidth * 0.7) * this.radius,\n            Math.sin(a1 + toothWidth * 0.7) * this.radius\n          );\n        }\n        ctx.closePath();\n        ctx.fill();\n        ctx.strokeStyle = darkColor;\n        ctx.lineWidth = 1.5;\n        ctx.stroke();\n\n        ctx.shadowColor = 'transparent';\n        ctx.shadowBlur = 0;\n\n        // Main body\n        const bodyGrad = ctx.createRadialGradient(-this.radius * 0.4, -this.radius * 0.4, 0, 0, 0, this.radius * 0.9);\n        bodyGrad.addColorStop(0, accentColor);\n        bodyGrad.addColorStop(0.7, baseColor);\n        bodyGrad.addColorStop(1, darkColor);\n        ctx.beginPath();\n        ctx.arc(0, 0, this.radius * 0.88, 0, Math.PI * 2);\n        ctx.fillStyle = bodyGrad;\n        ctx.fill();\n        ctx.strokeStyle = darkColor;\n        ctx.lineWidth = 2;\n        ctx.stroke();\n\n        // Spokes\n        const spokeCount = Math.max(4, Math.floor(this.teeth / 3));\n        ctx.strokeStyle = darkColor;\n        ctx.lineWidth = this.radius * 0.08;\n        for (let i = 0; i < spokeCount; i++) {\n          const sa = (i / spokeCount) * Math.PI * 2 + this.angle;\n          ctx.beginPath();\n          ctx.moveTo(Math.cos(sa) * this.radius * 0.2, Math.sin(sa) * this.radius * 0.2);\n          ctx.lineTo(Math.cos(sa) * this.radius * 0.78, Math.sin(sa) * this.radius * 0.78);\n          ctx.stroke();\n        }\n\n        // Center hub\n        const hubGrad = ctx.createRadialGradient(-this.radius * 0.05, -this.radius * 0.05, 0, 0, 0, this.radius * 0.25);\n        hubGrad.addColorStop(0, accentColor);\n        hubGrad.addColorStop(0.6, baseColor);\n        hubGrad.addColorStop(1, darkColor);\n        ctx.beginPath();\n        ctx.arc(0, 0, this.radius * 0.25, 0, Math.PI * 2);\n        ctx.fillStyle = hubGrad;\n        ctx.fill();\n        ctx.strokeStyle = darkColor;\n        ctx.lineWidth = 1.5;\n        ctx.stroke();\n\n        // Center hole\n        ctx.beginPath();\n        ctx.arc(0, 0, this.radius * 0.1, 0, Math.PI * 2);\n        ctx.fillStyle = '#0a0a1e';\n        ctx.fill();\n\n        // Rivets\n        const rivetCount = 6;\n        const rivetRadius = this.radius * 0.42;\n        for (let i = 0; i < rivetCount; i++) {\n          const ra = (i / rivetCount) * Math.PI * 2 + this.angle * 0.3;\n          const rx = Math.cos(ra) * rivetRadius;\n          const ry = Math.sin(ra) * rivetRadius;\n          \n          ctx.beginPath();\n          ctx.arc(rx, ry, 3.5, 0, Math.PI * 2);\n          const rg = ctx.createRadialGradient(rx - 1, ry - 1, 0, rx, ry, 3.5);\n          rg.addColorStop(0, '#aaaabc');\n          rg.addColorStop(1, '#3a3a5a');\n          ctx.fillStyle = rg;\n          ctx.fill();\n          ctx.strokeStyle = darkColor;\n          ctx.lineWidth = 0.5;\n          ctx.stroke();\n        }\n\n        // Target indicators\n        if (!this.isAligned) {\n          const indicatorPulse = Math.sin(time * 0.004) * 0.3 + 0.7;\n          const proximity = 1 - (this.getAngleDifference() / 180);
          ctx.strokeStyle = `rgba(255, 215, 0, ${indicatorPulse * 0.5})`;
          ctx.lineWidth = 2;
          ctx.setLineDash([5, 5]);
          ctx.beginPath();
          ctx.arc(0, 0, this.radius * 1.35, 0, Math.PI * 2);
          ctx.stroke();
          ctx.setLineDash([]);

          // Target angle marker
          ctx.save();
          ctx.rotate(this.targetAngle * Math.PI / 180);
          ctx.beginPath();
          ctx.moveTo(this.radius * 0.9, -5);
          ctx.lineTo(this.radius * 1.2, -3);
          ctx.lineTo(this.radius * 1.2, 3);
          ctx.lineTo(this.radius * 0.9, 5);
          ctx.closePath();
          ctx.fillStyle = `rgba(0, 255, 136, ${indicatorPulse * 0.7})`;
          ctx.fill();
          ctx.restore();
        }

        ctx.restore();
      }
    }

    // ==================== LEVER CLASS ====================
    class Lever {
      constructor(config) {
        this.id = config.id;
        this.x = config.x;
        this.y = config.y;
        this.length = config.length || 80;
        this.targetAngle = config.targetAngle || 45;
        this.angle = config.startAngle || -45;
        this.isSelected = false;
        this.isPulled = false;
        this.targetReached = false;
        this.animationProgress = 0;
      }

      containsPoint(px, py) {
        const handleX = this.x + Math.cos(this.angle * Math.PI / 180) * this.length;
        const handleY = this.y + Math.sin(this.angle * Math.PI / 180) * this.length;
        const dx = px - handleX;
        const dy = py - handleY;
        return Math.sqrt(dx * dx + dy * dy) <= 20;
      }

      draw(ctx, time) {
        ctx.save();
        ctx.translate(this.x, this.y);

        // Base mount
        ctx.fillStyle = '#3a3a4a';
        ctx.beginPath();
        ctx.arc(0, 0, 15, 0, Math.PI * 2);
        ctx.fill();
        ctx.strokeStyle = '#2a2a3a';
        ctx.lineWidth = 2;
        ctx.stroke();

        // Arm
        ctx.rotate(this.angle * Math.PI / 180);
        
        const gradient = ctx.createLinearGradient(0, -8, 0, 8);
        gradient.addColorStop(0, '#00d9ff');
        gradient.addColorStop(0.5, '#008899');
        gradient.addColorStop(1, '#004455');
        
        ctx.fillStyle = gradient;
        ctx.beginPath();
        ctx.roundRect(0, -6, this.length, 12, 4);
        ctx.fill();
        ctx.strokeStyle = '#004455';
        ctx.lineWidth = 1.5;
        ctx.stroke();

        // Handle
        const handleX = this.length;
        const pulse = Math.sin(time * 0.005) * 0.2 + 0.8;
        
        ctx.shadowColor = this.isSelected ? '#ffd700' : '#00d9ff';
        ctx.shadowBlur = this.isSelected ? 15 : 8 * pulse;
        
        ctx.beginPath();
        ctx.arc(handleX, 0, 14, 0, Math.PI * 2);
        ctx.fillStyle = this.isSelected ? '#ffd700' : '#00d9ff';
        ctx.fill();
        ctx.strokeStyle = '#008899';
        ctx.lineWidth = 2;
        ctx.stroke();

        // Handle grip lines
        ctx.strokeStyle = '#004455';
        ctx.lineWidth = 1.5;
        for (let i = -6; i <= 6; i += 4) {
          ctx.beginPath();
          ctx.moveTo(handleX - 8, i);
          ctx.lineTo(handleX + 8, i);
          ctx.stroke();
        }

        ctx.restore();
      }
    }

    // ==================== GATE CLASS ====================
    class Gate {
      constructor(config) {
        this.x = config.x;
        this.y = config.y;
        this.width = config.width || 200;
        this.height = config.height || 300;
        this.isOpen = false;
        this.openProgress = 0;
        this.sections = config.sections || 4;
        this.barColor = '#8b4513';
        this.accentColor = '#cd853f';
      }

      draw(ctx, time) {
        ctx.save();
        ctx.translate(this.x, this.y);

        // Frame
        const frameGrad = ctx.createLinearGradient(-this.width/2 - 15, 0, this.width/2 + 15, 0);
        frameGrad.addColorStop(0, '#4a3728');
        frameGrad.addColorStop(0.5, '#6b4c35');
        frameGrad.addColorStop(1, '#4a3728');
        
        // Left frame
        ctx.fillStyle = frameGrad;
        ctx.fillRect(-this.width/2 - 15, -this.height/2 - 20, 15, this.height + 40);
        ctx.strokeStyle = '#3a2718';
        ctx.lineWidth = 2;
        ctx.strokeRect(-this.width/2 - 15, -this.height/2 - 20, 15, this.height + 40);

        // Right frame
        ctx.fillRect(this.width/2, -this.height/2 - 20, 15, this.height + 40);
        ctx.strokeRect(this.width/2, -this.height/2 - 20, 15, this.height + 40);

        // Top frame
        ctx.fillRect(-this.width/2 - 15, -this.height/2 - 20, this.width + 30, 15);
        ctx.strokeRect(-this.width/2 - 15, -this.height/2 - 20, this.width + 30, 15);

        // Bottom frame
        ctx.fillRect(-this.width/2 - 15, this.height/2, this.width + 30, 15);
        ctx.strokeRect(-this.width/2 - 15, this.height/2, this.width + 30, 15);

        // Bars
        const barSpacing = this.width / this.sections;
        const openOffset = this.openProgress * (this.width / 2 + 10);
        
        for (let i = 0; i <= this.sections; i++) {
          const bx = -this.width/2 + i * barSpacing - openOffset * (i <= this.sections/2 ? 1 : -1) * (i - this.sections/2);
          
          const barGrad = ctx.createLinearGradient(bx - 4, 0, bx + 4, 0);
          barGrad.addColorStop(0, this.accentColor);
          barGrad.addColorStop(0.5, this.barColor);
          barGrad.addColorStop(1, '#5a3010');
          
          ctx.fillStyle = barGrad;
          ctx.fillRect(bx - 4, -this.height/2, 8, this.height);
          ctx.strokeStyle = '#3a2008';
          ctx.lineWidth = 1;
          ctx.strokeRect(bx - 4, -this.height/2, 8, this.height);

          // Rivets on bars
          ctx.fillStyle = '#888';
          ctx.beginPath();
          ctx.arc(bx, -this.height/2 + 10, 3, 0, Math.PI * 2);
          ctx.fill();
          ctx.beginPath();
          ctx.arc(bx, this.height/2 - 10, 3, 0, Math.PI * 2);
          ctx.fill();
        }

        // Decorative elements
        ctx.fillStyle = '#ffd700';
        ctx.beginPath();
        ctx.arc(-this.width/2 - 8, -this.height/2 - 12, 6, 0, Math.PI * 2);
        ctx.fill();
        ctx.beginPath();
        ctx.arc(this.width/2 + 8, -this.height/2 - 12, 6, 0, Math.PI * 2);
        ctx.fill();

        ctx.restore();
      }
    }

    // ==================== DUST PARTICLE CLASS ====================
    class DustParticle {
      constructor(x, y) {
        this.x = x;
        this.y = y;
        this.vx = (Math.random() - 0.5) * 4;
        this.vy = (Math.random() - 0.5) * 4;
        this.life = 1;
        this.decay = 0.02 + Math.random() * 0.02;
        this.size = 2 + Math.random() * 3;
        this.color = Math.random() > 0.5 ? '#ffd700' : '#ff6b35';
      }

      update() {
        this.x += this.vx;
        this.y += this.vy;
        this.vy += 0.1;
        this.life -= this.decay;
        this.size *= 0.98;
      }

      draw(ctx) {
        ctx.globalAlpha = this.life;
        ctx.fillStyle = this.color;
        ctx.beginPath();
        ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);
        ctx.fill();
        ctx.globalAlpha = 1;
      }

      isDead() {
        return this.life <= 0;
      }
    }

