    // ==================== GAME ENGINE ====================
    class Game {
      constructor() {
        this.canvas = document.getElementById('gameCanvas');
        this.ctx = this.canvas.getContext('2d');
        this.audio = new AudioEngine();
        
        this.currentLevel = 0;
        this.gears = [];
        this.levers = [];
        this.gate = null;
        this.particles = [];
        
        this.selectedGear = null;
        this.selectedLever = null;
        this.isDragging = false;
        this.lastMouseX = 0;
        this.lastMouseY = 0;
        
        this.timer = 0;
        this.timerStarted = false;
        this.levelComplete = false;
        this.gameComplete = false;
        
        this.highScores = this.loadHighScores();
        
        this.setupCanvas();
        this.setupEventListeners();
        this.loadLevel(0);
        
        this.lastTime = 0;
        this.gameLoop(0);
      }

      loadHighScores() {
        try {
          return JSON.parse(localStorage.getItem('gearGateHighScores')) || {};
        } catch (e) {
          return {};
        }
      }

      saveHighScores() {
        try {
          localStorage.setItem('gearGateHighScores', JSON.stringify(this.highScores));
        } catch (e) {}
      }

      setupCanvas() {
        const resize = () => {
          const container = document.getElementById('gameContainer');
          const rect = container.getBoundingClientRect();
          this.canvas.width = rect.width * window.devicePixelRatio;
          this.canvas.height = rect.height * window.devicePixelRatio;
          this.ctx.scale(window.devicePixelRatio, window.devicePixelRatio);
          this.canvasWidth = rect.width;
          this.canvasHeight = rect.height;
        };
        
        resize();
        window.addEventListener('resize', resize);
      }

      setupEventListeners() {
        // Mouse events
        this.canvas.addEventListener('mousedown', (e) => this.handlePointerDown(e));
        this.canvas.addEventListener('mousemove', (e) => this.handlePointerMove(e));
        this.canvas.addEventListener('mouseup', () => this.handlePointerUp());
        this.canvas.addEventListener('mouseleave', () => this.handlePointerUp());

        // Touch events
        this.canvas.addEventListener('touchstart', (e) => {
          e.preventDefault();
          this.handlePointerDown(e.touches[0]);
        });
        this.canvas.addEventListener('touchmove', (e) => {
          e.preventDefault();
          this.handlePointerMove(e.touches[0]);
        });
        this.canvas.addEventListener('touchend', () => this.handlePointerUp());

        // HUD buttons
        document.getElementById('resetBtn').addEventListener('click', () => this.resetLevel());
        document.getElementById('volumeBtn').addEventListener('click', () => {
          this.audio.init();
          const muted = this.audio.toggleMute();
          document.getElementById('volumeBtn').classList.toggle('muted', muted);
        });
        document.getElementById('nextLevelBtn').addEventListener('click', () => this.nextLevel());

        // Initialize audio on first interaction
        document.body.addEventListener('click', () => this.audio.init(), { once: true });
        document.body.addEventListener('touchstart', () => this.audio.init(), { once: true });
      }

      getCanvasCoords(e) {
        const rect = this.canvas.getBoundingClientRect();
        return {
          x: e.clientX - rect.left,
          y: e.clientY - rect.top
        };
      }

      handlePointerDown(e) {
        if (this.levelComplete) return;
        
        const coords = this.getCanvasCoords(e);
        this.lastMouseX = coords.x;
        this.lastMouseY = coords.y;

        // Check levers first
        for (const lever of this.levers) {
          if (lever.containsPoint(coords.x, coords.y)) {
            this.selectedLever = lever;
            lever.isSelected = true;
            this.isDragging = true;
            this.audio.playSelect();
            return;
          }
        }

        // Check gears
        for (const gear of this.gears) {
          if (gear.containsPoint(coords.x, coords.y)) {
            if (gear.type === 'locked') {
              this.audio.playSelect();
              return;
            }
            this.selectedGear = gear;
            gear.isSelected = true;
            this.isDragging = true;
            this.audio.playSelect();
            this.audio.startRotate(gear.id);
            
            if (!this.timerStarted) {
              this.timerStarted = true;
            }
            return;
          }
        }
      }

      handlePointerMove(e) {
        if (!this.isDragging) return;
        
        const coords = this.getCanvasCoords(e);
        const dx = coords.x - this.lastMouseX;
        const dy = coords.y - this.lastMouseY;

        if (this.selectedLever) {
          const angle = Math.atan2(coords.y - this.selectedLever.y, coords.x - this.selectedLever.x);
          const degrees = angle * 180 / Math.PI;
          this.selectedLever.angle = Math.max(-60, Math.min(60, degrees));
          
          // Check if lever reached target
          if (!this.selectedLever.targetReached) {
            if (Math.abs(this.selectedLever.angle - this.selectedLever.targetAngle) < 5) {
              this.selectedLever.targetReached = true;
              this.selectedLever.angle = this.selectedLever.targetAngle;
              this.audio.playAlignment();
              this.activateGearsFromLever(this.selectedLever);
            }
          }
        } else if (this.selectedGear) {
          const sensitivity = 0.5;
          this.selectedGear.angle += dx * sensitivity;
          
          const intensity = Math.min(1, Math.abs(dx) / 10);
          this.audio.updateRotate(this.selectedGear.id, intensity);
          
          // Create dust particles when rotating
          if (Math.random() > 0.7) {
            const angle = Math.atan2(coords.y - this.selectedGear.y, coords.x - this.selectedGear.x);
            const dist = this.selectedGear.radius + 10;
            this.particles.push(new DustParticle(
              this.selectedGear.x + Math.cos(angle) * dist,
              this.selectedGear.y + Math.sin(angle) * dist
            ));
          }
          
          // Check alignment
          if (this.selectedGear.checkAlignment()) {
            this.audio.playAlignment();
            this.spawnAlignmentParticles(this.selectedGear);
            this.updateGearStatus();
            this.checkVictory();
          }
        }

        this.lastMouseX = coords.x;
        this.lastMouseY = coords.y;
      }

      handlePointerUp() {
        if (this.selectedGear) {
          this.audio.stopRotate(this.selectedGear.id);
          this.selectedGear.isSelected = false;
          this.selectedGear = null;
        }
        if (this.selectedLever) {
          this.selectedLever.isSelected = false;
          this.selectedLever = null;
        }
        this.isDragging = false;
      }

      activateGearsFromLever(lever) {
        // When lever is pulled, activate connected gears
        for (const gear of this.gears) {
          if (gear.type === 'slave' && !gear.isAligned) {
            gear.angle += 180;
            if (gear.checkAlignment()) {
              this.audio.playAlignment();
              this.spawnAlignmentParticles(gear);
              this.updateGearStatus();
              this.checkVictory();
            }
          }
        }
      }

      spawnAlignmentParticles(gear) {
        for (let i = 0; i < 15; i++) {
          const angle = Math.random() * Math.PI * 2;
          const dist = gear.radius * 0.8;
          this.particles.push(new DustParticle(
            gear.x + Math.cos(angle) * dist,
            gear.y + Math.sin(angle) * dist
          ));
        }
      }

      loadLevel(levelIndex) {
        if (levelIndex >= LEVELS.length) {
          this.gameComplete = true;
          this.showGameComplete();
          return;
        }

        const level = LEVELS[levelIndex];
        this.currentLevel = levelIndex;
        
        this.gears = level.gears.map(g => {
          const scaled = { ...g };
          scaled.x = g.x * this.canvasWidth;
          scaled.y = g.y * this.canvasHeight;
          return new Gear(scaled);
        });

        this.levers = level.levers.map(l => {
          const scaled = { ...l };
          scaled.x = l.x * this.canvasWidth;
          scaled.y = l.y * this.canvasHeight;
          return new Lever(scaled);
        });

        if (level.gate) {
          const g = level.gate;
          this.gate = new Gate({
            x: g.x * this.canvasWidth,
            y: g.y * this.canvasHeight,
            width: g.width,
            height: g.height
          });
        }

        this.particles = [];
        this.selectedGear = null;
        this.selectedLever = null;
        this.isDragging = false;
        this.timer = 0;
        this.timerStarted = false;
        this.levelComplete = false;

        this.updateUI();
        document.getElementById('victoryOverlay').classList.remove('show');
        
        // Update high score display
        const highScore = this.highScores[levelIndex];
        document.getElementById('highScore').textContent = highScore ? `BEST: ${this.formatTime(highScore)}` : 'BEST: --';
      }

      resetLevel() {
        this.audio.playReset();
        this.loadLevel(this.currentLevel);
      }

      nextLevel() {
        this.audio.playSelect();
        this.loadLevel(this.currentLevel + 1);
      }

      updateGearStatus() {
        const total = this.gears.filter(g => g.type !== 'locked').length;
        const aligned = this.gears.filter(g => g.type !== 'locked' && g.isAligned).length;
        const status = document.getElementById('gearStatus');
        status.textContent = `${aligned}/${total} ALIGNED`;
        status.classList.toggle('aligned', aligned === total);
      }

      checkVictory() {
        const allAligned = this.gears.filter(g => g.type !== 'locked').every(g => g.isAligned);
        const leverComplete = this.levers.every(l => l.targetReached);
        
        if (allAligned && (this.levers.length === 0 || leverComplete) && !this.levelComplete) {
          this.levelComplete = true;
          this.audio.playSuccess();
          
          // Save high score
          if (!this.highScores[this.currentLevel] || this.timer < this.highScores[this.currentLevel]) {
            this.highScores[this.currentLevel] = this.timer;
            this.saveHighScores();
          }
          
          setTimeout(() => {
            this.audio.playGateOpen();
            this.animateGateOpen();
          }, 500);
        }
      }

      animateGateOpen() {
        const animate = () => {
          this.gate.openProgress += 0.02;
          if (this.gate.openProgress >= 1) {
            this.showVictoryOverlay();
            return;
          }
          requestAnimationFrame(animate);
        };
        animate();
      }

      showVictoryOverlay() {
        this.audio.playComplete();
        document.getElementById('victoryStats').textContent = `Time: ${this.formatTime(this.timer)}`;
        document.getElementById('victoryOverlay').classList.add('show');
        
        const btn = document.getElementById('nextLevelBtn');
        if (this.currentLevel >= LEVELS.length - 1) {
          btn.textContent = 'PLAY AGAIN';
        } else {
          btn.textContent = 'NEXT LEVEL';
        }
      }

      showGameComplete() {
        document.getElementById('victoryOverlay').innerHTML = `
          <h1>MASTER ENGINEER</h1>
          <p>You've conquered all mechanisms!</p>
          <div id="victoryStats">All 10 levels completed</div>
          <button id="nextLevelBtn" onclick="game.loadLevel(0)">PLAY AGAIN</button>
        `;
        document.getElementById('victoryOverlay').classList.add('show');
      }

      formatTime(seconds) {
        const mins = Math.floor(seconds / 60);
        const secs = Math.floor(seconds % 60);
        const tenths = Math.floor((seconds % 1) * 10);
        return `${mins.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}.${tenths}`;
      }

      updateUI() {
        document.getElementById('levelIndicator').textContent = `LEVEL ${this.currentLevel + 1}`;
        document.getElementById('timer').textContent = this.formatTime(this.timer);
        this.updateGearStatus();
      }

      update(deltaTime) {
        if (!this.levelComplete && this.timerStarted) {
          this.timer += deltaTime / 1000;
          this.updateUI();
        }

        // Update particles
        this.particles = this.particles.filter(p => {
          p.update();
          return !p.isDead();
        });
      }

      draw(time) {
        this.ctx.clearRect(0, 0, this.canvasWidth, this.canvasHeight);

        // Background
        const bgGrad = this.ctx.createLinearGradient(0, 0, this.canvasWidth, this.canvasHeight);
        bgGrad.addColorStop(0, '#1a1a2e');
        bgGrad.addColorStop(0.5, '#16213e');
        bgGrad.addColorStop(1, '#1a1a2e');
        this.ctx.fillStyle = bgGrad;
        this.ctx.fillRect(0, 0, this.canvasWidth, this.canvasHeight);

        // Grid pattern
        this.ctx.strokeStyle = 'rgba(58, 58, 74, 0.3)';
        this.ctx.lineWidth = 1;
        const gridSize = 40;
        for (let x = 0; x < this.canvasWidth; x += gridSize) {
          this.ctx.beginPath();
          this.ctx.moveTo(x, 0);
          this.ctx.lineTo(x, this.canvasHeight);
          this.ctx.stroke();
        }
        for (let y = 0; y < this.canvasHeight; y += gridSize) {
          this.ctx.beginPath();
          this.ctx.moveTo(0, y);
          this.ctx.lineTo(this.canvasWidth, y);
          this.ctx.stroke();
        }

        // Draw gate (behind gears)
        if (this.gate) {
          this.gate.draw(this.ctx, time);
        }

        // Draw levers
        for (const lever of this.levers) {
          lever.draw(this.ctx, time);
        }

        // Draw gears
        for (const gear of this.gears) {
          gear.draw(this.ctx, time);
        }

        // Draw particles
        for (const particle of this.particles) {
          particle.draw(this.ctx);
        }
      }

      gameLoop(time) {
        const deltaTime = time - this.lastTime;
        this.lastTime = time;

        this.update(deltaTime);
        this.draw(time);

        requestAnimationFrame((t) => this.gameLoop(t));
      }
    }

    // ==================== INITIALIZATION ====================
    let game;
    
    window.addEventListener('load', () => {
      // Hide loading screen after fonts load
      setTimeout(() => {
        document.getElementById('loadingScreen').classList.add('hidden');
        game = new Game();
      }, 1500);
    });
  </script>
</body>
</html>
"}