  "game.js": "class Game {\n    constructor(canvas) {\n        this.canvas = canvas;\n        this.ctx = canvas.getContext('2d');\n        this.width = canvas.width;\n        this.height = canvas.height;\n        \n        // Game state\n        this.stardust = 0;\n        this.highScore = 0;\n        this.running = false;\n        this.lastTimestamp = 0;\n        this.spawnTimer = 0;\n        this.spawnInterval = 2.0; // seconds, will be randomized\n        this.wind = { x: 0, y: 0 };\n        this.windTimer = 0;\n        this.milestone = 100;\n        this.milestoneActive = false;\n        this.milestoneTimer = 0;\n        \n        // Speedrun timer\n        this.startTime = 0;\n        this.elapsedTime = 0;\n        \n        // Audio context\n        this.audioContext = null;\n        this.initAudio();\n        \n        // Initialize components\n        this.avatar = new Avatar(this.width / 2, this.height / 2);\n        this.particles = [];\n        this.effects = [];\n        this.upgrades = {\n            spawnRate: { level: 0, baseCost: 50, name: 'Faster Spawns' },\n            particleValue: { level: 0, baseCost: 75, name: '+1 Value' },\n            collectionRadius: { level: 0, baseCost: 100, name: 'Larger Radius' }\n        };\n        \n        // Load high score\n        this.loadHighScore();\n        \n        // Setup event listeners\n        this.setupEventListeners();\n        \n        // Initialize UI\n        this.ui = new UI(this);\n        this.ui.init();\n        \n        // Start game loop\n        this.running = true;\n        requestAnimationFrame(this.gameLoop.bind(this));\n    }\n    \n    initAudio() {\n        try {\n            this.audioContext = new (window.AudioContext || window.webkitAudioContext)();\n        } catch (e) {\n            console.log('Web Audio API not supported');\n        }\n    }\n    \n    playSound(type) {\n        if (!this.audioContext) return;\n        \n        const oscillator = this.audioContext.createOscillator();\n        const gainNode = this.audioContext.createGain();\n        \n        oscillator.connect(gainNode);\n        gainNode.connect(this.audioContext.destination);\n        \n        if (type === 'collect') {\n            oscillator.frequency.setValueAtTime(880, this.audioContext.currentTime);\n            oscillator.frequency.exponentialRampToValueAtTime(440, this.audioContext.currentTime + 0.1);\n            gainNode.gain.setValueAtTime(0.1, this.audioContext.currentTime);\n            gainNode.gain.exponentialRampToValueAtTime(0.001, this.audioContext.currentTime + 0.1);\n            oscillator.start(this.audioContext.currentTime);\n            oscillator.stop(this.audioContext.currentTime + 0.1);\n        } else if (type === 'milestone') {\n            oscillator.frequency.setValueAtTime(330, this.audioContext.currentTime);\n            oscillator.frequency.exponentialRampToValueAtTime(660, this.audioContext.currentTime + 0.3);\n            gainNode.gain.setValueAtTime(0.15, this.audioContext.currentTime);\n            gainNode.gain.exponentialRampToValueAtTime(0.001, this.audioContext.currentTime + 0.3);\n            oscillator.start(this.audioContext.currentTime);\n            oscillator.stop(this.audioContext.currentTime + 0.3);\n        } else if (type === 'upgrade') {\n            oscillator.frequency.setValueAtTime(660, this.audioContext.currentTime);\n            oscillator.frequency.exponentialRampToValueAtTime(1320, this.audioContext.currentTime + 0.15);\n            gainNode.gain.setValueAtTime(0.1, this.audioContext.currentTime);\n            gainNode.gain.exponentialRampToValueAtTime(0.001, this.audioContext.currentTime + 0.15);\n            oscillator.start(this.audioContext.currentTime);\n            oscillator.stop(this.audioContext.currentTime + 0.15);\n        }\n    }\n    \n    setupEventListeners() {\n        // Mouse events\n        this.canvas.addEventListener('mousedown', (e) => {\n            this.avatar.startDrag(this.getMousePos(e));\n        });\n        \n        this.canvas.addEventListener('mousemove', (e) => {\n            if (this.avatar.dragging) {\n                this.avatar.setPosition(this.getMousePos(e));\n            }\n        });\n        \n        document.addEventListener('mouseup', () => {\n            this.avatar.stopDrag();\n        });\n        \n        // Touch events\n        this.canvas.addEventListener('touchstart', (e) => {\n            e.preventDefault();\n            if (e.touches.length === 1) {\n                this.avatar.startDrag(this.getTouchPos(e));\n            } \n        });\n        \n        this.canvas.addEventListener('touchmove', (e) => {\n            e.preventDefault();\n            if (this.avatar.dragging && e.touches.length === 1) {\n                this.avatar.setPosition(this.getTouchPos(e));\n            }\n        });\n        \n        this.canvas.addEventListener('touchend', (e) => {\n            e.preventDefault();\n            this.avatar.stopDrag();\n        });\n        \n        // Keyboard events\n        document.addEventListener('keydown', (e) => {\n            this.avatar.setKey(e.key, true);\n        });\n        \n        document.addEventListener('keyup', (e) => {\n            this.avatar.setKey(e.key, false);\n        });\n        \n        // Click for harvest\n        this.canvas.addEventListener('click', (e) => {\n            const pos = this.getMousePos(e);\n            this.checkParticleClick(pos);\n        });\n    }\n    \n    getMousePos(evt) {\n        const rect = this.canvas.getBoundingClientRect();\n        return {\n            x: (evt.clientX - rect.left) * (this.width / rect.width),\n            y: (evt.clientY - rect.top) * (this.height / rect.height)\n        };\n    }\n    \n    getTouchPos(evt) {\n        const rect = this.canvas.getBoundingClientRect();\n        const touch = evt.touches[0];\n        return {\n            x: (touch.clientX - rect.left) * (this.width / rect.width),\n            y: (to