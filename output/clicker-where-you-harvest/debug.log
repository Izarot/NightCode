awnTimer += deltaTime;\n        const baseInterval = 0.8 + Math.random() * 1.7; // 0.8 to 2.5 seconds\n        const spawnRateReduction = this.upgrades.spawnRate.level * 0.15;\n        const effectiveInterval = Math.max(0.3, baseInterval * (1 - spawnRateReduction));\n        \n        if (this.spawnTimer >= effectiveInterval) {\n            this.spawnTimer = 0;\n            this.spawnParticle();\n        }\n        \n        // Update avatar\n        this.avatar.update(deltaTime, this);\n        \n        // Update particles\n        for (let i = this.particles.length - 1; i >= 0; i--) {\n            const p = this.particles[i];\n            p.age += deltaTime;\n            \n            // Apply drift and wind\n            p.vx += this.wind.x * deltaTime * 0.5;\n            p.vy += this.wind.y * deltaTime * 0.5;\n            \n            // Apply friction to drift\n            p.vx *= 0.98;\n            p.vy *= 0.98;\n            \n            p.x += p.vx * deltaTime;\n            p.y += p.vy * deltaTime;\n            \n            // Remove if lifetime exceeded\n            if (p.age >= p.lifetime) {\n                this.particles.splice(i, 1);\n                continue;\n            }\n        }
        \n        // Check collisions between avatar and particles\n        const collectionRadius = 12 + this.upgrades.collectionRadius.level * 4;\n        for (let i = this.particles.length - 1; i >= 0; i--) {\n            const p = this.particles[i];\n            const dx = p.x - this.avatar.x;\n            const dy = p.y - this.avatar.y;\n            const dist = Math.sqrt(dx * dx + dy * dy);\n            \n            if (dist <= collectionRadius + p.radius) {\n                this.collectParticle(i);\n            }\n        }\n        \n        // Update effects\n        for (let i = this.effects.length - 1; i >= 0; i--) {\n            const e = this.effects[i];\n            e.x += e.vx * deltaTime;\n            e.y += e.vy * deltaTime;\n            e.alpha -= deltaTime * 2; // Fade out\n            e.radius += deltaTime * 20; // Expand\n            \n            if (e.alpha <= 0) {\n                this.effects.splice(i, 1);\n            }\n        }\n        \n        // Update milestone effect\n        if (this.milestoneActive) {\n            this.milestoneTimer += deltaTime;\n            if (this.milestoneTimer >= 1) {\n                this.milestoneActive = false;\n            }\n        }\n        \n        // Update timer\n        if (this.startTime > 0) {\n            this.elapsedTime = (Date.now() - this.startTime) / 1000;\n        }\n    }\n    \n    render() {\n        const ctx = this.ctx;\n        \n        // Clear canvas\n        ctx.clearRect(0, 0, this.width, this.height);\n        \n        // Draw background\n        this.drawBackground();\n        \n        // Draw particles\n        this.drawParticles();\n        \n        // Draw effects\n        this.drawEffects();\n        \n        // Draw avatar\n        this.avatar.render(ctx);\n        \n        // Draw milestone indicator\n        if (this.milestoneActive) {\n            ctx.save();\n            ctx.translate(this.width / 2, 60);\n            const scale = 0.5 + 0.5 * Math.sin(this