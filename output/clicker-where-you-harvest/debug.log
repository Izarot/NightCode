is.ctx;\n        \n        for (const e of this.effects) {\n            ctx.save();\n            ctx.globalAlpha = e.alpha;\n            ctx.fillStyle = `hsl(${e.hue}, 100%, 70%)`;\n            ctx.shadowBlur = 15;\n            ctx.shadowColor = `hsl(${e.hue}, 100%, 70%)`;\n            ctx.beginPath();\n            ctx.arc(e.x, e.y, e.radius, 0, Math.PI * 2);\n            ctx.fill();\n            ctx.restore();\n        }\n    }\n    \n    gameLoop(timestamp) {\n        if (!this.lastTimestamp) this.lastTimestamp = timestamp;\n        const deltaTime = Math.min((timestamp - this.lastTimestamp) / 1000, 0.1);\n        this.lastTimestamp = timestamp;\n        \n        this.update(deltaTime);\n        this.render();\n        \n        requestAnimationFrame(this.gameLoop.bind(this));\n    }\n    \n    saveHighScore() {\n        localStorage.setItem('stardustHighScore', this.highScore.toString());\n    }\n    \n    loadHighScore() {\n        const saved = localStorage.getItem('stardustHighScore');\n        if (saved) {\n            this.highScore = parseInt(saved);\n        }\n    }\n    \n    purchaseUpgrade(type) {\n        const upgrade = this.upgrades[type];\n        const cost = Math.floor(upgrade.baseCost * Math.pow(1.15, upgrade.level));\n        \n        if (this.stardust >= cost) {\n            this.stardust -= cost;\n            upgrade.level++;\n            this.playSound('upgrade');\n            this.ui.updateCounter();\n            this.ui.updateButtons();\n            return true;\n        }\n        return false;\n    }\n}\n\nclass Avatar {\n    constructor(x, y) {\n        this.x = x;\n        this.y = y;\n        this.vx = 0;\n        this.vy = 0;\n        this.radius = 12;\n        this.dragging = false;\n        this.keys = {};\n        this.baseSpeed = 150;\n        this.acceleration = 800;\n        this.deceleration = 600;\n        this.maxSpeed = 300;\n        this.friction = 0.85;\n        this.trail = [];\n    }\n    \n    startDrag(pos) {\n        this.dragging = true;\n        this.setPosition(pos);\n    }\n    \n    stopDrag() {\n        this.dragging = false;\n    }\n    \n    setPosition(pos) {\n        this.x = pos.x;\n        this.y = pos.y;\n        this.clampToBounds();\n    }\n    \n    setKey(key, isPressed) {\n        this.keys[key] = isPressed;\n    }\n    \n    clampToBounds() {\n        const bounce = 0.2;\n        \n        if (this.x < this.radius) {\n            this.x = this.radius;\n            this.vx *= -bounce;\n        } else if (this.x > this.width - this.radius) {\n            this.x = this.width - this.radius;\n            this.vx *= -bounce;\n        }\n        \n        if (this.y < this.radius) {\n            this.y = this.radius;\n            this.vy *= -bounce;\n        } else if (this.y > this.height - this.radius) {\n            this.y = this.height - this.radius;\n            this.vy *= -bounce;\n        }\n    }\n    \n    update(deltaTime, game) {\n        this.width = game.width;\n        this.height = game.height;\n        \n        if (!this.dragging) {\n            // Keyboard movement\n            let moveX = 0;\n            let moveY = 0;\n            \n            if (this.keys['ArrowLeft'] || this.keys['a'] || this.keys['A']) moveX -= 1;\n            if (this.keys['ArrowRight'] || this.keys['d'] || this.keys['D']) moveX += 1;\n            if (this.keys['ArrowUp'] || this.keys['w'] || this.keys['W']) moveY -= 1;\n            if (this.keys['ArrowDown'] || this.keys['s'] || this.keys['S']) moveY += 1;\n            \n            // Normalize diagonal movement\n            if (moveX !== 0 && moveY !== 0) {\n                moveX *= 0.7071;\n                moveY *= 0.7071;\n            }\n            \n            if (moveX !== 0 || moveY !== 0) {\n                // Accelerate\n                this.vx += moveX * this.acceleration * deltaTime;\n                this.vy += moveY * this.acceleration * deltaTime;\n                \n                // Cap speed\n                const speed = Math.sqrt(this.vx * this.vx + this.vy * this.vy);\n                if (speed > this.maxSpeed) {\n                    this.vx = (this.vx / speed) * this.maxSpeed;\n                    this.vy = (this.vy / speed) * this.maxSpeed;\n                }\n            } else {\n                // Decelerate\n                this.vx *= (1 - this.deceleration * deltaTime);\n                this.vy *= (1 - this.deceleration * deltaTime);\n                \n                // Apply friction\n                this.vx *= this.friction;\n                this.vy *= this.friction;\n                \n                // Stop completely if very slow\n                if (Math.abs(this.vx) < 0.1) this.vx = 0;\n                if (Math.abs(this.vy) < 0.1) this.vy = 0;\n            }\n            \n            // Integrate position\n            this.x += this.vx * deltaTime;\n            this.y += this.vy * deltaTime;\n        }\n        \n        // Clamp to bounds\n        this.clampToBounds();\n        \n        // Update trail\n        this.trail.push({ x: this.x, y: this.y, time: Date.now() });\n        if (this.trail.length > 3) {\n            this.trail.shift();\n        }\n    }\n    \n    render(ctx) {\n        // Draw trail\n        for (let i = 0; i < this.trail.length; i++) {\n            const t = this.trail[i];\n            const age = (Date.now() - t.time) / 300;\n            if (age < 1) {\n                ctx.save();\n                ctx.globalAlpha = 1 - age;\n                ctx.fillStyle = '#ffdd33';\n                ctx.shadowBlur = 10;\n                ctx.shadowColor = '#ffbb00';\n                ctx.beginPath();\n                ctx.arc(t.x, t.y, 4, 0, Math.PI * 2);\n                ctx.fill();\n                ctx.restore();\n            }\n        }\n        \n        // Draw avatar\n        const gradient = ctx.createRadialGradient(\n            this.x - 3, this.y - 3, 0,\n            this.x, this.y, this.radius\n        );\n        gradient.addColorStop(0, '#ffdd33');\n        gradient.addColorStop(1, '#ffbb00');\n        \n        ctx.save();\n        ctx.shadowBlur = 15;\n        ctx.shadowColor = '#ffbb00';\n        ctx.fillStyle = gradient;\n        ctx.strokeStyle = '#222222';\n        ctx.lineWidth = 2;\n        ctx.beginPath();\n        ctx.arc(this.x, this.y, this.radius, 0, Math.PI * 2);\n        ctx.fill();\n        ctx.stroke();\n        ctx.restore();\n    }\n}\n\nclass UI {\n    constructor(game) {\n        this.game = game;\n        this.tooltip = document.getElementById('tooltip');\n        this.tooltipTimeout = null;\n    }\n    \n    init() {\n        this.updateCounter();\n        this.updateHighScore();\n        this.updateButtons();\n        this.updateTimer();\n        \n        // Start timer\n        this.game.startTime = Date.now();\n        \n        // Update timer every frame\n        setInterval(() => {\n            this.updateTimer();\n        }, 100);\n    }\