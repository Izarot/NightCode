Raw: {"index.html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Fish Jump Adventure</title>\n    <link rel=\"icon\" href=\"data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='70' font-size='60'>🐟</text></svg>\">\n    <link rel=\"stylesheet\" href=\"styles/main.css\">\n    <link rel=\"stylesheet\" href=\"styles/responsive.css\">\n    <link rel=\"stylesheet\" href=\"styles/animations.css\">\n</head>\n<body>\n    <div id=\"game-container\">\n        <canvas id=\"gameCanvas\"></canvas>\n        <div id=\"ui-overlay\">\n            <div id=\"hud\">\n                <div id=\"score\">Score: 0</div>\n                <div id=\"lives\">Lives: 3</div>\n                <div id=\"level\">Level 1</div>\n                <div id=\"timer\">Time: 30</div>\n                <div id=\"high-score\">High Score: 0</div>\n            </div>\n            <div id=\"menus\">\n                <div id=\"main-menu\" class=\"menu\">\n                    <h1>Fish Jump Adventure</h1>\n                    <button id=\"start-btn\">Start Game</button>\n                    <button id=\"instructions-btn\">Instructions</button>\n                </div>\n                <div id=\"instructions\" class=\"menu\">\n                    <h2>How to Play</h2>\n                    <p>Arrow Keys: Swim</p>\n                    <p>Space/W: Jump</p>\n                    <p>Shift/Ctrl: Dive</p>\n                    <button id=\"back-btn\">Back</button>\n                </div>\n                <div id=\"game-over\" class=\"menu\">\n                    <h1>Game Over</h1>\n                    <div id=\"final-score\">Score: 0</div>\n                    <button id=\"restart-btn\">Restart</button>\n                </div>\n            </div>\n        </div>\n    </div>\n    <script src=\"js/core/utils.js\"></script>\n    <script src=\"js/core/canvas.js\"></script>\n    <script src=\"js/core/input.js\"></script>\n    <script src=\"js/core/audio.js\"></script>\n    <script src=\"js/core/game.js\"></script>\n    <script src=\"js/entities/player.js\"></script>\n    <script src=\"js/entities/enemy.js\"></script>\n    <script src=\"js/entities/platform.js\"></script>\n    <script src=\"js/entities/collectible.js\"></script>\n    <script src=\"js/entities/particle.js\"></script>\n    <script src=\"js/systems/physics.js\"></script>\n    <script src=\"js/systems/collision.js\"></script>\n    <script src=\"js/systems/level.js\"></script>\n    <script src=\"js/systems/camera.js\"></script>\n    <script src=\"js/systems/save.js\"></script>\n    <script src=\"js/ui/hud.js\"></script>\n    <script src=\"js/ui/menu.js\"></script>\n    <script src=\"js/ui/controls.js\"></script>\n    <script src=\"config/game-config.js\"></script>\n    <script src=\"config/difficulty.js\"></script>\n    <script>window.addEventListener('load', () => { if(window.FishJumpAdventure) window.FishJumpAdventure.init(); });</script>\n</body>\n</html>", "styles/main.css": "/* Fish Jump Adventure - Main Styles */\n:root {\n    --primary-blue: #006994;\n    --teal: #40B08C;\n    --cyan: #7FFFD4;\n    --sandy-beige: #F5E6D3;\n    --coral-pink: #FF6B9D;\n    --lime-green: #A8E600;\n    --dark-gray: #2F2F2F;\n    --red: #CC0000;\n    --white: #FFFFFF;\n    --gold: #D4AF37;\n    --silver: #C0C0C0;\n    --yellow: #FFD700;\n    --light-gray: #DDDDDD;\n    --orange: #FF9933;\n}\n\n* {\n    margin: 0;\n    padding: 0;\n    box-sizing: border-box;\n}\n\nhtml, body {\n    width: 100%;\n    height: 100%;\n    overflow: hidden;\n    background-color: var(--primary-blue);\n    font-family: 'Arial', sans-serif;\n    touch-action: none;\n}\n\n#game-container {\n    position: relative;\n    width: 100%;\n    height: 100vh;\n    display: flex;\n    justify-content: center;\n    align-items: center;\n    background-color: var(--primary-blue);\n}\n\n#gameCanvas {\n    background-color: var(--teal);\n    image-rendering: pixelated;\n    max-width: 100%;\n    height: auto;\n    border: 2px solid var(--white);\n    border-radius: 8px;\n    box-shadow: 0 0 20px var(--cyan);\n}\n\n#ui-overlay {\n    position: absolute;\n    top: 0;\n    left: 0;\n    width: 100%;\n    height: 100%;\n    pointer-events: none;\n}\n\n#hud {\n    position: absolute;\n    top: 10px;\n    left: 10px;\n    display: flex;\n    flex-direction: column;\n    gap: 5px;\n    pointer-events: none;\n    z-index: 10;\n}\n\n#hud div {\n    color: var(--white);\n    font-size: 18px;\n    text-shadow: 1px 1px 2px var(--dark-gray);\n    background-color: rgba(0, 0, 0, 0.5);\n    padding: 4px 8px;\n    border-radius: 4px;\n}\n\n#timer {\n    position: absolute;\n    bottom: 10px;\n    left: 50%;\n    transform: translateX(-50%);\n    font-size: 24px;\n    color: var(--white);\n    text-shadow: 1px 1px 2px var(--dark-gray);\n    background-color: rgba(0, 0, 0, 0.5);\n    padding: 6px 12px;\n    border-radius: 6px;\n}\n\n.menu {\n    position: absolute;\n    top: 50%;\n    left: 50%;\n    transform: translate(-50%, -50%);\n    text-align: center;\n    color: var(--white);\n    display: none;\n    flex-direction: column;\n    gap: 15px;\n    pointer-events: auto;\n    z-index: 20;\n}\n\n.menu h1 {\n    font-size: 48px;\n    text-shadow: 2px 2px 4px var(--dark-gray);\n    color: var(--coral-pink);\n}\n\n.menu h2 {\n    font-size: 32px;\n    text-shadow: 2px 2px 4px var(--dark-gray);\n    color: var(--lime-green);\n}\n\nbutton {\n    background-color: var(--coral-pink);\n    color: var(--white);\n    border: none;\n    padding: 12px 24px;\n    font-size: 20px;\n    border-radius: 8px;\n    cursor: pointer;\n    transition: all 0.2s;\n    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.3);\n}\n\nbutton:hover {\n    background-color: var(--lime-green);\n    transform: scale(1.05);\n    box-shadow: 0 6px 12px rgba(0, 0, 0, 0.4);\n}\n\nbutton:active {\n    transform: scale(0.98);\n}\n\np {\n    font-size: 18px;\n    line-height: 1.6;\n}\n", "styles/responsive.css": "/* Fish Jump Adventure - Responsive Styles */\n@media (max-width: 768px) {\n    #gameCanvas {\n        width: 100vw;\n        height: auto;\n        max-height: 100vh;\n        border-width: 1px;\n    }\n\n    #hud div {\n        font-size: 16px;\n        padding: 3px 6px;\n    }\n\n    #timer {\n        font-size: 20px;\n        padding: 5px 10px;\n    }\n\n    .menu h1 {\n        font-size: 36px;\n    }\n\n    .menu h2 {\n        font-size: 24px;\n    }\n\n    button {\n        padding: 10px 20px;\n        font-size: 18px;\n    }\n}\n\n@media (max-width: 480px) {\n    #gameCanvas {\n        width: 100vw;\n        height: auto;\n    }\n\n    #hud div {\n        font-size: 14px;\n        padding: 2px 4px;\n    }\n\n    #timer {\n        font-size: 18px;\n        padding: 4px 8px;\n    }\n\n    .menu h1 {\n        font-size: 28px;\n    }\n\n    .menu h2 {\n        font-size: 20px;\n    }\n\n    button {\n        padding: 8px 16px;\n        font-size: 16px;\n    }\n}\n\n/* Ensure canvas scales properly on all devices */\n#game-container {\n    width: 100vw;\n    height: 100vh;\n}\n\n/* Touch-friendly controls for mobile */\n@media (hover: none) and (pointer: coarse) {\n    button {\n        min-height: 44px;\n        min-width: 44px;\n        padding: 12px 24px;\n    }\n}\n", "styles/animations.css": "/* Fish Jump Adventure - Animations */\n@keyframes bob {\n    0%, 100% { transform: translateY(0); }\n    50% { transform: translateY(-5px); }\n}\n\n@keyframes pulse {\n    0%, 100% { opacity: 1; }\n    50% { opacity: 0.7; }\n}\n\n@keyframes splash {\n    0% { transform: scale(0.5); opacity: 1; }\n    100% { transform: scale(2); opacity: 0; }\n}\n\n@keyframes twinkle {\n    0%, 100% { opacity: 0.3; }\n    50% { opacity: 1; }\n}\n\n@keyframes glow {\n    0%, 100% { box-shadow: 0 0 5px var(--cyan); }\n    50% { box-shadow: 0 0 20px var(--cyan), 0 0 40px var(--lime-green); }\n}\n\n@keyframes fade-in {\n    from { opacity: 0; }\n    to { opacity: 1; }\n}\n\n@keyframes fade-out {\n    from { opacity: 1; }\n    to { opacity: 0; }\n}\n\n@keyframes float {\n    0%, 100% { transform: translateY(0) rotate(0deg); }\n    50% { transform: translateY(-10px) rotate(5deg); }\n}\n\n@keyframes swim-cycle {\n    0% { background-position: 0 0; }\n    100% { background-position: 100% 0; }\n}\n\n/* Apply animations to game elements */\n.player {\n    animation: bob 2s ease-in-out infinite;\n}\n\n.collectible {\n    animation: float 3s ease-in-out infinite;\n}\n\n.gem {\n    animation: twinkle 2s ease-in-out infinite;\n}\n\n.particle-splash {\n    animation: splash 0.5s ease-out forwards;\n}\n\n.power-up-active {\n    animation: glow 1s ease-in-out infinite;\n}\n", "js/core/utils.js": "// Fish Jump Adventure - Utility Functions\nconst Utils = {\n    // Clamp a value between min and max\n    clamp(value, min, max) {\n        return Math.min(Math.max(value, min), max);\n    },\n\n    // Linear interpolation\n    lerp(start, end, t) {\n        return start + (end - start) * t;\n    },\n\n    // Distance between two points\n    distance(x1, y1, x2, y2) {\n        const dx = x2 - x1;\n        const dy = y2 - y1;\n        return Math.sqrt(dx * dx + dy * dy);\n    },\n\n    // Random number between min and max\n    random(min, max) {\n        return Math.random() * (max - min) + min;\n    },\n\n    // Random integer between min and max (inclusive)\n    randomInt(min, max) {\n        return Math.floor(Math.random() * (max - min + 1)) + min;\n    },\n\n    // Degrees to radians\n    degToRad(degrees) {\n        return degrees * (Math.PI / 180);\n    },\n\n    // Radians to degrees\n    radToDeg(radians) {\n        return radians * (180 / Math.PI);\n    },\n\n    // Check if two rectangles overlap (AABB collision)\n    rectOverlap(rect1, rect2) {\n        return rect1.x < rect2.x + rect2.width &&\n               rect1.x + rect1.width > rect2.x &&\n               rect1.y < rect2.y + rect2.height &&\n               rect1.y + rect1.height > rect2.y;\n    },\n\n    // Check if two circles overlap\n    circleOverlap(circle1, circle2) {\n        const dx = circle1.x - circle2.x;\n        const dy = circle1.y - circle2.y;\n        const distance = Math.sqrt(dx * dx + dy * dy);\n        return distance < circle1.radius + circle2.radius;\n    },\n\n    // Format time in MM:SS format\n    formatTime(seconds) {\n        const mins = Math.floor(seconds / 60);\n        const secs = Math.floor(seconds % 60);\n        return `${mins.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}`;\n    },\n\n    // Debounce function\n    debounce(func, wait) {\n        let timeout;\n        return function executedFunction(...args) {\n            const later = () => {\n                clearTimeout(timeout);\n                func(...args);\n            };\n            clearTimeout(timeout);\n            timeout = setTimeout(later, wait);\n        };\n    },\n\n    // Throttle function\n    throttle(func, limit) {\n        let inThrottle;\n        return function() {\n            const args = arguments;\n            const context = this;\n            if (!inThrottle) {\n                func.apply(context, args);\n                inThrottle = true;\n                setTimeout(() => inThrottle = false, limit);\n            }\n        };\n    }\n};\n\n// Export for use in other modules\nif (typeof module !== 'undefined' && module.exports) {\n    module.exports = Utils;\n}\n", "js/core/canvas.js": "// Fish Jump Adventure - Canvas Rendering System\nclass CanvasRenderer {\n    constructor(canvasId) {\n        this.canvas = document.getElementById(canvasId);\n        this.ctx = this.canvas.getContext('2d');\n        this.width = this.canvas.width;\n        this.height = this.canvas.height;\n        this.camera = { x: 0, y: 0 };\n        this.setupCanvas();\n        this.setupEventListeners();\n    }\n\n    setupCanvas() {\n        // Set canvas to full window size\n        this.resizeCanvas();\n        \n        // Enable image smoothing for pixel art\n        this.ctx.imageSmoothingEnabled = false;\n    }\n\n    resizeCanvas() {\n        const container = this.canvas.parentElement;\n        const containerWidth = container.clientWidth;\n        const containerHeight = container.clientHeight;\n        \n        // Maintain aspect ratio (16:9)\n        const aspectRatio = 16 / 9;\n        let newWidth, newHeight;\n        \n        if (containerWidth / containerHeight > aspectRatio) {\n            newWidth = containerHeight * aspectRatio;\n            newHeight = containerHeight;\n        } else {\n            newWidth = containerWidth;\n            newHeight = containerWidth / aspectRatio;\n        }\n        \n        this.canvas.width = newWidth;\n        this.canvas.height = newHeight;\n        this.width = newWidth;\n        this.height = newHeight;\n    }\n\n    setupEventListeners() {\n        window.addEventListener('resize', () => {\n            this.resizeCanvas();\n        });\n    }\n\n    // Clear the canvas\n    clear() {\n        this.ctx.clearRect(0, 0, this.width, this.height);\n    }\n\n    // Set camera position\n    setCamera(x, y) {\n        this.camera.x = x;\n        this.camera.y = y;\n    }\n\n    // Convert world coordinates to screen coordinates\n    worldToScreen(x, y) {\n        return {\n            x: x - this.camera.x,\n            y: y - this.camera.y\n        };\n    }\n\n    // Draw a rectangle\n    drawRect(x, y, width, height, color) {\n        const screenPos = this.worldToScreen(x, y);\n        this.ctx.fillStyle = color;\n        this.ctx.fillRect(screenPos.x, screenPos.y, width, height);\n    }\n\n    // Draw a circle\n    drawCircle(x, y, radius, color) {\n        const screenPos = this.worldToScreen(x, y);\n        this.ctx.fillStyle = color;\n        this.ctx.beginPath();\n        this.ctx.arc(screenPos.x, screenPos.y, radius, 0, Math.PI * 2);\n        this.ctx.fill();\n    }\n\n    // Draw text\n    drawText(text, x, y, fontSize, color, align = 'left') {\n        const screenPos = this.worldToScreen(x, y);\n        this.ctx.fillStyle = color;\n        this.ctx.font = `${fontSize}px Arial`;\n        this.ctx.textAlign = align;\n        this.ctx.fillText(text, screenPos.x, screenPos.y);\n    }\n\n    // Draw sprite\n    drawSprite(sprite, x, y, width, height) {\n        const screenPos = this.worldToScreen(x, y);\n        this.ctx.drawImage(sprite, screenPos.x, screenPos.y, width, height);\n    }\n\n    // Draw line\n    drawLine(x1, y1, x2, y2, color, lineWidth = 1) {\n        const screen1 = this.worldToScreen(x1, y1);\n        const screen2 = this.worldToScreen(x2, y2);\n        this.ctx.strokeStyle = color;\n        this.ctx.lineWidth = lineWidth;\n        this.ctx.beginPath();\n        this.ctx.moveTo(screen1.x, screen1.y);\n        this.ctx.lineTo(screen2.x, screen2.y);\n        this.ctx.stroke();\n    }\n\n    // Draw polygon\n    drawPolygon(points, color) {\n        if (points.length === 0) return;\n        \n        this.ctx.fillStyle = color;\n        this.ctx.beginPath();\n        \n        for (let i = 0; i < points.length; i++) {\n            const screenPos = this.worldToScreen(points[i].x, points[i].y);\n            if (i === 0) {\n                this.ctx.moveTo(screenPos.x, screenPos.y);\n            } else {\n                this.ctx.lineTo(screenPos.x, screenPos.y);\n            }\n        }\n        \n        this.ctx.closePath();\n        this.ctx.fill();\n    }\n\n    // Save and restore context\n    save() {\n        this.ctx.save();\n    }\n\n    restore() {\n        this.ctx.restore();\n    }\n\n    // Set global alpha\n    setAlpha(alpha) {\n        this.ctx.globalAlpha = alpha;\n    }\n\n    // Reset alpha\n    resetAlpha() {\n        this.ctx.globalAlpha = 1;\n    }\n\n    // Draw gradient rectangle\n    drawGradientRect(x, y, width, height, color1, color2, vertical = false) {\n        const screenPos = this.worldToScreen(x, y);\n        const gradient = vertical\n            ? this.ctx.createLinearGradient(screenPos.x, screenPos.y, screenPos.x, screenPos.y + height)\n            : this.ctx.createLinearGradient(screenPos.x, screenPos.y, screenPos.x + width, screenPos.y);\n        \n        gradient.addColorStop(0, color1);\n        gradient.addColorStop(1, color2);\n        \n        this.ctx.fillStyle = gradient;\n        this.ctx.fillRect(screenPos.x, screenPos.y, width, height);\n    }\n}\n\n// Initialize renderer when DOM is loaded\nlet canvasRenderer;\nwindow.addEventListener('load', () => {\n    canvasRenderer = new CanvasRenderer('gameCanvas');\n});\n", "js/core/input.js": "// Fish Jump Adventure - Input Handling System\nclass InputManager {\n    constructor() {\n        this.keys = {};\n        this.lastKeys = {};\n        this.touchStartX = 0;\n        this.touchStartY = 0;\n        this.touchEndX = 0;\n        this.touchEndY = 0;\n        this.swipeThreshold = 50;\n        this.setupEventListeners();\n    }\n\n    setupEventListeners() {\n        // Keyboard events\n        window.addEventListener('keydown', (e) => {\n            this.keys[e.code] = true;\n            // Prevent scrolling with arrow keys\n            if (['ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight', 'Space'].includes(e.code)) {\n                e.preventDefault();\n            }\n        });\n\n        window.addEventListener('keyup', (e) => {\n            this.keys[e.code] = false;\n        });\n\n        // Touch events for mobile\n        window.addEventListener('touchstart', (e) => {\n            e.preventDefault();\n            const touch = e.touches[0];\n            this.touchStartX = touch.clientX;\n            this.touchStartY = touch.clientY;\n            this.keys['Touch'] = true;\n        }, { passive: false });\n\n        window.addEventListener('touchend', (e) => {\n            e.preventDefault();\n            const touch = e.changedTouches[0];\n            this.touchEndX = touch.clientX;\n            this.touchEndY = touch.clientY;\n            this.keys['Touch'] = false;\n            this.handleSwipe();\n        }, { passive: false });\n\n        // Prevent context menu on long press\n        window.addEventListener('contextmenu', (e) => {\n            e.preventDefault();\n        });\n    }\n\n    handleSwipe() {\n        const dx = this.touchEndX - this.touchStartX;\n        const dy = this.touchEndY - this.touchStartY;\n        const absDx = Math.abs(dx);\n        const absDy = Math.abs(dy);\n\n        if (Math.max(absDx, absDy) > this.swipeThreshold) {\n            if (absDx > absDy) {\n                // Horizontal swipe\n                if (dx > 0) {\n                    this.keys['SwipeRight'] = true;\n                    setTimeout(() => { this.keys['SwipeRight'] = false; }, 100);\n                } else {\n                    this.keys['SwipeLeft'] = true;\n                    setTimeout(() => { this.keys['SwipeLeft'] = false; }, 100);\n                }\n            } else {\n                // Vertical swipe\n                if (dy > 0) {\n                    this.keys['SwipeDown'] = true;\n                    setTimeout(() => { this.keys['SwipeDown'] = false; }, 100);\n                } else {\n                    this.keys['SwipeUp'] = true;\n                    setTimeout(() => { this.keys['SwipeUp'] = false; }, 100);\n                }\n            }\n        }\n    }\n\n    // Update key states\n    update() {\n        this.lastKeys = { ...this.keys };\n    }\n\n    // Check if key is currently pressed\n    isPressed(keyCode) {\n        return !!this.keys[keyCode];\n    }\n\n    // Check if key was just pressed (edge detection)\n    isJustPressed(keyCode) {\n        return !!this.keys[keyCode] && !this.lastKeys[keyCode];\n    }\n\n    // Check if key was just released\n    isJustReleased(keyCode) {\n        return !this.keys[keyCode] && !!this.lastKeys[keyCode];\n    }\n\n    // Get input direction vector\n    getDirection() {\n        let x = 0;\n        let y = 0;\n\n        if (this.isPressed('ArrowLeft') || this.isPressed('KeyA') || this.isPressed('SwipeLeft')) {\n            x -= 1;\n        }\n        if (this.isPressed('ArrowRight') || this.isPressed('KeyD') || this.isPressed('SwipeRight')) {\n            x += 1;\n        }\n        if (this.isPressed('ArrowUp') || this.isPressed('KeyW') || this.isPressed('SwipeUp')) {\n            y -= 1;\n        }\n        if (this.isPressed('ArrowDown') || this.isPressed('KeyS') || this.isPressed('SwipeDown')) {\n            y += 1;\n        }\n\n        // Normalize diagonal movement\n        if (x !== 0 && y !== 0) {\n            const len = Math.sqrt(x * x + y * y);\n            x /= len;\n            y /= len;\n        }\n\n        return { x, y };\n    }\n\n    // Check for jump input\n    isJumpPressed() {\n        return this.isJustPressed('Space') ||\n               this.isJustPressed('Enter') ||\n               this.isJustPressed('KeyW') ||\n               this.isJustPressed('ArrowUp') ||\n               this.isJustPressed('SwipeUp');\n    }\n\n    // Check for dive input\n    isDivePressed() {\n        return this.isPressed('ShiftLeft') ||\n               this.isPressed('ShiftRight') ||\n               this.isPressed('ControlLeft') ||\n               this.isPressed('ControlRight') ||\n               this.isPressed('SwipeDown');\n    }\n\n    // Reset input state\n    reset() {\n        this.keys = {};\n        this.lastKeys = {};\n    }\n}\n\n// Initialize input manager\nlet inputManager;\nwindow.addEventListener('load', () => {\n    inputManager = new InputManager();\n});\n", "js/core/audio.js": "// Fish Jump Adventure - Audio System using Web Audio API\nclass AudioManager {\n    constructor() {\n        this.audioContext = null;\n        this.masterGain = null;\n        this.sounds = {};\n        this.music = null;\n        this.isMuted = false;\n        this.init();\n    }\n\n    async init() {\n        try {\n            this.audioContext = new (window.AudioContext || window.webkitAudioContext)();\n            this.masterGain = this.audioContext.createGain();\n            this.masterGain.connect(this.audioContext.destination);\n            this.masterGain.gain.value = 0.7;\n            await this.createSounds();\n        } catch (e) {\n            console.warn('Web Audio API not supported:', e);\n        }\n    }\n\n    // Create sound effects using Web Audio API\n    async createSounds() {\n        if (!this.audioContext) return;\n\n        // Jump sound - short upward whoosh\n        this.sounds.jump = this.createOscillatorSound('sine', 200, 800, 0.1, 'exponential');\n\n        // Landing sound - soft splash\n        this.sounds.landing = this.createOscillatorSound('sine', 400, 100, 0.2, 'exponential');\n\n        // Enemy death - crunching underwater sound\n        this.sounds.enemyDeath = this.createOscillatorSound('square', 300, 100, 0.3, 'linear');\n\n        // Power-up activation - bright chime\n        this.sounds.powerUp = this.createChordSound([523.25, 659.25, 783.99], 0.3);\n\n        // Collectible pickup - pleasant tinkling tone\n        this.sounds.collect = this.createOscillatorSound('sine', 800, 1200, 0.1, 'exponential');\n\n        // Game over - low descending tone\n        this.sounds.gameOver = this.createOscillatorSound('sine', 300, 100, 0.5, 'exponential');\n\n        // Bubble pop\n        this.sounds.bubble = this.createNoiseSound(0.1);\n\n        // Background music - ambient ocean track\n        this.createBackgroundMusic();\n    }\n\n    createOscillatorSound(type, frequency, endFrequency, duration, rampType = 'linear') {\n        const sound = {\n            play: () => {\n                if (this.isMuted || !this.audioContext) return;\n                const oscillator = this.audioContext.createOscillator();\n                const gainNode = this.audioContext.createGain();\n\n                oscillator.type = type;\n                oscillator.frequency.setValueAtTime(frequency, this.audioContext.currentTime);\n\n                if (rampType === 'exponential') {\n                    oscillator.frequency.exponentialRampToValueAtTime(endFrequency, this.audioContext.currentTime + duration);\n                } else {\n                    oscillator.frequency.linearRampToValueAtTime(endFrequency, this.audioContext.currentTime + duration);\n                }\n\n                gainNode.gain.setValueAtTime(0.001, this.audioContext.currentTime);\n                gainNode.gain.exponentialRampToValueAtTime(0.2, this.audioContext.currentTime + 0.01);\n                gainNode.gain.exponentialRampToValueAtTime(0.001, this.audioContext.currentTime + duration);\n\n                oscillator.connect(gainNode);\n                gainNode.connect(this.masterGain);\n\n                oscillator.start(this.audioContext.currentTime);\n                oscillator.stop(this.audioContext.currentTime + duration);\n            }\n        };\n        return sound;\n    }\n\n    createChordSound(frequencies, duration) {\n        return {\n            play: () => {\n                if (this.isMuted || !this.audioContext) return;\n                frequencies.forEach(freq => {\n                    const oscillator = this.audioContext.createOscillator();\n                    const gainNode = this.audioContext.createGain();\n\n                    oscillator.type = 'sine';\n                    oscillator.frequency.setValueAtTime(freq, this.audioContext.currentTime);\n\n                    gainNode.gain.setValueAtTime(0.001, this.audioContext.currentTime);\n                    gainNode.gain.exponentialRampToValueAtTime(0.15, this.audioContext.currentTime + 0.01);\n                    gainNode.gain.exponentialRampToValueAtTime(0.001, this.audioContext.currentTime + duration);\n\n                    oscillator.connect(gainNode);\n                    gainNode.connect(this.masterGain);\n\n                    oscillator.start(this.audioContext.currentTime);\n                    oscillator.stop(this.audioContext.currentTime + duration);\n                });\n            }\n        };\n    }\n\n    createNoiseSound(duration) {\n        return {\n            play: () => {\n                if (this.isMuted || !this.audioContext) return;\n                const bufferSize = this.audioContext.sampleRate * duration;\n                const buffer = this.audioContext.createBuffer(1, bufferSize, this.audioContext.sampleRate);\n                const data = buffer.getChannelData(0);\n\n                for (let i = 0; i < bufferSize; i++) {\n                    data[i] = Math.random() * 2 - 1;\n                }\n\n                const bufferSource = this.audioContext.createBufferSource();\n                bufferSource.buffer = buffer;\n\n                const filter = this.audioContext.createBiquadFilter();\n                filter.type = 'lowpass';\n                filter.frequency.setValueAtTime(1000, this.audioContext.currentTime);\n                filter.frequency.exponentialRampToValueAtTime(100, this.audioContext.currentTime + duration);\n\n                const gainNode = this.audioContext.createGain();\n                gainNode.gain.setValueAtTime(0.001, this.audioContext.currentTime);\n                gainNode.gain.exponentialRampToValueAtTime(0.1, this.audioContext.currentTime + 0.01);\n                gainNode.gain.exponentialRampToValueAtTime(0.001, this.audioContext.currentTime + duration);\n\n                bufferSource.connect(filter);\n                filter.connect(gainNode);\n                gainNode.connect(this.masterGain);\n\n                bufferSource.start(this.audioContext.currentTime);\n                bufferSource.stop(this.audioContext.currentTime + duration);\n            }\n        };\n    }\n\n    createBackgroundMusic() {\n        if (!this.audioContext) return;\n\n        // Create ambient ocean sound using low-frequency oscillators\n        const createAmbientTrack = () => {\n            const lowOsc = this.audioContext.createOscillator();\n            const lowGain = this.audioContext.createGain();\n            lowOsc.type = 'sine';\n            lowOsc.frequency.setValueAtTime(60, this.audioContext.currentTime);\n            lowGain.gain.setValueAtTime(0.05, this.audioContext.currentTime);\n            lowOsc.connect(lowGain);\n            lowGain.connect(this.masterGain);\n            lowOsc.start();\};

        this.music = {
            lowOsc: lowOsc,
            lowGain: lowGain
        };
    }

    playMusic() {
        if (this.isMuted || !this.music) return;
        this.music.lowOsc.connect(this.masterGain);
    }

    stopMusic() {
        if (!this.music) return;
        this.music.lowOsc.disconnect();
    }

    playSound(soundName) {
        if (this.sounds[soundName]) {
            this.sounds[soundName].play();
        }
    }

    toggleMute() {
        this.isMuted = !this.isMuted;
        if (this.masterGain) {
            this.masterGain.gain.value = this.isMuted ? 0 : 0.7;
        }
        return this.isMuted;
    }

    setVolume(volume) {
        if (this.masterGain) {
            this.masterGain.gain.value = volume;
        }
    }
}

// Initialize audio manager
let audioManager;
window.addEventListener('load', () => {
    audioManager = new AudioManager();
});", "js/core/game.js": "// Fish Jump Adventure - Main Game Class\nclass FishJumpAdventure {\n    constructor() {\n        this.canvas = null;\n        this.ctx = null;\n        this.player = null;\n        this.platforms = [];\n        this.enemies = [];\n        this.collectibles = [];\n        this.particles = [];\n        this.camera = { x: 0, y: 0 };\n        this.score = 0;\n        this.lives = 3;\n        this.level = 1;\n        this.timeLeft = 30;\n        this.highScore = 0;\n        this.gameState = 'menu';\n        this.gravity = 0.5;\n        this.isPaused = false;\n        this.lastTime = 0;\n        this.frameCount = 0;\n        this.powerUpActive = false;\n        this.powerUpTimer = 0;\n        this.powerUpType = null;\n        this.levelWidth = 2000;\n        this.levelHeight = 1000;\n        this.waterLevel = 800;\n        this.init();\n    }\n\n    init() {\n        this.canvas = document.getElementById('gameCanvas');\n        this.ctx = this.canvas.getContext('2d');\n        this.resizeCanvas();\n        this.setupEventListeners();\n        this.loadHighScore();\n        this.createInitialLevel();\n        this.gameLoop();\n    }\n\n    resizeCanvas() {\n        const container = this.canvas.parentElement;\n        const containerWidth = container.clientWidth;\n        const containerHeight = container.clientHeight;\n        \        const aspectRatio = 16 / 9;\n        let newWidth, newHeight;\n        \n        if (containerWidth / containerHeight > aspectRatio) {\n            newWidth = containerHeight * aspectRatio;\n            newHeight = containerHeight;\n        } else {\n            newWidth = containerWidth;\n            newHeight = containerWidth / aspectRatio;\n        }\n        \n        this.canvas.width = newWidth;\n        this.canvas.height = newHeight;\n    }\n\n    setupEventListeners() {\n        window.addEventListener('resize', () => {\n            this.resizeCanvas();\n        });\n\n        document.getElementById('start-btn').addEventListener('click', () => {\n            this.startGame();\n        });\n\n        document.getElementById('instructions-btn').addEventListener('click', () => {\n            this.showInstructions();\n        });\n\n        document.getElementById('back-btn').addEventListener('click', () => {\n            this.showMainMenu();\n        });\n\n        document.getElementById('restart-btn').addEventListener('click', () => {\n            this.restartGame();\n        });\n    }\n\n    createInitialLevel() {\n        // Create player\n        this.player = new Player(100, 300);\n        \n        // Create platforms\n        this.platforms = [];\n        this.platforms.push(new Platform(0, 500, 200, 20));\n        this.platforms.push(new Platform(300, 450, 150, 20));\n        this.platforms.push(new Platform(500, 400, 150, 20));\n        this.platforms.push(new Platform(700, 350, 150, 20));\n        this.platforms.push(new Platform(900, 300, 150, 20));\n        this.platforms.push(new Platform(1100, 250, 150, 20));\n        this.platforms.push(new Platform(1300, 200, 150, 20));\n        this.platforms.push(new Platform(1500, 150, 150, 20));\n        \n        // Create enemies\n        this.enemies = [];\n        this.enemies.push(new Enemy(400, 430, 'left', 2));\n        this.enemies.push(new Enemy(800, 280, 'left', 2));\n        this.enemies.push(new Enemy(1200, 180, 'left', 2));\n        \n        // Create collectibles\n        this.collectibles = [];\n        this.collectibles.push(new Collectible(350, 430, 'coin'));\n        this.collectibles.push(new Collectible(750, 330, 'coin'));\n        this.collectibles.push(new Collectible(1150, 230, 'gem'));\n        this.collectibles.push(new Collectible(1450, 130, 'powerup'));\n    }\n\n    startGame() {\n        this.gameState = 'playing';\n        this.score = 0;\n        this.lives = 3;\n        this.level = 1;\n        this.timeLeft = 30;\n        this.isPaused = false;\n        this.updateHUD();\n        this.hideMenus();\n        this.createInitialLevel();\n    }\n\n    restartGame() {\n        this.startGame();\n    }\n\n    showInstructions() {\n        this.hideMenus();\n        document.getElementById('instructions').style.display = 'flex';\n    }\n\n    showMainMenu() {\n        this.hideMenus();\n        document.getElementById('main-menu').style.display = 'flex';\n    }\n\n    hideMenus() {\n        document.getElementById('main-menu').style.display = 'none';\n        document.getElementById('instructions').style.display = 'none';\n        document.getElementById('game-over').style.display = 'none';\n    }\n\n    showGameOver() {\n        this.gameState = 'gameover';\n        document.getElementById('final-score').textContent = `Score: ${this.score}`;\n        document.getElementById('game-over').style.display = 'flex';\n    }\n\n    updateHUD() {\n        document.getElementById('score').textContent = `Score: ${this.score}`;\n        document.getElementById('lives').textContent = `Lives: ${this.lives}`;\n        document.getElementById('level').textContent = `Level ${this.level}`;\n        document.getElementById('timer').textContent = `Time: ${Math.ceil(this.timeLeft)}`;\n        document.getElementById('high-score').textContent = `High Score: ${this.highScore}`;\n    }\n\n    loadHighScore() {\n        const saved = localStorage.getItem('fishJumpHighScore');\n        if (saved) {\n            this.highScore = parseInt(saved);\n        }\n    }\n\n    saveHighScore() {\n        if (this.score > this.highScore) {\n            this.highScore = this.score;\n            localStorage.setItem('fishJumpHighScore', this.highScore.toString());\n        }\n    }\n\n    gameLoop(timestamp = 0) {\n        const deltaTime = timestamp - this.lastTime;\n        this.lastTime = timestamp;\n        \n        if (this.gameState === 'playing' && !this.isPaused) {\n            this.update(deltaTime);\n        }\n        \n        this.render();\n        this.frameCount++;\n        \n        requestAnimationFrame((ts) => this.gameLoop(ts));\n    }\n\n    update(deltaTime) {\n        // Update timer\n        this.timeLeft -= deltaTime / 1000;\n        if (this.timeLeft <= 0) {\n            this.timeLeft = 0;\n            this.lives = 0;\n            this.checkGameOver();\n        }\n        \n        // Update player\n        this.player.update(deltaTime);\n        \n        // Apply gravity\n        if (!this.player.isOnGround) {\n            this.player.vy += this.gravity;\n        }\n        \n        // Update platforms\n        this.platforms.forEach(platform => platform.update(deltaTime));\n        \n        // Update enemies\n        this.enemies.forEach(enemy => enemy.update(deltaTime));\n        \n        // Update collectibles\n        this.collectibles.forEach(collectible => collectible.update(deltaTime));\n        \n        // Update particles\n        this.particles.forEach((particle, index) => {\n            particle.update(deltaTime);\n            if (particle.isDead()) {\n                this.particles.splice(index, 1);\n            }
        });\n        \n        // Update power-up timer\n        if (this.powerUpActive) {\n            this.powerUpTimer -= deltaTime / 1000;\n            if (this.powerUpTimer <= 0) {\n                this.powerUpActive = false;\n                this.powerUpType = null;\n            }
        }\n        \n        // Check collisions\n        this.checkCollisions();\n        \n        // Update camera to follow player\n        this.updateCamera();\n        \n        // Update HUD\n        this.updateHUD();\n        \n        // Check level progression\n        this.checkLevelProgression();\n    }\n\n    updateCamera() {\n        const targetX = this.player.x - this.canvas.width / 2;\n        const targetY = this.player.y - this.canvas.height / 2;\n        \n        this.camera.x = Utils.lerp(this.camera.x, targetX, 0.1);\n        this.camera.y = Utils.lerp(this.camera.y, targetY, 0.1);\n        \n        // Clamp camera to level bounds\n        this.camera.x = Utils.clamp(this.camera.x, 0, this.levelWidth - this.canvas.width);\n        this.camera.y = Utils.clamp(this.camera.y, 0, this.levelHeight - this.canvas.height);\n    }\n\n    checkCollisions() {\n        // Platform collisions\n        this.platforms.forEach(platform => {\n            if (Utils.rectOverlap(this.player.getBounds(), platform.getBounds())) {\n                this.player.handlePlatformCollision(platform);\n            }
        });\n        \n        // Enemy collisions\n        this.enemies.forEach((enemy, index) => {\n            if (Utils.rectOverlap(this.player.getBounds(), enemy.getBounds())) {\n                if (this.player.vy > 0 && this.player.y < enemy.y) {\n                    // Jump on enemy\n                    this.player.vy = -10;\n                        this.player.y = enemy.y - this.player.height;\n                        this.player.isOnGround = true;\n                        this.enemies.splice(index, 1);\n                        this.score += 100;\n                        this.createParticles(enemy.x, enemy.y, '#FF6B9D');\n                        if (audioManager) audioManager.playSound('enemyDeath');\n                    } else {\n                        // Player hit by enemy\n                        this.lives--;\n                        this.player.resetPosition();\n                        if (this.lives <= 0) {\n                            this.checkGameOver();\n                        } else if (audioManager) {\n                            audioManager.playSound('bubble');\n                        }\n                    }\n                }\
            });\n        \n        // Collectible collisions\n        this.collectibles.forEach((collectible, index) => {\n            if (Utils.rectOverlap(this.player.getBounds(), collectible.getBounds())) {\n                this.collectibles.splice(index, 1);\n                if (collectible.type === 'coin') {\n                    this.score += 10;\n                    if (audioManager) audioManager.playSound('collect');\n                } else if (collectible.type === 'gem') {\n                    this.score += 50;\n                    if (audioManager) audioManager.playSound('powerUp');\n                } else if (collectible.type === 'powerup') {\n                    this.activatePowerUp('invincible');\n                    if (audioManager) audioManager.playSound('powerUp');\n                }\n                this.createParticles(collectible.x, collectible.y, collectible.color);\n            }\n        });\n    }\n\n    activatePowerUp(type) {\n        this.powerUpActive = true;\n        this.powerUpTimer = 10;\n        this.powerUpType = type;\n        this.player.addPowerUp(type);\n    }\n\n    createParticles(x, y, color) {\n        for (let i = 0; i < 10; i++) {\n            this.particles.push(new Particle(x, y, color));\n        }\n    }\n\n    checkLevelProgression() {\n        if (this.score >= this.level * 500) {\n            this.level++;\n            this.timeLeft += 15;\n            this.spawnNewPlatforms();\n        }\n    }\n\n    spawnNewPlatforms() {\n        const startX = this.level * 200;\n        for (let i = 0; i < 5; i++) {\n            const x = startX + i * 150;\n            const y = 500 - i * 50;\n            this.platforms.push(new Platform(x, y, 150, 20));\n        }\n    }\n\n    checkGameOver() {\n        this.saveHighScore();\n        this.showGameOver();\n    }\n\n    render() {\n        // Clear canvas\n        this.ctx.clearRect(0, 0, this.canvas.width, this.canvas.height);\n        \n        // Draw background\n        this.drawBackground();\n        \n        // Draw water\n        this.drawWater();\n        \n        // Draw platforms\n        this.platforms.forEach(platform => platform.draw(this.ctx, this.camera));\n        \n        // Draw enemies\n        this.enemies.forEach(enemy => enemy.draw(this.ctx, this.camera));\n        \n        // Draw collectibles\n        this.collectibles.forEach(collectible => collectible.draw(this.ctx, this.camera));\n        \n        // Draw particles\n        this.particles.forEach(particle => particle.draw(this.ctx, this.camera));\n        \n        // Draw player\n        this.player.draw(this.ctx, this.camera);\n        \n        // Draw UI overlay elements that need canvas rendering\n        if (this.powerUpActive) {\n            this.drawPowerUpIndicator();\n        }\n    }\n\n    drawBackground() {\n        // Draw sky gradient\n        const gradient = this.ctx.createLinearGradient(0, 0, 0, this.canvas.height);\n        gradient.addColorStop(0, '#006994');\n        gradient.addColorStop(1, '#40B08C');\n        this.ctx.fillStyle = gradient;\n        this.ctx.fillRect(0, 0, this.canvas.width, this.canvas.height);\n        \n        // Draw sun\n        this.ctx.fillStyle = '#FFD700';\n        this.ctx.beginPath();\n        this.ctx.arc(this.canvas.width - 50, 50, 30, 0, Math.PI * 2);\n        this.ctx.fill();\n        \n        // Draw clouds\n        this.ctx.fillStyle = 'rgba(255, 255, 255, 0.7)';\n        for (let i = 0; i < 3; i++) {\n            const x = 100 + i * 200;\n            const y = 80;\n            this.ctx.beginPath();\n            this.ctx.arc(x, y, 20, 0, Math.PI * 2);\n            this.ctx.arc(x + 25, y, 25, 0, Math.PI * 2);\n            this.ctx.arc(x + 50, y, 20, 0, Math.PI * 2);\n            this.ctx.fill();\n        }\n    }\n\n    drawWater() {\n        this.ctx.fillStyle = 'rgba(0, 105, 148, 0.7)';\n        this.ctx.fillRect(0, this.waterLevel - this.camera.y, this.canvas.width, this.canvas.height - this.waterLevel + this.camera.y);\n        \n        // Draw water waves\n        this.ctx.strokeStyle = 'rgba(64, 176, 140, 0.5)';\n        this.ctx.lineWidth = 2;\n        for (let i = 0; i < this.canvas.width; i += 20) {\n            this.ctx.beginPath();\n            this.ctx.moveTo(i, this.waterLevel - this.camera.y);\n            this.ctx.bezierCurveTo(\n                i + 10, (this.waterLevel - this.camera.y) + 5,\n                i + 20, (this.waterLevel - this.camera.y) - 5,\n                i + 30, this.waterLevel - this.camera.y\n            );\n            this.ctx.stroke();\n        }\n    }\n\n    drawPowerUpIndicator() {\n        this.ctx.fillStyle = 'rgba(212, 175, 55, 0.8)';\n        this.ctx.fillRect(10, this.canvas.height - 50, 200, 30);\n        this.ctx.fillStyle = '#FFFFFF';\n        this.ctx.font = '16px Arial';\n        this.ctx.fillText(`Power-Up: ${this.powerUpType} (${Math.ceil(this.powerUpTimer)}s)`, 20, this.canvas.height - 30);\n    }\n}\n\n// Initialize game when DOM is loaded\nwindow.FishJumpAdventure = new FishJumpAdventure();\nwindow.addEventListener('load', () => {\n    if(window.FishJumpAdventure) window.FishJumpAdventure.init();\n});", "js/entities/player.js": "// Fish Jump Adventure - Player Entity\nclass Player {\n    constructor(x, y) {\n        this.x = x;\n        this.y = y;\n        this.width = 32;\n        this.height = 32;\n        this.vx = 0;\n        this.vy = 0;\n        this.speed = 5;\n        this.jumpForce = -12;\n        this.isOnGround = false;\n        this.facing = 1;\n        this.color = '#7FFFD4';\n        this.powerUps = [];\n        this.invincible = false;\n        this.invincibleTimer = 0;\n        this.startX = x;\n        this.startY = y;\n    }\n\n    update(deltaTime) {\n        // Handle input\n        const direction = inputManager ? inputManager.getDirection() : { x: 0, y: 0 };\n        \n        this.vx = direction.x * this.speed;\n        \n        // Handle jump\n        if (inputManager && inputManager.isJumpPressed() && this.isOnGround) {\n            this.vy = this.jumpForce;\n            this.isOnGround = false;\n            if (audioManager) audioManager.playSound('jump');\n        }\n        \n        // Handle dive\n        if (inputManager && inputManager.isDivePressed()) {\n            this.vy += 0.5;\n        }\n        \n        // Apply velocity\n        this.x += this.vx;\n        this.y += this.vy;\n        \n        // Apply friction\n        this.vx *= 0.9;\n        \n        // Update facing direction\n        if (this.vx > 0) this.facing = 1;\n        if (this.vx < 0) this.facing = -1;\n        \n        // Update invincibility timer\n        if (this.invincible) {\n            this.invincibleTimer -= deltaTime / 1000;\n            if (this.invincibleTimer <= 0) {\n                this.invincible = false;\n            }\n        }\n        \n        // Keep player in bounds\n        if (this.x < 0) this.x = 0;\n        if (this.y > 1000) {\n            this.y = 1000;\n            this.vy = 0;\n        }\n    }\n\n    handlePlatformCollision(platform) {\n        if (this.vy > 0 && this.y + this.height > platform.y) {\n            this.vy = 0;\n            this.y = platform.y - this.height;\n            this.isOnGround = true;\n            if (audioManager) audioManager.playSound('landing');\n        }\n    }\n\n    getBounds() {\n        return {\n            x: this.x,\n            y: this.y,\n            width: this.width,\n            height: this.height\n        };\n    }\n\n    addPowerUp(type) {\n        if (type === 'invincible') {\n            this.invincible = true;\n            this.invincibleTimer = 10;\n        }\n        this.powerUps.push(type);\n    }\n\n    resetPosition() {\n        this.x = this.startX;\n        this.y = this.startY;\n        this.vx = 0;\n        this.vy = 0;\n        this.isOnGround = false;\n    }\n\n    draw(ctx, camera) {\n        const screenX = this.x - camera.x;\n        const screenY = this.y - camera.y;\n        \n        // Draw player as a fish\n        ctx.fillStyle = this.color;\n        ctx.beginPath();\n        ctx.ellipse(screenX + this.width / 2, screenY + this.height / 2, this.width / 2, this.height / 2, 0, 0, Math.PI * 2);\n        ctx.fill();\n        \n        // Draw eye\n        ctx.fillStyle = '#000000';\n        ctx.beginPath();\n        ctx.arc(screenX + this.width / 2 + this.facing * 5, screenY + this.height / 2 - 5, 3, 0, Math.PI * 2);\n        ctx.fill();\n        \n        // Draw tail\n        ctx.fillStyle = this.color;\n        ctx.beginPath();\n        ctx.moveTo(screenX + this.width / 2, screenY + this.height / 2);\n        ctx.lineTo(screenX + this.width / 2 - this.facing * 10, screenY + this.height / 2 - 10);\n        ctx.lineTo(screenX + this.width / 2 - this.facing * 10, screenY + this.height / 2 + 10);\n        ctx.closePath();\n        ctx.fill();\n        \n        // Draw fins\n        ctx.fillStyle = '#40B08C';\n        ctx.beginPath();\n        ctx.ellipse(screenX + this.width / 2, screenY + 5, 5, 3, 0, 0, Math.PI * 2);\n        ctx.fill();\n        \n        // Draw invincibility effect\n        if (this.invincible) {\n            ctx.strokeStyle = '#FFD700';\n            ctx.lineWidth = 2;\n            ctx.beginPath();\n            ctx.arc(screenX + this.width / 2, screenY + this.height / 2, this.width / 2 + 5, 0, Math.PI * 2);\n            ctx.stroke();\n        }\n    }\n}\n\n// Export for use in other modules\nif (typeof module !== 'undefined' && module.exports) {\n    module.exports = Player;\n}", "js/entities/enemy.js": "// Fish Jump Adventure - Enemy Entity\nclass Enemy {\n    constructor(x, y, direction, speed) {\n        this.x = x;\n        this.y = y;\n        this.width = 32;\n        this.height = 32;\n        this.direction = direction;\n        this.speed = speed;\n        this.vx = direction === 'left' ? -speed : speed;\n        this.vy = 0;\n        this.color = '#FF6B9D';\n        this.patrolDistance = 100;\n        this.startX = x;\n    }\n\n    update(deltaTime) {\n        // Move back and forth\n        this.x += this.vx;\n        \n        // Reverse direction at patrol boundaries\n        if (Math.abs(this.x - this.startX) > this.patrolDistance) {\n            this.vx = -this.vx;\n        }\n        \n        // Apply gravity\n        this.vy += 0.5;\n        this.y += this.vy;\n        \n        // Keep on ground\n        if (this.y > 500) {\n            this.y = 500;\n            this.vy = 0;\n        }\n    }\n\n    getBounds() {\n        return {\n            x: this.x,\n            y: this.y,\n            width: this.width,\n            height: this.height\n        };\n    }\n\n    draw(ctx, camera) {\n        const screenX = this.x - camera.x;\n        const screenY = this.y - camera.y;\n        \n        // Draw enemy as a jellyfish\n        ctx.fillStyle = this.color;\n        ctx.beginPath();\n        ctx.ellipse(screenX + this.width / 2, screenY + this.height / 2, this.width / 2, this.height / 2, 0, 0, Math.PI * 2);\n        ctx.fill();\n        \n        // Draw tentacles\n        ctx.strokeStyle = this.color;\n        ctx.lineWidth = 2;\n        for (let i = 0; i < 4; i++) {\n            ctx.beginPath();\n            ctx.moveTo(screenX + this.width / 2, screenY + this.height / 2 + this.height / 2);\n            ctx.lineTo(screenX + this.width / 2 + (i - 1.5) * 8, screenY + this.height / 2 + this.height / 2 + 15);\n            ctx.stroke();\n        }\n        \n        // Draw face\n        ctx.fillStyle = '#000000';\n        ctx.beginPath();\n        ctx.arc(screenX + this.width / 2 - 5, screenY + this.height / 2 - 3, 2, 0, Math.PI * 2);\n        ctx.arc(screenX + this.width / 2 + 5, screenY + this.height / 2 - 3, 2, 0, Math.PI * 2);\n        ctx.fill();\n        \n        // Draw mouth\n        ctx.strokeStyle = '#000000';\n        ctx.lineWidth = 1;\n        ctx.beginPath();\n        ctx.arc(screenX + this.width / 2, screenY + this.height / 2 + 5, 5, 0, Math.PI);\n        ctx.stroke();\n    }\n}\n\n// Export for use in other modules\nif (typeof module !== 'undefined' && module.exports) {\n    module.exports = Enemy;\n}", "js/entities/platform.js": "// Fish Jump Adventure - Platform Entity\nclass Platform {\n    constructor(x, y, width, height) {\n        this.x = x;\n        this.y = y;\n        this.width = width;\n        this.height = height;\n        this.color = '#40B08C';\n        this.type = 'normal';\n    }\n\n    update(deltaTime) {\n        // Platforms are static, no update needed\n    }\n\n    getBounds() {\n        return {\n            x: this.x,\n            y: this.y,\n            width: this.width,\n            height: this.height\n        };\n    }\n\n    draw(ctx, camera) {\n        const screenX = this.x - camera.x;\n        const screenY = this.y - camera.y;\n        \n        // Draw platform\n        ctx.fillStyle = this.color;\n        ctx.fillRect(screenX, screenY, this.width, this.height);\n        \n        // Draw platform details\n        ctx.strokeStyle = '#2F2F2F';\n        ctx.lineWidth = 2;\n        ctx.strokeRect(screenX, screenY, this.width, this.height);\n        \n        // Draw algae details\n        ctx.fillStyle = '#A8E600';\n        for (let i = 0; i < this.width; i += 20) {\n            ctx.beginPath();\n            ctx.ellipse(screenX + i, screenY, 3, 5, 0, 0, Math.PI * 2);\n            ctx.fill();\n        }\n    }\n}\n\n// Export for use in other modules\nif (typeof module !== 'undefined' && module.exports) {\n    module.exports = Platform;\n}", "js/entities/collectible.js": "// Fish Jump Adventure - Collectible Entity\nclass Collectible {\n    constructor(x, y, type) {\n        this.x = x;\n        this.y = y;\n        this.width = 20;\n        this.height = 20;\n        this.type = type;\n        this.color = type === 'coin' ? '#FFD700' : type === 'gem' ? '#7FFFD4' : '#FF6B9D';\n        this.rotation = 0;\n        this.animationTime = 0;\n    }\n\n    update(deltaTime) {\n        this.animationTime += deltaTime / 1000;\n        this.rotation = this.animationTime * 2;\n    }\n\n    getBounds() {\n        return {\n            x: this.x,\n            y: this.y,\n            width: this.width,\n            height: this.height\n        };\n    }\n\n    draw(ctx, camera) {\n        const screenX = this.x - camera.x;\n        const screenY = this.y - camera.y;\n        \n        ctx.save();\n        ctx.translate(screenX + this.width / 2, screenY + this.height / 2);\n        ctx.rotate(this.rotation);\n        \n        if (this.type === 'coin') {\n            // Draw coin\n            ctx.fillStyle = this.color;\n            ctx.beginPath();\n            ctx.arc(0, 0, this.width / 2, 0, Math.PI * 2);\n            ctx.fill();\n            \n            // Draw shine\n            ctx.fillStyle = '#FFFFFF';\n            ctx.beginPath();\n            ctx.arc(-3, -3, 3, 0, Math.PI * 2);\n            ctx.fill();\n        } else if (this.type === 'gem') {\n            // Draw gem\n            ctx.fillStyle = this.color;\n            ctx.beginPath();\n            ctx.moveTo(0, -this.width / 2);\n            ctx.lineTo(this.width / 2, 0);\n            ctx.lineTo(0, this.width / 2);\n            ctx.lineTo(-this.width / 2, 0);\n            ctx.closePath();\n            ctx.fill();\n        } else if (this.type === 'powerup') {\n            // Draw power-up\n            ctx.fillStyle = this.color;\n            ctx.beginPath();\n            ctx.arc(0, 0, this.width / 2, 0, Math.PI * 2);\n            ctx.fill();\n            \n            // Draw star\n            ctx.strokeStyle = '#FFFFFF';\n            ctx.lineWidth = 2;\n            ctx.beginPath();\n            for (let i = 0; i < 5; i++) {\n                const angle = (i * Math.PI * 2) / 5 - Math.PI / 2;\n                const x = Math.cos(angle) * this.width / 3;\n                const y = Math.sin(angle) * this.width / 3;\n                if (i === 0) {\n                    ctx.moveTo(x, y);\n                } else {\n                    ctx.lineTo(x, y);\n                }\n            }\n            ctx.stroke();\n        }\n        \n        ctx.restore();\n    }\n}\n\n// Export for use in other modules\nif (typeof module !== 'undefined' && module.exports) {\n    module.exports = Collectible;\n}", "js/entities/particle.js": "// Fish Jump Adventure - Particle System\nclass Particle {\n    constructor(x, y, color) {\n        this.x = x;\n        this.y = y;\n        this.vx = Utils.random(-3, 3);\n        this.vy = Utils.random(-5, -1);\n        this.size = Utils.random(2, 6);\n        this.color = color;\n        this.life = 1;\n        this.decay = Utils.random(0.01, 0.03);\n    }\n\n    update(deltaTime) {\n        this.x += this.vx;\n        this.y += this.vy;\n        this.vy += 0.1;\n        this.life -= this.decay;\n    }\n\n    isDead() {\n        return this.life <= 0;\n    }\n\n    draw(ctx, camera) {\n        const screenX = this.x - camera.x;\n        const screenY = this.y - camera.y;\n        \n        ctx.globalAlpha = this.life;\n        ctx.fillStyle = this.color;\n        ctx.beginPath();\n        ctx.arc(screenX, screenY, this.size, 0, Math.PI * 2);\n        ctx.fill();\n        ctx.globalAlpha = 1;\n    }\n}\n\n// Export for use in other modules\nif (typeof module !== 'undefined' && module.exports) {\n    module.exports = Particle;\n}", "js/systems/physics.js": "// Fish Jump Adventure - Physics System\nconst Physics = {\n    gravity: 0.5,\n    friction: 0.9,\n    terminalVelocity: 15,\n    \n    applyGravity(entity) {\n        if (!entity.isOnGround) {\n            entity.vy += this.gravity;\n            if (entity.vy > this.terminalVelocity) {\n                entity.vy = this.terminalVelocity;\n            }\n        }\n    },\n    \n    applyFriction(entity) {\n        entity.vx *= this.friction;\n    },\n    \n    updateEntity(entity, deltaTime) {\n        entity.x += entity.vx;\n        entity.y += entity.vy;\n        this.applyGravity(entity);\n        this.applyFriction(entity);\n    },\n    \n    checkCollision(entity1, entity2) {\n        return Utils.rect