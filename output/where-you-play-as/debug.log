class=\"screen\">\n        <div class=\"gameover-block\">\n            <h1>The Forest Remembers.</h1>\n            <p>You were seen.</p>\n            <button id=\"respawn-btn\" class=\"menu-btn\">Rise Again</button>\n        </div>\n    </div>\n\n    <!-- HUD -->\n    <div id=\"hud\">\n        <!-- Speedrun Timer -->\n        <div id=\"speedrun-timer\" class=\"hud-corner top-center\">\n            <span class=\"timer-label\">RUN</span>\n            <span id=\"timer-display\">00:00.00</span>\n        </div>\n\n        <!-- Detection Compass (top-left) -->\n        <div id=\"compass\" class=\"hud-corner top-left\">\n            <div class=\"compass-ring\">\n                <div id=\"compass-arrow\"></div>\n                <div class=\"compass-center\"></div>\n            </div>\n            <div id=\"compass-distance\">---</div>\n        </div>\n\n        <!-- Beast Detection Meter (top-right) -->\n        <div id=\"detection-meter\" class=\"hud-corner top-right\">\n            <div class=\"meter-label\">AWARENESS</div>\n            <div class=\"meter-track\">\n                <div id=\"meter-fill\"></div>\n            </div>\n            <div id=\"meter-value\">0%</div>\n        </div>\n\n        <!-- Tool Belt (bottom-center) -->\n        <div id=\"tool-belt\" class=\"hud-corner bottom-center\">\n            <div class=\"tool-slot\" data-slot=\"0\">\n                <div class=\"tool-hex\"><span>1</span><div class=\"tool-icon\">🔍</div></div>\n                <div class=\"tool-cooldown\"></div>\n                <div class=\"tool-name\">Tracker Lens</div>\n            </div>\n            <div class=\"tool-slot\" data-slot=\"1\">\n                <div class=\"tool-hex\"><span>2</span><div class=\"tool-icon\">💥</div></div>\n                <div class=\"tool-cooldown\"></div>\n                <div class=\"tool-name\">Sound Flare</div>\n            </div>\n            <div class=\"tool-slot\" data-slot=\"2\">\n                <div class=\"tool-hex\"><span>3</span><div class=\"tool-icon\">👻</div></div>\n                <div class=\"tool-cooldown\"></div>\n                <div class=\"tool-name\">Stealth Cloak</div>\n            </div>\n        </div>\n\n        <!-- Stealth & Stamina (bottom-right) -->\n        <div id=\"status-bars\" class=\"hud-corner bottom-right\">\n            <div class=\"vbar-wrap\">\n                <div class=\"vbar-label\">N</div>\n                <div class=\"vbar-track\"><div id=\"noise-fill\" class=\"vbar-fill\"></div></div>\n            </div>\n            <div class=\"vbar-wrap\">\n                <div class=\"vbar-label\">S</div>\n                <div class=\"vbar-track\"><div id=\"stamina-fill\" class=\"vbar-fill\"></div></div>\n            </div>\n        </div>\n\n        <!-- Interaction Prompt -->\n        <div id=\"interact-prompt\"></div>\n\n        <!-- Minimap (bottom-left) -->\n        <div id=\"minimap-wrap\" class=\"hud-corner bottom-left\">\n            <canvas id=\"minimap\"></canvas>\n        </div>\n    </div>\n</div>\n\n<script src=\"js/modules/utils.js\"></script>\n<script src=\"js/modules/audio.js\"></script>\n<script src=\"js/modules/world.js\"></script>\n<script src=\"js/modules/physics.js\"></script>\n<script src=\"js/modules/player.js\"></script>\n<script src=\"js/modules/beastAI.js\"></script>\n<script src=\"js/modules/tools.js\"></script>\n<script src=\"js/modules/renderer.js\"></script>\n<script src=\"js/modules/ui.js\"></script>\n<script src=\"js/main.js\"></script>\n</body>\n</html>\n", "css/hud.css": "/* ============================================\n   Crimson Trail - HUD Styling\n   Palette: Crimson #8b1a0a, Ember #c44b1a,\n            Moss #3a5a2a, Bone #e8d8b8,\n            Fog #c8c0b8, Shadow #1a0e08\n   ============================================ */\n\n:root {\n    --crimson: #8b1a0a;\n    --ember: #c44b1a;\n    --amber: #d97a2a;\n    --moss: #3a5a2a;\n    --bark: #4a2a18;\n    --bone: #e8d8b8;\n    --fog: #c8c0b8;\n    --shadow: #1a0e08;\n    --leaf: #6a3a1a;\n    --dusk: #2a1a14;\n    --hud-bg: rgba(20, 12, 8, 0.72);\n    --hud-border: rgba(232, 216, 184, 0.25);\n    --hud-glow: rgba(201, 90, 40, 0.4);\n}\n\n* { box-sizing: border-box; margin: 0; padding: 0; }\n\nhtml, body {\n    width: 100%;\n    height: 100%;\n    overflow: hidden;\n    background: #000;\n    font-family: 'Courier New', monospace;\n    color: var(--bone);\n    user-select: none;\n    -webkit-tap-highlight-color: transparent;\n    touch-action: none;\n}\n\n#game-wrapper {\n    position: relative;\n    width: 100vw;\n    height: 100vh;\n    overflow: hidden;\n}\n\n#game-canvas {\n    display: block;\n    width: 100%;\n    height: 100%;\n    background: #0a0604;\n    cursor: crosshair;\n    image-rendering: auto;\n}\n\n/* ===== Screens ===== */\n.screen {\n    position: absolute;\n    inset: 0;\n    display: none;\n    align-items: center;\n    justify-content: center;\n    background: radial-gradient(ellipse at center, rgba(40, 20, 10, 0.85), rgba(10, 6, 4, 0.97));\n    z-index: 100;\n    backdrop-filter: blur(2px);\n}\n.screen.active { display: flex; }\n\n.title-block, .encounter-block, .gameover-block {\n    text-align: center;\n    padding: 40px;\n    border: 1px solid var(--hud-border);\n    background: var(--hud-bg);\n    border-radius: 4px;\n    box-shadow: 0 0 60px var(--hud-glow), inset 0 0 30px rgba(0,0,0,0.5);\n    max-width: 90vw;\n}\n\n.title-block h1 {\n    font-family: Georgia, serif;\n    font-size: clamp(2.2rem, 6vw, 4.2rem);\n    color: var(--ember);\n    letter-spacing: 0.15em;\n    text-shadow: 0 0 30px var(--hud-glow), 0 4px 0 var(--shadow);\n    margin-bottom: 0.2em;\n}\n.title-block h2 {\n    font-family: Georgia, serif;\n    font-style: italic;\n    font-size: clamp(1rem, 2.5vw, 1.4rem);\n    color: var(--fog);\n    font-weight: 300;\n    margin-bottom: 1.5em;\n}\n.lore {\n    font-size: clamp(0.8rem, 2vw, 0.95rem);\n    color: var(--fog);\n    margin-bottom: 2em;\n    line-height: 1.6;\n    max-width: 400px;\n    margin-left: auto;\n    margin-right: auto;\n}\n\n.menu-btn {\n    font-family: 'Courier New', monospace;\n    background: transparent;\n    color: var(--bone);\n    border: 1px solid var(--ember);\n    padding: 14px 38px;\n    font-size: 1rem;\n    letter-spacing: 0.2em;\n    cursor: pointer;\n    transition: all 0.3s ease;\n    text-transform: uppercase;\n    position: relative;\n    overflow: hidden;\n}\n.menu-btn:hover {\n    background: var(--ember);\n    color: var(--shadow);\n    box-shadow: 0 0 30px var(--ember);\n}\n\n.high-score-display {\n    margin-top: 2em;\n    padding-top: 1.5em;\n    border-top: 1px dashed var(--hud-border);\n}\n.hs-label {\n    display: block;\n    font-size: 0.7rem;\n    letter-spacing: 0.3em;\n    color: var(--fog);\n    margin-bottom: 0.5em;\n}\n.hs-value {\n    font-size: 1.4rem;\n    color: var(--amber);\n    font-weight: bold;\n    letter-spacing: 0.1em;\n}\n\n.encounter-block h1 {\n    font-family: Georgia, serif;\n    color: var(--amber);\n    font-size: clamp(1.8rem, 5vw, 2.6rem);\n    margin-bottom: 1.5em;\n    text-shadow: 0 0 20px var(--hud-glow);\n}\n.stat-row {\n    display: flex;\n    justify-content: space-between;\n    padding: 8px 0;\n    border-bottom: 1px solid var(--hud-border);\n    font-size: 0.9rem;\n    min-width: 260px;\n}\n.stat-row span:last-child { color: var(--amber); font-weight: bold; }\n\n.gameover-block h1 {\n    font-family: Georgia, serif;\n    font-style: italic;\n    color: var(--crimson);\n    font-size: clamp(1.8rem, 5vw, 2.6rem);\n    margin-bottom: 0.5em;\n    text-shadow: 0 0 20px var(--crimson);\n}\n.gameover-block p {\n    color: var(--fog);\n    margin-bottom: 2em;\n    letter-spacing: 0.2em;\n    font-size: 0.85rem;\n}\n\n/* ===== HUD Layout ===== */\n#hud {\n    position: absolute;\n    inset: 0;\n    pointer-events: none;\n    z-index: 10;\n    font-size: 11px;\n}\n\n.hud-corner {\n    position: absolute;\n    padding: 10px;\n}\n\n/* Speedrun Timer (top-center) */\n#speedrun-timer {\n    top: 8px;\n    left: 50%;\n    transform: translateX(-50%);\n    background: var(--hud-bg);\n    border: 1px solid var(--hud-border);\n    padding: 6px 16px;\n    border-radius: 2px;\n    display: flex;\n    gap: 10px;\n    align-items: center;\n    backdrop-filter: blur(4px);\n}\n.timer-label {\n    color: var(--amber);\n    letter-spacing: 0.3em;\n    font-weight: bold;\n}\n#timer-display {\n    color: var(--bone);\n    font-weight: bold;\n    font-size: 1rem;\n    letter-spacing: 0.08em;\n    text-shadow: 0 0 8px rgba(217, 122, 42, 0.5);\n}\n\n/* Compass (top-left) */\n#compass {\n    top: 8px;\n    left: 8px;\n    width: 92px;\n    background: var(--hud-bg);\n    border: 1px solid var(--hud-border);\n    border-radius: 50%;\n    padding: 0;\n    text-align: center;\n    backdrop-filter: blur(4px);\n}\n.compass-ring {\n    width: 78px;\n    height: 78px;\n    margin: 6px auto 4px;\n    position: relative;\n    border: 1px solid var(--hud-border);\n    border-radius: 50%;\n}\n.compass-center {\n    position: absolute;\n    width: 6px;\n    height: 6px;\n    background: var(--ember);\n    border-radius: 50%;\n    top: 50%;\n    left: 50%;\n    transform: translate(-50%, -50%);\n    box-shadow: 0 0 8px var(--ember);\n}\n#compass-arrow {\n    position: absolute;\n    width: 0;\n    height: 0;\n    border-left: 6px solid transparent;\n    border-right: 6px solid transparent;\n    border-bottom: 12px solid var(--crimson);\n    top: 50%;\n    left: 50%;\n    transform-origin: 50% 36px;\n    transform: translate(-50%, -50%) rotate(0deg);\n    opacity: 0;\n    transition: opacity 0.3s;\n    filter: drop-shadow(0 0 4px var(--crimson));\n}\n#compass-arrow.visible { opacity: 1; animation: pulse-compass 1s infinite; }\n@keyframes pulse-compass {\n    0%, 100% { opacity: 0.6; }\n    50% { opacity: 1; }\n}\n#compass-distance {\n    font-size: 10px;\n    color: var(--fog);\n    margin-bottom: 4px;\n    letter-spacing: 0.05em;\n}\n\n/* Detection Meter (top-right) */\n#detection-meter {\n    top: 8px;\n    right: 8px;\n    text-align: right;\n    background: var(--hud-bg);\n    border: 1px solid var(--hud-border);\n    padding: 8px;\n    border-radius: 2px;\n    backdrop-filter: blur(4px);\n}\n.meter-label {\n    color: var(--fog);\n    font-size: 9px;\n    letter-spacing: 0.2em;\n    margin-bottom: 4px;\n}\n.meter-track {\n    width: 8px;\n    height: 120px;\n    background: rgba(0,0,0,0.5);\n    border: 1px solid var(--hud-border);\n    margin-left: auto;\n    position: relative;\n    overflow: hidden;\n}\n#meter-fill {\n    position: absolute;\n    bottom: 0;\n    left: 0;\n    width: 100%;\n    height: 0%;\n    background: linear-gradient(to top, #4a8acc, #c4a83a, #c44b1a, #8b1a0a);\n    transition: height 0.2s, background 0.5s;\n}\n#meter-fill.critical {\n    animation: pulse-meter 0.8s infinite;\n}\n@keyframes pulse-meter {\n    0%, 100% { box-shadow: 0 0 8px var(--crimson); }\n    50% { box-shadow: 0 0 24px var(--crimson); }\n}\n#meter-value {\n    font-size: 10px;\n    color: var(--bone);\n    margin-top: 4px;\n    font-weight: bold;\n}\n\n/* Tool Belt (bottom-center) */\n#tool-belt {\n    bottom: 12px;\n    left: 50%;\n    transform: translateX(-50%);\n    display: flex;\n    gap: 12px;\n    background: var(--hud-bg);\n    border: 1px solid var(--hud-border);\n    padding: 8px 14px;\n    border-radius: 2px;\n    backdrop-filter: blur(4px);\n}\n.tool-slot {\n    position: relative;\n    width: 54px;\n    height: 60px;\n    text-align: center;\n}\n.tool-hex {\n    width: 48px;\n    height: 52px;\n    background: rgba(20, 12, 8, 0.85);\n    border: 1px solid var(--hud-border);\n    clip-path: polygon(25% 0%, 75% 0%, 100% 50%, 75% 100%, 25% 100%, 0% 50%);\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    justify-content: center;\n    position: relative;\n    margin: 0 auto;\n}\n.tool-hex span {\n    position: absolute;\n    top: 4px;\n    font-size: 9px;\n    color: var(--fog);\n    letter-spacing: 0.1em;\n}\n.tool-icon {\n    font-size: 20px;\n    margin-top: 8px;\n    filter: grayscale(0.3) brightness(0.85);\n    transition: filter 0.2s;\n}\n.tool-slot.active .tool-icon { filter: grayscale(0) brightness(1.2); }\n.tool-slot.active .tool-hex {\n    border-color: var(--bone);\n    box-shadow: 0 0 12px var(--ember), inset 0 0 8px var(--ember);\n}\n.tool-cooldown {\n    position: absolute;\n    bottom: 4px;\n    left: 50%;\n    transform: translateX(-50%);\n    width: 36px;\n    height: 4px;\n    background: rgba(0,0,0,0.6);\n    border: 1px solid var(--hud-border);\n    overflow: hidden;\n}\n.tool-cooldown::after {\n    content: '';\n    display: block;\n    height: 100%;\n    width: var(--cd, 0%);\n    background: var(--amber);\n}\n.tool-name {\n    position: absolute;\n    bottom: -18px;\n    left: 50%;\n    transform: translateX(-50%);\n    font-size: 9px;\n    color: var(--fog);\n    white-space: nowrap;\n    opacity: 0;\n    transition: opacity 0.2s;\n    pointer-events: none;\n}\n.tool-slot:hover .tool-name { opacity: 1; }\n\n/* Status Bars (bottom-right) */\n#status-bars {\n    bottom: 12px;\n    right: 12px;\n    display: flex;\n    gap: 8px;\n    background: var(--hud-bg);\n    border: 1px solid var(--hud-border);\n    padding: 8px;\n    border-radius: 2px;\n    backdrop-filter: blur(4px);\n}\n.vbar-wrap {\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    gap: 4px;\n}\n.vbar-label {\n    font-size: 9px;\n    color: var(--fog);\n    font-weight: bold;\n}\n.vbar-track {\n    width: 10px;\n    height: 64px;\n    background: rgba(0,0,0,0.5);\n    border: 1px solid var(--hud-border);\n    position: relative;\n}\n.vbar-fill {\n    position: absolute;\n    bottom: 0;\n    left: 0;\n    width: 100%;\n    height: 0%;\n    background: var(--moss);\n    transition: height 0.15s, background 0.3s;\n}\n#noise-fill.warning { background: var(--amber); }\n#noise-fill.danger { background: var(--crimson); animation: shake 0.3s infinite; }\n@keyframes shake {\n    0%, 100% { transform: translateX(0); }\n    50% { transform: translateX(1px); }\n}\n#stamina-fill { background: var(--bone); }\n\n/* Minimap (bottom-left) */\n#minimap-wrap {\n    bottom: 12px;\n    left: 12px;\n    background: var(--hud-bg);\n    border: 1px solid var(--hud-border);\n    padding: 4px;\n    border-radius: 2px;\n    backdrop-filter: blur(4px);\n}\n#minimap {\n    display: block;\n    width: 110px;\n    height: 110px;\n    image-rendering: pixelated;\n}\n\n/* Interaction Prompt */\n#interact-prompt {\n    position: absolute;\n    left: 50%;\n    top: 55%;\n    transform: translateX(-50%);\n    background: var(--hud-bg);\n    border: 1px solid var(--hud-border);\n    padding: 6px 14px;\n    font-family: Georgia, serif;\n    font-style: italic;\n    font-size: 0.9rem;\n    color: var(--bone);\n    opacity: 0;\n    transition: opacity 0.25s;\n    backdrop-filter: blur(3px);\n    white-space: nowrap;\n}\n#interact-prompt.visible { opacity: 1; }\n\n/* ===== Responsive Scaling for Mobile ===== */\n@media (max-width: 700px) {\n    #compass { width: 70px; }\n    .compass-ring { width: 58px; height: 58px; }\n    #compass-arrow { border-left-width: 4px; border-right-width: 4px; border-bottom-width: 9px; transform-origin: 50% 27px; }\n    .meter-track { height: 90px; }\n    #tool-belt { padding: 6px 10px; gap: 8px; }\n    .tool-slot { width: 44px; height: 50px; }\n    .tool-hex { width: 38px; height: 42px; }\n    .tool-icon { font-size: 16px; }\n    .vbar-track { height: 50px; }\n    #minimap { width: 80px; height: 80px; }\n    #minimap-wrap { padding: 3px; }\n    .hud-corner { padding: 6px; }\n    #speedrun-timer { padding: 4px 10px; }\n    #timer-display { font-size: 0.85rem; }\n}\n\n@media (max-width: 480px) {\n    #compass { width: 56px; }\n    .compass-ring { width: 46px; height: 46px; }\n    .compass-ring .compass-center { width: 4px; height: 4px; }\n    #compass-distance { font-size: 8px; }\n    #detection-meter { padding: 5px; }\n    .meter-track { height: 70px; width: 6px; }\n    .meter-label, #meter-value { font-size: 8px; }\n    .tool-slot { width: 38px; height: 44px; }\n    .tool-hex { width: 32px; height: 36px; }\n    .tool-icon { font-size: 14px; margin-top: 6px; }\n    .tool-hex span { font-size: 8px; top: 3px; }\n    #status-bars { gap: 5px; padding: 5px; }\n    .vbar-track { height: 40px; width: 8px; }\n    .vbar-label { font-size: 8px; }\n    #minimap { width: 64px; height: 64px; }\n}\n\n/* Damage flash overlay */\n#hud.damage-flash::before {\n    content: '';\n    position: absolute;\n    inset: 0;\n    background: radial-gradient(circle, transparent 40%, rgba(139, 26, 10, 0.4));\n    pointer-events: none;\n    animation: flash 0.5s;\n}\n@keyframes flash {\n    0% { opacity: 0; }\n    20% { opacity: 1; }\n    100% { opacity: 0; }\n}\n", "js/modules/utils.js": "// ============================================\n// Utility functions & seeded RNG\n// ============================================\n\nconst Utils = {\n    rand(seed) {\n        // Mulberry32 PRNG - fast deterministic seeded random\n        this._seed = (this._seed || seed) >>> 0;\n        this._seed = (this._seed + 0x6D2B79F5) >>> 0;\n        let t = this._seed;\n        t = Math.imul(t ^ (t >>> 15), t | 1);\n        t ^= t + Math.imul(t ^ (t >>> 7), t | 61);\n        return ((t ^ (t >>> 14)) >>> 0) / 4294967296;\n    },\n    resetSeed(seed) { this._seed = seed >>> 0; },\n    range(rand, min, max) { return min + rand() * (max - min); },\n    intRange(rand, min, max) { return Math.floor(min + rand() * (max - min + 1)); },\n    distance(a, b) {\n        const dx = a.x - b.x, dy = a.y - b.y;\n        return Math.sqrt(dx * dx + dy * dy);\n    },\n    distanceSq(a, b) {\n        const dx = a.x - b.x, dy = a.y - b.y;\n        return dx * dx + dy * dy;\n    },\n    clamp(v, min, max) { return v < min ? min : (v > max ? max : v); },\n    lerp(a, b, t) { return a + (b - a) * t; },\n    lerpColor(c1, c2, t) {\n        return {\n            r: Math.round(this.lerp(c1.r, c2.r, t)),\n            g: Math.round(this.lerp(c1.g, c2.g, t)),\n            b: Math.round(this.lerp(c1.b, c2.b, t))\n        };\n    },\n    normalize(vx, vy) {\n        const m = Math.sqrt(vx * vx + vy * vy);\n        if (m < 0.0001) return { x: 0, y: 0 };\n        return { x: vx / m, y: vy / m };\n    },\n    aabb(a, b) {\n        return a.x < b.x + b.w &&\n               a.x + a.w > b.x &&\n               a.y < b.y + b.h &&\n               a.y + a.h > b.y;\n    },\n    formatTime(ms) {\n        const totalSec = ms / 1000;\n        const m = Math.floor(totalSec / 60);\n        const s = Math.floor(totalSec % 60);\n        const cs = Math.floor((totalSec * 100) % 100);\n        return `${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}.${String(cs).padStart(2, '0')}`;\n    },\n    // Line-of-sight via grid raycasting (simple)\n    hasLineOfSight(ax, ay, bx, by, world) {\n        const steps = Math.ceil(Math.max(Math.abs(bx - ax), Math.abs(by - ay)) / 8);\n        for (let i = 1; i < steps; i++) {\n            const t = i / steps;\n            const x = ax + (bx - ax) * t;\n            const y = ay + (by - ay) * t;\n            if (world.isSolidAt(x, y)) return false;\n        }\n        return true;\n    },\n    angleBetween(ax, ay, bx, by) {\n        return Math.atan2(by - ay, bx - ax);\n    },\n    angleDiff(a, b) {\n        let d = b - a;\n        while (d > Math.PI) d -= Math.PI * 2;\n        while (d < -Math.PI) d += Math.PI * 2;\n        return d;\n    },\n    // Deterministic hash for grid\n    hash(x, y, salt = 0) {\n        let h = (x * 374761393 + y * 668265263 + salt * 982451653) | 0;\n        h = (h ^ (h >>> 13)) * 1274126177;\n        return ((h ^ (h >>> 16)) >>> 0) / 4294967296;\n    }\n};\n\nwindow.Utils = Utils;\n", "js/modules/audio.js": "// ============================================\n// Procedural Audio (Web Audio API)\n// ============================================\n\nconst Audio = {\n    ctx: null,\n    masterGain: null,\n    musicGain: null,\n    sfxGain: null,\n    heartbeatInterval: null,\n    ambientStarted: false,\n    initialized: false,\n\n    init() {\n        if (this.initialized) return;\n        try {\n            this.ctx = new (window.AudioContext || window.webkitAudioContext)();\n            this.masterGain = this.ctx.createGain();\n            this.masterGain.gain.value = 0.5;\n            this.masterGain.connect(this.ctx.destination);\n\n            this.musicGain = this.ctx.createGain();\n            this.musicGain.gain.value = 0.6;\n            this.musicGain.connect(this.masterGain);\n\n            this.sfxGain = this.ctx.createGain();\n            this.sfxGain.gain.value = 0.7;\n            this.sfxGain.connect(this.masterGain);\n            this.initialized = true;\n        } catch (e) {\n            console.warn('Audio init failed', e);\n        }\n    },\n\n    resume() {\n        if (this.ctx && this.ctx.state === 'suspended') this.ctx.resume();\n    },\n\n    setMasterVolume(v) {\n        if (this.masterGain) this.masterGain.gain.value = Utils.clamp(v, 0, 1);\n    },\n\n    // --- Utility oscillators ---\n    _osc(freq, type, dur, vol = 0.5, attack = 0.01, release = 0.05) {\n        if (!this.ctx) return;\n        const osc = this.ctx.createOscillator();\n        const gain = this.ctx.createGain();\n        osc.type = type;\n        osc.frequency.value = freq;\n        const now = this.ctx.currentTime;\n        gain.gain.setValueAtTime(0, now);\n        gain.gain.linearRampToValueAtTime(vol, now + attack);\n        gain.gain.exponentialRampToToEndTime(0.0001, now + dur - release);\n        gain.gain.exponentialRampToValueAtTime(0.0001, now + dur);\n        osc.connect(gain).connect(this.sfxGain);\n        osc.start(now);\n        osc.stop(now + dur);\n    },\n\n    _noiseBuffer(dur = 1) {\n        if (!this.ctx) return null;\n        const len = Math.floor(this.ctx.sampleRate * dur);\n        const buf = this.ctx.createBuffer(1, len, this.ctx.sampleRate);\n        const data = buf.getChannelData(0);\n        for (let i = 0; i < len; i++) data[i] = (Math.random() * 2 - 1);\n        return buf;\n    },\n\n    playNoise(dur, vol = 0.3, freq = 800, q = 1) {\n        if (!this.ctx) return;\n        const src = this.ctx.createBufferSource();\n        src.buffer = this._noiseBuffer(dur);\n        const filter = this.ctx.createBiquadFilter();\n        filter.type = 'bandpass';\n        filter.frequency.value = freq;\n        filter.Q.value = q;\n        const gain = this.ctx.createGain();\n        const now = this.ctx.currentTime;\n        gain.gain.setValueAtTime(vol, now);\n        gain.gain.exponentialRampToValueAtTime(0.0001, now + dur);\n        src.connect(filter).connect(gain).connect(this.sfxGain);\n        src.start(now);\n        src.stop(now + dur);\n    },\n\n    // --- Game SFX ---\n    playFootstep(surface = 'leaf') {\n        const baseFreq = surface === 'grass' ? 200 : 120;\n        this._osc(baseFreq + Math.random() * 40, 'triangle', 0.08, 0.18);\n        this.playNoise(0.08, 0.08, 600 + Math.random() * 200);\n    },\n\n    playSprint() {\n        this.playNoise(0.15, 0.15, 400);\n        this._osc(150, 'sawtooth', 0.12, 0.08);\n    },\n\n    playStealth() {\n        this._osc(880, 'sine', 0.25, 0.2);\n        this._osc(1320, 'sine', 0.25, 0.12);\n    },\n\n    playFlare() {\n        if (!this.ctx) return;\n        const now = this.ctx.currentTime;\n        const osc = this.ctx.createOscillator();\n        const gain = this.ctx.createGain();\n        osc.type = 'sawtooth';\n        osc.frequency.setValueAtTime(220, now);\n        osc.frequency.exponentialRampToValueAtTime(1200, now + 0.15);\n        osc.frequency.exponentialRampToValueAtTime(80, now + 1.5);\n        gain.gain.setValueAtTime(0.4, now);\n        gain.gain.exponentialRampToValueAtTime(0.0001, now + 1.5);\n        osc.connect(gain).connect(this.sfxGain);\n        osc.start(now);\n        osc.stop(now + 1.5);\n        this.playNoise(1.4, 0.2, 500);\n    },\n\n    playHeartbeat(rate = 1) {\n        const t = this.ctx ? this.ctx.currentTime : 0;\n        this._osc(60, 'sine', 0.1, 0.35);\n        setTimeout(() => this._osc(50, 'sine', 0.12, 0.3), 120);\n    },\n\n    startHeartbeat() {\n        if (this.heartbeatInterval) return;\n        const beat = () => {\n            this.playHeartbeat();\n            const next = 800 - this._lastTension * 400 || 700;\n            this.heartbeatInterval = setTimeout(beat, next);\n        };\n        beat();\n    },\n    setTension(t) { this._lastTension = t; },\n    stopHeartbeat() {\n        if (this.heartbeatInterval) clearTimeout(this.heartbeatInterval);\n        this.heartbeatInterval = null;\n    },\n\n    playDamage() {\n        this._osc(180, 'sawtooth', 0.3, 0.4);\n        this._osc(120, 'square', 0.25, 0.2);\n        this.playNoise(0.3, 0.3, 300);\n    },\n\n    playCacheFound() {\n        this._osc(523, 'sine', 0.15, 0.3);\n        setTimeout(() => this._osc(659, 'sine', 0.15, 0.3), 80);\n        setTimeout(() => this._osc(784, 'sine', 0.3, 0.3), 160);\n    },\n\n    playStagRoar() {\n        if (!this.ctx) return;\n        const now = this.ctx.currentTime;\n        const osc = this.ctx.createOscillator();\n        const gain = this.ctx.createGain();\n        osc.type = 'sawtooth';\n        osc.frequency.setValueAtTime(80, now);\n        osc.frequency.linearRampToValueAtTime(180, now + 0.4);\n        osc.frequency.linearRampToValueAtTime(60, now + 1.4);\n        gain.gain.setValueAtTime(0.5, now);\n        gain.gain.exponentialRampToValueAtTime(0.0001, now + 1.6);\n        osc.connect(gain).connect(this.sfxGain);\n        osc.start(now);\n        osc.stop(now + 1.6);\n        this.playNoise(1.4, 0.35, 250);\n    },\n\n    playEncounterStart() {\n        this._osc(110, 'sawtooth', 0.4, 0.4);\n        this._osc(55, 'sine', 0.6, 0.3);\n        this.playNoise(0.6, 0.25, 200);\n    },\n\n    playClick() {\n        this._osc(900, 'square', 0.05, 0.15);\n    },\n\n    // --- Ambient loop ---\n    startAmbient() {\n        if (this.ambientStarted || !this.ctx) return;\n        this.ambientStarted = true;\n\n        const noise = this.ctx.createBufferSource();\n        noise.buffer = this._noiseBuffer(4);\n        noise.loop = true;\n        const filter = this.ctx.createBiquadFilter();\n        filter.type = 'lowpass';\n        filter.frequency.value = 400;\n        const gain = this.ctx.createGain();\n        gain.gain.value = 0.08;\n        noise.connect(filter).connect(gain).connect(this.musicGain);\n        noise.start();\n        this._ambientNoise = { noise, gain, filter };\n\n        // Wind howl (slow LFO on a sine)\n        const windOsc = this.ctx.createOscillator();\n        const windGain = this.ctx.createGain();\n        windOsc.type = 'sawtooth';\n        windOsc.frequency.value = 60;\n        windGain.gain.value = 0.0;\n        const lfo = this.ctx.createOscillator();\n        const lfoGain = this.ctx.createGain();\n        lfo.frequency.value = 0.12;\n        lfoGain.gain.value = 0.05;\n        lfo.connect(lfoGain).connect(windGain.gain);\n        windOsc.connect(windGain).connect(this.musicGain);\n        windOsc.start();\n        lfo.start();\n        this._windOsc = windOsc;\n        this._windGain = windGain;\n    },\n\n    setWindIntensity(v) {\n        if (this._windGain) this._windGain.gain.value = Utils.clamp(v, 0, 0.15);\n    },\n\n    stopAmbient() {\n        this.ambientStarted = false;\n        if (this._ambientNoise) try { this._ambientNoise.noise.stop(); } catch(e){}\n        if (this._windOsc) try { this._windOsc.stop(); } catch(e){}\n    }\n};\n\nwindow.Audio = Audio;\n", "js/modules/world.js": "// ============================================\n// Procedural World Generation\n// Forest of crimson maples, fog, ruins, streams\n// ============================================\n\nconst World = {\n    width: 4800,\n    height: 3600,\n    tileSize: 32,\n    cols: 0,\n    rows: 0,\n    grid: null,\n    decor: [],\n    caches: [],\n    ruinZones: [],\n    streamSegments: [],\n    spawn: { x: 0, y: 0 },\n    stagSpawn: { x: 0, y: 0 },\n    seed: 12345,\n\n    generate(seed) {\n        this.seed = seed;\n        Utils.resetSeed(seed);\n        this.cols = Math.ceil(this.width / this.tileSize);\n        this.rows = Math.ceil(this.height / this.tileSize);\n\n        // Build base ground grid (0=open, 1=tree, 2=rock, 3=water, 4=bush)\n        this.grid = new Uint8Array(this.cols * this.rows);\n        const rand = () => Utils.rand(seed);\n\n        // Pre-generate tree blobs via noise\n        for (let y = 0; y < this.rows; y++) {\n            for (let x = 0; x < this.cols; x++) {\n                const wx = x * this.tileSize;\n                const wy = y * this.tileSize;\n                const distFromCenter = Math.hypot(wx - this.width / 2, wy - this.height / 2);\n                const maxDist = Math.min(this.width, this.height) * 0.45;\n\n                // Noise samples (multi-octave)\n                const n1 = Utils.hash(x, y, 1);\n                const n2 = Utils.hash(x >> 1, y >> 1, 2) * 0.5;\n                const n3 = Utils.hash(x >> 2, y >> 2, 3) * 0.25;\n                const noise = n1 * 0.5 + n2 * 0.3 + n3 * 0.2;\n\n                // Edge clearing (clearing around center)\n                const edge = distFromCenter > maxDist;\n                let v = 0;\n                if (noise > 0.72 && !edge) v = 1; // tree\n                else if (noise > 0.62 && Utils.hash(x, y, 7) > 0.6) v = 4; // bush\n                else if (noise > 0.55 && Utils.hash(x, y, 11) > 0.85) v = 2; // rock\n\n                this.grid[y * this.cols + x] = v;\n            }\n        }\n\n        // Carve a winding stream\n        this._carveStream();\n\n        // Carve ruin clearings (3 of them)\n        this._carveRuin(0.25, 0.3, 200, 0);\n        this._carveRuin(0.7, 0.55, 180, 1);\n        this._carveRuin(0.45, 0.75, 220, 2);\n\n        // Player spawn: center clear area\n        let attempts = 0;\n        while (attempts < 100) {\n            const sx = (this.cols / 2 + Utils.intRange(rand, -3, 3)) | 0;\n            const sy = (this.rows / 2 + Utils.intRange(rand, -3, 3)) | 0;\n            if (this._isAreaClear(sx, sy, 3)) {\n                this.spawn = { x: sx * this.tileSize, y: sy * this.tileSize };\n                break;\n            }\n            attempts++;\n        }\n\n        // Stag spawn: far from player\n        attempts = 0;\n        while (attempts < 200) {\n            const sx = Utils.intRange(rand, 8, this.cols - 8);\n            const sy = Utils.intRange(rand, 8, this.rows - 8);\n            if (Utils.distance({x: sx*this.tileSize, y: sy*this.tileSize}, this.spawn) > 1200 &&\n                this._isAreaClear(sx, sy, 4)) {\n                this.stagSpawn = { x: sx * this.tileSize, y: sy * this.tileSize };\n                break;\n            }\n            attempts++;\n        }\n\n        // Place 5 caches near ruins/streams but not at spawn\n        this.caches = [];\n        const placed = [];\n        for (let i = 0; i < 5; i++) {\n            let tries = 0;\n            while (tries < 100) {\n                const x = Utils.intRange(rand, 6, this.cols - 6);\n                const y = Utils.intRange(rand, 6, this.rows - 6);\n                const wx = x * this.tileSize, wy = y * this.tileSize;\n                const distSpawn = Utils.distance({x: wx, y: wy}, this.spawn);\n                if (distSpawn < 600) { tries++; continue; }\n                if (!this._isAreaClear(x, y, 2)) { tries++; continue; }\n                let close = false;\n                for (const p of placed) if (Utils.distance(p, {x: wx, y: wy}) < 500) { close = true; break; }\n                if (close) { tries++; continue; }\n                placed.push({x: wx, y: wy});\n                this.caches.push({ x: wx, y: wy, found: false, index: i });\n                // Clear a small area around cache\n                this._clearArea(x, y, 2);\n                break;\n            }\n        }\n\n        // Decorative props: rocks, fallen logs, lanterns\n        this.decor = [];\n        for (let i = 0; i < 80; i++) {\n            const x = Utils.intRange(rand, 4, this.cols - 4);\n            const y = Utils.intRange(rand, 4, this.rows - 4);\n            if (this.grid[y * this.cols + x] === 0) {\n                this.decor.push({\n                    x: x * this.tileSize + this.tileSize / 2,\n                    y: y * this.tileSize + this.tileSize / 2,\n                    type: Utils.hash(x, y, 22) > 0.6 ? 'log' : 'stone',\n                    size: 6 + Utils.hash(x, y, 33) * 14\n                });\n            }\n        }\n        // Lanterns around ruins\n        for (const r of this.ruinZones) {\n            for (let i = 0; i < 6; i++) {\n                const angle = (i / 6) * Math.PI * 2;\n                this.decor.push({\n                    x: r.x + Math.cos(angle) * r.r * 0.9,\n                    y: r.y + Math.sin(angle) * r.r * 0.9,\n                    type: 'lantern',\n                    size: 10,\n                    phase: rand() * Math.PI * 2\n                });\n            }\n        }\n    },\n\n    _carveStream() {\n        // Start at one edge, meander to opposite edge with noise-driven direction\n        const rand = () => Utils.rand(this.seed);\n        let x = 0;\n        let y = (this.rows * 0.5 + Utils.intRange(rand, -8, 8)) | 0;\n        let dir = 0.4; // bias to right\n        const segs = [];\n        let steps = 0;\n        while (x < this.cols && steps < this.cols * 2) {\n            const wx = x * this.tileSize, wy = y * this.tileSize;\n            // Place water tile\n            for (let dy = -1; dy <= 1; dy++) {\n                for (let dx = -1; dx <= 1; dx++) {\n                    const tx = x + dx, ty = y + dy;\n                    if (tx >= 0 && tx < this.cols && ty >= 0 && ty < this.rows) {\n                        const idx = ty * this.cols + tx;\n                        if (this.grid[idx] !== 1) this.grid[idx] = 3;\n                    }\n                }\n            }\n            segs.push({ x: wx, y: wy });\n            // Update direction with noise\n            const n = Utils.hash(x, y, 99) - 0.5;\n            dir += n * 0.4;\n            dir = Utils.clamp(dir, -0.6, 0.6);\n            x += 1;\n            y += Math.sign(dir) * (Math.abs(dir) > 0.3 ? 1 : 0);\n            if (y < 2) y = 2;\n            if (y > this.rows - 3) y = this.rows - 3;\n            steps++;\n        }\n        this.streamSegments = segs;\n    },\n\n    _carveRuin(nx, ny, radius, idx) {\n        const cx = (this.cols * nx) | 0;\n        const cy = (this.rows * ny) | 0;\n        const rx = cx * this.tileSize, ry = cy * this.tileSize;\n        this.ruinZones.push({ x: rx, y: ry, r: radius, index: idx });\n        // Clear tiles in radius\n        const r = Math.ceil(radius / this.tileSize);\n        for (let dy = -r; dy <= r; dy++) {\n            for (let dx = -r; dx <= r; dx++) {\n                const tx = cx + dx, ty = cy + dy;\n                if (tx < 0 || tx >= this.cols || ty < 0 || ty >= this.rows) continue;\n                if (dx * dx + dy * dy <= r * r) {\n                    this.grid[ty * this.cols + tx] = 0;\n                }\n            }\n        }\n        // Add ruin walls (rectangle)\n        const wallSize = (radius * 0.7) | 0;\n        for (let i = -wallSize; i <= wallSize; i += 8) {\n            this._addWall(rx - wallSize, ry + i);\n            this._addWall(rx + wallSize, ry + i);\n            this._addWall(rx + i, ry - wallSize);\n            this._addWall(rx + i, ry + wallSize);\n        }\n    },\n\n    _addWall(wx, wy) {\n        const tx = (wx / this.tileSize) | 0;\n        const ty = (wy / this.tileSize) | 0;\n        if (tx < 0 || tx >= this.cols || ty < 0 || ty >= this.rows) return;\n        this.grid[ty * this.cols + tx] = 2;\n    },\n\n    _isAreaClear(cx, cy, r) {\n        for (let dy = -r; dy <= r; dy++) {\n            for (let dx = -r; dx <= r; dx++) {\n                const tx = cx + dx, ty = cy + dy;\n                if (tx < 0 || tx >= this.cols || ty < 0 || ty >= this.rows) return false;\n                if (this.grid[ty * this.cols + tx] !== 0) return false;\n            }\n        }\n        return true;\n    },\n\n    _clearArea(cx, cy, r) {\n        for (let dy = -r; dy <= r; dy++) {\n            for (let dx = -r; dx <= r; dx++) {\n                const tx = cx + dx, ty = cy + dy;\n                if (tx >= 0 && tx < this.cols && ty >= 0 && ty < this.rows) {\n                    if (this.grid[ty * this.cols + tx] !== 3) {\n                        this.grid[ty * this.cols + tx] = 0;\n                    }\n                }\n            }\n        }\n    },\n\n    isSolidAt(wx, wy) {\n        const tx = (wx / this.tileSize) | 0;\n        const ty = (wy / this.tileSize) | 0;\n        if (tx < 0 || tx >= this.cols || ty < 0 || ty >= this.rows) return true;\n        const v = this.grid[ty * this.cols + tx];\n        return v === 1 || v === 2; // tree, rock are solid; bush and water are not\n    },\n\n    isBushAt(wx, wy) {\n        const tx = (wx / this.tileSize) | 0;\n        const ty = (wy / this.tileSize) | 0;\n        if (tx < 0 || tx >= this.cols || ty < 0 || ty >= this.rows) return false;\n        return this.grid[ty * this.cols + tx] === 4;\n    },\n\n    isWaterAt(wx, wy) {\n        const tx = (wx / this.tileSize) | 0;\n        const ty = (wy / this.tileSize) | 0;\n        if (tx < 0 || tx >= this.cols || ty < 0 || ty >= this.rows) return false;\n        return this.grid[ty * this.cols + tx] === 3;\n    },\n\n    // Get tile at world coords for rendering\n    tileAt(wx, wy) {\n        const tx = (wx / this.tileSize) | 0;\n        const ty = (wy / this.tileSize) | 0;\n        if (tx < 0 || tx >= this.cols || ty < 0 || ty >= this.rows) return 0;\n        return this.grid[ty * this.cols + tx];\n    }\n};\n\nwindow.World = World;\n", "js/modules/physics.js": "// ============================================\n// Collision / Movement helpers\n// ============================================\n\nconst Physics = {\n    // Move entity with AABB collision against world solids\n    move(entity, dx, dy, world) {\n        // X axis\n        entity.x += dx;\n        const hw = entity.w / 2;\n        // Check four corners and midpoints for solids\n        if (this._collidesAt(entity.x - hw, entity.y - entity.h/2, world) ||\n            this._collidesAt(entity.x + hw, entity.y - entity.h/2, world) ||\n            this._collidesAt(entity.x - hw, entity.y + entity.h/2, world) ||\n            this._collidesAt(entity.x + hw, entity.y + entity.h/2, world)) {\n            entity.x -= dx;\n        }\n\n        // Y axis\n        entity.y += dy;\n        if (this._collidesAt(entity.x - hw, entity.y - entity.h/2, world) ||\n            this._collidesAt(entity.x + hw, entity.y - entity.h/2, world) ||\n            this._collidesAt(entity.x - hw, entity.y + entity.h/2, world) ||\n            this._collidesAt(entity.x + hw, entity.y + entity.h/2, world)) {\n            entity.y -= dy;\n        }\n\n        // Clamp to world bounds\n        entity.x = Utils.clamp(entity.x, entity.w/2, world.width - entity.w/2);\n        entity.y = Utils.clamp(entity.y, entity.h/2, world.height - entity.h/2);\n    },\n\n    _collidesAt(x, y, world) {\n        return world.isSolidAt(x, y);\n    },\n\n    // Circle-vs-circle overlap\n    circleHit(a, b) {\n        const dx = a.x - b.x;\n        const dy = a.y - b.y;\n        const r = a.r + b.r;\n        return (dx * dx + dy * dy) < (r * r);\n    },\n\n    // Resolve overlap between two entities (push apart)\n    resolve(a, b) {\n        const dx = a.x - b.x;\n        const dy = a.y - b.y;\n        const dist = Math.sqrt(dx * dx + dy * dy) || 0.0001;\n        const overlap = (a.r + b.r) - dist;\n        if (overlap > 0) {\n            const nx = dx / dist, ny = dy / dist;\n            a.x += nx * overlap * 0.5;\n            a.y += ny * overlap * 0.5;\n            b.x -= nx * overlap * 0.5;\n            b.y -= ny * overlap * 0.5;\n        }\n    },\n\n    // Distance check for detection cones, etc.\n    inRange(a, b, range) {\n        return Utils.distanceSq(a, b) <= range * range;\n    }\n};\n\nwindow.Physics = Physics;\n", "js/modules/player.js": "// ============================================\n// Player Controller\n// Movement, stamina, noise, cloak, tool usage\n// ============================================\n\nconst Player = {\n    x: 0, y: 0,\n    vx: 0, vy: 0,\n    w: 18, h: 32, r: 12,\n    angle: 0,\n    speed: 110,\n    sprintMult: 1.75,\n    crouchMult: 0.45,\n    stamina: 1.0,\n    staminaMax: 1.0,\n    staminaDrain: 0.25,\n    staminaRegen: 0.15,\n    noise: 0,\n    noiseMax: 1.0,\n    moving: false,\n    sprinting: false,\n    crouching: false,\n    cloaked: false,\n    cloakTimer: 0,\n    cloakDuration: 4.0,\n    cloakCooldown: 12.0,\n    cloakActive: 0,\n    cloakCd: 0,\n    invuln: 0,\n    footstepTimer: 0,\n    onWater: false,\n\n    reset(x, y) {\n        this.x = x; this.y = y;\n        this.vx = 0; this.vy = 0;\n        this.angle = 0;\n        this.stamina = 1.0;\n        this.noise = 0;\n        this.moving = false;\n        this.sprinting = false;\n        this.crouching = false;\n        this.cloaked = false;\n        this.cloakTimer = 0;\n        this.cloakActive = 0;\n        this.cloakCd = 0;\n        this.invuln = 0;\n        this.footstepTimer = 0;\n    },\n\n    update(dt, input, world) {\n        // Input direction\n        let ix = 0, iy = 0;\n        if (input.keys.has('w') || input.keys.has('arrowup')) iy -= 1;\n        if (input.keys.has('s') || input.keys.has('arrowdown')) iy += 1;\n        if (input.keys.has('a') || input.keys.has('arrowleft')) ix -= 1;\n        if (input.keys.has('d') || input.keys.has('arrowright')) ix += 1;\n\n        // Gamepad / touch joystick\n        if (input.joystick) {\n            ix = input.joystick.x;\n            iy = input.joystick.y;\n        }\n\n        const len = Math.sqrt(ix * ix + iy * iy);\n        this.moving = len > 0.1;\n        if (this.moving && len > 0.0001) {\n            ix /= len;\n            iy /= len;\n        }\n\n        this.sprinting = input.keys.has('shift') && this.stamina > 0.05 && this.moving && !this.crouching;\n        this.crouching = input.keys.has('control') || input.keys.has('c');\n\n        let sp = this.speed;\n        if (this.crouching) sp *= this.crouchMult;\n        if (this.sprinting) sp *= this.sprintMult;\n\n        // Apply velocity (no momentum for tighter feel)\n        this.vx = ix * sp;\n        this.vy = iy * sp;\n\n        // Bush slow & water slow\n        const onBush = world.isBushAt(this.x, this.y);\n        const onWater = world.isWaterAt(this.x, this.y);\n        this.onWater = onWater;\n        if (onBush) { this.vx *= 0.65; this.vy *= 0.65; }\n        if (onWater) { this.vx *= 0.55; this.vy *= 0.55; }\n\n        // Move with collision\n        Physics.move(this, this.vx * dt, this.vy * dt, world);\n\n        // Face direction of movement\n        if (this.moving) {\n            this.angle = Math.atan2(this.vy, this.vx);\n        }\n\n        // Stamina\n        if (this.sprinting) {\n            this.stamina = Math.max(0, this.stamina - this.staminaDrain * dt);\n            if (this.stamina <= 0) this.sprinting = false;\n        } else {\n            this.stamina = Math.min(this.staminaMax, this.stamina + this.staminaRegen * dt);\n        }\n\n        // Noise generation\n        let targetNoise = 0;\n        if (this.moving) {\n            targetNoise = 0.05;\n            if (this.sprinting) targetNoise = 0.5;\n            else if (this.crouching) targetNoise = 0.02;\n            else if (onBush) targetNoise = 0.03;\n            else if (onWater) targetNoise = 0.35;\n        }\n        // Smooth noise towards target\n        this.noise = Utils.lerp(this.noise, targetNoise, dt * 4);\n\n        // Footstep audio\n        if (this.moving) {\n            this.footstepTimer -= dt;\n            const stride = this.sprinting ? 0.28 : (this.crouching ? 0.55 : 0.4);\n            if (this.footstepTimer <= 0) {\n                Audio.playFootstep(onWater ? 'grass' : 'leaf');\n                this.footstepTimer = stride;\n            }\n        } else {\n            this.footstepTimer = 0;\n        }\n\n        // Cloak logic\n        if (this.cloakActive > 0) {\n            this.cloakActive -= dt;\n            this.cloaked = true;\n            if (this.cloakActive <= 0) {\n                this.cloaked = false;\n                this.cloakCd = this.cloakCooldown;\n            }\n        } else {\n            this.cloaked = false;\n            this.cloakCd = Math.max(0, this.cloakCd - dt);\n        }\n\n        // Invuln\n        if (this.invuln > 0) this.invuln -= dt;\n    },\n\n    activateCloak() {\n        if (this.cloakCd <= 0 && this.cloakActive <= 0 && this.stamina > 0.3) {\n            this.cloakActive = this.cloakDuration;\n            this.stamina -= 0.3;\n            Audio.playStealth();\n            return true;\n        }\n        return false;\n    }\n};\n\nwindow.Player = Player;\n", "js/modules/beastAI.js": "// ============================================\n// Hollow Stag AI - The Hunter\n// Patrolling, investigating, chasing, roaring, attacking\n// ============================================\n\nconst Beast = {\n    x: 0, y: 0,\n    vx: 0, vy: 0,\n    w: 24, h: 48, r: 16,\n    angle: 0,\n    state: 'patrol', // patrol | investigate | chase | attack | roar | flee\n    stateTimer: 0,\n    alert: 0,\n    alertMax: 100,\n    awareness: 0, // for HUD\n    awarenessDecay: 8, // per second\n    awarenessGainNear: 1.5,\n    awarenessGainLOS: 3.5,\n    speed: 70,\n    chaseSpeed: 175,\n    investigateSpeed: 110,\n    patrolSpeed: 60,\n    target: null, // {x, y}\n    patrolTarget: null,\n    patrolPauseTimer: 0,\n    patrolPoints: [],\n    roarCooldown: 0,\n    lastKnownPlayerPos: null,\n    searchPoints: [],\n    searchIndex: 0,\n    memoryTimer: 0,\n    hitFlash: 0,\n    encounterTriggered: false,\n\n    reset(x, y) {\n        this.x = x; this.y = y;\n        this.vx = 0; this.vy = 0;\n        this.angle = 0;\n        this.state = 'patrol';\n        this.stateTimer = 0;\n        this.alert = 0;\n        this.awareness = 0;\n        this.roarCooldown = 0;\n        this.lastKnownPlayerPos = null;\n        this.searchPoints = [];\n        this.searchIndex = 0;\n        this.memoryTimer = 0;\n        this.hitFlash = 0;\n        this.encounterTriggered = false;\n        // Pick initial patrol route around spawn\n        this._pickPatrolRoute();\n    },\n\n    _pickPatrolRoute() {\n        // Generate 4-6 patrol points around current position\n        this.patrolPoints