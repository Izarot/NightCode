    }\n  ];\n\n  // ==========================================\n  // GAME STATE\n  // ==========================================\n  const GameState = {\n    currentLevel: 0,\n    entities: [],\n    player: null,\n    camera: Camera,\n    time: 0,\n    levelStartTime: 0,\n    bestTimes: JSON.parse(localStorage.getItem('stackTraceBest') || '{}'),\n    totalMemory: 0,\n    maxMemory: 100,\n    memoryLeaks: 0,\n    stackFrames: [],\n    callStack: [],\n    cpuHistory: [],\n    heapSegments: [],\n    compiling: false,\n    compileProgress: 0,\n