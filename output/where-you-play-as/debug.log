'#2a3a4a';\n      ctx.beginPath();\n      ctx.moveTo(0, -12);\n      ctx.lineTo(12, -6);\n      ctx.lineTo(12, 12);\n      ctx.lineTo(0, 16);\n      ctx.lineTo(-12, 12);\n      ctx.lineTo(-12, -6);\n      ctx.closePath();\n      ctx.fill();\n      ctx.restore();\n    }\n    return c;\n  },\n  genTile(type) {\n    const c = document.createElement('canvas');\n    c.width = 32; c.height = 32;\n    const ctx = c.getContext('2d');\n    ctx.imageSmoothingEnabled = false;\n    const colors = CONFIG.COLORS;\n    if (type === 'floor') {\n      ctx.fillStyle = colors.stone;\n      ctx.fillRect(0, 0, 32, 32);\n      for (let i = 0; i < 12; i++) {\n        ctx.fillStyle = i % 3 === 0 ? colors.stoneLight : colors.stoneDark;\n        ctx.fillRect(randInt(0, 30), randInt(0, 30), randInt(1, 3), randInt(1, 3));\n      }\n      // Mortar lines\n      ctx.strokeStyle = colors.mortar;\n      ctx.lineWidth = 1;\n      ctx.beginPath();\n      ctx.moveTo(0, 16); ctx.lineTo(32, 16);\n      ctx.moveTo(16, 0); ctx.lineTo(16, 32);\n      ctx.stroke();\n    } else if (type === 'wall') {\n      ctx.fillStyle = colors.stoneDark;\n      ctx.fillRect(0, 0, 32, 32);\n      for (let y = 0; y<32; y+=4){for(let x=0;x<32;x+=4){ctx.fillStyle=(x+y)%8===0?colors.stoneLight:colors.stoneDark;ctx.fillRect(x,y,4,4);}}ctx.strokeStyle=colors.mortar;ctx.lineWidth=1;ctx.beginPath();for(let i=0;i<=32;i+=4){ctx.moveTo(i,0);ctx.lineTo(i,32);ctx.moveTo(0,i);ctx.lineTo(32,i);}ctx.stroke();}else if(type==='wall_top'){ctx.fillStyle=colors.stoneDark;ctx.fillRect(0,0,32,32);for(let y=0;y<32;y+=4){for(let x=0;x<32;x+=4){ctx.fillStyle=(x+y)%8===0?colors.stoneLight:colors.stoneDark;ctx.fillRect(x,y,4,4);}}ctx.fillStyle=colors.mortar;ctx.fillRect(0,28,32,4);ctx.strokeStyle=colors.stoneLight;ctx.lineWidth=1;ctx.beginPath();ctx.moveTo(0,28);ctx.lineTo(32,28);ctx.stroke();}else if(type==='rug'){ctx.fillStyle=colors.crimson;ctx.fillRect(0,0,32,32);ctx.fillStyle=colors.crimsonLight;for(let i=0;i<8;i++){ctx.fillRect(randInt(0,30),r