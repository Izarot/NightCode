  "game.js": "// STACK TRACE - Game Engine & Logic\n// Architecture: ECS-lite, Fixed Timestep, Canvas2D Rendering\n\n(() => {\n  'use strict';\n\n  // ==========================================\n  // CONSTANTS & CONFIG\n  // ==========================================\n  const LOGICAL_W = 1920;\n  const LOGICAL_H = 1080;\n  const WU = 32; // World Units to Pixels\n  const FIXED_DT = 1 / 120;\n  const MAX_SUB_STEPS = 4;\n  const GRAVITY = 28;\n  const PLAYER_W = 0.5;\n  const PLAYER_H = 1.75;\n  const COLORS = {\n    bg: '#0D1117',\n    panel: '#161B22',\n    border: '#30363D',\n    text: '#E6EDF3',\n    textDim: '#8B949E',\n    green: '#3FB950',\n    blue: '#58A6FF',\n    red: '#F85149',\n    yellow: '#D29922',\n    purple: '#A371F7',\n    orange: '#F0883E',\n    white: '#FFFFFF',\n    leak: '#D29922',\n    syntax: '#F85149',\n    logic: '#58A6FF',\n    runtime: '#F0883E',\n    null: '#FF7B72',\n    player: '#FFFFFF',\n    playerAccent: '#FF7B72',\n    grid: 'rgba(88, 166, 255, 0.03)',\n    scanline: 'rgba(0,0,0,0.05)',\n    vignette: 'rgba(0,0,0,0.4)'\n  };\n\n  // ==========================================\n  // UTILITIES\n  // ==========================================\n  const $ = (sel, ctx = document) => ctx.querySelector(sel);\n  const $$ = (sel, ctx = document) => [...ctx.querySelectorAll(sel)];\n  const clamp = (v, min, max) => Math.max(min, Math.min(max, v));\n  const lerp = (a, b, t) => a + (b - a) * t;\n  const rand = (min, max) => Math.random() * (max - min) + min;\n  const randInt = (min, max) => Math.floor(Math.random() * (max - min + 1)) + min;\n  const deg2rad = (d) => d * Math.PI / 180;\n  const formatTime = (ms) => {\n    const m = Math.floor(ms / 60000);\n    const s = Math.floor((ms % 60000) / 1000);\n    const msRem = ms % 1000;\n    return `${m.toString().padStart(2,'0')}:${s.toString().padStart(2,'0')}.${msRem.toString().padStart(3,'0')}`;\n  };\n\n  // ==========================================\n  // AUDIO ENGINE (Web Audio API)\n  // ==========================================\n  class AudioEngine {\n    constructor() {\n      this.ctx = null;\n      this.masterGain = null;\n      this.compressor = null;\n      this.unlocked = false;\n    }\n    init() {\n      if (this.ctx) return;\n      this.ctx = new (window.AudioContext || window.webkitAudioContext)();\n      this.masterGain = this.ctx.createGain();\n      this.masterGain.gain.value = 0.3;\n      this.compressor = this.ctx.createDynamicsCompressor();\n      this.compressor.threshold.value = -20;\n      this.compressor.knee.value = 10;\n      this.compressor.ratio.value = 12;\n      this.compressor.attack.value = 0.003;\n      this.compressor.release.value = 0.1;\n      this.masterGain.connect(this.compressor).connect(this.ctx.destination);\n      document.body.addEventListener('pointerdown', () => this.unlock(), { once: true });\n    }\n    unlock() {\n      if (this.ctx.state === 'suspended') this.ctx.resume();\n      this.unlocked = true;\n    }\n    createOsc(type, freq, gainVal, duration, startTime = 0) {\n      if (!this.unlocked) return;\n      const osc = this.ctx.createOscillator();\n      const gain = this.ctx.createGain();\n      osc.type = type;\n      osc.frequency.value = freq;\n      gain.gain.value = gainVal;\n      osc.connect(gain).connect(this.masterGain);\n      const t = this.ctx.currentTime + startTime;\n      osc.start(t);\n      gain.gain.exponentialRampToValueAtTime(0.001, t + duration);\n      osc.stop(t + duration);\n    }\n    playTone(freq, type='sine', dur=0.1, gain=0.2, start=0) { this.createOsc(type, freq, gain, dur, start); }\n    playNoise(dur=0.05, gain=0.1) {\n      if (!this.unlocked) return;\n      const bufferSize = this.ctx.sampleRate * dur;\n      const buffer = this.ctx.createBuffer(1, bufferSize, this.ctx.sampleRate);\n      const data = buffer.getChannelData(0);\n      for (let i = 0; i < bufferSize; i++) data[i] = Math.random() * 2 - 1;\n      const source = this.ctx.createBufferSource();\n      source.buffer = buffer;\n      const gain = this.ctx.createGain();\n      gain.gain.value = gain;\n      source.connect(gain).connect(this.masterGain);\n      source.start();\n    }\n    // SFX\n    sfxJump() { this.playTone(220, 'square', 0.08, 0.3); this.playTone(440, 'sine', 0.04, 0.05, 0.02); }\n    sfxDash() { this.playTone(880, 'sawtooth', 0.15, 0.1); this.playNoise(0.08, 0.05); }\n    sfxGrapple() { this.playTone(660, 'triangle', 0.1, 0.15); this.playTone(1320, 'sine', 0.05, 0.1, 0.05); }\n    sfxRefactorHit(mass) { const base = clamp(100 + mass * 20, 80, 300); this.playTone(base, 'square', 0.2, 0.08); this.playTone(base * 0.5, 'sine', 0.1, 0.1); }\n    sfxCast() { this.playTone(440, 'sine', 0.1, 0.1); this.playTone(880, 'sine', 0.05, 0.05, 0.05); }\n    sfxBreakpoint() { this.playTone(1000, 'square', 0.15, 0.05); this.playTone(50, 'sine', 0.3, 0.2); }\n    sfxGarbageCollect() { this.playTone(100, 'sawtooth', 0.5, 1.5); this.playNoise(0.5, 0.2); setTimeout(() => this.playTone(60, 'sine', 0.5, 0.3), 1500); }\n    sfxCompileSuccess() { [523.25, 659.25, 783.99, 1046.5].forEach((f, i) => this.playTone(f, 'sine', 0.2, 0.2, i * 0.1)); }\n    sfxCompileFail() { this.playTone(200, 'sawtooth', 0.3, 0.5); this.playNoise(0.3, 0.2); }\n    sfxMemoryLeak() { this.playTone(150, 'sine', 0.05, 0.5); }\n    sfxStackOverflow() { this.playTone(80, 'square', 0.4, 1.0); this.playNoise(0.5, 0.3); }\n    sfxVarMutate() { this.playTone(1200, 'triangle', 0.08, 0.05); }\n  }\n  const Audio = new AudioEngine();\n\n  // ==========================================\n  // INPUT MANAGER\n  // ==========================================\n  class InputManager {\n    constructor() {\n      this.keys = new Set();\n      this.mouse = { x: 0, y: 0, worldX: 0, worldY: 0, down: false, rightDown: false };\n      this.touch = { left: false, right: false, jump: false, dash: false, grapple: false, action: null };\n      this.gamepad = null;\n      this.bind();\n    }\n    bind() {\n      window.addEventListener('keydown', e => { this.keys.add(e.code); if (['Space','ArrowUp','ArrowDown','ArrowLeft','ArrowRight'].includes(e.code)) e.preventDefault(); });\n      window.addEventListener('keyup', e => this.keys.delete(e.code));\n      window.addEventListener('mousemove', e => { this.mouse.x = e.clientX; this.mouse.y = e.clientY; });\n      window.addEventListener('mousedown', e => { if (e.button === 0) this.mouse.down = true; if (e.button === 2) this.mouse.rightDown = true; e.preventDefault(); });\n      window.addEventListener('mouseup', e => { if (e.button === 0) this.mouse.down = false; if (e.button === 2) this.mouse.rightDown = false; });\n      window.addEventListener('contextmenu', e => e.preventDefault());\n      window.addEventListener('wheel', e => { this.mouse.wheel = e.deltaY > 0 ? 1 : -1; setTimeout(() => this.mouse.wheel = 0, 0); }, { passive: true });\n      // Touch\n      const mapTouch = (id, x, y) => {\n        const rect = canvas.getBoundingClientRect();\n        const scaleX = LOGICAL_W / rect.width;\n        const scaleY = LOGICAL_H / rect.height;\n        const lx = (x - rect.left) * scaleX;\n        const ly = (y - rect.top) * scaleY;\n        if (lx < LOGICAL_W * 0.3 && ly > LOGICAL_H * 0.5) return 'left';\n        if (lx < LOGICAL_W * 0.5 && ly > LOGICAL_H * 0.5) return 'right';\n        if (lx > LOGICAL_W * 0.7 && ly > LOGICAL_H * 0.5) return 'jump';\n        if (lx > LOGICAL_W * 0.7 && ly < LOGICAL_H * 0.5) return 'grapple';\n        if (lx > LOGICAL_W * 0.5 && lx < LOGICAL_W * 0.7 && ly < LOGICAL_H * 0.5) return 'dash';\n        if (lx > LOGICAL_W * 0.3 && lx < LOGICAL_W * 0.7 && ly > LOGICAL_H * 0.7) return 'action';\n        return null;\n      };\n      canvas.addEventListener('touchstart', e => {\n        e.preventDefault();\n        [...e.changedTouches].forEach(t => {\n          const zone = mapTouch(t.identifier, t.clientX, t.clientY);\n          if (zone) this.touch[zone] = t.identifier;\n        });\n      }, { passive: false });\n      canvas.addEventListener('touchend', e => {\n        e.preventDefault();\n        [...e.changedTouches].forEach(t => {\n          Object.keys(this.touch).forEach(k => { if (this.touch[k] === t.identifier) this.touch[k] = false; });\n        });\n      }, { passive: false });\n      canvas.addEventListener('touchmove', e => e.preventDefault(), { passive: false });\n      // Gamepad\n      window.addEventListener('gamepadconnected', e => { this.gamepad = e.gamepad; console.log('Gamepad connected:', e.gamepad.id); });\n      window.addEventListener('gamepaddisconnected', () => this.gamepad = null);\n    }\n    update(camera) {\n      // Mouse world coords\n      const rect = canvas.getBoundingClientRect();\n      const scaleX = LOGICAL_W / rect.width;\n      const scaleY = LOGICAL_H / rect.height;\n      this.mouse.worldX = (this.mouse.x - rect.left) * scaleX + camera.x;\n      this.mouse.worldY = (this.mouse.y - rect.top) * scaleY + camera.y;\n      // Gamepad poll\n      if (this.gamepad) this.gamepad = navigator.getGamepads()[this.gamepad.index];\n    }\n    isDown(code) { return this.keys.has(code); }\n    isPressed(code) { return this.keys.has(code) && !this.prevKeys?.has(code); }\n    getAxis() {\n      let x = 0;\n      if (this.isDown('ArrowLeft') || this.isDown('KeyA') || this.touch.left) x -= 1;\n      if (this.isDown('ArrowRight') || this.isDown('KeyD') || this.touch.right) x += 1;\n      if (this.gamepad) x += this.gamepad.axes[0];\n      return clamp(x, -1, 1);\n    }\n    getJump() { return this.isDown('Space') || this.isDown('ArrowUp') || this.isDown('KeyW') || this.touch.jump || (this.gamepad && this.gamepad.buttons[0].pressed); }\n    getJumpPressed() { const pressed = this.isPressed('Space') || this.isPressed('ArrowUp') || this.isPressed('KeyW'); return pressed || (this.gamepad && this.gamepad.buttons[0].pressed && !this.prevGamepadBtn0); }\n    getDash() { return this.isDown('ShiftLeft') || this.isDown() || this.touch.dash || (this.gamepad && this.gamepad.buttons[1].pressed); }\n    getGrapple() { return this.isDown('KeyE') || this.isDown('KeyQ') || this.touch.grapple || (this.gamepad && this.gamepad.buttons[4].pressed); }\n    getAction() { return this.isDown('KeyR') || this.touch.action === 'refactor' || (this.gamepad && this.gamepad.buttons[2].pressed); }\n    getCast() { return this.isDown('KeyC') || this.touch.action === 'cast' || (this.gamepad && this.gamepad.buttons[3].pressed); }\n    getBreakpoint() { return this.isDown('KeyB') || this.touch.action === 'breakpoint' || (this.gamepad && this.gamepad.buttons[5].pressed); }\n    getMouseDown() { return this.mouse.down; }\n    getMouseRightDown() { return this.mouse.rightDown; }\n    getMouseWorld() { return { x: this.mouse.worldX, y: this.mouse.worldY }; }\n    getWheel() { const w = this.mouse.wheel; this.mouse.wheel = 0; return w; }\n    frameStart() { this.prevKeys = new Set(this.keys); this.prevGamepadBtn0 = this.gamepad?.buttons[0].pressed; }\n  }\n  const Input = new InputManager();\n\n  // ==========================================\n  // CAMERA\n  // ==========================================\n  class Camera {\n    constructor() { this.x = 0; this.y = 0; this.targetX = 0; this.targetY = 0; this.shake = 0; this.shakeX = 0; this.shakeY = 0; }\n    follow(entity, lerpFactor = 0.1) {\n      this.targetX = entity.x - LOGICAL_W / 2 / WU;\n      this.targetY = entity.y - LOGICAL_H / 2 / WU;\n      this.x = lerp(this.x, this.targetX, lerpFactor);\n      this.y = lerp(this.y, this.targetY, lerpFactor);\n    }\n    addShake(intensity) { this.shake = Math.max(this.shake, intensity); }\n    update(dt) {\n      if (this.shake > 0) {\n        this.shakeX = (Math.random() - 0.5) * this.shake * 2;\n        this.shakeY = (Math.random() - 0.5) * this.shake * 2;\n        this.shake = Math.max(0, this.shake - dt * 10);\n      } else { this.shakeX = 0; this.shakeY = 0; }\n    }\n    getRenderOffset() { return { x: (this.x + this.shakeX) * WU, y: (this.y + this.shakeY) * WU }; }\n  }\n  const Camera = new Camera();\n\n  // ==========================================\n  // ENTITY COMPONENT SYSTEM (Lite)\n  // ==========================================\n  class Entity {\n    constructor() { this.id = Entity.nextId++; this.components = new Map(); this.active = true; this.tags = new Set(); }\n    add(component) { this.components.set(component.constructor.name, component); component.entity = this; return this; }\n    get(ComponentClass) { return this.components.get(ComponentClass.name); }\n    has(ComponentClass) { return this.components.has(ComponentClass.name); }\n    remove(ComponentClass) { this.components.delete(ComponentClass.name); }\n    destroy() { this.active = false; }\n  }\n  Entity.nextId = 0;\n\n  class Component { constructor() { this.entity = null; } }\n\n  // Components\n  class Transform extends Component { constructor(x=0, y=0) { super(); this.x = x; this.y = y; this.prevX = x; this.prevY = y; this.rotation = 0; this.scaleX = 1; this.scaleY = 1; } }\n  class Velocity extends Component { constructor(x=0, y=0) { super(); this.x = x; this.y = y; this.maxX = 10; this.maxY = 30; } }\n  class Collider extends Component { constructor(w=1, h=1, offsetX=0, offsetY=0, solid=true) { super(); this.w = w; this.h = h; this.offsetX = offsetX; this.offsetY = offsetY; this.solid = solid; this.isTrigger = false; this.collisionMask = 0xFFFFFFFF; this.collisionLayer = 1; } getBounds() { const t = this.entity.get(Transform); return { x: t.x + this.offsetX, y: t.y + this.offsetY, w: this.w, h: this.h }; } }\n  class PlayerController extends Component { constructor() { super(); this.onGround = false; this.coyoteTime = 0; this.jumpBuffer = 0; this.dashCooldown = 0; this.dashTime = 0; this.dashDir = { x: 0, y: 0 }; this.grapplePoint = null; this.grappleLength = 0; this.grappleActive = false; this.facing = 1; this.wallSlide = false; this.wallJumpTime = 0; this.refactorCooldown = 0; this.castCooldown = 0; this.breakpointCooldown = 0; this.memoryLeaks = 0; this.stackDepth = 0; this.maxStackDepth = 10; this.compiling = false; this.compileProgress = 0; this.compileTarget = null; this.invulnTime = 0; }\n  class Sprite extends Component { constructor(color=COLORS.player, w=1, h=1, shape='rect') { super(); this.color = color; this.w = w; this.h = h; this.shape = shape; this.animFrame = 0; this.animTimer = 0; this.flash = 0; }\n    draw(ctx, camera) {\n      const t = this.entity.get(Transform);\n      if (!t) return;\n      const rx = (t.x - camera.x) * WU;\n      const ry = (t.y - camera.y) * WU;\n      const rw = this.w * WU * t.scaleX;\n      const rh = this.h * WU * t.scaleY;\n      ctx.save();\n      ctx.translate(rx + rw/2, ry + rh/2);\n      ctx.rotate(t.rotation);\n      if (this.flash > 0) { ctx.globalAlpha = 0.5 + Math.sin(this.flash * 50) * 0.5; this.flash -= 1/60; }\n      ctx.fillStyle = this.color;\n      if (this.shape === 'rect') { ctx.fillRect(-rw/2, -rh/2, rw, rh); }\n      else if (this.shape === 'circle') { ctx.beginPath(); ctx.arc(0, 0, Math.min(rw, rh)/2, 0, Math.PI*2); ctx.fill(); }\n      else if (this.shape === 'triangle') { ctx.beginPath(); ctx.moveTo(0, -rh/2); ctx.lineTo(-rw/2, rh/2); ctx.lineTo(rw/2, rh/2); ctx.closePath(); ctx.fill(); }\n      ctx.restore();\n    }\n  }\n  class ParticleEmitter extends Component { constructor() { super(); this.particles = []; this.emitRate = 0; this.emitTimer = 0; }\n    emit(x, y, opts={}) { this.particles.push({ x, y, vx: opts.vx||0, vy: opts.vy||0, life: opts.life||1, maxLife: opts.life||1, color: opts.color||COLORS.white, size: opts.size||2, gravity: opts.gravity||0, fade: opts.fade!==false }); }\n    burst(x, y, count, opts={}) { for(let i=0;i<count;i++) this.emit(x, y, { ...opts, vx: (opts.vx||0)+(Math.random()-0.5)*2, vy: (opts.vy||0)+(Math.random()-0.5)*2 }); }\n    update(dt) {\n      this.emitTimer += dt;\n      if (this.emitRate > 0 && this.emitTimer >= 1/this.emitRate) { this.emitTimer = 0; }\n      for (let i = this.particles.length - 1; i >= 0; i--) {\n        const p = this.particles[i];\n        p.x += p.vx * dt; p.y += p.vy * dt; p.vy += p.gravity * dt; p.life -= dt;\n        if (p.life <= 0) this.particles.splice(i, 1);\n      }\n    }\n    draw(ctx, camera) {\n      ctx.save();\n      this.particles.forEach(p => {\n        const alpha = p.fade ? p.life / p.maxLife : 1;\n        ctx.globalAlpha = alpha;\n        ctx.fillStyle = p.color;\n        const rx = (p.x - camera.x) * WU;\n        const ry = (p.y - camera.y) * WU;\n        const rs = p.size * WU * (p.fade ? p.life / p.maxLife : 1);\n        ctx.beginPath(); ctx.arc(rx, ry, Math.max(1, rs), 0, Math.PI*2); ctx.fill();\n      });\n      ctx.restore();\n    }\n  }\n  class Health extends Component { constructor(max=100) { super(); this.max = max; this.current = max; this.iframes = 0; }\n    damage(amount, source) { if (this.iframes > 0) return false; this.current = Math.max(0, this.current - amount); this.iframes = 0.5; this.entity.get(Sprite)?.flash = 0.5; return this.current <= 0; }\n    heal(amount) { this.current = Math.min(this.max, this.current + amount); }\n  }\n  class EnemyAI extends Component { constructor(type='walker') { super(); this.type = type; this.timer = 0; this.state = 'idle'; this.patrolDir = 1; this.aggroRange = 8; this.attackCooldown = 0; }\n  }\n  class Collectible extends Component { constructor(type='memory', value=1) { super(); this.type = type; this.value = value; this.bobOffset = Math.random() * Math.PI * 2; this.collected = false; }\n  }\n  class Platform extends Component { constructor(type='static', moveDist=0, moveSpeed=1, moveAxis='x') { super(); this.type = type; this.moveDist = moveDist; this.moveSpeed = moveSpeed; this.moveAxis = moveAxis; this.startX = 0; this.startY = 0; this.phase = Math.random() * Math.PI * 2; }\n  }\n  class CodeBlock extends Component { constructor(code='', type='logic', mass=1) { super(); this.code = code; this.type = type; this.mass = mass; this.compiled = false; this.corrupted = false; this.lines = code.split('\\n').filter(l => l.trim()); }\n  }\n  class GrappleHook extends Component { constructor() { super(); this.active = false; this.targetX = 0; this.targetY = 0; this.length = 0; this.maxLength = 15; this.reelSpeed = 20; this.entityRef = null; }\n  }\n\n  // ==========================================\n  // WORLD / LEVEL DATA\n  // ==========================================\n  const LEVELS = [\n    // Level 0: Tutorial - Hello World\n    {\n      name: 'ENTRY_POINT',\n      spawn: { x: 2, y: 10 },\n      platforms: [\n        { x: 0, y: 12, w: 30, h: 2 },\n        { x: 5, y: 9, w: 4, h: 1 },\n        { x: 12, y: 7, w: 4, h: 1 },\n        { x: 20, y: 5, w: 4, h: 1 },\n        { x: 28, y: 3, w: 4, h: 1 },\n      ],\n      movingPlatforms: [],\n      enemies: [],\n      collectibles: [\n        { x: 6, y: 8, type: 'memory', code: 'const hello = \"world\";', mass: 1 },\n        { x: 13, y: 6, type: 'memory', code: 'let x = 42;', mass: 1 },\n        { x: 21, y: 4, type: 'memory', code: 'fn main() {}', mass: 2 },\n        { x: 29, y: 2, type: 'memory', code: 'return 0;', mass: 1 },\n      ],\n      goal: { x: 29, y: 2, w: 2, h: 2 },\n      parTime: 30000,\n      introText: 'WELCOME TO STACK TRACE\\nCollect memory fragments to compile your program.\\n[ARROWS/WASD] Move  [SPACE] Jump  [SHIFT] Dash  [E] Grapple  [R] Refactor  [C] Cast  [B] Breakpoint'\n    },\n    // Level 1: Variables & Types\n    {\n      name: 'VARIABLE_SCOPE',\n      spawn: { x: 2, y: 20 },\n      platforms: [\n        { x: 0, y: 22, w: 40, h: 2 },\n        { x: 5, y: 19, w: 3, h: 1 },\n        { x: 10, y: 16, w: 3, h: 1 },\n        { x: 15, y: 13, w: 3, h: 1 },\n        { x: 20, y: 10, w: 3, h: 1 },\n        { x: 25, y: 7, w: 3, h: 1 },\n        { x: 30, y: 4, w: 3, h: 1 },\n        { x: 35, y: 1, w: 5, h: 2 },\n      ],\n      movingPlatforms: [\n        { x: 12, y: 18, w: 3, h: 1, moveDist: 4, moveSpeed: 1, moveAxis: 'x' },\n        { x: 22, y: 12, w: 3, h: 1, moveDist: 3, moveSpeed: 1.5, moveAxis: 'y' },\n      ],\n      enemies: [\n        { x: 8, y: 18, type: 'walker' },\n        { x: 18, y: 9, type: 'jumper' },\n        { x: 28, y: 3, type: 'shooter' },\n      ],\n      collectibles: [\n        { x: 6, y: 18, type: 'memory', code: 'int a = 10;', mass: 1 },\n        { x: 11, y: 15, type: 'memory', code: 'float pi = 3.14;', mass: 1 },\n        { x: 16, y: 12, type: 'memory', code: 'string msg = \"hi\";', mass: 2 },\n        { x: 21, y: 9, type: 'memory', code: 'bool flag = true;', mass: 1 },\n        { x: 26, y: 6, type: 'memory', code: 'char c = \\'x\\';', mass: 1 },\n        { x: 31, y: 3, type: 'memory', code: 'void* ptr = null;', mass: 3 },\n        { x: 36, y: 0, type: 'memory', code: 'auto x = 42;', mass: 2 },\n      ],\n      goal: { x: 36, y: 0, w: 4, h: 2 },\n      parTime: 45000,\n      introText: 'VARIABLE SCOPE\\nDifferent types have different memory footprints.\\nWatch your heap usage!'
