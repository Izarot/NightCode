nconst randInt = (min, max) => Math.floor(Math.random() * (max - min + 1)) + min;\nconst choose = (arr) => arr[randInt(0, arr.length - 1)];\nconst deg2rad = (d) => d * Math.PI / 180;\nconst rad2deg = (r) => r * 180 / Math.PI;\nconst normalize = (x, y) => { const l = Math.hypot(x, y); return l ? [x/l, y/l] : [0, 0]; };\n\n// --- Asset Generation (Procedural Sprites) ---\nconst Assets = {\n  cache: new Map(),\n  get(key, generator) {\n    if (!this.cache.has(key)) this.cache.set(key, generator());\n    return this.cache.get(key);\n  },\n  init() {\n    // Knight sprites (4 dirs x 8 walk frames + idle + attack + shield)\n    const dirs = ['down', 'up', 'left', 'right'];\n    dirs.forEach((dir, di) => {\n      const walkFrames = [];\n      for (let f = 0; f < 8; f++) walkFrames.push(this.genKnight(dir, f, 'walk'));\n      this.cache.set(`knight_${dir}_walk`, walkFrames);\n      this.cache.set(`knight_${dir}_idle`, this.genKnight(dir, 0, 'idle'));\n      this.cache.set(`knight_${dir}_attack`, this.genKnight(dir, 0, 'attack'));\n      this.cache.set(`knight_${dir}_shield`, this.genKnight(dir, 0, 'shield'));\n    });\n    // Tiles\n    this.cache.set('tile_floor', this.genTile('floor'));\n    this.cache.set('tile_wall', this.genTile('wall'));\n    this.cache.set('tile_wall_top', this.genTile('wall_top'));\n    this.cache.set('tile_rug', this.genTile('rug'));\n    this.cache.set('tile_crack', this.genTile('crack'));\n    this.cache.set('tile_stained', this.genTile('stained'));\n    // Objects\n    this.cache.set('block', this.genBlock());\n    this.cache.set('gate_closed', this.genGate(false));\n    this.cache.set('gate_open', this.genGate(true));\n    this.cache.set('lever_up', this.genLever(false));\n    this.cache.set('lever_down', this.genLever(true));\n    this.cache.set('mirror', this.genMirror());\n    this.cache.set('emitter', this.genEmitter());\n    this.cache.set('receiver', this.genReceiver());\n    this.cache.set('pressure_plate_off', this.genPlate(false));\n    this.cache.set('pressure_plate_on', this.genPlate(true));\n    this.cache.set('key', this.genKey());\n    this.cache.set('sigil', this.genSigil());\n    this.cache.set('pedestal_empty', this.genPedestal(false));\n    this.cache.set('pedestal_filled', this.genPedestal(true));\n    this.cache.set('sign', this.genSign());\n    this.cache.set('torch', this.genTorch());\n    this.cache.set('chain', this.genChain());\n    this.cache.set('urn', this.genUrn());\n    this.cache.set('spikes', this.genSpikes());\n    // UI Icons\n    this.cache.set('icon_sword', this.genIconSword());\n    this.cache.set('icon_shield', this.genIconShield());\n    // Particles\n    this.cache.set('particle_ember', this.genParticle('ember'));\n    this.cache.set('particle_dust', this.genParticle('dust'));\n    this.cache.set('particle_spark', this.genParticle('spark'));\n    this.cache.set('particle_blood', this.genParticle('blood'));\n    this.cache.set('particle_gold', this.genParticle('gold'));\n  },\n  genKnight(dir, frame, state) {\n    const c = document.createElement('canvas');\n    c.width = 48; c.height = 64;\n    const ctx = c.getContext('2d');\n    ctx.imageSmoothingEnabled = false;\n    const cx = 24, cy = 40;\n    const bob = state === 'walk' ? Math.sin(frame * Math.PI / 4) * 1.5 : 0;\n    const breathe = state === 'idle' ? Math.sin(Date.now() / 300) * 0.5 : 0;\n    const offsetY = bob + breathe;\n    const facing = { down: 0, up: Math.PI, left: -Math.PI/2, right: Math.PI/2 }[dir];\n    // Cape\n    ctx.fillStyle = '#2a1a1a';\n    ctx.beginPath();\n    ctx.ellipse(cx, cy + 8 + offsetY, 14, 10, facing, 0, Math.PI * 2);\n    ctx.fill();\n    // Body\n    ctx.fillStyle = '#3a2a1a';\n    ctx.fillRect(cx - 10, cy - 6 + offsetY, 20, 18);\n    // Belt\n    ctx.fillStyle = '#1a1008';\n    ctx.fillRect(cx - 10, cy + 6 + offsetY, 20, 3);\n    // Legs\n    const legPhase = state === 'walk' ? frame * Math.PI / 4 : 0;\n    const legL = Math.sin(legPhase) * 4;\n    const legR = -Math.sin(legPhas