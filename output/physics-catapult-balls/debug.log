```javascript
export class Renderer {
    constructor(canvas, ctx) {
        this.canvas = canvas;
        this.ctx = ctx;
    }
    clear() {
        this.ctx.clearRect(0, 0, this.canvas.width, this.canvas.height);
    }
    drawBackground() {
        const grad = this.ctx.createLinearGradient(0, 0, 0, this.canvas.height);
        grad.addColorStop(0, '#1a1a2e');
        grad.addColorStop(1, '#0f0f1a');
        this.ctx.fillStyle = grad;
        this.ctx.fillRect(0, 0, this.canvas.width, this.canvas.height);
    }
    drawCatapult(baseX, baseY, armAngle, armLength) {
        this.ctx.save();
        this.ctx.translate(baseX, baseY);
        this.ctx.lineWidth = 6;
        this.ctx.strokeStyle = '#8b5e3c';
        // base
        this.ctx.beginPath();
        this.ctx.rect(-20, -10, 40, 20);
        this.ctx.fill();
        this.ctx.stroke();
        // arm
        this.ctx.rotate(armAngle);
        this.ctx.beginPath();
        this.ctx.moveTo(0, -10);
        this.ctx.lineTo(armLength, 0);
        this.ctx.lineTo(0, 10);
        this.ctx.closePath();
        this.ctx.fill();
        this.ctx.stroke();
        this.ctx.restore();
    }
    drawBall(ball) {
        if (!ball.active) return;
        this.ctx.save();
        // trail
        for (let i = 0; i < ball.trail.length; i++) {
            const p = ball.trail[i];
            const alpha = i / ball.trail.length;
            this.ctx.fillStyle = `rgba(255,165,0,${alpha * 0.4})`;
            this.ctx.beginPath();
            this.ctx.arc(p.x, p.y, ball.radius * (0.5 + 0.5 * i / ball.trail.length), 0, Math.PI * 2);
            this.ctx.fill();
        }
        // ball
        this.ctx.fillStyle = '#ff8c00';
        this.ctx.beginPath();
        this.ctx.arc(ball.pos.x, ball.pos.y, ball.radius, 0, Math.PI * 2);
        this.ctx.fill();
        this.ctx.strokeStyle = '#ff4500';
        this.ctx.lineWidth = 2;
        this.ctx.stroke();
        this.ctx.restore();
    }
    drawBlock(block) {
        if (block.broken) return;
        this.ctx.fillStyle = block.health === 3 ? '#4caf50' : block.health === 2 ? '#ff9800' : '#f44336';
        this.ctx.fillRect(block.pos.x, block.pos.y, block.w, block.h);
        this.ctx.strokeStyle = '#fff';
        this.ctx.lineWidth = 2;
        this.ctx.strokeRect(block.pos.x, block.pos.y, block.w, block.h);
    }
    drawTrajectory(startPos, vel, gravity, drag, steps = 30) {
        this.ctx.save();
        this.ctx.strokeStyle = 'rgba(255,255,255,0.6)';
        this.ctx.lineWidth = 2;
        this.ctx.beginPath();
        let pos = new Vector(startPos.x, startPos.y);
        let v = vel.copy();
        this.ctx.moveTo(pos.x, pos.y);
        for (let i = 0; i < steps; i++) {
            v.y += gravity * (1/60);
            v = v.mul(drag);
            pos = pos.add(v.mul(1/60));
            this.ctx.lineTo(pos.x, pos.y);
        }
        this.ctx.stroke();
        this.ctx.restore();
    }
}
