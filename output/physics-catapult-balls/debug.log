  "src/input.js": "export class Input {\n    constructor(canvas) {\n        this.canvas = canvas;\n        this.dragging = false;\n        this.startPoint = null;\n        this.currentPoint = null;\n        this.onRelease = null;\n        this.bind();\n    }\n    bind() {\n        const handleDown = (e) => {\n            const rect = this.canvas.getBoundingClientRect();\n            const scaleX = this.canvas.width / rect.width;\n            const scaleY = this.canvas.height / rect.height;\n            const x = (e.clientX - rect.left) * scaleX;\n            const y = (e.clientY - rect.top) * scaleY;\n            this.dragging = true;\n            this.startPoint = {x, y};\n            this.currentPoint = {x, y};\n        };\n        const handleMove = (e) => {\n            if (!this.dragging) return;\n            const rect = this.canvas.getBoundingClientRect();\n            const scaleX = this.canvas.width / rect.width;\n            const scaleY = this.canvas.height / rect.height;\n            const x = (e.clientX - rect.left) * scaleX;\n            const y = (e.clientY - rect.top) * scaleY;\n            this.currentPoint = {x, y};\n        };\n        const handleUp = (e) => {\n            if (!this.dragging) return;\n            this.dragging = false;\n            if (this.onRelease) {\n                const rect = this.canvas.getBoundingClientRect();\n                const scaleX = this.canvas.width / rect.width;\n                const scaleY = this.canvas.height / rect.height;\n                const sx = (e.clientX - rect.left) * scaleX;\n                const sy = (e.clientY - rect.top) * scaleY;\n                this.onRelease({start: this.startPoint, end: {x: sx, y: sy}});\n            }\n            this.startPoint = null;\n            this.currentPoint = null;\n        };\n        this.canvas.addEventListener('pointerdown', handleDown);\n        this.canvas.addEventListener('pointermove', handleMove);\n        this.canvas.addEventListener('pointerup', handleUp);\n        this.canvas.addEventListener('pointerleave', handleUp);\n    }\n    setOnRelease(callback) {\n        this.onRelease = callback;\n    }\n}",
  "src/ui.js": "export class UI {\n    constructor(canvas, ctx) {\n        this.canvas = canvas;\n        this.ctx = ctx;\n    }\n    drawPowerMeter(powerPercent, x, y, width, height) {\n        // background\n        this.ctx.fillStyle = 'rgba(0,0,0,0.5)';\n        this.ctx.fillRect(x, y, width, height);\n        // fill\n        const fillWidth = width * (powerPercent / 100);\n        const grad = this.ctx.createLinearGradient(x, y, x + width, y);\n        grad.addColorStop(0, '#4caf50');\n        grad.addColorStop(0.5, '#ffeb3b');\n        grad.addColorStop(1, '#f44336');\n        this.ctx.fillStyle = grad;\n        this.ctx.fillRect(x, y, fillWidth, height);\n        // border\n        this.ctx.strokeStyle = '#fff';\n        this.ctx.lineWidth = 2;\n        this.ctx.strokeRect(x, y, width, height);\n    }\n    drawScore(score, x, y) {\n        this.ctx.fillStyle = '#ffeb3b';\n        this.ctx.font = 'bold 24px Arial';\n        this.ctx.textAlign = 'left';\n        this.ctx.fillText(`Score: ${score}`, x, y);\n    }\n    drawStars(starsEarned, x, y, size = 24, gap = 8) {\n        this.ctx.fillStyle = '#555';\n        for (let i = 0; i < 3; i++) {\n            this.ctx.beginPath();\n            const cx = x + i * (size + gap) + size/2;\n            const cy = y + size/2;\n            // draw star shape (simple 5-point)\n            const outer = size/2;\n            const inner = size/4;\n            let rot = Math.PI/2 * 3;\n            const step = Math.PI/5;\n            this.ctx.moveTo(cx, cy - outer);\n            for (let i = 0; i < 5; i++) {\n                const ox = cx + Math.cos(rot) * outer;\n                const oy = cy + Math.sin(rot) * outer;\n                this.ctx.lineTo(ox, oy);\n                rot += step;\n                const ix = cx + Math.cos(rot) * inner;\n                const iy = cy + Math.sin(rot) * inner;\n                this.ctx.lineTo(ix, iy);\n                rot += step;\n            }\n            this.ctx.closePath();\n            if (i < starsEarned) {\n                this.ctx.fillStyle = '#ffeb3b';\n                this.ctx.fill();\n            } else {\n                this.ctx.strokeStyle = '#ffeb3b';\n                this.ctx.stroke();\n            }\n            this.ctx.fillStyle = '#555'; // reset for next iteration\n        }\n    }\n    drawTimer(seconds, x, y) {\n        this.ctx.fillStyle = '#fff';\n        this.ctx.font = '20px Arial';\n        this.ctx.textAlign = 'left';\n        const mins = Math.floor(seconds / 60);\n        const secs = seconds % 60;\n        this.ctx.fillText(`Time: ${mins.toString().padStart(2,'0')}:${secs.toString().padStart(2,'0')}`, x, y);\n    }\n    drawBallCounter(remaining, max, x, y, iconSize = 24) {\n        this.ctx.fillStyle = '#fff';\n        this.ctx.font = `bold ${iconSize}px Arial`;\n        this.ctx.textAlign = 'left';\n        this.ctx.fillText(`Balls: ${remaining}/${max}`, x, y);\n    }\n    drawPauseButton(x, y, size = 30, paused) {\n        this.ctx.fillStyle = paused ? '#f44336' : '#4caf50';\n        this.ctx.beginPath();\n        if (paused) {\n            // play triangle\n            this.ctx.moveTo(x, y);\n            this.ctx.lineTo(x + size, y + size/2);\n            this.ctx.lineTo(x, y + size);\n            this.ctx.closePath();\n        } else {\n            // pause bars\n            this.ctx.rect(x, y, size*0.3, size);\n            this.ctx.rect(x + size*0.7, y, size*0.3, size);\n        }\n        this.ctx.fill();\n        this.ctx.strokeStyle = '#fff';\n        this.ctx.lineWidth = 2;\n        this.ctx.stroke();\n    }\n    drawRestartButton(x, y, size = 30) {\n        this.ctx.fillStyle = '#2196f3';\n        this.ctx.beginPath();\n        // circular arrow\n        const radius = size/2;\n        this.ctx.arc(x + radius, y + radius, radius*0.8, Math.PI*0.25, Math.PI*1.75, false);\n        // arrow head\n        this.ctx.lineTo(x + radius + radius*0.4, y + radius - radius*0.2);\n        this.ctx.moveTo(x + radius + radius*0.3, y + radius);\n        this.ctx.lineTo(x + radius + radius*0.4, y + radius + radius*0.2);\n        this.ctx.closePath();\n        this.ctx.fill();\n        this.ctx.strokeStyle = '#fff';\n        this.ctx.lineWidth = 2;\n        this.ctx.stroke();\n    }\n}",
  "src/game.js": "export class Game {\n    constructor() {\n        this.canvas = document.getElementById('gameCanvas');\n        this.ctx = this.canvas.getContext('2d');\n        this.resize();\n        window.addEventListener('resize', () => this.resize());\n        this.renderer = new Renderer(this.canvas, this.ctx);\n        this.input = new Input(this.canvas);\n        this.ui = new UI(this.canvas, this.ctx);\n        this.level = this.createLevel1();\n        this.balls = [];\n        this.maxBalls = 3;\n        this.remainingBalls = this.maxBalls;\n        this.score = 0;\n        this.stars = 0;\n        this.levelTime = 0;\n        this.bestTime = parseInt(localStorage.getItem('physicsCatapultBestTime')) || 9999;\n        this.highScore = parseInt(localStorage.getItem('physicsCatapultHighScore')) || 0;\n        this.paused = false;\n        this.gameOver = false;\n        this.levelComplete = false;\n        this.powerPercent = 0;\n        this.launchVel = new Vector();\n        this.armBase = {x: 150, y: this.canvas.height - 100};\n        this.armLength = 120;\n        this.armAngle = Math.PI/2; // pointing up initially\n        this.gravity = 0.5; // pixels per ms^2? We'll adjust per frame using dt in seconds.\n        this.drag = 0.998; // per frame\n        this.lastTime = 0;\n        this.bindInput();\n    }\n    resize() {\n        const dpr = window.devicePixelRatio || 1;\n        const desiredWidth = 1280;\n        const desiredHeight = 720;\n        const scale = Math.min(window.innerWidth / desiredWidth, window.innerHeight / desiredHeight);\n        this.canvas.width = desiredWidth * scale * dpr;\n        this.canvas.height = desiredHeight * scale * dpr;\n        this.canvas.style.width = `${desiredWidth * scale}px`;\n        this.canvas.style.height = `${desiredHeight * scale}px`;\n        this.ctx.scale(dpr, dpr);\n    }\n    bindInput() {\n        this.input.setOnRelease(({start, end}) => {\n            if (this.remainingBalls <= 0 || this.paused || this.gameOver || this.levelComplete) return;\n            // compute angle and pullback distance\n            const dx = end.x - start.x;\n            const dy = end.y - start.y;\n            const pullBack = Math.hypot(dx, dy);\n            const maxPull = 200;\n            const clamped = clamp(pullBack, 0, maxPull);\n            this.powerPercent = (clamped / maxPull) * 100;\n            // angle from base to start point? Actually arm angle is from base to current handle.\n            // We'll compute angle from base to start point (where drag started)\n            const angle = Math.atan2(start.y - this.armBase.y, start.x - this.armBase.x);\n            // limit angle to -PI/2 to PI/2? We'll allow 0 to PI (downwards)\n            const limitedAngle = clamp(angle, -Math.PI/2, Math.PI/2);\n            // launch velocity magnitude proportional to pullBack\n            const speed = clamped * 0.15; // tweak\n            const vel = vectorFromAngle(limitedAngle + Math.PI/2, speed); // +PI/2 to point up? We'll adjust.\n            this.launchBall(vel);\n        });\n    }\n    launchBall(vel) {\n        if (this.remainingBalls <= 0) return;\n        const ball = new Ball(this.armBase.x, this.armBase.y - 30);\n        ball.vel = vel.copy();\n        ball.active = true;\n        this.balls.push(ball);\n        this.remainingBalls--;\n        this.playLaunchSound();\n        // reset arm\n        this.armAngle = Math.PI/2;\n        this.powerPercent = 0;\n    }\n    update(dt) {\n        if (this.paused || this.gameOver || this.levelComplete) return;\n        this.levelTime += dt;\n        // update balls\n        for (const ball of this.balls) {\n            ball.update(dt, this.gravity, this.drag);\n            // floor collision\n            if (ball.pos.y > this.canvas.height - ball.radius) {\n                ball.pos.y = this.canvas.height - ball.radius;\n                ball.vel.y = -ball.vel.y * 0.6;\n                ball.vel.x *= 0.9;\n                if (Math.abs(ball.vel.y) < 0.5) ball.vel.y = 0;\n                this.playImpactSound();\n            }\n            // wall collision\n            if (ball.pos.x < ball.radius) {\n                ball.pos.x = ball.radius;\n                ball.vel.x = -ball.vel.x * 0.6;\n                this.playImpactSound();\n            }\n            if (ball.pos.x > this.canvas.width - ball.radius) {\n                ball.pos.x = this.canvas.width - ball.radius;\n                ball.vel.x = -ball.vel.x * 0.6;\n                this.playImpactSound();\n            }\n            // ceiling? ignore\n            // block collisions\n            for (const block of this.level.blocks) {\n                if (block.broken) continue;\n                if (block.hits(ball)) {\n                    // simple response: reflect based on side\n                    const dx = ball.pos.x - (block.pos.x + block.w/2);\n                    const dy = ball.pos.y - (block.pos.y + block.h/2);\n                    const absdx = Math.abs(dx);\n                    const absdy = Math.abs(dy);\n                    if (absdx > absdy) {\n                        // hit left/right\n                        ball.vel.x = -ball.vel.x * 0.85;\n                        if (dx > 0) ball.pos.x = block.pos.x + block.w + ball.radius;\n                        else ball.pos.x = block.pos.x - ball.radius;\n                    } else {\n                        // hit top/bottom\n                        ball.vel.y = -ball.vel.y * 0.85;\n                        if (dy > 0) ball.pos.y = block.pos.y + block.h + ball.radius;\n                        else ball.pos.y = block.pos.y - ball.radius;\n                    }\n                    this.playImpactSound();\n                    block.applyDamage();\n                    if (block.broken) {\n                        this.score += 10 * (block.health + 1); // health before damage? approximate\n                        // spawn debris? skip for simplicity\n                    }\n                }\n            }\n            // check if ball reached goal zone (e.g., right side flag)\n            if (ball.pos.x > this.canvas.width - 50 && ball.pos.y < 100) {\n                this.completeLevel();\n            }\n        }\n        // remove inactive balls far off screen\n        this.balls = this.balls.filter(b => b.active && b.pos.x > -50 && b.pos.x < this.canvas.width+50 && b.pos.y > -50 && b.pos.y < this.canvas.height+50);\n        // check for out of balls and no active balls -> fail\n        if (this.remainingBalls === 0 && this.balls.every(b => !b.active)) {\n            this.failLevel();\n        }\n    }\n    completeLevel() {\n        this.levelComplete = true;\n        // compute stars based on time and remaining balls\n        const timeScore = Math.max(0, 100 - this.levelTime/10); // arbitrary\n        const ballsScore = (this.remainingBalls / this.maxBalls) * 100;\n        const total = (timeScore + ballsScore) / 2;\n        if (total >= 90) this.stars = 3;\n        else if (total >= 60) this.stars = 2;\n        else if (total >= 30) this.stars = 1;\n        else this.stars = 0;\n        // update high score\n        if (this.score > this.highScore) {\n            this.highScore = this.score;\n            localStorage.setItem('physicsCatapultHighScore', this.score.toString());\n        }\n        if (this.levelTime < this.bestTime) {\n            this.bestTime = this.levelTime;\n            localStorage.setItem('physicsCatapultBestTime', Math.floor(this.bestTime).toString());\n        }\n    }\n    failLevel() {\n        this.gameOver = true;\n    }\n    resetLevel() {\n        this.level = this.createLevel1();\n        this.balls = [];\n        this.remainingBalls = this.maxBalls;\n        this.score = 0;\n        this.stars = 0;\n        this.levelTime = 0;\n        this.paused = false;\n        this.gameOver = false;\n        this.levelComplete = false;\n        this.armAngle = Math.PI/2;\n        this.powerPercent = 0;\n    }\n    togglePause() {\n        this.paused = !this.paused;\n    }\n    restart() {\n        this.resetLevel();\n    }\n    playLaunchSound() {\n        // Web Audio API: short rising tone\n        const ctx = new (window.AudioContext || window.webkitAudioContext)();\n        const osc = ctx.createOscillator();\n        const gain = ctx.createGain();\n        osc.connect(gain);\n        gain.connect(ctx.destination);\n        osc.frequency.setValueAtTime(220, ctx.currentTime);\n        osc.frequency.exponentialRampToValueAtTime(880, ctx.currentTime + 0.1);\n        gain.gain.setValueAtTime(0, ctx.currentTime);\n        gain.gain.linearRampToValueAtTime(0.4, ctx.currentTime + 0.02);\n        gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.2);\n        osc.start();\n        osc.stop(ctx.currentTime + 0.25);\n    }\n    playImpactSound() {\n