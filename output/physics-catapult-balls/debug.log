Now src/physics.js:

We'll define Vector class, Ball, Block.

```javascript
export class Vector {
    constructor(x = 0, y = 0) {
        this.x = x;
        this.y = y;
    }
    add(v) { return new Vector(this.x + v.x, this.y + v.y); }
    sub(v) { return new Vector(this.x - v.x, this.y - v.y); }
    mul(s) { return new Vector(this.x * s, this.y * s); }
    div(s) { return new Vector(this.x / s, this.y / s); }
    mag() { return Math.hypot(this.x, this.y); }
    setMag(m) { const m0 = this.mag(); if (m0 > 0) { const s = m / m0; this.x *= s; this.y *= s; } return this; }
    limit(max) { if (this.mag() > max) this.setMag(max); return this; }
    copy() { return new Vector(this.x, this.y); }
    static dot(a, b) { return a.x * b.x + a.y * b.y; }
}

export class Ball {
    constructor(x, y, radius = 12) {
        this.pos = new Vector(x, y);
        this.vel = new Vector(0, 0);
        this.radius = radius;
        this.mass = 1;
        this.active = false;
        this.trail = [];
    }
    applyForce(force) {
        const f = force.div(this.mass);
        this.vel = this.vel.add(f);
    }
    update(dt, gravity, drag) {
        if (!this.active) return;
        // apply gravity
        this.vel.y += gravity * dt;
        // apply drag
        this.vel = this.vel.mul(drag);
        // update position
        this.pos = this.pos.add(this.vel.mul(dt));
        // store trail
        this.trail.push({x: this.pos.x, y: this.pos.y});
        if (this.trail.length > 8) this.trail.shift();
    }
    // bounce off vertical/horizontal surfaces
    bounce(normal) {
        // reflect velocity about normal
        const v = this.vel;
        const dot = Vector.dot(v, normal);
        // reflection: v - 2*(v·n)*n
        const reflect = v.sub(normal.mul(2 * dot));
        // apply restitution
        this.vel = reflect.mul(0.85);
        // add slight random angle
        const angle = Math.atan2(this.vel.y, this.vel.x) + (Math.random() - 0.5) * 0.5; // +/-0.25 rad
        const speed = this.vel.mag();
        this.vel = vectorFromAngle(angle, speed);
    }
}

export class Block {
    constructor(x, y, w, h, health = 3) {
        this.pos = new Vector(x, y);
        this.w = w;
        this.h = h;
        this.health = health;
        this.broken = false;
    }
    hits(ball) {
        // simple AABB vs circle
        const dx = Math.abs(ball.pos.x - (this.pos.x + this.w/2));
        const dy = Math.abs(ball.pos.y - (this.pos.y + this.h/2));
        if (dx > this.w/2 + ball.radius) return false;
        if (dy > this.h/2 + ball.radius) return false;
        return true;
    }
    applyDamage() {
        this.health--;
        if (this.health <= 0) this.broken = true;
    }
}
