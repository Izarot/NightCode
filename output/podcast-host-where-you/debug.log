.highScore || 0;\n        }\n        this.gameState.episode++;\n        this.gameState.guest = Utils.generateGuest();\n    }\n    create() {\n        this.createStudio();\n        this.createPlayer();\n        this.createObjects();\n        this.createHUD();\n        this.setupInput();\n        \n        this.setupTimer = 30;\n        this.timeLabel = this.add.text(512, 50, `Guest arrives in: ${this.setupTimer}s`, { fontSize: '24px', fontFamily: 'Arial Black', color: '#ffd700' }).setOrigin(0.5).setDepth(100);\n        this.speedrunTimer = this.add.text(994, 50, '⏱️ 00:00', { fontSize: '18px', fontFamily: 'Arial', color: '#4ecdc4' }).setOrigin(1, 0.5).setDepth(100);\n        \n        this.time.addEvent({ delay: 1000, callback: this.startTimer, callbackScope: this, loop: true });\n        this.cameras.main.fadeIn(500);\n    }\n    startTimer() {\n        if (this.gameState.phase !== 'SETUP') return;\n        this.setupTimer--;\n        this.timeLabel.setText(`Guest arrives in: ${this.setupTimer}s`);\n        if (this.setupTimer <= 0) {\n            this.timeLabel.setText('Guest has arrived!');\n            this.spawnGuest();\n        }\n        const elapsed = Math.floor((Date.now() - this.gameState.startTime) / 1000);\n        const mins = Math.floor(elapsed / 60).toString().padStart(2, '0');\n        const secs = (elapsed % 60).toString().padStart(2, '0');\n        this.speedrunTimer.setText(`⏱️ ${mins}:${secs}`);\n    }\n    createStudio() {\n        this.add.rectangle(512, 384, 1024, 768, 0x2d3436);\n        for (let x = 0; x < 16; x++) {\n            for (let y = 0; y < 12; y++) {\n                if ((x + y) % 2 === 0) this.add.rectangle(32 + x * 64, 32 + y * 64, 64, 64, 0x3d4446, 0.3);\n            }\n        }\n        this.add.rectangle(512, 30, 1024, 60, 0x4a4a6a);\n        for (let i = 0; i < 8; i++) {\n            this.add.rectangle(64 + i * 128, 30, 120, 50, 0x5a5a7a);\n            this.add.rectangle(64 + i * 128, 30, 110, 40, 0x3a3a5a);\n        }\n    }\n    createPlayer() {\n        this.player = this.physics.add.sprite(512, 500, 'player');\n        this.player.setCollideWorldBounds(true);\n        this.player.body.setSize(24, 24);\n        this.player.vx = 0; this.player.vy = 0;\n        this.coffeeSprite = this.add.sprite(512, 480, 'coffee').setVisible(false).setDepth(10);\n    }\n    createObjects() {\n        this.couch = this.add.sprite(700, 250, 'couch').setDepth(1);\n        this.hostDesk = this.add.sprite(200, 500, 'desk').setDepth(1);\n        this.hostMicLight = this.add.circle(160, 480, 6, 0xff0000).setDepth(2);\n        this.add.text(140, 460, 'HOST MIC', { fontSize: '10px', color: '#888' }).setDepth(2);\n        this.guestMic = this.add.sprite(700, 320, 'mic_stand').setDepth(1);\n        this.guestMicLight = this.add.circle(700, 308, 6, 0xff0000).setDepth(2);\n        this.add.text(660, 340, 'GUEST MIC', { fontSize: '10px', color: '#888' }).setDepth(2);\n        this.lightRig = this.add.sprite(512, 80, 'light').setDepth(0);\n        this.lightRadius = this.add.circle(512, 384, 200, 0xffff00, 0.15).setDepth(0).setBlendMode(Phaser.BlendModes.ADD);\n        this.coffeeMachine = this.add.rectangle(350, 600, 40, 60, 0x8b4513).setDepth(1).setInteractive({ useHandCursor: true });\n        this.add.text(320, 635, 'COFFEE', { fontSize: '10px', color: '#888' }).setDepth(2);\n        this.editingBay = this.add.sprite(850, 600, 'monitor').setDepth(1).setInteractive({ useHandCursor: true });\n        this.add.text(800, 635, 'EDITING BAY', { fontSize: '10px', color: '#888' }).setDepth(2);\n        this.bookshelf = this.add.sprite(80, 200, 'bookshelf').setDepth(1).setInteractive({ useHandCursor: true });\n        this.guestSprite = this.add.sprite(700, 250, `guest_${this.gameState.guest.portrait}`).setDepth(1).setVisible(false);\n    }\n    createHUD() {\n        this.hudContainer = this.add.container(0, 700).setDepth(100);\n        this.add.rectangle(0, 0, 1024, 68, 0x000000, 0.8).setOrigin(0, 0);\n        \n        this.moneyText = this.add.text(20, 12, `💰 $${this.gameState.money}`, { fontSize: '18px', color: '#ffd700' });\n        this.reputationText = this.add.text(20, 38, `⭐ ${'★'.repeat(this.gameState.reputation)}${'☆'.repeat(5-this.gameState.reputation)} Rep`, { fontSize: '14px', color: '#ffd700' });\n        this.episodeText = this.add.text(180, 25, `🎙️ Episode ${this.gameState.episode}`, { fontSize: '16px', color: '#4ecdc4' });\n        \n        this.energyBar = this.add.rectangle(380, 20, 200, 16, 0x333333);\n        this.energyFill = this.add.rectangle(380, 20, 200, 16, 0x00ff88).setOrigin(0, 0.5);\n        this.add.text(380, 42, '⚡ Energy', { fontSize: '12px', color: '#aaa' }).setOrigin(0, 0.5);\n        \n        this.patienceBar = this.add.rectangle(620, 20, 200, 16, 0x333333);\n        this.patienceFill = this.add.rectangle(620, 20, 200, 16, 0x4ecdc4).setOrigin(0, 0.5);\n        this.add.text(620, 42, '🕐 Guest Patience', { fontSize: '12px', color: '#aaa' }).setOrigin(0, 0.5);\n        \n        this.chemistryBar = this.add.rectangle(620, 20, 0, 16, 0xff00ff).setOrigin(0, 0.5);\n        this.chemistryBar.setVisible(false);\n        \n        this.phaseText = this.add.text(994, 25, 'PHASE: SETUP', { fontSize: '14px', color: '#ffd700' }).setOrigin(1, 0.5);\n    }\n    setupInput() {\n        this.cursors = this.input.keyboard.createCursorKeys();\n        this.wasd = this.input.keyboard.addKeys('W,A,S,D');\n        this.interactKey = this.input.keyboard.addKey('E');\n        this.spaceKey = this.input.keyboard.addKey('SPACE');\n        this.escKey = this.input.keyboard.addKey('ESC');\n        \n        this.interactKey.on('down', () => this.tryInteract());\n        this.spaceKey.on('down', () => this.tryInteract());\n        this.escKey.on('down', () => { if (this.gameState.phase === 'INTERVIEW') this.endInterviewEarly(); });\n        \n        this.coffeeMachine.on('pointerdown', () => { if (Utils.distance(this.player.x, this.player.y, 350, 600) < CONFIG.player.interactRadius) this.makeCoffee(); });\n        this.editingBay.on('pointerdown', () => { if (Utils.distance(this.player.x, this.player.y, 850, 600) < CONFIG.player.interactRadius) this.openEditor(); });\n        this.bookshelf.on('pointerdown', () => { if (Utils.distance(this.player.x, this.player.y, 80, 200) < CONFIG.player.interactRadius) this.openBookshelf(); });\n    }\n    update(time, delta) {\n        const dt = delta / 1000;\n        this.updatePlayer(dt);\n        this.updateBars();\n        this.updateGuestBehavior(dt);\n        this.updateInterview(dt);\n    }\n    updatePlayer(dt) {\n        let dx = 0, dy = 0;\n        if (this.cursors.left.isDown || this.wasd.A.isDown) dx -= 1;\n        if (this.cursors.right.isDown || this.wasd.D.isDown) dx += 1;\n        if (this.cursors.up.isDown || this.wasd.W.isDown) dy -= 1;\n        if (this.cursors.down.isDown || this.wasd.S.isDown) dy += 1;\n        \n        if (dx !== 0 && dy !== 0) { dx *= 0.707; dy *= 0.707; }\n        \n        this.player.vx = Utils.lerp(this.player.vx, dx * CONFIG.player.speed, CONFIG.player.accel);\n        this.player.vy = Utils.lerp(this.player.vy, dy * CONFIG.player.speed, CONFIG.player.accel);\n        this.player.x += this.player.vx * dt;\n        this.player.y += this.player.vy * dt;\n        \n        this.coffeeSprite.setPosition(this.player.x, this.player.y - 30);\n        \n        if (this.gameState.energy <= 0) {\n            this.player.vx *= 0.5; this.player.vy *= 0.5;\n            this.player.setTint(0x888888);\n        } else { this.player.clearTint(); }\n    }\n    tryInteract() {\n        if (this.gameState.phase === 'SETUP') {\n            if (Utils.distance(this.player.x, this.player.y, 160, 480) < CONFIG.player.interactRadius) this.toggleHostMic();\n            else if (Utils.distance(this.player.x, this.player.y, 700, 320) < CONFIG.player.interactRadius) this.toggleGuestMic();\n            else if (Utils.distance(this.player.x, this.player.y, 512, 80) < CONFIG.player.interactRadius) this.toggleLights();\n            else if (Utils.distance(this.player.x, this.player.y, 350, 600) < CONFIG.player.interactRadius) this.makeCoffee();\n        }\n        else if (this.gameState.phase === 'INTERVIEW') {\n            this.showQuestionDialog();\n        }\n    }\n    toggleHostMic() {\n        this.gameState.hostMicOn = !this.gameState.hostMicOn;\n        this.hostMicLight.setFillStyle(this.gameState.hostMicOn ? 0x00ff00 : 0xff0000);\n        audioManager.playClick();\n        this.showNotification(this.gameState.hostMicOn ? 'Host mic ON' : 'Host mic OFF');\n    }\n    toggleGuestMic() {\n        this.gameState.guestMicOn = !this.gameState.guestMicOn;\n        this.guestMicLight.setFillStyle(this.gameState.guestMicOn ? 0x00ff00 : 0xff0000);\n        audioManager.playClick();\n        this.showNotification(this.gameState.guestMicOn ? 'Guest mic ON' : 'Guest mic OFF');\n    }\n    toggleLights() {\n        const modes = ['standard', 'bright', 'moody'];\n        const idx = (modes.indexOf(this.gameState.lightMode) + 1) % modes.length;\n        this.gameState.lightMode = modes[idx];\n        const colors = { standard: 0xffff00, bright: 0xffffff, moody: 0xff00ff };\n        this.lightRadius.setFillStyle(colors[this.gameState.lightMode], 0.15);\n        audioManager.playClick();\n        this.showNotification(`Lighting: ${this.gameState.lightMode.toUpperCase()}`);\n    }\n    makeCoffee() {\n        if (this.gameState.hasCoffee) { this.showNotification('Already have coffee!'); return; }\n        this.gameState.hasCoffee = true;\n        this.coffeeSprite.setVisible(true);\n        audioManager.playPickup();\n        this.showNotification('☕ Coffee ready!');\n    }\n    deliverCoffee() {\n        if (this.gameState.coffeeDelivered) return;\n        if (Utils.distance(this.player.x, this.player.y, 700, 250) < CONFIG.player.interactRadius) {\n            this.gameState.coffeeDelivered = true;\n            this.gameState.energy = Math.min(100, this.gameState.energy + 30);\n            this.gameState.patience = Math.min(100, this.gameState.patience + 20);\n            this.gameState.chemistry += 5;\n            this.coffeeSprite.setVisible(false);\n            audioManager.playSuccess();\n            this.showNotification('☕ Coffee delivered! +Chemistry');\n        }\n    }\n    spawnGuest() {\n        this.gameState.phase = 'GUEST_ARRIVING';\n        this.guestSprite.setVisible(true);\n        this.guestSprite.x = 1024;\n        this.guestSprite.y = 250;\n        this.tweens.add({ targets: this.guestSprite, x: 700, duration: 1500, ease: 'Power2', onComplete: () => { this.startInterview(); }});\n        this.showNotification(`${this.gameState.guest.name} is arriving!`);\n    }\n    startInterview() {\n        this.gameState.phase = 'INTERVIEW';\n        this.phaseText.setText('PHASE: INTERVIEW');\n        this.chemistryBar.setVisible(true);\n        this.time.removeAllEvents();\n        this.questions = Utils.generateQuestions(this.gameState.guest);\n        this.questionIndex = 0;\n        this.interviewTimer = 0;\n        this.guestHasLeft = false;\n        \n        this.time.addEvent({ delay: 1000, callback: () => {\n            this.interviewTimer++;\n            if (this.interviewTimer > 300 && !this.guestHasLeft) this.endInterview();\n        }, callbackScope: this, loop: true });\n        \n        this.time.delayedCall(2000, () => this.showQuestionDialog());\n    }\n    updateGuestBehavior(dt) {\n        if (this.gameState.phase !== 'INTERVIEW') return;\n        const drainMultiplier = this.gameState.guest.patienceDrain;\n        let drain = CONFIG.interview.patienceDrain * drainMultiplier * dt;\n        if (this.gameState.energy < 30) drain *= 1.5;\n        if (this.gameState.hostMicOn && this.gameState.guestMicOn) drain *= 0.7;\n        this.gameState.patience -= drain;\n        if (this.gameState.patience <= 0) { this.gameState.patience = 0; this.endInterview(); }\n        \n        if (this.gameState.hasCoffee && !this.gameState.coffeeDelivered) {\n            const dist = Utils.distance(this.player.x, this.player.y, this.guestSprite.x, this.guestSprite.y);\n            if (dist < 40) this.deliverCoffee();\n        }\n    }\n    updateInterview(dt) {\n        if (this.gameState.phase !== 'INTERVIEW') return;\n        this.gameState.energy -= CONFIG.interview.energyDrain * dt;\n        if (this.gameState.energy < 0) this.gameState.energy = 0;\n        this.gameState.interviewProgress = Math.min(100, (this.interviewTimer / 300) * 100);\n    }\n    showQuestionDialog() {\n        if (this.gameState.phase !== 'INTERVIEW') return;\n        if (this.questionDialog && this.questionDialog.active) return;\n        if (this.questionIndex >= this.questions.length) { this.endInterview(); return; }\n        \n        const question = this.questions[this.questionIndex];\n        this.questionDialog = this.add.container(512, 384).setDepth(200);\n        const bg = this.add.rectangle(0, 0, 800, 400, 0x1a1a2e, 0.95);\n        const border = this.add.rectangle(0, 0, 800, 400, 0x00ff88).setStrokeStyle(4, 0x00ff88);\n        const title = this.add.text(0, -150, `🎙️ Ask the Right Question`, { fontSize: '24px', color: '#00ff88', fontFamily: 'Arial Black' }).setOrigin(0.5);\n        const questionText = this.add.text(0, -80, question.text, { fontSize: '20px', color: '#ffffff', fontFamily: 'Arial', wordWrap: { width: 700 } }).setOrigin(0.5);\n        const relevanceColor = question.relevance === 2 ? '#00ff88' : question.relevance === 1 ? '#ffd700' : '#ff6b6b';\n        const relevanceText = this.add.text(0, -20, `Relevance: ${'★'.repeat(question.relevance)}${'☆'.repeat(2-question.relevance)}`, { fontSize: '14px', color: relevanceColor }).setOrigin(0.5);\n        \n        const btn1 = this.add.container(-200, 80).setSize(150, 50).setInteractive({ useHandCursor: true });\n        const b1bg = this.add.rectangle(0, 0, 150, 50, relevanceColor);\n        const b1text = this.add.text(0, 0, 'Ask Question', { fontSize: '16px', color: '#1a1a2e', fontFamily: 'Arial Black' }).setOrigin(0.5);\n        btn1.add([b1bg, b1text]);\n        btn1.on('pointerdown', () => { audioManager.playClick(); this.askQuestion(question); this.questionDialog.destroy(); });\n        \n        const btn2 = this.add.container(200, 80).setSize(150, 50).setInteractive({ useHandCursor: true });\n        const b2bg = this.add.rectangle(0, 0, 150, 50, 0xff6b6b);\n        const b2text = this.add.text(0, 0, 'Skip', { fontSize: '16px', color: '#ffffff', fontFamily: 'Arial Black' }).setOrigin(0.5);\n        btn2.add([b2bg, b2text]);\n        btn2.on('pointerdown', () => { audioManager.playError(); this.skipQuestion(); this.questionDialog.destroy(); });\n        \n        this.questionDialog.add([bg, border, title, questionText, relevanceText, btn1, btn2]);\n    }\n    askQuestion(question) {\n        const relevance = question.relevance;\n        let chemistryGain = 0;\n        if (relevance === 2) { chemistryGain = CONFIG.interview.chemistryGood; audioManager.playSuccess(); }\n        else if (relevance === 1) { chemistryGain = CONFIG.interview.chemistryDecent; audioManager.playClick(); }\n        else { chemistryGain = CONFIG.interview.chemistryBad; audioManager.playError(); }\n        \n        this.gameState.chemistry = Utils.clamp(this.gameState.chemistry + chemistryGain, 0, 100);\n        this.gameState.patience = Utils.clamp(this.gameState.patience - 5, 0, 100);\n        this.questionIndex++;\n        \n        this.showFloatingText(700, 250, `+${chemistryGain} Chem`, chemistryGain > 10 ? '#00ff88' : chemistryGain > 5 ? '#ffd700' : '#ff6b6b');\n        this.time.delayedCall(2000, () => this.showQuestionDialog());\n    }\n    skipQuestion() {\n        this.gameState.chemistry = Utils.clamp(this.gameState.chemistry - 5, 0, 100);\n        this.gameState.patience = Utils.clamp(this.gameState.patience - 3, 0, 100);\n        this.questionIndex++;\n        this.showFloatingText(700, 250, '-5 Chem', '#ff6b6b');\n        this.time.delayedCall(1500, () => this.showQuestionDialog());\n    }\n    endInterviewEarly() {\n        if (this.gameState.guestHasLeft) return;\n        this.gameState.chemistry *= 0.5;\n        this.endInterview();\n    }\n    endInterview() {\n        if (this.guestHasLeft) return;\n        this.guestHasLeft = true;\n        this.gameState.phase = 'POST_INTERVIEW';\n        this.phaseText.setText('PHASE: POST-INTERVIEW');\n        \n        this.tweens.add({ targets: this.guestSprite, x: 1024, duration: 1500, ease: 'Power2' });\n        this.showNotification('Interview ended! Go to editing bay.');\n        \n        this.time.delayedCall(3000, () => {\n            this.gameState.clips = Utils.generateClips(this.gameState.chemistry);\n            this.openEditor();\n        });\n    }\n    openEditor() {\n        if (!this.gameState.clips || this.gameState.clips.length === 0) {\n            this.showNotification('No clips yet - complete an interview first!');\n            return;\n        }\n        if (this.gameState.phase === 'INTERVIEW') { this.showNotification('Cannot edit during interview!'); return; }\n        this.scene.start('EditorScene', { gameState: this.gameState });\n    }\n    openBookshelf() {\n        const topics = this.gameState.guest.topics.join(', ');\n        const hintDialog = this.add.container(512, 384).setDepth(200);\n        const bg = this.add.rectangle(0, 0, 600, 300, 0x1a1a2e, 0.95);\n        const border = this.add.rectangle(0, 0, 600, 300, 0xffd700).setStrokeStyle(4, 0xffd700);\n        const title = this.add.text(0, -100, '📚 GUEST RESEARCH', { fontSize: '22px', color: '#ffd700', fontFamily: 'Arial Black' }).setOrigin(0.5);\n        const info = this.add.text(0, -40, `${this.gameState.guest.name}`, { fontSize: '18px', color: '#ffffff' }).setOrigin(0.5);\n        const info2 = this.add.text(0, -10, `${this.gameState.guest.title}`, { fontSize: '14px', color: '#4ecdc4' }).setOrigin(0.5);\n        const info3 = this.add.text(0, 30, `Topics: ${topics}`, { fontSize: '13px', color: '#aaaaaa', wordWrap: { width: 500 } }).setOrigin(0.5);\n        const info4 = this.add.text(0, 80, `Quirk: ${this.gameState.guest.quirk.text}`, { fontSize: '13px', color: '#ff00ff' }).setOrigin(0.5);\n        const closeBtn = this.add.container(0, 120).setSize(100, 30).setInteractive({ useHandCursor: true });\n        const cbg = this.add.rectangle(0, 0, 100, 30, 0x00ff88);\n        const ctext = this.add.text(0, 0, 'CLOSE', { fontSize: '14px', color: '#1a1a2e', fontFamily: 'Arial Black' }).setOrigin(0.5);\n        closeBtn.add([cbg, ctext]);\n        closeBtn.on('pointerdown', () => { hintDialog.destroy(); });\n        hintDialog.add([bg, border, title, info, info2, info3, info4, closeBtn]);\n    }\n    updateBars() {\n        this.energyFill.width = (this.gameState.energy / 100) * 200;\n        this.patienceFill.width = (this.gameState.patience / 100) * 200;\n        this.chemistryBar.width = (this.gameState.chemistry / 100) * 200;\n        const cColor = this.gameState.chemistry > 70 ? 0x00ff88 : this.gameState.chemistry > 40 ? 0xffd700 : 0xff6b6b;\n        this.chemistryBar.setFillStyle(cColor);\n        this.moneyText.setText(`💰 $${this.gameState.money}`);\n        this.reputationText.setText(`⭐ ${'★'.repeat(this.gameState.reputation)}${'☆'.repeat(5-this.gameState.reputation)} Rep`);\n    }\n    showNotification(text) {\n        const note = this.add.text(512, 100, text, { fontSize: '20px', color: '#00ff88', backgroundColor: '#000000', padding: { x: 20, y: 10 } }).setOrigin(0.5).setDepth(150);\n        this.tweens.add({ targets: note, alpha: 0, y: 50, duration: 2000, onComplete: () => note.destroy() });\n    }\n    showFloatingText(x, y, text, color) {\n        const txt = this.add.text(x, y, text, { fontSize: '24px', color: color, fontFamily: 'Arial Black' }).setOrigin(0.5).setDepth(150);\n        this.tweens.add({ targets: txt, y: y - 50, alpha: 0, duration: 1500, onComplete: () => txt.destroy() });\n    }\n}\n\nclass EditorScene extends Phaser.Scene {\n    constructor() { super({ key: 'EditorScene' }); }\n    init(data) { this.gameState = data.gameState; }\n    create() {\n        this.add.rectangle(512, 384, 1024, 768, 0x1a1a2e);\n        this.add.text(512, 40, '🎬 AUDIO EDITING BAY', { fontSize: '32px', color: '#00ff88', fontFamily: 'Arial Black' }).setOrigin(0.5);\n        this.add.text(512, 80, `Target Runtime: 22:00 | Current: 00:00`, { fontSize: '16px', color: '#4ecdc4' }).setOrigin(0.5);\n        \n        this.tracks = [\n            { y: 200, color: 0x00d4ff, label: 'TRACK 1', clips: [] },\n            { y: 350, color: 0xff00ff, label: 'TRACK 2', clips: [] }\n        ];\n        \n        this.tracks.forEach((track, i) => {\n            this.add.rectangle(312, track.y, 600, 100, 0x2d3436).setStrokeStyle(2, track.color);\n            this.add.text(20, track.y, track.label, { fontSize: '14px', color: '#ffffff', fontFamily: 'Arial Black' });\n            for (let x = 0; x < 600; x += 30) {\n                this.add.rectangle(312 + x - 300, track.y, 1, 100, 0x4a4a6a, 0.3);\n            }\n        });\n        \n        this.add.text(512, 480, 'AVAILABLE CLIPS', { fontSize: '18px', color: '#ffd700', fontFamily: 'Arial Black' }).setOrigin(0.5);\n        \n        this.clipBin = this.add.container(512, 600);\n        this.gameState.clips.forEach((clip, i) => {\n            const clipX = (i - this.gameState.clips.length / 2) * 90;\n            const clipBg = this.add.rectangle(clipX, 0, 80, 32, clip.track === 0 ? 0x00d4ff : 0xff00ff).setStrokeStyle(2, 0xffffff);\n            const clipText = this.add.text(clipX, 0, clip.name.substring(0, 8), { fontSize: '10px', color: '#000000' }).setOrigin(0.5);\n            const clipSprite = this.add.container(clipX, 0, [clipBg, clipText]).setSize(80, 32).setInteractive({ useHandCursor: true });\n            clipSprite.clipData = clip;\n            clipSprite.placed = false;\n            clipBg.setFillStyle(clip.hasMistake ? 0xff6b6b : (clip.track === 0 ? 0x00d4ff : 0xff00ff));\n            this.clipBin.add(clipSprite);\n        });\n        \n        this.runtimeText = this.add.text(512, 680, 'Runtime: 00:00 / 22:00', { fontSize: '16px', color: '#ffffff' }).setOrigin(0.5);\n        \n        this.publishBtn = this.add.container(512, 720).setSize(200, 40).setInteractive({ useHandCursor: true });\n        const pbg = this.add.rectangle(0, 0, 200, 40, 0xffd700);\n        const ptext = this.add.text(0, 0, 'PUBLISH EPISODE', { fontSize: '16px', color: '#1a1a2e', fontFamily: 'Arial Black' }).setOrigin(0.5);\n        this.publishBtn.add([pbg, ptext]);\n        this.publishBtn.on('pointerdown', () => this.publishEpisode());\n        \n        this.setupDragDrop();\n    }\n    setupDragDrop() {\n        this.input.on('dragstart', (pointer, gameObject) => {\n            if (gameObject.placed) return;\n            gameObject.setAlpha(0.7);\n            this.children.bringToTop(gameObject);\n        });\n        this.input.on('drag', (pointer, gameObject, dragX, dragY) => {\n            if (gameObject.placed) return;\n            gameObject.x = dragX;\n            gameObject.y = dragY;\n        });\n        this.input.on('dragend', (pointer, gameObject) => {\n            if (gameObject.placed) return;\n            gameObject.setAlpha(1);\n            this.snapToTrack(gameObject);\n        });\n        this.input.on('drop', (pointer, gameObject, dropZone) => {\n            if (gameObject.placed) return;\n        });\n        this.clipBin.iterate(child => { if (child.setInteractive) child.setInteractive({ draggable: true }); });\n    }\n    snapToTrack(clipSprite) {\n        const clip = clipSprite.clipData;\n        let targetTrack = null;\n        let targetY = 0;\n        \n        for (const track of this.tracks) {\n            if (Math.abs(clipSprite.y - track.y) < 60) {\n                if (track.clips.length === 0 || track.color === (clip.track === 0 ? 0x00d4ff : 0xff00ff)) {\n                    targetTrack = track;\n                    targetY = track.y;\n                    break;\n                }\n            }\n        }\n        \n        if (targetTrack) {\n            const lastClip = targetTrack.clips[targetTrack.clips.length - 1];\n            const targetX = lastClip ? lastClip.x + 90 : 40;\n            if (targetX > 580) {\n                this.showEditorError('Track is full!');\n                clipSprite.x = clipSprite.clipData.originalX || 0;\n                clipSprite.y = 0;\n                return;\n            }\n            clipSprite.x = targetX;\n            clipSprite.y = targetY;\n            clipSprite.placed = true;\n            targetTrack.clips.push(clipSprite);\n            audioManager.playClipPlace();\n            this.updateRuntime();\n        } else {\n            this.showEditorError('Drop on a track!');\n            clipSprite.x = clipSprite.clipData.originalX || 0;\n            clipSprite.y = 0;\n        }\n    }\n    updateRuntime() {\n        let totalSeconds = 0;\n        this.tracks.forEach(track => {\n            track.clips.forEach(clip => { totalSeconds += clip.clipData.duration; });\n        });\n        this.gameState.currentRuntime = totalSeconds;\n        const mins = Math.floor(totalSeconds / 60).toString().padStart(2, '0');\n        const secs = (totalSeconds % 60).toString().padStart(2, '0');\n        this.runtimeText.setText(`Runtime: ${mins}:${secs} / 22:00`);\n        \n        const ratio = totalSeconds / this.gameState.targetRuntime;\n        if (ratio >= 0.95 && ratio <= 1.05) this.runtimeText.setColor('#00ff88');\n        else if (ratio < 0.8 || ratio > 1.2) this.runtimeText.setColor('#ff6b6b');\n        else this.runtimeText.setColor('#ffd700');\n    }\n    showEditorError(text) {\n        const err = this.add.text(512, 160, text, { fontSize: '16px', color: '#ff6b6b', backgroundColor: '#000000', padding: { x: 10, y: 5 } }).setOrigin(0.5);\n        this.tweens.add({ targets: err, alpha: 0, duration: 1500, onComplete: () => err.destroy() });\n    }\n    publishEpisode() {\n        let totalSeconds = 0;\n        let mistakeCount = 0;\n        this.tracks.forEach(track => {\n            track.clips.forEach(clip => {\n                totalSeconds += clip.clipData.duration;\n                if (clip.clipData.hasMistake) mistakeCount++;\n            });\n        });\n        \n        const runtimeRatio = totalSeconds / this.gameState.targetRuntime;\n        let qualityScore = 50;\n        qualityScore += (this.gameState.chemistry * 0.3);\n        qualityScore -= (mistakeCount * 10);\n        if (runtimeRatio >= 0.95 && runtimeRatio <= 1.05) qualityScore += 20;\n        if (runtimeRatio < 0.5 || runtimeRatio > 1.5) qualityScore -= 30;\n        qualityScore = Utils.clamp(qualityScore, 0, 100);\n        \n        const earnings = Math.floor(qualityScore * this.gameState.reputation * 5);\n        const reputationGain = qualityScore > 80 ? 1 : qualityScore < 30 ? -1 : 0;\n        \n        this.gameState.money += earnings;\n        this.gameState.reputation = Utils.clamp(this.gameState.reputation + reputationGain, 1, 5);\n        \n        const saveData = {\n            money: this.gameState.money,\n            reputation: this.gameState.reputation,\n            episode: this.gameState.episode,\n            highScore: Math.max(this.gameState.highScore || 0, this.gameState.money)\n        };\n        localStorage.setItem('micCheckSave', JSON.stringify(saveData));\n        \n        this.scene.start('ResultsScene', { qualityScore, earnings, mistakeCount, reputationGain, gameState: this.gameState });\n    }\n}\n\nclass ResultsScene extends Phaser.Scene {\n    constructor() { super({ key: 'ResultsScene' }); }\n    init(data) { this.results = data; this.gameState = data.gameState; }\n    create() {\n        this.add.rectangle(512, 384, 1024, 768, 0x1a1a2e);\n        \n        const score = this.results.qualityScore;\n        const scoreColor = score > 80 ? '#00ff88' : score > 50 ? '#ffd700' : '#ff6b6b';\n        const rating = score > 90 ? '🏆 MASTERPIECE!' : score > 75 ? '⭐ GREAT EPISODE!' : score > 50 ? '👍 DECENT SHOW' : score > 25 ? '😬 NEEDS WORK' : '💀 DISASTER';\n        \n        this.add.text(512, 100, 'EPISODE PUBLISHED!', { fontSize: '40px', color: '#00ff88', fontFamily: 'Arial Black' }).setOrigin(0.5);\n        this.add.text(512, 160, rating, { fontSize: '28px', color: scoreColor, fontFamily: 'Arial Black' }).setOrigin(0.5);\n        \n        this.add.text(512, 250, `Quality Score: ${Math.floor(score)}/100`, { fontSize: '22px', color: scoreColor, fontFamily: 'Arial Black' }).setOrigin(0.5);\n        this.add.text(512, 290, `Earnings: +$${this.results.earnings}`, { fontSize: '22px', color: '#ffd700', fontFamily: 'Arial Black' }).setOrigin(0.5);\n        this.add.text(512, 330, `Reputation: ${this.results.reputationGain > 0 ? '+' : ''}${this.results.reputationGain} ⭐`, { fontSize: '18px', color: '#ffffff' }).setOrigin(0.5);\n        \n        if (this.results.mistakeCount > 0) {\n            this.add.text(512, 370, `Mistakes: ${this.results.mistakeCount}`, { fontSize: '16px', color: '#ff6b6b' }).setOrigin(0.5);\n        }\n        \n        const replayBtn = this.add.container(512, 480).setSize(200, 50).setInteractive({ useHandCursor: true });\n        const rbg = this.add.rectangle(0, 0, 200, 50, 0x00ff88);\n        const rtext = this.add.text(0, 0, 'NEXT EPISODE', { fontSize: '18px', color: '#1a1a2e', fontFamily: 'Arial Black' }).setOrigin(0.5);\n        replayBtn.add([rbg, rtext]);\n        replayBtn.on('pointerdown', () => { audioManager.playClick(); this.scene.start('StudioScene'); });\n        \n        const menuBtn = this.add.container(512, 550).setSize(200, 50).setInteractive({ useHandCursor: true });\n        const mbg = this.add.rectangle(0, 0, 200, 50, 0x4ecdc4);\n        const mtext = this.add.text(0, 0, 'MAIN MENU', { fontSize: '18px', color: '#1a1a2e', fontFamily: 'Arial Black'