0</div>\n            <div class=\"hud-item timer\" id=\"timerDisplay\">Time: 60s</div>\n            <div class=\"hud-item level\" id=\"levelIndicator\">Level 1</div>\n            <div class=\"hud-item status\" id=\"statusText\">Ready to slide!</div>\n        </div>\n\n        <div id=\"timerDisplay\">Time: 60s</div>\n        <div id=\"statusBar\">Ready to play</div>\n\n        <div id=\"rowHeader\" style=\"display:none;\">Row 1</div>\n        <div id=\"rowHeader\" style=\"display:block;\">Row 1</div>\n\n        <button id=\"startBtn\" class=\"start-btn\" style=\"margin-top:20px;\">Start Game</button>\n    </div>\n\n    <script src=\"js/rows.js\"></script>\n    <script src=\"js/physics.js\"></script>\n    <script src=\"js/audio.js\"></script>\n    <script src=\"js/particles.js\"></script>\n    <script src=\"js/input.js\"></script>\n    <script src=\"js/game.js\"></script>\n</body>\n</html>",
  "css/style.css": ":root {\n    --bg: #1a1f2e;\n    --player: #00d4ff;\n    --obstacle: #2a2a3a;\n    --target: #7fff57;\n    --exit: #ff9f43;\n    --accent: #00b4a0;\n    --text: #ffffff;\n    --shadow: 0 4px 12px rgba(0,0,0,0.3);\n}\n\n* { margin: 0; padding: 0; box-sizing: border-box; }\n\nbody {\n    font-family: 'Segoe UI', sans-serif;\n    background: var(--bg);\n    color: var(--text);\n    min-height: 100vh;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    overflow: hidden;\n}\n\n.game-container {\n    position: relative;\n    width: 100%;\n    max-width: 900px;\n    height: 0;\n    display: none;\n}\n\n.game-container.active {\n    display: block;\n}\n\n#canvas {\n    display: block;\n    width: 100%;\n    height: auto;\n}\n\n#hud-layer {\n    position: absolute;\n    top: 20px;\n    left: 20px;\n    right: 20px;\n    z-index: 10;\n    pointer-events: none;\n}\n\n.hud-item {\n    font-size: 14px;\n    font-weight: 600;\n    padding: 8px 12px;\n    border-radius: 6px;\n    letter-spacing: 0.5px;\n}\n\n.score { background: rgba(0,212,255,0.2); color: var(--player); }\ntimer { background: rgba(255,159,67,0.2); color: var(--exit); }\n.level { background: rgba(0,181,160,0.2); color: var(--accent); }\n\n#timer-display {\n    position: absolute;\n    top: 20px;\n    right: 20px;\n    background: rgba(26,31,46,0.9);\n    backdrop-filter: blur(8px);\n    padding: 12px 20px;\n    border-radius: 50px;\n    font-size: 22px;\n    font-weight: 700;\n    color: var(--text);\n    box-shadow: var(--shadow);\n}\n\n#status-bar {\n    position: absolute;\n    top: 50px;\n    bottom: 40px;\n    display: flex;\n    justify-content: center;\n    gap: 20px;\n    font-size: 16px;\n    color: #aaa;\n    pointer-events: none;\n}\n\n.row-header {\n    position: absolute;\n    bottom: 20px;\n    left: 50%;\n    transform: translateX(-50%);\n    font-size: 12px;\n    opacity: 0.7;\n}\n\n#startBtn {\n    margin-top: 20px;\n    padding: 14px 48px;\n    font-size: 18px;\n    background: var(--player);\n    color: #000;\n    border: none;\n    border-radius: 50px;\n    cursor: pointer;\n    transition: transform 0.2s, box-shadow 0.2s;\n}\n#startBtn:hover {\n    transform: scale(1.05);\n    box-shadow: 0 4px 20px rgba(0,212,255,0.4);\n}\n",
  "js/rows.js": "// Row configuration data for the puzzle\nconst ROWS = [\n    {\n        id: 1,\n        obstacles: [{ y: 200 }, { y: 350 }],\n        targets: [{ y: 300 }],\n        exitZone: { xMin: 750, xMax: 770 }\n    },\n    {\n        id: 2,\n        obstacles: [{ y: 180 }, { y: 280 }],\n        targets: [{ y: 260 }],\n        exitZone: { xMin: 780, xMax: 800 }\n    },\n    {\n        id: 3,\n        obstacles: [{ y: 220 }, { y: 340 }],\n        targets: [{ y: 290 }, { y: 410 }],\n        exitZone: { xMin: 810, xMax: 830 }\n    },\n    {\n        id: 4,\n        obstacles: [{ y: 150 }, { y: 270 }],\n        targets: [{ y: 210 }, { y: 330 }],\n        exitZone: { xMin: 840, xMax: 860 }\n    }\n];\n\n// Generate random row configurations for more variety\nfunction generateRandomRow() {\n    const baseY = Math.floor(Math.random() * 250) + 50;\n    const numObstacles = 2 + Math.floor(Math.random() * 3);\n    const obs = [];\n    for (let i = 0; i < numObstacles; i++) {\n        obs.push({ y: baseY + i * 40 });\n    }\n    return {\n        id: Date.now(),\n        obstacles: obs,\n        targets: [{ y: baseY + 70 }],\n        exitZone: { xMin: 760 + Math.floor(Math.random() * 20), xMax: 780 + Math.floor(Math.random() * 20) }\n    };\n}\n\n// Export for use in other modules\nwindow.ROWS = ROWS;\nwindow.generateRandomRow = () => generateRandomRow();\n",
  "js/physics.js": "// Physics engine for player movement and collision detection\nconst PHYSICS = {\n    speed: 6,          // pixels per second\n    acceleration: 0.8, // deceleration factor when stopping\n    friction: 0.92,    // air resistance coefficient\n    maxSpeed: 7,\n    turnRadius: 120,   // degrees for smooth turning\n    \n    // Player state\n    player: null,\n    \n    init() {\n        this.player = {\n            x: 0,\n            y: 0,\n            vx: 0,\n            vy: 0,\n            width: 48,\n            height: 64,\n            targetX: 0\n        };\n    },\n    \n    update(deltaTime) {\n        if (!this.player) return;\n        \n        // Apply friction to velocity\n        this.player.vx *= this.friction;\n        this.player.vy *= this.friction;\n        \n        // Limit speed\n        const speed = Math.sqrt(this.player.vx * this.player.vx + this.player.vy * this.player.vy);\n        if (speed > this.maxSpeed) {\n            const ratio = this.maxSpeed / speed;\n            this.player.vx = this.player.vx * ratio;\n            this.player.vy = this.player.vy * ratio;\n        }\n        \n        // Update position\n        this.player.x += this.player.vx * deltaTime;\n        this.player.y += this.player.vy * deltaTime;\n        \n        // Clamp to canvas bounds\n        this.clampPosition();\n        \n        // Update target X based on progress\n        this.updateTarget();\n    },\n    \n    clampPosition() {\n        const canvas = document.getElementById('gameCanvas');\n        const w = canvas.width;\n        const h = canvas.height;\n        this.player.x = Math.max(0, Math.min(w - this.player.width, this.player.x));\n        this.player.y = Math.max(0, Math.min(h - this.player.height, this.player.y));\n    },\n    \n    updateTarget() {\n        // Advance target based on time spent in row\n        const elapsed = this.getElapsedTime();\n        const targetIndex = this.ROW_INDEX;\n        \n        // Move toward next target if we have one\n        if (this.ROW_INDEX >= 0 && this.ROW_INDEX < ROWS.length) {\n            const row = ROWS[this.ROW_INDEX];\n            let nextTargetY = null;\n            \n            // Find next target below current position\n            for (let i = row.targets.length - 1; i >= 0; i--) {\n                if (this.player.y < row.targets[i].y) {\n                    nextTargetY = row.targets[i].y;\n                    break;\n                }\n            }\n            \n            if (nextTargetY !== null) {\n                this.player.targetX = nextTargetY;\n            }\n        }\n    },\n    \n    getElapsedTime() {\n        // Simplified: track time since entering row\n        return this.lastEnterTime || 0;\n    },\n    \n    lastEnterTime() {\n        if (!this.lastEnterTime) {\n            this.lastEnterTime = Date.now();\n        }\n    }\n};\n\n// Initialize physics once\nPHYSICS.init();",
  "js/audio.js": "// Web Audio API sound effects generator\nconst AudioEngine = {\n    ctx: null,\n    \n    init() {\n        this.ctx = new (window.AudioContext || window.webkitAudioContext)();\n    },\n    \n    // Short whoosh for sliding\n    slideSound(duration = 0.1) {\n        if (!this.ctx) return;\n        const osc = this.ctx.createOscillator();\n        const gain = this.ctx.createGain();\n        \n        osc.type = 'sine';\n        osc.frequency.setValueAtTime(800, this.ctx.currentTime);\n        osc.frequency.exponentialRampToValueAtTime(200, this.ctx.currentTime + duration);\n        \n        gain.gain.setValueAtTime(0.1, this.ctx.currentTime);\n        gain.gain.exponentialRampToValueAtTime(0.001, this.ctx.currentTime + duration);\n        \n        osc.connect(gain);\n        gain.connect(this.ctx.destination);\n        osc.start();\n        osc.stop(this.ctx.currentTime + duration);\n    },\n    \n    // Thud for collision\n    collisionSound() {\n        if (!this.ctx) return;\n        const osc = this.ctx.createOscillator();\n        const gain = this.ctx.createGain();\n        \n        osc.type = 'square';\n        osc.frequency.setValueAtTime(150, this.ctx.currentTime);\n        osc.frequency.exponentialRampToValueAtTime(50, this.ctx.currentTime + 0.15);\n        \n        gain.gain.setValueAtTime(0.2, this.ctx.currentTime);\n        gain.gain.exponentialRampToValueAtTime(0.01, this.ctx.currentTime + 0.15);\n        \n        osc.connect(gain);\n        gain.connect(this.ctx.destination);\n        osc.start();\n        osc.stop(this.ctx.currentTime + 0.15);\n    },\n    \n    // Chime for passing target\n    targetPassSound() {\n        if (!this.ctx) return;\n        const freq = 880;\n        const osc = this.ctx.createOscillator();\n        const gain = this.ctx.createGain();\n        \n        osc.frequency.setValueAtTime(freq, this.ctx.currentTime);\n        osc.frequency.add(440, this.ctx.currentTime + 0.08, 0.06);\n        osc.frequency.add(660, this.ctx.currentTime + 0.12, 0.04);\n        \n        gain.gain.setValueAtTime(0.15, this.ctx.currentTime);\n        gain.gain.exponentialRampToValueAtTime(0.001, this.ctx.currentTime + 0.25);\n        \n        osc.connect(gain);\n        gain.connect(this.ctx.destination);\n        osc.start();\n        osc.stop(this.ctx.currentTime + 0.25);\n    },\n    \n    // Ascending arpeggio for win\n    winSound() {\n        if (!this.ctx) return;\n        const notes = [523, 659, 784, 1047]; // C5, E5, G5, C6\n        notes.forEach((freq, i) => {\n            const osc = this.ctx.createOscillator();\n            const gain = this.ctx.createGain();\n            osc.frequency.setValueAtTime(freq, this.ctx.currentTime + i * 0.08);\n            gain.gain.setValueAtTime(0.1, this.ctx.currentTime + i * 0.08);\n            gain.gain.exponentialRampToValueAtTime(0.001, this.ctx.currentTime + i * 0.08 + 0.15);\n            osc.connect(gain);\n            gain.connect(this.ctx.destination);\n            osc.start(this.ctx.currentTime + i * 0.08);\n            osc.stop(this.ctx.currentTime + i * 0.08 + 0.15);\n        });\n    },\n    \n    // Descending tone for fail\n    failSound() {\n        if (!this.ctx) return;\n        const osc = this.ctx.createOscillator();\n        const gain = this.ctx.createGain();\n        \n        osc.frequency.setValueAtTime(300, this.ctx.currentTime);\n        osc.frequency.exponentialRampToValueAtTime(100, this.ctx.currentTime + 0.3);\n        \n        gain.gain.setValueAtTime(0.2, this.ctx.currentTime);\n        gain.gain.exponentialRampToValueAtTime(0.01, this.ctx.currentTime + 0.3);\n        \n        osc.connect(gain);\n        gain.connect(this.ctx.destination);\n        osc.start();\n        osc.stop(this.ctx.currentTime + 0.3);\n    }\n};\n\n// Initialize audio context (on first interaction)\nwindow.AudioInitialized = true;\nif (!window.AudioInitialized) {\n    AudioEngine.init();\n    window.AudioInitialized = true;\n}", 
  "js/particles.js": "// Particle system for visual effects\nconst ParticleSystem = {\n    particles: [],\n    emit(x, y, count, color, life = 1.0) {\n        for (let i = 0; i < count; i++) {\n            const angle = Math.random() * Math.PI * 2;\n            const speed = Math.random() * 3 + 1;\n            this.particles.push({\n                x: x,\n                y: y,\n                vx: Math.cos(angle) * speed,\n                vy: Math.sin(angle) * speed,\n                life: life,\n                maxLife: life,\n                color: color,\n                size: Math.random() * 4 + 2\n            });\n        }\n    },\n    \n    update(deltaTime) {\n        for (let i = this.particles.length - 1; i >= 0; i--) {\n            const p = this.particles[i];\n            p.x += p.vx * deltaTime;\n            p.y += p.vy * deltaTime;\n            p.life -= deltaTime * 2; // 2 seconds per lifetime\n            \n            if (p.life <= 0) {\n                this.particles.splice(i, 1);\n            }\n        }\n    },\n    \n    render(ctx) {\n        ctx.clearRect(0, 0, ctx.canvas.width, ctx.canvas.height);\n        for (const p of this.particles) {\n            const alpha = (p.life / p.maxLife) * 0.8;\n            ctx.beginPath();\n            ctx.arc(p.x, p.y, p.size * alpha, 0, Math.PI * 2);\n            ctx.fillStyle = p.color;\n            ctx.fill();\n        }\n    }\n};\n\n// Global reference\nwindow.ParticleSystem = ParticleSystem;\n",
  "js/input.js": "// Input handler for keyboard and touch\nconst InputHandler = {\n    keys: {}, // Track pressed keys\n    touchState: { left: false, right: false },\n    \n    init() {\n        // Keyboard events\n        document.addEventListener('keydown', (e) => {\n            this.keys[e.code] = true;\n            // Space bar toggles pause\n            if (e.code === 'Space') e.preventDefault();\n        });\n        \n        document.addEventListener('keyup', (e) => {\n            this.keys[e.code] = false;\n        });\n        \n        // Touch events for mobile\n        const canvas = document.getElementById('gameCanvas');\n        canvas.addEventListener('touchstart', (e) => {\n            e.preventDefault();\n            if (e.touches.length === 1) {\n                this.touchState.left = true;\n            }\n        });\n        \n        canvas.addEventListener('touchend', (e) => {\n            e.preventDefault();\n            if (e.changedTouches.length > 0) {\n                this.touchState.left = false;\n            }\n        });\n        \n        canvas.addEventListener('wheel', (e) => {\n            e.preventDefault();\n            // Pause/resume with wheel\n            if (Math.abs(e.deltaY) > 0.1) {\n                this.paused = !this.paused;\n            }\n        });\n    },\n    \n    isDown(code) {\n        return !!this.keys[code];\n    },\n    \n    getTouchX() {\n        const rect = canvas.getBoundingClientRect();\n        return rect.left + this.touchState.left ? \n               (this.touchState.right ? canvas.width : 0) : 0;\n    },\n    \n    getTouchY() {\n        const rect = canvas.getBoundingClientRect();\n        return rect.top + this.touchState.left ? \n               (this.touchState.right ? canvas.height : 0) : 0;\n    }\n};\n\n// Singleton instance\nwindow.Input = new InputHandler();\n",
  "js/game.js": "// Main game controller\nconst Game = {\n    state: \"START\", // START | PLAYING | WON | FAILED\n    currentRow: 0,\n    timeLeft: 60,\n    score: 0,\n    completedRows: 0,\n    totalRows: ROWS.length,\n    paused: false,\n    lastTick: 0,\n    \n    init() {\n        this.loadHighScore();\n        InputHandler.init();\n        \n        // Set up canvas\n        this.canvas = document.getElementById('gameCanvas');\n        this.ctx = this.canvas.getContext('2d');\n        \n        // Resize handler for responsiveness\n        this.resize();\n        window.addEventListener('resize', () => this.resize());\n        \n        // Load row data\n        this.rows = ROWS;\n        \n        // Initial draw\n        this.draw();\n        \n        // Start the game loop\n        this.lastTick = performance.now();\n        requestAnimationFrame(() => this.gameLoop());\n    },\n    \n    loadHighScore() {\n        try {\n            const saved = localStorage.getItem('sliderush_highscore');\n            if (saved) {\n                this.score = parseInt(saved, 10);\n            }\n        } catch (e) {\n            console.warn('Failed to load high score:', e);\n        }\n    },\n    \n    saveHighScore() {\n        try {\n            localStorage.setItem('sliderush_highscore', this.score.toString());\n        } catch (e) {\n            console.warn('Failed to save high score:', e);\n        }\n    },\n    \n    startGame() {\n        if (this.state === \"START\") {\n            this.state = \"PLAYING\";\n            this.currentRow = 0;\n            this.timeLeft = 60;\n            this.completedRows = 0;\n            this.score = 0;\n            this.paused = false;\n            \n            // Reset player\n            PHYSICS.player.x = 0;\n            PHYSICS.player.y = 0;\n            PHYSICS.player.vx = 0;\n            PHYSICS.player.vy = 0;\n            PHYSICS.player.targetX = 0;\n            \n            // Clear particles\n            ParticleSystem.emitted = false;\n            \n            // Hide start screen\n            document.getElementById('startBtn').style.display = 'none';\n            document.getElementById('gameContainer').classList.add('active');\n            \n            // Show HUD\n            this.updateHUD();\n            \n            // Start the timer\n            this.startTimer();\n            \n            console.log('Game started!');\n        }\n    },\n    \n    update(timestamp) {\n        if (this.state !== \"PLAYING\") return;\n        \n        const dt = (timestamp - this.lastTick) / 1000;\n        this.lastTick = timestamp;\n        \n        // Update physics\n        PHYSICS.update(dt);\n        \n        // Update timer\n        this.timeLeft -= dt * 60; // 60 fps -> 1 sec per tick\n        \n        // Update particles\n        ParticleSystem.update(dt);\n        \n        // Update HUD\n        this.updateHUD();\n        \n        // Check row completion\n        this.checkWinCondition();\n        \n        // Continue game loop\n        requestAnimationFrame(() => this.gameLoop());\n    },\n    \n    gameLoop() {\n        this.update(this.performTimestamp());\n    },\n    \n    performTimestamp() {\n        return Date.now();\n    },\n    \n    updateHUD() {\n        document.getElementById('scoreDisplay').textContent = `Score: ${this.score}`;\n        document.getElementById('timerDisplay').textContent = `Time: ${Math.max(0, Math.round(this.timeLeft))}s`;\n        document.getElementById('levelIndicator').textContent = `Level ${this.currentRow + 1}`;\n        \n        // Status text\n        const statusEl = document.getElementById('statusText');\n        if (this.state === \"START\") {\n            statusEl.textContent = \"Press Start to begin.\";\n        } else if (this.state === \"PLAYING\") {\n            statusEl.textContent = `Row ${this.currentRow + 1} — ${this.timeLeft}s remaining`;\n        } else if (this.state === \"WON\") {\n            statusEl.textContent = \"Level Complete! 🎉\";\n        } else if (this.state === \"FAILED\") {\n            statusEl.textContent = \"Time's Up! Try again.\";\n        }\n    },\n    \n    checkWinCondition() {\n        if (this.state === \"PLAYING\") {\n            // Check if all targets in current row are passed\n            const row = this.rows[this.currentRow];\n            // Simple check: player should be near exit zone\n            // In a full implementation, we'd track which targets were passed\n            // For now, we'll mark as won when reaching the end of all rows\n            \n            // If we've completed all rows, we're done\n            if (this.completedRows >= this.totalRows) {\n                this.endGame(true);\n            }\n        }\n    },\n    \}`