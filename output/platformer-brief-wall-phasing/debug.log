  "config.js": "export const Config = {\n  // Render\n  DESIGN_WIDTH: 1920,\n  DESIGN_HEIGHT: 1080,\n  TILE_SIZE: 16,\n  CHUNK_SIZE: 64,\n  \n  // Physics\n  Physics: {\n    GRAVITY: 2400,\n    MAX_FALL_SPEED: 1200,\n    MOVE_ACCEL_GROUND: 4800,\n    MOVE_DECEL_GROUND: 6000,\n    MOVE_ACCEL_AIR: 2400,\n    MOVE_DECEL_AIR: 400,\n    MAX_SPEED_GROUND: 320,\n    MAX_SPEED_AIR: 300,\n    JUMP_VELOCITY: -680,\n    JUMP_CUT_MULTIPLIER: 0.45,\n    COYOTE_TIME: 0.1,\n    JUMP_BUFFER: 0.12,\n    WALL_SLIDE_SPEED: 180,\n    WALL_JUMP_FORCE_X: 420,\n    WALL_JUMP_FORCE_Y: -580,\n    WALL_JUMP_LOCKOUT: 0.15,\n    CORNER_CORRECTION_BIAS: 2\n  },\n  \n  // Phasing\n  Phase: {\n    DURATION: 0.35,\n    COOLDOWN: 1.2,\n    INPUT_WINDOW: 0.08,\n    REENTRY_PUSH: 8,\n    VISUAL_TRAIL_LIFETIME: 0.15\n  },\n  \n  // Colors\n  Colors: {\n    BG: '#0D0D1A',\n    FG_SOLID: '#1A1A2E',\n    FG_SOLID_LIGHT: '#2E2E4E',\n    PHASE_CYAN: '#00F3FF',\n    HAZARD_MAGENTA: '#FF2E63',\n    GOLD: '#FFD700',\n    UI_TEXT: '#E0E0E0',\n    UI_ACCENT: '#00F3FF',\n    UI_WARNING: '#FF2E63',\n    UI_BG: 'rgba(13, 13, 26, 0.85)',\n    UI_BORDER: '#00F3FF',\n    PARTICLE_DUST: '#4A4A6A',\n    PARTICLE_SPARK: '#00F3FF',\n    PHASE_TRAIL_START: '#00F3FF',\n    PHASE_TRAIL_END: '#FF00FF'\n  },\n  \n  // Layers\n  Layers: {\n    BG_PARALLAX: 0,\n    BG_TILES: 1,\n    FG_TILES: 2,\n    PARTICLES_BELOW: 3,\n    ACTORS: 4,\n    PARTICLES_ABOVE: 5,\n    FG_OVERLAY: 6,\n    UI_HUD: 7,\n    POST_PROCESS: 8\n  },\n  \n  // Collision\n  Collision: {\n    LAYER_SOLID: 1,\n    LAYER_ONE_WAY: 2,\n    LAYER_HAZARD: 4,\n    LAYER_TRIGGER: 8,\n    LAYER_ENEMY_HURTBOX: 16,\n    LAYER_PHASE_SOLID: 32\n  },\n  \n  // Player States\n  PlayerState: {\n    IDLE: 'IDLE',\n    RUN: 'RUN',\n    JUMP_ASCEND: 'JUMP_ASCEND',\n    JUMP_APEX: 'JUMP_APEX',\n    FALL: 'FALL',\n    WALL_SLIDE: 'WALL_SLIDE',\n    PHASING: 'PHASING',\n    PHASE_WINDUP: 'PHASE_WINDUP',\n    DEATH: 'DEATH'\n  },\n  \n  // Input\n  Input: {\n    DEADZONE: 0.15,\n    TRIGGER_THRESHOLD: 0.5\n  },\n  \n  // Timing\n  FIXED_DT: 1/60,\n  MAX_SUB_STEPS: 6\n};\n\nexport const Colors = Config.Colors;\nexport const Physics = Config.Physics;\nexport const PhaseConfig = Config.Phase;\nexport const Layers = Config.Layers;\nexport const CollisionLayers = Config.Collision;\nexport const PlayerState = Config.PlayerState;",
  "utils.js": "export class Vec2 {\n  constructor(x = 0, y = 0) { this.x = x; this.y = y; }\n  set(x, y) { this.x = x; this.y = y; return this; }\n  copy(v) { this.x = v.x; this.y = v.y; return this; }\n  clone() { return new Vec2(this.x, this.y); }\n  add(v) { this.x += v.x; this.y += v.y; return this; }\n  sub(v) { this.x -= v.x; this.y -= v.y; return this; }\n  scale(s) { this.x *= s; this.y *= s; return this; }\n  length() { return Math.hypot(this.x, this.y); }\n  lengthSq() { return this.x * this.x + this.y * this.y; }\n  normalize() { const l = this.length(); if (l > 0) { this.x /= l; this.y /= l; } return this; }\n  dot(v) { return this.x * v.x + this.y * v.y; }\n  lerp(v, t) { this.x += (v.x - this.x) * t; this.y += (v.y - this.y) * t; return this; }\n  floor() { this.x = Math.floor(this.x); this.y = Math.floor(this.y); return this; }\n  ceil() { this.x = Math.ceil(this.x); this.y = Math.ceil(this.y); return this; }\n  min(v) { this.x = Math.min(this.x, v.x); this.y = Math.min(this.y, v.y); return this; }\n  max(v) { this.x = Math.max(this.x, v.x); this.y = Math.max(this.y, v.y); return this; }\n  static zero() { return new Vec2(0, 0); }\n}\n\nexport class AABB {\n  constructor(x = 0, y = 0, w = 0, h = 0) { this.x = x; this.y = y; this.w = w; this.h = h; }\n  set(x, y, w, h) { this.x = x; this.y = y; this.w = w; this.h = h; return this; }\n  copy(b) { this.x = b.x; this.y = b.y; this.w = b.w; this.h = b.h; return this; }\n  clone() { return new AABB(this.x, this.y, this.w, this.h); }\n  get left() { return this.x; }\n  get right() { return this.x + this.w; }\n  get top() { return this.y; }\n  get bottom() { return this.y + this.h; }\n  get centerX() { return this.x + this.w * 0.5; }\n  get centerY() { return this.y + this.h * 0.5; }\n  overlaps(other) { return this.x < other.right && this.right > other.x && this.y < other.bottom && this.bottom > other.y; }\n  contains(x, y) { return x >= this.x && x < this.right && y >= this.y && y < this.bottom; }\n  expand(padding) { this.x -= padding; this.y -= padding; this.w += padding * 2; this.h += padding * 2; return this; }\n  shift(x, y) { this.x += x; this.y += y; return this; }\n}\n\nexport class ObjectPool {\n  constructor(createFn, resetFn, initialSize = 100) {\n    this.createFn = createFn;\n    this.resetFn = resetFn;\n    this.pool = [];\n    this.active = new Set();\n    for (let i = 0; i < initialSize; i++) this.pool.push(createFn());\n  }\n  acquire() {\n    let obj = this.pool.pop() || this.createFn();\n    this.active.add(obj);\n    return obj;\n  }\n  release(obj) {\n    if (this.active.delete(obj)) {\n      this.resetFn(obj);\n      this.pool.push(obj);\n    }\n  }\n  releaseAll() {\n    for (const obj of this.active) {\n      this.resetFn(obj);\n      this.pool.push(obj);\n    }\n    this.active.clear();\n  }\n  forEachActive(fn) { for (const obj of this.active) fn(obj); }\n}\n\nexport function lerp(a, b, t) { return a + (b - a) * t; }\nexport function clamp(v, min, max) { return Math.max(min, Math.min(max, v)); }\nexport function easeOutExpo(t) { return t === 1 ? 1 : 1 - Math.pow(2, -10 * t); }\nexport function easeOutElastic(t) { const c4 = (2 * Math.PI) / 3; return t === 0 ? 0 : t === 1 ? 1 : Math.pow(2, -10 * t) * Math.sin((t * 10 - 0.75) * c4) + 1; }\nexport function randomRange(min, max) { return Math.random() * (max - min) + min; }\nexport function formatTime(ms) { const m = Math.floor(ms / 60000); const s = Math.floor((ms % 60000) / 1000); const msPart = Math.floor(ms % 1000); return `${m.toString().padStart(2, '0')}:${s.toString().padStart(2, '0')}.${msPart.toString().padStart(3, '0')}`; }\nexport function hexToRgb(hex) { const r = parseInt(hex.slice(1, 3), 16); const g = parseInt(hex.slice(3, 5), 16); const b = parseInt(hex.slice(5, 7), 16); return { r, g, b }; }\nexport function rgbToHex(r, g, b) { return '#' + [r, g, b].map(x => Math.round(clamp(x, 0, 255)).toString(16).padStart(2, '0')).join(''); }\nexport function lerpColor(hexA, hexB, t) { const a = hexToRgb(hexA); const b = hexToRgb(hexB); return rgbToHex(lerp(a.r, b.r, t), lerp(a.g, b.g, t), lerp(a.b, b.b, t)); }",
  "input.js": "import { Config } from './config.js';\n\nexport class InputManager {\n  constructor() {\n    this.actionMap = {\n      'MOVE_LEFT': { keys: ['ArrowLeft', 'KeyA'], gamepad: { axis: 0, threshold: -0.5 } },\n      'MOVE_RIGHT': { keys: ['ArrowRight', 'KeyD'], gamepad: { axis: 0, threshold: 0.5 } },\n      'JUMP': { keys: ['Space', 'ArrowUp', 'KeyW'], gamepad: { button: 0 } },\n      'PHASE': { keys: ['ShiftLeft', 'ShiftRight'], gamepad: { button: 6, axis: 5, threshold: 0.5 } },\n      'PAUSE': { keys: ['Escape', 'KeyP'], gamepad: { button: 9 } }\n    };\n    \n    this.keyState = new Map();\n    this.keyPrevState = new Map();\n    this.actionState = new Map();\n    this.actionPrevState = new Map();\n    this.actionValue = new Map();\n    this.actionPrevValue = new Map();\n    this.buffer = [];\n    this.gamepadIndex = -1;\n    \n    this.init();\n  }\n  \n  init() {\n    window.addEventListener('keydown', e => this.onKeyDown(e));\n    window.addEventListener('keyup', e => this.onKeyUp(e));\n    window.addEventListener('gamepadconnected', e => this.onGamepadConnected(e));\n    window.addEventListener('gamepaddisconnected', e => this.onGamepadDisconnected(e));\n    \n    for (const action of Object.keys(this.actionMap)) {\n      this.actionState.set(action, false);\n      this.actionPrevState.set(action, false);\n      this.actionValue.set(action, 0);\n      this.actionPrevValue.set(action, 0);\n    }\n  }\n  \n  onKeyDown(e) { if (!e.repeat) this.keyState.set(e.code, true); }\n  onKeyUp(e) { this.keyState.set(e.code, false); }\n  \n  onGamepadConnected(e) { if (this.gamepadIndex === -1) this.gamepadIndex = e.gamepad.index; }\n  onGamepadDisconnected(e) { if (this.gamepadIndex === e.gamepad.index) this.gamepadIndex = -1; }\n  \n  update() {\n    // Store previous\n    for (const action of this.actionState.keys()) {\n      this.actionPrevState.set(action, this.actionState.get(action));\n      this.actionPrevValue.set(action, this.actionValue.get(action));\n    }\n    \n    // Keyboard\n    for (const [action, mapping] of Object.entries(this.actionMap)) {\n      let pressed = false;\n      let value = 0;\n      \n      for (const key of mapping.keys) {\n        if (this.keyState.get(key)) { pressed = true; value = 1; break; }\n      }\n      \n      // Gamepad\n      const gp = navigator.getGamepads()[this.gamepadIndex];\n      if (gp) {\n        if (mapping.gamepad.button !== undefined && gp.buttons[mapping.gamepad.button].pressed) {\n          pressed = true; value = 1;\n        }\n        if (mapping.gamepad.axis !== undefined) {\n          const axisVal = gp.axes[mapping.gamepad.axis];\n          if (Math.abs(axisVal) > Config.Input.DEADZONE) {\n            if ((axisVal > 0 && mapping.gamepad.threshold > 0) || (axisVal < 0 && mapping.gamepad.threshold < 0)) {\n              pressed = true; value = Math.abs(axisVal);\n            }\n          }\n        }\n        if (mapping.gamepad.axis !== undefined && mapping.gamepad.threshold !== undefined) {\n          const axisVal = gp.axes[mapping.gamepad.axis];\n          if (axisVal > Config.Input.TRIGGER_THRESHOLD) { pressed = true; value = axisVal; }\n        }\n      }\n      \n      this.actionState.set(action, pressed);\n      this.actionValue.set(action, value);\n      \n      // Buffer\n      if (pressed && !this.actionPrevState.get(action)) {\n        this.buffer.push({ action, time: performance.now() / 1000, value });\n      }\n    }\n    \n    // Clean buffer\n    const now = performance.now() / 1000;\n    this.buffer = this.buffer.filter(b => now - b.time < 0.3);\n  }\n  \n  isPressed(action) { return this.actionState.get(action) || false; }\n  isJustPressed(action) { return this.actionState.get(action) && !this.actionPrevState.get(action); }\n  isJustReleased(action) { return !this.actionState.get(action) && this.actionPrevState.get(action); }\n  getValue(action) { return this.actionValue.get(action) || 0; }\n  \n  consumeBuffer(action, maxAge = 0.2) {\n    const now = performance.now() / 1000;\n    const idx = this.buffer.findIndex(b => b.action === action && now - b.time <= maxAge);\n    if (idx !== -1) { this.buffer.splice(idx, 1); return true; }\n    return false;\n  }\n  \n  getMoveAxis() { return this.getValue('MOVE_RIGHT') - this.getValue('MOVE_LEFT'); }\n}",
  "audio.js": "export class AudioSystem {\n  constructor() {\n    this.ctx = null;\n    this.masterGain = null;\n    this.compressor = null;\n    this.buffers = new Map();\n    this.sources = [];\n    this.musicSources = [];\n    this.musicGain = null;\n    this.sfxGain = null;\n    this.enabled = true;\n    this.volume = 0.7;\n    this.musicVolume = 0.5;\n    this.sfxVolume = 0.8;\n  }\n  \n  async init() {\n    this.ctx = new (window.AudioContext || window.webkitAudioContext)();\n    \n    this.compressor = this.ctx.createDynamicsCompressor();\n    this.compressor.threshold.value = -24;\n    this.compressor.knee.value = 30;\n    this.compressor.ratio.value = 12;\n    this.compressor.attack.value = 0.003;\n    this.compressor.release.value = 0.25;\n    \n    this.masterGain = this.ctx.createGain();\n    this.masterGain.gain.value = this.volume;\n    \n    this.musicGain = this.ctx.createGain();\n    this.musicGain.gain.value = this.musicVolume;\n    \n    this.sfxGain = this.ctx.createGain();\n    this.sfxGain.gain.value = this.sfxVolume;\n    \n    this.musicGain.connect(this.masterGain);\n    this.sfxGain.connect(this.masterGain);\n    this.masterGain.connect(this.compressor);\n    this.compressor.connect(this.ctx.destination);\n    \n    // Generate synthetic sounds\n    this.generateSounds();\n  }\n  \n  generateSounds() {\n    // Jump - short pluck\n    this.buffers.set('jump', this.createPluck(440, 0.1, 'sine', 0.3));\n    // Land - thud\n    this.buffers.set('land', this.createNoiseBurst(0.05, 200, 0.4));\n    // Phase windup - rising sweep\n    this.buffers.set('phase_windup', this.createSweep(200, 800, 0.1, 'sine', 0.2));\n    // Phase active - low hum\n    this.buffers.set('phase_active', this.createTone(120, 1.0, 'sawtooth', 0.15));\n    // Phase exit - snap\n    this.buffers.set('phase_exit', this.createPluck(800, 0.05, 'square', 0.4));\n    // Phase fail - bass drop\n    this.buffers.set('phase_fail', this.createSweep(200, 40, 0.5, 'sawtooth', 0.6));\n    // Wall slide - granular\n    this.buffers.set('wall_slide', this.createNoiseBurst(0.1, 500, 0.1));\n    // Dash - whoosh\n    this.buffers.set('dash', this.createSweep(600, 200, 0.15, 'sine', 0.3));\n    // Collect - chime\n    this.buffers.set('collect', this.createPluck(880, 0.2, 'sine', 0.4));\n    // Death - harsh\n    this.buffers.set('death', this.createNoiseBurst(0.3, 100, 0.5));\n  }\n  \n  createPluck(freq, duration, type, gain) {\n    const buffer = this.ctx.createBuffer(1, this.ctx.sampleRate * duration, this.ctx.sampleRate);\n    const data = buffer.getChannelData(0);\n    for (let i = 0; i < data.length; i++) {\n      const t = i / this.ctx.sampleRate;\n      const env = Math.exp(-t * 15);\n      data[i] = Math.sin(2 * Math.PI * freq * t) * env * gain;\n    }\n    return buffer;\n  }\n  \n  createSweep(freqStart, freqEnd, duration, type, gain) {\n    const buffer = this.ctx.createBuffer(1, this.ctx.sampleRate * duration, this.ctx.sampleRate);\n    const data = buffer.getChannelData(0);\n    for (let i = 0; i < data.length; i++) {\n      const t = i / this.ctx.sampleRate;\n      const progress = t / duration;\n      const freq = freqStart + (freqEnd - freqStart) * progress;\n      const env = Math.exp(-t * 5);\n      data[i] = Math.sin(2 * Math.PI * freq * t) * env * gain;\n    }\n    return buffer;\n  }\n  \n  createTone(freq, duration, type, gain) {\n    const buffer = this.ctx.createBuffer(1, this.ctx.sampleRate * duration, this.ctx.sampleRate);\n    const data = buffer.getChannelData(0);\n    for (let i = 0; i < data.length; i++) {\n      const t = i / this.ctx.sampleRate;\n      data[i] = Math.sin(2 * Math.PI * freq * t) * gain;\n    }\n    return buffer;\n  }\n  \n  createNoiseBurst(duration, freqCenter, gain) {\n    const buffer = this.ctx.createBuffer(1, this.ctx.sampleRate * duration, this.ctx.sampleRate);\n    const data = buffer.getChannelData(0);\n    for (let i = 0; i < data.length; i++) {\n      const t = i / this.ctx.sampleRate;\n      const env = Math.exp(-t * 20);\n      data[i] = (Math.random() * 2 - 1) * env * gain;\n    }\n    return buffer;\n  }\n  \n  playSfx(name, options = {}) {\n    if (!this.enabled || !this.ctx || !this.buffers.has(name)) return null;\n    \n    if (this.ctx.state === 'suspended') this.ctx.resume();\n    \n    const source = this.ctx.createBufferSource();\n    source.buffer = this.buffers.get(name);\n    \n    const gain = this.ctx.createGain();\n    gain.gain.value = options.volume || 1;\n    \n    if (options.pitch) {\n      source.playbackRate.value = options.pitch;\n    } else if (name === 'jump') {\n      source.playbackRate.value = 0.95 + Math.random() * 0.1;\n    }\n    \n    source.connect(gain);\n    gain.connect(this.sfxGain);\n    source.start(0);\n    \n    source.onended = () => {\n      source.disconnect();\n      gain.disconnect();\n    };\n    \n    return source;\n  }\n  \n  playMusic(layerName, loop = true) {\n    // Placeholder for music layers\n  }\n  \n  setMusicVolume(vol) { this.musicVolume = vol; if (this.musicGain) this.musicGain.gain.value = vol; }\n  setSfxVolume(vol) { this.sfxVolume = vol; if (this.sfxGain) this.sfxGain.gain.value = vol; }\n  setMasterVolume(vol) { this.volume = vol; if (this.masterGain) this.masterGain.gain.value = vol; }\n  \n  duckMusic(amount, duration) {\n    if (!this.musicGain) return;\n    const start = this.musicGain.gain.value;\n    const target = start * amount;\n    this.musicGain.gain.setTargetAtTime(target, this.ctx.currentTime, 0.05);\n    setTimeout(() => {\n      this.musicGain.gain.setTargetAtTime(start, this.ctx.currentTime, 0.1);\n    }, duration * 1000);\n  }\n}",
  "entities.js": "import { Vec2, AABB } from './utils.js';\nimport { Config } from './config.js';\n\n// Component Types\nexport const ComponentType = {\n  TRANSFORM: 'transform',\n  VELOCITY: 'velocity',\n  COLLIDER: 'collider',\n  PLAYER: 'player',\n  PHASING: 'phasing',\n  SPRITE: 'sprite',\n  PARTICLE: 'particle',\n  TILEMAP: 'tilemap',\n  CAMERA: 'camera',\n  TIMER: 'timer',\n  HEALTH: 'health'\n};\n\n// Base Component Classes\nexport class Transform {\n  constructor(x = 0, y = 0) { this.pos = new Vec2(x, y); this.prevPos = new Vec2(x, y); this.scale = new Vec2(1, 1); this.rotation = 0; }\n}\n\nexport class Velocity {\n  constructor() { this.vel = new Vec2(0, 0); this.maxSpeed = 300; this.drag = 0; }\n}\n\nexport class Collider {\n  constructor(w = 16, h = 16, offsetX = 0, offsetY = 0, layer = Config.Collision.LAYER_SOLID, mask = 0xFFFFFFFF) {\n    this.bounds = new AABB(0, 0, w, h);\n    this.offset = new Vec2(offsetX, offsetY);\n    this.layer = layer;\n    this.mask = mask;\n    this.isTrigger = false;\n    this.collisions = [];\n  }\n  getWorldBounds(transform) {\n    return new AABB(\n      transform.pos.x + this.offset.x,\n      transform.pos.y + this.offset.y,\n      this.bounds.w,\n      this.bounds.h\n    );\n  }\n}\n\nexport class PlayerComponent {\n  constructor() {\n    this.state = Config.PlayerState.IDLE;\n    this.facingDir = 1;\n    this.grounded = false;\n    this.prevGrounded = false;\n    this.touchingWallLeft = false;\n    this.touchingWallRight = false;\n    this.coyoteTimer = 0;\n    this.jumpBufferTimer = 0;\n    this.wallJumpLockout = 0;\n    this.phaseWindupTimer = 0;\n    this.phaseTimer = 0;\n    this.phaseCooldown = 0;\n    this.phaseDirection = new Vec2(0, 0);\n    this.squashStretch = new Vec2(1, 1);\n    this.squashTimer = 0;\n    this.invulnerable = false;\n    this.justJumped = false;\n    this.justPhased = false;\n  }\n}\n\nexport class PhasingComponent {\n  constructor() {\n    this.active = false;\n    this.windup = false;\n    this.timer = 0;\n    this.cooldown = 0;\n    this.direction = new Vec2(0, 0);\n    this.trailTimer = 0;\n  }\n}\n\nexport class SpriteComponent {\n  constructor(texture = null, frameW = 16, frameH = 16) {\n    this.texture = texture;\n    this.frameW = frameW;\n    this.frameH = frameH;\n    this.currentFrame = 0;\n    this.frameTimer = 0;\n    this.frameRate = 12;\n    this.animations = new Map();\n    this.currentAnim = 'idle';\n    this.flipX = false;\n    this.additive = false;\n    this.alpha = 1;\n    this.tint = null;\n  }\n  addAnimation(name, frames, frameRate = 12, loop = true) {\n    this.animations.set(name, { frames, frameRate, loop });\n  }\n  play(name, reset = true) {\n    if (this.currentAnim === name && !reset) return;\n    const anim = this.animations.get(name);\n    if (anim) { this.currentAnim = name; this.currentFrame = 0; this.frameTimer = 0; this.frameRate = anim.frameRate; }\n update(dt) {\n    const anim = this.animations.get(this.currentAnim);\n    if (!anim) return;\n    this.frameTimer += dt;\n    const frameDuration = 1 / this.frameRate;\n    if (this.frameTimer >= frameDuration) {\n      this.frameTimer -= frameDuration;\n      this.currentFrame++;\n      if (this.currentFrame >= anim.frames.length) {\n        if (anim.loop) this.currentFrame = 0;\n        else this.currentFrame = anim.frames.length - 1;\n      }\n    }\n  }\n}\n\nexport class ParticleComponent {\n  constructor() {\n    this.lifetime = 1;\n    this.maxLifetime = 1;\n    this.colorStart = '#FFFFFF';\n    this.colorEnd = '#FFFFFF';\n    this.sizeStart = 4;\n    this.sizeEnd = 0;\n    this.gravity = 0;\n    this.fadeOut = true;\n    this.additive = false;\n  }\n}\n\nexport class TilemapComponent {\n  constructor() {\n    this.chunks = new Map();\n    this.tileSize = Config.TILE_SIZE;\n    this.chunkSize = Config.CHUNK_SIZE;\n    this.tileset = null;\n    this.solidTiles = new Set();\n    this.oneWayTiles = new Set();\n    this.hazardTiles = new Set();\n    this.phaseSolidTiles = new Set();\n  }\n  getChunkKey(cx, cy) { return `${cx},${cy}`; }\n  getChunk(cx, cy) { return this.chunks.get(this.getChunkKey(cx, cy)); }\n  setChunk(cx, cy, data) { this.chunks.set(this.getChunkKey(cx, cy), data); }\n  getTile(x, y) {\n    const cx = Math.floor(x / this.chunkSize);\n    const cy = Math.floor(y / this.chunkSize);\n    const chunk = this.getChunk(cx, cy);\n    if (!chunk) return 0;\n    const lx = x - cx * this.chunkSize;\n    const ly = y - cy * this.chunkSize;\n    return chunk[ly * this.chunkSize + lx] || 0;\n  }\n  setTile(x, y, id) {\n    const cx = Math.floor(x / this.chunkSize);\n    const cy = Math.floor(y / this.chunkSize);\n    let chunk = this.getChunk(cx, cy);\n    if (!chunk) { chunk = new Uint16Array(this.chunkSize * this.chunkSize); this.setChunk(cx, cy, chunk); }\n    const lx = x - cx * this.chunkSize;\n    const ly = y - cy * this.chunkSize;\n    chunk[ly * this.chunkSize + lx] = id;\n  }\n}\n\nexport class CameraComponent {\n  constructor() {\n    this.target = null;\n    this.pos = new Vec2(0, 0);\n    this.shakeIntensity = 0;\n    this.shakeTimer = 0;\n    this.shakeOffset = new Vec2(0, 0);\n    this.lookAhead = new Vec2(0, 0);\n    this.deadzone = new Vec2(120, 80);\n  }\n}\n\nexport class TimerComponent {\n  constructor() { this.timers = new Map(); }\n  set(name, duration, callback, loop = false) { this.timers.set(name, { duration, elapsed: 0, callback, loop, active: true }); }\n  update(dt) { for (const [name, timer] of this.timers) { if (!timer.active) continue; timer.elapsed += dt; if (timer.elapsed >= timer.duration) { timer.callback(); if (timer.loop) timer.elapsed = 0; else timer.active = false; } } }\n  clear(name) { this.timers.delete(name); }\n}\n\nexport class HealthComponent {\n  constructor(maxHealth = 1) { this.maxHealth = maxHealth; this.currentHealth = maxHealth; this.invulnTimer = 0; }\n  takeDamage(amount) { if (this.invulnTimer > 0) return false; this.currentHealth = Math.max(0, this.currentHealth - amount); this.invulnTimer = 0.5; return this.currentHealth <= 0; }\n  heal(amount) { this.currentHealth = Math.min(this.maxHealth, this.currentHealth + amount); }\n  update(dt) { if (this.invulnTimer > 0) this.invulnTimer -= dt; }\n}\n\n// Entity Manager\nexport class EntityManager {\n  constructor() {\n    this.entities = [];\n    this.components = new Map();\n    this.nextId = 0;\n    this.toAdd = [];\n    this.toRemove = new Set();\n  }\n  create() {\n    const id = this.nextId++;\n    this.entities.push(id);\n    return id;\n  }\n  addComponent(entity, type, component) {\n    if (!this.components.has(type)) this.components.set(type, new Map());\n    this.components.get(type).set(entity, component);\n  }\n  getComponent(entity, type) {\n    const map = this.components.get(type);\n    return map ? map.get(entity) : null;\n  }\n  hasComponent(entity, type) {\n    const map = this.components.get(type);\n    return map ? map.has(entity) : false;\n  }\n  removeComponent(entity, type) {\n    const map = this.components.get(type);\n    if (map) map.delete(entity);\n  }\n  removeEntity(entity) { this.toRemove.add(entity); }\n  cleanup() {\n    for (const entity of this.toRemove) {\n      const idx = this.entities.indexOf(entity);\n      if (idx !== -1) this.entities.splice(idx, 1);\n      for (const map of this.components.values()) map.delete(entity);\n    }\n    this.toRemove.clear();\n  }\n  query(...types) {\n    const results = [];\n    for (const entity of this.entities) {\n      let valid = true;\n      for (const type of types) {\n        if (!this.hasComponent(entity, type)) { valid = false; break; }\n      }\n      if (valid) results.push(entity);\n    }\n    return results;\n  }\n}",
  "physics.js": "import { Vec2, AABB } from './utils.js';\nimport { Config } from './config.js';\nimport { EntityManager, ComponentType, Collider, Transform, Velocity, PlayerComponent } from './entities.js';\n\nexport class PhysicsSystem {\n  constructor(entityManager) {\n    this.em = entityManager;\n    this.broadphase = new Map();\n    this.cellSize = Config.CHUNK_SIZE;\n  }\n  \n  update(dt) {\n    this.integrate(dt);\n    this.buildBroadphase();\n    this.narrowPhase();\n    this.resolveCollisions();\n  }\n  \n  integrate(dt) {\n    for (const entity of this.em.entities) {\n      const transform = this.em.getComponent(entity, ComponentType.TRANSFORM);\n      const velocity = this.em.getComponent(entity, ComponentType.VELOCITY);\n      if (!transform || !velocity) continue;\n      \n      transform.prevPos.copy(transform.pos);\n      transform.pos.add(velocity.vel.clone().scale(dt));\n    }\n  }\n  \n  buildBroadphase() {\n    this.broadphase.clear();\n    for (const entity of this.em.entities) {\n      const transform = this.em.getComponent(entity, ComponentType.TRANSFORM);\n      const collider = this.em.getComponent(entity, ComponentType.COLLIDER);\n      if (!transform || !collider) continue;\n      \n      const bounds = collider.getWorldBounds(transform);\n      const minX = Math.floor(bounds.left / this.cellSize);\n      const maxX = Math.floor(bounds.right / this.cellSize);\n      const minY = Math.floor(bounds.top / this.cellSize);\n      const maxY = Math.floor(bounds.bottom / this.cellSize);\n      \n      for (let cx = minX; cx <= maxX; cx++) {\n        for (let cy = minY; cy <= maxY; cy++) {\n          const key = `${cx},${cy}`;\n          if (!this.broadphase.has(key)) this.broadphase.set(key, []);\n          this.broadphase.get(key).push(entity);\n        }\n      }\n    }\n  }\n  \n  narrowPhase() {\n    const checked = new Set();\n    \n    for (const [key, entities] of this.broadphase) {\n      for (let i = 0; i < entities.length; i++) {\n        for (let j = i + 1; j < entities.length; j++) {\n          const a = entities[i];\n          const b = entities[j];\n          const pairKey = a < b ? `${a},${b}` : `${b},${a}`;\n          if (checked.has(pairKey)) continue;\n          checked.add(pairKey);\n          \n          const colA = this.em.getComponent(a, ComponentType.COLLIDER);\n          const colB = this.em.getComponent(b, ComponentType.COLLIDER);\n          const transA = this.em.getComponent(a, ComponentType.TRANSFORM);\n          const transB = this.em.getComponent(b, ComponentType.TRANSFORM);\n          \n          if (!colA || !colB || !transA || !transB) continue;\n          if ((colA.layer & colB.mask) === 0 && (colB.layer & colA.mask) === 0) continue;\n          \n          const boundsA = colA.getWorldBounds(transA);\n          const boundsB = colB.getWorldBounds(transB);\n          \n          if (boundsA.overlaps(boundsB)) {\n            colA.collisions.push({ entity: b, bounds: boundsB, collider: colB });\n            colB.collisions.push({ entity: a, bounds: boundsA, collider: colA });\n          }\n        }\n      }\n    }\n  }\n  \n  resolveCollisions() {\n    for (const entity of this.em.entities) {\n      const player = this.em.getComponent(entity, ComponentType.PLAYER);\n      if (!player) continue;\n      \n      const transform = this.em.getComponent(entity, ComponentType.TRANSFORM);\n      const velocity = this.em.getComponent(entity, ComponentType.VELOCITY);\n      const collider = this.em.getComponent(entity, ComponentType.COLLIDER);\n      const phasing = this.em.getComponent(entity, ComponentType.PHASING);\n      \n      if (!transform || !velocity || !collider) continue;\n      \n      player.grounded = false;\n      player.touchingWallLeft = false;\n      player.touchingWallRight = false;\n      \n      const isPhasing = phasing && phasing.active;\n      \n      for (const collision of collider.collisions) {\n        const otherCollider = collision.collider;\n        const otherBounds = collision.bounds;\n        const bounds = collider.getWorldBounds(transform);\n        \n        if (isPhasing && (otherCollider.layer & Config.Collision.LAYER_PHASE_SOLID) === 0) continue;\n        if (otherCollider.isTrigger) continue;\n        \n        const overlapX = Math.min(bounds.right, otherBounds.right) - Math.max(bounds.left, otherBounds.left);\n        const overlapY = Math.min(bounds.bottom, otherBounds.bottom) - Math.max(bounds.top, otherBounds.top);\n        \n        if (overlapX < overlapY) {\n          if (bounds.centerX < otherBounds.centerX) {\n            transform.pos.x -= overlapX;\n            velocity.vel.x = Math.min(velocity.vel.x, 0);\n            player.touchingWallRight = true;\n          } else {\n            transform.pos.x += overlapX;\n            velocity.vel.x = Math.max(velocity.vel.x, 0);\n            player.touchingWallLeft = true;\n          }\n        } else {\n          if (bounds.centerY < otherBounds.centerY) {\n            transform.pos.y -= overlapY;\n            velocity.vel.y = Math.min(velocity.vel.y, 0);\n            player.grounded = true;\n            player.coyoteTimer = Config.Physics.COYOTE_TIME;\n          } else {\n            transform.pos.y += overlapY;\n            velocity.vel.y = Math.max(velocity.vel.y, 0);\n          }\n        }\n      }\n      \n      collider.collisions.length = 0;\n    }\n  }\n  \n  // Tilemap collision\n  checkTileCollision(entity, tilemap, dx, dy) {\n    const transform = this.em.getComponent(entity, ComponentType.TRANSFORM);\n    const collider = this.em.getComponent(entity, ComponentType.COLLIDER);\n    const phasing = this.em.getComponent(entity, ComponentType.PHASING);\n    if (!transform || !collider) return { x: false, y: false };\n    \n    const bounds = collider.getWorldBounds(transform);\n    const newBounds = new AABB(bounds.x + dx, bounds.y + dy, bounds.w, bounds.h);\n    \n    const startX = Math.floor(newBounds.left / tilemap.tileSize);\n    const endX = Math.floor((newBounds.right - 0.001) / tilemap.tileSize);\n    const startY = Math.floor(newBounds.top / tilemap.tileSize);\n    const endY = Math.floor((newBounds.bottom - 0.001) / tilemap.tileSize);\n    \n    let hitX = false, hitY = false;\n    \n    for (let tx = startX; tx <= endX; tx++) {\n      for (let ty = startY; ty <= endY; ty++) {\n        const tileId = tilemap.getTile(tx, ty);\n        if (tileId === 0) continue;\n        \n        const isSolid = tilemap.solidTiles.has(tileId);\n        const isOneWay = tilemap.oneWayTiles.has(tileId);\n        const isHazard = tilemap.hazardTiles.has(tileId);\n        const isPhaseSolid = tilemap.phaseSolidTiles.has(tileId);\n        \n        const isPhasing = phasing && phasing.active;\n        if (isPhasing && !isPhaseSolid) continue;\n        if (!isSolid && !isOneWay && !isHazard) continue;\n        \n        const tileBounds = new AABB(tx * tilemap.tileSize, ty * tilemap.tileSize, tilemap.tileSize, tilemap.tileSize);\n        \n        if (newBounds.overlaps(tileBounds)) {\n          const overlapX = Math.min(newBounds.right, tileBounds.right) - Math.max(newBounds.left, tileBounds.left);\n          const overlapY = Math.min(newBounds.bottom, tileBounds.bottom) - Math.max(newBounds.top, tileBounds.top);\n          \n          if (overlapX < overlapY) {\n            hitX = true;\n            if (dx > 0) transform.pos.x = tileBounds.left - bounds.w - collider.offset.x;\n            else if (dx < 0) transform.pos.x = tileBounds.right - collider.offset.x;\n          } else {\n            hitY = true;\n            if (dy > 0) {\n              transform.pos.y = tileBounds.top - bounds.h - collider.offset.y;\n              if (!isOneWay || dy > 0) {\n                const player = this.em.getComponent(entity, ComponentType.PLAYER);\n                if (player) player.grounded = true;\n              }\n            } else if (dy < 0) {\n              transform.pos.y = tileBounds.bottom - collider.offset.y;\n            }\n          }\n        }\n      }\n    }\n    \n    return { x: hitX, y: hitY };\n  }\n}",
  "player.js": "import { Vec2 } from './utils.js';\nimport { Config } from './config.js';\nimport { EntityManager, ComponentType, Transform, Velocity, Collider, PlayerComponent, PhasingComponent, SpriteComponent, TimerComponent } from './entities.js';\nimport { PhysicsSystem } from './physics.js';\nimport { AudioSystem } from './audio.js';\nimport { ParticleSystem } from './particle.js';\n\nexport class PlayerSystem {\n  constructor(entityManager, physics, audio, particles, input) {\n    this.em = entityManager;\n    this.physics = physics;\n    this.audio = audio;\n    this.particles = particles;\n    this.input = input;\n    this.playerEntity = null;\n  }\n  \n  createPlayer(x, y) {\n    const entity = this.em.create();\n    \n    this.em.addComponent(entity, ComponentType.TRANSFORM, new Transform(x, y));\n    this.em.addComponent(entity, ComponentType.VELOCITY, new Velocity());\n    this.em.addComponent(entity, ComponentType.COLLIDER, new Collider(12, 28, -6, -28));\n    this.em.addComponent(entity, ComponentType.PLAYER, new PlayerComponent());\n    this.em.addComponent(entity, ComponentType.PHASING, new PhasingComponent());\n    this.em.addComponent(entity, ComponentType.SPRITE, new SpriteComponent(null, 24, 32));\n    this.em.addComponent(entity, ComponentType.TIMER, new TimerComponent());\n    \n    const sprite = this.em.getComponent(entity, ComponentType.SPRITE);\n    sprite.addAnimation('idle', [0, 1, 2, 3], 8, true);\n    sprite.addAnimation('run', [4, 5, 6, 7, 8, 9], 14, true);\n    sprite.addAnimation('jump', [10], 1, false);\n    sprite.addAnimation('fall', [11], 1, false);\n    sprite.addAnimation('wall_slide', [12, 13], 6, true);\n    sprite.addAnimation('phase_windup', [14, 15], 20, false);\n    sprite.addAnimation('phase', [16, 17, 18, 19], 16, true);\n    sprite.addAnimation('death', [20, 21, 22], 8, false);\n    sprite.play('idle');\n    \n    this.playerEntity = entity;\n    return entity;\n  }\n  \n  update(dt) {\n    if (!this.playerEntity) return;\n    \n    const player = this.em.getComponent(this.playerEntity, ComponentType.PLAYER);\n    const velocity = this.em.getComponent(this.playerEntity, ComponentType.VELOCITY);\n    const transform = this.em.getComponent(this.playerEntity, ComponentType.TRANSFORM);\n    const phasing = this.em.getComponent(this.playerEntity, ComponentType.PHASING);\n    const sprite = this.em.getComponent(this.playerEntity, ComponentType.SPRITE);\n    const timer = this.em.getComponent(this.playerEntity, ComponentType.TIMER);\n    \n    if (!player || !velocity || !transform) return;\n    \n    // Timers\n    if (player.coyoteTimer > 0) player.coyoteTimer -= dt;\n    if (player.jumpBufferTimer > 0) player.jumpBufferTimer -= dt;\n    if (player.wallJumpLockout > 0) player.wallJumpLockout -= dt;\n    if (player.phaseCooldown > 0) player.phaseCooldown -= dt;\n    if (player.squashTimer > 0) player.squashTimer -= dt;\n    \n    // Squash & stretch recovery\n    if (player.squashTimer <= 0) {\n      player.squashStretch.x = lerp(player.squashStretch.x, 1, dt * 10);\n      player.squashStretch.y = lerp(player.squashStretch.y, 1, dt * 10);\n    }\n    \n    // Input\n    const moveX = this.input.getMoveAxis();\n    const jumpPressed = this.input.isPressed('JUMP');\n    const jumpJustPressed = this.input.isJustPressed('JUMP');\n    const phaseJustPressed = this.input.isJustPressed('PHASE');\n    \n    // Jump buffer\n    if (jumpJustPressed) player.jumpBufferTimer = Config.Physics.JUMP_BUFFER;\n    \n    // Phase windup\n    if (phaseJustPressed && player.phaseCooldown <= 0 && !phasing.active && !phasing.windup) {\n      const phaseDir = new Vec2(moveX, 0);\n      if (phaseDir.length() < 0.1) {\n        phaseDir.y = -1; // Default up\n      } else {\n        phaseDir.normalize();\n      }\n      player.phaseDirection.copy(phaseDir);\n      phasing.windup = true;\n      phasing.direction.copy(phaseDir);\n      player.phaseWindupTimer = Config.Phase.INPUT_WINDOW;\n      player.state = Config.PlayerState.PHASE_WINDUP;\n      this.audio.playSfx('phase_windup');\n    }\n    \n    if (phasing.windup) {\n      player.phaseWindupTimer -= dt;\n      if (player.phaseWindupTimer <= 0) {\n        this.activatePhase();\n      }\n    }\n    \n    // Phase active\n    if (phasing.active) {\n      phasing.timer -= dt;\n      phasing.trailTimer -= dt;\n      \n      if (phasing.trailTimer <= 0) {\n        this.particles.emitPhaseTrail(transform.pos.x, transform.pos.y, phasing.direction);\n        phasing.trailTimer = Config.Phase.VISUAL_TRAIL_LIFETIME;\n      }\n      \n      // Move during phase\n      const phaseSpeed = 1200;\n      velocity.vel.x = phasing.direction.x * phaseSpeed;\n      velocity.vel.y = phasing.direction.y * phaseSpeed;\n      \n      if (phasing.timer <= 0) {\n        this.deactivatePhase();\n      }\n    }\n    \n    // Ground movement\n    if (player.grounded && !phasing.active) {\n      const accel = moveX !== 0 ? Config.Physics.MOVE_ACCEL_GROUND : Config.Physics.MOVE_DECEL_GROUND;\n      const maxSpeed = Config.Physics.MAX_SPEED_GROUND;\n      \n      velocity.vel.x += moveX * accel * dt;\n      velocity.vel.x = clamp(velocity.vel.x, -maxSpeed, maxSpeed);\n      \n      if (moveX === 0) {\n        velocity.vel.x = lerp(velocity.vel.x, 0, Config.Physics.MOVE_DECEL_GROUND * dt / maxSpeed);\n        if (Math.abs(velocity.vel.x) < 10) velocity.vel.x = 0;\n      }\n      \n      // Facing direction\n      if (moveX > 0) player.facingDir = 1;\n      else if (moveX < 0) player.facingDir = -1;\n    }\n    \n    // Air movement\n    if (!player.grounded && !phasing.active) {\n      const accel = Config.Physics.MOVE_ACCEL_AIR;\n      const decel = Config.Physics.MOVE_DECEL_AIR;\n      const maxSpeed = Config.Physics.MAX_SPEED_AIR;\n      \n      if (player.wallJumpLockout > 0 && Math.sign(moveX) === -Math.sign(player.facingDir)) {\n        // Ignore input opposite to wall jump direction\n      } else {\n        velocity.vel.x += moveX * accel * dt;\n      }\n      velocity.vel.x = clamp(velocity.vel.x, -maxSpeed, maxSpeed);\n      \n      if (moveX === 0) {\n        velocity.vel.x = lerp(velocity.vel.x, 0, decel * dt / maxSpeed);\n      }\n    }\n    \n    // Gravity\n    if (!phasing.active) {\n      velocity.vel.y += Config.Physics.GRAVITY * dt;\n      velocity.vel.y = Math.min(velocity.vel.y, Config.Physics.MAX_FALL_SPEED);\n    }\n    \n    // Jump\n    const canJump = player.grounded || player.coyoteTimer > 0 || (player.touchingWallLeft || player.touchingWallRight);\n    if (player.jumpBufferTimer > 0 && canJump && !phasing.active) {\n      if (player.touchingWallLeft || player.touchingWallRight) {\n        this.wallJump();\n      } else {\n        this.jump();\n      }\n      player.jumpBufferTimer = 0;\n    }\n    \n    // Jump cut\n    if (this.input.isJustReleased('JUMP') && velocity.vel.y < 0 && !phasing.active) {\n      velocity.vel.y *= Config.Physics.JUMP_CUT_MULTIPLIER;\n    }\n    \n    // Wall slide\n    if (!player.grounded && (player.touchingWallLeft || player.touchingWallRight) && velocity.vel.y > 0 && !phasing.active) {\n      velocity.vel.y = Math.min(velocity.vel.y, Config.Physics.WALL_SLIDE_SPEED);\n      player.state = Config.PlayerState.WALL_SLIDE;\n      player.facingDir = player.touchingWallLeft ? 1 : -1;\n    }\n    \n    // State machine\n    this.updateState();\n    \n    // Update sprite\n    this.updateSprite(dt);\n    \n    // Update timer component\n    if (timer) timer.update(dt);\n  }\n  \n  jump() {\n    const velocity = this.em.getComponent(this.playerEntity, ComponentType.VELOCITY);\n    const player = this.em.getComponent(this.playerEntity, ComponentType.PLAYER);\n    const transform = this.em.getComponent(this.playerEntity, ComponentType.TRANSFORM);\n    \n    velocity.vel.y = Config.Physics.JUMP_VELOCITY;\n    player.grounded = false;\n    player.coyoteTimer = 0;\n    player.justJumped = true;\n    player.state = Config.PlayerState.JUMP_ASCEND;\n    \n    // Squash\n    player.squashStretch.set(1.3, 0.7);\n    player.squashTimer = 0.1;\n    \n    this.audio.playSfx('jump', { pitch: 0.9 + Math.random() * 0.2 });\n    this.particles.emitJumpDust(transform.pos.x, transform.pos.y + 16);\n  }\n  \n  wallJump() {\n    const velocity = this.em.getComponent(this.playerEntity, ComponentType.VELOCITY);\n    const player = this.em.getComponent(this.playerEntity, ComponentType.PLAYER);\n    const transform = this.em.getComponent(this.playerEntity, ComponentType.TRANSFORM);\n    \n    const wallDir = player.touchingWallLeft ? 1 : -1;\n    velocity.vel.x = wallDir * Config.Physics.WALL_JUMP_FORCE_X;\n    velocity.vel.y = Config.Physics.WALL_JUMP_FORCE_Y;\n    \n    player.facingDir = wallDir;\n    player.wallJumpLockout = Config.Physics.WALL_JUMP_LOCKOUT;\n    player.grounded = false;\n    player.coyoteTimer = 0;\n    player.state = Config.PlayerState.JUMP_ASCEND;\n    \n    // Stretch\n    player.squashStretch.set(0.7, 1.3);\n    player.squashTimer = 0.1;\n    \n    this.audio.playSfx('jump', { pitch: 1.2 });\n    this.particles.emitWallJumpDust(transform.pos.x, transform.pos.y, wallDir);\n  }\n  \n  activatePhase() {\n    const phasing = this.em.getComponent(this.playerEntity, ComponentType.PHASING);\n    const player = this.em.getComponent(this.playerEntity, ComponentType.PLAYER);\n    const velocity = this.em.getComponent(this.playerEntity, ComponentType.VELOCITY);\n    const transform = this.em.getComponent(this.playerEntity, ComponentType.TRANSFORM);\n    \n    phasing.windup = false;\n    phasing.active = true;\n    phasing.timer = Config.Phase.DURATION;\n    phasing.cooldown = Config.Phase.COOLDOWN;\n    \n    player.phaseCooldown = Config.Phase.COOLDOWN;\n    player.state = Config.PlayerState.PHASING;\n    player.justPhased = true;\n    \n    // Cancel vertical momentum\n    velocity.vel.y = 0;\n    \n    this.audio.playSfx('phase_active');\n    this.particles.emitPhaseActivate(transform.pos.x, transform.pos.y, phasing.direction);\n  }\n  \n  deactivatePhase() {\n    const phasing = this.em.getComponent(this.playerEntity, ComponentType.PHASING);\n    const player = this.em.getComponent(this.playerEntity, ComponentType.PLAYER);\n    const transform = this.em.getComponent(this.playerEntity, ComponentType.TRANSFORM);\n    \n    phasing.active = false;\n    phasing.timer = 0;\n    \n    player.state = Config.PlayerState.FALL;\n    \n    this.audio.playSfx('phase_exit');\n    this.particles.emitPhaseExit(transform.pos.x, transform.pos.y);\n  }\n  \n  updateState() {\n    const player = this.em.getComponent(this.playerEntity, ComponentType.PLAYER);\n    const velocity = this.em.getComponent(this.playerEntity, ComponentType.VELOCITY);\n    const phasing = this.em.getComponent(this.playerEntity, ComponentType.PHASING);\n    \n    if (phasing.windup) {\n      player.state = Config.PlayerState.PHASE_WINDUP;\n    } else if (phasing.active) {\n      player.state = Config.PlayerState.PHASING;\n    } else if (player.grounded) {\n      if (Math.abs(velocity.vel.x) > 20) player.state = Config.PlayerState.RUN;\n      else player.state = Config.PlayerState.IDLE;\n    } else {\n      if (velocity.vel.y < -50) player.state = Config.PlayerState.JUMP_ASCEND;\n      else if (velocity.vel.y > 50) player.state = Config.PlayerState.FALL;\n      else player.state = Config.PlayerState.JUMP_APEX;\n    }\n  }\n  \n  updateSprite(dt) {\n    const sprite = this.em.getComponent(this.playerEntity, ComponentType.SPRITE);\n    const player = this.em.getComponent(this.playerEntity, ComponentType.PLAYER);\n    const phasing = this.em.getComponent(this.playerEntity, ComponentType.PHASING);\n    \n    if (!sprite) return;\n    \n    sprite.flipX = player.facingDir < 0;\n    \n    const animMap = {\n      [Config.PlayerState.IDLE]: 'idle',\n      [Config.PlayerState.RUN]: 'run',\n      [Config.PlayerState.JUMP_ASCEND]: 'jump',\n      [Config.PlayerState.JUMP_APEX]: 'jump',\n      [Config.PlayerState.FALL]: 'fall',\n      [Config.PlayerState.WALL_SLIDE]: 'wall_slide',\n      [Config.PlayerState.PHASE_WINDUP]: 'phase_windup',\n      [Config.PlayerState.PHASING]: 'phase',\n      [Config.PlayerState.DEATH]: 'death'\n    };\n    \n    const animName = animMap[player.state] || 'idle';\n    sprite.play(animName, false);\n    sprite.update(dt);\n    \n    // Phase visual effects\n    if (phasing.active) {\n      sprite.alpha = 0.6 + Math.sin(performance.now() * 0.01) * 0.2;\n      sprite.additive = true;\n      sprite.tint = Config.Colors.PHASE_CYAN;\n    } else if (phasing.windup) {\n      sprite.alpha = 1;\n      sprite.additive = true;\n      sprite.tint = lerpColor(Config.Colors.UI_TEXT, Config.Colors.PHASE_CYAN, Math.sin(performance.now() * 0.02) * 0.5 + 0.5);\n    } else {\n      sprite.alpha = 1;\n      sprite.additive = false;\n      sprite.tint = null;\n    }\n    \n    // Apply squash/stretch to sprite scale\n    sprite.scale.x = player.squashStretch.x * player.facingDir;\n    sprite.scale.y = player.squashStretch.y;\n  }\n  \n  kill() {\n    const player = this.em