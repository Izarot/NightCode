Id('startScreen');\nconst gameOverScreen = document.getElementById('gameOverScreen');\nconst startBtn = document.getElementById('startBtn');\nconst restartBtn = document.getElementById('restartBtn');\n\n// Config\nconst PLAYER_SIZE = 30;\nconst ENEMY_SIZE = 40;\nconst ENEMY_SPEED_BASE = 4;\nconst SPAWN_RATE = 60; // frames\n\n// State\nlet width, height;\nlet player = { x: 0, y: 0, vx: 0, vy: 0 };\nlet enemies = [];\nlet frameCount = 0;\nlet gameActive = false;\nlet startTime = 0;\nlet elapsedTime = 0;\nlet highScore = parseFloat(localStorage.getItem('neon_dodge_highscore')) || 0;\nlet animationId;\n\n// Input\nlet touchX = 0;\nlet touchY = 0;\nlet isDragging = false;\n\nfunction resize() {\n    const container = canvas.parentElement;\n    width = container.clientWidth;\n    height = container.clientHeight;\n    canvas.width = width;\n    canvas.height = height;\n    if (gameActive) {\n        resetPlayerPos();\n    }\n}\n\nfunction resetPlayerPos() {\n    player.x = width / 2;\n    player.y = height - PLAYER_SIZE - 20;\n}\n\nfunction init() {\n    resize();\n    window.addEventListener('resize', resize);\n    \n    // Mouse\n    canvas.addEventListener('mousedown', e => { isDragging = true; touchX = e.clientX; touchY = e.clientY; });\n    window.addEventListener('mousemove', e => { if(isDragging) { touchX = e.clientX; touchY = e.clientY; } });\n    window.addEventListener('mouseup', () => isDragging = false);\n\n    // Touch\n    canvas.addEventListener('touchstart', e => { isDragging = true; const t = e.touches[0]; touchX = t.clientX; touchY = t.clientY; }, {passive: false});\n    window.addEventListener('touchmove', e => { if(isDragging) { e.preventDefault(); const t = e.touches[0]; touchX = t.clientX; touchY = t.clientY; } }, {passive: false});\n    window.addEventListener('touchend', () => isDragging = false);\n\n    // Keys\n    window.addEventListener('keydown', e => {\n        if (e.key === 'ArrowLeft') player.vx = -5;\n        if (e.key === 'ArrowRight') pl