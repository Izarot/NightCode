ath.floor(speedRunTimer)}s`, this.canvas.width / 2, this.canvas.height - 30);\n  }\n\n  drawVehiclePosition() {\n    // Draw vehicle position indicator\n    const x = this.vehicle?.x || 100;\n    const y = this.vehicle?.y || 0;\n    \n    this.ctx.fillStyle = \'#ff2d95\';\n    this.ctx.beginPath();\n    this.ctx.arc(x, y, 8, 0, Math.PI * 2);\n    this.ctx.fill();\n    \n    // Vehicle icon\n    this.ctx.fillStyle = \'#ffffff\';\n    this.ctx.fillRect(x - 15, y - 20, 30, 30);\n  }\n}\n'), write(file='/src/utils/helpers.ts', content='// Utility functions for the game\n\nexport function clamp(value: number, min: number, max: number): number {\n  return Math.max(min, Math.min(max, value));\n}\n\nexport function lerp(start: number, end: number, t: number): number {\n  return start + (end - start) * t;\n}\n\nexport function round(value: number, decimals: number = 0): number {\n  return Math.round(value * Math.pow(10, decimals)) / Math.pow(10, decimals);\n}\n\nexport function getRandomInt(min: number, max: number): number {\n  return Math.floor(Math.random() * (max - min + 1)) + min;\n}\n'), write(file='/package.json', content='{\n  "name": "horizon-racing",\n  "version": "1.0.0",\n  "description": "Vertical Horizon Racer - A retro-styled racing game with scrolling track and speedrun timer",\n  "main": "src/main.ts",\n  "scripts": {\n    "start": "npx serve .",\n    "build": "tsc",\n    "test": "jest"\n  },\n  "keywords": ["racing", "game", "vertical", "horizon"],\n  "author": "Game Developer",\n  "license": "MIT",\n  "devDependencies": {\n    "typescript": "^5.0.0",\n    "serve": "^14.2.0"\n  }\n}\n'), write(file='/tsconfig.json', content='{\n  "compilerOptions": {\n    "target": "ES2020",\n    "module": "commonjs",\n    "strict": true,\n    "esModuleInterop": true,\n    "outDir": "./dist",\n    "rootDir": "./src",\n    "strictNullChecks": true,\n    "forceConsistentCasingInFileNames": true,\n    "resolveJsonModule": true\n  },\n  "include": ["src/**/*"],\n  "exclude": ["