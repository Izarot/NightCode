```javascript
import { loadLevel } from './levelLoader.js';
import { updatePhysics, applyMagnetForce } from './physics.js';
import { Key, Lock, Wall, Hazard, Switch } from './entities.js';
import { handleInput, setMagnetPos, togglePolarity, startMagnet, stopMagnet } from './input.js';
import { render, renderHUD } from './ui.js';
import { initAudio } from './assets.js';
import { getVector } from './utils.js';

const canvas = document.getElementById('gameCanvas');
const ctx = canvas.getContext('2d');
let entities = [];
let magnet = { x:0, y:0, radius:80, strength:2, polarity:1, // 1 attract, -1 repel
               energy:120, maxEnergy:120, energyCost:12, moves:0, active:false };
let keys = [];
let locks = [];
let walls = [];
let hazards = [];
let switches = [];
let gameState = 'play';
let startTime = Date.now();
let highScore = parseInt(localStorage.getItem('mkpHighScore')) || 0;
let score = 0;
let par = 0;

function resize() {
  canvas.width = window.innerWidth;
  canvas.height = window.innerHeight;
}
window.addEventListener('resize', resize);
resize();

let level = null;
let levelLoaded = false;

async function init() {
  const audio = initAudio();
  level = await loadLevel('assets/levels/lvl01.json');
  // parse level
  const ts = level.tileSize || 40;
  // walls
  for (const w of level.walls) {
    walls.push(new Wall(w.x*ts, w.y*ts, w.w*ts, w.h*ts));
  }
  // hazards
  for (const h of level.hazards) {
    hazards.push(new Hazard(h.x*ts, h.y*ts, ts, ts));
  }
  // switches (simplify)
  for (const s of level.switches) {
    switches.push(new Switch(s.x*ts, s.y*ts, ts, ts));
  }
  // locks
  for (const l of level.locks) {
    locks.push(new Lock(l.goal[0]*ts, l.goal[1]*ts, l.type, ts));
  }
  // keys
  for (const k of level.keys) {
    keys.push(new Key(k.start[0]*ts, k.start[1]*ts, k.type, ts));
  }
  // magnet settings
  magnet.radius = level.magnet.radius;
  magnet.strength = level.magnet.strength;
  magnet.polarity = level.magnet.polarity === 'attract' ? 1 : -1;
  magnet.energyCost = level.magnet.energyCost;
  magnet.maxEnergy = level.energy.max;
  magnet.energy = magnet.maxEnergy;
  par = level.par || 0;
  levelLoaded = true;
  requestAnimationFrame(gameLoop);
}

function gameLoop(time) {
  if (!levelLoaded) { requestAnimationFrame(gameLoop); return; }
  const dt = 1/60;
  // input
  handleInput();
  // magnet force
  if (magnet.active) {
    applyMagnetForce(magnet, keys, walls);
    // play hum loop? we'll just trigger a short sound on activation
  }
  // update entities
  updatePhysics(entities.concat(keys, locks, walls, hazards, switches), dt, walls);
  // check key-lock overlap
  for (const key of keys) {
    if (!key.locked) {
      for (const lock of locks) {
        if (!lock.isUnlocked && lock.type === key.type) {
          const dx = key.x - lock.x;
          const dy = key.y - lock.y;
          const dist = Math.sqrt(dx*dx+dy*dy);
          if (dist < lock.size/2 + key.size/2) {
            lock.isUnlocked = true;
            key.locked = true;
            audio.playLockClick();
            // add points
            score += 100;
          }
        }
      }
    }
  }
  // check hazards
  for (const key of keys) {
    for (const haz of hazards) {
      if (key.x > haz.x && key.x < haz.x+haz.w && key.y > haz.y && key.y < haz.y+haz.h) {
        // reset key
        key.x = key.startX;
        key.y = key.startY;
        key.vx = 0;
        key.vy = 0;
        magnet.energy = Math.max(0, magnet.energy - 10);
        audio.playHazardZap();
      }
    }
  }
  // check win condition
  const allUnlocked = locks.every(l => l.isUnlocked);
  if (allUnlocked && gameState === 'play') {
    gameState = 'win';
    const elapsed = (Date.now() - startTime)/1000;
    const timeBonus = Math.max(0, 60 - elapsed) * 2; // arbitrary
    const energyBonus = magnet.energy;
    const moveBonus = Math.max(0, par - magnet.moves) * 20;
    score += timeBonus + energyBonus + moveBonus;
    if (score > highScore) {
      highScore = score;
      localStorage.setItem('mkpHighScore', highScore);
    }
  }
  // render
  ctx.clearRect(0,0,canvas.width,canvas.height);
  // draw background gradient
  const grad = ctx.createLinearGradient(0,0,0,canvas.height);
  grad.addColorStop(0,'#0d0d0d');
  grad.addColorStop(1,'#1a1a1a');
  ctx.fillStyle = grad;
  ctx.fillRect(0,0,canvas.width,canvas.height);
  // draw walls
  ctx.fillStyle = '#555';
  for (const w of walls) {
    ctx.fillRect(w.x, w.y, w.w, w.h);
  }
  // draw hazards
  ctx.fillStyle = '#f00';
  for (const h of hazards) {
    ctx.fillRect(h.x, h.y, h.w, h.h);
  }
  // draw switches
  ctx.fillStyle = '#880';
  for (const s of switches) {
    ctx.fillRect(s.x, s.y, s.w, s.h);
  }
  // draw locks
  for (const l of locks) {
    l.draw(ctx);
  }
  // draw keys
  for (const k of keys) {
    k.draw(ctx);
  }
  // draw magnet cursor
  ctx.save();
  ctx.translate(magnet.x, magnet.y);
  ctx.beginPath();
  ctx.arc(0,0,magnet.radius,0,Math.PI*2);
  ctx.strokeStyle = magnet.polarity===1 ? '#00f' : '#f00';
  ctx.lineWidth = 3;
  ctx.stroke();
  // polarity icon
  ctx.fillStyle = '#fff';
  ctx.font = 'bold 20px sans-serif';
  ctx.textAlign = 'center';
  ctx.textBaseline = 'middle';
  ctx.fillText(magnet.polarity===1 ? 'N' : 'S', 0, 0);
  if (magnet.active) {
    ctx.strokeStyle = 'rgba(255,255,255,0.3)';
    ctx.lineWidth = 2;
    ctx.beginPath();
    ctx.arc(0,0,magnet.radius*1.2,0,Math.PI*2);
    ctx.stroke();
  }
  ctx.restore();
  // HUD
  renderHUD(ctx, magnet, score, par, startTime, highScore);
  if (gameState === 'win') {
    ctx.fillStyle = 'rgba(0,0,0,0.7)';
    ctx.fillRect(0,0,canvas.width,canvas.height);
    ctx.fillStyle = '#ff0';
    ctx.textAlign = 'center';
    ctx.font = '48px sans-serif';
    ctx.fillText('Level Complete!', canvas.width/2, canvas.height/2 - 40);
    ctx.font = '24px sans-serif';
    ctx.fillText(`Score: ${score}`, canvas.width/2, canvas.height/2);
    ctx.fillText(`High Score: ${highScore}`, canvas.width/2, canvas.height/2 + 30);
    ctx.fillText('Click to replay', canvas.width/2, canvas.height/2 + 70);
  }
  requestAnimationFrame(gameLoop);
}

init();

// click to replay on win
canvas.addEventListener('click', () => {
  if (gameState === 'win') {
    // reset
    location.reload();
  }
});
```

