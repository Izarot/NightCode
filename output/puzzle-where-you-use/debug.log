```javascript
export function applyMagnetForce(magnet, keys, walls) {
  const {x:mx, y:my, radius, strength, polarity} = magnet;
  const r2 = radius*radius;
  for (const key of keys) {
    const dx = key.x - mx;
    const dy = key.y - my;
    const distSq = dx*dx + dy*dy;
    if (distSq <= r2) {
      const dist = Math.sqrt(distSq);
      const nx = dx/dist;
      const ny = dy/dist;
      const falloff = 1 - distSq/r2;
      const force = strength * falloff;
      const ax = (polarity===1 ? nx : -nx) * force / key.mass;
      const ay = (polarity===1 ? ny : -ny) * force / key.mass;
      key.vx += ax;
      key.vy += ay;
    }
  }
}

export function updatePhysics(entities, dt, walls) {
  for (const e of entities) {
    // apply damping
    e.vx *= 1 - e.drag * dt;
    e.vy *= 1 - e.drag * dt;
    // integrate
    e.x += e.vx * dt;
    e.y += e.vy * dt;
    // simple AABB collision with walls
    for (const w of walls) {
      if (e.x < w.x + w.w && e.x + e.w > w.x &&
          e.y < w.y + w.h && e.y + e.h > w.y) {
        // resolve: push out
        const overlapX = Math.min(e.x + e.w - w.x, w.x + w.w - e.x);
        const overlapY = Math.min(e.y + e.h - w.y, w.y + w.h - e.y);
        if (overlapX < overlapY) {
          e.x += e.x + e.w/2 < w.x + w.w/2 ? -overlapX : overlapX;
        } else {
          e.y += e.y + e.h/2 < w.y + w.h/2 ? -overlapY : overlapY;
        }
        // bounce a little
        e.vx *= -0.2;
        e.vy *= -0.2;
      }
    }
  }
}
```

