    playSound('swap');
  }
}

function spawnEnemies() {
  enemies = [];
  const count = 2 + wave;
  for (let i = 0; i < count; i++) {
    let ex, ey;
    do {
      ex = Math.floor(Math.random() * COLS);
      ey = Math.floor(Math.random() * ROWS);
    } while (grid[ey][ex] !== 0 || (ex === player.tx && ey === player.ty));
    enemies.push({ x: ex, y: ey, tx: ex, ty: ey, hp: 20 + wave * 5, timer: 0 });
  }
}

function update() {
  if (gameOver) return;
  
  player.x += (player.tx * cellSize + cellSize / 2 - player.x) * 0.2;
  player.y += (player.ty * cellSize + cellSize / 2 - player.y) * 0.2;
  
  enemies.forEach(en => {
    en.timer++;
    if (en.timer > Math.max(20, 60 - wave * 3)) {
      en.timer = 0;
      const dx = player.tx - en.tx;
      const dy = player.ty - en.ty;
      if (Math.abs(dx) + Math.abs(dy) === 1) {
        integrity -= 10;
        integrityEl.textContent = Math.max(0, integrity);
        playSound('hit');
        createParticles(en.tx, en.ty, COLORS.enemy);
        if (integrity <= 0) endGame();
      } else {
        const nx = en.tx + Math.sign(dx);
        const ny = en.ty + Math.sign(dy);
        if (nx >= 0 && nx < COLS && ny >= 0 && ny < ROWS && grid[ny][nx] === 0) {
          en.tx = nx;
          en.ty = ny;
        }
      }
    }
  });
  
  for (let i = particles.length - 1; i >= 0; i--) {
    const p = particles[i];
    p.x += p.vx;
    p.y += p.vy;
    p.life--;
    if (p.life <= 0) particles.splice(i, 1);
  }
}

function createParticles(cx, cy, color) {
  for (let i = 0; i < 6; i++) {
    particles.push({
      x: cx * cellSize + cellSize / 2,
      y: cy * cellSize + cellSize / 2,
      vx: (Math.random() - 0.5) * 6,
      vy: (Math.random() - 0.5) * 6,
      life: 25,
      color: color
    });
  }
}

function endGame() {
  gameOver = true;
  timerRunning = false;
  overlay.classList.remove('hidden');
  overlayTitle.textContent = 'VAULT BREACHED';
  overlayScore.textContent = wave - 1;
  if (wave - 1 > highScore) {
    highScore = wave - 1;
    localStorage.setItem('shattered_vault_highscore', highScore.toString());
    highScoreEl.textContent = highScore;
  }
}

function draw() {
  ctx.fillStyle = COLORS.bg;
  ctx.fillRect(0, 0, width, height);
  
  for (let r = 0; r < ROWS; r++) {
    for (let c = 0; c < COLS; c++) {
      const type = grid[r][c];
      if (type === 0) continue;
      let color = COLORS.wall;
      if (type === 1) color = COLORS.combat;
      else if (type === 2) color = COLORS.trap;
      else if (type === 3) color = COLORS.utility;
      else if (type === 4) color = COLORS.barricade;
      ctx.fillStyle = color;
      ctx.fillRect(c * cellSize, r * cellSize, cellSize - 1, cellSize - 1);
    }
  }
  
  enemies.forEach(en => {
    ctx.fillStyle = COLORS.enemy;
    ctx.fillRect(en.tx * cellSize + 2, en.ty * cellSize + 2, cellSize - 4, cellSize - 4);
  });
  
  ctx.fillStyle = COLORS.player;
  ctx.beginPath();
  ctx.arc(player.x, player.y, player.radius, 0, Math.PI * 2);
  ctx.fill();
  
  particles.forEach(p => {
    ctx.fillStyle = p.color;
    ctx.fillRect(p.x, p.y, 3, 3);
  });
}

function gameLoop() {
  update();
  draw();
  requestAnimationFrame(gameLoop);
}

spawnEnemies();
gameLoop();
</script>"}