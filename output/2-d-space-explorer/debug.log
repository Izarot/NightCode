```javascript
// src/utils/quadtree.js
class Quadtree {
  constructor(bounds, capacity = 10) {
    this.bounds = bounds; // {x, y, w, h}
    this.capacity = capacity;
    this.objects = [];
    this.nodes = null;
  }
  
   subdivide() {
    const { x, y, w, h } = this.bounds;
