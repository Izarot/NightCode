#### Player Model
javascript
class Player {
  constructor(x, y) {
    this.x = x;
    this.y = y;
    this.vx = 0;
    this.vy = 0;
    this.angle = 0; // radians
    this.angularVelocity = 0;
    this.maxSpeed = 450;
    this.thrust = 600;
    this.maxRotation = 3.5;
    this.shield = 100;
    this.hull = 100; // or maybe just shield + hull system
    this.shieldRegenRate = 2; // HP/sec
    this.thrusting = false;
    this.braking = false;
    this.invincible = false;
    this.invincibleTimer = 0;
    this.speedBoostTimer = 0;
    this.radius = 15;
  }
  
  update(dt, input) {
    // Rotation
    if (input.up) this.angle -= this.maxRotation * dt * 0.15; // easing
    // ...
    
    // Thrust
    if (input.thrust) {
      const thrustX = Math.cos(this.angle) * this.thrust;
      const thrustY = Math.sin(this.angle) * this.thrust;
      this.vx += thrustX * dt;
      this.vy += thrustY * dt;
      this.thrusting = true;
    } else {
      this.thrusting = false;
    }
    
    // Brake
    if (input.brake) {
      // apply reverse thrust
      this.vx -= Math.cos(this.angle) * this.thrust * 0.5 * dt;
      this.vy -= Math.sin(this.angle) * this.thrust * 0.5 * dt;
      // momentum damping
      this.vx *= 0.995;
      this.vy *= 0.995;
    }
    
    // Clamp speed
    const speed = Math.sqrt(this.vx*this.vx + this.vy*this.vy);
    if (speed > this.maxSpeed) {
      this.vx = (this.vx / speed) * this.maxSpeed;
      this.vy = (this.vy / speed) * this.maxSpeed;
    }
    
    // Update position
    this.x += this.vx * dt;
    this.y += this.vy * dt;
    
    // Shield regen
    if (!this.damaged && this.shield < 100) {
      this.shield = Math.min(100, this.shield + this.shieldRegenRate * dt);
    }
    
    // Invincibility timer
    if (this.invincible) {
      this.invincibleTimer -= dt;
      if (this.invincibleTimer <= 0) {
        this.invincible = false;
      }
    }
    
    // Speed boost timer
    if (this.speedBoostTimer > 0) {
      this.speedBoostTimer -= dt;
    }
  }
  
  takeDamage(amount) {
    if (this.invincible) return;
    this.shield -= amount;
    this.damaged = true;
    // trigger damage effect
  }
  
  collectCore() {
    this.speedBoostTimer = 5; // 5 seconds
    this.invincible = true;
    this.invincibleTimer = 5;
  }
}


