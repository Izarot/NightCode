Let me write the procedural generator:

```javascript
class ProceduralGenerator {
  constructor() {
    this.noiseScale = 0.005;
    this.noiseOffset = { x: 0, y: 0 };
    this.waveDensity = 0.3;
    this.waveSpeed = 1;
  }
  
  generateField(canvasWidth, canvasHeight, wave) {
    const asteroids = [];
    const count = Math.floor(5 + wave * 15);
    
    for (let i = 0; i < count; i++) {
      // Use noise to find a good spawn location
      const angle = Math.random() * Math.PI * 2;
      const dist = Math.random() * 400 + 100;
      const x = (canvasWidth / 2) + Math.cos(angle) * dist + MathUtils.randomRange(-200, 200);
      const y = (canvasHeight / 2) + Math.sin(angle) * dist + MathUtils.randomRange(-200, 200);
      
      // Determine size based on wave
      const baseSize = 20 + wave * 10;
      const sizeVariation = MathUtils.randomRange(0.5, 1.5);
      const radius = baseSize * sizeVariation;
      
      // Add some clustering
      const clusterNoise = this.noise2D(x * this.noiseScale, y * this.noiseScale);
      if (clusterNoise > 0.5 + wave * 0.1) {
        // Place near existing cluster
        const clusterAngle = Math.random() * Math.PI * 2;
        const clusterDist = Math.random() * 80;
        const cx = x + Math.cos(clusterAngle) * clusterDist;
        const cy = y + Math.sin(clusterAngle) * clusterDist;
        asteroids.push(new Asteroid(cx, cy, radius));
      } else {
        asteroids.push(new Asteroid(x, y, radius));
      }
    }
    
    return asteroids;
  }
}
```

