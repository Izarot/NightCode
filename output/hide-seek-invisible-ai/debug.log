  "styles.css": ":root {\n    --neon-cyan: #00ffff;\n    --neon-magenta: #ff00ff;\n    --neon-yellow: #ffff00;\n    --neon-red: #ff3333;\n    --bg-dark: #0a0a12;\n    --panel-bg: rgba(10, 10, 18, 0.85);\n    --border-neon: #00ffff;\n    --text-primary: #e0e0ff;\n    --text-dim: #606080;\n}\n\n* { margin: 0; padding: 0; box-sizing: border-box; }\n\nhtml, body { \n    width: 100%; height: 100%; \n    background: var(--bg-dark); \n    overflow: hidden; \n    font-family: 'Rajdhani', sans-serif; \n    color: var(--text-primary);\n    touch-action: none;\n}\n\n#game-canvas {\n    display: block;\n    width: 100%;\n    height: 100%;\n    image-rendering: pixelated;\n    image-rendering: crisp-edges;\n}\n\n#ui-overlay {\n    position: fixed;\n    top: 0; left: 0; width: 100%; height: 100%;\n    pointer-events: none;\n    display: flex;\n    flex-direction: column;\n    justify-content: space-between;\n    padding: 1rem;\n    font-family: 'Orbitron', sans-serif;\n}\n\n/*** HUD ***/\n.hud-top {\n    display: flex;\n    justify-content: space-between;\n    align-items: flex-start;\n}\n\n.hud-timer {\n    font-size: clamp(1.2rem, 4vw, 2rem);\n    font-weight: 900;\n    color: var(--neon-cyan);\n    text-shadow: 0 0 10px var(--neon-cyan), 0 0 20px var(--neon-cyan);\n    letter-spacing: 0.1em;\n    background: var(--panel-bg);\n    padding: 0.5rem 1rem;\n    border: 2px solid var(--neon-cyan);\n    border-radius: 4px;\n    backdrop-filter: blur(4px);\n}\n\n.detection-meter-container {\n    flex: 1;\n    max-width: 300px;\n    margin: 0 1rem;\n    height: 8px;\n    background: rgba(0,0,0,0.5);\n    border: 1px solid var(--neon-cyan);\n    border-radius: 4px;\n    overflow: hidden;\n    position: relative;\n    box-shadow: inset 0 0 10px rgba(0,0,0,0.5), 0 0 10px var(--neon-cyan);\n}\n\n.detection-meter-fill {\n    height: 100%;\n    width: 0%;\n    background: linear-gradient(90deg, var(--neon-cyan), var(--neon-yellow), var(--neon-red));\n    transition: width 0.1s linear, background 0.3s;\n    border-radius: 3px;\n    box-shadow: 0 0 10px currentColor;\n}\n\n.detection-meter-container.warning .detection-meter-fill { animation: pulse-fill 0.5s infinite alternate; }\n@keyframes pulse-fill { from { box-shadow: 0 0 5px currentColor; } to { box-shadow: 0 0 20px currentColor; } }\n\n.hud-bottom {\n    display: flex;\n    justify-content: space-between;\n    align-items: flex-end;\n}\n\n.hud-stamina, .hud-echo {\n    width: 80px; height: 80px;\n    border-radius: 50%;\n    border: 3px solid var(--neon-cyan);\n    position: relative;\n    background: var(--panel-bg);\n    backdrop-filter: blur(4px);\n    box-shadow: 0 0 15px var(--neon-cyan);\n}\n\n.hud-stamina::before, .hud-echo::before {\n    content: '';\n    position: absolute;\n    top: 50%; left: 50%;\n    transform: translate(-50%, -50%);\n    font-size: 1.5rem;\n    color: var(--neon-cyan);\n    text-shadow: 0 0 5px var(--neon-cyan);\n}\n\n.hud-stamina::before { content: '⚡'; }\n.hud-echo::before { content: '🌊'; }\n\n.hud-ring {\n    position: absolute;\n    top: 3px; left: 3px; right: 3px; bottom: 3px;\n    border-radius: 50%;\n    border: 4px solid transparent;\n    border-top-color: var(--neon-cyan);\n    animation: spin 2s linear infinite;\n    opacity: 0.6;\n}\n@keyframes spin { to { transform: rotate(360deg); } }\n\n.hud-fill {\n    position: absolute;\n    bottom: 3px; left: 3px; right: 3px;\n    background: var(--neon-cyan);\n    border-radius: 0 0 50% 50%;\n    transition: height 0.1s linear;\n}\n\n.hud-echo .hud-fill { background: var(--neon-magenta); }\n.hud-echo.cooldown .hud-fill { background: #444; }\n\n/*** Menus ***/\n.menu-panel {\n    position: fixed;\n    top: 50%; left: 50%;\n    transform: translate(-50%, -50%);\n    width: 90%; max-width: 400px;\n    background: var(--panel-bg);\n    border: 2px solid var(--neon-cyan);\n    border-radius: 8px;\n    padding: 2rem;\n    text-align: center;\n    box-shadow: 0 0 30px rgba(0, 255, 255, 0.3), inset 0 0 30px rgba(0, 255, 255, 0.05);\n    backdrop-filter: blur(10px);\n    z-index: 10;\n    pointer-events: auto;\n    display: none;\n    flex-direction: column;\n    gap: 1.5rem;\n}\n\n.menu-panel.active { display: flex; }\n\n.menu-title {\n    font-family: 'Orbitron', sans-serif;\n    font-size: clamp(1.5rem, 5vw, 2.5rem);\n    font-weight: 900;\n    color: var(--neon-cyan);\n    text-shadow: 0 0 10px var(--neon-cyan);\n    letter-spacing: 0.1em;\n    text-transform: uppercase;\n}\n\n.menu-subtitle { color: var(--text-dim); font-size: 0.9rem; line-height: 1.5; }\n\n.menu-btn {\n    font-family: 'Orbitron', sans-serif;\n    font-size: 1rem;\n    font-weight: 700;\n    padding: 1rem 2rem;\n    background: transparent;\n    border: 2px solid var(--neon-cyan);\n    color: var(--neon-cyan);\n    cursor: pointer;\n    transition: all 0.2s;\n    text-transform: uppercase;\n    letter-spacing: 0.1em;\n    clip-path: polygon(10% 0, 100% 0, 100% 70%, 90% 100%, 0 100%, 0 30%);\n}\n\n.menu-btn:hover, .menu-btn:focus {\n    background: var(--neon-cyan);\n    color: var(--bg-dark);\n    box-shadow: 0 0 20px var(--neon-cyan);\n    outline: none;\n}\n\n.menu-btn:disabled { opacity: 0.4; cursor: not-allowed; }\n\n.high-score {\n    font-family: 'Orbitron', sans-serif;\n    font-size: 1.2rem;\n    color: var(--neon-yellow);\n    text-shadow: 0 0 5px var(--neon-yellow);\n}\n\n/*** Game Over / Win ***/\n.overlay-message {\n    position: fixed;\n    top: 50%; left: 50%;\n    transform: translate(-50%, -50%);\n    text-align: center;\n    z-index: 20;\n    pointer-events: none;\n    opacity: 0;\n    transition: opacity 0.5s;\n}\n\n.overlay-message.visible { opacity: 1; pointer-events: auto; }\n\n.overlay-message h1 { font-size: clamp(2rem, 8vw, 4rem); font-weight: 900; margin-bottom: 0.5rem; text-shadow: 0 0 20px currentColor; }\n.overlay-message.defeat h1 { color: var(--neon-red); }\n.overlay-message.victory h1 { color: var(--neon-cyan); }\n.overlay-message p { font-size: 1.2rem; color: var(--text-dim); margin-bottom: 2rem; }\n\n/*** Responsive ***/\n@media (max-width: 600px) {\n    #ui-overlay { padding: 0.5rem; }\n    .hud-stamina, .hud-echo { width: 60px; height: 60px; }\n    .detection-meter-container { max-width: 150px; }\n}",
  "src/main.js": "import { Game } from './core/Game.js';\nimport { Input } from './core/Input.js';\nimport { Audio } from './core/Audio.js';\nimport { Assets } from './core/Assets.js';\nimport { Menu } from './ui/Menu.js';\n\nconst canvas = document.getElementById('game-canvas');\nconst uiOverlay = document.getElementById('ui-overlay');\n\n// High DPI support\nfunction resizeCanvas() {\n    const dpr = window.devicePixelRatio || 1;\n    const rect = canvas.getBoundingClientRect();\n    canvas.width = rect.width * dpr;\n    canvas.height = rect.height * dpr;\n    canvas.style.width = rect.width + 'px';\n    canvas.style.height = rect.height + 'px';\n}\nwindow.addEventListener('resize', resizeCanvas);\nresizeCanvas();\n\nasync function init() {\n    const audio = new Audio();\n    await audio.init();\n    \n    const assets = new Assets();\n    await assets.load();\n    \n    const input = new Input();\n    \n    const game = new Game(canvas, uiOverlay, input, audio, assets);\n    \n    const menu = new Menu(uiOverlay, game);\n    game.setMenu(menu);\n    \n    game.start();\n}\n\ninit().catch(console.error);",
  "src/core/Game.js": "export class Game {\n    constructor(canvas, uiOverlay, input, audio, assets) {\n        this.canvas = canvas;\n        this.ctx = canvas.getContext('2d');\n        this.uiOverlay = uiOverlay;\n        this.input = input;\n        this.audio = audio;\n        this.assets = assets;\n        \n        this.width = canvas.width;\n        this.height = canvas.height;\n        \n        this.running = false;\n        this.lastTime = 0;\n        \n        // Game State\n        this.state = 'menu'; // menu, playing, paused, gameover, victory\n        this.score = 0;\n        this.highScore = parseInt(localStorage.getItem('phantomHideHighScore')) || 0;\n        \n        // Entities & Systems\n        this.player = null;\n        this.seeker = null;\n        this.hidingSpots = [];\n        this.echoPulses = [];\n        this.particles = [];\n        \n        // Map\n        this.walls = [];\n        this.mapWidth = 2000;\n        this.mapHeight = 2000;\n        \n        // Timer\n        this.survivalTime = 0;\n        this.targetTime = 180; // 3 minutes\n        \n        // Camera\n        this.camera = { x: 0, y: 0 };\n        \n        // Detection Meter\n        this.detectionLevel = 0; // 0-1\n        \n        // Bind methods\n        this.loop = this.loop.bind(this);\n        this.handleResize = this.handleResize.bind(this);\n    }\n\n    setMenu(menu) { this.menu = menu; }\n\n    start() {\n        this.running = true;\n        this.lastTime = performance.now();\n        this.initLevel();\n        this.menu.showMain();\n        requestAnimationFrame(this.loop);\n    }\n\n    initLevel() {\n        // Generate Map\n        this.generateMap();\n        \n        // Player\n        this.player = {\n            x: this.mapWidth / 2,\n            y: this.mapHeight / 2,\n            vx: 0, vy: 0,\n            radius: 16,\n            speed: 180,\n            sprintSpeed: 280,\n            accel: 800,\n            friction: 0.85,\n            stamina: 100,\n            maxStamina: 100,\n            staminaRegen: 15,\n            staminaDrain: 40,\n            hiding: false,\n            hideCooldown: 0,\n            echoCooldown: 0,\n            echoMaxCooldown: 3,\n            breathHeld: false\n        };\n        \n        // Seeker\n        this.seeker = {\n            x: Math.random() * this.mapWidth,\n            y: Math.random() * this.mapHeight,\n            vx: 0, vy: 0,\n            radius: 18,\n            state: 'patrol',\n            speed: { patrol: 60, investigate: 100, chase: 220 },\n            target: { x: 0, y: 0 },\n            path: [],\n            pathIndex: 0,\n            lastKnownNoise: null,\n            revealTimer: 0,\n            revealDuration: 1.5,\n            visible: false,\n            glitchOffset: { x: 0, y: 0 },\n            detectionRange: 300,\n            visionRange: 400,\n            visionAngle: Math.PI / 3\n        };\n        this.pickNewPatrolTarget();\n        \n        // Hiding Spots\n        this.hidingSpots = [];\n        for (let i = 0; i < 8; i++) {\n            this.hidingSpots.push({\n                x: 200 + Math.random() * (this.mapWidth - 400),\n                y: 200 + Math.random() * (this.mapHeight - 400),\n                radius: 40,\n                type: ['locker', 'crate', 'curtain'][Math.floor(Math.random() * 3)],\n                occupied: false\n            });\n        }\n        \n        // Reset\n        this.echoPulses = [];\n        this.particles = [];\n        this.survivalTime = 0;\n        this.detectionLevel = 0;\n        this.camera.x = this.player.x - this.width / 2;\n        this.camera.y = this.player.y - this.height / 2;\n    }\n\n    generateMap() {\n        this.walls = [];\n        // Border walls\n        const thickness = 50;\n        this.walls.push({ x: -thickness, y: -thickness, w: this.mapWidth + thickness*2, h: thickness }); // Top\n        this.walls.push({ x: -thickness, y: this.mapHeight, w: this.mapWidth + thickness*2, h: thickness }); // Bottom\n        this.walls.push({ x: -thickness, y: -thickness, w: thickness, h: this.mapHeight + thickness*2 }); // Left\n        this.walls.push({ x: this.mapWidth, y: -thickness, w: thickness, h: this.mapHeight + thickness*2 }); // Right\n        \n        // Internal maze-like walls\n        for (let i = 0; i < 30; i++) {\n            const horizontal = Math.random() < 0.5;\n            const len = 200 + Math.random() * 300;\n            const thick = 30;\n            if (horizontal) {\n                this.walls.push({ x: Math.random() * (this.mapWidth - len), y: Math.random() * this.mapHeight, w: len, h: thick });\n            } else {\n                this.walls.push({ x: Math.random() * this.mapWidth, y: Math.random() * (this.mapHeight - len), w: thick, h: len });\n            }\n        }\n    }\n\n    pickNewPatrolTarget() {\n        const margin = 200;\n        this.seeker.target.x = margin + Math.random() * (this.mapWidth - margin * 2);\n        this.seeker.target.y = margin + Math.random() * (this.mapHeight - margin * 2);\n        this.seeker.path = this.findPath(this.seeker.x, this.seeker.y, this.seeker.target.x, this.seeker.target.y);\n        this.seeker.pathIndex = 0;\n    }\n\n    findPath(sx, sy, tx, ty) {\n        // Simplified A* - returns direct path if no obstacles, else waypoints\n        // For performance, we'll use a simple raycast check and if blocked, go around via corners\n        // This is a placeholder for a full A* implementation\n        const path = [];\n        // Check line of sight\n        if (!this.lineOfSight(sx, sy, tx, ty)) {\n            // Find a waypoint around a random wall\n            const wall = this.walls[Math.floor(Math.random() * this.walls.length)];\n            const corners = [\n                { x: wall.x - 20, y: wall.y - 20 },\n                { x: wall.x + wall.w + 20, y: wall.y - 20 },\n                { x: wall.x - 20, y: wall.y + wall.h + 20 },\n                { x: wall.x + wall.w + 20, y: wall.y + wall.h + 20 }\n            ];\n            const best = corners.reduce((prev, curr) => \n                (Math.hypot(curr.x - sx, curr.y - sy) + Math.hypot(tx - curr.x, ty - curr.y)) <\n                (Math.hypot(prev.x - sx, prev.y - sy) + Math.hypot(tx - prev.x, ty - prev.y)) ? curr : prev\n            );\n            path.push(best);\n        }\n        path.push({ x: tx, y: ty });\n        return path;\n    }\n\n    lineOfSight(x1, y1, x2, y2) {\n        // Simple raycast against walls\n        for (const wall of this.walls) {\n            if (this.lineRectIntersect(x1, y1, x2, y2, wall.x, wall.y, wall.w, wall.h)) {\n                return false;\n            }\n        }\n        return true;\n    }\n\n    lineRectIntersect(x1, y1, x2, y2, rx, ry, rw, rh) {\n        // Check if line intersects rectangle\n        const left = rx, right = rx + rw, top = ry, bottom = ry + rh;\n        if ((x1 < left && x2 < left) || (x1 > right && x2 > right) || (y1 < top && y2 < top) || (y1 > bottom && y2 > bottom)) return false;\n        // Check intersection with each edge\n        const edges = [\n            [left, top, right, top],\n            [right, top, right, bottom],\n            [right, bottom, left, bottom],\n            [left, bottom, left, top]\n        ];\n        for (const [ex1, ey1, ex2, ey2] of edges) {\n            if (this.linesIntersect(x1, y1, x2, y2, ex1, ey1, ex2, ey2)) return true;\n        }\n        return false;\n    }\n\n    linesIntersect(x1, y1, x2, y2, x3, y3, x4, y4) {\n        const denom = (x1 - x2) * (y3 - y4) - (y1 - y2) * (x3 - x4);\n        if (denom === 0) return false;\n        const t = ((x1 - x3) * (y3 - y4) - (y1 - y3) * (x3 - x4)) / denom;\n        const u = -((x1 - x2) * (y1 - y3) - (y1 - y2) * (x1 - x3)) / denom;\n        return t >= 0 && t <= 1 && u >= 0 && u <= 1;\n    }\n\n    loop(timestamp) {\n        if (!this.running) return;\n        \n        const dt = Math.min((timestamp - this.lastTime) / 1000, 0.1); // cap dt\n        this.lastTime = timestamp;\n        \n        this.update(dt);\n        this.render();\n        \n        requestAnimationFrame(this.loop);\n    }\n\n    update(dt) {\n        if (this.state !== 'playing') return;\n        \n        this.survivalTime += dt;\n        \n        // Input\n        this.handleInput(dt);\n        \n        // Update Player Physics\n        this.updatePlayer(dt);\n        \n        // Update Seeker AI\n        this.updateSeeker(dt);\n        \n        // Update Echo Pulses\n        this.updateEchoPulses(dt);\n        \n        // Update Particles\n        this.updateParticles(dt);\n        \n        // Check Collisions\n        this.checkCollisions();\n        \n        // Update Camera\n        this.updateCamera();\n        \n        // Update Detection Meter\n        this.updateDetectionMeter();\n        \n        // Win Condition\n        if (this.survivalTime >= this.targetTime) {\n            this.victory();\n        }\n    }\n\n    handleInput(dt) {\n        const p = this.player;\n        \n        // Movement\n        let ax = 0, ay = 0;\n        if (this.input.keys['w'] || this.input.keys['arrowup']) ay -= 1;\n        if (this.input.keys['s'] || this.input.keys['arrowdown']) ay += 1;\n        if (this.input.keys['a'] || this.input.keys['arrowleft']) ax -= 1;\n        if (this.input.keys['d'] || this.input.keys['arrowright']) ax += 1;\n        \n        // Gamepad\n        if (this.input.gamepad) {\n            const gp = this.input.gamepad;\n            ax += gp.axes[0];\n            ay += gp.axes[1];\n        }\n        \n        const moving = Math.abs(ax) > 0.1 || Math.abs(ay) > 0.1;\n        \n        // Sprint\n        const sprintPressed = this.input.keys['shift'] || (this.input.gamepad && this.input.gamepad.buttons[7].pressed); // R2/Right Trigger\n        const canSprint = p.stamina > 0 && moving;\n        const sprinting = sprintPressed && canSprint && !p.hiding;\n        \n        // Breath holding (reduce noise)\n        p.breathHeld = this.input.keys[' '] || (this.input.gamepad && this.input.gamepad.buttons[0].pressed); // Space / A\n        \n        const targetSpeed = sprinting ? p.sprintSpeed : p.speed;\n        if (moving) {\n            const len = Math.hypot(ax, ay);\n            ax = (ax / len) * p.accel;\n            ay = (ay / len) * p.accel;\n        }\n        \n        p.vx += ax * dt;\n        p.vy += ay * dt;\n        \n        // Clamp speed\n        const speed = Math.hypot(p.vx, p.vy);\n        if (speed > targetSpeed) {\n            p.vx = (p.vx / speed) * targetSpeed;\n            p.vy = (p.vy / speed) * targetSpeed;\n        }\n        \n        // Stamina\n        if (sprinting) {\n            p.stamina = Math.max(0, p.stamina - p.staminaDrain * dt);\n        } else if (!p.breathHeld) {\n            p.stamina = Math.min(p.maxStamina, p.stamina + p.staminaRegen * dt);\n        }\n        \n        // Echo Pulse\n        p.echoCooldown = Math.max(0, p.echoCooldown - dt);\n        const pulsePressed = this.input.keys['e'] || (this.input.gamepad && this.input.gamepad.buttons[2].pressed); // E / X\n        if (pulsePressed && p.echoCooldown <= 0 && !p.hiding) {\n            this.emitEchoPulse();\n            p.echoCooldown = p.echoMaxCooldown;\n        }\n        \n        // Hiding\n        p.hideCooldown = Math.max(0, p.hideCooldown - dt);\n        const hidePressed = this.input.keys['f'] || (this.input.gamepad && this.input.gamepad.buttons[1].pressed); // F / B\n        if (hidePressed && p.hideCooldown <= 0) {\n            this.toggleHide();\n            p.hideCooldown = 0.5;\n        }\n        \n        // Pause\n        if (this.input.keysJustPressed['escape'] || (this.input.gamepad && this.input.gamepad.buttons[9].pressed)) {\n            this.togglePause();\n        }\n    }\n\n    updatePlayer(dt) {\n        const p = this.player;\n        \n        // Apply velocity with collision\n        let nx = p.x + p.vx * dt;\n        let ny = p.y + p.vy * dt;\n        \n        // X axis\n        let hitX = false;\n        for (const wall of this.walls) {\n            if (this.circleRectCollide(nx, p.y, p.radius, wall)) {\n                hitX = true;\n                // Slide\n                if (p.vx > 0) nx = wall.x - p.radius;\n                else nx = wall.x + wall.w + p.radius;\n                p.vx = 0;\n                break;\n            }\n        }\n        if (!hitX) p.x = nx;\n        \n        // Y axis\n        let hitY = false;\n        for (const wall of this.walls) {\n            if (this.circleRectCollide(p.x, ny, p.radius, wall)) {\n                hitY = true;\n                if (p.vy > 0) ny = wall.y - p.radius;\n                else ny = wall.y + wall.h + p.radius;\n                p.vy = 0;\n                break;\n            }\n        }\n        if (!hitY) p.y = ny;\n        \n        // Friction\n        if (!hitX) p.vx *= p.friction;\n        if (!hitY) p.vy *= p.friction;\n        if (Math.abs(p.vx) < 1) p.vx = 0;\n        if (Math.abs(p.vy) < 1) p.vy = 0;\n        \n        // Clamp to map bounds\n        p.x = Math.max(p.radius, Math.min(this.mapWidth - p.radius, p.x));\n        p.y = Math.max(p.radius, Math.min(this.mapHeight - p.radius, p.y));\n    }\n\n    circleRectCollide(cx, cy, radius, rect) {\n        const closestX = Math.max(rect.x, Math.min(cx, rect.x + rect.w));\n        const closestY = Math.max(rect.y, Math.min(cy, rect.y + rect.h));\n        const dx = cx - closestX;\n        const dy = cy - closestY;\n        return (dx * dx + dy * dy) < (radius * radius);\n    }\n\n    updateSeeker(dt) {\n        const s = this.seeker;\n        const p = this.player;\n        \n        // Reveal timer\n        if (s.revealTimer > 0) {\n            s.revealTimer -= dt;\n            s.visible = true;\n            s.glitchOffset.x = (Math.random() - 0.5) * 10;\n            s.glitchOffset.y = (Math.random() - 0.5) * 10;\n        } else {\n            s.visible = false;\n            s.glitchOffset = { x: 0, y: 0 };\n        }\n        \n        // Noise detection\n        let noiseDetected = false;\n        let noiseX = 0, noiseY = 0;\n        \n        // Player noise radius\n        let noiseRadius = 0;\n        const speed = Math.hypot(p.vx, p.vy);\n        if (speed > p.speed * 0.8) noiseRadius = 300; // Sprinting\n        else if (speed > 10) noiseRadius = 100; // Walking\n        \n        if (noiseRadius > 0 && !p.breathHeld) {\n            const dist = Math.hypot(p.x - s.x, p.y - s.y);\n            if (dist < noiseRadius + s.detectionRange) {\n                noiseDetected = true;\n                noiseX = p.x; noiseY = p.y;\n            }\n        }\n        \n        // Echo pulse noise\n        for (const pulsefor (const pulse of this.echoPulses) {\n            const dist = Math.hypot(pulse.x - s.x, pulse.y - s.y);\n            if (dist < pulse.radius + s.detectionRange) {\n                noiseDetected = true;\n                noiseX = pulse.x; noiseY = pulse.y;\n            }\n        }\n        \n        // State Machine\n        switch (s.state) {\n            case 'patrol':\n                if (noiseDetected) {\n                    s.state = 'investigate';\n                    s.lastKnownNoise = { x: noiseX, y: noiseY };\n                    s.path = this.findPath(s.x, s.y, noiseX, noiseY);\n                    s.pathIndex = 0;\n                } else {\n                    // Follow patrol path\n                    if (s.path.length > 0 && s.pathIndex < s.path.length) {\n                        const target = s.path[s.pathIndex];\n                        const dx = target.x - s.x;\n                        const dy = target.y - s.y;\n                        const dist = Math.hypot(dx, dy);\n                        if (dist < 20) {\n                            s.pathIndex++;\n                        } else {\n                            s.vx = (dx / dist) * s.speed.patrol;\n                            s.vy = (dy / dist) * s.speed.patrol;\n                        }\n                    } else {\n                        this.pickNewPatrolTarget();\n                    }\n                }\n                break;\n            \n            case 'investigate':\n                if (s.lastKnownNoise) {\n                    const dx = s.lastKnownNoise.x - s.x;\n                    const dy = s.lastKnownNoise.y - s.y;\n                    const dist = Math.hypot(dx, dy);\n                    if (dist < 30) {\n                        // Arrived at noise location, search\n                        s.state = 'search';\n                        s.target = { x: s.x, y: s.y };\n                        s.searchTimer = 3;\n                    } else {\n                        s.vx = (dx / dist) * s.speed.investigate;\n                        s.vy = (dy / dist) * s.speed.investigate;\n                    }\n                } else {\n                    s.state = 'patrol';\n                }\n                break;\n            \n            case 'search':\n                s.searchTimer -= dt;\n                // Random micro movements\n                s.vx += (Math.random() - 0.5) * 200 * dt;\n                s.vy += (Math.random() - 0.5) * 200 * dt;\n                const searchSpeed = Math.hypot(s.vx, s.vy);\n                if (searchSpeed > s.speed.investigate) {\n                    s.vx = (s.vx / searchSpeed) * s.speed.investigate;\n                    s.vy = (s.vy / searchSpeed) * s.speed.investigate;\n                }\n                \n                // Check if player visible during search\n                if (this.canSeePlayer()) {\n                    s.state = 'chase';\n                    s.revealTimer = s.revealDuration;\n                } else if (s.searchTimer <= 0) {\n                    s.state = 'patrol';\n                }\n                break;\n            \n            case 'chase':\n                if (this.canSeePlayer()) {\n                    s.lastKnownNoise = { x: p.x, y: p.y };\n                    s.revealTimer = s.revealDuration;\n                }\n                \n                if (s.lastKnownNoise) {\n                    const dx = s.lastKnownNoise.x - s.x;\n                    const dy = s.lastKnownNoise.y - s.y;\n                    const dist = Math.hypot(dx, dy);\n                    if (dist > 50) {\n                        s.vx = (dx / dist) * s.speed.chase;\n                        s.vy = (dy / dist) * s.speed.chase;\n                    } else {\n                        s.state = 'search';\n                        s.searchTimer = 2;\n                    }\n                } else {\n                    s.state = 'patrol';\n                }\n                break;\n        }\n        \n        // Apply velocity with collision\n        let nsx = s.x + s.vx * dt;\n        let nsy = s.y + s.vy * dt;\n        \n        for (const wall of this.walls) {\n            if (this.circleRectCollide(nsx, s.y, s.radius, wall)) {\n                if (s.vx > 0) nsx = wall.x - s.radius;\n                else nsx = wall.x + wall.w + s.radius;\n                s.vx = 0;\n                break;\n            }\n        }\n        for (const wall of this.walls) {\n            if (this.circleRectCollide(s.x, nsy, s.radius, wall)) {\n                if (s.vy > 0) nsy = wall.y - s.radius;\n                else nsy = wall.y + wall.h + s.radius;\n                s.vy = 0;\n                break;\n            }\n        }\n        s.x = nsx;\n        s.y = nsy;\n        \n        // Clamp to map\n        s.x = Math.max(s.radius, Math.min(this.mapWidth - s.radius, s.x));\n        s.y = Math.max(s.radius, Math.min(this.mapHeight - s.radius, s.y));\n    }\n\n    canSeePlayer() {\n        const p = this.player;\n        const s = this.seeker;\n        if (p.hiding) return false;\n        \n        const dx = p.x - s.x;\n        const dy = p.y - s.y;\n        const dist = Math.hypot(dx, dy);\n        \n        if (dist > s.visionRange) return false;\n        \n        const angle = Math.atan2(dy, dx);\n        const seekerAngle = Math.atan2(s.vy, s.vx) || 0;\n        let diff = Math.abs(angle - seekerAngle);\n        if (diff > Math.PI) diff = Math.PI * 2 - diff;\n        if (diff > s.visionAngle / 2) return false;\n        \n        // Line of sight check\n        return this.lineOfSight(s.x, s.y, p.x, p.y);\n    }\n\n    updateEchoPulses(dt) {\n        for (let i = this.echoPulses.length - 1; i >= 0; i--) {\n            const pulse = this.echoPulses[i];\n            pulse.life -= dt;\n            pulse.radius += pulse.speed * dt;\n            pulse.alpha = pulse.life / pulse.maxLife;\n            if (pulse.life <= 0) {\n                this.echoPulses.splice(i, 1);\n            }\n        }\n    }\n\n    emitEchoPulse() {\n        const p = this.player;\n        this.echoPulses.push({\n            x: p.x,\n            y: p.y,\n            radius: 0,\n            maxRadius: 500,\n            speed: 400,\n            life: 1.25,\n            maxLife: 1.25,\n            alpha: 1\n        });\n        this.audio.play('echo');\n        this.spawnParticles(p.x, p.y, 12, '#ff00ff', 2, 0.5);\n    }\n\n    updateParticles(dt) {\n        for (let i = this.particles.length - 1; i >= 0; i--) {\n            const pt = this.particles[i];\n            pt.x += pt.vx * dt;\n            pt.y += pt.vy * dt;\n            pt.life -= dt;\n            pt.alpha = pt.life / pt.maxLife;\n            pt.size *= 0.98;\n            if (pt.life <= 0) this.particles.splice(i, 1);\n        }\n    }\n\n    spawnParticles(x, y, count, color, speed, life) {\n        for (let i = 0; i < count; i++) {\n            const angle = Math.random() * Math.PI * 2;\n            const spd = speed * (0.5 + Math.random() * 0.5);\n            this.particles.push({\n                x, y,\n                vx: Math.cos(angle) * spd,\n                vy: Math.sin(angle) * spd,\n                size: 3 + Math.random() * 4,\n                color,\n                life: life * (0.5 + Math.random() * 0.5),\n                maxLife: life,\n                alpha: 1\n            });\n        }\n    }\n\n    checkCollisions() {\n        const p = this.player;\n        const s = this.seeker;\n        \n        // Seeker catches player\n        if (s.visible && s.state === 'chase') {\n            const dist = Math.hypot(p.x - s.x, p.y - s.y);\n            if (dist < p.radius + s.radius) {\n                this.gameOver();\n                return;\n            }\n        }\n        \n        // Hiding spots\n        for (const spot of this.hidingSpots) {\n            const dist = Math.hypot(p.x - spot.x, p.y - spot.y);\n            if (dist < p.radius + spot.radius) {\n                spot.nearby = true;\n            } else {\n                spot.nearby = false;\n            }\n        }\n    }\n\n    toggleHide() {\n        const p = this.player;\n        for (const spot of this.hidingSpots) {\n            const dist = Math.hypot(p.x - spot.x, p.y - spot.y);\n            if (dist < p.radius + spot.radius) {\n                p.hiding = !p.hiding;\n                if (p.hiding) {\n                    p.vx = 0; p.vy = 0;\n                    this.audio.play('hide');\n                } else {\n                    this.audio.play('unhide');\n                }\n                return;\n            }\n        }\n    }\n\n    updateCamera() {\n        const p = this.player;\n        this.camera.x = p.x - this.width / 2;\n        this.camera.y = p.y - this.height / 2;\n        \n        // Clamp camera to map bounds\n        this.camera.x = Math.max(0, Math.min(this.mapWidth - this.width, this.camera.x));\n        this.camera.y = Math.max(0, Math.min(this.mapHeight - this.height, this.camera.y));\n    }\n\n    updateDetectionMeter() {\n        const p = this.player;\n        const s = this.seeker;\n        \n        let level = 0;\n        \n        if (s.visible) {\n            const dist = Math.hypot(p.x - s.x, p.y - s.y);\n            level = Math.max(level, 1 - dist / 500);\n        }\n        \n        if (s.state === 'chase') level = Math.max(level, 0.7);\n        else if (s.state === 'investigate') level = Math.max(level, 0.4);\n        else if (s.state === 'search') level = Math.max(level, 0.5);\n        \n        // Noise contribution\n        const speed = Math.hypot(p.vx, p.vy);\n        if (speed > p.speed * 0.8 && !p.breathHeld) level = Math.max(level, 0.6);\n        else if (speed > 10 && !p.breathHeld) level = Math.max(level, 0.2);\n        \n        this.detectionLevel = this.detectionLevel * 0.9 + level * 0.1;\n    }\n\n    togglePause() {\n        if (this.state === 'playing') {\n            this.state = 'paused';\n            this.menu.showPause();\n        } else if (this.state === 'paused') {\n            this.state = 'playing';\n            this.menu.hide();\n        }\n    }\n\n    gameOver() {\n        this.state = 'gameover';\n        this.audio.play('gameover');\n        this.menu.showGameOver(this.survivalTime);\n        \n        if (this.survivalTime > this.highScore) {\n            this.highScore = Math.floor(this.survivalTime);\n            localStorage.setItem('phantomHideHighScore', this.highScore);\n        }\n    }\n\n    victory() {\n        this.state = 'victory';\n        this.audio.play('victory');\n        this.menu.showVictory(this.survivalTime);\n        \n        if (this.survivalTime > this.highScore) {\n            this.highScore = Math.floor(this.survivalTime);\n            localStorage.setItem('phantomHideHighScore', this.highScore);\n        }\n    }\n\n    restart() {\n        this.initLevel();\n        this.state = 'playing';\n        this.menu.hide();\n    }\n\n    handleResize() {\n        resizeCanvas();\n        this.width = this.canvas.width;\n        this.height = this.canvas.height;\n    }\n\n    render() {\n        const ctx = this.ctx;\n        const cam = this.camera;\n        \n        // Clear\n        ctx.fillStyle = '#0a0a12';\n        ctx.fillRect(0, 0, this.width, this.height);\n        \n        ctx.save();\n        ctx.translate(-cam.x, -cam.y);\n        \n        // Draw grid background\n        this.drawGrid(ctx);\n        \n        // Draw walls\n        this.drawWalls(ctx);\n        \n        // Draw hiding spots\n        this.drawHidingSpots(ctx);\n        \n        // Draw echo pulses\n        this.drawEchoPulses(ctx);\n        \n        // Draw particles\n        this.drawParticles(ctx);\n        \n        // Draw seeker\n        this.drawSeeker(ctx);\n        \n        // Draw player\n        this.drawPlayer(ctx);\n        \n        ctx.restore();\n        \n        // Draw UI (HUD) - rendered in screen space\n        this.renderHUD(ctx);\n    }\n\n    drawGrid(ctx) {\n        const cam = this.camera;\n        const gridSize = 100;\n        const startX = Math.floor(cam.x / gridSize) * gridSize;\n        const startY = Math.floor(cam.y / gridSize) * gridSize;\n        const endX = startX + this.width + gridSize;\n        const endY = startY + this.height + gridSize;\n        \n        ctx.strokeStyle = 'rgba(0, 255, 255, 0.03)';\n        ctx.lineWidth = 1;\n        \n        for (let x = startX; x <= endX; x += gridSize) {\n            ctx.beginPath();\n            ctx.moveTo(x, cam.y);\n            ctx.lineTo(x, cam.y + this.height);\n            ctx.stroke();\n        }\n        for (let y = startY; y <= endY; y += gridSize) {\n            ctx.beginPath();\n            ctx.moveTo(cam.x, y);\n            ctx.lineTo(cam.x + this.width, y);\n            ctx.stroke();\n        }\n    }\n\n    drawWalls(ctx) {\n        ctx.fillStyle = '#1a1a2e';\n        ctx.strokeStyle = '#00ffff';\n        ctx.lineWidth = 2;\n        ctx.shadowColor = '#00ffff';\n        ctx.shadowBlur = 10;\n        \n        for (const wall of this.walls) {\n            ctx.beginPath();\n            ctx.rect(wall.x, wall.y, wall.w, wall.h);\n            ctx.fill();\n            ctx.stroke();\n        }\n        ctx.shadowBlur = 0;\n    }\n\n    drawHidingSpots(ctx) {\n        for (const spot of this.hidingSpots) {\n            const nearby = spot.nearby;\n            \n            ctx.save();\n            ctx.translate(spot.x, spot.y);\n            \n            // Outer glow\n            const gradient = ctx.createRadialGradient(0, 0, 0, 0, 0, spot.radius);\n            gradient.addColorStop(0, nearby ? 'rgba(0, 255, 255, 0.3)' : 'rgba(0, 255, 255, 0.1)');\n            gradient.addColorStop(1, 'rgba(0, 255, 255, 0)');\n            ctx.fillStyle = gradient;\n            ctx.beginPath();\n            ctx.arc(0, 0, spot.radius, 0, Math.PI * 2);\n            ctx.fill();\n            \n            // Spot shape based on type\n            ctx.strokeStyle = nearby ? '#00ffff' : '#008888';\n            ctx.lineWidth = nearby ? 3 : 2;\n            ctx.shadowColor = '#00ffff';\n            ctx.shadowBlur = nearby ? 15 : 5;\n            \n            switch (spot.type) {\n                case 'locker':\n                    ctx.beginPath();\n                    ctx.rect(-spot.radius * 0.6, -spot.radius, spot.radius * 1.2, spot.radius * 2);\n                    ctx.stroke();\n                    // Door line\n                    ctx.beginPath();\n                    ctx.moveTo(-spot.radius * 0.6, 0);\n                    ctx.lineTo(spot.radius * 0.6, 0);\n                    ctx.stroke();\n                    break;\n                case 'crate':\n                    ctx.beginPath();\n                    ctx.rect(-spot.radius * 0.7, -spot.radius * 0.7, spot.radius * 1.4, spot.radius * 1.4);\n                    ctx.stroke();\n                    // Cross\n                    ctx.beginPath();\n                    ctx.moveTo(-spot.radius * 0.7, 0);\n                    ctx.lineTo(spot.radius * 0.7, 0);\n                    ctx.moveTo(0, -spot.radius * 0.7);\n                    ctx.lineTo(0, spot.radius * 0.7);\n                    ctx.stroke();\n                    break;\n                case 'curtain':\n                    ctx.beginPath();\n                    ctx.moveTo(-spot.radius, -spot.radius);\n                    ctx.lineTo(spot.radius, -spot.radius);\n                    for (let i = -spot.radius; i <= spot.radius; i += 8) {\n                        ctx.moveTo(i, -spot.radius);\n                        ctx.lineTo(i + 5, spot.radius);\n                    }\n                    ctx.stroke();\n                    break;\n            }\n            ctx.restore();\n        }\n    }\n\n    drawEchoPulses(ctx) {\n        for (const pulse of this.echoPulses) {\n            ctx.save();\n            ctx.globalAlpha = pulse.alpha;\n            ctx.strokeStyle = '#ff00ff';\n            ctx.lineWidth = 3;\n            ctx.shadowColor = '#ff00ff';\n            ctx.shadowBlur = 20;\n            ctx.beginPath();\n            ctx.arc(pulse.x, pulse.y, pulse.radius, 0, Math.PI * 2);\n            ctx.stroke();\n            \n            // Inner ring\n            ctx.globalAlpha = pulse.alpha * 0.5;\n            ctx.lineWidth = 1;\n            ctx.beginPath();\n            ctx.arc(pulse.x, pulse.y, pulse.radius * 0.8, 0, Math.PI * 2);\n            ctx.stroke();\n            ctx.restore();\n        }\n    }\n\n    drawParticles(ctx) {\n        for (const pt of this.particles) {\n            ctx.save();\n            ctx.globalAlpha = pt.alpha;\n            ctx.fillStyle = pt.color;\n            ctx.shadowColor = pt.color;\n            ctx.shadowBlur = 10;\n            ctx.beginPath();\n            ctx.arc(pt.x, pt.y, pt.size, 0, Math.PI * 2);\n            ctx.fill();\n            ctx.restore();\n        }\n    }\n\n    drawSeeker(ctx) {\n        const s = this.seeker;\n        if (!s.visible) return;\n        \n        ctx.save();\n        ctx.translate(s.x + s.glitchOffset.x, s.y + s.glitchOffset.y);\n        \n        // Vision cone\n        if (s.state === 'chase' || s.state === 'search') {\n            ctx.save();\n            const angle = Math.atan2(s.vy, s.vx) || 0;\n            ctx.rotate(angle);\n            const gradient = ctx.createRadialGradient(0, 0, 0, 0, 0, s.visionRange);\n            gradient.addColorStop(0, 'rgba(255, 0, 0, 0.15)');\n            gradient.addColorStop(1, 'rgba(255, 0, 0, 0)');\n            ctx.fillStyle = gradient;\n            ctx.beginPath();\n            ctx.moveTo(0, 0);\n            ctx.arc(0, 0, s.visionRange, -s.visionAngle / 2, s.visionAngle / 2);\n            ctx.closePath();\n            ctx.fill();\n            ctx.restore();\n        }\n        \n        // Detection range ring\n        ctx.strokeStyle = 'rgba(255, 51, 51, 0.3)';\n        ctx.lineWidth = 1;\n        ctx.setLineDash([10, 5]);\n        ctx.beginPath();\n        ctx.arc(0, 0, s.detectionRange, 0, Math.PI * 2);\n        ctx.stroke();\n        ctx.setLineDash([]);\n        \n        // Seeker body - glitchy triangle\n        ctx.fillStyle = '#ff3333';\n        ctx.shadowColor = '#ff3333';\n        ctx.shadowBlur = 20;\n        ctx.beginPath();\n        ctx.moveTo(0, -s.radius);\n        ctx.lineTo(s.radius * 0.9, s.radius * 0.5);\n        ctx.lineTo(-s.radius * 0.9, s.radius * 0.5);\n        ctx.closePath();\n        ctx.fill();\n        \n        // Core\n        ctx.fillStyle = '#fff';\n        ctx.shadowBlur = 10;\n        ctx.beginPath();\n        ctx.arc(0, 0, 6, 0, Math.PI * 2);\n        ctx.fill();\n        \n        // Glitch effect\n        if (Math.random() < 0.1) {\n            ctx.fillStyle = 'rgba(255, 255, 255, 0.5)';\n            ctx.fillRect(-s.radius, -s.radius, s.radius * 2, Math.random() * 4);\n        }\n        \n        ctx.restore();\n    }\n\n    drawPlayer(ctx) {\n        const p = this.player;\n        \n        ctx.save();\n        ctx.translate(p.x, p.y);\n        \n        // Stamina ring\n        if (!p.hiding) {\n            ctx.strokeStyle = `rgba(0, 255, 255, ${p.stamina / 100})`;\n            ctx.lineWidth = 2;\n            ctx.shadowColor = '#00ffff';\n            ctx.shadowBlur = 10;\n            ctx.beginPath();\n            ctx.arc(0, 0, p.radius + 8, -Math.PI / 2, -Math.PI / 2 + (p.stamina / 100) * Math.PI * 2);\n            ctx.stroke();\n        }\n        \n        // Hiding indicator\n        if (p.hiding) {\n            ctx.fillStyle = 'rgba(0, 255, 255, 0.3)';\n            ctx.shadowColor = '#00ffff';\n            ctx.shadowBlur = 20;\n            ctx.beginPath();\n            ctx.arc(0, 0, p.radius + 10, 0, Math.PI * 2);\n            ctx.fill();\n            \n            ctx.fillStyle = '#00ffff';\n            ctx.font = '20px Arial';\n            ctx.textAlign = 'center';\n            ctx.textBaseline = 'middle';\n            ctx.fillText('👻', 0, 4);\n        }\n        \n        // Player body\n        const angle = Math.atan2(p.vy, p.vx) || 0;\n        ctx.rotate(angle);\n        \n        ctx.fillStyle = p.hiding ? '#00ffff' : '#00ffff';\n        ctx.shadowColor = '#00ffff';\n        ctx.shadowBlur = 15;\n        \n        ctx.beginPath();\n        ctx.moveTo(p.radius, 0);\n        ctx.lineTo(-p.radius * 0.7, p.radius * 0.7);\n        ctx.lineTo(-p.radius * 0.4, 0);\n        ctx.lineTo(-p.radius * 0.7, -p.radius * 0.7);\n        ctx.closePath();\n        ctx.fill();\n        \n        // Engine glow when moving\n        const speed = Math.hypot(p.vx, p.vy);\n        if (speed > 10) {\n            const gradient = ctx.createRadialGradient(-p.radius * 0.5, 0, 0, -p.radius * 0.5, 0, p.radius);\n            gradient.addColorStop(0, '#00ffff');\n            gradient.addColorStop(1, 'rgba(0, 255, 255, 0)');\n            ctx.fillStyle = gradient;\n            ctx.beginPath();\n            ctx.arc(-p.radius * 0.5, 0, p.radius, 0, Math.PI * 2);\n            ctx.fill();\n        }\n        \n        // Breath hold indicator\n        if (p.breathHeld && !p.hiding) {\n            ctx.fillStyle = 'rgba(255, 255, 0, 0.8)';\n            ctx.font = '16px Arial';\n            ctx.textAlign = 'center';\n            ctx.fillText('🤐', 0, -p.radius - 15);\n        }\n        \n        ctx.restore();\n    }\n\n    renderHUD(ctx) {\n        // Timer\n        const timeLeft = Math.max(0, this.targetTime - this.survivalTime);\n        const mins = Math.floor(timeLeft / 60);\n        const secs = Math.floor(timeLeft % 60);\n        const timerEl = document.getElementById('hud-timer');\n        if (timerEl) timerEl.textContent = `${mins}:${secs.toString().padStart(2, '0')}`;\n        \n        // Detection meter\n        const meterFill = document.querySelector('.detection-meter-fill');\n        const meterContainer = document.querySelector('.detection-meter-container');\n        if (meterFill) {\n            meterFill.style.width = `${this.detectionLevel * 100}%`;\n        }\n        if (meterContainer) {\n            if (this.detectionLevel > 0.7) meterContainer.classList.add('warning');\n            else meterContainer.classList.remove('warning');\n        }\n        \n        // Stamina ring\n        const staminaFill = document.querySelector('.hud-stamina .hud-fill');\n        if (staminaFill) {\n            staminaFill.style.height = `${(this.player.stamina / this.player.maxStamina) * 100}%`;\n        }\n        \n        // Echo cooldown\n        const echoFill = document.querySelector('.hud-echo .hud-fill');\n        const echoContainer = document.querySelector('.hud-echo');\n        if (echoFill && echoContainer) {\n            const p = this.player;\n            if (p.echoCooldown > 0) {\n                echoContainer.classList.add('cooldown');\n                echoFill.style.height = `${(1 - p.echoCooldown / p.echoMaxCooldown) * 100}%`;\n            } else {\n                echoContainer.classList.remove('cooldown');\n                echoFill.style.height = '100%';\n            }\n        }\n    }\n}\n\n// Global resize function reference\nfunction resizeCanvas() {\n    const canvas = document.getElementById('game-canvas');\n    const dpr = window.devicePixelRatio || 1;\n    const rect = canvas.getBoundingClientRect();\n    canvas.width = rect.width * dpr;\n    canvas.height = rect.height * dpr;\n    canvas.style.width = rect.width + 'px';\n    canvas.style.height = rect.height + 'px';\n}",
  "src/core/Input.js": "export class Input {\n    constructor() {\n        this.keys = {};\n        this.keysJustPressed = {};\n        this.keysJustReleased = {};\n        this.gamepad = null;\n        \n        this.bindEvents();\n        this.startGamepadPolling();\n    }\n\n    bindEvents() {\n        window.addEventListener('keydown', (e) => {\n            const key = e.key.toLowerCase();\n            if (!this.keys[key]) {\n                this.keysJustPressed[key] = true;\n            }\n            this.keys[key] = true;\n            \n            // Prevent default for game keys\n            if (['w','a','s','d','arrowup','arrowdown','arrowleft','arrowright',' ','shift','e','f','escape'].includes(key)) {\n                e.preventDefault();\n            }\n        });\n\n        window.addEventListener('keyup', (e) => {\n            const key = e.key.toLowerCase();\n            this.keys[key] = false;\n            this.keysJustReleased[key] = true;\n        });\n\n        // Clear just-pressed/released each frame\n        this.clearJustPressed = this.clearJustPressed.bind(this);\n    }\n\n    clearJustPressed() {\n        this.keysJustPressed = {};\n        this.keysJustReleased = {};\n    }\n\n    startGamepadPolling() {\n        window.addEventListener('gamepadconnected', (e) => {\n            console.log('Gamepad connected:', e.gamepad.id);\n            this.gamepad = e.gamepad;\n        });\n\n        window.addEventListener('gamepaddisconnected', (e) => {\n            console.log('Gamepad disconnected');\n            this.gamepad = null;\n        });\n\n        // Check for already connected gamepads\n        const gamepads = navigator.getGamepads();\n        for (const gp of gamepads) {\n            if (gp) this.gamepad = gp;\n        }\n    }\n\n    update() {\n        this.clearJustPressed();\n        \n        // Update gamepad state\n        const gamepads = navigator.getGamepads();\n        if (gamepads[0]) {\n            this.gamepad = gamepads[0];\n        } else if (this.gamepad && !gamepads[this.gamepad.index]) {\n            this.gamepad = null;\n        }\n    }\n\n    isPressed(key) {\n        return this.keys[key.toLowerCase()] === true;\n    }\n\n    wasJustPressed(key) {\n        return this.keysJustPressed[key.toLowerCase()] === true;\n    }\n\n    wasJustReleased(key) {\n        return this.keysJustReleased[key.toLowerCase()] === true;\n    }\n\n    getGamepad() {\n        return this.gamepad;\n    }\n\n    // Vibration support\n    vibrate(duration, strong = 0.5, weak = 0.3) {\n        if (this.gamepad && this.gamepad.vibrationActuator) {\n            this.gamepad.vibrationActuator.playEffect('dual-rumble', {\n                duration,\n                strongMagnitude: strong,\n                weakMagnitude: weak\n            }).catch(() => {});\n        } else if (this.gamepad && this.gamepad.hapticActuators) {\n            for (const actuator of this.gamepad.hapticActuators) {\n                actuator.pulse(strong, duration).catch(() => {});\n            }\n        }\n    }\n}",
  "src/core/Audio.js": "export class Audio {\n    constructor() {\n        this.ctx = null;\n        this.sounds = {};\n        this.masterGain = null;\n        this.musicGain = null;\n        this.sfxGain = null;\n        this.enabled = true;\n        this.musicSource = null;\n    }\n\n    async init() {\n        this.ctx = new (window.AudioContext || window.webkitAudioContext)();\n        \n        // Create gain nodes\n