Now bridge system:

let bridgePoints = 100;
const bpRegenRate = 5; // per second
let lastBridgeTime = 0;
const bridgeCooldown = 0; // no cooldown, just BP cost

const bridgeSegments = []; // each segment: {x, y, w, h, created, duration, fadeTime, cost}
function canAffordBridge(length) {
  // cost: 20 + (length-1)*10
  const cost = 20 + (length-1)*10;
  return bridgePoints >= cost;
}
function createBridge(length) {
  if (!canAffordBridge(length)) return;
  const cost = 20 + (length-1)*10;
  bridgePoints -= cost;
  const startX = player.x; // anchor at player position? maybe need to detect anchor points.
  // For simplicity, we create a horizontal bridge at player.y - player.h (ground level)
  const y = player.y - player.h;
  const w = length * 32; // each segment 32px wide
  const h = 8; // thickness
  const created = performance.now();
  const duration = 5000; // 5 seconds
  const fadeTime = 500; // fade over 0.5s
  bridgeSegments.push({x: startX, y, w, h, created, duration, fadeTime, cost});
}
function updateBridge(bridge, dt) {
  const elapsed = performance.now() - bridge.created;
  if (elapsed > bridge.duration) {
    // fade out
    const alpha = Math.max(0, 1 - (elapsed - bridge.duration) / bridge.fadeTime);
    bridge.alpha = alpha;
    if (alpha <= 0) {
      // remove
      bridgeSegments.splice(bridgeSegments.indexOf(bridge), 1);
    }
  }
}
function drawBridge(bridge) {
  ctx.save();
  ctx.globalAlpha = bridge.alpha ?? 1;
  ctx.fillStyle = 'var(--bridge)';
  ctx.fillRect(bridge.x, bridge.y, bridge.w, bridge.h);
  ctx.restore();
}

Now timer:

let startTime = performance.now();
function getElapsedTime() {
  return (performance.now() - startTime) / 1000;
}
function drawTimer() {
  ctx.fillStyle = 'var(--hud-text)';
  ctx.font = '1.2rem Arial';
  ctx.textAlign = 'center';
  ctx.fillText(`Time: ${Math.floor(getElapsedTime())}s`, canvas.width/2, 30);
}

