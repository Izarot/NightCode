0.001, audioCtx.currentTime + 0.2);\n  osc.connect(gain);\n  gain.connect(audioCtx.destination);\n  osc.start();\n  osc.stop(audioCtx.currentTime + 0.2);\n}\n\nconst bridgePoints = 100;\nconst bpRegenRate = 5;\nlet lastBridgeTime = 0;\nconst bridgeSegments = [];\n\nfunction canAffordBridge(length) {\n  const cost = 20 + (length - 1) * 10;\n  return bridgePoints >= cost;\n}\nfunction createBridge(length) {\n  if (!canAffordBridge(length)) return;\n  const cost = 20 + (length - 1) * 10;\n  bridgePoints -= cost;\n  const startX = player.x;\n  const y = player.y - player.h;\n  const w = length * 32;\n  const h = 8;\n  const created = performance.now();\n  const duration = 5000;\n  const fadeTime = 500;\n  bridgeSegments.push({x: startX, y, w, h, created, duration, fadeTime, cost});\n}\nfunction updateBridge(bridge, dt) {\n  const elapsed = performance.now() - bridge.created;\n  if (elapsed > bridge.duration) {\n    const alpha = Math.max(0, 1 - (elapsed - bridge.duration) / bridge.fadeTime);\n    bridge.alpha = alpha;\n    if (alpha <= 0) {\n      bridgeSegments.splice(bridgeSegments.indexOf(bridge), 1);\n    }\n  }\n}\nfunction drawBridge(bridge) {\n  ctx.save();\n  ctx.globalAlpha = bridge.alpha ?? 1;\n  ctx.fillStyle = 'var(--bridge)';\n  ctx.fillRect(bridge.x, bridge.y, bridge.w, bridge.h);\n  ctx.restore();\n}\n\nconst startTime = performance.now();\nfunction getElapsedTime() {\n  return (performance.now() - startTime) / 1000;\n}\nfunction drawTimer() {\n  ctx.fillStyle = 'var(--hud-text)';\n  ctx.font = '1.2rem Arial';\n  ctx.textAlign = 'center';\n  ctx.fillText(`Time: ${Math.floor(getElapsedTime())}s`, canvas.width / 2, 30);\n}\n\nconst player = {\n  x: 100,\n  y: 300,\n  w: 12,\n  h: 16,\n  vx: 0,\n  vy: 0,\n  speed: 6,\n  jumpVel: -12,\n  gravity: 0.5,\n  onGround: false,\n  crouch: false,\n  update(dt) {\n    const left = keys['a'] || keys['ArrowLeft'];\n    const right = keys['d'] || keys['ArrowRight'];\n    if (left) this.vx = this.speed;\n    else if (right) this.vx = this.speed;\n    else this.vx = 0;\n    this.vx *= this.onGround ? 0.85 : 0.5;\n    if ((keys[' '] || keys['w'] || keys['ArrowUp']) && this.onGround) {\n      this.vy = this.jumpVel;\n      this.onGround = false;\n      playJump();\n    }\n    this.vy += this.gravity;\n    this.x += this.vx * dt;\n    this.y += this.vy * dt;\n    if (this.y + this.h >= 500) {\n      this.y = 500 - this.h;\n      this.vy = 0;\n      this.onGround = true;\n    }\n    if (this.x < 0) this.x = 0;\n    if (this.x + this.w > canvas.width) this.x = canvas.width - this.w;\n  },\n  draw() {\n    ctx.fillStyle = 'var(--player)';\n    ctx.fillRect(this.x, this.y, this.w, this.h);\n  }\n};\n\nconst keys = {};\nwindow.addEventListener('keydown', e => { keys[e.code] = true; });\nwindow.addEventListener('keyup', e => { keys[e.code] = false; });\n\nconst buildBtn = document.getElementById('build-btn');\nbuildBtn.addEventListener('click', () => {\n  const length = 2 + Math.floor(Math.random() * 7); // 2-8\n  createBridge(length);\n});\n\nlet lastTime = 0;\nfunction gameLoop(timestamp) {\n  const dt = (timestamp - lastTime) / 1000;\n  lastTime = timestamp;\n  update(dt);\n  render();\n  requestAnimationFrame(gameLoop);\n}\nrequestAnimationFrame(gameLoop);\n\nfunction update(dt) {\n  bridgePoints += bpRegenRate * dt;\n  bridgePoints = Math.min(100, bridgePoints);\n  bridgeSegments.forEach(bridge => updateBridge(bridge, dt));\n  player.update(dt);\n  if (player.x > canvas.width - 50) {\n    const currentBP = Math.floor(bridgePoints);\n    const highScore = localStorage.getItem('bridgeBuilderHighScore');\n    if (!highScore || currentBP > parseInt(highScore)) {\n      localStorage.setItem('bridgeBuilderHighScore', currentBP);\n    }\n    alert(`Level Complete! Score: ${currentBP}`);\n  }\n}\n\nfunction render() {\n  ctx.clearRect(0, 0, canvas.width, canvas.height);\n  ctx.fillStyle = 'var(--bg)';\n  ctx.fillRect(0, 0, canvas.width, canvas.height);\n  // ground\n  ctx.fillStyle = '#555';\n  ctx.fillRect(0, 500, canvas.width, 200);\n  // bridges\n  bridgeSegments.forEach(drawBridge);\n  // player\n  player.draw();\n  // HUD\n  drawHUD();\n  drawTimer();\n}\n\nfunction drawHUD() {\n  // health bar\n  const healthWidth = 200;\n  const healthHeight = 12;\n  ctx.fillStyle = 'var(--hud-bg)';\n  ctx.fillRect(10, 10, healthWidth, healthHeight);\n  ctx.fillStyle = 'var(--player)';\n  const healthFill = Math.min(1, player.health / 3);\n  ctx.fillRect(10, 10, healthWidth * healthFill, healthHeight);\n  // BP\n  ctx.fillStyle = 'var(--hud-text)';\n  ctx.font = '1rem Arial';\n  ctx.fillText(`BP: ${Math.floor(bridgePoints)}`, canvas.width - 160, 30);\n  // timer\n  drawTimer();\n}\n"

