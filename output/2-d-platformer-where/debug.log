const canvas = document.getElementById('gameCanvas');
const ctx = canvas.getContext('2d');
let scale = Math.min(window.innerWidth / 1280, window.innerHeight / 720);
canvas.width = 1280 * scale;
canvas.height = 720 * scale;
const scaleFactor = scale;

function resize() {
  scale = Math.min(window.innerWidth / 1280, window.innerHeight / 720);
  canvas.width = 1280 * scale;
  canvas.height = 720 * scale;
}
window.addEventListener('resize', resize);

const audioCtx = new (window.AudioContext || window.webkitAudioContext)();

function playSound(frequency, duration, type='square') {
  const osc = audioCtx.createOscillator();
  const gain = audioCtx.createGain();
  osc.type = type;
  osc.frequency.value = frequency;
  gain.gain.value = 0.2;
  osc.connect(gain);
  gain.connect(audioCtx.destination);
  osc.start();
  gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + duration);
  osc.stop(audioCtx.currentTime + duration);
}

// Helper to play short sounds
function playJump() { playSound(440, 0.1, 'square'); }
function playBridgeBuild() { 
  const osc = audioCtx.createOscillator();
  const gain = audioCtx.createGain();
  osc.type = 'sawtooth';
  osc.frequency.setValueAtTime(880, audioCtx.currentTime);
  osc.frequency.exponentialRampToValueAtTime(220, audioCtx.currentTime + 0.3);
  gain.gain.setValueAtTime(0.2, audioCtx.currentTime);
  gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 0.3);
  osc.connect(gain);
  gain.connect(audioCtx.destination);
  osc.start();
  osc.stop(audioCtx.currentTime + 0.3);
}
function playDamage() { playSound(660, 0.05, 'square'); }
function playCheckpoint() { 
  const osc = audioCtx.createOscillator();
  const gain = audioCtx.createGain();
  osc.type = 'sine';
  osc.frequency.setValueAtTime(1000, audioCtx.currentTime);
  osc.frequency.exponentialRampToValueAtTime(200, audioCtx.currentTime + 0.2);
  gain.gain.setValueAtTime(0.2, audioCtx.currentTime);
  gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 0.2);
  osc.connect(gain);
  gain.connect(audioCtx.destination);
  osc.start();
  osc.stop(audioCtx.currentTime + 0.2);
}

Now player:

const player = {
  x: 100,
  y: 300,
  w: 12,
  h: 16,
  vx: 0,
  vy: 0,
  speed: 6,
  jumpVel: -12,
  gravity: 0.5,
  onGround: false,
  crouch: false,
  // methods
  update(dt) {
    // horizontal input
    const left = keys['a'] || keys['ArrowLeft'];
    const right = keys['d'] || keys['ArrowRight'];
    if (left) this.vx = this.speed;
    else if (right) this.vx = this.speed;
    else this.vx = 0;
    // apply friction
    this.vx *= this.onGround ? 0.85 : 0.5;
    // jump
    if ((keys[' '] || keys['w'] || keys['ArrowUp']) && this.onGround) {
      this.vy = this.jumpVel;
      this.onGround = false;
      playJump();
    }
    // apply gravity
    this.vy += this.gravity;
    // move
    this.x += this.vx * dt;
    this.y += this.vy * dt;
    // simple ground detection (assume ground at y = 500)
    if (this.y + this.h >= 500) {
      this.y = 500 - this.h;
      this.vy = 0;
      this.onGround = true;
    }
    // keep within canvas
    if (this.x < 0) this.x = 0;
    if (this.x + this.w > canvas.width) this.x = canvas.width - this.w;
  },
  draw() {
    ctx.fillStyle = 'var(--player)';
    ctx.fillRect(this.x, this.y, this.w, this.h);
  }
};

