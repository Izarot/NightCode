essFlash = 0;\n    let patternMatched = [];\n\n    function initLevel() {\n      const lvl = levels[currentLevel];\n      boids = [];\n      for (let i = 0; i < lvl.birdCount; i++) {\n        const x = width * 0.2 + Math.random() * width * 0.6;\n        const y = height * 0.2 + Math.random() * height * 0.6;\n        boids.push(new Boid(x, y));\n      }\n      patternMatched = [];\n      levelTime = 0;\n      gameState = 'playing';\n      updateHUD();\n    }\n\n    function updateHUD() {\n      const lvl = levels[currentLevel];\n      document.getElementById('levelTitle').textContent = `Level ${currentLevel + 1}: ${lvl.name}`;\n      document.getElementById('highScore').textContent = `Best: ${getHighScore()}`;\n      document.getElementById('score').textContent = score;\n      const fillPct = ((attractionPower - 1) / 4) * 100;\n      document.getElementById('attractionFill').style.width = fillPct + '%';\n    }\n\n    function formatTime(t) {\n      const mins = Math.floor(t / 3600);\n      const secs = Math.floor((t % 3600) / 60);\n      const ms = Math.floor((t % 60) * 100 / 60);\n      return `${mins.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}.${ms.toString().padStart(2, '0')}`;\n    }\n\n    function calculateMatch() {\n      const lvl = levels[currentLevel];\n      const pat = lvl.pattern;\n      if (pat.length === 0) return 0;\n      let totalDist = 0;\n      const assigned = new Set();\n      for (const bird of boids) {\n        let bestDist = Infinity, bestIdx = -1;\n        for (let i = 0; i < pat.length; i++) {\n          if (assigned.has(i)) continue;\n          const dx = bird.x - width / 2 - pat[i].x;\n          const dy = bird.y - height / 2 - pat[i].y;\n          const d = Math.sqrt(dx * dx + dy * dy);\n          if (d < bestDist) { bestDist = d; bestIdx = i; }\n        }\n        if (bestIdx >= 0) { assigned.add(bestIdx); totalDist += bestDist; }\n      }\n      const maxErr = pat.length * 200;\n      return Math.max(0, 1 - totalDi