        if (repelEffect > 0) {
          ctx.beginPath();
          ctx.arc(mouseX, mouseY, 150, 0, Math.PI * 2);
          ctx.strokeStyle = `rgba(0, 217, 255, ${repelEffect * 0.5})`;
          ctx.lineWidth = 2;
          ctx.setLineDash([5, 5]);
          ctx.stroke();
          ctx.setLineDash([]);
        }
      }
      
      // Draw Boids
      for (const boid of boids) {
        // Trail
        for (let i = 0; i < boid.trail.length; i++) {
          const t = boid.trail[i];
          const alpha = 1 - i / boid.trail.length;
          const size = 3 * alpha;
          ctx.beginPath();
          ctx.arc(t.x, t.y, size, 0, Math.PI * 2);
          ctx.fillStyle = `rgba(244, 162, 97, ${alpha * 0.5})`;
          ctx.fill();
        }
        
        // Body
        const angle = Math.atan2(boid.vy, boid.vx);
        ctx.save();
        ctx.translate(boid.x, boid.y);
        ctx.rotate(angle);
        
        // Wing shimmer
        const wingOffset = Math.sin(levelTime * 0.2 + boid.x * 0.01) * 2;
        
        // Main body
        ctx.beginPath();
        ctx.ellipse(0, 0, 12, 6, 0, 0, Math.PI * 2);
        const bodyGrad = ctx.createRadialGradient(0, 0, 0, 0, 0, 12);
        bodyGrad.addColorStop(0, '#fff8f0');
        bodyGrad.addColorStop(0.5, '#f4a261');
        bodyGrad.addColorStop(1, '#e76f51');
        ctx.fillStyle = bodyGrad;
        ctx.fill();
        
        // Wing
        ctx.beginPath();
        ctx.moveTo(-2, -3);
        ctx.quadraticCurveTo(-8, -8 + wingOffset, -14, -2 + wingOffset);
        ctx.quadraticCurveTo(-8, 0, -2, 3);
        ctx.fillStyle = '#e9c46a';
        ctx.fill();
        
        // Beak
        ctx.beginPath();
        ctx.moveTo(12, 0);
        ctx.lineTo(18, 0);
        ctx.lineTo(12, 3);
        ctx.closePath();
        ctx.fillStyle = '#f4a261';
        ctx.fill();
        
        // Eye
        ctx.beginPath();
        ctx.arc(6, -1, 2, 0, Math.PI * 2);
        ctx.fillStyle = '#1a1a2e';
        ctx.fill();
        ctx.beginPath();
        ctx.arc(6.5, -1.5, 0.8, 0, Math.PI * 2);
        ctx.fillStyle = '#fff';
        ctx.fill();
        
        ctx.restore();
      }
      
      // Particles
      for (const p of particles) p.draw();
      
      // Success flash
      if (successFlash > 0) {
        ctx.fillStyle = `rgba(255, 215, 0, ${successFlash * 0.02})`;
        ctx.fillRect(0, 0, width, height);
      }
    }
    
    function gameLoop() {
      update();
      draw();
      requestAnimationFrame(gameLoop);
    }
    
    // Input handling
    canvas.addEventListener('mousemove', (e) => {
      initAudio();
      mouseX = e.clientX;
      mouseY = e.clientY;
    });
    
    canvas.addEventListener('touchmove', (e) => {
      initAudio();
      e.preventDefault();
      mouseX = e.touches[0].clientX;
      mouseY = e.touches[0].clientY;
    }, { passive: false });
    
    canvas.addEventListener('touchstart', (e) => {
      initAudio();
      e.preventDefault();
      mouseX = e.touches[0].clientX;
      mouseY = e.touches[0].clientY;
    }, { passive: false });
    
    canvas.addEventListener('mouseleave', () => {
      mouseX = -1000;
      mouseY = -1000;
    });
    
    canvas.addEventListener('wheel', (e) => {
      e.preventDefault();
      attractionPower = Math.max(1, Math.min(5, attractionPower + e.deltaY * -0.001));
      document.getElementById('attractionFill').style.width = ((attractionPower - 1) / 4) * 100 + '%';
    }, { passive: false });
    
    canvas.addEventListener('contextmenu', (e) => {
      e.preventDefault();
      repelEffect = 1;
      playRepel();
    });
    
    document.addEventListener('keydown', (e) => {
      if (e.code === 'Space') {
        e.preventDefault();
        if (gameState === 'complete') {
          if (currentLevel < levels.length - 1) {
            currentLevel++;
            document.getElementById('levelComplete').classList.remove('show');
            setTimeout(initLevel, 300);
          } else {
            // Game finished
            const hs = getHighScore();
            document.getElementById('finalScore').textContent = score;
            if (score > hs) {
              setHighScore(score);
              document.getElementById('highScoreText').textContent = 'New High Score!';
            } else {
              document.getElementById('highScoreText').textContent = `Best: ${hs}`;
            }
            document.getElementById('levelComplete').classList.remove('show');
            setTimeout(() => document.getElementById('gameOver').classList.add('show'), 500);
          }
        } else if (gameState === 'playing') {
          currentLevel = 0;
          score = 0;
          initLevel();
        }
      }
    });
    
    document.getElementById('nextBtn').addEventListener('click', () => {
      if (currentLevel < levels.length - 1) {
        currentLevel++;
        document.getElementById('levelComplete').classList.remove('show');
        setTimeout(initLevel, 300);
      } else {
        // Game finished
        const hs = getHighScore();
        document.getElementById('finalScore').textContent = score;
        if (score > hs) {
          setHighScore(score);
          document.getElementById('highScoreText').textContent = 'New High Score!';
        } else {
          document.getElementById('highScoreText').textContent = `Best: ${hs}`;
        }
        document.getElementById('levelComplete').classList.remove('show');
        setTimeout(() => document.getElementById('gameOver').classList.add('show'), 500);
      }
      initAudio();
    });
    
    document.getElementById('playAgainBtn').addEventListener('click', () => {
      document.getElementById('gameOver').classList.remove('show');
      currentLevel = 0;
      score = 0;
      setTimeout(initLevel, 300);
      initAudio();
    });
    
    // Start game
    initLevel();
    gameLoop();
  </script>
</body>
</html>