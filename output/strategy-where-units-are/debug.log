  "css/style.css": "#game-container {\n    position: relative;\n    width: 100%;\n    height: 100vh;\n    overflow: hidden;\n    background: #0a0a1a;\n}\n\n#game-canvas {\n    display: block;\n    width: 100%;\n    height: auto;\n    cursor: crosshair;\n}\n\n/* --- HUD Layouts --- */\n#hud-top-left {\n    position: absolute;\n    left: 20px;\n    top: 20px;\n    padding: 12px 16px;\n    background: rgba(10, 10, 26, 0.92);\n    border-radius: 8px;\n    font-family: 'Segoe UI', sans-serif;\n    font-size: 14px;\n    color: #e0e0e0;\n    z-index: 100;\n}\n\n#hud-top-center {\n    position: absolute;\n    left: 50%;\n    top: 50%;\n    transform: translate(-50%, -50%);\n    padding: 16px 28px;\n    background: rgba(15, 18, 35, 0.85);\n    border-radius: 12px;\n    display: flex;\n    flex-direction: column;\n    gap: 8px;\n}\n\n#hud-top-right {\n    position: absolute;\n    right: 20px;\n    top: 50%;\n    transform: translate(-50%, -50%);\n    padding: 16px 22px;\n    background: rgba(10, 10, 26, 0.85);\n    border-radius: 12px;\n    text-align: right;\n}\n\n#hud-bottom-left {\n    position: absolute;\n    bottom: 20px;\n    left: 20px;\n    padding: 12px 16px;\n    background: rgba(10, 10, 26, 0.92);\n    border-radius: 8px;\n    font-family: 'Segoe UI', sans-serif;\n    font-size: 13px;\n    color: #c0c0c0;\n}\n\n#hud-bottom-center {\n    position: absolute;\n    bottom: 20px;\n    left: 50%;\n    transform: translateX(-50%);\n    width: 140px;\n    height: 80px;\n    background: rgba(15, 18, 35, 0.9);\n    border-radius: 6px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n}\n\n#hud-bottom-right {\n    position: absolute;\n    bottom: 20px;\n    right: 20px;\n    padding: 12px 16px;\n    background: rgba(10, 10, 26, 0.85);\n    border-radius: 8px;\n    font-family: 'Segoe UI', sans-serif;\n    font-size: 13px;\n    color: #e0e0e0;\n}\n\n/* --- Speedrun Timer --- */\n#speedrun-timer {\n    position: absolute;\n    top: 16px;\n    right: 16px;\n    font-family: 'Courier New', monospace;\n    font-size: 28px;\n    color: #00e4ff;\n    font-weight: bold;\n    text-shadow: 0 0 8px rgba(0, 228, 255, 0.5);\n}\n\n/* --- Mini-Map --- */\n#hud-bottom-center .mini-map {\n    width: 200px;\n    height: 112px;\n    border-radius: 6px;\n    background: rgba(0, 0, 0, 0.5);\n    margin: 0 auto;\n}\n\n#hud-bottom-center .unit-dot {\n    width: 8px;\n    height: 8px;\n    border-radius: 50%;\n}\n\n#hud-bottom-center .enemy-dot {\n    background: #ff0066;\n}\n\n#hud-bottom-center .nutrient-patch {\n    background: #ffcc00;\n}\n\n/* --- Responsive Adjustments --- */\n@media (max-width: 768px) {\n    #hud-top-left { padding: 10px 12px; font-size: 12px; }\n    #hud-top-center { padding: 12px 20px; gap: 6px; }\n    #hud-top-right { padding: 10px 14px; }\n    #hud-bottom-left { padding: 10px 12px; font-size: 11px; }\n    #hud-bottom-center { width: 110px; height: 60px; }\n    #hud-bottom-right { padding: 10px 12px; font-size: 11px; }\n}\n",
  "js/core/game-state.js": "// Game State Manager\nconst GameState = {\n    // Core state\n    units: [],\n    nutrients: 0,\n    mutagen: 0,\n    mp: 0,\n    maxMp: 100,\n    \n    // Turn & Timer\n    time: 0,\n    speedrunTimer: 0,\n    round: 1,\n    \n    // Camera\n    cameraX: 0,\n    cameraY: 0,\n    zoom: 1.0,\n    \n    // Colors (unique vibrant palette)\n    COLORS: {\n        PLAYER: '#00e4ff',\n        ENEMY: '#ff0066',\n        UNIT_PLAZMA: '#00e4ff',\n        UNIT_PHOAGE: '#ff6600',\n        UNIT_SPORE: '#ff8844'\n    },\n    \n    // Initialize empty unit list\n    init() {\n        this.units = [];\n    },\n    \n    // Get unit by ID\n    getUnit(id) {\n        return this.units.find(u => u.id === id);\n    },\n    \n    // Add a unit\n    addUnit(type, position) {\n        const unit = {\n            id: Date.now().toString(),\n            type,\n            x: position.x,\n            y: position.y,\n            health: 100,\n            energy: 50,\n            speed: this.getDefaultSpeed(type),\n            maxHealth: 100,\n            energyMax: 50,\n            mutated: false,\n            mutationType: null,\n            lastSpawn: Date.now()\n        };\n        this.units.push(unit);\n        return unit;\n    },\n    \n    // Remove a unit\n    removeUnit(id) {\n        this.units = this.units.filter(u => u.id !== id);\n    },\n    \n    // Update all units (movement, health, etc.)\n    tick() {\n        this.time += 1;\n        this.speedrunTimer = Math.min(this.speedrunTimer + 1, 300);\n        \n        // Update speedrun timer display\n        document.getElementById('speedrun-timer').textContent =\n            this.speedrunTimer.toString().padStart(2, '0');\n    },\n    \n    // Get all units\n    getAllUnits() {\n        return this.units;\n    }\n};\n\n// Default speeds per unit type\nconst DEFAULT_SPEED = {\n    Plasmid: 130,\n    Phage: 160,\n    Spore: 110\n};\n\nfunction getDefaultSpeed(type) {\n    return DEFAULT_SPEED[type] || 150;\n}",
  "js/core/resource-manager.js": "// Resource Manager - Nutrients and Mutagen\nconst ResourceManager = {\n    nutrients: 0,\n    mutagen: 0,\n    \n    // Spawn a unit from the colony hub\n    // cost: number of nutrients required\n    spawnUnit(type, position) {\n        if (this.nutrients >= type.cost) {\n            this.nutrients -= type.cost;\n            const unit = GameState.addUnit(type, position);\n            return unit;\n        }\n        throw new Error(`Insufficient nutrients: ${type.cost}`);\n    },\n    \n    // Collect nutrients from patches (simulated)\n    collectNutrients(duration) {\n        // In a full version, this would check for nutrient patches\n        // For now, we simulate collection over time\n        this.nutrients = Math.min(20, this.nutrients + 2 * duration);\n    },\n    \n    // Collect mutagen from dead enemies\n    collectMutagen() {\n        this.mutagen += 5;\n        console.log('Mutagen collected:', this.mutagen);\n    },\n    \n    // Check if high score has been beaten\n    getHighScore() {\n        try {\n            const saved = localStorage.getItem('bactaria_highscore');\n            return saved ? parseInt(saved, 10) : 0;\n        } catch (e) {\n            return 0;\n        }\n    },\n    \n    // Save high score\n    saveHighScore(score) {\n        try {\n            localStorage.setItem('bactaria_highscore', score);\n            return true;\n        } catch (e) {\n            console.error('Failed to save high score:', e);\n            return false;\n        }\n    },\n    \n    // Reset resources for new game\n    reset() {\n        this.nutrients = 0;\n        this.mutagen = 0;\n    }\n};\n",
  "js/pathfinder/astar.js": "// A* Pathfinding Algorithm\nconst AStar = {\n    // Cell size in pixels (matches game grid)\n    CELL_SIZE: 32,\n    \n    // Build the grid\n    buildGrid(width, height) {\n        const grid = {};\n        for (let x = 0; x < width; x++) {\n            for (let y = 0; y < height; y++) {\n                grid[x + width/2, y + height/2] = {\n                    x: x,\n                    y: y,\n                    walkable: true\n                };\n            }\n        }\n        return grid;\n    },\n    \n    // Find shortest path from start to goal\n    findPath(grid, start, goal) {\n        const openSet = new Set();\n        const closedSet = new Set();\n        const cameFrom = {};\n        const gScore = {}; // Cost from start to node\n        const fScore = {}; // Estimated total cost\n        \n        // Initialize start\n        const startKey = `${start.x},${start.y}`;\n        openSet.add(startKey);\n        gScore[startKey] = 0;\n        fScore[startKey] = heuristic(start, goal);\n        \n        while (openSet.size > 0) {\n            // Get node with lowest f_score\n            let currentKey = null;\n            let minF = Infinity;\n            for (const key of openSet) {\n                if (gScore[key] + fScore[key] < minF) {\n                    minF = gScore[key] + fScore[key];\n                    currentKey = key;\n                }\n            }\n            \n            if (!currentKey) break; // No path found\n            \n            const current = grid[currentKey.split(',')];\n            openSet.delete(currentKey);\n            closedSet.add(currentKey);\n            \n            if (currentKey === goalKey) {\n                return reconstructPath(cameFrom, currentKey);\n            }\n            \n            // Neighbors (4-directional)\n            const neighbors = [\n                { dx: 1, dy: 0 }, // East\n                { dx: -1, dy: 0 }, // West\n                { dx: 0, dy: 1 }, // South\n                { dx: 0, dy: -1 } // North\n            ];\n            \n            for (const dir of neighbors) {\n                const nx = current.x + dir.dx;\n                const ny = current.y + dir.dy;\n                const neighborKey = `${nx},${ny}`;\n                \n                if (!grid.hasOwnProperty(neighborKey)) continue;\n                if (!grid[neighborKey].walkable) continue;\n                if (closedSet.has(neighborKey)) continue;\n                \n                const tentativeG = gScore[currentKey] + 1;\n                if (tentativeG < gScore[neighborKey]) {\n                    cameFrom[neighborKey] = currentKey;\n                    gScore[neighborKey] = tentativeG;\n                    fScore[neighborKey] = tentativeG + heuristic(grid[neighborKey], goal);\n                    openSet.add(neighborKey);\n                }\n            }\n        }\n        \n        return null; // No path\n    },\n    \n    // Heuristic: Manhattan distance\n    heuristic(a, b) {\n        return Math.abs(a.x - b.x) + Math.abs(a.y - b.y);\n    },\n    \n    // Reconstruct path from cameFrom map\n    reconstructPath(cameFrom, currentKey) {\n        const path = [];\n        let key = currentKey;\n        while (key !== undefined) {\n            const [x, y] = key.split(',').map(Number);\n            path.push({ x, y });\n            key = cameFrom[key] || undefined;\n        }\n        return path.reverse();\n    }\n};\n",
  "js/entities/unit.js": "// Unit Entity Class\nconst Unit = {\n    id: null,\n    type: null,\n    x: 0,\n    y: 0,\n    health: 100,\n    energy: 50,\n    maxHealth: 100,\n    maxEnergy: 50,\n    speed: 0,\n    mutated: false,\n    mutationType: null,\n    lastSpawn: 0,\n    \n    constructor(type, position) {\n        this.id = this.generateId();\n        this.type = type;\n        this.x = position.x;\n        this.y = position.y;\n        this.health = 100;\n        this.energy = 50;\n        this.maxHealth = 100;\n        this.maxEnergy = 50;\n        this.speed = this.getDefaultSpeed(type);\n        this.mutated = false;\n        this.mutationType = null;\n        this.lastSpawn = Date.now();\n    },\n    \n    // Get default speed for this unit type\n    getDefaultSpeed() {\n        switch (this.type) {\n            case 'Plasmid': return 130;\n            case 'Phage': return 160;\n            case 'Spore': return 110;\n            default: return 150;\n        }\n    },\n    \n    // Take damage\n    takeDamage(amount) {\n        this.health = Math.max(0, this.health - amount);\n        if (this.health <= 0) {\n            this.health = 0;\n            this.isAlive = false;\n        }\n    },\n    \n    // Heal slowly when not damaged\n    heal() {\n        if (!this.isAlive) return;\n        this.energy = Math.min(this.maxEnergy, this.energy + 5);\n    },\n    \n    // Attempt to move towards target\n    moveTo(target) {\n        if (!this.isAlive) return;\n        \n        const dx = target.x - this.x;\n        const dy = target.y - this.y;\n        const dist = Math.sqrt(dx * dx + dy * dy);\n        \n        if (dist < 0.5) return;\n        \n        // Move towards target\n        const moveDist = this.speed;\n        const step = Math.min(dist, moveDist);\n        this.x += (dx / dist) * step;\n        this.y += (dy / dist) * step;\n        \n        // Apply friction\n        this.x *= 0.95;\n        this.y *= 0.95;\n        \n        // Energy consumption for movement\n        this.energy = Math.max(0, this.energy - 0.05);\n    },\n    \n    // Split into two daughter units\n    split() {\n        if (!this.isAlive) return;\n        \n        // Cost: 5 energy\n        if (this.energy < 5) {\n            console.warn('Not enough energy to split');\n            return;\n        }\n        \n        // Consume energy\n        this.energy -= 5;\n        \n        // Create two daughter units\n        const childSpeed = this.speed * 0.9;\n        const children = [\n            new Unit(this.type, { x: this.x + (Math.random() - 0.5) * 8, y: this.y }),\n            new Unit(this.type, { x: this.x - (Math.random() - 0.5) * 8, y: this.y })\n        ];\n        \n        // Give children full energy\n        for (const child of children) {\n            child.energy = this.maxEnergy;\n        }\n        \n        // Add children to game state\n        GameState.addUnit(this.type, { x: child.x, y: child.y });\n        \n        // Mark parent as split\n        this.isAlive = false;\n        this.mutated = true;\n        this.mutationType = 'split';\n        \n        // Visual feedback could go here\n        console.log(`Splitting ${this.type} at (${this.x.toFixed(1)}, ${this.y.toFixed(1)})`);\n    },\n    \n    // Mutate the unit\n    mutate(mutationType) {\n        if (!this.isAlive) return;\n        \n        // Check MP availability\n        if (GameState.mp < mutationCosts[mutationType]) {\n            console.warn(`Not enough MP for ${mutationType} mutation`);\n            return;\n        }\n        \n        // Deduct MP\n        GameState.mp -= mutationCosts[mutationType];\n        \n        // Apply mutation effects (simplified)\n        this.mutated = true;\n        this.mutationType = mutationType;\n        \n        // Change color based on mutation\n        switch (mutationType) {\n            case 'enhanced_metabolism':\n                this.maxEnergy = 70;\n                this.speed = 135;\n                break;\n            case 'cell_wall':\n                this.speed = 105;\n                this.maxHealth = 140;\n                break;\n            case 'toxicity':\n                this.attackDamage = 15;\n                this.meleeRange = 45;\n                break;\n            case 'photosynthesis':\n                this.energyRegeneration = 8;\n                break;\n            case 'spore_burst':\n                this.sporeBurstEffect = true;\n                break;\n            default:\n                break;\n        }\n        \n        // Visual cue would be shown here\n        console.log(`Mutated ${this.type} with ${mutationType}`);\n    },\n    \n    // Check if unit is alive\n    isAlive() {\n        return this.health > 0 && !this.isAlive;\n    },\n    \n    // Get unit info for HUD\n    toHudInfo() {\n        return {\n            id: this.id,\n            type: this.type,\n            health: this.health,\n            energy: this.energy,\n            maxHealth: this.maxHealth,\n            speed: this.speed,\n            mutated: this.mutated,\n            mutationType: this.mutationType\n        };\n    }\n};",
  "js/audio/sfx.js": "// Audio System using Web Audio API\nconst SFX = {\n    ctx: null,\n    \n    init() {\n        if (!this.ctx) {\n            this.ctx = new (window.AudioContext || window.webkitAudioContext)();\n        }\n        // Ensure audio context is resumed (required for autoplay)\n        if (this.ctx.state === 'suspended') {\n            this.ctx.resume();\n        }\n    },\n    \n    // Play a sound effect\n    play(name) {\n        if (!this.ctx) return;\n        \n        const oscillator = this.ctx.createOscillator();\n        const gainNode = this.ctx.createGain();\n        \n        oscillator.connect(gainNode);\n        gainNode.connect(this.ctx.destination);\n        \n        switch (name) {\n            case 'split':\n                this.playSplit();\n                break;\n            case 'mutate':\n                this.playMutation();\n                break;\n            case 'attack':\n                this.playAttack();\n                break;\n            case 'footstep':\n                this.playFootstep();\n                break;\n            case 'resource':\n                this.playResource();\n                break;\n            default:\n                this.playNoise();\n        }\n        \n        oscillator.frequency.value = 600; // Base frequency\n        oscillator.type = 'sine';\n        gainNode.gain.setValueAtTime(0.1, this.ctx.currentTime);\n        gainNode.gain.exponentialRampToValueAtTime(0.01, this.ctx.currentTime + 0.3);\n        oscillator.start(this.ctx.currentTime);\n        oscillator.stop(this.ctx.currentTime + 0.3);\n    },\n    \n    playSplit() {\n        const osc = this.ctx.createOscillator();\n        const gain = this.ctx.createGain();\n        osc.connect(gain);\n        gain.connect(this.ctx.destination);\n        \n        osc.frequency.setValueAtTime(800, this.ctx.currentTime);\n        osc.frequency.exponentialRampToValueAtTime(200, this.ctx.currentTime + 0.5);\n        gain.gain.setValueAtTime(0.15, this.ctx.currentTime);\n        gain.gain.exponentialRampToValueAtTime(0.001, this.ctx.currentTime + 0.5);\n        osc.start(this.ctx.currentTime);\n        osc.stop(this.ctx.currentTime + 0.5);\n    },\n    \n    playMutation() {\n        const osc = this.ctx.createOscillator();\n        const gain = this.ctx.createGain();\n        osc.connect(gain);\n        gain.connect(this.ctx.destination);\n        \n        osc.frequency.setValueAtTime(400, this.ctx.currentTime);\n        osc.frequency.exponentialRampToValueAtTime(100, this.ctx.currentTime + 0.4);\n        gain.gain.setValueAtTime(0.12, this.ctx.currentTime);\n        gain.gain.exponentialRampToValueAtTime(0.001, this.ctx.currentTime + 0.4);\n        osc.start(this.ctx.currentTime);\n        osc.stop(this.ctx.currentTime + 0.4);\n    },\n    \n    playAttack() {\n        const osc = this.ctx.createOscillator();\n        const gain = this.ctx.createGain();\n        osc.connect(gain);\n        gain.connect(this.ctx.destination);\n        \n        osc.frequency.setValueAtTime(300, this.ctx.currentTime);\n        osc.frequency.exponentialRampToValueAtTime(150, this.ctx.currentTime + 0.25);\n        gain.gain.setValueAtTime(0.2, this.ctx.currentTime);\n        gain.gain.exponentialRampToValueAtTime(0.001, this.ctx.currentTime + 0.25);\n        osc.start(this.ctx.currentTime);\n        osc.stop(this.ctx.currentTime + 0.25);\n    },\n    \n    playFootstep() {\n        // Short noise burst for footsteps\n        const bufferSize = this.ctx.sampleRate * 0.08; // ~80ms\n        const buffer = this.ctx.createBuffer(1, bufferSize, this.ctx.sampleRate);\n        const data = buffer.getChannelData(0);\n        \n        for (let i = 0; i < bufferSize; i++) {\n            data[i] = Math.random() * 0.3 - 0.15;\n        }\n        \n        const source = this.ctx.createBufferSource();\n        source.buffer = buffer;\n        source.connect(this.ctx.destination);\n        \n        const filter = this.ctx.createBiquadFilter();\n        filter.type = 'lowpass';\n        filter.frequencyVal = 800;\n        source.connect(filter);\n        filter.connect(this.ctx.destination);\n        \n        source.start();\n        setTimeout(() => source.stop(this.ctx.currentTime + 0.08), 0.08);\n    },\n    \n    playResource() {\n        // Soft chime for resource collection\n        const osc = this.ctx.createOscillator();\n        const gain = this.ctx.createGain();\n        osc.connect(gain);\n        gain.connect(this.ctx.destination);\n        \n        osc.frequency.setValueAtTime(500, this.ctx.currentTime);\n        osc.frequency.exponentialRampToValueAtTime(100, this.ctx.currentTime + 0.2);\n        gain.gain.setValueAtTime(0.1, this.ctx.currentTime);\n        gain.gain.exponential}