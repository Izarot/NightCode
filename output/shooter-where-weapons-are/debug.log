ht: 8px;\n            background: #333;\n            border-radius: 4px;\n            overflow: hidden;\n        }\n        .health-fill {\n            height: 100%;\n            background: linear-gradient(90deg, #00E5FF, #FF006C);\n            transition: width 0.3s ease;\n        }\n        .weapon-indicator {\n            transform: rotate(-45deg);\n            width: 140px;\n            height: 140px;\n            border-radius: 50%;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            font-size: 48px;\n            color: white;\n            transition: transform 0.3s ease;\n        }\n        .weapon-indicator.active {\n            transform: rotate(0deg) scale(1.1);\n        }\n        .minimap {\n            position: absolute;\n            bottom: 20px;\n            right: 20px;\n            width: 180px;\n            height: 120px;\n            background: rgba(0, 0, 0, 0.7);\n            border-radius: 8px;\n            overflow: hidden;\n            box-shadow: 0 8px 32px rgba(0, 255, 255, 0.2);\n        }\n        .minimap canvas {\n            width: 100%;\n            height: 100%;\n        }\n        .paused-overlay {\n            position: absolute;\n            inset: 0;\n            background: rgba(0, 20, 40, 0.95);\n            display: flex;\n            flex-direction: column;\n            align-items: center;\n            justify-content: center;\n            z-index: 200;\n            opacity: 0;\n            transition: opacity 0.3s ease;\n        }\n        .paused-overlay.active {\n            opacity: 1;\n        }\n        .pause-btn {\n            background: linear-gradient(135deg, #00E5FF, #007ACC);\n            color: white;\n            border: none;\n            padding: 15px 40px;\n            font-size: 28px;\n            cursor: pointer;\n            border-radius: 50px;\n            box-shadow: 0 0 30px rgba(0, 229, 255, 0.4);\n            transition: transform 0.2s ease;\n        }\n        .pause-btn:hover {\n            transform: scale(1.05);\n        }\n        .settings-btn {\n            background: rgba(255, 255, 255, 0.9);\n            border: 2px solid #00E5FF;\n            color: #0A0F1D;\n            padding: 10px 20px;\n            border-radius: 8px;\n            cursor: pointer;\n            font-size: 14px;\n            transition: all 0.2s ease;\n        }\n        .settings-btn:hover {\n            background: #00E5FF;\n            color: #0A0F1D;\n        }\n        .score-display {\n            position: absolute;\n            bottom: 20px;\n            right: 20px;\n            z-index: 50;\n            background: rgba(0, 0, 0, 0.8);\n            padding: 15px 25px;\n            border-radius: 10px;\n            backdrop-filter: blur(10px);\n            font-size: 22px;\n            font-weight: bold;\n            color: #00E5FF;\n        }\n        .high-score {\n            margin-top: 10px;\n            font-size: 18px;\n            color: #FF006C;\n        }\n        @media (max-width: 600px) {\n            #game-container {\n                border-radius: 0;\n                max-width: 100%;\n            }\n            .health-bar {\n                width: 100px;\n            }\n            .weapon-indicator {\n                width: 110px;\n                height: 110px;\n                font-size: 36px;\n            }\n            .minimap {\n                width: 130px;\n                height: 90px;\n            }\n        }\n    </style>\n</head>\n<body>\n    <div id=\"game-container\">\n        <canvas id=\"gameCanvas\"></canvas></canvas>\n        <div class=\"speedrun-timer\" id=\"speedrunTimer\">00:00.000</div>\n        <div class=\"paused-overlay active\" id=\"pausedOverlay\">\n            <span class=\"pause-btn\">PAUSED</span>\n        </div>\n        <div class=\"hud-top-left\">\n            <div class=\"health-bar\">\n                <div class=\"health-fill\" id=\"healthFill\" style=\"width: 100%\"\"></div>\n            </div>\n            <div class=\"weapon-indicator\" id=\"weaponIndicator\" style=\"background: #00E5FF;\">🔫</div>\n            <div class=\"minimap\" id=\"minimapContainer\"></div>\n        </div>\n        <div class=\"score-display\" id=\"scoreDisplay\">SCORE: 0</div>\n        <div class=\"high-score\" id=\"highScoreDisplay\">BEST: 0</div>\n    </div>\n    <script src=\"main.js\"></script>\n</body>\n</html>",\n  "main.js": "// Arsenal Shift - Main Entry Point\n// Initializes the game engine, loads assets, and starts the game loop\n\nclass ArsenalShiftGame {\n    constructor() {\n        this.canvas = document.getElementById('gameCanvas');\n        this.ctx = this.canvas.getContext('2d');\n        this.timerEl = document.getElementById('speedrunTimer');\n        this.pausedOverlay = document.getElementById('pausedOverlay');\n        this.healthFill = document.getElementById('healthFill');\n        this.weaponIndicator = document.getElementById('weaponIndicator');\n        this.scoreDisplay = document.getElementById('scoreDisplay');\n        this.highScoreDisplay = document.getElementById('highScoreDisplay');\n        \n        // Configuration\n        this.config = {\n            health: 100,\n            maxHealth: 100,\n            speedWalk: 120,\n            speedSprint: 200,\n            speedCrouch: 60,\n            sprintCooldown: 3,\n            crouchCooldown: 5,\n            dashCooldown: 0.8,\n            dashPower: 300,\n            weaponSwitchTime: 0.4,\n            reloadTime: 1.2,\n            partialReloadTime: 0.6,\n            ammoRegenerationDelay: 30,\n            heatMax: 100,\n            heatCooldown: 2\n        };\n        \n        this.init();\n    }\n    \n    init() {\n        this.resize();\n        window.addEventListener('resize', () => this.resize());\n        this.loadHighScore();\n        this.startGame();\n    }\n    \n    resize() {\n        const container = document.getElementById('game-container');\n        const size = container.clientWidth;\n        const aspect = 16 / 9;\n        this.canvas.width = Math.round(size * aspect);\n        this.canvas.height = size;\n        \n        // Apply responsive scaling via CSS (handled by browser)\n        this.setTargetSize(size);\n    }\n    \n    setTargetSize(targetWidth) {\n        const aspect = 16 / 9;\n        const targetHeight = (targetWidth * aspect).toFixed(2);\n        this.canvas.width = Math.round(targetHeight * aspect);\n        this.canvas.height = targetHeight;\n    }\n    \n    loadHighScore() {\n        try {\n            const saved = localStorage.getItem('arsenalshift_highscore');\n            if (saved) {\n                this.score = parseInt(saved, 10);\n            }\n        } catch (e) {\n            console.warn('Failed to load high score:', e);\n        }\n    }\n    \n    saveHighScore() {\n        try {\n            localStorage.setItem('arsenalshift_highscore', this.score);\n        } catch (e) {\n            console.warn('Failed to save high score:', e);\n        }\n    }\n    \n    startGame() {\n        this.gameState = {\n            isRunning: false,\n            isPaused: false,\n            frameCount: 0,\n            score: this.config.maxHealth,\n            highScore: this.loadHighScore(),\n            weapons: [],\n            particles: [],\n            projectiles: [],\n            enemies: [],\n            camera: { x: 0, y: 0 }\n        };\n        \n        this.animate();\n    }\n    \n    animate() {\n        if (!this.gameState.isRunning || this.gameState.isPaused) return;\n        \n        this.frameCount++;\n        \n        // Update speedrun timer\n        const elapsed = this.frameCount * 0.016; // ~60 FPS\n        const minutes = Math.floor(elapsed / 60);\n        const seconds = Math.floor((elapsed % 60) / 0.016);\n        const millis = (elapsed % 0.016) * 1000;\n        this.timerEl.textContent = `${String(minutes).padStart(2, '0')}:${String(seconds).padStart(2, '0')}.${millis.toFixed(3)}`;\n        \n        // Update game systems\n        this.updatePhysics();\n        this.updateUI();\n        this.render();\n        \n        requestAnimationFrame(() => this.animate());\n    }\n    \n    updatePhysics() {\n        // Handle input\n        this.handleInput();\n        \n        // Move player\n        if (this.gameState.isRunning && !this.gameState.isPaused) {\n            this.movePlayer();\n        }\n        \n        // Update weapons\n        this.updateWeapons();\n        \n        // Update HUD\n        this.updateHUD();\n    }\n    \n    handleInput() {\n        const keys = {\n            w: false, s: false, a: false, d: false,\n            ArrowUp: false, ArrowDown: false, ArrowLeft: false, ArrowRight: false,\n            Space: false\n        };\n        \n        window.addEventListener('keydown', (e) => {\n            if (keys[e.key] === true) {\n                keys[e.key] = true;\n                this.processAction(e.key);\n            }\n        });\n        \n        window.addEventListener('keyup', (e) => {\n            if (keys[e.key]) {\n                keys[e.key] = false;\n            }\n        });\n        \n        // Dash input\n        if (keys['Space'] || keys['Shift'] || keys['Z']) {\n            this.dash();\n        }\n    }\n    \n    processAction(action) {\n        switch (action) {\n            case 'switch_weapon':\n                this.switchWeapon();\n                break;\n            case 'reload':\n                this.reload();\n                break;\n            case 'pause':\n                this.togglePause();\n                break;\n        }\n    }\n    \n    togglePause() {\n        if (!this.gameState.isRunning) return;\n        this.gameState.isPaused = !this.gameState.isPaused;\n        this.pausedOverlay.classList.toggle('active', this.gameState.isPaused);\n    }\n    \n    switchWeapon() {\n        // Find next weapon in cycle\n        const currentIndex = this.getCurrentWeaponIndex();\n        const nextIndex = (currentIndex + 1) % this.weapons.length;\n        \n        // Check if weapon switch animation is ready\n        if (this.weaponSwitchAnimComplete) return;\n        \n        this.weaponSwitchAnimComplete = false;\n        \n        // Play weapon switch animation\n        this.weaponSwitchTimer = 0;\n        this.weaponSwitchTimer += 0.016;\n        \n        // Update weapon indicator\n        const newWeapon = this.weapons[nextIndex];\n        this.weaponIndicator.style.transform = `rotate(${newWeapon.angle}deg) scale(${newWeapon.emphasis})`;\n        this.weaponIndicator.className = `weapon-indicator ${newWeapon.isActive ? ' active' : ''}`;\n        \n        // Update game state\n        this.gameState.weapons[currentIndex].setActive(false);\n        this.gameState.weapons[nextIndex].setActive(true);\n        \n        // Update HUD\n        this.updateHUD();\n    }\n    \n    getCurrentWeaponIndex() {\n        // In a real implementation, track which weapon is currently selected\n        // For now, we'll cycle based on frame count\n        return Math.floor(this.gameState.frameCount * 8) % this.weapons.length;\n    }\n    \n    reload() {\n        if (!this.gameState.isRunning || this.gameState.isPaused) return;\n        \n        if (this.gameState.weapons.length > 0) {\n            const weapon = this.weapons[this.gameState.weapons.length - 1]; // Current weapon\n            if (weapon.ammo > 0) {\n                weapon.consumeAmmo();\n                this.addParticles('reload', '#00E5FF', 20);\n            }\n        }\n        this.gameState.reloadTimer = this.config.reloadTime;\n    }\n    \n    addParticles(type, color, count) {\n        for (let i = 0; i < count; i++) {\n            this.particles.push({\n                x: this.canvas.width / 2,\n                y: this.canvas.height / 2,\n                vx: (Math.random() - 0.5) * 8,\n                vy: (Math.random() - 0.5) * 8,\n                life: 1.0,\n                decay: 0.02 + Math.random() * 0.03,\n                size: Math.random() * 6 + 2,\n                color: type === 'reload' ? color : color,\n                type: type\n            });\n        }\n    }\n    \n    movePlayer() {\n        const speed = this.getCurrentSpeed();\n        \n        // Calculate movement vector\n        let dx = 0, dy = 0;\n        if (keys['w'] || keys['W']) dx -= speed;\n        if (keys['s'] || keys['S']) dx += speed;\n        if (keys['a'] || keys['A']) dy -= speed;\n        if (keys['d'] || keys['D']) dy += speed;\n        \n        // Apply momentum\n        this.ctx.save();\n        this.ctx.translate(\n            this.gameState.camera.x,\n            this.gameState.camera.y\n        );\n        \n        // Normalize and apply damping\n        const magnitude = Math.sqrt(dx * dx + dy * dy);\n        if (magnitude > 0) {\n            dx /= magnitude;\n            dy /= magnitude;\n        }\n        \n        // Move player\n        this.player.x += dx * speed;\n        this.player.y += dy * speed;\n        \n        // Clamp to screen bounds\n        this.clampPosition();\n        \n        this.ctx.clearRect(0, 0, this.canvas.width, this.canvas.height);\n        this.drawEnvironment();\n        this.drawPlayer();\n        this.drawWeapons();\n        this.drawParticles();\n        this.ctx.restore();\n    }\n    \n    clampPosition() {\n        const halfW = this.canvas.width / 2;\n        const halfH = this.canvas.height / 2;\n        \n        if (this.player.x < -halfW) this.player.x = -halfW;\n        if (this.player.x > halfW) this.player.x = halfW;\n        if (this.player.y < -halfH) this.player.y = -halfH;\n        if (this.player.y > halfH) this.player.y = halfH;\n    }\n    \n    getCurrentSpeed() {\n        // Determine current speed tier based on inputs\n        let speed = this.config.speedWalk;\n        \n        if (keys['w'] || keys['W']) speed = this.config.speedSprint;\n        else if (keys['s'] || keys['S']) speed = this.config.speedCrouch;\n        \n        return speed;\n    }\n    \n    updateWeapons() {\n        // Update weapon states\n        this.weapons.forEach(weapon => {\n            if (weapon.isActive) {\n                // Update ammo\n                if (weapon.ammo <= 0) {\n                    this.triggerHeatWarning(weapon);\n                }\n                \n                // Overheat system\n                if (weapon.heat >= this.config.heatMax) {\n                    this.applyHeatEffect(weapon);\n                }\n            }\n        });\n    }\n    \n    triggerHeatWarning(weapon) {\n        if (weapon.heat >= this.config.heatMax * 0.8) {\n            this.showWarning(`Heat Warning: ${weapon.name} - Overheating!`);\n        }\n    }\n    \n    applyHeatEffect(weapon) {\n        // Visual effect only - in a full implementation this would change weapon properties\n        weapon.heat += 5;\n        if (weapon.heat >= this.config.heatMax) {\n            this.applyHeatVisual(weapon);\n        }\n    }\n    \n    showWarning(message) {\n        // Simple alert-like message\n        alert(message);\n    }\n    \n    drawEnvironment() {\n        // Draw background layers\n        this.ctx.fillStyle = '#0D1020';\n        this.ctx.fillRect(0, 0, this.canvas.width, this.canvas.height);\n        \n        // Gradient sky\n        this.ctx.beginPath();\n        this.ctx.moveTo(0, this.canvas.height);\n        this.ctx.lineTo(this.canvas.width, this.canvas.height * 0.3);\n        this.ctx.quadraticCurveTo(this.canvas.width, this.canvas.height * 0.5, this.canvas.width, this.canvas.height * 0.75);\n        this.ctx.lineTo(this.canvas.width, this.canvas.height * 0.85);\n        this.ctx.quadraticCurveTo(this.canvas.width * 0.5, this.canvas.height * 0.9, 0, this.canvas.height * 0.95);\n        this.ctx.closePath();\n        this.ctx.fillStyle = '#1a2040';\n        this.ctx.fill();\n        \n        // Stars\n        this.drawStars();\n    }\n    \n    drawStars() {\n        for (let i = 0; i < 50; i++) {\n            const star = {\n                x: Math.random() * this.canvas.width,\n                y: Math.random() * this.canvas.height,\n                size: Math.random() * 2 + 0.5,\n                brightness: Math.random() * 0.8 + 0.2\n            };\n            this.ctx.fillStyle = `rgba(255, 255, 255, ${star.brightness})`;\n            this.ctx.beginPath();\n            this.ctx.arc(star.x, star.y, star.size, 0, Math.PI * 2);\n            this.ctx.fill();\n        }\n    }\n    \n    drawPlayer() {\n        // Draw player sprite with weapon overlay\n        const sx = this.canvas.width / 2 - this.player.x;\n        const sy = this.canvas.height / 2 - this.player.y;\n        \n        // Body\n        this.ctx.fillStyle = '#ff4444';\n        this.ctx.beginPath();\n        this.ctx.ellipse(sx, sy, 24, 34, 0, 0, Math.PI * 2);\n        this.ctx.fill();\n        \n        // Armor\n        this.ctx.fillStyle = '#2a1a3a';\n        this.ctx.beginPath();\n        this.ctx.ellipse(sx, sy, 26, 38, 0, 0, Math.PI * 2);\n        this.ctx.fill();\n        \n        // Weapon attachment\n        if (this.weapons.length > 0 && this.weapons[0].isActive) {\n            const weapon = this.weapons[0];\n            const wX = sx + weapon.attachmentX;\n            const wY = sy + weapon.attachmentY;\n            \n            // Weapon barrel\n            this.ctx.fillStyle = '#00E5FF';\n            this.ctx.fillRect(wX - 4, wY - 8, 6, 16);\n            \n            // Weapon glow\n            this.ctx.shadowColor = '#00E5FF';\n            this.ctx.shadowBlur = 15;\n            this.ctx.fillRect(wX - 2, wY - 6, 4, 8);\n            this.ctx.shadowBlur = 0;\n        }\n    }\n    \n    drawWeapons() {\n        // Draw active weapon\n        if (this.weapons.length > 0 && this.weapons[0].isActive) {\n            const weapon = this.weapons[0];\n            const wx = this.canvas.width / 2 - weapon.x;\n            const wy = this.canvas.height / 2 - weapon.y;\n            \n            // Weapon body\n            this.ctx.fillStyle = weapon.color;\n            this.ctx.fillRect(wx - 4, wy - 8, 6, 16);\n            \n            // Glow\n            this.ctx.shadowColor = weapon.color;\n            this.ctx.shadowBlur = 20;\n            this.ctx.fillRect(wx - 2, wy - 6, 4, 8);\n            this.ctx.shadowBlur = 0;\n        }\n    }\n    \n    drawParticles() {\n        this.particles.forEach(p => {\n            this.ctx.globalAlpha = p.life;\n            this.ctx.fillStyle = p.color;\n            this.ctx.fillRect(p.x - p.size/2, p.y - p.size/2, p.size, p.size);\n            this.ctx.globalAlpha = 1.0;\n        });\n    }\n    \n    updateHUD() {\n        // Health bar\n        const healthPercent = this.gameState.health / this.gameState.maxHealth;\n        this.healthFill.style.width = healthPercent * 100 + '%';\n        \n        // Weapon indicator\n        const currentWeaponIdx = this.getCurrentWeaponIndex();\n        const currentWeapon = this.weapons[currentWeaponIdx];\n        \n        if (currentWeapon) {\n            this.weaponIndicator.style.background = currentWeapon.color;\n            this.weaponIndicator.innerHTML = `<span>${currentWeapon.name}</span>`;\n            this.weaponIndicator.className = `weapon-indicator ${currentWeapon.isActive ? ' active' : ''}`;\n        }\n        \n        // Score\n        this.scoreDisplay.textContent = `SCORE: ${this.gameState.score}`;\n        \n        // High score\n        const best = this.gameState.highScore;\n        if (best > 0) {\n            this.highScoreDisplay.textContent = `BEST: ${best}`;\n        }\n    }\n}\n\n// Initialize the game when DOM is loaded\ndocument.addEventListener('DOMContentLoaded', () => {\n    new ArsenalShiftGame();\n});\n",
  "src/config/physics.js": "// Physics configuration for Arsenal Shift\nconst PHYSICS = {\n    // Movement speeds (px/s)\n    SPEED_WALK: 120,\n    SPEED_SPRINT: 200,\n    SPEED_CRAWL: 60,\n    \n    // Acceleration parameters\n    ACCELERATION_TIME: 0.15,\n    DAMPING_FACTOR: 0.85,\n    \n    // Weapon modifiers\n    WEAPON_MODIFIERS: {\n        Heavy: {\n            speedMultiplier: 0.6,\n            massModifier: 0.5,\n            knockbackReduction: 0.5,\n            dashCooldown: 0.8\n        },\n        Light: {\n            speedMultiplier: 1.3,\n            massModifier: 1.25,\n            knockbackIncrease: 0.25,\n            dashCooldown: 0.6\n        },\n        Special: {\n            speedMultiplier: 1.1,\n            massModifier: 0.8,\n            knockbackIncrease: 0.5,\n            dashCooldown: 0.4\n        }\n    },\n    \n    // Timing\n    SPRINT_COOLDOWN: 3,      // seconds\n    CRAWL_COOLDOWN: 5,       // seconds\n    DASH_COOLDOWN: 0.8,      // seconds\n    HEAT_MAX: 100,\n    HEAT_COOLDOWN: 2         // seconds\n},\n\n// Color palette for the game (vibrant neon cyberpunk)\nconst COLOR_PALETTE = {\n    base: '#2E0854',          // Deep purple base\n    accent1: '#00E5FF',       // Electric cyan (primary)\n    accent2: '#FF006C',       // Magenta (secondary)\n    accent3: '#CCFF00',       // Lime green (highlight)\n    accent4: '#00FF88',       // Bright green (energy)\n    background: '#0D1020',     // Very dark navy\n    surface: '#1a2040',       // Dark surface tone\n    weapon_heavy: '#7B2FF7',   // Purple heavy weapon tint\n    weapon_light: '#FF6B35',   // Orange light weapon tint\n    weapon_special: '#FF2E63', // Pink special weapon tint\n    text: '#00E5FF',\n    shadow: 'rgba(0, 229, 255, 0.3)',\n    danger: '#FF6B35'\n};\n\nmodule.exports = PHYSICS, COLOR_PALETTE;\n",
