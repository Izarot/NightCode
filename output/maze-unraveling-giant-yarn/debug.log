```javascript
class YarnSegment {
    constructor(x, y, w, h, color, type = 'wall') {
        this.x = x;
        this.y = y;
        this.w = w;
        this.h = h;
        this.color = color;
        this.type = type; // 'wall', 'start', 'exit'
        this.cut = false;
        this.thickness = 2 + Math.random() * 3; // 2-5px
        this.id = Math.random().toString(36).substr(2, 9);
    }
    
    draw(ctx) {
        if (this.cut) return;
        
        const cx = this.x + this.w / 2;
        const cy = this.y + this.h / 2;
        const halfW = this.w / 2;
        const halfH = this.h / 2;
        
        // Sine wave displacement
        const waveAmp = 1.5;
        const waveFreq = 0.15;
        const offsetX = Math.sin(Date.now() * 0.001 + this.id.charCodeAt(0)) * waveAmp;
        const offsetY = Math.cos(Date.now() * 0.001 + this.id.charCodeAt(1)) * waveAmp;
        
        ctx.save();
        
        // Glow for danger types
        if (this.type === 'danger') {
            ctx.shadowColor = this.color;
            ctx.shadowBlur = 8;
        } else if (this.type === 'exit') {
            ctx.shadowColor = '#FFD700';
            ctx.shadowBlur = 15;
        } else if (this.type === 'start') {
            ctx.shadowColor = '#00E5FF';
            ctx.shadowBlur = 10;
        }
        
        // Draw yarn as bezier curves
        ctx.strokeStyle = this.color;
        ctx.lineWidth = this.thickness;
        ctx.lineCap = 'round';
        
        // Draw multiple bezier curves for yarn texture
        const segments = 3;
        for (let i = 0; i < segments; i++) {
            const t = i / (segments - 1);
            const px = this.x + halfW + (this.w - halfW * 2) * t + offsetX * 0.3;
            const py = this.y + halfH + (this.h - halfH * 2) * t + offsetY * 0.3;
            
            ctx.beginPath();
            ctx.moveTo(this.x + halfW, this.y + halfH * 0.3);
            ctx.quadraticCurveTo(cx + offsetX * 0.5, cy + offsetY * 0.5, px, py);
            ctx.stroke();
        }
        
        // Border
        ctx.strokeStyle = 'rgba(0,0,0,0.3)';
        ctx.lineWidth = 1;
        ctx.strokeRect(this.x, this.y, this.w, this.h);
        
        ctx.restore();
    }
    
    intersects(point, radius) {
        // Check if a point with given radius intersects this rectangle
        const closestX = Math.max(this.x, Math.min(point.x, this.x + this.w));
        const closestY = Math.max(this.y, Math.min(point.y, this.y + this.h));
        const dx = point.x - closestX;
        const dy = point.y - closestY;
        return (dx * dx + dy * dy) < (radius * radius);
    }
    
    containsPoint(px, py) {
        return px >= this.x && px <= this.x + this.w && py >= this.y && py <= this.y + this.h;
    }
}
