Recursive Backtracker maze generation:

```javascript
class MazeGenerator {
    constructor(cols, rows, cellSize) {
        this.cols = cols;
        this.rows = rows;
        this.cellSize = cellSize;
        this.grid = [];
        this.walls = [];
        this.generate();
    }
    
    generate() {
        // Initialize grid
        for (let r = 0; r < this.rows; r++) {
            this.grid[r] = [];
            for (let c = 0; c < this.cols; c++) {
                this.grid[r][c] = {
                    visited: false,
