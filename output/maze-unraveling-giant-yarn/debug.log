class Player {
    constructor(x, y) {
        this.x = x;
        this.y = y;
        this.vx = 0;
        this.vy = 0;
        this.radius = 12;
        this.acceleration = 1200;
        this.friction = 0.85;
        this.maxSpeed = 220;
        this.angle = 0;
    }
    update(dt, input) {
        let ax = 0, ay = 0;
        if (input.up) ay -= this.acceleration;
        if (input.down) ay += this.acceleration;
        if (input.left) ax -= this.acceleration;
        if (input.right) ax += this.acceleration;
        this.vx += ax * dt;
        this.vy += ay * dt;
        this.vx *= this.friction;
        this.vy *= this.friction;
        const speed = Math.sqrt(this.vx * this.vx + this.vy * this.vy);
        if (speed > this.maxSpeed) {
            this.vx = (this.vx / speed) * this.maxSpeed;
            this.vy = (this.vy / speed) * this.maxSpeed;
        }
        this.x += this.vx * dt;
        this.y += this.vy * dt;
        if (Math.abs(this.vx) > 1) {
            this.angle = Math.atan2(this.vy, this.vx);
        }
    }
    draw(ctx) {
        ctx.save();
        ctx.translate(this.x, this.y);
        ctx.shadowColor = '#00E5FF';
        ctx.shadowBlur = 15;
        ctx.fillStyle = '#00E5FF';
        ctx.beginPath();
        ctx.arc(0, 0, this.radius, 0, Math.PI * 2);
        ctx.fill();
        ctx.fillStyle = 'rgba(255,255,255,0.4)';
        ctx.beginPath();
        ctx.arc(-3, -3, this.radius * 0.4, 0, Math.PI * 2);
        ctx.fill();
        ctx.restore();
    }
    getBounds() {
        return { x: this.x - this.radius, y: this.y - this.radius, w: this.radius * 2, h: this.radius * 2 };
    }
}

class YarnSegment {
    constructor(x, y, w, h, color, type = 'wall') {
        this.x = x;
        this.y = y;
        this.w = w;
        this.h = h;
        this.color = color;
        this.type = type;
        this.cut = false;
        this.thickness = 2 + Math.random() * 3;
        this.id = Math.random().toString(36).substr(2, 9);
    }
    draw(ctx) {
        if (this.cut) return;
        const cx = this.x + this.w / 2;
        const cy = this.y + this.h / 2;
        const halfW = this.w / 2;
        const halfH = this.h / 2;
        const waveAmp = 1.5;
        const waveFreq = 0.15;
        const t = Date.now() * 0.001;
        const offsetX = Math.sin(t + this.id.charCodeAt(0)) * waveAmp;
        const offsetY = Math.cos(t + this.id.charCodeAt(1)) * waveAmp;
        ctx.save();
        if (this.type === 'danger') {
            ctx.shadowColor = this.color;
            ctx.shadowBlur = 8;
        } else if (this.type === 'exit') {
            ctx.shadowColor = '#FFD700';
            ctx.shadowBlur = 15;
        } else if (this.type === 'start') {
            ctx.shadowColor = '#00E5FF';
            ctx.shadowBlur = 10;
        }
        ctx.strokeStyle = this.color;
        ctx.lineWidth = this.thickness;
        ctx.lineCap = 'round';
        const segments = 3;
        for (let i = 0; i < segments; i++) {
            const segT = i / (segments - 1);
            const px = this.x + halfW + (this.w - halfW * 2) * segT + offsetX * 0.3;
            const py = this.y + halfH + (this.h - halfH * 2) * segT + offsetY * 0.3;
            ctx.beginPath();
            ctx.moveTo(this.x + halfW, this.y + halfH * 0.3);
            ctx.quadraticCurveTo(cx + offsetX * 0.5, cy + offsetY * 0.5, px, py);
            ctx.stroke();
        }
        ctx.strokeStyle = 'rgba(0,0,0,0.3)';
        ctx.lineWidth = 1;
        ctx.strokeRect(this.x, this.y, this.w, this.h);
        ctx.restore();
    }
    intersects(px, py, radius) {
        const closestX = Math.max(this.x, Math.min(px, this.x + this.w));
        const closestY = Math.max(this.y, Math.min(py, this.y + this.h));
        const dx = px - closestX;
        const dy = py - closestY;
        return (dx * dx + dy * dy) < (radius * radius);
    }
    containsPoint(px, py) {
        return px >= this.x && px <= this.x + this.w && py >= this.y && py <= this.y + this.h;
    }
}

class LooseFiber {
    constructor(x, y, w, h, color) {
        this.x = x;
        this.y = y;
        this.oldX = x;
        this.oldY = y;
        this.w = w;
        this.h = h;
        this.color = color;
        this.gravity = 1200;
        this.friction = 0.95;
        this.settled = false;
        this.alpha = 0.7;
    }
    update(dt, walls) {
        if (this.settled) return;
        const vx = (this.x - this.oldX) * this.friction;
        const vy = (this.y - this.oldY) * this.friction;
        this.oldX = this.x;
        this.oldY = this.y;
        this.x += vx;
        this.y += vy;
        this.y += this.gravity * dt;
        if (this.y + this.h / 2 > window.innerHeight) {
            this.y = window.innerHeight - this.h / 2;
            this.oldY = this.y;
        }
        for (const wall of walls) {
            if (wall.cut || wall.type === 'loose') continue;
            if (this.x < wall.x + wall.w &&
                this.x + this.w > wall.x &&
                this.y < wall.y + wall.h &&
                this.y + this.h > wall.y) {
                const overlapLeft = (this.x + this.w) - wall.x;
                const overlapRight = (wall.x + wall.w) - this.x;
                const overlapTop = (this.y + this.h) - wall.y;
                const overlapBottom = (wall.y + wall.h) - this.y;
                const minOverlap = Math.min(overlapLeft, overlapRight, overlapTop, overlapBottom);
                if (minOverlap === overlapLeft) {
                    this.x = wall.x - this.w;
                    this.oldX = this.x;
                } else if (minOverlap === overlapRight) {
                    this.x = wall.x + wall.w;
                    this.oldX = this.x;
                } else if (minOverlap === overlapTop) {
                    this.y = wall.y - this.h;
                    this.oldY = this.y;
                } else {
                    this.y = wall.y + wall.h;
                    this.oldY = this.y;
                }
            }
        }
        const speed = Math.abs(this.x - this.oldX) + Math.abs(this.y - this.oldY);
        if (speed < 0.5 && this.y + this.h / 2 >= window.innerHeight - 1) {
            this.settled = true;
        }
    }
    draw(ctx) {
        ctx.save();
        ctx.globalAlpha = this.alpha;
        ctx.strokeStyle = this.color;
        ctx.lineWidth = 1.5;
        ctx.beginPath();
        ctx.moveTo(this.x, this.y);
        ctx.lineTo(this.x + this.w, this.y + this.h);
        ctx.stroke();
        ctx.restore();
    }
}

class Particle {
    constructor(x, y, vx, vy, color, life, size) {
        this.x = x;
        this.y = y;
        this.vx = vx;
        this.vy = vy;
        this.color = color;
        this.life = life;
        this.maxLife = life;
        this.size = size;
    }
    update(dt) {
        this.x += this.vx * dt;
        this.y += this.vy * dt;
        this.vy += 400 * dt;
        this.life -= dt;
    }
    draw(ctx) {
        const alpha = this.life / this.maxLife;
        ctx.save();
        ctx.globalAlpha = alpha * 0.8;
        ctx.strokeStyle = this.color;
        ctx.lineWidth = this.size;
        ctx.beginPath();
        ctx.moveTo(this.x, this.y);
        ctx.lineTo(this.x + this.vx * 0.05, this.y + this.vy * 0.05);
        ctx.stroke();
        ctx.restore();
    }
    isDead() {
        return this.life <= 0;
    }
}

class Checkpoint {
    constructor(x, y) {
        this.x = x;
        this.y = y;
        this.activated = false;
    }
    draw(ctx) {
        ctx.save();
        ctx.fillStyle = this.activated ? 'rgba(0,229,255,0.3)' : 'rgba(0,229,255,0.1)';
        ctx.beginPath();
        ctx.arc(this.x, this.y, 8, 0, Math.PI * 2);
        ctx.fill();
        ctx.strokeStyle = this.activated ? '#00E5FF' : 'rgba(0,229,255,0.3)';
        ctx.lineWidth = 2;
        ctx.stroke();
        ctx.restore();
    }
}

class Spider {
    constructor(x, y, path) {
        this.x = x;
        this.y = y;
        this.path = path;
        this.pathIndex = 0;
        this.speed = 60;
        this.radius = 10;
        this.alive = true;
    }
    update(dt) {
        if (!this.alive) return;
        const target = this.path[this.pathIndex];
        const dx = target.x - this.x;
        const dy = target.y - this.y;
        const dist = Math.sqrt(dx * dx + dy * dy);
        if (dist < 5) {
            this.pathIndex = (this.pathIndex + 1) % this.path.length;
        } else {
            this.x += (dx / dist) * this.speed * dt;
            this.y += (dy / dist) * this.speed * dt;
        }
    }
    draw(ctx) {
        if (!this.alive) return;
        ctx.save();
        ctx.translate(this.x, this.y);
        ctx.fillStyle = '#8A1C1C';
        ctx.beginPath();
        ctx.arc(0, 0, this.radius, 0, Math.PI * 2);
        ctx.fill();
        ctx.fillStyle = '#FF0000';
        ctx.beginPath();
        ctx.arc(-3, -2, 2, 0, Math.PI * 2);
        ctx.arc(3, -2, 2, 0, Math.PI * 2);
        ctx.fill();
        ctx.restore();
    }
}


#### maze.js

javascript
class MazeGenerator {
    constructor(cols, rows, cellSize) {
        this.cols = cols;
        this.rows = rows;
        this.cellSize = cellSize;
        this.grid = [];
        this.walls = [];
        this.generate();
    }
    generate() {
        for (let r = 0; r < this.rows; r++) {
            this.grid[r] = [];
            for (let c = 0; c < this.cols; c++) {
                this.grid[r][c] = {
                    visited: false,
                    walls: [true, true, true, true],
                };
            }
        }
        const stack = [];
        const startCell = { col: 0, row: 0 };
        this.grid[0][0].visited = true;
        stack.push(startCell);
        while (stack.length > 0) {
            const current = stack[stack.length - 1];
