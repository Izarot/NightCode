// Player class
class Player {
    constructor(x, y) {
        this.x = x;
        this.y = y;
        this.vx = 0;
        this.vy = 0;
        this.radius = 12;
        this.acceleration = 1200;
        this.friction = 0.85;
        this.maxSpeed = 220;
        this.angle = 0;
    }
    
    update(dt, input) {
        let ax = 0, ay = 0;
        if (input.up) ay -= this.acceleration;
        if (input.down) ay += this.acceleration;
        if (input.left) ax -= this.acceleration;
        if (input.right) ax += this.acceleration;
        
        this.vx += ax * dt;
        this.vy += ay * dt;
        
        // Apply friction
        this.vx *= Math.pow(this.friction, dt * 60);
        this.vy *= Math.pow(this.friction, dt * 60);
        
        // Cap speed
        const speed = Math.sqrt(this.vx * this.vx + this.vy * this.vy);
        if (speed > this.maxSpeed) {
            this.vx = (this.vx / speed) * this.maxSpeed;
            this.vy = (this.vy / speed) * this.maxSpeed;
        }
        
        this.x += this.vx * dt;
        this.y += this.vy * dt;
        
        // Update angle based on horizontal movement
        if (Math.abs(this.vx) > 1) {
            this.angle = Math.atan2(this.vy, this.vx);
        }
    }
    
    draw(ctx) {
        ctx.save();
        ctx.translate(this.x, this.y);
        
        // Glow
        ctx.shadowColor = '#00E5FF';
        ctx.shadowBlur = 15;
        
        // Body
        ctx.fillStyle = '#00E5FF';
        ctx.beginPath();
        ctx.arc(0, 0, this.radius, 0, Math.PI * 2);
        ctx.fill();
        
        // Inner highlight
        ctx.fillStyle = 'rgba(255,255,255,0.4)';
        ctx.beginPath();
        ctx.arc(-3, -3, this.radius * 0.4, 0, Math.PI * 2);
        ctx.fill();
        
        ctx.restore();
    }
    
    getBounds() {
        return { x: this.x - this.radius, y: this.y - this.radius, w: this.radius * 2, h: this.radius * 2 };
    }
}
