```javascript
import { Player } from './physics/Player.js';
import { Handhold } from './mechanics/Handhold.js';
import { IntegrityTracker } from './mechanics/Integrity.js';
import { ProceduralGenerator } from './generation/Procedural.js';
import { Renderer } from './rendering/CanvasRenderer.js';
import { HUD } from './ui/HUD.js';

const canvas = document.getElementById('gameCanvas');
const ctx = canvas.getContext('2d');

let W = 0, H = 0;
function resize() {
  W = canvas.width = window.innerWidth;
  H = canvas.height = window.innerHeight;
}
resize();
window.addEventListener('resize', resize);

// Game state
const STATE = { START: 0, PLAYING: 1, ZENITH: 2, GAMEOVER: 3 };
let state = STATE.START;

let player, handholds, integrity, generator, renderer, hud;
let startTime = 0;
let elapsedTime = 0;
let highScore = parseInt(localStorage.getItem('tc_highscore') || '0', 10);
let shakeAmount = 0;
let zenithTimer = 0;

// Input
let inputX = 0, inputY = 0;
let inputActive = false;

function getInputPos(e) {
  const rect = canvas.getBoundingClientRect();
  const t = e.touches ? e.touches[0] : e;
  return { x: t.clientX - rect.left, y: t.clientY - rect.top };
}

canvas.addEventListener('touchstart', (e) => {
  e.preventDefault();
  const p = getInputPos(e);
  inputX = p.x; inputY = p.y; inputActive = true;
}, { passive: false });

canvas.addEventListener('touchmove', (e) => {
  e.preventDefault();
  const p = getInputPos(e);
  inputX = p.x; inputY = p.y;
}, { passive: false });

canvas.addEventListener('touchend', () => { inputActive = false; }, { passive: false });

canvas.addEventListener('mousedown', (e) => {
  const p = getInputPos(e);
  inputX = p.x; inputY = p.y; inputActive = true;
});
canvas.addEventListener('mousemove', (e) => {
  const p = getInputPos(e);
  inputX = p.x; inputY = p.y;
});
canvas.addEventListener('mouseup', () => { inputActive = false; });

// Keyboard
document.addEventListener('keydown', (e) => {
  if (e.code === 'Space') { e.preventDefault(); tryJump(); }
  if (e.code === 'KeyP') { tryPlace(); }
});

function tryJump() {
  if (state !== STATE.PLAYING) return;
  player.wallJump();
}

function tryPlace() {
  if (state !== STATE.PLAYING) return;
  player.placeHandhold();
}

// Initialize
function initGame() {
  player = new Player(W / 2, H - 100);
  handholds = [];
  integrity = new IntegrityTracker();
  generator = new ProceduralGenerator(W);
  renderer = new Renderer(ctx);
  hud = new HUD();
  startTime = performance.now();
  elapsedTime = 0;
  shakeAmount = 0;
  zenithTimer = 0;
  // Pre-generate some handholds
  generator.generateInitial(player.y);
}

document.getElementById('startBtn').addEventListener('click', () => {
  document.getElementById('startScreen').style.display = 'none';
  initGame();
  state = STATE.PLAYING;
});

document.getElementById('restartBtn').addEventListener('click', () => {
  document.getElementById('gameOver').style.display = 'none';
  initGame();
  state = STATE.PLAYING;
});

// Game loop
let lastTime = performance.now();
function loop(now) {
  const dt = Math.min((now - lastTime) / 16.67, 2); // normalized to 60fps frames
  lastTime = now;
  update(dt);
  render();
  requestAnimationFrame(loop);
}

function update(dt) {
  if (state === STATE.PLAYING) {
    elapsedTime = (performance.now() - startTime) / 1000;
    player.update(dt, handholds, generator);
    checkHandholdGrab(dt);
    checkFallPast(dt);
    generator.update(player.y);
    integrity.update(dt);
    // Check zenith
    if (player.y < generator.highestY() - 200 && player.climbProgress > 0.95) {
      triggerZenith();
    }
    // Camera
    renderer.camera.y += (player.y - renderer.camera.y) * 0.1 * dt;
    renderer.camera.x += ((player.x - renderer.camera.x) * 0.1 * dt);
    // Shake decay
    shakeAmount *= Math.pow(0.85, dt);
    // HUD update
    hud.update(elapsedTime, integrity, player.altitude, player.climbProgress);
  } else if (state === STATE.ZENITH) {
    zenithTimer += dt;
    player.update(dt, handholds, generator);
    generator.update(player.y);
    renderer.camera.y += (player.y - renderer.camera.y) * 0.1 * dt;
    if (zenithTimer > 90) { // ~1.5 seconds
      state = STATE.PLAYING;
      generator.resetForNextSection();
      hud.flashZenithDone();
    }
  }
}

function triggerZenith() {
  state = STATE.ZENITH;
  zenithTimer = 0;
  hud.showZenithBanner();
  playSound('zenith');
  // Save high score
  const score = Math.floor(player.altitude);
  if (score > highScore) {
    highScore = score;
    localStorage.setItem('tc_highscore', String(highScore));
  }
}

function checkHandholdGrab(dt) {
  for (const h of handholds) {
    if (!h.grabbed && h.withinGrabRange(player)) {
      h.grabbed = true;
      player.clinging = true;
      player.vx = 0;
      player.vy = 0;
      playSound('grab');
    }
  }
}

function checkFallPast(dt) {
