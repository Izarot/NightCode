export class Renderer {
  constructor(ctx) {
    this.ctx = ctx;
    this.camera = { x: 0, y: 0 };
  }

  render(player, handholds, generator) {
    const ctx = this.ctx;
    ctx.clearRect(0, 0, generator.wallWidth, window.innerHeight);
    
    // Background gradient based on height
    const heightFactor = Math.min(1, player.altitude / 5000);
    const bgGrad = ctx.createLinearGradient(0, 0, 0, window.innerHeight);
    bgGrad.addColorStop(0, lerpColor('#0f172a', '#1e1b4b', heightFactor));
    bgGrad.addColorStop(1, lerpColor('#0f172a', '#0c4a6e', heightFactor));
    ctx.fillStyle = bgGrad;
    ctx.fillRect(0, 0, generator.wallWidth, window.innerHeight);
    
    // Parallax background
    this.drawParallax(generator, player);
    
    // Wall texture
    this.drawWallTexture(generator);
    
    // Threads
    this.drawThreads(handholds);
    
    // Handholds
    for (const h of handholds) {
      if (!h.failed) this.drawHandhold(h);
    }
    
    // Particles
    this.drawParticles();
    
    // Placement indicator
    this.drawPlacementIndicator(player);
    
    // Player
    this.drawPlayer(player);
  }
  
  // ... more methods
}


