javascript
export class ProceduralGenerator {
  constructor(width) {
    this.width = width;
    this.wallWidth = width;
    this.handholds = [];
    this.highestY = 0;
    this.totalHeight = 0;
    this.sectionCount = 0;
  }

  generateInitial(startY) {
    this.handholds.push(new Handhold(this.width / 2, startY));
    this.highestY = startY;
    this.sectionCount = 1;
    this.generateMore(startY - 400);
  }

  generateMore(targetY) {
    while (this.highestY > targetY) {
      this.highestY -= 200 + Math.floor(Math.random() * 100);
      this.sectionCount++;
      const x = this.width * (0.2 + Math.random() * 0.6);
      const y = this.highestY;
      this.handholds.push(new Handhold(x, y));
      // Sometimes add multiple handholds per section
      if (Math.random() > 0.5) {
        const x2 = this.width * (0.2 + Math.random() * 0.6);
        this.handholds.push(new Handhold(x2, y - 50));
      }
    }
  }

  update(playerY) {
    this.generateMore(playerY - 600);
  }

  resetForNextSection() {
    // Keep existing handholds, generate new ones above
    this.generateMore(this.highestY - 400);
  }

  highestY() {
    return this.highestY;
  }

  totalHeight() {
    return this.sectionCount * 300;
  }
}


Now the IntegrityTracker:

javascript
export class IntegrityTracker {
  constructor() {
    this.value = 100;
    this.threshold = 50;
  }

  add(amount) {
    this.value = Math.min(100, this.value + amount);
  }

  subtract(amount) {
    this.value = Math.max(0, this.value - amount);
  }

  update(dt) {
    // Slow decay over time
    this.value = Math.max(0, this.value - 0.02 * dt);
  }

  isAlive() {
    return this.value >= this.threshold;
  }
}


