export class Handhold {
  constructor(x, y) {
    this.x = x;
    this.y = y;
    this.snapY = y + 15;
    this.snapped = false;
    this.grabbed = false;
    this.failed = false;
    this.connections = [];
    this.threadIntegrity = 0;
    this.pulse = 0;
    this.scale = 0;
    this.alpha = 1;
  }

  update(dt) {
    if (!this.snapped) {
      this.y += 0.5 * dt;
      if (this.y >= this.snapY) {
        this.snapped = true;
        this.y = this.snapY;
      }
    }
    if (this.snapped) {
      this.scale = Math.min(1, this.scale + 0.1 * dt);
      this.pulse += 0.05 * dt;
    }
  }

  connectTo(other) {
    if (!this.connections.includes(other)) {
      this.connections.push(other);
      other.connections.push(this);
      this.threadIntegrity += 10;
    }
  }

  tryConnect(allHandholds) {
    let nearest = null;
    let minDist = 40;
    for (const h of allHandholds) {
      if (h === this || h.failed) continue;
      const dx = this.x - h.x;
      const dy = this.y - h.y;
      const dist = Math.sqrt(dx * dx + dy * dy);
      if (dist < minDist) {
        minDist = dist;
        nearest = h;
      }
    }
    if (nearest) {
      this.connectTo(nearest);
      return true;
    }
    return false;
  }
}


