javascript
export class Player {
  constructor(x, y) {
    this.x = x;
    this.y = y;
    this.vx = 0;
    this.vy = 0;
    this.clinging = false;
    this.altitude = 0;
    this.climbProgress = 0;
    this.maxAltitude = 0;
    this.radius = 12;
    this.fallAnim = 0;
  }

  update(dt, handholds, generator) {
    // Gravity
    if (!this.clinging) {
      this.vy += 0.4 * dt;
      this.vy = Math.min(this.vy, 8);
    } else {
      this.vy *= 0.8;
      if (Math.abs(this.vy) < 0.1) this.vy = 0;
    }

    // Horizontal friction
    this.vx *= Math.pow(0.85, dt);

    // Apply velocity
    this.x += this.vx * dt;
    this.y += this.vy * dt;

    // Clamp to wall bounds
    this.x = Math.max(this.radius, Math.min(generator.wallWidth - this.radius, this.x));

    // Update altitude
    const alt = Math.max(0, generator.highestY());
    this.altitude = Math.max(this.altitude, alt - this.y);
    this.climbProgress = this.altitude / (generator.totalHeight || 1);
    this.maxAltitude = Math.max(this.maxAltitude, this.altitude);

    // Fall animation
    if (this.fallAnim > 0) {
      this.fallAnim -= dt;
    }
  }

  wallJump() {
    if (!this.clinging) return;
    this.vx = (this.x < generator.wallWidth / 2 ? -1 : 1) * 6;
    this.vy = -7;
    this.clinging = false;
    this.fallAnim = 15;
    playSound('jump');
  }

  placeHandhold() {
    if (!this.clinging) return;
    const h = new Handhold(this.x, this.y);
    handholds.push(h);
    this.clinging = false;
    this.fallAnim = 15;
    playSound('drop');
  }

  grabHandhold(h) {
    this.clinging = true;
    this.vx = 0;
    this.vy = 0;
  }

  withinGrabRange(h) {
    const dx = this.x - h.x;
    const dy = this.y - h.y;
    return Math.sqrt(dx * dx + dy * dy) < 40;
  }

  belowHandhold(h) {
    return this.y > h.y + 20 && !h.grabbed;
  }
}


