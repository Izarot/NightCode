  "styles.css": "\n    * {\n        margin: 0;\n        padding: 0;\n        box-sizing: border-box;\n    }\n\n    body {\n        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;\n        background: #1a1a2e;\n        overflow: hidden;\n        height: 100vh;\n        display: flex;\n        justify-content: center;\n        align-items: center;\n    }\n\n    canvas {\n        display: block;\n        cursor: none;\n    }\n\n    /* Responsive Canvas */\n    #gameCanvas {\n        width: 100%;\n        height: 100%;\n        image-rendering: pixelated;\n        object-fit: contain;\n    }\n\n    /* HUD Styles */\n    #hud {\n        position: absolute;\n        bottom: 30px;\n        left: 50%;\n        transform: translateX(-50%);\n        z-index: 50;\n        display: flex;\n        gap: 20px;\n        background: rgba(15, 23, 42, 0.85);\n        backdrop-filter: blur(10px);\n        border-radius: 12px;\n        padding: 8px 16px;\n        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.5);\n    }\n\n    .lives-count {\n        color: #E74C3C;\n        font-size: 24px;\n        font-weight: 700;\n    }\n\n    .score-value {\n        font-size: 48px;\n        font-weight: 700;\n        color: #2C3E50;\n        text-shadow: 0 2px 4px rgba(0,0,0,0.5);\n    }\n\n    .speed-value {\n        font-size: 36px;\n        font-weight: 700;\n        color: #F1C40F;\n    }\n\n    .combo-value {\n        font-size: 28px;\n        color: #27AE60;\n    }\n\n    /* Menu Buttons */\n    .menu-btn {\n        padding: 14px 28px;\n        border: none;\n        border-radius: 8px;\n        background: linear-gradient(135deg, #2C3E50, #34495E);\n        color: #fff;\n        font-size: 18px;\n        cursor: pointer;\n        transition: all 0.2s ease;\n    }\n\n    .menu-btn:hover {\n        transform: translateY(-2px);\n        box-shadow: 0 6px 20px rgba(0,0,0,0.4);\n    }\n\n    .menu-btn.active {\n        background: linear-gradient(135deg, #E74C3C, #F39C12);\n        color: #fff;\n    }\n\n    /* Timer Display */\n    #timerDisplay {\n        position: absolute;\n        top: 10px;\n        right: 10px;\n        z-index: 100;\n        color: #F1C40F;\n        font-size: 22px;\n        font-weight: 700;\n        text-shadow: 0 1px 3px rgba(0,0,0,0.5);\n    }\n\n    /* Hidden elements */\n    #gameOver {\n        position: fixed;\n        inset: 0;\n        background: rgba(0,0,0,0.7);\n        display: flex;\n        align-items: center;\n        justify-content: center;\n        z-index: 200;\n        opacity: 0;\n        pointer-events: none;\n        transition: opacity 0.3s;\n    }\n\n    #gameOver.visible {\n        opacity: 1;\n        pointer-events: auto;\n    }\n\n    #gameOver h1 {\n        font-size: 48px;\n        color: #E74C3C;\n        text-shadow: 0 2px 10px rgba(231, 76, 60, 0.5);\n        margin-bottom: 20px;\n    }\n\n    #gameOver p {\n        font-size: 24px;\n        color: #ECF0F1;\n        margin-bottom: 30px;\n    }\n\n    #restartBtn {\n        padding: 14px 40px;\n        border: none;\n        border-radius: 8px;\n        background: #2C3E50;\n        color: #fff;\n        font-size: 20px;\n        cursor: pointer;\n        transition: all 0.2s;\n    }\n\n    #restartBtn:hover {\n        background: #34495E;\n    }\n\n    /* Animations */ \n    @keyframes pulse {\n        0%, 100% { opacity: 1; }\n        50% { opacity: 0.7; }\n    }\n\n    .animate-pulse {\n        animation: pulse 1s infinite;\n    }\n",
  "main.js": "// Main Game Loop & State Management\nimport { Player } from './player.js';\nimport { GroundManager } from './ground.js';\nimport { AudioEngine } from './audio.js';\nimport { UIManager } from './ui.js';\n\nclass Game {\n    constructor() {\n        this.canvas = document.getElementById('gameCanvas');\n        this.ctx = this.canvas.getContext('2d');\n        this.timerDisplay = document.getElementById('timerDisplay');\n        this.livesDisplay = document.getElementById('lives');\n        this.scoreDisplay = document.getElementById('score');\n        this.speedDisplay = document.getElementById('speed');\n        this.comboDisplay = document.getElementById('combo');\n        this.highScore = localStorage.getItem('runnerHighScore') || 0;\n        this.gameState = 'boot'; // boot, playing, paused, gameover\n        this.timerInterval = null;\n        this.lastTime = performance.now();\n        \n        // Initialize systems\n        this.audio = new AudioEngine();\n        this.player = new Player(this.canvas);\n        this.ground = new GroundManager(this.canvas);\n        this.ui = new UIManager(this.canvas, this.timerDisplay, this.livesDisplay, this.scoreDisplay, this.speedDisplay, this.comboDisplay);\n        this.highScore = parseInt(this.highScore, 10);\n        \n        // Difficulty scaling\n        this.baseSpeed = 120;\n        this.maxSpeed = 300;\n        this.speedMultiplier = 1.0;\n        \n        // Start\n        this.startGame();\n    }\n\n    startGame() {\n        this.gameState = 'playing';\n        this.resetPlayer();\n        this.resetGround();\n        this.audio.enable();\n        \n        // Reset HUD\n        this.livesDisplay.textContent = '❤️❤️❤️';\n        this.scoreDisplay.textContent = 'Score: 0';\n        this.speedDisplay.textContent = 'Speed: 120 px/s';\n        this.comboDisplay.textContent = 'Combo: 1';\n        this.timerDisplay.textContent = 'Time: 000s';\n        \n        // Start timer\n        this.timerInterval = setInterval(() => {\n            const seconds = Math.floor((Date.now() - this.lastTime) / 1000);\n            this.timerDisplay.textContent = `Time: ${seconds}`;\n            this.lastTime = Date.now();\n        }, 1000);\n        \n        // Initial ground placement\n        this.ground.spawnInitialTiles();\n    }\n\n    resetPlayer() {\n        this.player.position = { x: 0, y: 0 };\n        this.player.velocity = { x: 0, y: 0 };\n        this.player.isRunning = false;\n        this.player.isJumping = false;\n        this.player.isBoosting = false;\n        this.player.animFrame = 0;\n        this.player.animTimer = 0;\n    }\n\n    update(deltaTime) {\n        if (this.gameState !== 'playing') return;\n\n        // Apply delta time\n        const dt = Math.min(deltaTime, 0.1);\n        \n        // Player movement & physics\n        this.updatePlayer(dt);\n        \n        // Ground scrolling & gap generation\n        this.updateGround(dt);\n        \n        // Spawn obstacles & collectibles\n        this.spawnEntities(dt);\n        \n        // Check for game over conditions\n        if (this.checkFall()) {\n            this.endGame();\n        }\n        \n        // Update HUD\n        this.updateHUD();\n    }\n\n    updatePlayer(deltaTime) {\n        const speed = this.baseSpeed * this.speedMultiplier;\n        \n        // Horizontal movement (acceleration/deceleration)\n        if (this.player.isRunning && this.player.velocity.x < this.maxSpeed) {\n            this.player.velocity.x += this.speed * deltaTime;\n        } else if (!this.player.isRunning && this.player.velocity.x > 0) {\n            this.player.velocity.x -= this.speed * deltaTime;\n        }\n        \n        // Clamp speed\n        this.player.velocity.x = Math.min(this.maxSpeed, Math.max(-this.maxSpeed, this.player.velocity.x));\n        \n        // Jump logic\n        if (this.player.isJumping) {\n            this.player.velocity.y = -350; // Jump impulse\n            this.player.jumpTimer = 0;\n        } else {\n            // Gravity\n            this.player.velocity.y += 1000 * deltaTime;\n        }\n        \n        // Boost jump (double tap)\n        if (this.player.hasBoost && !this.player.isJumping) {\n            this.player.velocity.y += 200 * deltaTime;\n            this.player.isBoosting = true;\n        }\n        \n        // Animation timing\n        if (this.player.animFrame < 4) {\n            this.player.animTimer += deltaTime;\n            if (this.player.animTimer >= 0.12) {\n                this.player.animFrame = (this.player.animFrame + 1) % 4;\n                this.player.animTimer = 0;\n            }\n        }\n        \n        // Landing detection\n        if (this.player.velocity.y <= 0 && this.player.velocity.x === 0) {\n            this.player.isRunning = false;\n            this.player.velocity.y = 0;\n            this.player.animFrame = 0;\n        }\n    }\n\n    updateGround(deltaTime) {\n        // Move ground left\n        this.ground.scrollLeft = this.ground.scrollLeft + this.player.velocity.x * deltaTime;\n        \n        // Generate gaps every 1500px of player X progress\n        const playerX = this.player.position.x;\n        const gapProgress = Math.floor(playerX / 1500) * 1500;\n        \n        // Advance gap position\n        this.ground.currentGapPosition = gapProgress;\n        \n        // Remove old tiles\n        while (this.ground.tiles.length > 0 && this.ground.tiles[0].x < this.ground.currentGapPosition - 192) {\n            this.ground.tiles.shift();\n        }\n        \n        // Add new tiles\n        const newTileX = this.ground.currentGapPosition + 192;\n        this.ground.addTile(newTileX);\n    }\n\n    spawnEntities(deltaTime) {\n        // Cactus/Rock spawn every 200px\n        if (deltaTime * 200 > this.player.position.x) {\n            this.spawnEntity('rock', this.player.position.x + 50);\n        }\n        \n        // Flying enemy every 1200px\n        if (deltaTime * 1200 > this.player.position.x) {\n            this.spawnEntity('enemy', this.player.position.x + 80);\n        }\n        \n        // Coin every 300px\n        if (deltaTime * 300 > this.player.position.x) {\n            this.spawnEntity('coin', this.player.position.x + 30);\n        }\n        \n        // Power-up Shield every 2000px\n        if (deltaTime * 2000 > this.player.position.x) {\n            this.spawnEntity('shield', this.player.position.x + 40);\n        }\n        \n        // Power-up Double Jump every 2500px\n        if (deltaTime * 2500 > this.player.position.x) {\n            this.spawnEntity('doubleJump', this.player.position.x + 25);\n        }\n    }\n\n    spawnEntity(type, xOffset) {\n        const entityType = type.toLowerCase();\n        \n        switch(entityType) {\n            case 'rock':\n                this.createRock(xOffset, this.canvas.width / 2, this.canvas.height - 20);\n                break;\n            case 'enemy':\n                this.createEnemy(xOffset, this.canvas.width / 2, this.canvas.height - 60);\n                break;\n            case 'coin':\n                this.createCoin(xOffset, this.canvas.width / 2, this.canvas.height - 35);\n                break;\n            case 'shield':\n                this.createShield(xOffset, this.canvas.width / 2, this.canvas.height - 45);\n                break;\n            case 'doublejump':\n                this.createDoubleJump(xOffset, this.canvas.width / 2, this.canvas.height - 55);\n                break;\n        }\n    }\n\n    createRock(x, y, height) {\n        const rock = new Entity('rock', x, y, height);\n        rock.sprite = \'rock_30x30.png\'; // Placeholder path\n        rock.health = 1;\n        this.entities.push(rock);\n    }\n\n    createEnemy(x, y, height) {\n        const enemy = new Entity('enemy', x, y, height);\n        enemy.sprite = \'enemy_28x28.png\';\n        enemy.speed = 1.5;\n        this.entities.push(enemy);\n    }\n\n    createCoin(x, y, height) {\n        const coin = new Entity('coin', x, y, height);\n        coin.sprite = 'coin_24x24.png';\n        coin.value = 10;\n        this.entities.push(coin);\n    }\n\n    createShield(x, y, height) {\n        const shield = new Entity('shield', x, y, height);\n        shield.color = '#3498DB';\n        shield.active = true;\n        this.entities.push(shield);\n    }\n\n    createDoubleJump(x, y, height) {\n        const dj = new Entity('doublejump', x, y, height);\n        dj.multiplier = 2.0;\n        this.entities.push(dj);\n    }\n\n    checkFall() {\n        // Check if player is above ground level\n        const playerY = this.player.position.y;\n        if (playerY > this.canvas.height + 20) {\n            return true;\n        }\n        return false;\n    }\n\n    endGame() {\n        this.gameState = 'gameover';\n        this.audio.stopAll();\n        \n        // Update high score\n        let newScore = this.score;\n        if (newScore > this.highScore) {\n            this.highScore = newScore;\n            localStorage.setItem('runnerHighScore', this.highScore);\n            this.showHighScoreMessage();\n        }\n        \n        // Show game over screen\n        document.getElementById('gameOver').classList.add('visible');\n        this.timerDisplay.textContent = 'Time: 0s';\n    }\n\n    showHighScoreMessage() {\n        const msg = document.createElement('div');\n        msg.style = 'position:fixed;inset:0;background:rgba(0,0,0,0.8);display:flex;align-items:center;justify-content:center;z-index:150;color:#fff;'\n        msg.innerHTML = `<h1>🏆 New High Score! 🏆</h1><p>Score: ${this.highScore}</p>`;\n        document.body.appendChild(msg);\n        setTimeout(() => msg.remove(), 5000);\n    }\n}\n\n// Initialize game when DOM is ready\ndocument.addEventListener('DOMContentLoaded', () => {\n    window.game = new Game();\n});",
  "player.js": "// Player Class - Handles physics, animation, and input\n\nclass Player {\n    constructor(canvas) {\n        this.canvas = canvas;\n        this.ctx = canvas.getContext('2d');\n        this.position = { x: 0, y: 0 };\n        this.velocity = { x: 0, y: 0 };\n        this.isRunning = false;\n        this.isJumping = false;\n        this.isBoosting = false;\n        this.animFrame = 0;\n        this.animTimer = 0;\n        this.health = 3;\n        this.maxHealth = 3;\n        \n        // Animation states\n        this.animStates = {\n            idle: 0,\n            running: 1,\n            jumping: 2,\n            boosting: 3\n        };\n        \n        // Get screen dimensions\n        this.screenWidth = canvas.width;\n        this.screenHeight = canvas.height;\n    }\n\n    reset() {\n        this.position = { x: 0, y: 0 };\n        this.velocity = { x: 0, y: 0 };\n        this.isRunning = false;\n        this.isJumping = false;\n        this.isBoosting = false;\n        this.animFrame = 0;\n        this.animTimer = 0;\n        this.health = this.maxHealth;\n        this.animStates = {\n            idle: 0,\n            running: 1,\n            jumping: 2,\n            boosting: 3\n        };\n    }\n\n    update(deltaTime) {\n        // Determine if running (holding right arrow)\n        const isRunning = this.isRunning || (this.velocity.x > 0 && this.velocity.y < 0);\n        \n        if (isRunning) {\n            this.velocity.x += this.baseSpeed * deltaTime;\n        } else {\n            // Decelerate when not running\n            this.velocity.x *= 0.99;\n        }\n        \n        // Jump control\n        if (this.isJumping && this.velocity.y < 0) {\n            this.velocity.y = -350; // Jump impulse\n            this.isJumping = true;\n        } else if (this.isBoosting && this.velocity.y < 0) {\n            this.velocity.y = -350 + (this.isBoosting ? 200 : 0);\n            this.isBoosting = true;\n        } else {\n            this.isJumping = false;\n        }\n        \n        // Apply gravity\n        this.velocity.y += 1000 * deltaTime;\n        \n        // Boundary check - don't go below ground\n        if (this.velocity.y > 0) {\n            this.velocity.y = 0;\n        }\n        \n        // Update animation\n        if (this.animFrame < 4) {\n            this.animTimer += deltaTime;\n            if (this.animTimer >= 0.12) {\n                this.animFrame = (this.animFrame + 1) % 4;\n                this.animTimer = 0;\n            }\n        }\n    }\n\n    getBounds() {\n        return {\n            x: this.position.x,\n            y: this.position.y,\n            w: 40,\n            h: 40\n        };\n    }\n}", 
  "ground.js": "// Ground Manager - Handles scrolling tiles and gap generation\n\nclass GroundManager {\n    constructor(canvas) {\n        this.canvas = canvas;\n        this.ctx = canvas.getContext('2d');\n        this.tiles = [];\n        this.scrollLeft = 0;\n        this.currentGapPosition = 0;\n        this.gapLength = 192; // 3 tiles * 64px\n        \n        // Parallax layers\n        this.parallaxSpeeds = [0.2, 0.5, 0.8]; // mountain, hill, cloud\n    }\n\n    addTile(x) {\n        const tile = new GroundTile(x, this.canvas.height - 20);\n        this.tiles.push(tile);\n    }\n\n    removeOldTiles() {\n        // Remove tiles that have completely passed the gap position\n        while (this.tiles.length > 0 && this.tiles[0].x < this.currentGapPosition - this.gapLength) {\n            this.tiles.shift();\n        }\n    }\n\n    appendNewTile(x) {\n        this.tiles.push(new GroundTile(x, this.canvas.height - 20));\n    }\n\n    spawnInitialTiles() {\n        // Add enough tiles to cover the visible area plus buffer\n        const buffer = 200;\n        for (let i = 0; i < 10; i++) {\n            const x = buffer - i * 64;\n            this.addTile(x);\n        }\n    }\n\n    update(deltaTime) {\n        // Scroll ground left\n        this.scrollLeft += this.player.velocity.x * deltaTime;\n        \n        // Advance gap position\n        this.currentGapPosition += this.player.velocity.x * deltaTime;\n        \n        // Remove old tiles\n        this.removeOldTiles();\n        \n        // Add new tiles as needed\n        const nextX = this.currentGapPosition + this.gapLength;\n        if (nextX - this.scrollLeft > 64) {\n            this.appendNewTile(nextX);\n        }\n    }\n\n    // Draw ground tiles\n    draw() {\n        const ctx = this.ctx;\n        \n        // Draw existing tiles\n        for (const tile of this.tiles) {\n            if (tile.x + tile.w > 0 && tile.x < this.scrollLeft + this.gapLength) {\n                ctx.fillStyle = '#2C3E50';\n                ctx.fillRect(tile.x, tile.y, tile.w, tile.h);\n                \n                // Subtle gradient for depth\n                const grad = ctx.createLinearGradient(tile.x, tile.y, tile.x, tile.y + tile.h);\n                grad.addColorStop(0, '#34495E');\n                grad.addColorStop(1, '#2C3E50');\n                ctx.fillStyle = grad;\n                ctx.fillRect(tile.x, tile.y, tile.w, tile.h);\n            }\n        }\n        \n        // Draw gap overlay (vertical danger zone)\n        const gapStart = this.currentGapPosition;\n        const gapEnd = gapStart + this.gapLength;\n        \n        // Danger zone overlay (darkened)\n        ctx.fillStyle = 'rgba(0, 0, 0, 0.3)';\n        ctx.fillRect(gapStart, 0, this.gapLength, this.canvas.height);\n        \n        // Center marker for gap warning\n        ctx.fillStyle = '#E74C3C';\n        ctx.beginPath();\n        ctx.arc(gapStart + this.gapLength/2, this.canvas.height/2, 6, 0, Math.PI * 2);\n        ctx.fill();\n    }\n}", 
  "audio.js": "// Audio Engine - Web Audio API sound effects\n\nclass AudioEngine {\n    constructor() {\n        this.oscillator = null;\n        this.buffer = null;\n        this.sources = new Set();\n    }\n\n    enable() {\n        // Create audio context (must be triggered by user interaction or autoplay policy)\n        if (!this.audioContext) {\n            this.audioContext = new (window.AudioContext || window.webkitAudioContext)();\n        }\n        \n        // Preload sound samples\n        this.preloadSounds();\n    }\n\n    preloadSounds() {\n        // Jump sound\n        const jumpBuffer = this.audioContext.createBuffer(2, 22050, 44100);\n        const jumpData = new Uint8Array(jumpBuffer.getLength());\n        // Simple sine wave pattern for jump\n        for (let i = 0; i < jumpBuffer.getLength(); i++) {\n            const t = i / 44100;\n            const freq = 800 + Math.sin(t * 10) * 200;\n            const sample = Math.floor(127 * Math.abs(Math.sin(2 * Math.PI * freq * t)));\n            jumpData.setUint8(i, sample);\n        }\n        this.buffer = jumpBuffer;\n        this.sources.add('jump');\n        \n        // Coin collect sound\n        const coinBuffer = this.audioContext.createBuffer(2, 22050, 44100);\n        const coinData = new Uint8Array(coinBuffer.getLength());\n        for (let i = 0; i < coinBuffer.getLength(); i++) {\n            const t = i / javascript
        for (let i = 0; i < coinBuffer.getLength(); i++) {
            const t = i / 44100;
            const freq = 600 + Math.sin(t * 15) * 300;
            const sample = Math.floor(128 * Math.abs(Math.sin(2 * Math.PI * freq * t)));
            coinData.setUint8(i, sample);
        }
        this.buffer = coinBuffer;
