  "index.html": "<!DOCTYPE html>\\n<html lang=\\\"en\\\">\\n<head>\\n<meta charset=\\\"UTF-8\\\">\\n<title>Bloat &amp; Bounds</title>\\n<link rel=\\\"icon\\\" href=\\\"data:image/svg+xml;utf8,<svg xmlns=\\\"http://www.w3.org/2000/svg\\\" viewBox=\\\"0 0 100 100\\\"><text y=\\\"0.9em\\\" font-size=\\\"80\\\">🐙</text></svg>\\\" type=\\\"image/svg+xml\\\">\\n<style>\\ncanvas { background:#111; display:block; margin:0 auto; }\\n</style>\\n</head>\\n<body>\\n<canvas id=\\\"gameCanvas\\\" width=\\\"800\\\" height=\\\"600\\\"></canvas>\\n<script src=\\\"main.js\\\"></script>\\n</body>\\n</html>",
  "main.js": "import { Game } from './src/core/engine.js';\nimport Input from './src/core/input.js';\nimport { HUD } from './src/ui/hud.js';\nimport { PauseOverlay } from './src/ui/pause.js';\nimport { GameOverScreen } from './src/ui/gameover.js';\nimport { SettingsMenu } from './src/ui/settings.js';\nimport { Persistence } from './src/core/persistence.js';\n\nconst canvas = document.getElementById('gameCanvas');\nconst ctx = canvas.getContext('2d');\n\nconst game = new Game(canvas, ctx);\nconst hud = new HUD(game);\nconst pauseOverlay = new PauseOverlay(game);\nconst gameOver = new GameOverScreen(game);\nconst settings = new SettingsMenu(game);\n\nInput.init();\n\ngame.init();\n\ngame.changeState = function(state) {\n  this.state = state;\n  if (state === 'play') {\n    this.lastTime = performance.now();\n    this.loop();\n  } else if (state === 'pause') {\n    pauseOverlay.show();\n  } else if (state === 'gameOver') {\n    gameOver.show();\n  } else if (state === 'menu') {\n    settings.show();\n  }\n};\n\ngame.loop = function() {\n  const now = performance.now();\n  const delta = now - this.lastTime;\n  this.lastTime = now;\n  this.update(delta);\n  this.render();\n  requestAnimationFrame(this.loop.bind(this));\n};\n\ngame.update = function(delta) {\n  if (this.state === 'play') {\n    this.player.update(delta);\n    this.entities.forEach(e => e.update(delta));\n    if (Input.isDown('KeyP')) {\n      this.changeState('pause');\n    }\n  }\n};\n\ngame.render = function() {\n  this.ctx.clearRect(0,0,this.width,this.height);\n  // draw entities\n  this.entities.forEach(e => e.render(this.ctx, this.camera));\n  if (this.player) this.player.render(this.ctx, this.camera);\n  this.renderHUD();\n  if (this.state === 'pause') pauseOverlay.render(this.ctx);\n  if (this.state === 'gameOver') gameOver.render(this.ctx);\n  if (this.state === 'menu') settings.render(this.ctx);\n};\n\ngame.renderHUD = function() {\n  hud.render(this.ctx);\n};\n\ngame.reset = function() {\n  this.state = 'boot';\n  this.lastTime = 0;\n  this.entities = [];\n  this.player = null;\n  this.score = 0;\n  this.highScore = 0;\n  this.levelIndex = 0;\n  Persistence.load();\n  this.changeState('boot');\n};\n\ngame.init = function() {\n  this.loadResources().then(() => {\n    this.player = new Player(this.canvas, this.ctx);\n    const loader = new LevelLoader(this);\n    loader.load(0);\n  });\n};\n\ngame.changeState = function(state) {\n  this.state = state;\n  if (state === 'play') {\n    this.lastTime = performance.now();\n    this.loop();\n  } else if (state === 'pause') {\n    pauseOverlay.show();\n  } else if (state === 'gameOver') {\n    gameOver.show();\n  } else if (state === 'menu') {\n    settings.show();\n  }\n};\n"
,
  "src/core/engine.js": "export class Game {\n  constructor(canvas, ctx) {\n    this.canvas = canvas;\n    this.ctx = ctx;\n    this.width = canvas.width;\n    this.height = canvas.height;\n    this.state = 'boot';\n    this.lastTime = 0;\n    this.accumulator = 0;\n    this.fixedStep = 1/60;\n    this.player = null;\n    this.entities = [];\n    this.camera = { x: 0, y: 0 };\n    this.score = 0;\n    this.highScore = 0;\n    this.loaded = false;\n    this.sprites = {};\n    this.audio = null;\n  }\n\n  init() {\n    this.loadResources().then(() => {\n      this.state = 'play';\n      this.loop();\n    });\n  }\n\n  async loadResources() {\n    // load sprites\n    const spritePromises = [\n      this.loadImage('assets/player.png', 'player'),\n      this.loadImage('assets/items.png', 'items'),\n      this.loadImage('assets/enemies.png', 'enemies')\n    ];\n    const [playerImg, itemsImg, enemiesImg] = await Promise.all(spritePromises);\n    this.sprites.player = playerImg;\n    this.sprites.items = itemsImg;\n    this.sprites.enemies = enemiesImg;\n\n    // load audio\n    this.audio = new AudioManager();\n    await this.audio.loadSounds();\n    this.loaded = true;\n  }\n\n  loadImage(src, key) {\n    return new Promise((resolve, reject) => {\n      const img = new Image();\n      img.src = src;\n      img.onload = () => resolve(img);\n      img.onerror = reject;\n    });\n  }\n\n  loop(timestamp) {\n    if (!this.loaded) {\n      this.lastTime = timestamp;\n      requestAnimationFrame(this.loop.bind(this));\n      return;\n    }\n    const delta = timestamp - this.lastTime;\n    this.lastTime = timestamp;\n    this.accumulator += delta;\n    this.update(this.fixedStep);\n    this.render();\n    requestAnimationFrame(this.loop.bind(this));\n  }\n\n  update(delta) {\n    if (this.state !== 'play') return;\n    this.player.update(delta);\n    this.entities.forEach(e => e.update(delta));\n    // camera follow\n    this.camera.x = this.player.x - this.width/2;\n    this.camera.y = this.player.y - this.height/2;\n  }\n\n  render() {\n    this.ctx.clearRect(0,0,this.width,this.height);\n    // draw entities\n    this.entities.forEach(e => e.render(this.ctx, this.camera));\n    if (this.player) this.player.render(this.ctx, this.camera);\n    this.renderHUD();\n  }\n\n  renderHUD() {\n    const ctx = this.ctx;\n    const sizeBarWidth = this.player.sizeFactor * 20;\n    ctx.fillStyle = '#2ECC71';\n    ctx.fillRect(10, 20, sizeBarWidth, 10);\n    ctx.fillStyle = '#000';\n    ctx.fillText(`Size: ${Math.round(this.player.sizeFactor*100)}%`, 30, 30);\n    ctx.fillStyle = '#FFD700';\n    ctx.fillText(`Score: ${this.score}`, this.width/2 - 50, 20);\n    ctx.fillStyle = '#FFF';\n    ctx.fillText(`Level ${this.levelIndex+1}`, 10, this.height-10);\n  }\n}\n",
  "src/core/input.js": "export const Input = {\n  keys: {},\n  init() {\n    window.addEventListener('keydown', e => {\n      this.keys[e.key] = true;\n    });\n    window.addEventListener('keyup', e => {\n      this.keys[e.key] = false;\n    });\n    // simple touch mapping to arrow keys\n    window.addEventListener('touchstart', e => {\n      const touch = e.touches[0];\n      if (touch.moveX > 30) this.keys['ArrowRight'] = true;\n      else if (touch.moveX < -30) this.keys['ArrowLeft'] = true;\n    });\n    window.addEventListener('touchend', () => {\n      this.keys['ArrowRight'] = false;\n      this.keys['ArrowLeft'] = false;\n    });\n  },\n  isDown(key) {\n    return !!this.keys[key];\n  }\n};\n",
  "src/core/persistence.js": "export const Persistence = {\n  save() {\n    const data = {\n      levelIndex: this.levelIndex,\n      score: this.score,\n      highScore: this.highScore,\n      sizeFactor: this.player?.sizeFactor ?? 1\n    };\n    localStorage.setItem('bloat_bounds_save', JSON.stringify(data));\n  },\n  load() {\n    const data = JSON.parse(localStorage.getItem('bloat_bounds_save'));\n    if (data) {\n      this.levelIndex = data.levelIndex ?? 0;\n      this.score = data.score ?? 0;\n      this.highScore = data.highScore ?? 0;\n      this.player?.setSizeFactor(data.sizeFactor ?? 1);\n    }\n  }\n};\n",
  "src/core/audio/manager.js": "export class AudioManager {\n  constructor() {\n    this.ctx = new (window.AudioContext || window.webkitAudioContext)();\n    this.sounds = {};\n    this.volume = 1.0;\n  }\n\n  async loadSounds() {\n    const soundFiles = {\n      collect: 'assets/collect.wav',\n      jump: 'assets/jump.wav',\n      hurt: 'assets/hurt.wav',\n      grow: 'assets/grow.wav',\n      complete: 'assets/complete.wav'\n    };\n    for (const [key, url] of Object.entries(soundFiles)) {\n      const response = await fetch(url);\n      const arrayBuffer = await response.arrayBuffer();\n      const audioBuffer = await this.ctx.decodeAudioData(arrayBuffer);\n      this.sounds[key] = audioBuffer;\n    }\n  }\n\n  play(name, loop = false) {\n    if (!this.sounds[name]) return;\n    const source = this.ctx.createBufferSource();\n    source.buffer = this.sounds[name];\n    const gain = this.ctx.createGain();\n    gain.gain.value = this.volume;\n    source.connect(gain);\n    gain.connect(this.ctx.destination);\n    source.start(0);\n    if (loop) source.loop = true;\n  }\n}\n",
  "src/entities/player.js": "export class Player {\n  constructor(canvas, ctx) {\n    this.canvas = canvas;\n    this.ctx = ctx;\n    this.width = canvas.width;\n    this.height = canvas.height;\n    this.x = 100;\n    this.y = this.height - 100;\n    this.vx = 0;\n    this.vy = 0;\n    this.baseRadius = 10;\n    this.sizeFactor = 1.0;\n    this.radius = this.baseRadius * this.sizeFactor;\n    this.maxVx = 6 * this.sizeFactor;\n    this.jumpForce = -15 * this.sizeFactor;\n    this.gravity = 0.8;\n    this.friction = 0.92;\n    this.onGround = false;\n    this.coyoteTimer = 0;\n    this.coyoteTime = 0.15;\n    this.jumpWindow = 0.3;\n    this.doubleJump = false;\n    this.shield = 0;\n    this.score = 0;\n    this.growth = 0;\n    this.groundY = this.height - 20;\n  }\n\n  update(delta) {\n    // coyote timer\n    if (this.onGround) {\n      this.coyoteTimer = this.coyoteTime;\n    } else {\n      this.coyoteTimer -= delta;\n    }\n\n    // horizontal input\n    if (Input.isDown('ArrowRight')) {\n      this.vx = Math.min(this.maxVx, this.vx + this.friction * 0.1);\n    } else if (Input.isDown('ArrowLeft')) {\n      this.vx = Math.max(-this.maxVx, this.vx - this.friction * 0.1);\n    } else {\n      this.vx *= this.friction;\n    }\n\n    // jump\n    if ((this.onGround || this.coyoteTimer > 0) && (Input.isDown('ArrowUp') || this.jumpWindow > 0)) {\n      this.vy = this.jumpForce;\n      this.onGround = false;\n      this.coyoteTimer = 0;\n      this.jumpWindow = 0.3;\n      this.doubleJump = true;\n    }\n\n    // gravity\n    this.vy += this.gravity * delta;\n\n    // update position\n    this.x += this.vx * delta;\n    this.y += this.vy * delta;\n\n    // ground check\n    if (this.y >= this.groundY) {\n      this.y = this.groundY;\n      this.vy = 0;\n      this.onGround = true;\n    } else {\n      this.onGround = false;\n    }\n\n    // growth timer\n    if (this.growth > 0) this.growth -= delta;\n  }\n\n  render(ctx, camera) {\n    const sx = this.x - camera.x;\n    const sy = this.y - camera.y;\n    ctx.save();\n    ctx.translate(sx, sy);\n    ctx.scale(this.sizeFactor, this.sizeFactor);\n    ctx.fillStyle = '#2ECC71';\n    ctx.fillRect(-10, -10, 20, 20);\n    ctx.restore();\n  }\n\n  setSizeFactor(factor) {\n    this.sizeFactor = Math.min(factor, 3.0);\n    this.radius = this.baseRadius * this.sizeFactor;\n    this.maxVx = 6 * this.sizeFactor;\n    this.jumpForce = -15 * this.sizeFactor;\n  }\n}\n",
  "src/entities/platform.js": "export class Platform {\n  constructor(x, y, width, height, moving = false, path = []) {\n    this.x = x;\n    this.y = y;\n    this.width = width;\n    this.height = height;\n    this.moving = moving;\n    this.path = path; // [{x, y, progress}]\n    this.progress = 0;\n    this.speed = 100; // pixels per second\n  }\n\n  update(dt) {\n    if (this.moving) {\n      this.progress += this.speed * dt;\n      if (this.progress > 1) {\n        this.progress = 0;\n        // reverse direction\n        const tmp = this.path[0];\n        this.path = [this.path[1], tmp];\n      }\n      const t = this.progress;\n      this.x = lerp(this.path[0].x, this.path[1].x, t);\n      this.y = lerp(this.path[0].y, this.path[1].y, t);\n    }\n  }\n\n  render(ctx, camera) {\n    ctx.fillStyle = '#34495E';\n    ctx.fillRect(this.x - camera.x, this.y - camera.y, this.width, this.height);\n  }\n}\n\nfunction lerp(a, b, t) {\n  return a + (b - a) * t;\n}\n",
  "src/entities/item.js": "export class Item {\n  constructor(x, y, type) {\n    this.x = x;\n    this.y = y;\n    this.type = type; // 'growth', 'speed', 'shield', 'score'\n    this.collected = false;\n  }\n\n  update(dt) {\n    // optional floating animation\n  }\n\n  render(ctx, camera) {\n    const sx = this.x - camera.x;\n    const sy = this.y - camera.y;\n    ctx.fillStyle = '#FFD700';\n    ctx.fillRect(sx, sy, 16, 16);\n  }\n\n  collect(player) {\n    if (this.collected) return;\n    this.collected = true;\n    switch (this.type) {\n      case 'growth':\n        player.setSizeFactor(player.sizeFactor * 1.10);\n        break;\n      case 'speed':\n        // temporary speed boost\n        break;\n      case 'shield':\n        player.shield = 3;\n        break;\n      case 'score':\n        player.score += 100;\n        break;\n    }\n    // play sound\n    const audio = new AudioManager();\n    audio.play('collect');\n  }\n}\n",
  "src/entities/enemy.js": "export class Enemy {\n  constructor(x, y, type) {\n    this.x = x;\n    this.y = y;\n    this.type = type; // 'patrol', 'chaser', 'projectile'\n    this.radius = 8;\n    this.active = true;\n  }\n\n  update(dt) {\n    if (!this.active) return;\n    if (this.type === 'patrol') {\n      // move between two points\n    } else if (this.type === 'chaser') {\n      // move towards player\n    } else if (this.type === 'projectile') {\n      // simple arc\n    }\n  }\n\n  render(ctx, camera) {\n    // draw enemy sprite\n  }\n\n  onCollision(player) {\n    if (player.shield > 0) {\n      player.shield -= 1;\n    } else {\n      player.sizeFactor *= 0.90; // lose 10% size\n    }\n  }\n}\n",
  "src/levels/loader.js": "export class LevelLoader {\n  constructor(game) {\n    this.game = game;\n    this.levelData = null;\n  }\n\n  load(levelIndex) {\n    fetch(`levels/level${levelIndex}.json`)\n      .then(r => r.json())\n      .then(data => {\n        this.levelData = data;\n        this.spawnEntities();\n        this.game.levelIndex = levelIndex;\n        this.game.state = 'play';\n      });\n  }\n\n  spawnEntities() {\n    this.game.entities = [];\n    // platforms\n    this.levelData.platforms.forEach(p => {\n      const platform = new Platform(p.x, p.y, p.w, p.h, p.moving, p.path);\n      this.game.entities.push(platform);\n    });\n    // items\n    this.levelData.items.forEach(i => {\n      const item = new Item(i.x, i.y, i.type);\n      this.game.entities.push(item);\n    });\n    // enemies\n    this.levelData.enemies.forEach(e => {\n      const enemy = new Enemy(e.x, e.y, e.type);\n      this.game.entities.push(enemy);\n    });\n  }\n}\n",
  "src/levels/levels.json": "{\n  \"platforms\": [\n    {\"x\":0,\"y\":500,\"w\":800,\"h\":20,\"moving\":false,\"path\":[]},\n    {\"x\":100,\"y\":450,\"w\":200,\"h\":20,\"moving\":true,\"path\":[{\"x\":100,\"y\":450,\"progress\":0},{\"x\":300,\"y\":450,\"progress\":0}]}\n  ],\n  \"items\": [\n    {\"x\":200,\"y\":420,\"type\":\"growth\"},\n    {\"x\":400,\"y\":420,\"type\":\"score\"}\n  ],\n  \"enemies\": [\n    {\"x\":150,\"y\":400,\"type\":\"patrol\"},\n    {\"x\":350,\"y\":400,\"type\":\"chaser\"}\n  ]\n}\n",
  "src/ui/hud.js": "export class HUD {\n  constructor(game) {\n    this.game = game;\n  }\n\n  render(ctx) {\n    const sizeBarWidth = this.game.player.sizeFactor * 20;\n    ctx.fillStyle = '#2ECC71';\n    ctx.fillRect(10, 20, sizeBarWidth, 10);\n    ctx.fillStyle = '#000';\n    ctx.fillText(`Size: ${Math.round(this.game.player.sizeFactor*100)}%`, 30, 30);\n    ctx.fillStyle = '#FFD700';\n    ctx.fillText(`Score: ${this.game.score}`, this.game.canvas.width/2 - 50, 20);\n    ctx.fillStyle = '#FFF';\n    ctx.fillText(`Level ${this.game.levelIndex+1}`, 10, this.game.canvas.height-10);\n  }\n}\n",
  "src/ui/pause.js": "export class PauseOverlay {\n  constructor(game) {\n    this.game = game;\n    this.visible = false;\n  }\n\n  show() {\n    this.visible = true;\n  }\n\n  hide() {\n    this.visible = false;\n  }\n\n  render(ctx) {\n    if (!this.visible) return;\n    const { width, height } = this.game.canvas;\n    ctx.fillStyle = 'rgba(0,0,0,0.6)';\n    ctx.fillRect(0,0,width,height);\n    ctx.fillStyle = '#FFF';\n    ctx.font = '36px \"Press Start 2P\"';\n    ctx.textAlign = 'center';\n    ctx.fillText('PAUSED', width/2, height/2 - 20);\n    const btnW = 150, btnH = 40;\n    const y = height/2 + 30;\n    // Resume\n    ctx.strokeRect(width/2 - btnW/2, y, btnW, btnH);\n    ctx.fillStyle = '#4CAF50';\n    ctx.fillText('Resume', width/2, y + btnH/2 + 5);\n    // Restart\n    ctx.strokeRect(width/2 - btnW/2, y + btnH + 10, btnW, btnH);\n    ctx.fillStyle = '#F44336';\n    ctx.fillText('Restart', width/2, y + btnH + 10 + btnH/2 + 5);\n    // Menu\n    ctx.strokeRect(width/2 - btnW/2, y + btnH*2 + 20, btnW, btnH);\n    ctx.fillStyle = '#2196F3';\n    ctx.fillText('Menu', width/2, y + btnH*2 + 20 + btnH/2 + 5);\n  }\n\n  onClick(x, y) {\n    const btnW = 150, btnH = 40;\n    const mx = x - this.game.canvas.width/2;\n    const my = y - this.game.canvas.height/2;\n    const resumeRect = {x: this.game.canvas.width/2 - btnW/2, y: this.game.canvas.height/2 - 30 - btnH/2, w: btnW, h: btnH};\n    const restartRect = {x: this.game.canvas.width/2 - btnW/2, y: this.game.canvas.height/2 - 30 - btnH/2 - (btnH+10), w: btnW, h: btnH};\n    const menuRect = {x: this.game.canvas.width/2 - btnW/2, y: this.game.canvas.height/2 - 30 - btnH/2 - (btnH*2+20), w: btnW, h: btnH};\n    if (mx >= resumeRect.x && mx <= resumeRect.x+resumeRect.w && my >= resumeRect.y && my <= resumeRect.y+resumeRect.h) {\n      this.hide();\n      this.game.changeState('play');\n    } else if (mx >= restartRect.x && mx <= restartRect.x+restartRect.w && my >= restartRect.y && my <= restartRect.y+restartRect.h) {\n      this.hide();\n      this.game.reset();\n      this.game.changeState('play');\n    } else if (mx >= menuRect.x && mx <= menuRect.x+menuRect.w && my >= menuRect.y && my <= menuRect.y+menuRect.h) {\n      this.hide();\n      this.game.changeState('menu');\n    }\n  }\n}\n",
  "src/ui/gameover.js": "export class GameOverScreen {\n  constructor(game) {\n    this.game = game;\n    this.visible = false;\n  }\n\n  show() {\n    this.visible = true;\n  }\n\n  hide() {\n    this.visible = false;\n  }\n\n  render(ctx) {\n    if (!this.visible) return;\n    const { width, height } = this.game.canvas;\n    ctx.fillStyle = 'rgba(0,0,0,0.8)';\n    ctx.fillRect(0,0,width,height);\n    ctx.fillStyle = '#FFF';\n    ctx.font = '48px \"Press Start 2P\"';\n    ctx.textAlign = 'center';\n    ctx.fillText('GAME OVER', width/2, height/2 - 30);\n    ctx.fillText(`Score: ${this.game.score}`, width/2, height/2);\n    const btnW = 120, btnH = 40;\n    const mx = width/2 - btnW/2, my = height/2 + 50;\n    // Retry\n    ctx.strokeRect(mx, my, btnW, btnH);\n    ctx.fillStyle = '#FF5252';\n    ctx.fillText('Retry', mx + btnW/2, my + btnH/2 + 5);\n    // Menu\n    ctx.strokeRect(mx, my + btnH + 10, btnW, btnH);\n    ctx.fillText('Menu', mx + btnW/2, my + btnH + 10 + btnH/2 + 5);\n  }\n\n  onClick(x, y) {\n    const btnW = 120, btnH = 40;\n    const mx = x - this.game.canvas.width/2;\n    const my = y - this.game.canvas.height/2;\n    const retryRect = {x: this.game.canvas.width/2 - btnW/2, y: this.game.canvas.height/2 - 30 - btnH/2, w: btnW, h: btnH};\n    const menuRect = {x: this.game.canvas.width/2 - btnW/2, y: this.game.canvas.height/2 - 30 - btnH/2 - (btnH+10), w: btnW, h: btnH};\n    if (mx >= retryRect.x && mx <= retryRect.x+retryRect.w && my >= retryRect.y && my <= retryRect.y+retryRect.h) {\n      this.game.reset();\n      this.hide();\n      this.game.changeState('play');\n    } else if (mx >= menuRect.x && mx <= menuRect.x+menuRect.w && my >= menuRect.y && my <= menuRect.y+menuRect.h) {\n      this.hide();\n      this.game.changeState('menu');\n    }\n  }\n}\n",
  "src/ui/settings.js": "export class SettingsMenu {\n  constructor(game) {\n    this.game = game;\n    this.visible = false;\n  }\n\n  show() {\n    this.visible = true;\n  }\n\n  hide() {\n    this.visible = false;\n  }\n\n  render(ctx) {\n    if (!this.visible) return;\n    const { width, height } = this.game.canvas;\n    ctx.fillStyle = 'rgba(0,0,0,0.6)';\n    ctx.fillRect(0,0,width,height);\n    ctx.fillStyle = '#FFF';\n    ctx.font = '24px \"Press Start 2P\"';\n    ctx.textAlign = 'left';\n    ctx.fillText('Settings', 20, 40);\n    // volume slider placeholder\n    ctx.fillText('Volume', 20, 60);\n    const volWidth = 150;\n    const x = 120, y = 70, w = volWidth, h = 10;\n    ctx.fillStyle = '#CCC';\n    ctx.fillRect(x, y, w, h);\n    // quality toggle\n    ctx.fillText('Quality', 20, 90);\n  }\n}\n",
  "src/levels/levels.json": "{\n  \"platforms\": [\n    {\"x\":0,\"y\":500,\"w\":800,\"h\":20,\"moving\":false,\"path\":[]},\n    {\"x\":100,\"y\":450,\"w\":200,\"h\":20,\"moving\":true,\"path\":[{\"x\":100,\"y\":450,\"progress\":0},{\"x\":300,\"y\":450,\"progress\":0}]}\n  ],\n  \"items\": [\n    {\"x\":200,\"y\":420,\"type\":\"growth\"},\n    {\"x\":400,\"y\":420,\"type\":\"score\"}\n  ],\n  \"enemies\": [\n    {\"x\":150,\"y\":400,\"type\":\"patrol\"},\n    {\"x\":350,\"y\":400,\"type\":\"chaser\"}\n  ]\n}\n",
  "src/ui/hud.js": "export class HUD {\n  constructor(game) {\n    this.game = game;\n  }\n\n  render(ctx) {\n    const sizeBarWidth = this.game.player.sizeFactor * 20;\n    ctx.fillStyle = '#2ECC71';\n    ctx.fillRect(10, 20, sizeBarWidth, 10);\n    ctx.fillStyle = '#000';\n    ctx.fillText(`Size: ${Math.round(this.game.player.sizeFactor*100)}%`, 30, 30);\n    ctx.fillStyle = '#FFD700';\n    ctx.fillText(`Score: ${this.game.score}`, this.game.canvas.width/2 - 50, 20);\n    ctx.fillStyle = '#FFF';\n    ctx.fillText(`Level ${this.game.levelIndex+1}`, 10, this.game.canvas.height-10);\n  }\n}\n",
  "src/ui/pause.js": "export class PauseOverlay {\n  constructor(game) {\n    this.game = game;\n    this.visible = false;\n  }\n\n  show() {\n    this.visible = true;\n  }\n\n  hide() {\n    this.visible = false;\n  }\n\n  render(ctx) {\n    if (!this.visible) return;\n    const { width, height } = this.game.canvas;\n    ctx.fillStyle = 'rgba(0,0,0,0.6)';\n    ctx.fillRect(0,0,width,height);\n    ctx.fillStyle = '#FFF';\n    ctx.font = '36px \"Press Start 2P\"';\n    ctx.textAlign = 'center';\n    ctx.fillText('PAUSED', width/2, height/2 - 20);\n    const btnW = 150, btnH = 40;\n    const y = height/2 + 30;\n    // Resume\n    ctx.strokeRect(width/2 - btnW/2, y, btnW, btnH);\n    ctx.fillStyle = '#4CAF50';\n    ctx.fillText('Resume', width/2, y + btnH/2 + 5);\n    // Restart\n    ctx.strokeRect(width/2 - btnW/2, y + btnH + 10, btnW, btnH);\n    ctx.fillStyle = '#F44336';\n    ctx.fillText('Restart', width/2, y + btnH + 10 + btnH/2 + 5);\n    // Menu\n    ctx.strokeRect(width/2 - btnW/2, y + btnH*2 + 20, btnW, btnH);\n    ctx.fillStyle = '#2196F3';\n    ctx.fillText('Menu', width/2, y + btnH*2 + 20 + btnH/2 + 5);\n  }\n\n  onClick(x, y) {\n    const btnW = 150, btnH = 40;\n    const mx = x - this.game.canvas.width/2;\n    const my = y - this.game.canvas.height/2;\n    const resumeRect = {x: this.game.canvas.width/2 - btnW/2, y: this.game.canvas.height/2 - 30 - btnH/2, w: btnW, h: btnH};\n    const restartRect = {x: this.game.canvas.width/2 - btnW/2, y: this.game.canvas.height/2 - 30 - btnH/2 - (btnH+10), w: btnW, h: btnH};\n    const menuRect = {x: this.game.canvas.width/2 - btnW/2, y: this.game.canvas.height/2 - 30 - btnH/2 - (btnH*2+20), w: btnW, h: btnH};\n    if (mx >= resumeRect.x && mx <= resumeRect.x+resumeRect.w && my >= resumeRect.y && my <= resumeRect.y+resumeRect.h) {\n      this.hide();\n      this.game.changeState('play');\n    } else if (mx >= restartRect.x && mx <= restartRect.x+restartRect.w && my >= restartRect.y && my <= restartRect.y+restartRect.h) {\n      this.hide();\n      this.game.reset();\n      this.game.changeState('play');\n    } else if (mx >= menuRect.x && mx <= menuRect.x+menuRect.w && my >= menuRect.y && my <= menuRect.y+menuRect.h) {\n      this.hide();\n      this.game.changeState('menu');\n    }\n  }\n}\n",
  "src/ui/gameover.js": "export class GameOverScreen {\n  constructor(game) {\n    this.game = game;\n    this.visible = false;\n  }\n\n  show() {\n    this.visible = true;\n  }\n\n  hide() {\n    this.visible = false;\n  }\n\n  render(ctx) {\n    if (!this.visible) return;\n    const { width, height } = this.game.canvas;\n    ctx.fillStyle = 'rgba(0,0,0,0.8)';\n    ctx.fillRect(0,0,width,height);\n    ctx.fillStyle = '#FFF';\n    ctx.font = '48px \"Press Start 2P\"';\n    ctx.textAlign = 'center';\n    ctx.fillText('GAME OVER', width/2, height/2 - 30);\n    ctx.fillText(`Score: ${this.game.score}`, width/2, height/2);\n    const btnW = 120, btnH = 40;\n    const mx = width/2 - btnW/2, my = height/2 + 50;\n    // Retry\n    ctx.strokeRect(mx, my, btnW, btnH);\n    ctx.fillStyle = '#FF5252';\n    ctx.fillText('Retry', mx + btnW/2, my + btnH/2 + 5);\n    // Menu\n    ctx.strokeRect(mx, my + btnH + 10, btnW, btnH);\n    ctx.fillText('Menu', mx + btnW/2, my + btnH + 10 + btnH/2 + 5);\n  }\n\n  onClick(x, y) {\n    const btnW = 120, btnH = 40;\n    const mx = x - this.game.canvas.width/2;\n    const my = y - this.game.canvas.height/2;\n    const retryRect = {x: this.game.canvas.width/2 - btnW/2, y: this.game.canvas.height/2 - 30 - btnH/2, w: btnW, h: btnH};\n    const menuRect = {x: this.game.canvas.width/2 - btnW/2, y: this.game.canvas.height/2 - 30 - btnH/2 - (btnH+10), w: btnW, h: btnH};\n    if (mx >= retryRect.x && mx <= retryRect.x+retryRect.w && my >= retryRect.y && my <= retryRect.y+retryRect.h) {\n      this.game.reset();\n      this.hide();\n      this.game.changeState('play');\n    } else if (mx >= menuRect.x && mx <= menuRect.x+menuRect.w && my >= menuRect.y && my <= menuRect.y+menuRect.h) {\n      this.hide();\n      this.game.changeState('menu');\n    }\n  }\n}\n",
  "src/ui/settings.js": "export class SettingsMenu {\n  constructor(game) {\n    this.game = game;\n    this.visible = false;\n  }\n\n  show() {\n    this.visible = true;\n  }\n\n  hide() {\n    this.visible = false;\n  }\n\n  render(ctx) {\n    if (!this.visible) return;\n    const { width, height } = this.game.canvas;\n    ctx.fillStyle = 'rgba(0,0,0,0.6)';\n    ctx.fillRect(0,0,width,height);\n    ctx.fillStyle = '#FFF';\n    ctx.font = '24px \"Press Start 2P\"';\n    ctx.textAlign = 'left';\n    ctx.fillText('Settings', 20, 40);\n    // volume slider placeholder\n    ctx.fillText('Volume', 20, 60);\n    const volWidth = 150;\n    const x = 120, y = 70, w = volWidth, h = 10;\n    ctx.fillStyle = '#CCC';\n    ctx.fillRect(x, y, w, h);\n    // quality toggle\n    ctx.fillText('Quality', 20, 90);\n  }\n}\n",
  "src/levels/levels.json": "{\n  \"platforms\": [\n    {\"x\":0,\"y\":500,\"w\":800,\"h\":20,\"moving\":false,\"path\":[]},\n    {\"x\":100,\"y\":450,\"w\":200,\"h\":20,\"moving\":true,\"path\":[{\"x\":100,\"y\":450,\"progress\":0},{\"x\":300,\"y\":450,\"progress\":0}]}\n  ],\n  \"items\": [\n    {\"x\":200,\"y\":420,\"type\":\"growth\"},\n    {\"x\":400,\"y\":420,\"type\":\"score\"}\n  ],\n  \"enemies\": [\n    {\"x\":150,\"y\":400,\"type\":\"patrol\"},\n    {\"x\":350,\"y\":400,\"type\":\"chaser\"}\n  ]\n}",
  "src/levels/loader.js": "export class LevelLoader {\n  constructor(game) {\n    this.game = game;\n    this.levelData = null;\n  }\n\n  load(levelIndex) {\n    fetch(`levels/level${levelIndex}.json`)\n      .then(r => r.json())\n      .then(data => {\n        this.levelData = data;\n        this.spawnEntities();\n        this.game.levelIndex = levelIndex;\n        this.game.state = 'play';\n      });\n  }\n\n  spawnEntities() {\n    this.game.entities = [];\n    // platforms\n    this.levelData.platforms.forEach(p => {\n      const platform = new Platform(p.x, p.y, p.w, p.h, p.moving, p.path);\n      this.game.entities.push(platform);\n    });\n    // items\n    this.levelData.items.forEach(i => {\n      const item = new Item(i.x, i.y, i.type);\n      this.game.entities.push(item);\n    });\n    // enemies\n    this.levelData.enemies.forEach(e => {\n      const enemy = new Enemy(e.x, e.y, e.type);\n      this.game.entities.push(enemy);\n    });\n  }\n}\n",
