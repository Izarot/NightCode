id=\"new-hs\" class=\"hidden\">🏆 NEW HIGH SCORE!</div>\n            <div id=\"time-display\">TIME: 00:00.00</div>\n            <button id=\"restart-btn\">PLAY AGAIN</button>\n            <button id=\"menu-btn\">MENU</button>\n        </div>\n        <div id=\"level-complete\" class=\"screen\">\n            <h2>✅ LEVEL COMPLETE!</h2>\n            <div id=\"level-score\">SCORE: 0</div>\n            <button id=\"nextlevel-btn\">NEXT LEVEL</button>\n        </div>\n        <div id=\"settings-menu\" class=\"screen\">\n            <h2>⚙️ SETTINGS</h2>\n            <div class=\"setting\">\n                <label>MUSIC</label>\n                <input type=\"range\" id=\"music-vol\" min=\"0\" max=\"100\" value=\"30\">\n            </div>\n            <div class=\"setting\">\n                <label>SFX</label>\n                <input type=\"range\" id=\"sfx-vol\" min=\"0\" max=\"100\" value=\"40\">\n            </div>\n            <button id=\"mute-btn\">MUTE ALL</button>\n            <button id=\"back-btn\">BACK</button>\n        </div>\n    </div>\n    <script src=\"main.js\"></script>\n</body>\n</html>", "style.css": "* {\n    margin: 0;\n    padding: 0;\n    box-sizing: border-box;\n}\n\nbody {\n    background: #0a0a1a;\n    overflow: hidden;\n    font-family: 'Courier New', monospace;\n    touch-action: none;\n    -webkit-touch-callout: none;\n    -webkit-user-select: none;\n    user-select: none;\n}\n\n#game-container {\n    position: relative;\n    width: 100vw;\n    height: 100vh;\n    display: flex;\n    justify-content: center;\n    align-items: center;\n}\n\n#gameCanvas {\n    background: #0d1117;\n    image-rendering: pixelated;\n    image-rendering: crisp-edges;\n    max-width: 100%;\n    max-height: 100%;\n}\n\n#ui-overlay {\n    position: absolute;\n    top: 10px;\n    left: 10px;\n    right: 10px;\n    display: flex;\n    gap: 20px;\n    align-items: flex-start;\n    flex-wrap: wrap;\n    pointer-events: none;\n    z-index: 10;\n}\n\n#timer {\n    background: 