"class Game {\n    constructor() {\n        this.canvas = document.getElementById('gameCanvas');\n        this.canvas.width = CONFIG.CANVAS_WIDTH;\n        this.canvas.height = CONFIG.CANVAS_HEIGHT;\n        this.ctx = this.canvas.getContext('2d');\n        this.input = new InputManager(this.canvas);\n        this.audio = new AudioManager();\n        this.ui = new UI();\n        this.player = null;\n        this.enemies = [];\n        this.bullets = [];\n        this.powerups = [];\n        this.score = 0;\n        this.gameState = 'menu'; // menu, playing, paused, gameover\n        this.lastTime = 0;\n        this.loadProgress();\n        this.init();\n    }\n    init() {\n        this.player = new Player(CONFIG.CANVAS_WIDTH / 2, CONFIG.CANVAS_HEIGHT / 2);\n        this.level = new Level();\n        this.ui.showTutorial();\n        requestAnimationFrame(this.loop.bind(this));\n    }\n    loop(timestamp) {\n        const dt = timestamp - this.lastTime;\n        this.lastTime = timestamp;\n        if (this.gameState === 'playing') {\n            this.update(dt);\n        }\n        this.draw();\n        requestAnimationFrame(this.loop.bind(this));\n    }\n    update(dt) {\n        this.player.update(this.input, dt, this.level);\n        this.level.update(dt);\n        this.updateBullets(dt);\n        this.updateEnemies(dt);\n        this.updatePowerups(dt);\n        this.checkCollisions();\n        this.checkPlayerDeath();\n        this.updateHUD();\n    }\n    updateBullets(dt) {\n        for (let i = this.bullets.length - 1; i >= 0; i--) {\n            const bullet = this.bullets[i];\n            bullet.x += bullet.vx;\n            bullet.y += bullet.vy;\n            bullet.lifetime -= dt;\n            if (bullet.lifetime <= 0 || bullet.x < 0 || bullet.x > CONFIG.CANVAS_WIDTH || bullet.y < 0 || bullet.y > CONFIG.CANVAS_HEIGHT) {\n                this.bullets.splice(i, 1);\n            }\n        }\n    }\n    updateEnemies(dt) {\n        for (let i = this.enemies.length - 1; i >= 0; i--) {\n            const enemy = this.enemies[i];\n            enemy.update(dt, this.player, this.level);\n            if (!enemy.alive) {\n                this.enemies.splice(i, 1);\n                this.score += 100;\n                this.audio.playEnemyDeath();\n                if (Math.random() < 0.1) {\n                    this.spawnPowerup(enemy.x, enemy.y);\n                }\n            }\n        }\n    }\n    updatePowerups(dt) {\n        for (let i = this.powerups.length - 1; i >= 0; i--) {\n            const pu = this.powerups[i];\n            pu.update(dt);\n            if (Utils.distance(pu.x, pu.y, this.player.x, this.player.y) < pu.radius + this.player.radius) {\n                pu.apply(this.player);\n                this.powerups.splice(i, 1);\n            }\n        }\n    }\n    spawnPowerup(x, y) {\n        const types = ['health', 'ammo', 'shield'];\n        const type = types[Math.floor(Math.random() * types.length)];\n        this.powerups.push(new PowerUp(type, x, y));\n    }\n    checkCollisions() {\n        // Bullets vs enemies\n        for (let i = this.bullets.length - 1; i >= 0; i--) {\n            const bullet = this.bullets[i];\n            for (let j = this.enemies.length - 1; j >= 0; j--) {\n                const enemy = this.enemies[j];\n                if (Utils.circleCircleCollision(bullet.x, bullet.y, 3, enemy.x, enemy.y, enemy.radius)) {\n                    const killed = enemy.takeDamage(bullet.damage);\n                    this.bullets.splice(i, 1);\n                    if (killed) {\n                        this.enemies.splice(j, 1);\n                    }\n                    break;\n                }\n            }\n        }\n        // Enemy bullets vs player\n        for (let i = this.bullets.length - 1; i >= 0; i--) {\n            const bullet = this.bullets[i];\n            if (bullet.fromEnemy) {\n                if (Utils.circleCircleCollision(bullet.x, bullet.y, 3, this.player.x, this.player.y, this.player.radius)) {\n                    this.player.takeDamage(bullet.damage);\n                    this.bullets.splice(i, 1);\n                }\n            }\n        }\n        // Enemy vs player collision\n        for (const enemy of this.enemies) {\n            if (Utils.circleCircleCollision(enemy.x, enemy.y, enemy.radius, this.player.x, this.player.y, this.player.radius)) {\n                this.player.takeDamage(enemy.damage);\n            }\n        }\n    }\n    checkPlayerDeath() {\n        if (this.player.hp <= 0) {\n            this.gameState = 'gameover';\n            this.ui.showGameOver();\n            this.saveProgress();\n        }\n    }\n    shoot() {\n        const angle = Math.atan2(this.input.mouse.y - this.player.y, this.input.mouse.x - this.player.x);\n        const bullets = this.player.shoot(angle);\n        bullets.forEach(b => {\n            b.fromEnemy = false;\n            b.damage = this.player.weapons[this.player.currentWeaponIndex].damage;\n            this.bullets.push(b);\n        });\n        this.audio.playGunshot();\n    }\n    fireRifle() {\n        const angle = Math.atan2(this.input.mouse.y - this.player.y, this.input.mouse.x - this.player.x);\n        const bullets = this.player.shoot(angle);\n        bullets.forEach(b => {\n            b.fromEnemy = false;\n            b.damage = 5;\n            this.bullets.push(b);\n        });\n        this.audio.playRifleShot();\n    }\n    scatterShot() {\n        const angle = Math.atan2(this.input.mouse.y - this.player.y, this.input.mouse.x - this.player.x);\n        const bullets = this.player.shoot(angle);\n        bullets.forEach(b => {\n            b.fromEnemy = false;\n            b.damage = 3;\n            this.bullets.push(b);\n        });\n        this.audio.playScatterShot();\n    }\n    activateShield() {\n        if (this.player.activateShield()) {\n            this.audio.playShieldChime();\n        }\n    }\n    updateHUD() {\n        this.ui.updateHealth((this.player.hp / this.player.maxHp) * 100);\n        this.ui.updateShield(this.player.shield.active);\n        this.ui.updateAmmo(this.player.weapons[this.player.currentWeaponIndex]);\n        this.ui.updateScore(this.score);\n        const weapon = this.player.weapons[this.player.currentWeaponIndex];\n        const cooldownPercent = 100 - (this.player.weapons[this.player.currentWeaponIndex].cooldown / this.player.weapons[this.player.currentWeaponIndex].fireRate) * 100;\n        this.ui.updateCooldown(cooldownPercent);\n    }\n    draw() {\n        this.ctx.clearRect(0, 0, CONFIG.CANVAS_WIDTH, CONFIG.CANVAS_HEIGHT);\n        // Draw background grid\n        this.ctx.strokeStyle = '#111';\n        this.ctx.lineWidth = 1;\n        for (let x = 0; x < CONFIG.CANVAS_WIDTH; x += 32) {\n            this.ctx.beginPath();\n            this.ctx.moveTo(x, 0);\n            this.ctx.lineTo(x, CONFIG.CANVAS_HEIGHT);\n            this.ctx.stroke();\n        }\n        for (let y = 0; y < CONFIG.CANVAS_HEIGHT; y += 32) {\n            this.ctx.beginPath();\n            this.ctx.moveTo(0, y);\n            this.ctx.lineTo(CONFIG.CANVAS_WIDTH, y);\n            this.ctx.stroke();\n        }\n        // Draw level obstacles\n        this.level.draw(this.ctx);\n        // Draw powerups\n        for (const pu of this.powerups) pu.draw(this.ctx);\n        // Draw enemies\n        for (const enemy of this.enemies) enemy.draw(this.ctx);\n        // Draw bullets\n        this.ctx.fillStyle = '#ffff00';\n        for (const bullet of this.bullets) {\n            this.ctx.beginPath();\n            this.ctx.arc(bullet.x, bullet.y, 3, 0, Math.PI * 2);\n            this.ctx.fill();\n        }\n        // Draw player\n        this.player.draw(this.ctx);\n        // Draw wave info\n        this.ctx.fillStyle = '#fff';\n        this.ctx.font = '14px Arial';\n        this.ctx.textAlign = 'left';\n        this.ctx.fillText(`Wave ${this.level.currentWave + 1}/${CONFIG.TOTAL_WAVES}`, 10, 20);\n    }\n    togglePause() {\n        if (this.gameState === 'playing') {\n            this.gameState = 'paused';\n            this.ui.showPause();\n        } else if (this.gameState === 'paused') {\n            this.gameState = 'playing';\n            this.ui.hidePause();\n        }\n    }\n    restart() {\n        this.score = 0;\n        this.bullets = [];\n        this.enemies = [];\n        this.powerups = [];\n        this.player = new Player(CONFIG.CANVAS_WIDTH / 2, CONFIG.CANVAS_HEIGHT / 2);\n        this.level = new Level();\n        this.gameState = 'playing';\n        this.ui.hidePause();\n        this.ui.hideGameOver();\n    }\n    loadProgress() {\n        const saved = localStorage.getItem(CONFIG.SAVE_KEY);\n        if (saved) {\n            try {\n                const data = JSON.parse(saved);\n                this.score = data.score || 0;\n                this.player.hp = data.hp || CONFIG.PLAYER_HP;\n                this.player.shield.upgradeLevel = data.shieldLevel || 0;\n            } catch (e) {}\n        }\n    }\n    saveProgress() {\n        localStorage.setItem(CONFIG.SAVE_KEY, JSON.stringify({ score: this.score, hp: this.player.hp, shieldLevel: this.player.shield.upgradeLevel }));\n    }\n}"

