"class UI {\n    constructor() {\n        this.healthFill = document.getElementById('health-fill');\n        this.shieldIndicator = document.getElementById('shield-indicator');\n        this.ammoCounter = document.getElementById('ammo-counter');\n        this.scoreDisplay = document.getElementById('score-display');\n        this.cooldownFill = document.getElementById('cooldown-fill');\n        this.pauseMenu = document.getElementById('pause-menu');\n        this.gameOver = document.getElementById('game-over');\n        this.tutorial = document.getElementById('tutorial');\n        this.finalScore = document.getElementById('final-score');\n        this.bindEvents();\n    }\n    bindEvents() {\n        document.getElementById('resume-btn').addEventListener('click', () => this.onResume());\n        document.getElementById('restart-btn').addEventListener('click', () => this.onRestart());\n        document.getElementById('settings-btn').addEventListener('click', () => this.onSettings());\n        document.getElementById('exit-btn').addEventListener('click', () => this.onExit());\n        document.getElementById('play-again-btn').addEventListener('click', () => this.onPlayAgain());\n        document.getElementById('main-menu-btn').addEventListener('click', () => this.onMainMenu());\n    }\n    showPause() { this.pauseMenu.classList.remove('hidden'); }\n    hidePause() { this.pauseMenu.classList.add('hidden'); }\n    showGameOver() { this.gameOver.classList.remove('hidden'); }\n    hideGameOver() { this.gameOver.classList.add('hidden'); }\n    showTutorial() { this.tutorial.classList.remove('hidden'); }\n    hideTutorial() { this.tutorial.classList.add('hidden'); }\n    updateHealth(percent) {\n        this.healthFill.style.width = percent + '%';\n    }\n    updateShield(active) {\n        this.shieldIndicator.style.opacity = active ? '1' : '0';\n    }\n    updateAmmo(weapon) {\n        const names = { pistol: 'Pistol', rifle: 'Rifle', scatter: 'Scatter' };\n        this.ammoCounter.textContent = names[weapon] || '';\n    }\n    updateScore(score) {\n        this.scoreDisplay.textContent = score;\n    }\n    updateCooldown(percent) {\n        this.cooldownFill.style.width = percent + '%';\n    }\n    updateFinalScore(score) {\n        this.finalScore.textContent = 'Final Score: ' + score;\n    }\n    onResume() { /* handled by game */ }\n    onRestart() { /* handled by game */ }\n    onSettings() { /* handled by game */ }\n    onExit() { /* handled by game */ }\n    onPlayAgain() { /* handled by game */ }\n    onMainMenu() { /* handled by game */ }\n}"

