ont-size:14px; font-weight:600; text-shadow:0 0 6px rgba(0,255,204,0.6); margin-top:2px; }\n\n#tooltip { position:absolute; bottom:80px; left:50%; transform:translateX(-50%); background:rgba(0,0,0,0.7); color:#00ffcc; padding:8px 20px; border-radius:20px; font-size:13px; border:1px solid rgba(0,255,204,0.3); opacity:0; transition:opacity 0.5s; pointer-events:none; white-space:nowrap; }\n#tooltip.show { opacity:1; }\n\n#startScreen, #gameOverScreen { position:fixed; top:0; left:0; width:100%; height:100%; display:flex; flex-direction:column; align-items:center; justify-content:center; background:rgba(10,10,10,0.92); z-index:100; }\n#gameOverScreen { display:none; }\n\n.game-title { color:#00ffcc; font-size:48px; font-weight:900; text-shadow:0 0 30px rgba(0,255,204,0.6), 0 0 60px rgba(0,255,204,0.3); letter-spacing:4px; margin-bottom:8px; }\n.game-subtitle { color:#785ce9; font-size:18px; font-weight:400; margin-bottom:40px; letter-spacing:2px; }\n\n.btn { background:rgba(0,255,204,0.1); color:#00ffcc; border:2px solid #00ffcc; padding:14px 40px; font-size:16px; font-weight:700; cursor:pointer; border-radius:4px; letter-spacing:2px; transition:all 0.2s; margin:6px; }\n.btn:hover { background:rgba(0,255,204,0.25); transform:scale(1.1); box-shadow:0 0 20px rgba(0,255,204,0.4); }\n.btn:active { transform:scale(0.95); }\n.btn.secondary { color:#785ce9; border-color:#785ce9; background:rgba(120,92,233,0.1); }\n.btn.secondary:hover { background:rgba(120,92,233,0.25); box-shadow:0 0 20px rgba(120,92,233,0.4); }\n.btn.danger { color:#ff4d4d; border-color:#ff4d4d; background:rgba(255,77,77,0.1); }\n.btn.danger:hover { background:rgba(255,77,77,0.25); box-shadow:0 0 20px rgba(255,77,77,0.4); }\n\n.high-score { color:#ffd700; font-size:14px; font-weight:700; text-shadow:0 0 8px rgba(255,215,0,0.5); margin-top:12px; }\n\n.controls-hint { color:#888; font-size:12px; margin-top:30px; text-align:center; line-height:1.8; }\n.controls-hint kbd { background:rgba(255,255,255,0.1); padding:2px 8px; border-radius:3px; border:1px solid #555; color:#ccc; font-family:inherit; }\n\n#gameOverScreen .game-over-title { color:#ff4d4d; font-size:42px; font-weight:900; text-shadow:0 0 30px rgba(255,77,77,0.6); letter-spacing:3px; margin-bottom:8px; }\n#gameOverScreen .final-score { color:#fff; font-size:28px; font-weight:700; margin-bottom:4px; }\n#gameOverScreen .final-wave { color:#785ce9; font-size:16px; margin-bottom:20px; }\n#gameOverScreen .new-high { color:#ffd700; font-size:18px; font-weight:700; margin-bottom:20px; display:none; }\n.stats-grid { display:grid; grid-template-columns:1fr 1fr; gap:8px 24px; margin-bottom:30px; }\n.stat-item { color:#aaa; font-size:13px; text-align:right; }\n.stat-item span { color:#fff; font-weight:700; }\n\n@keyframes pulse { 0%,100%{opacity:1} 50%{opacity:0.5} }\n@keyframes slideUp { from{transform:translateX(-50%) translateY(20px);opacity:0} to{transform:translateX(-50%) translateY(0);opacity:1} }\n\n#gameOverScreen { animation:fadeIn 0.5s; }\n@keyframes fadeIn { from{opacity:0} to{opacity:1} }\n</style>\n</head>\n<body>\n\n<canvas id=\"gameCanvas\"></canvas>\n\n<div id=\"hud\">\n  <div class=\"hp-bar-container\"><div class=\"hp-bar-fill\" id=\"hpBarFill\"></div></div>\n  <div class=\"hp-text\" id=\"hpText\">100 / 100</div>\n  <div class=\"shield-indicator\" id=\"shieldIndicator\">\n    <svg viewBox=\"0 0 56 56\">\n      <circle cx=\"28\" cy=\"28\" r=\"26\" fill=\"none\" stroke=\"#00ffcc\" stroke-width=\"2\" opacity=\"0.3\"/>\n      <circle cx=\"28\" cy=\"28\" r=\"26\" fill=\"none\" stroke=\"#00ffcc\" stroke-width=\"3\" id=\"shieldArc\" stroke-dasharray=\"163.36\" stroke-dashoffset=\"0\" stroke-linecap=\"round\" transform=\"rotate(-90 28 28)\"/>\n      <text x=\"28\" y=\"33\" text-anchor=\"middle\" fill=\"#00ffcc\" font-size=\"11\" font-weight=\"700\" id=\"shieldText\">CD</text>\n    </svg>\n  </div>\n  <div class=\"score-display\">\n    <div class=\"wave-label\" id=\"waveLabel\">WAVE 1</div>\n    <div class=\"score-num\" id=\"scoreNum\">0</div>\n    <div class=\"timer-display\" id=\"timerDisplay\">TIME: 00:00</div>\n  </div>\n</div>\n\n<div id=\"tooltip\">HOLD [SHIFT] to dash backward!</div>\n\n<div id=\"startScreen\">\n  <div class=\"game-title\">SHIELDSTORM</div>\n  <div class=\"game-subtitle\">ARENA</div>\n  <button class=\"btn\" id=\"btnStart\">START GAME</button>\n  <div class=\"controls-hint\">\n    <kbd>W</kbd><kbd>A</kbd><kbd>S</kbd><kbd>D</kbd> or <kbd>Arrows</kbd> to move &bull;\n    <kbd>Click</kbd> to shoot &bull;\n    <kbd>Shift</kbd> to dash &bull;\n    <kbd>Space</kbd> to shield<br>\n    Survive the waves. Collect power-ups. Get the high score.\n  </div>\n</div>\n\n<div id=\"gameOverScreen\">\n  <div class=\"game-over-title\">GAME OVER</div>\n  <div class=\"final-score\" id=\"finalScore\">Score: 0</div>\n  <div class=\"final-wave\" id=\"finalWave\">Wave: 1</div>\n  <div class=\"new-high\" id=\"newHigh\">NEW HIGH SCORE!</div>\n  <div class=\"stats-grid\">\n    <div class=\"stat-item\">Enemies: <span id=\"statKills\">0</span></div>\n    <div class=\"stat-item\">Shots: <span id=\"statShots\">0</span></div>\n    <div class=\"stat-item\">Accuracy: <span id=\"statAccuracy\">0%</span></div>\n    <div class=\"stat-item\">Time: <span id=\"statTime\">0:00</span></div>\n  </div>\n  <button class=\"btn\" id=\"btnRestart\">PLAY AGAIN</button>\n  <button class=\"btn secondary\" id=\"btnMenu\">MAIN MENU</button>\n</div>\n\n<script>\n// ===== GAME ENGINE =====\nconst canvas = document.getElementById('gameCanvas');\nconst ctx = canvas.getContext('2d');\n\n// Audio context for sound effects\nlet audioCtx;\nfunction initAudio() {\n  if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();\n}\nfunction playSound(freq, duration, type='square', vol=0.1) {\n  if (!audioCtx) return;\n  const osc = audioCtx.createOscillator();\n  const gain = audioCtx.createGain();\n  osc.type = type;\n  osc.frequency.value = freq;\n  gain.gain.setValueAtTime(vol, audioCtx.currentTime);\n  gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + duration);\n  osc.connect(gain);\n  gain.connect(audioCtx.destination);\n  osc.start();\n  osc.stop(audioCtx.currentTime + duration);\n}\nfunction shootSound() { playSound(800, 0.08, 'square', 0.06); }\nfunction hitSound() { playSound(200, 0.15, 'sawtooth', 0.08); }\nfunction explosionSound() { playSound(80, 0.3, 'sawtooth', 0.12); }\nfunction shieldSound() { playSound(1200, 0.15, 'sine', 0.08); }\nfunction powerupSound() { playSound(600, 0.2, 'sine', 0.1); }\nfunction waveSound() { playSound(440, 0.5, 'triangle', 0.08); playSound(660, 0.5, 'triangle', 0.08); }\n\n// Resize\nfunction resize() {\n  const dpr = window.devicePixelRatio || 1;\n  canvas.width = window.innerWidth * dpr;\n  canvas.height = window.innerHeight * dpr;\n  canvas.style.width = window.innerWidth + 'px';\n  canvas.style.height = window.innerHeight + 'px';\n  ctx.scale(dpr, dpr);\n  W = window.innerWidth;\n  H = window.innerHeight;\n}\nlet W, H;\nwindow.addEventListener('resize', resize);\nresize();\n\n// Game state\nlet gameState = 'menu'; // menu, playing, gameover\nlet score = 0;\nlet highScore = parseInt(localStorage.getItem('shieldstorm_hs') || '0');\nlet wave = 1;\nlet waveTimer = 0;\nlet gameTime = 0;\nlet kills = 0;\nlet shotsFired = 0;\nlet shotsHit = 0;\n\n// Player\nlet player = {\n  x: W/2, y: H/2, vx: 0, vy: 0,\n  radius: 14, speed: 3.5,\n  hp: 100, maxHp: 100,\n  shieldActive: false, shieldCooldown: 0, shieldMaxCooldown: 5,\n  invincible: 0, dashCooldown: 0, dashTimer: 0,\n  shootCooldown: 0, shootRate: 0.12,\n  color: '#00ffcc'\n};\n\nlet keys = {};\nlet mouse = { x: 0, y: 0, down: false, clicked: false };\n\n// Entities\nlet bullets = [];\nlet enemies = [];\nlet particles = [];\nlet powerups = [];\nlet enemyBullets = [];\nlet floatingTexts = [];\nlet stars = [];\n\n// Init stars\nfor (let i = 0; i < 120; i++) {\n  stars.push({\n    x: Math.random() * 2000,\n    y: Math.random() * 2000,\n    size: Math.random() * 1.5 + 0.5,\n    speed: Math.random() * 0.3 + 0.1,\n    brightness: Math.random()\n  });\n}\n\n// Input\nwindow.addEventListener('keydown', e => {\n  keys[e.key.toLowerCase()] = true;\n  if (e.key === ' ' && gameState === 'playing') {\n    e.preventDefault();\n    activateShield();\n  }\n  if (e.key.toLowerCase() === 'shift' && gameState === 'playing') {\n    dash();\n  }\n});\nwindow.addEventListener('keyup', e => { keys[e.key.toLowerCase()] = false; });\ncanvas.addEventListener('mousemove', e => { mouse.x = e.clientX; mouse.y = e.clientY; });\ncanvas.addEventListener('mousedown', e => { if (e.button === 0) { mouse.down = true; mouse.clicked = true; } });\ncanvas.addEventListener('mouseup', e => { if (e.button === 0) mouse.down = false; });\ncanvas.addEventListener('click', () => { initAudio(); });\n\n// Touch support\ncanvas.addEventListener('touchstart', e => {\n  e.preventDefault();\n  initAudio();\n  const t = e.touches[0];\n  mouse.x = t.clientX; mouse.y = t.clientY;\n  mouse.down = true; mouse.clicked = true;\n});\ncanvas.addEventListener('touchmove', e => {\n  e.preventDefault();\n  const t = e.touches[0];\n  mouse.x = t.clientX; mouse.y = t.clientY;\n});\ncanvas.addEventListener('touchend', e => { mouse.down = false; });\n\n// Button handlers\ndocument.getElementById('btnStart').addEventListener('click', () => {\n  initAudio();\n  startGame();\n});\ndocument.getElementById('btnRestart').addEventListener('click', () => startGame());\ndocument.getElementById('btnMenu').addEventListener('click', () => {\n  gameState = 'menu';\n  document.getElementById('startScreen').style.display = 'flex';\n  document.getElementById('gameOverScreen').style.display = 'none';\n});\n\nfunction startGame() {\n  document.getElementById('startScreen').style.display = 'none';\n  document.getElementById('gameOverScreen').style.display = 'none';\n  gameState = 'playing';\n  score = 0; wave = 1; waveTimer = 2; gameTime = 0;\n  kills = 0; shotsFired = 0; shotsHit = 0;\n  player.x = W/2; player.y = H/2;\n  player.hp = player.maxHp; player.invincible = 2;\n  player.shieldCooldown = 0; player.dashCooldown = 0;\n  bullets = []; enemies = []; particles = []; powerups = [];\n  enemyBullets = []; floatingTexts = [];\n  updateHUD();\n  showTooltip();\n}\n\nfunction showTooltip() {\n  const tip = document.getElementById('tooltip');\n  tip.classList.add('show');\n  setTimeout(() => tip.classList.remove('show'), 4000);\n}\n\nfunction activateShield() {\n  if (player.shieldCooldown <= 0 && !player.shieldActive) {\n    player.shieldActive = true;\n    player.shieldCooldown = player.shieldMaxCooldown;\n    shieldSound();\n    // Shield burst particles\n    for (let i = 0; i < 20; i++) {\n      const angle = (Math.PI * 2 / 20) * i;\n      particles.push({\n        x: player.x, y: player.y,\n        vx: Math.cos(angle) * 3, vy: Math.sin(angle) * 3,\n        life: 0.5, maxLife: 0.5, radius: 2,\n        color: '#00ffcc', type: 'circle'\n      });\n    }\n  }\n}\n\nfunction dash() {\n  if (player.dashCooldown <= 0) {\n    player.dashTimer = 0.15;\n    player.dashCooldown = 3;\n    player.vx *= 0;\n    player.vy *= 0;\n    // Dash particles\n    for (let i = 0; i < 12; i++) {\n      particles.push({\n        x: player.x, y: player.y,\n        vx: (Math.random()-0.5)*4, vy: (Math.random()-0.5)*4,\n        life: 0.3, maxLife: 0.3, radius: Math.random()*3+1,\n        color: '#00ffcc', type: 'circle'\n      });\n    }\n  }\n}\n\n// Spawn enemies\nfunction spawnEnemy(type, x, y) {\n  const e = {\n    x, y, type, hp: 1, maxHp: 1,\n    radius: 12, speed: 1.5, color: '#ff4d4d',\n    shootTimer: Math.random() * 2,\n    shootRate: 2, angle: 0, vx: 0, vy: 0,\n    wobble: Math.random() * Math.PI * 2,\n    wobbleSpeed: Math.random() * 2 + 1,\n    wobbleAmp: 0,\n    spawnAnim: 1.0\n  };\n  switch(type) {\n    case 'basic':\n      e.hp = e.maxHp = 1; e.radius = 10; e.speed = 1.5 + wave * 0.1;\n      e.color = '#ff4d4d'; e.shootRate = 0;\n      break;\n    case 'fast':\n      e.hp = e.maxHp = 1; e.radius = 8; e.speed = 3 + wave * 0.1;\n      e.color = '#ffaa00'; e.shootRate = 0;\n      break;\n    case 'tank':\n      e.hp = e.maxHp = 3 + Math.floor(wave/3); e.radius = 16; e.speed = 0.8 + wave * 0.05;\n      e.color = '#785ce9'; e.shootRate = 0;\n      break;\n    case 'shooter':\n      e.hp = e.maxHp = 2; e.radius = 11; e.speed = 1;\n      e.color = '#ff66cc'; e.shootRate = Math.max(0.8, 2.5 - wave * 0.1);\n      break;\n    case 'zigzag':\n      e.hp = e.maxHp = 1; e.radius = 9; e.speed = 2 + wave * 0.08;\n      e.color = '#00ffcc'; e.shootRate = 0;\n      e.wobbleAmp = 60 + wave * 5;\n      break;\n    case 'boss':\n      e.hp = e.maxHp = 20 + wave * 5; e.radius = 30; e.speed = 0.5 + wave * 0.03;\n      e.color = '#ff0044'; e.shootRate = 0.6;\n      break;\n  }\n  enemies.push(e);\n}\n\nfunction spawnPowerup(x, y) {\n  const types = ['hp', 'shield', 'speed', 'rapidfire'];\n  const type = types[Math.floor(Math.random() * types.length)];\n  powerups.push({\n    x, y, type, radius: 10,\n    vy: -0.5, life: 8, color: type === 'hp' ? '#ff4d4d' : type === 'shield' ? '#00ffcc' : type === 'speed' ? '#ffaa00' : '#ffd700',\n    bob: Math.random() * Math.PI * 2\n  });\n}\n\nfunction spawnParticle(x, y, color, count, speed) {\n  for (let i = 0; i < count; i++) {\n    const angle = Math.random() * Math.PI * 2;\n    const spd = Math.random() * speed + speed * 0.3;\n    particles.push({\n      x, y,\n      vx: Math.cos(angle) * spd, vy: Math.sin(angle) * spd,\n      life: Math.random() * 0.6 + 0.2, maxLife: Math.random() * 0.6 + 0.4,\n      radius: Math.random() * 3 + 1,\n      color, type: 'circle'\n    });\n  }\n}\n\nfunction addFloatingText(x, y, text, color) {\n  floatingTexts.push({ x, y, text, color, life: 1.2, maxLife: 1.2 });\n}\n\n// Update\nfunction update(dt) {\n  if (gameState !== 'playing') return;\n  dt = Math.min(dt, 0.05);\n  gameTime += dt;\n\n  // Player movement\n  let mx = 0, my = 0;\n  if (keys['w'] || keys['arrowup']) my -= 1;\n  if (keys['s'] || keys['arrowdown']) my += 1;\n  if (keys['a'] || keys['arrowleft']) mx -= 1;\n  if (keys['d'] || keys['arrowright']) mx += 1;\n  if (mx !== 0 && my !== 0) { mx *= 0.707; my *= 0.707; }\n\n  if (player.dashTimer > 0) {\n    player.dashTimer -= dt;\n  } else {\n    player.vx = mx * player.speed;\n    player.vy = my * player.speed;\n  }\n\n  player.x += player.vx;\n  player.y += player.vy;\n  player.x = Math.max(player.radius, Math.min(W - player.radius, player.x));\n  player.y = Math.max(player.radius, Math.min(H - player.radius, player.y));\n\n  // Dash cooldown\n  if (player.dashCooldown > 0) player.dashCooldown -= dt;\n\n  // Shield cooldown\n  if (player.shieldCooldown > 0) player.shieldCooldown -= dt;\n\n  // Invincibility\n  if (player.invincible > 0) player.invincible -= dt;\n\n  // Shooting\n  if (player.shootCooldown > 0) player.shootCooldown -= dt;\n  const rapidfire = powerups.some(p => p.type === 'rapidfire');\n  const shootRate = rapidfire ? player.shootRate * 0.4 : player.shootRate;\n  if (mouse.down && player.shootCooldown <= 0) {\n    shoot();\n    player.shootCooldown = shootRate;\n  }\n\n  // Aim direction\n  const aimAngle = Math.atan2(mouse.y - player.y, mouse.x - player.x);\n\n  // Wave timer\n  if (waveTimer > 0) {\n    waveTimer -= dt;\n    if (waveTimer <= 0) startWave();\n  }\n\n  // Spawn enemies\n  if (enemies.length === 0 && waveTimer <= 0) {\n    waveTimer = 3;\n  }\n\n  // Update bullets\n  for (let i = bullets.length - 1; i >= 0; i--) {\n    const b = bullets[i];\n    b.x += b.vx;\n    b.y += b.vy;\n    b.life -= dt;\n    if (b.life <= 0 || b.x < -20 || b.x > W+20 || b.y < -20 || b.y > H+20) {\n      bullets.splice(i, 1);\n    }\n  }\n\n  // Update enemy bullets\n  for (let i = enemyBullets.length - 1; i >= 0; i--) {\n    const b = enemyBullets[i];\n    b.x += b.vx;\n    b.y += b.vy;\n    b.life -= dt;\n    if (b.life <= 0 || b.x < -20 || b.x > W+20 || b.y < -20 || b.y > H+20) {\n      enemyBullets.splice(i, 1);\n    }\n  }\n\n  // Update enemies\n  for (let i = enemies.length - 1; i >= 0; i--) {\n    const e = enemies[i];\n    e.spawnAnim = Math.max(0, e.spawnAnim - dt * 2);\n    e.wobble += e.wobbleSpeed * dt;\n\n    if (e.type === 'boss') {\n      // Boss moves toward player\n      const dx = player.x - e.x, dy = player.y - e.y;\n      const dist = Math.sqrt(dx*dx + dy*dy);\n      if (dist > 0) {\n        e.vx = (dx/dist) * e.speed;\n        e.vy = (dy/dist) * e.speed;\n      }\n    } else if (e.type === 'zigzag') {\n      e.vx = Math.cos(e.wobble) * e.wobbleAmp * 0.02;\n      e.vy = e.speed;\n      // Move toward player Y\n      if (e.y < player.y - 50) e.vy = e.speed * 1.3;\n    } else {\n      // Move toward player\n      const dx = player.x - e.x, dy = player.y - e.y;\n      const dist = Math.sqrt(dx*dx + dy*dy);\n      if (dist > 0) {\n        e.vx = (dx/dist) * e.speed;\n        e.vy = (dy/dist) * e.speed;\n      }\n    }\n\n    e.x += e.vx;\n    e.y += e.vy;\n    e.x = Math.max(e.radius, Math.min(W - e.radius, e.x));\n    e.y = Math.max(e.radius, Math.min(H - e.radius, e.y));\n\n    // Shooting\n    if (e.type === 'shooter' || e.type === 'boss') {\n      e.shootTimer -= dt;\n      if (e.shootTimer <= 0) {\n        e.shootTimer = e.shootRate;\n        const angle = Math.atan2(player.y - e.y, player.x - e.x);\n        enemyBullets.push({\n          x: e.x + Math.cos(angle) * e.radius,\n          y: e.y + Math.sin(angle) * e.radius,\n          vx: Math.cos(angle) * (2.5 + wave * 0.1),\n          vy: Math.sin(angle) * (2.5 + wave * 0.1),\n          radius: 4, life: 5, color: '#ff66cc'\n        });\n      }\n    }\n\n    // Check if enemy reached bottom\n    if (e.y > H + e.radius + 20) {\n      enemies.splice(i, 1);\n      player.hp -= 5;\n      hitSound();\n      if (player.hp <= 0) endGame();\n      updateHUD();\n    }\n  }\n\n  // Update powerups\n  for (let i = powerups.length - 1; i >= 0; i--) {\n    const p = powerups[i];\n    p.y += p.vy;\n    p.bob += dt * 3;\n    p.life -= dt;\n    if (p.life <= 0 || p.y < -20) {\n      powerups.splice(i, 1);\n      continue;\n    }\n    // Collect\n    const dx = player.x - p.x, dy = player.y - p.y;\n    if (Math.sqrt(dx*dx + dy*dy) < player.radius + p.radius) {\n      collectPowerup(p);\n      powerups.splice(i, 1);\n    }\n  }\n\n  // Update particles\n  for (let i = particles.length - 1; i >= 0; i--) {\n    const p = particles[i];\n    p.x += p.vx;\n    p.y += p.vy;\n    p.vx *= 0.97;\n    p.vy *= 0.97;\n    p.life -= dt;\n    if (p.life <= 0) particles.splice(i, 1);\n  }\n\n  // Update floating texts\n  for (let i = floatingTexts.length - 1; i >= 0; i--) {\n    const ft = floatingTexts[i];\n    ft.y -= 30 * dt;\n    ft.life -= dt;\n    if (ft.life <= 0) floatingTexts.splice(i, 1);\n  }\n\n  // Collision: bullets vs enemies\n  for (let i = bullets.length - 1; i >= 0; i--) {\n    const b = bullets[i];\n    let hit = false;\n    for (let j = enemies.length - 1; j >= 0; j--) {\n      const e = enemies[j];\n      const dx = b.x - e.x, dy = b.y - e.y;\n      if (Math.sqrt(dx*dx + dy*dy) < b.radius + e.radius) {\n        e.hp--;\n        shotsHit++;\n        hit = true;\n        hitSound();\n        spawnParticle(b.x, b.y, e.color, 5, 2);\n        if (e.hp <= 0) {\n          // Enemy killed\n          const points = e.type === 'boss' ? 500 : e.type === 'tank' ? 100 : e.type === 'zigzag' ? 75 : 50;\n          score += points * wave;\n          kills++;\n          explosionSound();\n          spawnParticle(e.x, e.y, e.color, 20, 4);\n          addFloatingText(e.x, e.y, '+' + points, '#fff');\n          // Drop powerup\n          if (Math.random() < 0.12) spawnPowerup(e.x, e.y);\n          enemies.splice(j, 1);\n        }\n        bullets.splice(i, 1);\n        break;\n      }\n    }\n  }\n\n  // Collision: enemy bullets vs player\n  if (player.invincible <= 0 && !player.shieldActive) {\n    for (let i = enemyBullets.length - 1; i >= 0; i--) {\n      const b = enemyBullets[i];\n      const dx = b.x - player.x, dy = b.y - player.y;\n      if (Math.sqrt(dx*dx + dy*dy) < b.radius + player.radius) {\n        player.hp -= 10;\n        player.invincible = 0.5;\n        hitSound();\n        spawnParticle(player.x, player.y, '#ff4d4d', 10, 3);\n        enemyBullets.splice(i, 1);\n        updateHUD();\n        if (player.hp <= 0) endGame();\n      }\n    }\n  }\n\n  // Collision: enemies vs player\n  if (player.invincible <= 0 && !player.shieldActive) {\n    for (let i = enemies.length - 1; i >= 0; i--) {\n      const e = enemies[i];\n      const dx = e.x - player.x, dy = e.y - player.y;\n      if (Math.sqrt(dx*dx + dy*dy) < e.radius + player.radius) {\n        player.hp -= 15;\n        player.invincible = 1;\n        hitSound();\n        spawnParticle(player.x, player.y, '#ff4d4d', 15, 3);\n        updateHUD();\n        if (player.hp <= 0) endGame();\n      }\n    }\n  }\n\n  // Shield collision with enemy bullets\n  if (player.shieldActive) {\n    for (let i = enemyBullets.length - 1; i >= 0; i--) {\n      const b = enemyBullets[i];\n      const dx = b.x - player.x, dy = b.y - player.y;\n      if (Math.sqrt(dx*dx + dy*dy) < b.radius + 30) {\n        spawnParticle(b.x, b.y, '#00ffcc', 5, 2);\n        enemyBullets.splice(i, 1);\n        score += 2;\n      }\n    }\n  }\n\n  // Update HUD\n  updateHUD();\n}\n\nfunction shoot() {\n  const angle = Math.atan2(mouse.y - player.y, mouse.x - player.x);\n  const speed = 8;\n  const rapidfire = powerups.some(p => p.type === 'rapidfire');\n  const bulletCount = rapidfire ? 3 : 1;\n  for (let i = 0; i < bulletCount; i++) {\n    const spread = (i - (bulletCount-1)/2) * 0.1;\n    const a = angle + spread;\n    bullets.push({\n      x: player.x + Math.cos(a) * 16,\n      y: player.y + Math.sin(a) * 16,\n      vx: Math.cos(a) * speed,\n      vy: Math.sin(a) * speed,\n      radius: 3, life: 2, color: '#00ffcc'\n    });\n  }\n  shootSound();\n  shotsFired++;\n}\n\nfunction collectPowerup(p) {\n  powerupSound();\n  switch(p.type) {\n    case 'hp':\n      player.hp = Math.min(player.maxHp, player.hp + 25);\n      addFloatingText(p.x, p.y, '+HP', '#ff4d4d');\n      break;\n    case 'shield':\n      player.shieldActive = true;\n      player.shieldCooldown = player.shieldMaxCooldown;\n      shieldSound();\n      addFloatingText(p.x, p.y, 'SHIELD', '#00ffcc');\n      break;\n    case 'speed':\n      player.speed = 5;\n      setTimeout(() => { player.speed = 3.5; }, 5000);\n      addFloatingText(p.x, p.y, 'SPEED', '#ffaa00');\n      break;\n    case 'rapidfire':\n      addFloatingText(p.x, p.y, 'RAPID', '#ffd700');\n      break;\n  }\n  spawnParticle(p.x, p.y, p.color, 15, 3);\n}\n\nfunction startWave() {\n  waveTimer = 0;\n  wave++;\n  waveLabel.textContent = 'WAVE ' + wave;\n  waveSound();\n  addFloatingText(W/2, H/2, 'WAVE ' + wave, '#785ce9');\n\n  const count = Math.min(3 + wave, 15);\n  const hasBoss = wave % 5 === 0;\n  const types = ['basic', 'fast', 'tank', 'shooter', 'zigzag'];\n\n  if (hasBoss) {\n    spawnEnemy('boss', W/2, -40);\n    for (let i = 0; i < count - 1; i++) {\n      const type = types[Math.floor(Math.random() * types.length)];\n      const x = Math.random()