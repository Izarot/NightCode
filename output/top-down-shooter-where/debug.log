System.getSettings(), sfxVol: e.target.value }); }); const settings = SaveSystem.getSettings(); document.getElementById('music-vol').value = settings.musicVol; document.getElementById('sfx-vol').value = settings.sfxVol; audio.setMusicVolume(settings.musicVol); audio.setSFXVolume(settings.sfxVol); updateHealthUI(); updateAmmoUI(); requestAnimationFrame(gameLoop);"} }