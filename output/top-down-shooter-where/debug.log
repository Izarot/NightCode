iction);\n            this.vy *= (1 - friction);\n        }\n        \n        // Clamp velocity\n        this.vx = Utils.clamp(this.vx, -speed, speed);\n        this.vy = Utils.clamp(this.vy, -speed, speed);\n        \n        // Update position\n        this.x += this.vx;\n        this.y += this.vy;\n        \n        // Boundary collision\n        this.x = Utils.clamp(this.x, this.radius, CONFIG.CANVAS_WIDTH - this.radius);\n        this.y = Utils.clamp(this.y, this.radius, CONFIG.CANVAS_HEIGHT - this.radius);\n        \n        // Collision with obstacles\n        for (const obstacle of level.obstacles) {\n            if (Utils.circleRectCollision(this.x, this.y, this.radius, obstacle.x, obstacle.y, obstacle.w, obstacle.h)) {\n                // Simple pushback\n                const dx = this.x - (obstacle.x + obstacle.w/2);\n                const dy = this.y - (obstacle.y + obstacle.h/2);\n                const dist = Math.sqrt(dx*dx + dy*dy) || 1;\n                this.x += (dx/dist) * 5;\n                this.y += (dy/dist) * 5;\n                this.vx *= 0.5;\n                this.vy *= 0.5;\n            }\n        }\n        \n        // Update shield\n        this.shield.update();\n        \n        // Invulnerability timer\n        if (this.invulnerable) {\n            this.invulnerableTime -= dt;\n            if (this.invulnerableTime <= 0) this.invulnerable = false;\n        }\n    }\n    shoot(angle) {\n        const weapon = this.weapons[this.currentWeaponIndex];\n        const weaponObj = new Weapon(weapon);\n        return weaponObj.fire(this.x, this.y, angle);\n    }\n    activateShield() {\n        return this.shield.activate();\n    }\n    takeDamage(amount) {\n        if (this.invulnerable || this.shield.active) return;\n        this.hp = Math.max(0, this.hp - amount);\n        this.invulnerable = true;\n        this.invulnerableTime = 500;\n    }\n    draw(ctx) {\n        // Draw player\n        ctx.fillStyle = '#00ffff';\n        ctx.beginPa