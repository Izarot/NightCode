        this.sfxGain = null;\n        this.initialized = false;\n    }\n    init() {\n        if (this.initialized) return;\n        this.ctx = new (window.AudioContext || window.webkitAudioContext)();\n        this.masterGain = this.ctx.createGain();\n        this.musicGain = this.ctx.createGain();\n        this.sfxGain = this.ctx.createGain();\n        this.masterGain.connect(this.ctx.destination);\n        this.musicGain.connect(this.masterGain);\n        this.sfxGain.connect(this.masterGain);\n        this.initialized = true;\n    }\n    playTone(freq, duration, type = 'sine', volume = 0.1) {\n        if (!this.initialized) return;\n        const osc = this.ctx.createOscillator();\n        const gain = this.ctx.createGain();\n        osc.type = type;\n        osc.frequency.value = freq;\n        gain.gain.setValueAtTime(volume, this.ctx.currentTime);\n        gain.gain.exponentialRampToValueAtTime(0.001, this.ctx.currentTime + duration);\n        osc.connect(gain);\n        gain.connect(this.sfxGain);\n        osc.start();\n        osc.stop(this.ctx.currentTime + duration);\n    }\n    playShieldChime() { this.playTone(800, 0.3, 'sine', 0.2); }\n    playShieldImpact() { this.playTone(200, 0.1, 'square', 0.1); }\n    playEnemyDeath() { this.playTone(400, 0.2, 'triangle', 0.1); }\n    playPlayerDamage() { this.playTone(100, 0.3, 'sawtooth', 0.15); }\n    playGunshot() { this.playTone(600, 0.05, 'square', 0.05); }\n    playRifleShot() { this.playTone(800, 0.03, 'square', 0.03); }\n    playScatterShot() { this.playTone(300, 0.1, 'triangle', 0.08); }\n    startMusic() {\n        if (!this.initialized) return;\n        // Simple ambient loop\n        const notes = [261.63, 293.66, 329.63, 349.23];\n        let i = 0;\n        this.musicInterval = setInterval(() => {\n            if (i >= notes.length) i = 0;\n            this.playTone(notes[i], 1, 'sine', 0.05);\n            i++;\n        }, 500);\n    }\n    stopMusic() { clearInterval(this.musicInterval); }\n}", "input.js": "class InputManager {\n    constructor(canvas) {\n        this.keys = {};\n        this.mouse = { x: 0, y: 0, down: false };\n        this.touchStart = null;\n        this.joystick = { x: 0, y: 0, active: false };\n        this.bindEvents(canvas);\n    }\n    bindEvents(canvas) {\n        window.addEventListener('keydown', e => { this.keys[e.code] = true; });\n        window.addEventListener('keyup', e => { this.keys[e.code] = false; });\n        canvas.addEventListener('mousemove', e => {\n            const rect = canvas.getBoundingClientRect();\n            this.mouse.x = (e.clientX - rect.left) * (canvas.width / rect.width);\n            this.mouse.y = (e.clientY - rect.top) * (canvas.height / rect.height);\n        });\n        canvas.addEventListener('mousedown', () => { this.mouse.down = true; });\n        canvas.addEventListener('mouseup', () => { this.mouse.down = false; });\n        canvas.addEventListener('touchstart', e => {\n            e.preventDefault();\n            for (const touch of e.changedTouches) {\n                this.touchStart = { x: touch.clientX, y: touch.clientY };\n            }\n        });\n        canvas.addEventListener('touchmove', e => {\n            e.preventDefault();\n            for (const touch of e.changedTouches) {\n                const dx = touch.clientX - this.touchStart.x;\n                const dy = touch.clientY - this.touchStart.y;\n                this.joystick.active = true;\n                this.joystick.x = Utils.clamp(dx / 100, -1, 1);\n                this.joystick.y = Utils.clamp(dy / 100, -1, 1);\n            }\n        });\n        canvas.addEventListener('touchend', () => {\n            this.joystick.active = false;\n            this.touchStart = null;\n        });\n    }\n    isKeyDown(code) { return !!this.keys[code]; }\n    isMouseDown() { return this.mouse.down; }\n    getJoystickInput() {\n        return this.joystick.active ? { x: this.joystick.x, y: this.joystick.y } : null;\n    }\n}", "weapon.js": "class Weapon {\n    constructor(type) {\n        this.type = type;\n        this.cooldown = 0;\n        switch(type) {\n            case 'pistol':\n                this.damage = 10;\n                this.fireRate = 300;\n                this.bulletSpeed = 8;\n                this.spread = Math.PI / 180 * 180; // 180 degrees\n                break;\n            case 'rifle':\n                this.damage = 5;\n                this.fireRate = 80;\n                this.bulletSpeed = 10;\n                this.spread = 0;\n                break;\n            case 'scatter':\n                this.damage = 3;\n                this.fireRate = 1000;\n                this.bulletSpeed = 8;\n                this.spread = Math.PI / 180 * 30; // 30 degrees\n                this.bulletsPerShot = 5;\n                break;\n        }\n    }\n    update(dt) {\n        this.cooldown -= dt;\n    }\n    canFire() { return this.cooldown <= 0; }\n    fire(x, y, angle) {\n        this.cooldown = this.fireRate;\n        const bullets = [];\n        for (let i = 0; i < (this.bulletsPerShot || 1); i++) {\n            const spreadAngle = angle + Utils.randomRange(-this.spread, this.spread);\n            bullets.push({ x, y, vx: Math.cos(spreadAngle) * this.bulletSpeed, vy: Math.sin(spreadAngle) * this.bulletSpeed });\n        }\n        return bullets;\n    }\n}", "shield.js": "class Shield {\n    constructor() {\n        this.active = false;\n        this.endTime = 0;\n        this.cooldownEnd = 0;\n        this.radius = CONFIG.SHIELD_BASE_RADIUS;\n        this.duration = CONFIG.SHIELD_DURATION;\n        this.cooldown = CONFIG.SHIELD_COOLDOWN;\n        this.upgradeLevel = 0;\n    }\n    activate() {\n        if (this.active || Date.now() < this.cooldownEnd) return false;\n        this.active = true;\n        this.endTime = Date.now() + this.duration;\n        return true;\n    }\n    update() {\n        if (this.active && Date.now() > this.endTime) {\n            this.active = false