tx.fill();\n    // pulse ring\n    if(this.life > CFG.field.fadeTime){\n      ctx.strokeStyle=`rgba(0,255,255,${0.4+0.2*Math.sin(Date.now()/200)})`;\n      ctx.lineWidth=2; ctx.beginPath(); ctx.arc(this.x,this.y,this.r,0,Math.PI*2); ctx.stroke();\n    }\n  }\n  isDead(){ return this.life<=0; }\n  affects(ex,ey){ return dist({x:ex,y:ey}, this) < this.r; }\n}\n\nclass Enemy {\n  constructor(type='basic'){\n    const side = randInt(0,3);\n    if(side===0){ this.x=rand(0,CFG.canvasW); this.y=-20; }\n    else if(side===1){ this.x=CFG.canvasW+20; this.y=rand(0,CFG.canvasH); }\n    else if(side===2){ this.x=rand(0,CFG.canvasW); this.y=CFG.canvasH+20; }\n    else { this.x=-20; this.y=rand(0,CFG.canvasH); }\n    this.type=type;\n    const def = CFG.enemy[type];\n    this.hp=def.hp; this.maxHp=def.hp; this.speed=def.speed; this.size=def.size; this.dmg=def.dmg; this.color=def.color;\n    this.atkCd=0; this.spawnCd=def.spawnCd||0;\n    this.slow=0;\n  }\n  update(){\n    // slow from fields\n    let slow = 0;\n    for(const f of fields) if(f.affects(this.x,this.y)) slow += CFG.field.slowPerField;\n    this.slow = Math.min(slow, CFG.field.slowMax);\n    // move toward player\n    const dx = player.x - this.x, dy = player.y - this.y;\n    const d = Math.hypot(dx,dy) || 1;\n    const spd = this.speed * (1 - this.slow);\n    this.x += dx/d * spd; this.y += dy/d * spd;\n    // attack\n    if(this.atkCd>0) this.atkCd--;\n    else if(d < 400){\n      const ang = Math.atan2(dy,dx);\n      eBullets.push(new EBullet(this.x, this.y, ang, this.dmg));\n      this.atkCd = CFG.enemy[this.type].atkCd;\n    }\n    // heavy spawn\n    if(this.type==='heavy' && this.spawnCd>0){ this.spawnCd--; if(this.spawnCd===0) enemies.push(new Enemy('basic')); }\n  }\n  draw(ctx){\n    ctx.save(); ctx.translate(this.x, this.y);\n    // body\n    ctx.beginPath(); ctx.arc(0,0,this.size,0,Math.PI*2);\n    ctx.fillStyle=this.color; ctx.shadowColor=this.color; ctx.shadowBlur=10; ctx.fill();\n    // slow aura\n    if(this.slow>0){ ctx.strokeStyle='#0ff'; ctx.lineWidth=2; ctx.beginPath(); ctx.arc(0,0,this.size+4+2*Math.sin(Date.now()/100),0,Math.PI*2); ctx.stroke(); }\n    // hp bar\n    if(this.hp<this.maxHp){ ctx.fillStyle='#333'; ctx.fillRect(-this.size, -this.size-8, this.size*2, 4); ctx.fillStyle='#0f0'; ctx.fillRect(-this.size, -this.size-8, this.size*2*this.hp/this.maxHp, 4); }\n    ctx.restore();\n  }\n  takeDamage(dmg){ this.hp-=dmg; if(this.hp<=0){ this.die(); return true; } return false; }\n  die(){ Audio.kill(); game.score += this.type==='heavy'?100:10; for(let i=0;i<8;i++) particles.push(new Particle(this.x,this.y,rand(-3,3),rand(-3,3),rand(0.5,1), this.color, 30)); if(this.type==='heavy' && Math.random()<0.1) powerups.push(new Powerup(this.x,this.y)); }\n}\n\nclass EBullet {\n  constructor(x,y,ang,dmg){ this.x=x; this.y=y; this.vx=Math.cos(ang)*5; this.vy=Math.sin(ang)*5; this.dmg=dmg; this.r=6; this.life=300; }\n  update(){ this.x+=this.vx; this.y+=this.vy; this.life--; }\n  draw(ctx){ ctx.beginPath(); ctx.arc(this.x,this.y,this.r,0,Math.PI*2); ctx.fillStyle='#f80'; ctx.shadowColor='#f80'; ctx.shadowBlur=8; ctx.fill(); ctx.shadowBlur=0; }\n  isDead(){ return this.life<=0 || this.x<-10||this.x>CFG.canvasW+10||this.y<-10||this.y>CFG.canvasH+10; }\n}\n\nclass Particle {\n  constructor(x,y,vx,vy,size,color,life){ this.x=x; this.y=y; this.vx=vx; this.vy=vy; this.size=size; this.color=color; this.life=life; this.maxLife=life; }\n  update(){ this.x+=this.vx; this.y+=this.vy; this.vx*=0.98; this.vy*=0.98; this.life--; }\n  draw(ctx){ ctx.globalAlpha=this.life/this.maxLife; ctx.beginPath(); ctx.arc(this.x,this.y,this.size,0,Math.PI*2); ctx.fillStyle=this.color; ctx.fill(); ctx.globalAlpha=1; }\n  isDead(){ return this.life<=0; }\n}\n\nclass Powerup {\n  constructor(x,y){ this.x=x; this.y=y; this.r=12; this.type=randInt(0,2); this.life=600; }\n  update(){ this.life--; }\n  draw(ctx){ ctx.save(); ctx.translate(this.x,this.y); ctx.rotate(Date.now()/500); ctx.fillStyle=this.type===0?'#0f0':'#ff0'; ctx.beginPath(); for(let i=0;i<5;i++){ ctx.lineTo(Math.cos(i*Math.PI*2/5)*this.r, Math.sin(i*Math.PI*2/5)*this.r); ctx.lineTo(Math.cos((i+0.5)*Math.PI*2/5)*this.r*0.5, Math.sin((i+0.5)*Math.PI*2/5)*this.r*0.5); } ctx.closePath(); ctx.fill(); ctx.restore(); }\n  isDead(){ return this.life<=0; }\n  apply(){ if(this.type===0){ CFG.field.radius = Math.min(80, CFG.field.radius+8); } else { CFG.player.dashCd = Math.max(60, CFG.player.dashCd-30); } }\n}\n\n// ========== STARFIELD ==========\nconst stars = [];\nfor(let i=0;i<150;i++) stars.push({x:rand(0,CFG.canvasW), y:rand(0,CFG.canvasH), s:rand(0.5,2), c:CFG.colors.stars[randInt(0,3)], layer:randInt(1,3)});\n\n// ========== GAME ==========\nconst canvas = document.getElementById('game');\nconst ctx = canvas.getContext('2d');\nlet mouse = {x:CFG.canvasW/2, y:CFG.canvasH/2};\nlet player, bullets, eBullets, enemies, fields, particles, powerups, game;\n\nclass Game {\n  constructor(){ this.reset(); }\n  reset(){\n    player = new Player();\n    bullets = []; eBullets = []; enemies = []; fields = []; particles = []; powerups = [];\n    this.score = 0; this.wave = 1; this.waveTimer = 0; this.waveActive = false; this.waveEnemies = 0;\n    this.bulletCd = 0; this.time = 0; this.running = true;\n    this.spawnWave();\n  }\n  spawnWave(){\n    this.waveActive = true;\n    this.waveEnemies = CFG.wave.baseCount + (this.wave-1)*CFG.wave.countInc;\n    const heavyChance = Math.min(0.5, CFG.wave.heavyChance + (this.wave-1)*CFG.wave.heavyInc);\n    for(let i=0;i<this.waveEnemies;i++){\n      setTimeout(()=>{ if(this.running) enemies.push(new Enemy(Math.random()<heavyChance?'heavy':'basic')); }, i*500);\n    }\n    Audio.wave();\n  }\n  update(){\n    if(!this.running) return;\n    this.time++;\n    if(this.bulletCd>0) this.bulletCd--;\n    player.update();\n    // bullets\n    for(const b of bullets) b.update();\n    bullets = bullets.filter(b=>!b.isDead());\n    // eBullets\n    for(const b of eBullets) b.update();\n    eBullets = eBullets.filter(b=>!b.isDead());\n    // fields\n    for(const f of fields) f.update();\n    fields = fields.filter(f=>!f.isDead());\n    // enemies\n    for(const e of enemies) e.update();\n    // particles\n    for(const p of particles) p.update();\n    particles = particles.filter(p=>!p.isDead());\n    // powerups\n    for(const p of powerups) p.update();\n    powerups = powerups.filter(p=>!p.isDead());\n    // collisions\n    this.checkCollisions();\n    // wave clear\n    if(this.waveActive && enemies.length===0){\n      this.waveActive = false; this.wave++;\n      setTimeout(()=>this.spawnWave(), 3000);\n    }\n    this.updateHUD();\n  }\n  checkCollisions(){\n    // player vs enemies\n    for(const e of enemies){\n      if(dist(player, e) < player.size + e.size) player.takeDamage(e.dmg);\n    }\n    // player vs eBullets\n    for(let i=eBullets.length-1;i>=0;i--){\n      if(dist(player, eBullets[i]) < player.size + eBullets[i].r){ player.takeDamage(eBullets[i].dmg); eBullets.splice(i,1); }\n    }\n    // bullets vs enemies\n    for(let i=bullets.length-1;i>=0;i--){\n      for(let j=enemies.length-1;j>=0;j--){\n        if(dist(bullets[i], enemies[j]) < bullets[i].r + enemies[j].size){\n          if(enemies[j].takeDamage(CFG.bullet.dmg)){ enemies.splice(j,1); }\n          bullets.splice(i,1); break;\n        }\n      }\n    }\n    // player vs powerups\n    for(let i=powerups.length-1;i>=0;i--){\n      if(dist(player, powerups[i]) < player.size + powerups[i].r){ powerups[i].apply(); powerups.splice(i,1); }\n    }\n  }\n  updateHUD(){\n    document.getElementById('health').textContent = `HP: ${Math.max(0,Math.round(player.hp))}/${player.maxHp}`;\n    document.getElementById('ammo').textContent = `AMMO: ${player.ammo}/${player.maxAmmo}`;\n    document.getElementById('score').textContent = `SCORE: ${this.score} | HI: ${this.highScore}`;\n    document.getElementById('fields').textContent = `FIELDS: ${fields.length}/${CFG.field.maxFields}`;\n    document.getElementById('wave').textContent = `WAVE: ${this.wave}`;\n    // timer\n    const t = this.time; const m = Math.floor(t/3600); const s = Math.floor((t%3600)/60); const ms = Math.floor((t%60)*100/60);\n    document.getElementById('timer').textContent = `${m.toString().padStart(2,'0')}:${s.toString().padStart(2,'0')}.${ms.toString().padStart(2,'0')}`;\n    // dash cooldown ring\n    const dashProg = player.dashCd > 0 ? 360 * (1 - player.dashCd/CFG.player.dashCd) : (player.dashing>0 ? 360 * (1 - player.dashing/CFG.player.dashDur) : 360);\n    document.getElementById('dash').style.setProperty('--dash-progress', `${dashProg}deg`);\n  }\n  draw(){\n    // bg\n    ctx.fillStyle = CFG.colors.bg; ctx.fillRect(0,0,CFG.canvasW,CFG.canvasH);\n    // grid\n    ctx.strokeStyle = CFG.colors.grid; ctx.lineWidth = 1;\n    for(let x=0;x<CFG.canvasW;x+=50){ ctx.beginPath(); ctx.moveTo(x,0); ctx.lineTo(x,CFG.canvasH); ctx.stroke(); }\n    for(let y=0;y<CFG.canvasH;y+=50){ ctx.beginPath(); ctx.moveTo(0,y); ctx.lineTo(CFG.canvasW,y); ctx.stroke(); }\n    // stars parallax\n    for(const s of stars){\n      const px = (s.x - player.vx * s.layer * 0.1) % CFG.canvasW;\n      const py = (s.y - player.vy * s.layer * 0.1) % CFG.canvasH;\n      ctx.fillStyle = s.c; ctx.beginPath(); ctx.arc(px<0?px+CFG.canvasW:px, py<0?py+CFG.canvasH:py, s.s, 0, Math.PI*2); ctx.fill();\n    }\n    // fields\n    for(const f of fields) f.draw(ctx);\n    // powerups\n    for(const p of powerups) p.draw(ctx);\n    // particles\n    for(const p of particles) p.draw(ctx);\n    // bullets\n    for(const b of bullets) b.draw(ctx);\n    for(const b of eBullets) b.draw(ctx);\n    // enemies\n    for(const e of enemies) e.draw(ctx);\n    // player\n    player.draw(ctx);\n  }\n  gameOver(){\n    this.running = false;\n    this.highScore = Math.max(this.highScore || 0, this.score);\n    localStorage.setItem('slowBurnHighScore', this.highScore);\n    Audio.gameover();\n    document.getElementById('finalScore').textContent = this.score;\n    const t = this.time; const m = Math.floor(t/3600); const s = Math.floor((t%3600)/60); const ms = Math.floor((t%60)*100/60);\n    document.getElementById('finalTime').textContent = `${m.toString().padStart(2,'0')}:${s.toString().padStart(2,'0')}.${ms.toString().padStart(2,'0')}`;\n    document.getElementById('finalWave').textContent = this.wave;\n    document.getElementById('gameover').style.display = 'block';\n  }\n  get highScore(){ return parseInt(localStorage.getItem('slowBurnHighScore')||'0'); }\n}\n\n// ==========// ========== INPUT ==========\nwindow.addEventListener('mousemove', e => { mouse.x = e.clientX; mouse.y = e.clientY; });\nwindow.addEventListener('mousedown', e => { if(e.button===0) player.input.shoot = true; });\nwindow.addEventListener('mouseup', e => { if(e.button===0) player.input.shoot = false; });\nwindow.addEventListener('keydown', e => {\n  if(e.key==='w'||e.key==='ArrowUp') player.input.y = -1;\n  if(e.key==='s'||e.key==='ArrowDown') player.input.y = 1;\n  if(e.key==='a'||e.key==='ArrowLeft') player.input.x = -1;\n  if(e.key==='d'||e.key==='ArrowRight') player.input.x = 1;\n  if(e.key===' '||e.key==='Shift') { player.input.dash = true; e.preventDefault(); }\n});\nwindow.addEventListener('keyup', e => {\n  if(e.key==='w'||e.key==='ArrowUp') player.input.y = 0;\n  if(e.key==='s'||e.key==='ArrowDown') player.input.y = 0;\n  if(e.key==='a'||e.key==='ArrowLeft') player.input.x = 0;\n  if(e.key==='d'||e.key==='ArrowRight') player.input.x = 0;\n  if(e.key===' '||e.key==='Shift') player.input.dash = false;\n});\n// touch support\ncanvas.addEventListener('touchstart', e => { e.preventDefault(); const t = e.touches[0]; mouse.x = t.clientX; mouse.y = t.clientY; player.input.shoot = true; }, {passive:false});\ncanvas.addEventListener('touchmove', e => { e.preventDefault(); const t = e.touches[0]; mouse.x = t.clientX; mouse.y = t.clientY; }, {passive:false});\ncanvas.addEventListener('touchend', e => { e.preventDefault(); player.input.shoot = false; }, {passive:false});\n\n// ========== LOOP ==========\nfunction loop(){\n  game.update();\n  game.draw();\n  requestAnimationFrame(loop);\n}\n\n// ========== INIT ==========\nfunction resize(){\n  const scale = Math.min(window.innerWidth/CFG.canvasW, window.innerHeight/CFG.canvasH);\n  canvas.style.width = `${CFG.canvasW*scale}px`;\n  canvas.style.height = `${CFG.canvasH*scale}px`;\n}\nwindow.addEventListener('resize', resize);\nresize();\ngame = new Game();\nloop();\n  <\/script>\n<\/body>\n<\/html>"\n}