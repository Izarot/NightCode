"class PowerUp {\n    constructor(type, x, y) {\n        this.type = type;\n        this.x = x;\n        this.y = y;\n        this.radius = 12;\n        this.active = true;\n        this.bobOffset = Math.random() * Math.PI * 2;\n    }\n    update(dt) {\n        this.bobOffset += dt * 0.005;\n    }\n    apply(player) {\n        switch(this.type) {\n            case 'health':\n                player.hp = Math.min(player.maxHp, player.hp + 30);\n                break;\n            case 'ammo':\n                player.weapons.push('rifle');\n                player.weapons.push('scatter');\n                break;\n            case 'shield':\n                player.shield.applyUpgrade();\n                break;\n        }\n        this.active = false;\n    }\n    draw(ctx) {\n        const bobY = Math.sin(this.bobOffset) * 5;\n        ctx.fillStyle = this.type === 'health' ? '#0f0' : this.type === 'ammo' ? '#ff0' : '#0ff';\n        ctx.beginPath();\n        ctx.arc(this.x, this.y + bobY, this.radius, 0, Math.PI * 2);\n        ctx.fill();\n        ctx.fillStyle = '#fff';\n        ctx.font = '12px Arial';\n        ctx.textAlign = 'center';\n        ctx.textBaseline = 'middle';\n        const symbol = this.type === 'health' ? '+' : this.type === 'ammo' ? 'R' : 'S';\n        ctx.fillText(symbol, this.x, this.y + bobY);\n    }\n}"

