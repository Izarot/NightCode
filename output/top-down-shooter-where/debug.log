  "index.html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Slow Burn: A Top-Down Shooter</title>\n  <link rel=\"icon\" href=\"data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🔥</text></svg>\">\n  <style>\n    * { margin: 0; padding: 0; box-sizing: border-box; }\n    body { background: #0a0a12; overflow: hidden; font-family: 'Segoe UI', sans-serif; }\n    canvas { display: block; max-width: 100vw; max-height: 100vh; touch-action: none; }\n    #ui { position: fixed; top: 0; left: 0; width: 100%; height: 100%; pointer-events: none; z-index: 10; }\n    .hud { position: absolute; color: #fff; text-shadow: 0 0 4px #000, 0 0 8px #00f; font-weight: bold; }\n    #health { top: 12px; left: 12px; }\n    #ammo { top: 12px; left: 50%; transform: translateX(-50%); }\n    #score { top: 48px; left: 50%; transform: translateX(-50%); font-size: 1.2rem; }\n    #timer { top: 12px; right: 12px; font-family: monospace; font-size: 1.1rem; }\n    #dash { bottom: 12px; right: 12px; width: 60px; height: 60px; border: 3px solid #444; border-radius: 50%; background: radial-gradient(circle at 30% 30%, #6af, #004); position: relative; }\n    #dash::after { content: ''; position: absolute; top: 3px; left: 3px; right: 3px; bottom: 3px; border-radius: 50%; background: conic-gradient(from -90deg, #0ff var(--dash-progress, 0deg), transparent 0); mask: radial-gradient(circle, transparent 60%, #000 61%); -webkit-mask: radial-gradient(circle, transparent 60%, #000 61%); }\n    #fields { top: 12px; right: 120px; }\n    #wave { bottom: 12px; left: 12px; font-size: 1.1rem; }\n    #gameover { position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%); background: rgba(10,10,18,0.95); border: 3px solid #0ff; border-radius: 16px; padding: 40px 60px; text-align: center; display: none; z-index: 100; }\n    #gameover h1 { color: #0ff; margin-bottom: 16px; text-shadow: 0 0 10px #0ff; }\n    #gameover p { color: #aaa; margin: 8px 0; }\n    #gameover button { margin-top: 24px; padding: 12px 32px; font-size: 1.2rem; background: linear-gradient(135deg, #0ff, #08f); border: none; border-radius: 8px; color: #001; font-weight: bold; cursor: pointer; transition: transform 0.1s; }\n    #gameover button:active { transform: scale(0.95); }\n    @media (max-width: 600px) { .hud { font-size: 0.85rem; } #dash { width: 48px; height: 48px; } }\n  </style>\n</head>\n<body>\n  <canvas id=\"game\"></canvas>\n  <div id=\"ui\">\n    <div id=\"health\" class=\"hud\">HP: 100/100</div>\n    <div id=\"ammo\" class=\"hud\">AMMO: 30/30</div>\n    <div id=\"score\" class=\"hud\">SCORE: 0 | HI: 0</div>\n    <div id=\"timer\" class=\"hud\">00:00.00</div>\n    <div id=\"fields\" class=\"hud\">FIELDS: 0/5</div>\n    <div id=\"wave\" class=\"hud\">WAVE: 1</div>\n    <div id=\"dash\" class=\"hud\" style=\"--dash-progress: 0deg\"></div>\n    <div id=\"gameover\">\n      <h1>GAME OVER</h1>\n      <p>Final Score: <span id=\"finalScore\">0</span></p>\n      <p>Time Survived: <span id=\"finalTime\">00:00.00</span></p>\n      <p>Waves Cleared: <span id=\"finalWave\">0</span></p>\n      <button onclick=\"location.reload()\">RETRY</button>\n    </div>\n  </div>\n  <script>\n// ========== CONFIG ==========\nconst CFG = {\n  canvasW: 800, canvasH: 600,\n  player: { size: 24, accel: 0.3, maxSpeed: 4.5, friction: 0.9, hp: 100, hpRegen: 1/60, dashSpeed: 8, dashDur: 30, dashCd: 180 },\n  bullet: { speed: 10, life: 180, dmg: 10, radius: 4, color: '#0ff' },\n  field: { radius: 48, duration: 300, fadeTime: 60, maxFields: 5, slowMax: 0.5, slowPerField: 0.3 },\n  enemy: { basic: { hp: 30, speed: 1.8, size: 20, dmg: 10, atkCd: 120, color: '#f44' }, heavy: { hp: 120, speed: 0.9, size: 36, dmg: 25, atkCd: 300, spawnCd: 300, color: '#f80' } },\n  wave: { baseCount: 4, countInc: 2, heavyChance: 0.1, heavyInc: 0.05 },\n  colors: { bg: '#0a0a12', stars: ['#fff', '#0ff', '#f0f', '#ff0'], grid: '#1a1a3a' }\n};\n\n// ========== UTIL ==========\nconst rand = (a,b)=>Math.random()*(b-a)+a;\nconst randInt = (a,b)=>Math.floor(rand(a,b+1));\nconst dist = (a,b)=>Math.hypot(a.x-b.x, a.y-b.y);\nconst clamp = (v,min,max)=>Math.max(min,Math.min(max,v));\nconst lerp = (a,b,t)=>a+(b-a)*t;\n\n// ========== AUDIO ==========\nconst AudioCtx = new (window.AudioContext||webkitAudioContext)();\nconst Audio = {\n  play(freq, type='square', dur=0.1, vol=0.2, start=0){ if(!AudioCtx) return; const o=AudioCtx.createOscillator(), g=AudioCtx.createGain(); o.type=type; o.frequency.value=freq; g.gain.value=vol; o.connect(g); g.connect(AudioCtx.destination); o.start(AudioCtx.currentTime+start); o.stop(AudioCtx.currentTime+start+dur); },\n  shoot(){ this.play(880, 'sawtooth', 0.05, 0.15); this.play(440, 'square', 0.08, 0.1, 0.02); },\n  hit(){ this.play(220, 'triangle', 0.1, 0.2); },\n  kill(){ this.play(150, 'sawtooth', 0.15, 0.25); this.play(300, 'square', 0.1, 0.15, 0.05); },\n  dash(){ this.play(600, 'sine', 0.2, 0.2); },\n  field(){ this.play(400, 'sine', 0.3, 0.15); },\n  wave(){ this.play(330, 'triangle', 0.2, 0.2); this.play(495, 'triangle', 0.2, 0.15, 0.1); },\n  gameover(){ this.play(200, 'sawtooth', 0.5, 0.3); this.play(100, 'sawtooth', 0.8, 0.25, 0.2); }\n};\n\n// ========== ENTITIES ==========\nclass Player {\n  constructor(){\n    this.x = CFG.canvasW/2; this.y = CFG.canvasH/2;\n    this.vx = 0; this.vy = 0;\n    this.hp = CFG.player.hp; this.maxHp = CFG.player.hp;\n    this.size = CFG.player.size;\n    this.dashCd = 0; this.dashing = 0; this.dashDir = {x:0,y:0};\n    this.ammo = 30; this.maxAmmo = 30; this.ammoCd = 0;\n    this.lastHit = 0;\n    this.input = {x:0,y:0, shoot:false, dash:false};\n  }\n  update(){\n    // regen\n    if(this.hp < this.maxHp && this.lastHit > 60) this.hp = Math.min(this.maxHp, this.hp + CFG.player.hpRegen);\n    this.lastHit++;\n    // ammo regen\n    if(this.ammo < this.maxAmmo){ this.ammoCd++; if(this.ammoCd >= 60){ this.ammo++; this.ammoCd = 0; } }\n    // dash cooldown\n    if(this.dashCd > 0) this.dashCd--;\n    // dashing\n    if(this.dashing > 0){\n      this.dashing--;\n      this.x += this.dashDir.x * CFG.player.dashSpeed;\n      this.y += this.dashDir.y * CFG.player.dashSpeed;\n      // trail particles\n      for(let i=0;i<2;i++) particles.push(new Particle(this.x+rand(-8,8), this.y+rand(-8,8), rand(-1,1), rand(-1,1), 0.5, '#0ff', 15));\n    } else {\n      // normal movement\n      if(this.input.x || this.input.y){\n        this.vx += this.input.x * CFG.player.accel;\n        this.vy += this.input.y * CFG.player.accel;\n        const spd = Math.hypot(this.vx, this.vy);\n        if(spd > CFG.player.maxSpeed){ this.vx = this.vx/spd*CFG.player.maxSpeed; this.vy = this.vy/spd*CFG.player.maxSpeed; }\n      } else {\n        this.vx *= CFG.player.friction; this.vy *= CFG.player.friction;\n      }\n      this.x += this.vx; this.y += this.vy;\n    }\n    // bounds\n    this.x = clamp(this.x, this.size, CFG.canvasW - this.size);\n    this.y = clamp(this.y, this.size, CFG.canvasH - this.size);\n    // shoot\n    if(this.input.shoot && this.ammo > 0 && game.bulletCd <= 0){\n      const ang = Math.atan2(mouse.y - this.y, mouse.x - this.x);\n      bullets.push(new Bullet(this.x, this.y, ang));\n      this.ammo--; this.ammoCd = 0; game.bulletCd = 8;\n      Audio.shoot();\n    }\n    // dash input\n    if(this.input.dash && this.dashCd <= 0 && !this.dashing){\n      const ang = Math.atan2(this.input.y || this.vy, this.input.x || this.vx) || 0;\n      this.dashDir = {x:Math.cos(ang), y:Math.sin(ang)};\n      this.dashing = CFG.player.dashDur;\n      this.dashCd = CFG.player.dashCd;\n      Audio.dash();\n    }\n  }\n  draw(ctx){\n    ctx.save();\n    ctx.translate(this.x, this.y);\n    if(this.dashing > 0) ctx.rotate(Math.atan2(this.dashDir.y, this.dashDir.x));\n    // ship body\n    ctx.beginPath();\n    ctx.moveTo(0, -this.size);\n    ctx.lineTo(this.size*0.7,