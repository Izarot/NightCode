    text-shadow: 0 0 20px #00ffff, 0 0 40px #00ffff;\n    margin-bottom: 30px;\n    text-align: center;\n}\n\nh2 {\n    color: #ff00ff;\n    font-size: clamp(20px, 5vw, 36px);\n    text-shadow: 0 0 20px #ff00ff;\n    margin-bottom: 20px;\n}\n\nbutton {\n    background: linear-gradient(180deg, #1a1a3a, #0a0a2a);\n    color: #00ffff;\n    border: 3px solid #00ffff;\n    padding: 15px 40px;\n    font-size: clamp(14px, 3vw, 20px);\n    font-family: inherit;\n    cursor: pointer;\n    margin: 10px;\n    transition: all 0.2s;\n    text-transform: uppercase;\n    box-shadow: 0 0 15px rgba(0, 255, 255, 0.3);\n}\n\nbutton:hover, button:active {\n    background: linear-gradient(180deg, #2a2a5a, #1a1a4a);\n    box-shadow: 0 0 25px rgba(0, 255, 255, 0.6);\n    transform: scale(1.05);\n}\n\n#menu-highscore {\n    color: #ffd700;\n    font-size: clamp(12px, 2.5vw, 18px);\n    margin-top: 20px;\n    text-shadow: 0 0 10px #ffd700;\n}\n\n#new-hs {\n    color: #ffd700;\n    font-size: clamp(16px, 4vw, 28px);\n    text-shadow: 0 0 20px #ffd700;\n    animation: pulse 0.5s ease-in-out infinite alternate;\n}\n\n.hidden {\n    display: none;\n}\n\n@keyframes pulse {\n    from { transform: scale(1); }\n    to { transform: scale(1.1); }\n}\n\n.setting {\n    display: flex;\n    align-items: center;\n    gap: 15px;\n    margin: 15px 0;\n    color: #00ffff;\n    font-size: 16px;\n}\n\n.setting input[type=\"range\"] {\n    width: 150px;\n    accent-color: #00ffff;\n}\n\n#touch-controls {\n    position: absolute;\n    bottom: 0;\n    left: 0;\n    width: 100%;\n    height: 200px;\n    display: none;\n    pointer-events: none;\n    z-index: 50;\n}\n\n@media (pointer: coarse) {\n    #touch-controls {\n        display: block;\n    }\n}\n\n#joystick-zone {\n    position: absolute;\n    left: 30px;\n    bottom: 30px;\n    width: 120px;\n    height: 120px;\n    pointer-events: auto;\n}\n\n#joystick-base {\n    width: 100%;\n    height: 100%;\n    background: rgba(0, 255, 255, 0.2);\n    border: 3px solid rgba(0, 255, 255, 0.5);\n    border-radius: 50%;\n}\n\n#joystick-thumb {\n    width: 50px;\n    height: 50px;\n    background: rgba(0, 255, 255, 0.6);\n    border: 2px solid #00ffff;\n    border-radius: 50%;\n    position: absolute;\n    top: 50%;\n    left: 50%;\n    transform: translate(-50%, -50%);\n}\n\n#fire-btn {\n    position: absolute;\n    right: 40px;\n    bottom: 40px;\n    width: 80px;\n    height: 80px;\n    border-radius: 50%;\n    font-size: 32px;\n    background: rgba(255, 0, 100, 0.3);\n    border-color: #ff0066;\n    color: #ff0066;\n    pointer-events: auto;\n    box-shadow: 0 0 20px rgba(255, 0, 100, 0.5);\n}\n\n#level-info {\n    position: absolute;\n    top: 50px;\n    left: 50%;\n    transform: translateX(-50%);\n    color: #ffaa00;\n    font-size: 24px;\n    text-shadow: 0 0 15px #ffaa00;\n    background: rgba(0,0,0,0.7);\n    padding: 10px 20px;\n    border: 2px solid #ffaa00;\n    pointer-events: none;\n    z-index: 10;\n}", "main.js": "const canvas = document.getElementById('gameCanvas');\nconst ctx = canvas.getContext('2d');\n\n// Canvas setup with responsive scaling\nfunction resizeCanvas() {\n    const container = document.getElementById('game-container');\n    const ratio = 1280 / 720;\n    let width = Math.min(window.innerWidth, container.clientWidth);\n    let height = Math.min(window.innerHeight, container.clientHeight);\n    \n    if (width / height > ratio) {\n        width = height * ratio;\n    } else {\n        height = width / ratio;\n    }\n    \n    canvas.width = 1280;\n    canvas.height = 720;\n    canvas.style.width = width + 'px';\n    canvas.style.height = height + 'px';\n}\nresizeCanvas();\nwindow.addEventListener('resize', resizeCanvas);\n\n// Vibrant color palette\nconst COLORS = {\n    player: '#00ffff',\n    playerDark: '#008888',\n    enemy: '#ff0066',\n    enemyDark: '#aa0044',\n    enemyShooter: '#ff6600',\n    enemyHopper: '#aa00ff',\n    enemyTank: '#ff0000',\n    bulletPlayer: '#00ffff',\n    bulletEnemy: '#ff3300',\n    powerup: '#ffd700',\n    healthOrb: '#00ff00',\n    shieldOrb: '#00aaff',\n    speedOrb: '#ffff00',\n    ammoOrb: '#ff8800',\n    background: '#0d1117',\n    stars: '#ffffff'\n};\n\n// Audio System using Web Audio API\nclass AudioSystem {\n    constructor() {\n        this.ctx = new (window.AudioContext || window.webkitAudioContext)();\n        this.musicVol = 0.3;\n        this.sfxVol = 0.4;\n        this.muted = false;\n        this.musicOsc = null;\n    }\n    \n    playTone(freq, duration, type = 'square', vol = 0.3) {\n        if (this.muted || !this.ctx) return;\n        const osc = this.ctx.createOscillator();\n        const gain = this.ctx.createGain();\n        osc.connect(gain);\n        gain.connect(this.ctx.destination);\n        osc.frequency.value = freq;\n        osc.type = type;\n        gain.gain.setValueAtTime(vol * this.sfxVol, this.ctx.currentTime);\n        gain.gain.exponentialRampToValueAtTime(0.001, this.ctx.currentTime + duration);\n        osc.start();\n        osc.stop(this.ctx.currentTime + duration);\n    }\n    \n    playShoot() {\n        this.playTone(880, 0.1, 'square', 0.3);\n        setTimeout(() => this.playTone(440, 0.05, 'sawtooth', 0.2), 20);\n    }\n    \n    playHit() {\n        this.playTone(200, 0.1, 'sawtooth', 0.25);\n    }\n    \n    playExplosion() {\n        this.playTone(100, 0.3, 'sawtooth', 0.4);\n        this.playTone(50, 0.4, 'square', 0.3);\n    }\n    \n    playPowerup() {\n        this.playTone(523, 0.1, 'sine', 0.4);\n        setTimeout(() => this.playTone(659, 0.1, 'sine', 0.4), 100);\n        setTimeout(() => this.playTone(784, 0.15, 'sine', 0.4), 200);\n    }\n    \n    playDamage() {\n        this.playTone(150, 0.2, 'sawtooth', 0.5);\n    }\n    \n    playGameOver() {\n        this.playTone(400, 0.3, 'square', 0.5);\n        setTimeout(() => this.playTone(300, 0.3, 'square', 0.5), 300);\n        setTimeout(() => this.playTone(200, 0.5, 'sawtooth', 0.5), 600);\n    }\n    \n    playLevelUp() {\n        this.playTone(523, 0.15, 'sine', 0.5);\n        setTimeout(() => this.playTone(659, 0.15, 'sine', 0.5), 150);\n        setTimeout(() => this.playTone(784, 0.15, 'sine', 0.5), 300);\n        setTimeout(() => this.playTone(1047, 0.3, 'sine', 0.5), 450);\n    }\n    \n    startMusic() {\n        if (this.musicOsc || this.muted) return;\n        const playNote = (freq, time) => {\n            if (this.muted) return;\n            const osc = this.ctx.createOscillator();\n            const gain = this.ctx.createGain();\n            osc.connect(gain);\n            gain.connect(this.ctx.destination);\n            osc.frequency.value = freq;\n            osc.type = 'triangle';\n            gain.gain.setValueAtTime(0.05 * this.musicVol, this.ctx.currentTime + time);\n            gain.gain.exponentialRampToValueAtTime(0.001, this.ctx.currentTime + time + 0.4);\n            osc.start(this.ctx.currentTime + time);\n            osc.stop(this.ctx.currentTime + time + 0.4);\n        };\n        \n        const melody = [262, 330, 392, 523, 392, 330, 262, 294, 349, 440, 349, 294];\n        const playLoop = () => {\n            if (this.muted) return;\n            melody.forEach((f, i) => playNote(f, i * 0.25));\n            this.musicTimeout = setTimeout(playLoop, melody.length * 250);\n        };\n        playLoop();\n    }\n    \n    stopMusic() {\n        if (this.musicTimeout) clearTimeout(this.musicTimeout);\n    }\n    \n    setMusicVolume(v) {\n        this.musicVol = v / 100;\n    }\n    \n    setSFXVolume(v) {\n        this.sfxVol = v / 100;\n    }\n    \n    toggleMute() {\n        this.muted = !this.muted;\n        if (this.muted) this.stopMusic();\n        else this.startMusic();\n        return this.muted;\n    }\n}\n\nconst audio = new AudioSystem();\n\n// Save System\nconst SaveSystem = {\n    getHighScore() {\n        return parseInt(localStorage.getItem('splinter_highScore') || '0');\n    },\n    \n    setHighScore(score) {\n        const current = this.getHighScore();\n        if (score > current) {\n            localStorage.setItem('splinter_highScore', score.toString());\n            return true;\n        }\n        return false;\n    },\n    \n    getSettings() {\n        const defaults = { musicVol: 30, sfxVol: 40, muted: false };\n        try {\n            return { ...defaults, ...JSON.parse(localStorage.getItem('splinter_settings') || '{}') };\n        } catch {\n            return defaults;\n        }\n    },\n    \n    saveSettings(settings) {\n        localStorage.setItem('splinter_settings', JSON.stringify(settings));\n    }\n};\n\n// Game State\nconst GameState = {\n    MENU: 'menu',\n    PLAYING: 'playing',\n    PAUSED: 'paused',\n    GAMEOVER: 'gameover',\n    LEVEL_COMPLETE: 'levelcomplete',\n    SETTINGS: 'settings'\n};\n\nlet currentState = GameState.MENU;\nlet gameTime = 0;\nlet levelTime = 0;\nlet score = 0;\nlet currentLevel = 1;\nlet waveCount = 0;\nlet highScore = SaveSystem.getHighScore();\n\n// Player\nconst player = {\n    x: 640,\n    y: 360,\n    vx: 0,\n    vy: 0,\n    angle: 0,\n    radius: 16,\n    health: 100,\n    maxHealth: 100,\n    ammo: 30,\n    maxAmmo: 30,\n    fireRate: 120,\n    lastShot: 0,\n    speed: 4,\n    acceleration: 0.25,\n    friction: 0.15,\n    shield: 0,\n    speedBoost: 0,\n    splitBoost: 0,\n    invincible: 0\n};\n\n// Input\nconst keys = {};\nlet joystickActive = false;\nlet joystickX = 0;\nlet joystickY = 0;\nlet firePressed = false;\n\ndocument.addEventListener('keydown', e => {\n    keys[e.key.toLowerCase()] = true;\n    if (e.key === ' ') { e.preventDefault(); firePressed = true; }\n    if (e.key === 'Escape' && currentState === GameState.PLAYING) {\n        setState(GameState.PAUSED);\n    }\n});\n\ndocument.addEventListener('keyup', e => {\n    keys[e.key.toLowerCase()] = false;\n    if (e.key === ' ') firePressed = false;\n});\n\n// Touch controls\nconst joystickBase = document.getElementById('joystick-base');\nconst joystickThumb = document.getElementById('joystick-thumb');\nconst fireBtn = document.getElementById('fire-btn');\n\nlet joystickTouchId = null;\nlet fireTouchId = null;\n\njoystickBase.addEventListener('touchstart', e => {\n    e.preventDefault();\n    joystickTouchId = e.changedTouches[0].identifier;\n    joystickActive = true;\n    handleJoystickMove(e.changedTouches[0]);\n});\n\njoystickBase.addEventListener('touchmove', e => {\n    e.preventDefault();\n    for (let touch of e.changedTouches) {\n        if (touch.identifier === joystickTouchId) {\n            handleJoystickMove(touch);\n        }\n    }\n});\n\njoystickBase.addEventListener('touchend', e => {\n    for (let touch of e.changedTouches) {\n        if (touch.identifier === joystickTouchId) {\n            joystickActive = false;\n            joystickX = 0;\n            joystickY = 0;\n            joystickThumb.style.transform = 'translate(-50%, -50%)';\n        }\n    }\n});\n\nfunction handleJoystickMove(touch) {\n    const rect = joystickBase.getBoundingClientRect();\n    const centerX = rect.left + rect.width / 2;\n    const centerY = rect.top + rect.height / 2;\n    let dx = touch.clientX - centerX;\n    let dy = touch.clientY - centerY;\n    const dist = Math.sqrt(dx * dx + dy * dy);\n    const maxDist = rect.width / 2 - 25;\n    \n    if (dist > maxDist) {\n        dx = dx / dist * maxDist;\n        dy = dy / dist * maxDist;\n    }\n    \n    joystickX = dx / maxDist;\n    joystickY = dy / maxDist;\n    joystickThumb.style.transform = `translate(calc(-50% + ${dx}px), calc(-50% + ${dy}px))`;\n}\n\nfireBtn.addEventListener('touchstart', e => {\n    e.preventDefault();\n    fireTouchId = e.changedTouches[0].identifier;\n    firePressed = true;\n});\n\nfireBtn.addEventListener('touchend', e => {\n    for (let touch of e.changedTouches) {\n        if (touch.identifier === fireTouchId) {\n            firePressed = false;\n        }\n    }\n});\n\n// Entities\nlet bullets = [];\nlet enemies = [];\nlet powerups = [];\nlet particles = [];\nlet stars = [];\n\n// Initialize stars\nfor (let i = 0; i < 100; i++) {\n    stars.push({\n        x: Math.random() * 1280,\n        y: Math.random() * 720,\n        size: Math.random() * 2 + 0.5,\n        alpha: Math.random() * 0.5 + 0.3\n    });\n}\n\n// Enemy types\nconst EnemyTypes = {\n    SLASHER: { health: 80, speed: 2, splitCount: 2, color: COLORS.enemy, size: 20, score: 100 },\n    SHOOTER: { health: 60, speed: 1.5, splitCount: 1, color: COLORS.enemyShooter, size: 18, score: 150, canShoot: true },\n    HOPPER: { health: 40, speed: 3, splitCount: 3, color: COLORS.enemyHopper, size: 14, score: 80 },\n    TANK: { health: 150, speed: 1, splitCount: 0, color: COLORS.enemyTank, size: 28, score: 300 },\n    BOSS: { health: 300, speed: 1.5, splitCount: 0, color: '#ff00ff', size: 50, score: 1000, isBoss: true }\n};\n\n// Powerup types\nconst PowerupTypes = {\n    HEALTH: { color: COLORS.healthOrb, effect: 'health', value: 33 },\n    SHIELD: { color: COLORS.shieldOrb, effect: 'shield', value: 5000 },\n    SPEED: { color: COLORS.speedOrb, effect: 'speed', value: 5000 },\n    AMMO: { color: COLORS.ammoOrb, effect: 'ammo', value: 15 },\n    SPLIT: { color: COLORS.powerup, effect: 'split', value: 2 }\n};\n\nfunction spawnEnemy(type, x, y, depth = 0) {\n    const config = EnemyTypes[type];\n    enemies.push({\n        type,\n        x: x || Math.random() * 1200 + 40,\n        y: y || Math.random() * 680 + 20,\n        vx: (Math.random() - 0.5) * 2,\n        vy: (Math.random() - 0.5) * 2,\n        health: config.health,\n        maxHealth: config.health,\n        speed: config.speed,\n        radius: config.size,\n        splitCount: config.splitCount,\n        splitDepth: depth,\n        color: config.color,\n        angle: Math.random() * Math.PI * 2,\n        lastShot: 0,\n        state: 'seek',\n        patternTime: 0,\n        flashTime: 0,\n        canShoot: config.canShoot || false,\n        isBoss: config.isBoss || false\n    });\n}\n\nfunction spawnPowerup(x, y) {\n    const types = Object.keys(PowerupTypes);\n    const weights = [0.2, 0.1, 0.05, 0.3, 0.05];\n    let r = Math.random();\n    let type = types[0];\n    let cumWeight = 0;\n    \n    for (let i = 0; i < weights.length; i++) {\n        cumWeight += weights[i];\n        if (r < cumWeight) {\n            type = types[i];\n            break;\n        }\n    }\n    \n    const config = PowerupTypes[type];\n    powerups.push({\n        x, y,\n        type,\n        color: config.color,\n        effect: config.effect,\n        value: config.value,\n        radius: 12,\n        pulseTime: 0\n    });\n}\n\nfunction spawnParticles(x, y, color, count, speed = 3) {\n    for (let i = 0; i < count; i++) {\n        const angle = Math.random() * Math.PI * 2;\n        const vel = Math.random() * speed + 1;\n        particles.push({\n            x, y,\n            vx: Math.cos(angle) * vel,\n            vy: Math.sin(angle) * vel,\n            color,\n            life: 30,\n            maxLife: 30,\n            size: Math.random() * 4 + 2\n        });\n    }\n}\n\nfunction fireBullet(x, y, angle, speed, isPlayer) {\n    bullets.push({\n        x, y,\n        vx: Math.cos(angle) * speed,\n        vy: Math.sin(angle) * speed,\n        isPlayer,\n        radius: isPlayer ? 4 : 5,\n        color: isPlayer ? COLORS.bulletPlayer : COLORS.bulletEnemy,\n        life: 120,\n        trail: []\n    });\n    if (isPlayer) audio.playShoot(); player.ammo--; } if (player.splitBoost > 0) { const spread = 0.15; fireBullet(x, y, angle - spread, speed, isPlayer); fireBullet(x, y, angle + spread, speed, isPlayer); } } function updatePlayer(dt) { let ax = 0, ay = 0; if (keys['w'] || keys['arrowup']) ay -= 1; if (keys['s'] || keys['arrowdown']) ay += 1; if (keys['a'] || keys['arrowleft']) ax -= 1; if (keys['d'] || keys['arrowright']) ax += 1; if (joystickActive) { ax = joystickX; ay = joystickY; } let speed = player.speed; if (player.speedBoost > 0) speed *= 1.5; player.vx += ax * player.acceleration * speed; player.vy += ay * player.acceleration * speed; player.vx *= (1 - player.friction); player.vy *= (1 - player.friction); player.x += player.vx; player.y += player.vy; player.x = Math.max(player.radius, Math.min(1280 - player.radius, player.x)); player.y = Math.max(player.radius, Math.min(720 - player.radius, player.y)); let mouseX = 0, mouseY = 0; if (keys['m'] && player.ammo > 0) { const now = Date.now(); if (now - player.lastShot > player.fireRate) { player.lastShot = now; fireBullet(player.x, player.y, player.angle, 12, true); } } if (player.speedBoost > 0) player.speedBoost -= dt; if (player.splitBoost > 0) player.splitBoost -= dt; if (player.shield > 0) player.shield -= dt; if (player.invincible > 0) player.invincible -= dt; if (firePressed && player.ammo > 0) { const now = Date.now(); if (now - player.lastShot > player.fireRate) { player.lastShot = now; fireBullet(player.x, player.y, player.angle, 12, true); } } } function updateBullets() { bullets = bullets.filter(b => { b.trail.unshift({ x: b.x, y: b.y }); if (b.trail.length > 5) b.trail.pop(); b.x += b.vx; b.y += b.vy; b.life--; if (b.x < 0 || b.x > 1280 || b.y < 0 || b.y > 720 || b.life <= 0) return false; if (b.isPlayer) { for (let e of enemies) { const dx = b.x - e.x; const dy = b.y - e.y; const dist = Math.sqrt(dx * dx + dy * dy); if (dist < e.radius + b.radius) { e.health -= 50; e.flashTime = 5; spawnParticles(e.x, e.y, e.color, 5); audio.playHit(); if (e.health <= 0) { score += EnemyTypes[e.type].score; waveCount++; spawnParticles(e.x, e.y, e.color, 15, 5); audio.playExplosion(); if (Math.random() < 0.3) spawnPowerup(e.x, e.y); if (e.splitCount > 0 && e.splitDepth < 2) { for (let i = 0; i < e.splitCount; i++) { spawnEnemy(e.type, e.x + (Math.random() - 0.5) * 30, e.y + (Math.random() - 0.5) * 30, e.splitDepth + 1); } } enemies = enemies.filter(en => en !== e); } return false; } } } else { const dx = b.x - player.x; const dy = b.y - player.y; const dist = Math.sqrt(dx * dx + dy * dy); if (dist < player.radius + b.radius) { if (player.shield <= 0 && player.invincible <= 0) { player.health -= 20; audio.playDamage(); spawnParticles(player.x, player.y, '#ff0000', 8); updateHealthUI(); if (player.health <= 0) { gameOver(); } } return false; } } return true; }); } function updateEnemies() { enemies.forEach(e => { e.patternTime++; const dx = player.x - e.x; const dy = player.y - e.y; const dist = Math.sqrt(dx * dx + dy * dy); e.angle = Math.atan2(dy, dx); if (e.isBoss) { if (e.patternTime % 120 < 60) { e.x += Math.cos(e.patternTime * 0.02) * e.speed; e.y += Math.sin(e.patternTime * 0.03) * e.speed; } else { e.x += (dx / dist) * e.speed * 0.5; e.y += (dy / dist) * e.speed * 0.5; } if (e.patternTime % 90 === 0) { for (let i = 0; i < 8; i++) { const angle = (i / 8) * Math.PI * 2; fireBullet(e.x, e.y, angle, 5, false); } } } else if (e.type === 'SHOOTER') { if (dist > 150) { e.x += (dx / dist) * e.speed; e.y += (dy / dist) * e.speed; } const now = Date.now(); if (now - e.lastShot > 2000 && dist < 400) { e.lastShot = now; fireBullet(e.x, e.y, e.angle, 6, false); } } else if (e.type === 'HOPPER') { if (e.patternTime % 60 === 0) { e.vx = (Math.random() - 0.5) * e.speed * 3; e.vy = (Math.random() - 0.5) * e.speed * 3; } e.x += e.vx; e.y += e.vy; } else { e.x += (dx / dist) * e.speed; e.y += (dy / dist) * e.speed; } e.x = Math.max(e.radius, Math.min(1280 - e.radius, e.x)); e.y = Math.max(e.radius, Math.min(720 - e.radius, e.y)); if (e.flashTime > 0) e.flashTime--; if (dist < player.radius + e.radius && player.shield <= 0 && player.invincible <= 0) { player.health -= 15; audio.playDamage(); spawnParticles(player.x, player.y, '#ff0000', 5); player.invincible = 500; updateHealthUI(); if (player.health <= 0) gameOver(); } }); } function updatePowerups() { powerups = powerups.filter(p => { p.pulseTime++; const dx = player.x - p.x; const dy = player.y - p.y; const dist = Math.sqrt(dx * dx + dy * dy); if (dist < player.radius + p.radius + 20) { const speed = 3; p.x += (dx / dist) * speed; p.y += (dy / dist) * speed; } if (dist < player.radius + p.radius) { audio.playPowerup(); spawnParticles(p.x, p.y, p.color, 10); switch (p.effect) { case 'health': player.health = Math.min(player.maxHealth, player.health + p.value); break; case 'shield': player.shield = p.value; break; case 'speed': player.speedBoost = p.value; break; case 'ammo': player.ammo = Math.min(player.maxAmmo, player.ammo + p.value); break; case 'split': player.splitBoost = p.value; break; } updateHealthUI(); updateAmmoUI(); updatePowerupDisplay(p.effect); return false; } return true; }); } function updateParticles() { particles = particles.filter(p => { p.x += p.vx; p.y += p.vy; p.vx *= 0.95; p.vy *= 0.95; p.life--; return p.life > 0; }); } function draw() { ctx.fillStyle = COLORS.background; ctx.fillRect(0, 0, 1280, 720); stars.forEach(s => { ctx.fillStyle = `rgba(255, 255, 255, ${s.alpha})`; ctx.beginPath(); ctx.arc(s.x, s.y, s.size, 0, Math.PI * 2); ctx.fill(); }); powerups.forEach(p => { const pulse = Math.sin(p.pulseTime * 0.1) * 0.3 + 1; ctx.fillStyle = p.color; ctx.shadowColor = p.color; ctx.shadowBlur = 15; ctx.beginPath(); ctx.arc(p.x, p.y, p.radius * pulse, 0, Math.PI * 2); ctx.fill(); ctx.shadowBlur = 0; }); particles.forEach(p => { const alpha = p.life / p.maxLife; ctx.fillStyle = p.color; ctx.globalAlpha = alpha; ctx.beginPath(); ctx.arc(p.x, p.y, p.size * alpha, 0, Math.PI * 2); ctx.fill(); ctx.globalAlpha = 1; }); bullets.forEach(b => { if (b.trail.length > 1) { ctx.strokeStyle = b.color; ctx.lineWidth = b.radius * 2; ctx.lineCap = 'round'; ctx.beginPath(); ctx.moveTo(b.trail[0].x, b.trail[0].y); for (let i = 1; i < b.trail.length; i++) { ctx.globalAlpha = 1 - (i / b.trail.length); ctx.lineTo(b.trail[i].x, b.trail[i].y); } ctx.stroke(); ctx.globalAlpha = 1; } ctx.fillStyle = b.color; ctx.shadowColor = b.color; ctx.shadowBlur = 10; ctx.beginPath(); ctx.arc(b.x, b.y, b.radius, 0, Math.PI * 2); ctx.fill(); ctx.shadowBlur = 0; }); enemies.forEach(e => { const flash = e.flashTime > 0; ctx.fillStyle = flash ? '#ffffff' : e.color; ctx.shadowColor = e.color; ctx.shadowBlur = e.isBoss ? 30 : 15; ctx.beginPath(); if (e.type === 'TANK' || e.isBoss) { const sides = e.isBoss ? 6 : 5; ctx.moveTo(e.x + e.radius, e.y); for (let i = 1; i <= sides; i++) { const angle = (i / sides) * Math.PI * 2; ctx.lineTo(e.x + Math.cos(angle) * e.radius, e.y + Math.sin(angle) * e.radius); } ctx.closePath(); } else { ctx.arc(e.x, e.y, e.radius, 0, Math.PI * 2); } ctx.fill(); ctx.shadowBlur = 0; if (e.isBoss) { ctx.strokeStyle = '#ffffff'; ctx.lineWidth = 2; ctx.stroke(); ctx.fillStyle = '#ff0000'; ctx.fillRect(e.x - 25, e.y - e.radius - 15, 50 * (e.health / e.maxHealth), 8); ctx.strokeRect(e.x - 25, e.y - e.radius - 15, 50, 8); } }); if (player.shield > 0) { ctx.strokeStyle = COLORS.shieldOrb; ctx.lineWidth = 3; ctx.shadowColor = COLORS.shieldOrb; ctx.shadowBlur = 15; ctx.beginPath(); ctx.arc(player.x, player.y, player.radius + 8, 0, Math.PI * 2); ctx.stroke(); ctx.shadowBlur = 0; } const pFlash = player.invincible > 0 && Math.floor(player.invincible / 100) % 2 === 0; ctx.fillStyle = pFlash ? '#ffffff' : COLORS.player; ctx.shadowColor = COLORS.player; ctx.shadowBlur = 15; ctx.save(); ctx.translate(player.x, player.y); ctx.rotate(player.angle); ctx.beginPath(); ctx.moveTo(player.radius, 0); ctx.lineTo(-player.radius * 0.7, player.radius * 0.7); ctx.lineTo(-player.radius * 0.3, 0); ctx.lineTo(-player.radius * 0.7, -player.radius * 0.7); ctx.closePath(); ctx.fill(); ctx.shadowBlur = 0; ctx.restore(); } function spawnWave() { const baseCount = 3 + currentLevel * 2; for (let i = 0; i < baseCount; i++) { const types = ['SLASHER', 'SLASHER', 'SHOOTER', 'HOPPER']; if (currentLevel >= 2) types.push('TANK'); if (currentLevel >= 3 && waveCount % 5 === 0) types.push('TANK'); const type = types[Math.floor(Math.random() * types.length)]; const edge = Math.floor(Math.random() * 4); let x, y; switch (edge) { case 0: x = Math.random() * 1280; y = -30; break; case 1: x = 1310; y = Math.random() * 720; break; case 2: x = Math.random() * 1280; y = 750; break; case 3: x = -30; y = Math.random() * 720; break; } spawnEnemy(type, x, y); } if (currentLevel >= 2 && waveCount > 0 && waveCount % 10 === 0) { spawnEnemy('BOSS', 640, 100); } } function updateUI() { document.getElementById('score').textContent = score; document.getElementById('high-score').textContent = 'HI: ' + highScore; document.getElementById('timer').textContent = formatTime(gameTime); } function updateHealthUI() { const segments = document.querySelectorAll('.segment'); const healthPerSeg = player.maxHealth / 3; segments.forEach((seg, i) => { const segHealth = Math.max(0, Math.min(healthPerSeg, player.health - i * healthPerSeg)); const ratio = segHealth / healthPerSeg; seg.classList.remove('warning', 'danger', 'empty'); if (ratio <= 0) { seg.classList.add('empty'); } else if (ratio < 0.33) { seg.classList.add('danger'); } else if (ratio < 0.66) { seg.classList.add('warning'); } }); } function updateAmmoUI() { document.getElementById('ammo').textContent = player.ammo + '/∞'; } function updatePowerupDisplay(effect) { const display = document.getElementById('powerup-display'); const labels = { health: '❤ HEALTH', shield: '🛡️ SHIELD', speed: '⚡ SPEED', ammo: '🔫 AMMO', split: '💫 SPLIT' }; display.textContent = labels[effect] || effect; setTimeout(() => display.textContent = '', 2000); } function formatTime(ms) { const totalSeconds = Math.floor(ms / 1000); const minutes = Math.floor(totalSeconds / 60); const seconds = totalSeconds % 60; const centiseconds = Math.floor((ms % 1000) / 10); return String(minutes).padStart(2, '0') + ':' + String(seconds).padStart(2, '0') + '.' + String(centiseconds).padStart(2, '0'); } function setState(state) { document.querySelectorAll('.screen').forEach(s => s.classList.remove('active')); currentState = state; switch (state) { case GameState.MENU: document.getElementById('menu').classList.add('active'); document.getElementById('menu-hs').textContent = highScore; audio.stopMusic(); break; case GameState.PLAYING: audio.startMusic(); break; case GameState.PAUSED: document.getElementById('pause-menu').classList.add('active'); break; case GameState.GAMEOVER: document.getElementById('gameover-screen').classList.add('active'); document.getElementById('final-score').textContent = 'SCORE: ' + score; document.getElementById('time-display').textContent = 'TIME: ' + formatTime(gameTime); const isNewHS = SaveSystem.setHighScore(score); document.getElementById('new-hs').classList.toggle('hidden', !isNewHS); if (isNewHS) highScore = score; audio.playGameOver(); break; case GameState.LEVEL_COMPLETE: document.getElementById('level-complete').classList.add('active'); document.getElementById('level-score').textContent = 'SCORE: ' + score; audio.playLevelUp(); break; case GameState.SETTINGS: document.getElementById('settings-menu').classList.add('active'); break; } } function startGame() { player.x = 640; player.y = 360; player.vx = 0; player.vy = 0; player.health = player.maxHealth; player.ammo = player.maxAmmo; player.shield = 0; player.speedBoost = 0; player.splitBoost = 0; player.invincible = 0; bullets = []; enemies = []; powerups = []; particles = []; score = 0; gameTime = 0; levelTime = 0; waveCount = 0; currentLevel = 1; updateHealthUI(); updateAmmoUI(); setState(GameState.PLAYING); spawnWave(); } function nextLevel() { currentLevel++; levelTime = 0; bullets = bullets.filter(b => b.isPlayer); enemies.forEach(e => { spawnParticles(e.x, e.y, e.color, 5); }); enemies = []; setState(GameState.PLAYING); spawnWave(); } function gameOver() { setState(GameState.GAMEOVER); } function resetGame() { setState(GameState.MENU); } let lastTime = 0; function gameLoop(timestamp) { const dt = timestamp - lastTime; lastTime = timestamp; if (currentState === GameState.PLAYING) { gameTime += dt; levelTime += dt; updatePlayer(dt); updateBullets(); updateEnemies(); updatePowerups(); updateParticles(); updateUI(); if (enemies.length === 0) { if (c