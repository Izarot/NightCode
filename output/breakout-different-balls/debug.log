tings</h2><div style=\"text-align:left;margin:12px 0\"><label style=\"display:flex;justify-content:space-between;align-items:center;margin:8px 0\"><span>Sound</span><input type=\"range\" id=\"sfxVolume\" min=\"0\" max=\"100\" value=\"70\" onchange=\"game.setSetting('sfx',this.value/100)\"></label><label style=\"display:flex;justify-content:space-between;align-items:center;margin:8px 0\"><span>Music</span><input type=\"range\" id=\"musicVolume\" min=\"0\" max=\"100\" value=\"40\" onchange=\"game.setSetting('music',this.value/100)\"></label><label style=\"display:flex;justify-content:space-between;align-items:center;margin:8px 0\"><span>Fullscreen</span><input type=\"checkbox\" id=\"fullscreenToggle\" onchange=\"game.toggleFullscreen()\"></label></div><div class=\"btn btn-secondary\" onclick=\"game.showScreen('menu')\">Back</div></div></div><div class=\"screen\" id=\"highScoresScreen\"><div class=\"panel\"><h2 style=\"margin-bottom:12px\">High Scores</h2><div id=\"hsList\" style=\"text-align:left;margin:12px 0;max-height:300px;overflow-y:auto\"></div><div class=\"btn btn-secondary\" onclick=\"game.showScreen('menu')\">Back</div></div></div></div><script>const C={WIDTH:800,HEIGHT:600,PADDLE_W:120,PADDLE_H:16,PADDLE_SPEED:8,PADDLE_MIN_W:60,PADDLE_MAX_W:240,PADDLE_R:8,BALL_R:8,BALL_SPEED:5,BALL_MIN_SPEED:3,BALL_MAX_SPEED:14,BALL_BOUNCE:0.85,BRICK_W:40,BRICK_H:16,BRICK_GAP:4,MAX_BALLS:6,LIVES:5};const BT={IGNIS:{name:'Ignis',color:'#ff4400',glow:'#ff6600',desc:'Passes through bricks, burning them',speedMul:1.15},CRYOS:{name:'Cryos',color:'#00ddff',glow:'#88ffff',desc:'Freezes bricks into barriers',speedMul:0.9},FRACTIO:{name:'Fractio',color:'#ff88ff',glow:'#ffaaff',desc:'Splits into 2 on brick hit',speedMul:1.0},GRAVITON:{name:'Graviton',color:'#8844cc',glow:'#aa66ff',desc:'Pulled by gravity, arcing shots',speedMul:1.0},UMBRA:{name:'Umbra',color:'#444466',glow:'#8888aa',desc:'Reveals hidden bricks, passes through',speedMul:1.25},EXPLOSIO:{name:'Explosio',color:'#ff2200',glow:'#ff4400',desc:'AOE explosion on impact',speedMul:0.8},PLASMA:{name:'Plasma',color:'#00aaff',glow:'#44ddff',desc:'Chains lightning to nearby bricks',speedMul:1.0},ELASTIS:{name:'Elastis',color:'#ffdd00',glow:'#ffee44',desc:'Bounces forever, gains speed',speedMul:1.0},VACUO:{name:'Vacuo',color:'#113366',glow:'#2255aa',desc:'Attracts weak bricks',speedMul:1.0},NEXUS:{name:'Nexus',color:'#ffd700',glow:'#ffee88',desc:'Launches multiple balls',speedMul:1.0}};const PU_TYPES=['expand','shrink','multi','slow','fire','magnet','life','sticky'];const PU_COLORS={expand:'#44ff44',shrink:'#ff4444',multi:'#aa44ff',slow:'#4488ff',fire:'#ff8800',magnet:'#c0c0c0',life:'#ff69b4',sticky:'#ffaa00'};const PU_NAMES={expand:'Expand',shrink:'Shrink',multi:'Multi-Ball',slow:'Slow-Mo',fire:'Fire Trail',magnet:'Magnet',life:'Extra Life',sticky:'Sticky'};class AudioSys{constructor(){this.ctx=null;this.enabled=true;this.volumes={sfx:0.7,music:0.4};this.musicGain=null}init(){this.ctx=new(window.AudioContext||window.webkitAudioContext)();this.masterGain=this.ctx.createGain();this.masterGain.gain.value=1;this.masterGain.connect(this.ctx.destination);this.musicGain=this.ctx.createGain();this.musicGain.gain.value=this.volumes.music;this.musicGain.connect(this.masterGain)}play(type){if(!this.enabled||!this.ctx)return;const now=this.ctx.currentTime;const g=this.ctx.createGain();g.connect(this.masterGain);const o=this.ctx.createOscillator();o.connect(g);switch(type){case'paddle':o.type='sine';o.frequency.setValueAtTime(440,now);o.frequency.exponentialRampToValueAtTime(880,now+.05);g.gain.setValueAtTime(this.volumes.sfx*.5,now);g.gain.exponentialRampToValueAtTime(.001,now+.08);o.start(now);o.stop(now+.08);break;case'brick':o.type='square';o.frequency.setValueAtTime(600,now);o.frequency.exponentialRampToValueAtTime(200,now+.08);g.gain.setValueAtTime(this.volumes.sfx*.3,now);g.gain.exponentialRampToValueAtTime(.001,now+.1);o.start(now);o.stop(now+.1);break;case'destroy':{const n=this.ctx.createBufferSource();const buf=this.ctx.createBuffer(1,this.ctx.sampleRate*.15,this.ctx.sampleRate);const d=buf.getChannelData(0);for(let i=0;i<d.length;i++)d[i]=(Math.random()*2-1)*Math.pow(1-i/d.length,2);n.buffer=buf;const g2=this.ctx.createGain();g2.gain.setValueAtTime(this.volumes.sfx*.4,now);g2.gain.exponentialRampToValueAtTime(.001,now+.15);n.connect(g2);g2.connect(this.masterGain);n.start(now);o.frequency.setValueAtTime(150,now);g.gain.setValueAtTime(this.volumes.sfx*.3,now);g.gain.exponentialRampToValueAtTime(.001,now+.12);o.start(now);o.stop(now+.12);break}case'lose':o.type='sine';o.frequency.setValueAtTime(400,now);o.frequency.exponentialRampToValueAtTime(100,now+.3);g.gain.setValueAtTime(this.volumes.sfx*.4,now);g.gain.exponentialRampToValueAtTime(.001,now+.35);o.start(now);o.stop(now+.35);break;case'lifeLost':o.type='sawtooth';o.frequency.setValueAtTime(300,now);o.frequency.exponentialRampToValueAtTime(100,now+.35);g.gain.setValueAtTime(this.volumes.sfx*.4,now);g.gain.exponentialRampToValueAtTime(.001,now+.4);o.start(now);o.stop(now+.4);break;case'powerup':o.type='sine';o.frequency.setValueAtTime(523,now);o.frequency.setValueAtTime(659,now+.08);o.frequency.setValueAtTime(784,now+.16);g.gain.setValueAtTime(this.volumes.sfx*.4,now);g.gain.exponentialRampToValueAtTime(.001,now+.25);o.start(now);o.stop(now+.25);break;case'combo':o.type='triangle';o.frequency.setValueAtTime(800,now);o.frequency.exponentialRampToValueAtTime(1600,now+.15);g.gain.setValueAtTime(this.volumes.sfx*.3,now);g.gain.exponentialRampToValueAtTime(.001,now+.2);o.start(now);o.stop(now+.2);break;case'levelup':{for(let i=0;i<5;i++){const o2=this.ctx.createOscillator();const g2=this.ctx.createGain();o2.connect(g2);g2.connect(this.masterGain);o2.type='sine';o2.frequency.setValueAtTime(400+i*100,now+i*.1);g2.gain.setValueAtTime(this.volumes.sfx*.3,now+i*.1);g2.gain.exponentialRampToValueAtTime(.001,now+i*.1+.3);o2.start(now+i*.1);o2.stop(now+i*.1+.3)}break}case'gameover':o.type='sawtooth';o.frequency.setValueAtTime(300,now);o.frequency.exponentialRampToValueAtTime(50,now+.8);g.gain.setValueAtTime(this.volumes.sfx*.4,now);g.gain.exponentialRampToValueAtTime(.001,now+1);o.start(now);o.stop(now+1);break}}},
setVolume(type,v){this.volumes[type]=v;if(type==='music'&&this.musicGain)this.musicGain.gain.value=v}},

class Game{constructor(){this.canvas=document.getElementById('gameCanvas');this.ctx=this.canvas.getContext('2d');this.audio=new AudioSys();this.state='menu';this.selectedBall='IGNIS';this.unlockedBalls=['IGNIS'];this.balls=[];this.paddle=null;this.bricks=[];this.powerups=[];this.particles=[];this.floatingTexts=[];this.score=0;this.lives=C.LIVES;this.level=1;this.combo=0;this.maxCombo=0;this.timer=0;this.timerRunning=false;this.shakeTimer=0;this.shakeIntensity=0;this.stickyBalls=[];this.slowMo=1;this.lastTime=0;this.deltaTime=0;this.powerupTimers={};this.paddleBallAttached=false;this.countdownVal=0;this.countdownTimer=0;this.levelBricksDestroyed=0;this.levelTotalBricks=0;this.highScores=this.loadHighScores();this.menuAnimTime=0;this.resize();this.audio.init();this.setupInput();this.setupUI();this.showScreen('menu');this.loop(0)},
resize(){this.canvas.width=window.innerWidth;this.canvas.height=window.innerHeight;this.scale=Math.min(this.canvas.width/C.WIDTH,this.canvas.height/C.HEIGHT);this.offsetX=(this.canvas.width-C.WIDTH*this.scale)/2;this.offsetY=(this.canvas.height-C.HEIGHT*this.scale)/2},
setupInput(){const handleMouse=(x,y)=>{if(this.paddle&&this.state==='playing'){this.paddle.targetX=x/this.scale-this.offsetX/this.scale-C.PADDLE_W/2;this.paddle.targetX=Math.max(0,Math.min(C.WIDTH-C.PADDLE_W,this.paddle.targetX))}};const handleTouch=(x,y)=>{if(this.paddle&&this.state==='playing'){this.paddle.targetX=x/this.scale-this.offsetX/this.scale-C.PADDLE_W/2;this.paddle.targetX=Math.max(0,Math.min(C.WIDTH-C.PADDLE_W,this.paddle.targetX))}};let mouseDown=false;this.canvas.addEventListener('mousemove',e=>{if(this.state==='playing'){const r=this.canvas.getBoundingClientRect();handleMouse(e.clientX-r.left,e.clientY-r.top)}});this.canvas.addEventListener('mousedown',e=>{mouseDown=true;if(this.state==='playing'){const r=this.canvas.getBoundingClientRect();handleMouse(e.clientX-r.left,e.clientY-r.top)}});this.canvas.addEventListener('mouseup',()=>mouseDown=false);this.canvas.addEventListener('touchmove',e=>{e.preventDefault();if(this.state==='playing'){const t=e.touches[0];const r=this.canvas.getBoundingClientRect();handleTouch(t.clientX-r.left,t.clientY-r.top)}},{passive:false});this.canvas.addEventListener('touchstart',e=>{e.preventDefault();if(this.state==='playing'){const t=e.touches[0];const r=this.canvas.getBoundingClientRect();handleTouch(t.clientX-r.left,t.clientY-r.top)}},{passive:false});document.addEventListener('keydown',e=>{if(e.key==='Escape'||e.key==='p'){if(this.state==='playing')this.pause();else if(this.state==='paused')this.resume()}});document.getElementById('pauseBtn').addEventListener('click',()=>{if(this.state==='playing')this.pause();else if(this.state==='paused')this.resume()});document.getElementById('touchPause').addEventListener('click',()=>{if(this.state==='playing')this.pause();else if(this.state==='paused')this.resume()}},
setupUI(){this.setupMenuBallCarousel();this.setupBallSelectGrid();this.updateHighScoresDisplay()},
setupMenuBallCarousel(){const c=document.getElementById('menuBallCarousel');c.innerHTML='';Object.entries(BT).forEach(([key,ball])=>{const d=document.createElement('div');d.className='ball-icon'+(this.selectedBall===key?' selected':'')+(this.unlockedBalls.includes(key)?'':' locked');d.style.background=ball.color;d.style.boxShadow=`0 0 8px ${ball.glow}40`;d.textContent=ball.name.substring(0,3);d.title=ball.name;d.onclick=()=>{if(this.unlockedBalls.includes(key)){this.selectedBall=key;this.setupMenuBallCarousel();this.drawMenuBallPreview()}};c.appendChild(d)});this.drawMenuBallPreview()},
drawMenuBallPreview(){const c=document.getElementById('menuBallPreview');if(!c)return;const x=c.getContext('2d');x.clearRect(0,0,80,80);const b=BT[this.selectedBall];x.beginPath();x.arc(40,40,18,0,Math.PI*2);x.fillStyle=b.color;x.shadowColor=b.glow;x.shadowBlur=15;x.fill();x.shadowBlur=0},
setupBallSelectGrid(){const g=document.getElementById('ballSelectGrid');g.innerHTML='';Object.entries(BT).forEach(([key,ball])=>{const d=document.createElement('div');d.className='ball-select-item'+(this.selectedBall===key?' selected':'')+(this.unlockedBalls.includes(key)?'':' locked');const mc=document.createElement('canvas');mc.width=36;mc.height=36;const mx=mc.getContext('2d');mx.beginPath();mx.arc(18,18,12,0,Math.PI*2);mx.fillStyle=ball.color;mx.shadowColor=ball.glow;mx.shadowBlur=8;mx.fill();const nm=document.createElement('div');nm.className='bs-name';nm.textContent=ball.name;const ds=document.createElement('div');ds.className='bs-desc';ds.textContent=ball.desc;d.appendChild(mc);d.appendChild(nm);d.appendChild(ds);d.onclick=()=>{if(this.unlockedBalls.includes(key)){this.selectedBall=key;this.setupBallSelectGrid()}};g.appendChild(d)})},
confirmBall(){this.showScreen('menu')},
showScreen(name){document.querySelectorAll('.screen').forEach(s=>s.classList.remove('active'));const el=document.getElementById(name+'Screen');if(el)el.classList.add('active');const hud=document.getElementById('hud');const puBar=document.getElementById('powerupBar');const pauseBtn=document.getElementById('pauseBtn');const touchPause=document.getElementById('touchPause');if(name==='playing'){hud.classList.add('active');puBar.classList.add('active');pauseBtn.classList.add('active');touchPause.classList.add('active')}else{hud.classList.remove('active');puBar.classList.remove('active');pauseBtn.classList.remove('active');touchPause.classList.remove('active')}},
setSetting(key,val){if(key==='sfx')this.audio.volumes.sfx=val;else if(key==='music')this.audio.volumes.music=val},
toggleFullscreen(){if(!document.fullscreenElement)document.documentElement.requestFullscreen();else document.exitFullscreen()},
loadHighScores(){try{return JSON.parse(localStorage.getItem('breakout_multiverse_hs')||'[]')}catch{return[]}},
saveHighScore(score){this.highScores.push({score,date:new Date().toLocaleDateString()});this.highScores.sort((a,b)=>b.score-a.score);this.highScores=this.highScores.slice(0,10);try{localStorage.setItem('breakout_multiverse_hs',JSON.stringify(this.highScores))}catch{}},
showHighScores(){const list=document.getElementById('hsList');list.innerHTML='';if(this.highScores.length===0){list.innerHTML='<p style="color:#666">No scores yet</p>'}else{this.highScores.forEach((h,i)=>{const d=document.createElement('div');d.style.cssText='display:flex;justify-content:space-between;padding:6px 0;border-bottom:1px solid var(--border)';d.innerHTML=`<span style="color:${i<3?'#ffd700':'#aaa'}">#${i+1}</span><span class="hud-score">${h.score}</span><span style="color:#666;font-size:12px">${h.date}</span>`;list.appendChild(d)})}},
updateHighScoresDisplay(){if(document.getElementById('hsList'))this.showHighScores()},
startGame(){this.audio.init();this.score=0;this.lives=C.LIVES;this.level=1;this.combo=0;this.maxCombo=0;this.timer=0;this.timerRunning=true;this.powerupTimers={};this.paddleBallAttached=false;this.balls=[];this.powerups=[];this.particles=[];this.floatingTexts=[];this.stickyBalls=[];this.state='countdown';this.showScreen('playing');this.loadLevel(1);this.countdownVal=3;this.countdownTimer=0;this.updateHUD()},
loadLevel(n){this.level=n;this.bricks=[];this.levelBricksDestroyed=0;const layouts=this.getLevelLayout(n);this.levelTotalBricks=layouts.length*layouts[0].filter(Boolean).length;layouts.forEach((row,ry)=>{row.forEach((cell,rx)=>{if(cell){this.bricks.push({x:rx*(C.BRICK_W+C.BRICK_GAP)+C.BRICK_GAP,y:ry*(C.BRICK_H+C.BRICK_GAP)+C.BRICK_GAP+10,w:C.BRICK_W,h:C.BRICK_H,hp:cell,type:cell,color:this.getBrickColor(cell,n),glow:this.getBrickGlow(cell,n),alive:true,hidden:cell>30,frozen:false})}})});this.createPaddle();this.spawnBall();this.updateHUD()},
getLevelLayout(lv){const layouts=[];const rows=Math.min(4+Math.floor(lv/3),8);const cols=Math.floor(C.WIDTH/C.BRICK_W)-1;for(let r=0;r<rows;r++){const row=[];for(let c=0;c<cols;c++){let hp=0;if(lv<=2){hp=r<3?2:r<5?1:0}else if(lv<=4){hp=r<2?3:r<4?2:r<6?1:0}else if(lv<=6){hp=r<2?4:r<4?3:r<6?2:r<8?1:0}else{hp=r<2?5:r<4?4:r<6?3:r<8?2:r<10?1:0}if(Math.random()<0.05*lv&&hp>0)hp+=2;row.push(hp>0?Math.min(hp,10):0)}layouts.push(row)}},return layouts},
getBrickColor(hp,lv){if(hp>=5)return'#ff0066';if(hp>=4)return'#ff3366';if(hp>=3)return'#ff6633';if(hp>=2)return'#ffaa00';return'#44ddff'},
getBrickGlow(hp,lv){if(hp>=5)return'#ff0066';if(hp>=4)return'#ff3366';if(hp>=3)return'#ff6633';if(hp>=2)return'#ffaa00';return'#44ddff'},
createPaddle(){this.paddle={x:C.WIDTH/2-C.PADDLE_W/2,y:C.HEIGHT-40,w:C.PADDLE_W,h:C.PADDLE_H,targetX:C.WIDTH/2-C.PADDLE_W/2,speed:C.PADDLE_SPEED}},
spawnBall(){const b=BT[this.selectedBall];const ball={x:C.WIDTH/2,y:C.HEIGHT-60,vx:(Math.random()>.5?1:-1)*C.BALL_SPEED*b.speedMul,vy:-C.BALL_SPEED*b.speedMul,r:C.BALL_R,type:this.selectedBall,color:b.color,glow:b.glow,active:true,throughBricks:b.type==='IGNIS'||b.type==='UMBRA',attracted:false,frozen:false,explosive:b.type==='EXPLOSIO',chainCount:0,stuck:false};this.balls.push(ball);this.paddleBallAttached=false},
spawnMultiBall(){const b=BT[this.selectedBall];for(let i=0;i<3;i++){const ball={x:C.WIDTH/2,y:C.HEIGHT-60,vx:(Math.random()>.5?1:-1)*C.BALL_SPEED*b.speedMul*(.8+Math.random()*.4),vy:-C.BALL_SPEED*b.speedMul*(.8+Math.random()*.4),r:C.BALL_R,type:this.selectedBall,color:b.color,glow:b.glow,active:true,throughBricks:b.type==='IGNIS'||b.type==='UMBRA',attracted:false,frozen:false,explosive:b.type==='EXPLOSIO',chainCount:0,stuck:false};this.balls.push(ball)}},
pause(){if(this.state!=='playing')return;this.state='paused';this.showScreen('pauseScreen')},
resume(){this.state='playing';this.showScreen('playing');this.lastTime=performance.now()},
restart(){this.startGame()},
quitToMenu(){this.state='menu';this.balls=[];this.powerups=[];this.particles=[];this.floatingTexts=[];this.showScreen('menu')},
nextLevel(){this.level++;this.loadLevel(this.level);this.state='playing';this.showScreen('playing')},
updateHUD(){document.getElementById('scoreVal').textContent=this.score;document.getElementById('levelVal').textContent=this.level;const m=Math.floor(this.timer/60);const s=Math.floor(this.timer%60);document.getElementById('timerVal').textContent=`${String(m).padStart(2,'0')}:${String(s).padStart(2,'0')}`;const lv=document.getElementById('livesVal');lv.innerHTML='';for(let i=0;i<C.LIVES;i++){const h=document.createElement('span');h.className='heart'+(i>=this.lives?' lost':'');h.textContent='♥';lv.appendChild(h)};this.updatePowerupBar()},
updatePowerupBar(){const bar=document.getElementById('powerupBar');bar.innerHTML='';Object.entries(this.powerupTimers).forEach(([k,v])=>{if(v>0){const badge=document.createElement('span');badge.className='pu-badge';badge.style.background=PU_COLORS[k]+'33';badge.style.border=`1px solid ${PU_COLORS[k]}`;badge.style.color=PU_COLORS[k];badge.innerHTML=`${PU_NAMES[k]} <span class="pu-timer">${Math.ceil(v)}s</span>`;bar.appendChild(badge)}})},
update(dt){if(this.state!=='playing')return;const sdt=dt*this.slowMo;this.timer+=sdt;this.updatePowerupTimers(sdt);this.updatePaddle(sdt);this.updateBalls(sdt);this.updatePowerups(sdt);this.updateParticles(sdt);this.updateFloatingTexts(sdt);this.updateComboDisplay();this.checkLevelComplete();if(this.shakeTimer>0)this.shakeTimer-=dt;if(this.paddle&&this.paddle.w<C.PADDLE_MIN_W)this.paddle.w=C.PADDLE_MIN_W},
updatePowerupTimers(dt){Object.keys(this.powerupTimers).forEach(k=>{this.powerupTimers[k]-=dt;if(this.powerupTimers[k]<=0){delete this.powerupTimers[k];this.onPowerupEnd(k)}});this.updatePowerupBar()},
onPowerupEnd(type){if(type==='expand'){if(this.paddle)this.paddle.w=Math.max(C.PADDLE_MIN_W,this.paddle.w-40)}else if(type==='shrink'){if(this.paddle)this.paddle.w=Math.min(C.PADDLE_MAX_W,this.paddle.w+40)}else if(type==='sticky'){this.paddleBallAttached=false}},
updatePaddle(dt){if(!this.paddle)return;const p=this.paddle;p.x+=(p.targetX-p.x)*0.2;p.x=Math.max(0,Math.min(C.WIDTH-p.w,p.x));p.w=Math.max(C.PADDLE_MIN_W,Math.min(C.PADDLE_MAX_W,p.w))},
updateBalls(dt){for(let i=this.balls.length-1;i>=0;i--){const b=this.balls[i];if(!b.active){this.balls.splice(i,1);continue}if(b.stuck){b.x=this.paddle.x+this.paddle.w/2;b.y=this.paddle.y-b.r-2;continue}if(this.paddleBallAttached&&this.balls.length===1){b.x=this.paddle.x+this.paddle.w/2;b.y=this.paddle.y-b.r-2;continue}b.x+=b.vx*dt*60;b.y+=b.vy*dt*60;if(b.x-b.r<0){b.x=b.r;b.vx=Math.abs(b.vx);this.audio.play('paddle')}if(b.x+b.r>C.WIDTH){b.x=C.WIDTH-b.r;b.vx=-Math.abs(b.vx);this.audio.play('paddle')}if(b.y-b.r<0){b.y=b.r;b.vy=Math.abs(b.vy);this.audio.play('paddle')}if(b.y>C.HEIGHT+20){this.handleBallLost(i);continue}if(this.paddle&&this.checkBallPaddle(b)){this.handlePaddleHit(b);continue}for(let j=0;j<this.bricks.length;j++){const br=this.bricks[j];if(!br.alive)continue;if(br.hidden&&!this.isBallRevealing(b))continue;if(br.frozen&&!b.throughBricks)continue;if(this.checkBallBrick(b,br)){this.handleBrickHit(b,br,j);if(b.explosive){this.explodeBrick(br);break}if(b.type==='FRACTIO'&&Math.random()<.5){this.splitBall(b);break}if(b.type==='NEXUS'){this.spawnMultiBall();break}if(b.type==='PLASMA'){this.chainLightning(b,br);break}if(b.type==='GRAVITON'){b.attracted=true;break}if(b.type==='VACUO'){this.attractWeakBricks(br);break}if(b.type==='ELASTIS'){b.vx*=-1;b.vy*=-1;b.vx*=1.02;b.vy*=1.02;break}break}}}},
isBallRevealing(b){return b.type==='UMBRA'||b.type==='IGNIS'},
checkBallPaddle(b){const p=this.paddle;return b.y+b.r>=p.y&&b.y-b.r<=p.y+p.h&&b.x>=p.x&&b.x<=p.x+p.w},
handlePaddleHit(b){const p=this.paddle;this.audio.play('paddle');const hitPos=(b.x-p.x)/p.w;const angle=(hitPos-.5)*Math.PI*.7;const speed=Math.sqrt(b.vx*b.vx+b.vy*b.vy);b.vx=Math.sin(angle)*speed;b.vy=-Math.abs(Math.cos(angle)*speed);b.y=p.y-b.r-1;this.combo=0;if(b.type==='GRAVITON')b.attracted=false;if(b.type==='ELASTIS'){b.vx*=1.02;b.vy*=1.02}},
checkBallBrick(b,br){return Math.abs(b.x-br.x-br.w/2)<b.r+br.w/2&&Math.abs(b.y-br.y-br.h/2)<b.r+br.h/2},
handleBrickHit(b,br,idx){if(b.throughBricks&&!b.type==='IGNIS'){br.hp--;if(br.hp<=0){br.alive=false;this.levelBricksDestroyed++;this.addScore(br.type);this.spawnBrickParticles(br);this.spawnFloatingText(br.x+br.w/2,br.y,br.type*10)}else{this.spawnBrickParticles(br,5);this.spawnFloatingText(br.x+br.w/2,br.y,'HIT')}this.audio.play('brick');return}if(br.frozen){br.frozen=false;br.hp=1;this.audio.play('brick');return}if(b.explosive){br.hp-=2}else{br.hp-=1}if(br.hp<=0){br.alive=false;this.levelBricksDestroyed++;this.addScore(br.type);this.spawnBrickParticles(br);this.spawnFloatingText(br.x+br.w/2,br.y,br.type*10);this.audio.play('destroy');this.combo++;if(this.combo>this.maxCombo)this.maxCombo=this.combo;if(this.combo>1){this.showCombo(this.combo);this.audio.play('combo')}if(Math.random()<.12)this.spawnPowerup(br.x+br.w/2,br.y+br.h/2)}else{this.spawnBrickParticles(br,5);this.audio.play('brick')}},
addScore(type){const base=type*10;this.score+=base*Math.max(1,this.combo)},
spawnBrickParticles(br,count=12){for(let i=0;i<count;i++){const angle=Math.random()*Math.PI*2;const speed=1+Math.random()*3;this.particles.push({x:br.x+br.w/2,y:br.y+br.h/2,vx:Math.cos(angle)*speed,vy:Math.sin(angle)*speed,life:1,color:br.color,size:2+Math.random()*3})}},
spawnFloatingText(x,y,text){this.floatingTexts.push({x,y,text,life:1,vy:-1.5})},
spawnPowerup(x,y){const type=PU_TYPES[Math.floor(Math.random()*PU_TYPES.length)];this.powerups.push({x,y,vy:1.5,type,size:12,age:0})},
explodeBrick(br){for(let i=this.bricks.length-1;i>=0;i--){const b=this.bricks[i];if(!b.alive||b===br)continue;const dx=b.x+b.w/2-br.x+br.w/2;const dy=b.y+b.h/2-br.y+br.h/2;const dist=Math.sqrt(dx*dx+dy*dy);if(dist<120){b.hp-=2;if(b.hp<=0){b.alive=false;this.levelBricksDestroyed++;this.addScore(b.type);this.spawnBrickParticles(b);this.spawnFloatingText(b.x+b.w/2,b.y,b.type*10);this.audio.play('destroy')}}}this.shakeTimer=.3;this.shakeIntensity=5},
splitBall(b){if(this.balls.length>=C.MAX_BALLS)return;const newBall={x:b.x,y:b.y,vx:-b.vx,vy:b.vy,r:b.r,type:b.type,color:b.color,glow:b.glow,active:true,throughBricks:b.throughBricks,attracted:false,frozen:false,explosive:b.explosive,chainCount:0,stuck:false};this.balls.push(newBall);this.audio.play('paddle')},
chainLightning(b,hitBrick){for(let i=0;i<this.bricks.length;i++){const br=this.bricks[i];if(!br.alive||br===hitBrick)continue;const dx=br.x+br.w/2-hitBrick.x+hitBrick.w/2;const dy=br.y+br.h/2-hitBrick.y+hitBrick.h/2;if(Math.sqrt(dx*dx+dy*dy)<100){br.hp-=1;