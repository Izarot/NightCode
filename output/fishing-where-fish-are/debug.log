      if (input.mouseDown && game.state === 'IDLE') {
        const chargeTime = Date.now() - input.chargeStart;
        castLine(Math.min(chargeTime / CONFIG.maxChargeTime, 1));
      }
      input.mouseDown = false;
      document.getElementById('powerBar').classList.remove('visible');
    });
    
    canvas.addEventListener('mouseleave', () => {
      if (input.mouseDown && game.state === 'IDLE') {
        const chargeTime = Date.now() - input.chargeStart;
        castLine(Math.min(chargeTime / CONFIG.maxChargeTime, 1));
      }
      input.mouseDown = false;
      document.getElementById('powerBar').classList.remove('visible');
    });
    
    // Touch support
    canvas.addEventListener('touchstart', (e) => {
      e.preventDefault();
      initAudio();
      const touch = e.touches[0];
      input.mouseDown = true;
      input.mouseX = touch.clientX;
      input.mouseY = touch.clientY;
      input.chargeStart = Date.now();
      document.getElementById('powerBar').classList.add('visible');
    });
    
    canvas.addEventListener('touchmove', (e) => {
      e.preventDefault();
      const touch = e.touches[0];
      input.mouseX = touch.clientX;
      input.mouseY = touch.clientY;
    });
    
    canvas.addEventListener('touchend', (e) => {
      e.preventDefault();
      if (input.mouseDown && game.state === 'IDLE') {
        const chargeTime = Date.now() - input.chargeStart;
        castLine(Math.min(chargeTime / CONFIG.maxChargeTime, 1));
      }
      input.mouseDown = false;
      document.getElementById('powerBar').classList.remove('visible');
    });
    
    // Fish click handler
    canvas.addEventListener('click', (e) => {
      if (game.state !== 'REELING') return;
      
      const clickX = e.clientX;
      const clickY = e.clientY;
      
      for (let i = fishes.length - 1; i >= 0; i--) {
        const fish = fishes[i];
        const dx = clickX - fish.x;
        const dy = clickY - fish.y;
        const dist = Math.sqrt(dx * dx + dy * dy);
        
        if (dist < fish.width * 0.6) {
          catchFish(fish, i);
          break;
        }
      }
    });
    
    // Cast line
    function castLine(power) {
      if (game.state !== 'IDLE') return;
      
      game.state = 'CHARGING';
      line.segments = [];
      line.inWater = false;
      line.attachedFish = null;
      line.hook = {
        x: boat.x + Math.cos(boat.rodAngle) * boat.rodLength,
        y: boat.y + Math.sin(boat.rodAngle) * boat.rodLength,
        vx: 0,
        vy: 0
      };
      
      playSound('cast');
      generateEquation();
      
      // Launch hook
      const angle = Math.atan2(input.mouseY - line.hook.y, input.mouseX - line.hook.x);
      const launchSpeed = 8 + power * 15;
      line.hook.vx = Math.cos(angle) * launchSpeed;
      line.hook.vy = Math.sin(angle) * launchSpeed;
      
      setTimeout(() => {
        if (game.state === 'CHARGING') {
          game.state = 'REELING';
          document.getElementById('instruction').textContent = 'Tap fish to catch them!';
        }
      }, 500);
    }
    
    // Catch fish
    function catchFish(fish, index) {
      playSound('catch');
      createParticles(fish.x, fish.y, fish.color, 20);
      
      if (fish.type === 'number') {
        // Fill equation slot
        if (game.equationSlots[0] === null) {
          game.equationSlots[0] = fish.value;
        } else if (game.equationSlots[1] === null) {
          game.equationSlots[1] = fish.value;
        }
        updateEquationDisplay();
        
        // Check if equation is complete
        if (game.equationSlots[0] !== null && game.equationSlots[1] !== null) {
          const a = game.equationSlots[0];
          const b = game.equationSlots[1];
          const result = game.equationSlots[2];
          const eq = game.currentEquation;
          
          let isCorrect = false;
          if (eq.operator === '+') isCorrect = a + b === result;
          else if (eq.operator === '-') isCorrect = a - b === result;
          else if (eq.operator === '*') isCorrect = a * b === result;
          else if (eq.operator === '/') isCorrect = a / b === result;
          
          if (isCorrect) {
            onEquationComplete();
          } else {
            onEquationWrong();
          }
        }
        
        game.fishCaught++;
        document.getElementById('fishCount').textContent = game.fishCaught;
        
      } else if (fish.type === 'operator') {
        // Show floating operator
        createFloatingText(fish.x, fish.y, fish.symbol, fish.color);
      }
      
      fishes.splice(index, 1);
      
      // Speed up hook after catch
      line.hook.vx *= 1.5;
      line.hook.vy *= 1.5;
    }
    
    function onEquationComplete() {
      playSound('complete');
      game.consecutiveSolves++;
      game.lastSolveTime = Date.now();
      
      // Score calculation
      const timeBonus = Math.max(0, 1000 - (Date.now() - game.solveStartTime));
      const comboMult = game.combo;
      const levelMult = 1 + (game.level - 1) * 0.1;
      const points = Math.floor((100 + timeBonus) * comboMult * levelMult);
      
      game.score += points;
      game.consecutiveSolves++;
      
      // Update combo
      if (Date.now() - game.lastComboTime < CONFIG.comboTimeout) {
        game.combo = Math.min(game.combo + 0.5, 5);
      } else {
        game.combo = 1;
      }
      game.lastComboTime = Date.now();
      
      // Level up
      if (game.consecutiveSolves % 3 === 0) {
        game.level++;
        document.getElementById('level').textContent = game.level;
      }
      
      // Create celebration particles
      createParticles(canvas.width / 2, canvas.height * 0.3, '#ffd43b', 30);
      
      createFloatingText(canvas.width / 2, canvas.height * 0.25, '+' + points, '#ffd43b');
      
      updateHUD();
      
      // Reset for next equation
      generateEquation();
      
      // Check high score
      if (game.score > highScore) {
        highScore = game.score;
        localStorage.setItem('fishEquationsHighScore', highScore.toString());
        document.getElementById('highScore').textContent = 'Best: ' + highScore;
      }
    }
    
    function onEquationWrong() {
      playSound('miss');
      game.combo = 1;
      game.consecutiveSolves = 0;
      
      createFloatingText(canvas.width / 2, canvas.height * 0.35, 'WRONG!', '#f85149');
      
      // Reset slots
      game.equationSlots[0] = null;
      game.equationSlots[1] = null;
      updateEquationDisplay();
    }
    
    function createFloatingText(x, y, text, color) {
      const el = document.createElement('div');
      el.className = 'floating-text';
      el.textContent = text;
      el.style.left = x + 'px';
      el.style.top = y + 'px';
      el.style.color = color;
      document.getElementById('hud').appendChild(el);
      
      setTimeout(() => el.remove(), 1500);
    }
    
    function updateHUD() {
      document.getElementById('score').textContent = game.score;
      
      const comboEl = document.getElementById('combo');
      comboEl.textContent = 'x' + game.combo.toFixed(1);
      comboEl.className = 'combo-value' + (game.combo > 1 ? ' active' : '');
    }
    
    // Main update loop
    let lastTime = 0;
    let fishSpawnTimer = 0;
    let bubbleTimer = 0;
    
    function update(timestamp) {
      const dt = Math.min((timestamp - lastTime) / 16.67, 3);
      lastTime = timestamp;
      
      // Update power bar
      if (input.mouseDown) {
        const chargeTime = Date.now() - input.chargeStart;
        input.chargePower = Math.min(chargeTime / CONFIG.maxChargeTime, 1);
        document.getElementById('powerFill').style.width = (input.chargePower * 100) + '%';
      }
      
      // Update boat bobbing
      boat.bobOffset = Math.sin(timestamp * 0.003) * 5;
      
      // Update hook physics
      if (game.state === 'CHARGING' || game.state === 'REELING') {
        // Gravity
        line.hook.vy += CONFIG.gravity * dt;
        
        // Water current
        if (line.inWater) {
          line.hook.vx += CONFIG.waterCurrent * dt;
          line.hook.vy *= 0.98;
        }
        
        // Update position
        line.hook.x += line.hook.vx * dt;
        line.hook.y += line.hook.vy * dt;
        
        // Water surface check
        const waterLevel = canvas.height * 0.15;
        if (line.hook.y > waterLevel && !line.inWater) {
          line.inWater = true;
          playSound('splash');
          createSplash(line.hook.x, waterLevel);
        }
        
        // Boundary checks
        if (line.hook.x < 0) line.hook.x = 0;
        if (line.hook.x > canvas.width) line.hook.x = canvas.width;
        
        // Reel in if above water or too long
        const hookDist = Math.sqrt(
          Math.pow(line.hook.x - boat.x, 2) + 
          Math.pow(line.hook.y - boat.y, 2)
        );
        
        const maxDist = 600;
        if (line.hook.y < waterLevel - 20 || hookDist > maxDist) {
          reelIn(dt);
        }
        
        // Reset if hook returns to boat
        if (hookDist < 50 && line.hook.y < waterLevel) {
          game.state = 'IDLE';
          line.inWater = false;
          document.getElementById('instruction').textContent = 'Click and hold to cast your line';
        }
      }
      
      // Update fishes
      for (let i = fishes.length - 1; i >= 0; i--) {
        const fish = fishes[i];
        
        // Check if startled by hook
        const distToHook = Math.sqrt(
          Math.pow(fish.x - line.hook.x, 2) + 
          Math.pow(fish.y - line.hook.y, 2)
        );
        
        if (distToHook < 100 && line.inWater && !fish.startled) {
          fish.startled = true;
          fish.startledTime = timestamp;
          fish.vx *= 2.5;
        }
        
        // Recover from startled
        if (fish.startled && timestamp - fish.startledTime > 500) {
          fish.startled = false;
        }
        
        // Wobble movement
        fish.wobble += fish.wobbleSpeed * 0.05 * dt;
        fish.vy = Math.sin(fish.wobble) * 0.5;
        
        // Update position
        fish.x += fish.vx * dt;
        fish.y += fish.vy * dt;
        
        // Remove if off screen
        if (fish.x < -fish.width * 2 || fish.x > canvas.width + fish.width * 2) {
          fishes.splice(i, 1);
        }
      }
      
      // Spawn fishes
      fishSpawnTimer += dt * 16.67;
      if (fishSpawnTimer > CONFIG.fishSpawnRate / (1 + game.level * 0.1)) {
        spawnFish();
        fishSpawnTimer = 0;
      }
      
      // Spawn bubbles
      bubbleTimer += dt * 16.67;
      if (bubbleTimer > 200) {
        if (Math.random() < 0.3) createBubble();
        bubbleTimer = 0;
      }
      
      // Update bubbles
      for (let i = bubbles.length - 1; i >= 0; i--) {
        const b = bubbles[i];
        b.wobble += b.wobbleSpeed;
        b.x += Math.sin(b.wobble) * 0.5;
        b.y -= b.speed * dt;
        
        if (b.y < canvas.height * 0.15) {
          bubbles.splice(i, 1);
        }
      }
      
      // Update particles
      for (let i = particles.length - 1; i >= 0; i--) {
        const p = particles[i];
        p.x += p.vx * dt;
        p.y += p.vy * dt;
        p.vy += (p.gravity || 0.2) * dt;
        p.life -= p.decay * dt;
        
        if (p.life <= 0) {
          particles.splice(i, 1);
        }
      }
      
      // Update timer display
      const elapsed = Math.floor((Date.now() - game.speedrunStartTime) / 1000);
      const mins = Math.floor(elapsed / 60);
      const secs = elapsed % 60;
      document.getElementById('speedrunTimer').textContent = mins + ':' + secs.toString().padStart(2, '0') + '.00';
      
      // Update game timer
      const gameElapsed = Math.floor((Date.now() - game.speedrunStartTime) / 1000);
      const gameMins = Math.floor(gameElapsed / 60);
      const gameSecs = gameElapsed % 60;
      document.getElementById('timer').textContent = gameMins + ':' + gameSecs.toString().padStart(2, '0');
    }
    
    function reelIn(dt) {
      const targetX = boat.x + Math.cos(boat.rodAngle) * boat.rodLength;
      const targetY = boat.y + Math.sin(boat.rodAngle) * boat.rodLength;
      
      const dx = targetX - line.hook.x;
      const dy = targetY - line.hook.y;
      const dist = Math.sqrt(dx * dx + dy * dy);
      
      const reelSpeed = input.chargePower > 0.5 ? CONFIG.reelSpeedCharged : CONFIG.reelSpeed;
      const speed = reelSpeed * dt;
      
      if (dist > speed) {
        line.hook.x += (dx / dist) * speed;
        line.hook.y += (dy / dist) * speed;
      } else {
        line.hook.x = targetX;
        line.hook.y = targetY;
      }
    }
    
    // Render
    function render() {
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      
      // Sky gradient
      const skyGrad = ctx.createLinearGradient(0, 0, 0, canvas.height * 0.2);
      skyGrad.addColorStop(0, '#1a1a2e');
      skyGrad.addColorStop(1, '#16213e');
      ctx.fillStyle = skyGrad;
      ctx.fillRect(0, 0, canvas.width, canvas.height * 0.2);
      
      // Water gradient
      const waterGrad = ctx.createLinearGradient(0, canvas.height * 0.15, 0, canvas.height);
      waterGrad.addColorStop(0, '#0c4a6e');
      waterGrad.addColorStop(0.3, '#075985');
      waterGrad.addColorStop(0.7, '#0c4a6e');
      waterGrad.addColorStop(1, '#082f49');
      ctx.fillStyle = waterGrad;
      ctx.fillRect(0, canvas.height * 0.15, canvas.width, canvas.height * 0.85);
      
      // Water surface shine
      ctx.fillStyle = 'rgba(125, 211, 252, 0.1)';
      ctx.fillRect(0, canvas.height * 0.15, canvas.width, 20);
      
      // Bubbles
      bubbles.forEach(b => {
        ctx.beginPath();
        ctx.arc(b.x, b.y, b.size, 0, Math.PI * 2);
        ctx.fillStyle = 'rgba(125, 211, 252, 0.4)';
        ctx.fill();
        ctx.strokeStyle = 'rgba(165, 216, 255, 0.6)';
        ctx.lineWidth = 1;
        ctx.stroke();
      });
      
      // Draw fishes
      fishes.forEach(fish => {
        ctx.save();
        ctx.translate(fish.x, fish.y);
        ctx.scale(fish.vx > 0 ? 1 : -1, 1);
        
        // Fish body
        ctx.beginPath();
        ctx.ellipse(0, 0, fish.width / 2, fish.height / 2, 0, 0, Math.PI * 2);
        
        const fishGrad = ctx.createRadialGradient(0, 0, 0, 0, 0, fish.width / 2);
        fishGrad.addColorStop(0, fish.color);
        fishGrad.addColorStop(1, shadeColor(fish.color, -30));
        ctx.fillStyle = fishGrad;
        ctx.fill();
        
        // Fish tail
        ctx.beginPath();
        ctx.moveTo(fish.width / 2, 0);
        ctx.lineTo(fish.width / 2 + fish.width * 0.4, -fish.height * 0.4);
        ctx.lineTo(fish.width / 2 + fish.width * 0.4, fish.height * 0.4);
        ctx.closePath();
        ctx.fillStyle = shadeColor(fish.color, -20);
        ctx.fill();
        
        // Fish eye
        ctx.beginPath();
        ctx.arc(-fish.width / 4, -fish.height / 6, fish.width * 0.08, 0, Math.PI * 2);
        ctx.fillStyle = '#fff';
        ctx.fill();
        ctx.beginPath();
        ctx.arc(-fish.width / 4, -fish.height / 6, fish.width * 0.04, 0, Math.PI * 2);
        ctx.fillStyle = '#000';
        ctx.fill();
        
        // Draw value or symbol
        ctx.fillStyle = '#fff';
        ctx.font = `bold ${Math.max(12, fish.width * 0.3)}px Orbitron, monospace`;
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        
        if (fish.type === 'number') {
          ctx.fillText(fish.value, 0, 2);
        } else {
          ctx.fillText(fish.symbol, 0, 2);
        }
        
        ctx.restore();
      });
      
      // Draw particles
      particles.forEach(p => {
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.size * p.life, 0, Math.PI * 2);
        ctx.fillStyle = p.color;
        ctx.globalAlpha = p.life;
        ctx.fill();
        ctx.globalAlpha = 1;
      });
      
      // Draw fishing line
      if (game.state === 'CHARGING' || game.state === 'REELING') {
        const startX = boat.x + Math.cos(boat.rodAngle) * boat.rodLength;
        const startY = boat.y + Math.sin(boat.rodAngle) * boat.rodLength;
        
        // Create smooth curve through segments
        ctx.beginPath();
        ctx.moveTo(startX, startY);
        
        const segments = 20;
        for (let i = 0; i <= segments; i++) {
          const t = i / segments;
          const x = lerp(startX, line.hook.x, t);
          const y = lerp(startY, line.hook.y, t);
          
          // Add wave effect in water
          if (t > 0.3 && line.inWater) {
            const wave = Math.sin(t * 10 + Date.now() * 0.01) * 3 * t;
            ctx.lineTo(x + wave, y);
          } else {
            ctx.lineTo(x, y);
          }
        }
        
        ctx.strokeStyle = '#8b949e';
        ctx.lineWidth = 2;
        ctx.stroke();
        
        // Draw hook
        ctx.beginPath();
        ctx.arc(line.hook.x, line.hook.y, CONFIG.hookSize, 0, Math.PI * 2);
        ctx.fillStyle = '#ffd43b';
        ctx.fill();
        ctx.strokeStyle = '#d29922';
        ctx.lineWidth = 3;
        ctx.stroke();
        
        // Hook shine
        ctx.beginPath();
        ctx.arc(line.hook.x - 5, line.hook.y - 5, 5, 0, Math.PI * 2);
        ctx.fillStyle = 'rgba(255, 255, 255, 0.5)';
        ctx.fill();
      }
      
      // Draw boat
      const boatX = boat.x;
      const boatY = boat.y + boat.bobOffset;
      
      // Boat body
      ctx.beginPath();
      ctx.ellipse(boatX, boatY, 40, 15, 0, 0, Math.PI);
      ctx.fillStyle = '#8b4513';
      ctx.fill();
      ctx.strokeStyle = '#5d2f0d';
      ctx.lineWidth = 2;
      ctx.stroke();
      
      // Boat cabin
      ctx.fillStyle = '#a0522d';
      ctx.fillRect(boatX - 20, boatY - 25, 40, 15);
      ctx.strokeStyle = '#5d2f0d';
      ctx.strokeRect(boatX - 20, boatY - 25, 40, 15);
      
      // Fishing rod
      ctx.beginPath();
      ctx.moveTo(boatX, boatY - 15);
      ctx.lineTo(
        boatX + Math.cos(boat.rodAngle) * boat.rodLength,
        boatY + Math.sin(boat.rodAngle) * boat.rodLength
      );
      ctx.strokeStyle = '#5d2f0d';
      ctx.lineWidth = 4;
      ctx.stroke();
      
      // Reel
      ctx.beginPath();
      ctx.arc(
        boatX + Math.cos(boat.rodAngle) * boat.rodLength * 0.3,
        boatY + Math.sin(boat.rodAngle) * boat.rodLength * 0.3,
        8, 0, Math.PI * 2
      );
      ctx.fillStyle = '#30363d';
      ctx.fill();
    }
    
    function lerp(a, b, t) {
      return a + (b - a) * t;
    }
    
    function shadeColor(color, percent) {
      const num = parseInt(color.replace('#', ''), 16);
      const amt = Math.round(2.55 * percent);
      const R = (num >> 16) + amt;
      const G = (num >> 8 & 0x00FF) + amt;
      const B = (num & 0x0000FF) + amt;
      return '#' + (0x1000000 + 
        (R < 255 ? R < 1 ? 0 : R : 255) * 0x10000 + 
        (G < 255 ? G < 1 ? 0 : G : 255) * 0x100 + 
        (B < 255 ? B < 1 ? 0 : B : 255)
      ).toString(16).slice(1);
    }
    
    // Game loop
    function gameLoop(timestamp) {
      update(timestamp);
      render();
      requestAnimationFrame(gameLoop);
    }
    
    // Initialize
    document.getElementById('highScore').textContent = 'Best: ' + highScore;
    generateEquation();
    
    // Start spawning
    for (let i = 0; i < 5; i++) {
      spawnFish();
    }
    
    requestAnimationFrame(gameLoop);
  </script>
</body>
</html>", "README.md": "# 🐟 Fish Equations\n\nA math-based fishing game where you catch fish with numbers to solve equations!\n\n## How to Play\n\n1. **Click and hold** to charge your cast power\n2. **Release** to cast your fishing line into the water\n3. **Click on fish** to catch them - numbers fill equation slots, operators float nearby\n4. **Solve equations** by catching the correct numbers\n5. **Build combos** for bonus points and level up!\n\n## Fish Types\n\n- **Minnows** (cyan): Small numbers 1-9\n- **Bass** (light blue): Medium numbers 10-99\n- **Tuna** (blue): Large numbers 100-999\n- **Sharks** (dark blue): Very large numbers 1000-9999\n\n## Operators\n\nOperators appear as special fish at different depths:\n- **+** (green): Shallow water\n- **-** (red): Shallow water\n- **×** (yellow): Mid depths\n- **÷** (purple): Deep water\n- **=** (blue): Shallow water\n\n## Controls\n\n- **Mouse/Touch**: Hold to charge, release to cast\n- **Click/Tap**: Catch fish while reeling in\n\n## Features\n\n- Procedurally generated equations\n- Progressive difficulty (new operators at levels 6, 11, 21)\n- Combo system with time bonuses\n- Speedrun timer\n- High score persistence (localStorage)\n- Responsive design (mobile-friendly)\n- Sound effects\n- Particle effects\n\n## Development\n\nOpen `index.html` in a browser to play.\n\n## License\n\nMIT", "SPEC.md": "# Fish Equations - Technical Specification\n\n## Overview\n\nFish Equations is a casual math game where players fish for numbers to solve arithmetic equations. The game combines fishing mechanics with mental math challenges.\n\n## Architecture\n\n### Single File Structure\n- `index.html`: Complete game in one file (HTML + CSS + JS)\n- No external dependencies except Google Fonts\n\n### Game States\n1. `IDLE` - Waiting for player input\n2. `CHARGING` - Player holding mouse/touch to charge cast\n3. `REELING` - Line in water, catching fish\n\n## Game Mechanics\n\n### Fishing System\n- Charge-based casting with visual power bar\n- Physics-based hook movement (gravity, water current)\n- Line curves with wave effect in water\n- Automatic reeling when hook reaches max distance or surfaces\n\n### Fish System\n- 4 fish types with different value ranges and speeds\n- 5 operator types at different depths\n- Fish flee when hook approaches (startled mechanic)\n- Weighted spawning based on fish rarity\n\n### Equation System\n- Procedurally generated based on level\n- Operators unlock progressively:\n  - Level 1: Addition only\n  - Level 6: Addition, Subtraction\n  - Level 11: Addition, Subtraction, Multiplication\n  - Level 21: All operators including Division\n- Max values scale with level\n\n### Scoring\n- Base points: 100\n- Time bonus: up to 1000 points\n- Combo multiplier: 1.0x to 5.0x\n- Level multiplier: 1.0x + 0.1x per level\n\n### Progression\n- Level up every 3 consecutive correct equations\n- Fish speed increases with level\n- Spawn rate increases with level\n\n## Rendering\n\n### Canvas Elements\n- Sky gradient (top portion)\n- Water gradient with depth zones\n- Bubbles (ambient particles)\n- Fish with body, tail, eye, and value/symbol\n- Fishing line with wave effect\n- Hook with shine\n- Boat with bobbing animation\n- Particle effects for catches and splashes\n\n### UI Elements (HTML Overlay)\n- Score panel with high score\n- Equation display with 3 slots\n- Level indicator\n- Combo multiplier\n- Fish caught counter\n- Game timer\n- Speedrun timer\n- Power bar (visible during charge)\n- Floating score text\n- Instructions\n\n## Audio\n\nUses Web Audio API for procedural sound effects:\n- Cast: Low frequency sweep\n- Splash: Noise burst\n- Catch: Rising arpeggio\n- Complete: 4-note celebration\n- Miss: Descending tone\n\n## Responsive Design\n\n- Fluid canvas sizing\n- Responsive HUD with flexbox\n- Media queries for mobile (< 600px, < 400px)\n- Touch event support\n\n## Storage\n\n- `localStorage` for high score persistence\n- Key: `fishEquationsHighScore`\n\n## Performance\n\n- RequestAnimationFrame game loop\n- Delta time normalization\n- Object pooling for particles/bubbles\n- Off-screen culling for fish\n\n## Browser Support\n\nModern browsers with:\n- Canvas 2D API\n- Web Audio API\n- localStorage\n- Touch Events (mobile)\n\n## Future Enhancements\n\nPotential features for future versions:\n- Power-ups/collectibles\n- Multiple game modes\n- Achievements\n- Leaderboards\n- Multiple fishing spots\n- Weather effects\n- Day/night cycle\n"}
}