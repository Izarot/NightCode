{"index.html":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Fire Breather</title>\n<link rel=\"icon\" href=\"data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🔥</text></svg>\">\n<style>\nbody{margin:0;overflow:hidden;background:#0d022b;font-family:'Courier New',monospace}\ncanvas{display:block;margin:auto;background:#0d022b}\n</style>\n</head>\n<body>\n<canvas id=\"game\"></canvas>\n<script src=\"game.js\"></script>\n</body>\n</html>","game.js":"// Fire Breather - simplified responsive canvas game\nconst canvas=document.getElementById('game');\nconst ctx=canvas.getContext('2d');\nlet w=canvas.width=window.innerWidth;\nlet h=canvas.height=window.innerHeight;\nwindow.addEventListener('resize',()=>{w=canvas.width=window.innerWidth;h=canvas.height=window.innerHeight;});\n\n// Palette\nconst C={bg:'#0d022b',ground:'#2a1a0a',lava:'#ff5e00',player:'#ffdd00',flame:'#ff6b00',imp:'#c73e7e',phoenix:'#ff9d00',golem:'#6bc17d',rider:'#4e9af1',fuel:'#00e5ff',text:'#ffffff'};\n\n// Player\nconst player={x:100,y:0,vx:0,vy:0,w:32,h:32,onGround:false,fuel:80,maxFuel:100,health:100,maxHealth:100,dir:1,score:0,inv:0};\n\n// Input\nconst keys={};const mouse={x:0,y:0,down:false};\nwindow.addEventListener('keydown',e=>keys[e.code]=true);\nwindow.addEventListener('keyup',e=>keys[e.code]=false);\nwindow.addEventListener('mousemove',e=>{mouse.x=e.clientX;mouse.y=e.clientY;});\nwindow.addEventListener('mousedown',()=>mouse.down=true);\nwindow.addEventListener('mouseup',()=>mouse.down=false);\nwindow.addEventListener('touchstart',e=>{e.preventDefault();mouse.down=true;mouse.x=e.touches[0].clientX;mouse.y=e.touches[0].clientY;},{passive:false});\nwindow.addEventListener('touchend',e=>{e.preventDefault();mouse.down=false;},{passive:false});\n\n// Audio\nconst audioCtx=new (window.AudioContext||window.webkitAudioContext)();\nfunction playSound(freq,dur,type='sine',vol=0.2){const o=audioCtx.createOscillator();const g=audioCtx.createGain();o.type=type;o.frequency.value=freq;o.connect(g);g.connect(audioCtx.destination);g.gain.value=vol;o.start();o.stop(audioCtx.currentTime+dur);}
\n// Platforms\nconst platforms=[];\nconst PLATFORM_COUNT=12;\nfor(let i=0;i<PLATFORM_COUNT;i++){platforms.push({x:i*120+80,y:h-120-i*10,w:100+Math.random()*40,h:12});}\n// Ground\nplatforms.push({x:0,y:h-40,w:w,h:40});\n\n// Enemies\nconst enemies=[];\nfunction spawnEnemy(){if(enemies.length<8){enemies.push({x:w+50,y:h-160,w:30,h:30,type:'imp',hp:30,vx:-1.5});}}\nsetInterval(spawnEnemy,2000);\n\n// Fuel pickups\nconst fuels=[];\nsetInterval(()=>{fuels.push({x:w+Math.random()*100,y:h-200,r:8});},3000);\n\n// Game state\nlet cameraX=0;\nlet breathCd=0;\nlet dashCd=0;\nlet lastTime=0;\nlet highScore=parseInt(localStorage.getItem('fireBreatherHighScore'))||0;\nlet startTime=performance.now();\n\n// Update\nfunction update(dt){dt=dt||1/60;\n// Movement\nif(keys['ArrowLeft']||keys['KeyA']){player.vx=-5;player.dir=-1;}\nelse if(keys['ArrowRight']||keys['KeyD']){player.vx=5;player.dir=1;}\nelse {player.vx*=0.92;}\nif((keys['ArrowUp']||keys['Space'])&&player.onGround){player.vy=-7;player.onGround=false;playSound(200,0.2,'square');}\n// Dash\nif((keys['ArrowLeft']||keys['ArrowRight'])&&dashCd<=0&&Math.abs(player.vx)>0){player.vx*=3;dashCd=2;playSound(80,0.3,'sawtooth');}\nif(dashCd>0)dashCd-=dt;\n// Gravity\nplayer.vy+=0.6;\nplayer.vx*=0.92;\n// Update pos\nplayer.x+=player.vx;\nplayer.y+=player.vy;\n// Collisions\nplayer.onGround=false;\nfor(const p of platforms){\nconst col=rectCollide(player,p);\nif(col){if(player.vy>0){player.y=p.y-player.h;player.vy=0;player.onGround=true;}else if(player.vy<0){player.y=p.y+p.h;player.vy=0;}}\n}\n// Keep in bounds\nif(player.x<0)player.x=0;\nif(player.y>h-40-player.h)player.y=h-40-player.h;\n// Camera follow\nconst targetCam=player.x-100;\nif(targetCam>cameraX)cameraX=targetCam;\nif(cameraX<0)cameraX=0;\n// Breath\nif(breathCd>0)breathCd-=dt;\nif(mouse.down&&breathCd<=0&&player.fuel>0){player.fuel-=5*dt;if(player.fuel<0)player.fuel=0;}\nif(!mouse.down&&breathCd<=0&&player.fuel>0){breathCd=0.5;}\n// Fuel regen on ground\nif(player.onGround&&player.fuel<player.maxFuel)player.fuel+=2*dt;\nif(player.fuel>player.maxFuel)player.fuel=player.maxFuel;\n// Health regen\nif(player.health<player.maxHealth)player.health+=1*dt;\nif(player.health>player.maxHealth)player.health=player.maxHealth;\n// Enemies\nfor(const e of enemies){e.x-=1.5;if(rectCollide(e,player)){if(player.inv<=0){player.health-=10;player.inv=1;playSound(100,0.3,'triangle');}}}\nif(player.inv>0)player.inv-=dt;\n// Remove off-screen\nfor(let i=enemies.length-1;i>=0;i--){if(enemies[i].x+enemies[i].w<cameraX-50)enemies.splice(i,1);}\nfor(let i=fuels.length-1;i>=0;i--){const f=fuels[i];f.x-=1.5;if(rectCollide(f,player)){player.fuel+=20;player.score+=10;if(player.fuel>player.maxFuel)player.fuel=player.maxFuel;fuels.splice(i,1);playSound(400,0.2,'sine');}}\n// Score\nconst elapsed=Math.floor((performance.now()-startTime)/1000);\nplayer.score+=dt*10;\nif(player.score>highScore){highScore=player.score;localStorage.setItem('fireBreatherHighScore',Math.floor(highScore));}\n// Game over\nif(player.health<=0){reset();}\n}\n\nfunction rectCollide(a,b){return a.x<b.x+b.w&&a.x+a.w>b.x&&a.y<b.y+b.h&&a.y+a.h>b.y;}\n\nfunction reset(){player.x=100;player.y=0;player.vx=0;player.vy=0;player.health=100;player.fuel=80;player.score=0;startTime=performance.now();enemies.length=0;fuels.length=0;cameraX=0;}\n\n// Render\nfunction render(){ctx.clearRect(0,0,w,h);\n// Background\nctx.fillStyle=C.bg;ctx.fillRect(0,0,w,h);\n// Platforms\nctx.fillStyle=C.ground;for(const p of platforms){ctx.fillRect(p.x-cameraX,p.y,w,12);}\n// Lava\nctx.fillStyle=C.lava;ctx.fillRect(0,h-40,w,40);\n// Fuel pickups\nctx.fillStyle=C.fuel;for(const f of fuels){ctx.beginPath();ctx.arc(f.x-cameraX+f.r,f.y+f.r,f.r,0,Math.PI*2);ctx.fill();}\n// Enemies\nfor(const e of enemies){ctx.fillStyle=e.type==='imp'?C.imp:C.phoenix;ctx.fillRect(e.x-cameraX,e.y,e.w,e.h);}\n// Player\nctx.fillStyle=C.player;ctx.fillRect(player.x-cameraX,player.y,player.w,player.h);\n// Flame\nif(mouse.down&&breathCd<=0&&player.fuel>0){const flameLen=30*(player.fuel/player.maxFuel);const mouthX=player.x-cameraX+(player.dir>0?player.w:0);const mouthY=player.y+player.h/2;ctx.strokeStyle=C.flame;ctx.lineWidth=4;ctx.beginPath();ctx.moveTo(mouthX,mouthY);ctx.lineTo(mouthX+player.dir*flameLen,mouse.y);ctx.stroke();playSound(300,0.1,'sawtooth',0.1);}\n// HUD\nctx.fillStyle=C.text;ctx.font='16px monospace';\nctx.fillText('FUEL: '+Math.floor(player.fuel)+'/'+player.maxFuel,10,30);\nctx.fillText('HP: '+Math.floor(player.health)+'/'+player.maxHealth,w-120,30);\nctx.fillText('SCORE: '+Math.floor(player.score),w/2-50,30);\nctx.fillText('TIME: '+elapsed+'s',10,h-20);\nctx.fillText('HIGH: '+Math.floor(highScore),w-120,h-20);\n// Low fuel warning\nif(player.fuel<20){ctx.strokeStyle='#ff0000';ctx.strokeRect(0,0,w,h);}}\n\n// Game loop\nfunction loop(timestamp){const dt=(timestamp-lastTime)/1000;lastTime=timestamp;update(dt);render();requestAnimationFrame(loop);}\nrequestAnimationFrame(loop);\n\n// Init audio on first interaction\nwindow.addEventListener('click',()=>{if(audioCtx.state==='suspended')audioCtx.resume();},true);\n\n// Expose for debugging\nwindow.game={player,platforms,enemies,fuels};"
