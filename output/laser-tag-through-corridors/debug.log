  "src/main.js": "import { Engine } from './core/Engine.js';\nimport { MenuManager } from './ui/MenuManager.js';\nimport { AudioManager } from './audio/AudioManager.js';\n\nconst canvas = document.getElementById('game');\nconst uiRoot = document.getElementById('ui-root');\n\nconst audio = new AudioManager();\naudio.init();\n\nconst engine = new Engine(canvas, audio);\nconst menu = new MenuManager(uiRoot, engine, audio);\n\nmenu.showMainMenu();\n\nglobalThis.__game = { engine, menu, audio }; // debug hook\n",
  "src/core/Engine.js": "export class Engine {\n  constructor(canvas, audio) {\n    this.canvas = canvas;\n    this.ctx = canvas.getContext('2d');\n    this.audio = audio;\n    this.running = false;\n    this.lastTime = 0;\n    this.fixedDt = 1/60;\n    this.accumulator = 0;\n    this.maxSubSteps = 5;\n    this.frameCount = 0;\n    this.perf = { sim: 0, render: 0 };\n    \n    this.input = new InputManager();\n    this.world = new World(this);\n    this.renderer = new Renderer(this);\n    this.camera = new Camera(this);\n    \n    this.resize();\n    window.addEventListener('resize', () => this.resize());\n    canvas.addEventListener('contextmenu', e => e.preventDefault());\n  }\n  \n  resize() {\n    const dpr = Math.min(window.devicePixelRatio, 2);\n    this.canvas.width = this.canvas.clientWidth * dpr;\n    this.canvas.height = this.canvas.clientHeight * dpr;\n    this.logicalWidth = 1920;\n    this.logicalHeight = 1080;\n    this.scale = Math.min(this.canvas.width / this.logicalWidth, this.canvas.height / this.logicalHeight);\n    this.ctx.setTransform(this.scale, 0, 0, this.scale, 0, 0);\n    this.camera.resize();\n  }\n  \n  start() {\n    if (this.running) return;\n    this.running = true;\n    this.lastTime = performance.now();\n    this.loop();\n  }\n  \n  stop() { this.running = false; }\n  \n  loop() {\n    if (!this.running) return;\n    const now = performance.now();\n    let dt = (now - this.lastTime) / 1000;\n    this.lastTime = now;\n    dt = Math.min(dt, 0.1);\n    \n    this.accumulator += dt;\n    let steps = 0;\n    while (this.accumulator >= this.fixedDt && steps < this.maxSubSteps) {\n      const simStart = performance.now();\n      this.fixedStep(this.fixedDt);\n      this.perf.sim = performance.now() - simStart;\n      this.accumulator -= this.fixedDt;\n      steps++;\n    }\n    const alpha = this.accumulator / this.fixedDt;\n    \n    const renderStart = performance.now();\n    this.render(alpha);\n    this.perf.render = performance.now() - renderStart;\n    \n    this.frameCount++;\n    requestAnimationFrame(() => this.loop());\n  }\n  \n  fixedStep(dt) {\n    this.input.update();\n    this.world.update(dt);\n    this.camera.update(dt);\n  }\n  \n  render(alpha) {\n    this.ctx.setTransform(this.scale, 0, 0, this.scale, 0, 0);\n    this.ctx.clearRect(0, 0, this.logicalWidth, this.logicalHeight);\n    this.renderer.render(this.ctx, alpha);\n    \n    // Perf overlay\n    if (this.showPerf) {\n      this.ctx.setTransform(1,0,0,1,0,0);\n      this.ctx.fillStyle = '#0008';\n      this.ctx.fillRect(0,0,200,60);\n      this.ctx.fillStyle = '#0f0';\n      this.ctx.font = '12px monospace';\n      this.ctx.fillText(`Sim: ${this.perf.sim.toFixed(2)}ms`, 10, 20);\n      this.ctx.fillText(`Render: ${this.perf.render.toFixed(2)}ms`, 10, 40);\n      this.ctx.fillText(`Total: ${(this.perf.sim+this.perf.render).toFixed(2)}ms`, 10, 60);\n    }\n  }\n  \n  newGame() {\n    this.world.generateSector();\n    this.world.player.reset();\n    this.camera.target = this.world.player.pos;\n    this.camera.pos = { ...this.camera.target };\n    this.start();\n  }\n}\n\nclass InputManager {\n  constructor() {\n    this.keys = new Set();\n    this.mouse = { x: 0, y: 0, worldX: 0, worldY: 0, down: false, rightDown: false };\n    this.gamepad = null;\n    this.bindEvents();\n  }\n  bindEvents() {\n    window.addEventListener('keydown', e => { this.keys.add(e.code); if(e.code==='KeyP') globalThis.__game?.engine?.togglePerf?.(); });\n    window.addEventListener('keyup', e => this.keys.delete(e.code));\n    window.addEventListener('mousemove', e => { this.mouse.x = e.clientX; this.mouse.y = e.clientY; });\n    window.addEventListener('mousedown', e => { if(e.button===0) this.mouse.down=true; if(e.button===2) this.mouse.rightDown=true; });\n    window.addEventListener('mouseup', e => { if(e.button===0) this.mouse.down=false; if(e.button===2) this.mouse.rightDown=false; });\n    window.addEventListener('gamepadconnected', e => this.gamepad = e.gamepad);\n    window.addEventListener('gamepaddisconnected', () => this.gamepad = null);\n  }\n  update() {\n    if (this.gamepad) navigator.getGamepads()[this.gamepad.index]; // poll\n    // Convert mouse to world\n    const eng = globalThis.__game?.engine;\n    if (eng) {\n      const rect = eng.canvas.getBoundingClientRect();\n      const scale = eng.scale;\n      this.mouse.worldX = (this.mouse.x - rect.left) / scale + eng.camera.pos.x - eng.logicalWidth/2;\n      this.mouse.worldY = (this.mouse.y - rect.top) / scale + eng.camera.pos.y - eng.logicalHeight/2;\n    }\n  }\n  getAxis() {\n    let x=0,y=0;\n    if(this.keys.has('KeyW')||this.keys.has('ArrowUp')) y--;\n    if(this.keys.has('KeyS')||this.keys.has('ArrowDown')) y++;\n    if(this.keys.has('KeyA')||this.keys.has('ArrowLeft')) x--;\n    if(this.keys.has('KeyD')||this.keys.has('ArrowRight')) x++;\n    if(this.gamepad){ x+=this.gamepad.axes[0]; y+=this.gamepad.axes[1]; }\n    const len=Math.hypot(x,y); return len>0.15?{x:x/len,y:y/len}:{x:0,y:0};\n  }\n  isDown(code){ return this.keys.has(code); }\n  isPressed(code){ return this.keys.has(code) && !this.prevKeys?.has(code); }\n  lateUpdate(){ this.prevKeys = new Set(this.keys); }\n}\n\n// Stub classes to satisfy imports - will be replaced by actual modules below\nclass World { constructor(eng){ this.engine=eng; this.player=null; this.enemies=[]; this.walls=[]; this.projectiles=[]; this.particles=[]; this.sector=0; }\n  generateSector(){ this.sector++; this.player=new Player(this); this.walls=SectorGen.generate(this); this.spawnEnemies(); }\n  spawnEnemies(){ for(let i=0;i<10+this.sector*2;i++) this.enemies.push(new Enemy(this, Math.random()*2000-1000, Math.random()*2000-1000)); }\n  update(dt){ this.player.update(dt); this.enemies.forEach(e=>e.update(dt)); this.projectiles.forEach(p=>p.update(dt)); this.walls.forEach(w=>w.update(dt)); this.particles.forEach(p=>p.update(dt)); }\n}\nclass Player { constructor(w){ this.world=w; this.pos={x:0,y:0}; this.vel={x:0,y:0}; this.radius=16; this.hp=100; this.maxHp=100; this.shield=0; this.stamina=100; this.maxStamina=100; this.dashCd=0; this.dashDur=0; this.invuln=0; this.state='IDLE'; this.score=0; }\n  reset(){ this.pos={x:0,y:0}; this.vel={x:0,y:0}; this.hp=this.maxHp; this.shield=0; this.stamina=this.maxStamina; this.dashCd=0; this.score=0; }\n  update(dt){ const input=this.world.engine.input.getAxis(); const speed=this.world.engine.input.isDown('ShiftLeft')&&this.stamina>0?480:280; const accel=2000; this.vel.x+= (input.x*speed-this.vel.x)*accel*dt; this.vel.y+= (input.y*speed-this.vel.y)*accel*dt; this.pos.x+=this.vel.x*dt; this.pos.y+=this.vel.y*dt; if(this.world.engine.input.isDown('Space')&&this.dashCd<=0&&this.stamina>=25){ this.dashDur=0.18; this.dashCd=1.2; this.stamina-=25; this.invuln=0.15; this.world.audio.play('dash'); } if(this.dashDur>0){ const dir=Math.atan2(this.world.engine.input.mouse.worldY-this.pos.y, this.world.engine.input.mouse.worldX-this.pos.x); this.vel.x=Math.cos(dir)*1200; this.vel.y=Math.sin(dir)*1200; this.dashDur-=dt; this.invuln=Math.max(this.invuln, this.dashDur); } this.dashCd-=dt; this.stamina=Math.min(this.maxStamina, this.stamina+dt*20); if(this.world.engine.input.mouse.down) this.fireBeam(); if(this.world.engine.input.mouse.rightDown) this.fireRifle(); if(this.world.engine.input.isPressed('KeyQ')) this.throwGrenade(); }\n  fireBeam(){ this.world.audio.play('beam'); const dir=Math.atan2(this.world.engine.input.mouse.worldY-this.pos.y, this.world.engine.input.mouse.worldX-this.pos.x); let x=this.pos.x, y=this.pos.y; for(let bounce=0;bounce<3;bounce++){ const hit=raycastSegments(x,y,dir,this.world.walls); if(!hit) break; hit.segment.applyTorque(hit.point, dir, 45); x=hit.point.x+Math.cos(dir)*0.1; y=hit.point.y+Math.sin(dir)*0.1; dir=reflectAngle(dir, hit.normal); } }\n  fireRifle(){ if(this.rifleCd>0) return; this.rifleCd=0.12; this.world.projectiles.push(new Projectile(this.world, this.pos.x, this.pos.y, Math.atan2(this.world.engine.input.mouse.worldY-this.pos.y, this.world.engine.input.mouse.worldX-this.pos.x), 'player', 18, 900, 2)); this.world.audio.play('shoot'); }\n  throwGrenade(){ if(this.grenadeCd>0) return; this.grenadeCd=18; this.world.projectiles.push(new Projectile(this.world, this.pos.x, this.pos.y, Math.atan2(this.world.engine.input.mouse.worldY-this.pos.y, this.world.engine.input.mouse.worldX-this.pos.x), 'grenade', 0, 400, 0, true)); this.world.audio.play('throw'); }\n}\nclass Enemy { constructor(w,x,y){ this.world=w; this.pos={x,y}; this.vel={x:0,y:0}; this.radius=14; this.hp=30; this.maxHp=30; this.type='drone'; this.fireCd=0; this.aiTimer=0; }\n  update(dt){ const player=this.world.player; const dx=player.pos.x-this.pos.x, dy=player.pos.y-this.pos.y; const dist=Math.hypot(dx,dy); if(dist<500&&this.fireCd<=0){ this.world.projectiles.push(new Projectile(this.world, this.pos.x, this.pos.y, Math.atan2(dy,dx), 'enemy', 10, 600, 0)); this.fireCd=1.5; this.world.audio.play('enemyShoot'); } this.fireCd-=dt; const speed=80; this.vel.x+=(dx/dist*speed-this.vel.x)*10*dt; this.vel.y+=(dy/dist*speed-this.vel.y)*10*dt; this.pos.x+=this.vel.x*dt; this.pos.y+=this.vel.y*dt; }\n}\nclass WallSegment { constructor(anchor, angle, length){ this.anchor=anchor; this.angle=angle; this.initialAngle=angle; this.length=length; this.angularVel=0; this.angularDrag=0.985; this.maxDelta=Math.PI/2; this.hp=100; this.maxHp=100; }\n  update(dt){ this.angle+=this.angularVel*dt; this.angularVel*=this.angularDrag; const delta=this.angle-this.initialAngle; if(delta>this.maxDelta){ this.angle=this.initialAngle+this.maxDelta; this.angularVel=0; }else if(delta<-this.maxDelta){ this.angle=this.initialAngle-this.maxDelta; this.angularVel=0; } }\n  applyTorque(point, beamDir, force){ const rx=point.x-this.anchor.x, ry=point.y-this.anchor.y; const torque=(rx*beamDir.y - ry*beamDir.x)*force; this.angularVel+=torque*0.01; }\n  getEndpoints(){ const dx=Math.cos(this.angle)*this.length/2, dy=Math.sin(this.angle)*this.length/2; return {x1:this.anchor.x-dx,y1:this.anchor.y-dy,x2:this.anchor.x+dx,y2:this.anchor.y+dy}; }\n  getNormal(){ return {x:-Math.sin(this.angle), y:Math.cos(this.angle)}; }\n}\nclass Projectile { constructor(w,x,y,angle,owner,dmg,speed,maxBounces,isGrenade=false){ this.world=w; this.pos={x,y}; this.vel={x:Math.cos(angle)*speed,y:Math.sin(angle)*speed}; this.owner=owner; this.dmg=dmg; this.bounces=0; this.maxBounces=maxBounces; this.isGrenade=isGrenade; this.life=isGrenade?4:3; this.radius=4; }\n  update(dt){ this.life-=dt; if(this.life<=0){ this.world.particles.push(new Particle(this.world, this.pos.x, this.pos.y, 'explosion')); this.remove(); return; } if(this.isGrenade){ this.vel.y+=500*dt; if(this.bounces<3&&this.pos.y>1000){ this.vel.y*=-0.5; this.bounces++; this.world.audio.play('bounce'); } } this.pos.x+=this.vel.x*dt; this.pos.y+=this.vel.y*dt; const hit=raycastSegments(this.pos.x-this.vel.x*dt, this.pos.y-this.vel.y*dt, Math.atan2(this.vel.y,this.vel.x), this.world.walls); if(hit){ if(this.isGrenade){ this.vel.x=reflectAngle(Math.atan2(this.vel.y,this.vel.x), hit.normal); this.bounces++; }else{ this.bounces++; if(this.bounces>this.maxBounces){ this.remove(); return; } const angle=reflectAngle(Math.atan2(this.vel.y,this.vel.x), hit.normal); this.vel.x=Math.cos(angle)*900; this.vel.y=Math.sin(angle)*900; this.dmg*=1.5; this.world.audio.play('ricochet'); } } this.world.enemies.forEach(e=>{ if(e!==this.owner&&Math.hypot(e.pos.x-this.pos.x,e.pos.y-this.pos.y)<e.radius+this.radius){ e.hp-=this.dmg; this.world.particles.push(new Particle(this.world, this.pos.x, this.pos.y, 'hit')); if(e.hp<=0){ this.world.player.score+=10; this.world.audio.play('kill'); e.remove=true; } if(!this.isGrenade) this.remove(); } }); }\n  remove(){ this.world.projectiles=this.world.projectiles.filter(p=>p!==this); }\n}\nclass Particle { constructor(w,x,y,type){ this.world=w; this.pos={x,y}; this.vel={x:(Math.random()-0.5)*200,y:(Math.random()-0.5)*200}; this.life=1; this.maxLife=1; this.type=type; this.color=type==='hit'?'#ff1493':type==='explosion'?'#ffaa00':'#00f3ff'; this.size=Math.random()*3+1; }\n  update(dt){ this.life-=dt; this.pos.x+=this.vel.x*dt; this.pos.y+=this.vel.y*dt; this.vel.x*=0.98; this.vel.y*=0.98; if(this.life<=0) this.world.particles=this.world.particles.filter(p=>p!==this); }\n}\nclass SectorGen { static generate(world){ const walls=[]; const gridSize=240; const cols=15, rows=10; const nodes=[]; for(let gy=0;gy<rows;gy++) for(let gx=0;gx<cols;gx++) nodes.push({x:gx*gridSize,y:gy*gridSize,visited:false}); const stack=[nodes[0]]; nodes[0].visited=true; while(stack.length){ const cur=stack[stack.length-1]; const neighbors=[[0,-1],[0,1],[-1,0],[1,0]].map(([dx,dy])=>nodes.find(n=>n.x===(cur.x/gridSize+dx)*gridSize&&n.y===(cur.y/gridSize+dy)*gridSize)).filter(n=>n&&!n.visited); if(neighbors.length){ const next=neighbors[Math.floor(Math.random()*neighbors.length)]; next.visited=true; stack.push(next); const anchor={x:(cur.x+next.x)/2,y:(cur.y+next.y)/2}; const angle=Math.atan2(next.y-cur.y,next.x-cur.x); walls.push(new WallSegment(anchor,angle,gridSize*1.2)); }else stack.pop(); }\n return walls; }\n}\nfunction raycastSegments(x,y,dir,walls){ let best=null, bestDist=Infinity; const dx=Math.cos(dir), dy=Math.sin(dir); for(const w of walls){ const ep=w.getEndpoints(); const segDx=ep.x2-ep.x1, segDy=ep.y2-ep.y1; const det=dx*segDy-dy*segDx; if(Math.abs(det)<0.001) continue; const t=((ep.x1-x)*segDy-(ep.y1-y)*segDx)/det; const u=((ep.x1-x)*dy-(ep.y1-y)*dx)/det; if(t>0.1&&t<bestDist&&u>=0&&u<=1){ bestDist=t; best={point:{x:x+dx*t,y:y+dy*t},normal:w.getNormal(),segment:w}; } } return best; }\nfunction reflectAngle(angle, normal){ const nx=normal.x, ny=normal.y; const dx=Math.cos(angle), dy=Math.sin(angle); const dot=dx*nx+dy*ny; return Math.atan2(dy-2*dot*ny, dx-2*dot*nx); }\nclass Camera { constructor(eng){ this.engine=eng; this.pos={x:0,y:0}; this.target={x:0,y:0}; this.trauma=0; }\n  resize(){}\n  update(dt){ const player=this.engine.world.player; const mouse=this.engine.input.mouse; const lookX=mouse.worldX-player.pos.x, lookY=mouse.worldY-player.pos.y; const lookDist=Math.hypot(lookX,lookY); this.target.x=player.pos.x+(lookDist>0?lookX/lookDist*180:0); this.target.y=player.pos.y+(lookDist>0?lookY/lookDist*180:0); const lerp=1-Math.pow(0.001,dt); this.pos.x+=(this.target.x-this.pos.x)*lerp; this.pos.y+=(this.target.y-this.pos.y)*lerp; if(this.trauma>0){ this.trauma=Math.max(0,this.trauma-=dt); const shake=this.trauma**2*12; this.pos.x+= (Math.random()-0.5)*shake; this.pos.y+= (Math.random()-0.5)*shake; } }\n  addTrauma(t){ this.trauma=Math.min(1, this.trauma+t); }\n}\nclass Renderer { constructor(eng){ this.engine=eng; }\n  render(ctx, alpha){ const cam=this.engine.camera; ctx.save(); ctx.translate(-cam.pos.x+this.engine.logicalWidth/2, -cam.pos.y+this.engine.logicalHeight/2);\n    this.renderWalls(ctx);\n    this.renderEntities(ctx, alpha);\n    this.renderProjectiles(ctx);\n    this.renderParticles(ctx);\n    this.renderBeam(ctx);\n    ctx.restore();\n    this.renderHUD(ctx);\n  }\n  renderWalls(ctx){ ctx.lineWidth=6; ctx.lineCap='round';\n    for(const w of this.engine.world.walls){ const ep=w.getEndpoints(); const hpRatio=w.hp/w.maxHp;\n      ctx.beginPath(); ctx.moveTo(ep.x1, ep.y1); ctx.lineTo(ep.x2, ep.y2);\n      const grad=ctx.createLinearGradient(ep.x1, ep.y1, ep.x2, ep.y2);\n      grad.addColorStop(0, `rgba(0,243,255,${0.3+0.4*hpRatio})`);\n      grad.addColorStop(0.5, `rgba(0,243,255,${0.6+0.3*hpRatio})`);\n      grad.addColorStop(1, `rgba(0,243,255,${0.3+0.4*hpRatio})`);\n      ctx.strokeStyle=grad; ctx.stroke();\n      ctx.shadowColor='#00f3ff'; ctx.shadowBlur=10; ctx.stroke(); ctx.shadowBlur=0;\n      if(hpRatio<1){ ctx.beginPath(); ctx.moveTo(ep.x1, ep.y1); ctx.lineTo(ep.x2, ep.y2); ctx.strokeStyle=`rgba(255,20,147,${1-hpRatio})`; ctx.lineWidth=3; ctx.stroke(); ctx.lineWidth=6; }\n    }\n  }\n  renderEntities(ctx, alpha){ const p=this.engine.world.player;\n    const ix=p.pos.x+p.vel.x*alpha*16, iy=p.pos.y+p.vel.y*alpha*16;\n    ctx.save(); ctx.translate(ix, iy);\n    if(p.invuln>0){ ctx.globalAlpha=0.5+0.5*Math.sin(performance.now()/50); }\n    ctx.beginPath(); ctx.arc(0,0,p.radius,0,Math.PI*2);\n    const pg=ctx.createRadialGradient(0,0,0,0,0,p.radius);\n    pg.addColorStop(0, '#ffffff'); pg.addColorStop(0.5, '#00f3ff'); pg.addColorStop(1, '#0066ff');\n    ctx.fillStyle=pg; ctx.fill();\n    ctx.strokeStyle='#00f3ff'; ctx.lineWidth=2; ctx.stroke();\n    if(p.shield>0){ ctx.beginPath(); ctx.arc(0,0,p.radius+4,0,Math.PI*2); ctx.strokeStyle=`rgba(0,243,255,${0.3+p.shield/p.maxHp*0.4})`; ctx.lineWidth=3; ctx.stroke(); }\n    ctx.restore();\n    for(const e of this.engine.world.enemies){ if(e.remove) continue;\n      const ex=e.pos.x+e.vel.x*alpha*16, ey=e.pos.y+e.vel.y*alpha*16;\n      ctx.save(); ctx.translate(ex, ey);\n      ctx.beginPath(); ctx.arc(0,0,e.radius,0,Math.PI*2);\n      const eg=ctx.createRadialGradient(0,0,0,0,0,e.radius);\n      eg.addColorStop(0, '#ff4444'); eg.addColorStop(1, '#880000');\n      ctx.fillStyle=eg; ctx.fill();\n      ctx.strokeStyle='#ff1493'; ctx.lineWidth=2; ctx.stroke();\n      ctx.restore();\n    }\n  }\n  renderProjectiles(ctx){ for(const p of this.engine.world.projectiles){ ctx.beginPath(); ctx.arc(p.pos.x, p.pos.y, p.radius, 0, Math.PI*2);\n    if(p.isGrenade){ ctx.fillStyle='#ffaa00'; ctx.shadowColor='#ffaa00'; ctx.shadowBlur=8; }\n    else if(p.owner==='player'){ ctx.fillStyle='#00f3ff'; ctx.shadowColor='#00f3ff'; ctx.shadowBlur=6; }\n    else{ ctx.fillStyle='#ff4400'; ctx.shadowColor='#ff4400'; ctx.shadowBlur=6; }\n    ctx.fill(); ctx.shadowBlur=0; }\n  }\n  renderParticles(ctx){ for(const pt of this.engine.world.particles){ ctx.globalAlpha=pt.life/pt.maxLife; ctx.beginPath(); ctx.arc(pt.pos.x, pt.pos.y, pt.size, 0, Math.PI*2); ctx.fillStyle=pt.color; ctx.fill(); }\n    ctx.globalAlpha=1;\n  }\n  renderBeam(ctx){ const p=this.engine.world.player; const eng=this.engine;\n    if(!eng.input.mouse.down) return;\n    const dir=Math.atan2(eng.input.mouse.worldY-p.pos.y, eng.input.mouse.worldX-p.pos.x);\n    let x=p.pos.x, y=p.pos.y;\n    ctx.save(); ctx.lineWidth=3; ctx.lineCap='round';\n    for(let bounce=0;bounce<3;bounce++){ const hit=raycastSegments(x,y,dir,eng.world.walls);\n      if(!hit){ const endX=x+Math.cos(dir)*5000, endY=y+Math.sin(dir)*5000;\n        const grad=ctx.createLinearGradient(x,y,endX,endY);\n        grad.addColorStop(0, 'rgba(255,20,147,0.8)'); grad.addColorStop(1, 'rgba(255,20,147,0)');\n        ctx.strokeStyle=grad; ctx.beginPath(); ctx.moveTo(x,y); ctx.lineTo(endX,endY);\n        ctx.shadowColor='#ff1493'; ctx.shadowBlur=15; ctx.stroke(); ctx.shadowBlur=0; break;\n      }\n      const grad=ctx.createLinearGradient(x,y,hit.point.x,hit.point.y);\n      grad.addColorStop(0, 'rgba(255,20,147,0.8)'); grad.addColorStop(1, 'rgba(255,20,147,0.2)');\n      ctx.strokeStyle=grad; ctx.beginPath(); ctx.moveTo(x,y); ctx.lineTo(hit.point.x,hit.point.y);\n      ctx.shadowColor='#ff1493'; ctx.shadowBlur=15; ctx.stroke(); ctx.shadowBlur=0;\n      ctx.beginPath(); ctx.arc(hit.point.x, hit.point.y, 8, 0, Math.PI*2);\n      ctx.fillStyle='rgba(255,20,147,0.6)'; ctx.fill();\n      x=hit.point.x+Math.cos(dir)*0.1; y=hit.point.y+Math.sin(dir)*0.1;\n      dir=reflectAngle(dir, hit.normal);\n    }\n    ctx.restore();\n  }\n  renderHUD(ctx){ ctx.setTransform(1,0,0,1,0,0);\n    const p=this.engine.world.player;\n    const w=this.engine.canvas.width, h=this.engine.canvas.height;\n    const scale=this.engine.scale;\n    const lw=this.engine.logicalWidth, lh=this.engine.logicalHeight;\n    ctx.font='14px JetBrains Mono';\n    ctx.fillStyle='#e0f8ff';\n    ctx.fillText(`SECTOR ${this.engine.world.sector}`, 20/scale, 30/scale);\n    ctx.fillText(`SCORE ${p.score}`, 20/scale, 50/scale);\n  }\n}\n",
  "src/ui/MenuManager.js": "export class MenuManager {\n  constructor(uiRoot, engine, audio) {\n    this.uiRoot = uiRoot;\n    this.engine = engine;\n    this.audio = audio;\n    this.currentMenu = null;\n    this.settings = {\n      masterVol: 0.7,\n      sfxVol: 0.8,\n      musicVol: 0.5,\n      reducedMotion: false,\n      colorblind: false,\n      difficulty: 'normal'\n    };\n    this.loadSettings();\n    this.applySettings();\n  }\n  loadSettings() {\n    try {\n      const saved = localStorage.getItem('refractionTagSettings');\n      if (saved) Object.assign(this.settings, JSON.parse(saved));\n    } catch (e) {}\n  }\n  saveSettings() {\n    localStorage.setItem('refractionTagSettings', JSON.stringify(this.settings));\n    this.applySettings();\n  }\n  applySettings() {\n    this.audio.setMasterVolume(this.settings.masterVol);\n    this.audio.setSfxVolume(this.settings.sfxVol);\n    this.audio.setMusicVolume(this.settings.musicVol);\n    document.documentElement.style.setProperty('--reduced-motion', this.settings.reducedMotion ? '1' : '0');\n    document.body.classList.toggle('colorblind', this.settings.colorblind);\n  }\n  clear() { this.uiRoot.innerHTML = ''; }\n  createBtn(text, onClick, cls = '') {\n    const btn = document.createElement('button');\n    btn.className = `btn ${cls}`;\n    btn.textContent = text;\n    btn.addEventListener('click', () => { this.audio.play('click'); onClick(); });\n    return btn;\n  }\n  showMainMenu() {\n    this.clear();\n    const menu = document.createElement('div');\n    menu.className = 'menu';\n    menu.setAttribute('role', 'dialog');\n    menu.setAttribute('aria-label', 'Main Menu');\n    menu.innerHTML = `\n      <h1>REFRACTION TAG</h1>\n      <div style=\"display:flex;flex-direction:column;gap:0.5rem;\"></div>\n    `;\n    const btnContainer = menu.querySelector('div');\n    btnContainer.appendChild(this.createBtn('NEW SECTOR', () => this.startGame()));\n    btnContainer.appendChild(this.createBtn('UPGRADES', () => this.showUpgrades()));\n    btnContainer.appendChild(this.createBtn('SETTINGS', () => this.showSettings()));\n    btnContainer.appendChild(this.createBtn('HOW TO PLAY', () => this.showHelp()));\n    this.uiRoot.appendChild(menu);\n    this.currentMenu = 'main';\n  }\n  startGame() {\n    this.clear();\n    this.engine.newGame();\n    this.currentMenu = null;\n  }\n  showPauseMenu() {\n    this.engine.stop();\n    const menu = document.createElement('div');\n    menu.className = 'menu';\n    menu.setAttribute('role', 'dialog');\n    menu.setAttribute('aria-label', 'Paused');\n    menu.innerHTML = `<h1>PAUSED</h1><div style=\"display:flex;flex-direction:column;gap:0.5rem;\"></div>`;\n    const btnContainer = menu.querySelector('div');\n    btnContainer.appendChild(this.createBtn('RESUME', () => { this.clear(); this.engine.start(); this.currentMenu = null; }));\n    btnContainer.appendChild(this.createBtn('SETTINGS', () => this.showSettings(true)));\n    btnContainer.appendChild(this.createBtn('ABANDON SECTOR', () => { this.clear(); this.showMainMenu(); }));\n    this.uiRoot.appendChild(menu);\n    this.currentMenu = 'pause';\n  }\n  showGameOver(victory) {\n    this.engine.stop();\n    const menu = document.createElement('div');\n    menu.className = 'menu';\n    menu.setAttribute('role', 'dialog');\n    menu.setAttribute('aria-label', victory ? 'Victory' : 'Defeat');\n    menu.innerHTML = `\n      <h1 style=\"color:${victory ? 'var(--health)' : 'var(--danger)'}\">${victory ? 'SECTOR CLEARED' : 'SIGNAL LOST'}</h1>\n      <p style=\"margin-bottom:1.5rem;font-size:1.1rem\">Final Score: <strong>${this.engine.world.player.score}</strong></p>\n      <div style=\"display:flex;flex-direction:column;gap:0.5rem;\"></div>\n    `;\n    const btnContainer = menu.querySelector('div');\n    btnContainer.appendChild(this.createBtn(victory ? 'NEXT SECTOR' : 'RETRY', () => this.startGame()));\n    btnContainer.appendChild(this.createBtn('MAIN MENU', () => this.showMainMenu()));\n    this.uiRoot.appendChild(menu);\n    this.currentMenu = 'gameover';\n  }\n  showUpgrades() {\n    this.clear();\n    const menu = document.createElement('div');\n    menu.className = 'menu';\n    menu.setAttribute('role', 'dialog');\n    menu.setAttribute('aria-label', 'Upgrades');\n    menu.innerHTML = `\n      <h1>UPGRADES</h1>\n      <p style=\"margin-bottom:1.5rem;opacity:0.8\">Spend score to enhance your capabilities</p>\n      <div class=\"upgrade-grid\" id=\"upgrade-grid\"></div>\n      <button class=\"btn\" style=\"margin-top:1.5rem\" onclick=\"this.closest('.menu').remove(); globalThis.__game.menu.showMainMenu()\">BACK</button>\n    `;\n    const grid = menu.querySelector('#upgrade-grid');\n    const upgrades = [\n      { id: 'hp', name: 'REINFORCED CHASSIS', desc: '+25 Max Health per level', cost: 50, max: 4, stat: 'maxHp', mult: 1.25 },\n      { id: 'shield', name: 'VOID BARRIER', desc: 'Regenerating shield (25 HP)', cost: 75, max: 3, stat: 'shield', mult: 1 },\n      { id: 'stamina', name: 'OVERDRIVE CORE', desc: '+30 Max Stamina, +50% regen', cost: 60, max: 3, stat: 'stamina', mult: 1.3 },\n      { id: 'dash', name: 'PHASE SHIFT', desc: 'Dash cooldown -20%, invuln +50%', cost: 80, max: 3, stat: 'dash', mult: 0.8 },\n      { id: 'beam', name: 'PRISM LENS', desc: 'Beam damage +50%, +1 bounce', cost: 100, max: 2, stat: 'beam', mult: 1.5 },\n      { id: 'rifle', name: 'MAG-ACCELERATOR', desc: 'Rifle fire rate +40%, dmg +25%', cost: 90, max: 3, stat: 'rifle', mult: 1.25 }\n    ];\n    upgrades.forEach(u => {\n      const level = this.engine.world.player.upgrades?.[u.id] || 0;\n      const card = document.createElement('div');\n      card.className = 'upgrade-card';\n      card.innerHTML = `\n        <h3>${u.name}</h3>\n        <p>${u.desc}</p>\n        <div style=\"margin-top:auto;display:flex;justify-content:space-between;align-items:center\">\n          <span>Level: ${level}/${u.max}</span>\n          <span style=\"color:var(--beam)\">${u.cost * (level+1)} PTS</span>\n        </div>\n      `;\n      const btn = this.createBtn(level >= u.max ? 'MAXED' : 'PURCHASE', () => {\n        if (level < u.max && this.engine.world.player.score >= u.cost * (level+1)) {\n          this.engine.world.player.score -= u.cost * (level+1);\n          this.engine.world.player.upgrades = this.engine.world.player.upgrades || {};\n          this.engine.world.player.upgrades[u.id] = level + 1;\n          this.applyUpgrade(u.id, level + 1);\n          this.showUpgrades();\n        }\n      });\n      if (level >= u.max || this.engine.world.player.score < u.cost * (level+1)) btn.disabled = true;\n      card.appendChild(btn);\n      grid.appendChild(card);\n    });\n    this.uiRoot.appendChild(menu);\n    this.currentMenu = 'upgrades';\n  }\n  applyUpgrade(id, level) {\n    const p = this.engine.world.player;\n    switch(id) {\n      case 'hp': p.maxHp = 100 + level * 25; p.hp = p.maxHp; break;\n      case 'shield': p.maxShield = level * 25; p.shield = p.maxShield; break;\n      case 'stamina': p.maxStamina = 100 + level * 30; p.stamina = p.maxStamina; break;\n      case 'dash': p.dashCdBase = 1.2 * Math.pow(0.8, level); p.invulnDash = 0.15 * (1 + level * 0.5); break;\n      case 'beam': p.beamDmgMult = Math.pow(1.5, level); p.beamBounces = 2 + level; break;\n      case 'rifle': p.rifleCdBase = 0.12 * Math.pow(0.7, level); p.rifleDmgMult = Math.pow(1.25, level); break;\n    }\n  }\n  showSettings(fromPause = false) {\n    this.clear();\n    const menu = document.createElement('div');\n    menu.className = 'menu';\n    menu.setAttribute('role', 'dialog');\n    menu.setAttribute('aria-label', 'Settings');\n    menu.innerHTML = `\n      <h1>SETTINGS</h1>\n      <div style=\"display:flex;flex-direction:column;gap:0.5rem;\"></div>\n      <button class=\"btn\" style=\"margin-top:1.5rem\" onclick=\"this.closest('.menu').remove(); ${fromPause ? 'globalThis.__game.menu.showPauseMenu()' : 'globalThis.__game.menu.showMainMenu()'}\">BACK</button>\n    `;\n    const container = menu.querySelector('div');\n    const rows = [\n      { label: 'Master Volume', type: 'range', min: 0, max: 1, step: 0.1, key: 'masterVal', get: () => this.settings.masterVol, set: v => this.settings.masterVol = v },\n      { label: 'SFX Volume', type: 'range', min: 0, max: 1, step: 0.1, key: 'sfxVal', get: () => this.settings.sfxVol, set: v => this.settings.sfxVol = v },\n      { label: 'Music Volume', type: 'range', min: 0, max: 1, step: 0.1, key: 'musicVal', get: () => this.settings.musicVol, set: v => this.settings.musicVol = v },\n      { label: 'Reduced Motion', type: 'checkbox', key: 'reducedMotion', get: () => this.settings.reducedMotion, set: v => this.settings.reducedMotion = v },\n      { label: 'Colorblind Mode', type: 'checkbox', key: 'colorblind', get: () => this.settings.colorblind, set: v => this.settings.colorblind = v },\n      { label: 'Difficulty', type: 'select', options: ['easy', 'normal', 'hard'], key: 'difficulty', get: () => this.settings.difficulty, set: v => this.settings.difficulty = v }\n    ];\n    rows.forEach(r => {\n      const row = document.createElement('div');\n      row.className = 'setting-row';\n      row.innerHTML = `<label>${r.label}</label>`;\n      let input;\n      if (r.type === 'range') {\n        input = document.createElement('input');\n        input.type = 'range';\n        input.min = r.min; input.max = r.max; input.step = r.step;\n        input.value = r.get();\n        input.addEventListener('input', e => { r.set(parseFloat(e.target.value)); this.saveSettings(); });\n      } else if (r.type === 'checkbox') {\n        input = document.createElement('input');\n        input.type = 'checkbox';\n        input.checked = r.get();\n        input.addEventListener('change', e => { r.set(e.target.checked); this.saveSettings(); });\n      } else if (r.type === 'select') {\n        input = document.createElement('select');\n        r.options.forEach(opt => { const o = document.createElement('option'); o.value = opt; o.textContent = opt; input.appendChild(o); });\n        input.value = r.get();\n        input.addEventListener('change', e => { r.set(e.target.value); this.saveSettings(); });\n      }\n      row.appendChild(input);\n      container.appendChild(row);\n    });\n    this.uiRoot.appendChild(menu);\n    this.currentMenu = 'settings';\n  }\n  showHelp() {\n    this.clear();\n    const menu = document.createElement('div');\n    menu.className = 'menu';\n    menu.setAttribute('role', 'dialog');\n    menu.setAttribute('aria-label', 'How to Play');\n    menu.innerHTML = `\n      <h1>HOW TO PLAY</h1>\n      <div style=\"text-align:left;line-height:1.8;font-size:0.95rem;max-height:60vh;overflow:auto\">\n        <h3 style=\"color:var(--beam);margin:1rem 0 0.5rem\">CONTROLS</h3>\n        <p><kbd style=\"background:var(--ui-bg);border:1px solid var(--ui-border);padding:0.1rem 0.4rem;border-radius:3px\">WASD</kbd> / <kbd style=\"background:var(--ui-bg);border:1px solid var(--ui-border);padding:0.1rem 0.4rem;border-radius:3px\">Arrow Keys</kbd> - Move</p>\n        <p><kbd style=\"background:var(--ui-bg);border:1px solid var(--ui-border);padding:0.1rem 0.4rem;border-radius:3px\">Shift</kbd> - Sprint (consumes stamina)</p>\n        <p><kbd style=\"background:var(--ui-bg);border:1px solid var(--ui-border);padding:0.1rem 0.4rem;border-radius:3px\">Space</kbd> - Dash toward cursor (25 stamina, i-frames)</p>\n        <p><kbd style=\"background:var(--ui-bg);border:1px solid var(--ui-border);padding:0.1rem 0.4rem;border-radius:3px\">LMB</kbd> - Hold: Prism Beam (reflects off walls, pushes them)</p>\n        <p><kbd style=\"background:var(--ui-bg);border:1px solid var(--ui-border);padding:0.1rem 0.4rem;border-radius:3px\">RMB</kbd> - Auto-Rifle (ricochets, gains damage per bounce)</p>\n        <p><kbd style=\"background:var(--ui-bg);border:1px solid var(--ui-border);padding:0.1rem 0.4rem;border-radius:3px\">Q</kbd> - Throw Grenade (bounces, explodes)</p>\n        <p><kbd style=\"background:var(--ui-bg);border:1px solid var(--ui-border);padding:0.1rem 0.4rem;border-radius:3px\">Esc</kbd> - Pause</p>\n        <h3 style=\"color:var(--beam);margin:1.5rem 0 0.5rem\">MECHANICS</h3>\n        <p><strong>Prism Beam:</strong> Hold LMB to fire a continuous beam. It reflects off walls up to 3 times. Each reflection applies torque, rotating the wall segment. Use this to create angles for trick shots or to push walls into enemies.</p>\n        <p><strong>Ricochet Rifle:</strong> Right-click fires fast projectiles that bounce off walls. Each bounce increases damage by 50%. Max 2 bounces base.</p>\n        <p><strong>Grenades:</strong> Press Q to lob a grenade. Bounces 3 times then explodes. 18s cooldown.</p>\n        <p><strong>Wall Physics:</strong> Walls are anchored segments that rotate when hit. They spring back to original angle. Destroy them by dealing enough damage.</p>\n        <p><strong>Sectors:</strong> Clear all enemies to advance. Each sector adds more enemies and tougher layouts. Earn score to buy upgrades between sectors.</p>\n        <h3 style=\"color:var(--beam);margin:1.5rem 0 0.5rem\">TIPS</h3>\n        <p>• Aim beam at wall edges for maximum torque</p>\n        <p>• Ricochet shots around corners for bonus damage</p>\n        <p>• Dash through enemy projectiles (i-frames)</p>\n        <p>• Manage stamina - sprinting prevents regen</p>\n        <p>• Upgrades persist across sectors</p>\n      </div>\n      <button class=\"btn\" style=\"margin-top:1.5rem\" onclick=\"this.closest('.menu').remove(); globalThis.__game.menu.showMainMenu()\">BACK</button>\n    `;\n    this.uiRoot.appendChild(menu);\n    this.currentMenu = 'help';\n  }\n}\n",
  "src/audio/AudioManager.js": "export class AudioManager {\n  constructor() {\n    this.ctx = null;\n    this.masterGain = null;\n    this.sfxGain = null;\n    this.musicGain = null;\n    this.masterVol = 0.7;\n    this.sfxVol = 0.8;\n    this.musicVol = 0.5;\n    this.sfxBuffers = {};\n    this.musicSource = null;\n    this.enabled = true;\n  }\n  async init() {\n    try {\n      this.ctx = new (window.AudioContext || window.webkitAudioContext)();\n      this.masterGain = this.ctx.createGain();\n      this.masterGain.gain.value = this.masterVol;\n      this.masterGain.connect(this.ctx.destination);\n      this.sfxGain = this.ctx.createGain();\n      this.sfxGain.gain.value = this.sfxVol;\n      this.sfxGain.connect(this.masterGain);\n      this.musicGain = this.ctx.createGain();\n      this.musicGain.gain.value = this.musicVol;\n      this.musicGain.connect(this.masterGain);\n      await this.generateSfx();\n      this.startMusic();\n    } catch (e) {\n      console.warn('Audio init failed:', e);\n      this.enabled = false;\n    }\n  }\n  async generateSfx() {\n    const createTone = (freq, dur, type='sine', vol=0.3) => {\n      const buffer = this.ctx.createBuffer(1, this.ctx.sampleRate * dur, this.ctx.sampleRate);\n      const data = buffer.getChannelData(0);\n      for (let i = 0; i < data.length; i++) {\n        const t = i / this.ctx.sampleRate;\n        const env = Math.exp(-t * 8);\n        let sample = 0;\n        if (type === 'sine') sample = Math.sin(2 * Math.PI * freq * t);\n        else if (type === 'square') sample = Math.sign(Math.sin(2 * Math.PI * freq * t));\n        else if (type === 'saw') sample = 2 * (t * freq - Math.floor(t * freq + 0.5));\n        else if (type === 'noise') sample = (Math.random() * 2 - 1) * env;\n        data[i] = sample * vol * env;\n      }\n      return buffer;\n    };\n    this.sfxBuffers = {\n      click: createTone(800, 0.05, 'square', 0.2),\n      dash: createTone(200, 0.15, 'saw', 0.4),\n      shoot: createTone(400, 0.08, 'square', 0.3),\n      enemyShoot: createTone(150, 0.1, 'saw', 0.25),\n      ricochet: createTone(600, 0.06, 'sine', 0.3),\n      bounce: createTone(300, 0.08, 'sine', 0.2),\n      hit: createTone(500, 0.1, 'square', 0.35),\n      kill: createTone(1000, 0.2, 'sine', 0.4),\n      explosion: createTone(80, 0.5, 'noise', 0.5),\n      throw: createTone(250, 0.1, 'saw', 0.3),\n      beam: createTone(120, 0.5, 'saw', 0.15)\n    };\n  }\n  play(name, opts = {}) {\n    if (!this.enabled || !this.sfxBuffers[name]) return;\n    if (this.ctx.state === 'suspended') await this.ctx.resume();\n    const src = this.ctx.createBufferSource();\n    src.buffer = this.sfxBuffers[name];\n    const gain = this.ctx.createGain();\n    gain.gain.value = opts.vol || 1;\n    src.connect(gain).connect(this.sfxGain);\n    if (opts.rate) src.playbackRate.value = opts.rate;\n    src.start();\n  }\n  setMasterVolume(v) { this.masterVol = v; if (this.masterGain) this.masterGain.gain.value = v; }\n  setSfxVolume(v) { this.sfxVol = v; if (this.sfxGain) this.sfxGain.gain.value = v; }\n  setMusicVolume(v) { this.musicVol = v; if (this.musicGain) this.musicGain.gain.value = v; }\n  startMusic() {\n    if (!this.enabled) return;\n    const playLoop = () => {\n      if (!this.enabled) return;\n      const buffer = this.createMusicBuffer();\n      this.musicSource = this.ctx.createBufferSource();\n      this.musicSource.buffer = buffer;\n      this.musicSource.loop = true;\n      this.musicSource.connect(this.musicGain);\n      this.musicSource.start();\n      this.musicSource.onended = playLoop;\n    };\n    playLoop();\n  }\n  createMusicBuffer() {\n    const len = this.ctx.sampleRate * 32;\n    const buffer = this.ctx.createBuffer(2, len, this.ctx.sampleRate);\n    const notes = [55, 61.74, 73.42, 82.41, 110, 123.47, 146.83, 164.81];\n    for (let ch = 0; ch < 2; ch++) {\n      const data = buffer.getChannelData(ch);\n      for (let i = 0; i < len; i++) {\n        const t = i / this.ctx.sampleRate;\n        const bar = Math.floor(t * 0.5) % 8;\n        const note = notes[bar];\n        const env = Math.exp(-(t % 2) * 1.5);\n        data[i] = Math.sin(2 * Math.PI * note * t) * 0.08 * env;\n        if (ch === 1) data[i] += Math.sin(2 * Math.PI * note * 0.5 * t) * 0.04 * env;\n      }\n    }\n    return buffer;\n  }\n  stopMusic() { if (this.musicSource) { this.musicSource.stop(); this.musicSource = null; } }\n}\n",
  "src/core/Constants.js": "export const CONSTANTS = {\n  PLAYER_RADIUS: 16,\n  PLAYER_SPEED: 280,\n  PLAYER_SPRINT_SPEED: 480,\n  PLAYER_ACCEL: 2000,\n  PLAYER_MAX_HP: 100,\n  PLAYER_MAX_STAMINA: 100,\n  PLAYER_STAMINA_REG