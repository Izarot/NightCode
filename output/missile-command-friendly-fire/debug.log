Game.Storage = {
  KEY:'mc_highscore',
  load(){try{const d=JSON.parse(localStorage.getItem(this.KEY));return d||null;}catch(e){return null;}},
  save(name,score){try{localStorage.setItem(this.KEY,JSON.stringify({name:name||'PLAYER',score:score,date:Date.now()}));}catch(e){}},
  clear(){try{localStorage.removeItem(this.KEY);}catch(e){}}
};
