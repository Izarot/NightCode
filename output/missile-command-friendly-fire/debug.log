Game.City = function(x,y){
  this.x=x;this.y=y;this.hp=3;this.damagedUntil=0;this.flash=0;
};
Game.City.prototype.hit=function(){if(this.damagedUntil>Game.Utils.now())return false;this.hp--;this.damagedUntil=Game.Utils.now()+2000;this.flash=1;return true;};
Game.City.prototype.draw=function(ctx){
  const col=this.hp===3?'#2E8B57':this.hp===2?'#8B8B00':'#8B0000';
  ctx.fillStyle=col;ctx.fillRect(this.x-24,this.y-24,48,48);
  ctx.strokeStyle='#000';ctx.lineWidth=2;ctx.strokeRect(this.x-24,this.y-24,48,48);
  // pixel roof details
  ctx.fillStyle='#000';ctx.fillRect(this.x-16,this.y-32,32,8);
  if(this.flash>0){ctx.fillStyle='rgba(255,255,255,'+this.flash+')';ctx.fillRect(this.x-24,this.y-24,48,48);this.flash-=0.05;}
};
