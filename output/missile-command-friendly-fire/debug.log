Game.FriendlyFire = {
  penalty(overshoot){return -50-(Math.floor(overshoot/10))*10;},
  applyPenalty(budget,allowances,lockEnd,penalty){
    const p=this.penalty(penalty);
    allowances[0]-=p; // track negative
    if(allowances[0]<0){allowances[0]=0;lockEnd=Game.Utils.now()+10000;return{penalty:p,locked:true};}
    return{penalty:p,locked:false};
  }
};
```

