**js/entities/particle.js**:
```js
Game.Particle = function(x,y,color){
  this.x=x;this.y=y;this.vx=(Math.random()-0.5)*6;this.vy=(Math.random()-0.5)*6;
  this.life=1;this.color=color;this.r=Math.random()*3+2;
};
Game.Particle.prototype.update=function(dt){this.x+=this.vx*dt;this.y+=this.vy*dt;this.vy+=0.2*dt;this.life-=dt*0.04;};
Game.Particle.prototype.draw=function(ctx){ctx.globalAlpha=Math.max(0,this.life);ctx.fillStyle=this.color;ctx.beginPath();ctx.arc(this.x,this.y,this.r,0,Math.PI*2);ctx.fill();ctx.globalAlpha=1;};
```

