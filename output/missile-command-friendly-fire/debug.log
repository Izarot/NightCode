**js/pooling.js**:
```js
Game.Pool = function Pool(factory){
  let items=[],free=[];
  return{
    get(){if(free.length)return free.pop();items.push(factory());return items[items.length-1];},
    release(o){o.active=false;free.push(o);}
  };
};
```

**js/audioManager.js**: Web Audio API synthesized sounds.
```js
Game.Audio = (function(){
  let ctx=null,master=null,enabled=true,vol=0.3;
  function ensure(){if(!ctx){ctx=new (window.AudioContext||window.webkitAudioContext)();master=ctx.createGain();master.gain.value=vol;master.connect(ctx.destination);} if(ctx.state==='suspended')ctx.resume();}
  function tone(freq,dur,type='square',gain=0.2){if(!enabled)return;ensure();const o=ctx.createOscillator(),g=ctx.createGain();o.type=type;o.frequency.value=freq;g.gain.setValueAtTime(gain,ctx.currentTime);g.gain.exponentialRampToValueAtTime(0.001,ctx.currentTime+dur);o.connect(g);g.connect(master);o.start();o.stop(ctx.currentTime+dur);}
  return{
    init(){ensure();},
    setVolume(v){vol=v;if(master)master.gain.value=v;},
    setEnabled(e){enabled=e;if(master)master.gain.value=e?vol:0;},
    launch(){tone(440,0.12,'square',0.15);},
    explosion(){tone(80,0.3,'sawtooth',0.25);tone(120,0.2,'square',0.15);},
    ffWarn(){tone(220,0.15,'square',0.2);},
    penalty(){tone(160,0.4,'sawtooth',0.25);},
    click(){tone(660,0.05,'square',0.1);},
    perfect(){tone(880,0.1,'triangle',0.2);tone(1320,0.15,'triangle',0.15);}
  };
})();
```

**js/entities/launcher.js**:
```js
Game.Launcher = function(x,y){
  this.x=x;this.y=y;this.vx=0;this.hp=100;this.cooldown=0;this.shake=0;
  this.width=32;this.height=32;
};
Game.Launcher.prototype.update=function(dt,input){
  const c=Game.Config;
  if(input.left)this.vx-=c.ACCEL;
  if(input.right)this.vx+=c.ACCEL;
  this.vx*=c.FRICTION;
  this.x+=this.vx;
  this.x=Game.Utils.clamp(this.x,this.width/2,c.WIDTH-this.width/2);
  if(this.shake>0)this.shake-=dt*60;
  if(this.cooldown>0)this.cooldown-=dt;
};
Game.Launcher.prototype.draw=function(ctx){
  const s=Math.max(0,this.shake);
  ctx.save();ctx.translate(this.x+(Math.random()-0.5)*s,this.y+(Math.random()-0.5)*s);
  // pixel launcher
  ctx.fillStyle='#FFD700';ctx.fillRect(-16,-16,32,32);
  ctx.strokeStyle='#000';ctx.lineWidth=2;ctx.strokeRect(-16,-16,32,32);
  ctx.fillStyle='#8B0000';ctx.fillRect(-6,-22,12,8); // missile port
  ctx.restore();
};
```

