;\n  text-shadow:3px 3px 0 var(--magenta),0 0 30px var(--cyan),0 0 60px var(--cyan);\n  animation:titlePulse 2.5s ease-in-out infinite;\n}\n@keyframes titlePulse{\n  0%,100%{text-shadow:3px 3px 0 var(--magenta),0 0 30px var(--cyan),0 0 60px var(--cyan)}\n  50%{text-shadow:3px 3px 0 var(--magenta),0 0 50px var(--magenta),0 0 90px var(--cyan)}\n}\n.subtitle{font-style:italic;font-size:18px;color:var(--magenta);letter-spacing:.4em;margin-top:8px;font-family:'Rajdhani'}\n.instructions{font-size:13px;color:var(--text);margin-top:36px;letter-spacing:.25em;opacity:.75;font-family:'Rajdhani'}\n.best-strip{font-size:16px;color:var(--yellow);margin-top:18px;letter-spacing:.2em}\n.pulse-btn{\n  margin-top:36px;\n  padding:14px 40px;\n  background:transparent;\n  border:2px solid var(--cyan);\n  color:var(--cyan);\n  font-family:'Orbitron',monospace;\n  font-size:16px;letter-spacing:.25em;font-weight:700;\n  cursor:pointer;\n  box-shadow:0 0 20px rgba(0,240,255,.5),inset 0 0 12px rgba(0,240,255,.2);\n  transition:transform .2s ease-out,box-shadow .2s ease-out,background .2s;\n  animation:pulseBtn 1s ease-in-out infinite;\n}\n@keyframes pulseBtn{\n  0%,100%{box-shadow:0 0 20px rgba(0,240,255,.5),inset 0 0 12px rgba(0,240,255,.2)}\n  50%{box-shadow:0 0 36px rgba(0,240,255,.9),inset 0 0 18px rgba(0,240,255,.4)}\n}\n.pulse-btn:hover{transform:scale(1.05);background:rgba(0,240,255,.12)}\n.death-title{\n  font-size:56px;color:var(--red);font-weight:900;letter-spacing:.2em;\n  text-shadow:0 0 30px var(--red),3px 3px 0 #6b0020;\n}\n.stats-card{\n  width:420px;max-width:90vw;\n  background:rgba(15,15,40,.85);border:1px solid var(--magenta);\n  border-radius:4px;padding:24px 32px;margin-top:20px;\n  box-shadow:0 0 24px rgba(255,0,170,.3);\n}\n.stat-row{\n  display:flex;justify-content:space-between;\n  padding:10px 0;border-bottom:1px solid rgba(0,240,255,.15);\n  font-size:18px;letter-spacing:.15em;\n}\n.stat-row:last-child{border-bottom:none}\n.stat-row span:first-child{color:var(--cyan)}\n.stat-row span:last-child{color:var(--magenta);font-weight:700}\n.leaderboard{\n  margin-top:28px;width:300px;max-width:90vw;\n  background:rgba(10,10,31,.75);border:1px solid var(--cyan);\n  border-radius:4px;padding:16px 24px;\n}\n.leaderboard h2{\n  font-size:14px;color:var(--cyan);letter-spacing:.3em;margin-bottom:12px;text-align:center;\n}\n.leaderboard ol{list-style:none;font-size:15px}\n.leaderboard li{\n  display:flex;justify-content:space-between;\n  padding:6px 0;border-bottom:1px solid rgba(0,240,255,.1);\n  letter-spacing:.1em;\n}\n.leaderboard li:last-child{border-bottom:none}\n.leaderboard li span:first-child{color:var(--magenta)}\n.leaderboard li span:last-child{color:var(--cyan)}\n.hidden{display:none!important}\n@media (max-width:720px){\n  #title{font-size:48px}\n  .death-title{font-size:36px}\n  #flux-time{font-size:24px}\n  #best-time{font-size:18px}\n  #speedrun-timer{top:80px;right:20px}\n}\n", "js/utils.js": "// Vector & math utilities + seeded RNG (Mulberry32)\nexport const TAU = Math.PI * 2;\n\nexport const clamp = (v, lo, hi) => Math.max(lo, Math.min(hi, v));\nexport const lerp = (a, b, t) => a + (b - a) * t;\nexport const rand = (a = 0, b = 1) => a + Math.random() * (b - a);\nexport const randInt = (a, b) => Math.floor(rand(a, b + 1));\nexport const dist2 = (ax, ay, bx, by) => { const dx = ax - bx, dy = ay - by; return dx * dx + dy * dy; };\nexport const dist = (ax, ay, bx, by) => Math.sqrt(dist2(ax, ay, bx, by));\n\nexport function angleBetween(ax, ay, bx, by) {\n  return Math.atan2(by - ay, bx - ax);\n}\n\nexport function normalize(x, y) {\n  const m = Math.hypot(x, y);\n  if (m < 1e-6) return { x: 0, y: 0 };\n  return { x: x / m, y: y / m };\n}\n\n// Mulberry32 seeded RNG\nexport function makeRng(seed = (Date.now() & 0xffffffff) >>> 0) {\n  let s = seed >>> 0;\n  return function () {\n    s |= 0;\n    s = (s + 0x6D2B79F5) | 0;\n    let t = Math.imul(s ^ (s >>> 15), 1 | s);\n    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;\n    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;\n  };\n}\n", "js/storage.js": "// LocalStorage wrapper for high-score persistence\nconst KEY = \"nexus_flux_scores_v1\";\nconst MAX = 10;\n\nexport function loadScores() {\n  try {\n    const raw = localStorage.getItem(KEY);\n    if (!raw) return [];\n    const arr = JSON.parse(raw);\n    return Array.isArray(arr) ? arr : [];\n  } catch (e) {\n    return [];\n  }\n}\n\nexport function saveScore(duration) {\n  const scores = loadScores();\n  const entry = {\n    score: Number(duration.toFixed(2)),\n    ts: Date.now(),\n    date: new Date().toISOString().slice(0, 10),\n  };\n  scores.push(entry);\n  scores.sort((a, b) => b.score - a.score);\n  const top = scores.slice(0, MAX);\n  try {\n    localStorage.setItem(KEY, JSON.stringify(top));\n  } catch (e) { /* quota */ }\n  return top;\n}\n\nexport function bestScore() {\n  const s = loadScores();\n  return s.length ? s[0].score : 0;\n}\n", "js/audio.js": "// Web Audio API simple sound effects - non-essential layer\nlet ctx = null;\nlet masterGain = null;\nlet muted = false;\n\nexport function initAudio() {\n  if (ctx) return;\n  try {\n    const AC = window.AudioContext || window.webkitAudioContext;\n    if (!AC) return;\n    ctx = new AC();\n    masterGain = ctx.createGain();\n    masterGain.gain.value = 0.35;\n    masterGain.connect(ctx.destination);\n  } catch (e) { /* ignore */ }\n}\n\nexport function resumeAudio() {\n  if (ctx && ctx.state === \"suspended\") ctx.resume();\n}\n\nexport function toggleMute() {\n  muted = !muted;\n  if (masterGain) masterGain.gain.value = muted ? 0 : 0.35;\n  return muted;\n}\n\nfunction blip(freq, dur, type = \"sine\", vol = 1, slide = 0) {\n  if (!ctx || muted) return;\n  const t = ctx.currentTime;\n  const o = ctx.createOscillator();\n  const g = ctx.createGain();\n  o.type = type;\n  o.frequency.setValueAtTime(freq, t);\n  if (slide) o.frequency.exponentialRampToValueAtTime(Math.max(20, freq + slide), t + dur);\n  g.gain.setValueAtTime(vol * 0.3, t);\n  g.gain.exponentialRampToValueAtTime(0.0001, t + dur);\n  o.connect(g); g.connect(masterGain);\n  o.start(t);\n  o.stop(t + dur + 0.02);\n}\n\nexport const sfx = {\n  nearMiss: () => blip(1200, 0.06, \"square\", 0.6),\n  death: () => blip(800, 0.8, \"sawtooth\", 0.8, -700),\n  milestone: () => {\n    if (!ctx || muted) return;\n    blip(523.25, 0.18, \"triangle\", 0.7);\n    setTimeout(() => blip(659.25, 0.18, \"triangle\", 0.7), 80);\n    setTimeout(() => blip(783.99, 0.3, \"triangle\", 0.7), 160);\n  },\n  start: () => blip(440, 0.1, \"square\", 0.5, 200),\n  hum: (intensity = 0.5) => {\n    // continuous low hum - throttled by caller\n    if (!ctx || muted) return;\n    const t = ctx.currentTime;\n    const o = ctx.createOscillator();\n    const g = ctx.createGain();\n    o.type = \"sine\";\n    o.frequency.value = 80;\n    g.gain.value = 0.04 * intensity;\n    o.connect(g); g.connect(masterGain);\n    o.start(t);\n    o.stop(t + 0.1);\n  },\n};\n", "js/particles.js": "// Particle manager with object pooling\nimport { TAU, rand } from \"./utils.js\";\n\nclass Particle {\n  constructor() { this.reset(); }\n  reset() {\n    this.x = 0; this.y = 0;\n    this.vx = 0; this.vy = 0;\n    this.life = 0; this.maxLife = 1;\n    this.size = 1; this.color = \"#fff\";\n    this.alive = false;\n  }\n}\n\nexport class ParticleSystem {\n  constructor(max = 800) {\n    this.pool = [];\n    for (let i = 0; i < max; i++) this.pool.push(new Particle());\n  }\n  spawn(p) {\n    const free = this.pool.find(p => !p.alive);\n    if (!free) return;\n    Object.assign(free, p);\n    free.alive = true;\n  }\n  burst(x, y, n = 40, opts = {}) {\n    for (let i = 0; i < n; i++) {\n      const a = (i / n) * TAU + rand(-0.1, 0.1);\n      const s = rand(opts.minSpeed || 80, opts.maxSpeed || 320);\n      this.spawn({\n        x, y,\n        vx: Math.cos(a) * s,\n        vy: Math.sin(a) * s,\n        life: 0, maxLife: opts.life || 1.2,\n        size: opts.size || rand(2, 5),\n        color: opts.color || \"#00f0ff\",\n      });\n    }\n  }\n  nearMissRing(x, y) {\n    this.spawn({\n      x, y, vx: 0, vy: 0,\n      life: 0, maxLife: 0.4,\n      size: 8, color: \"#00f0ff\",\n      ring: true,\n    });\n  }\n  update(dt) {\n    for (const p of this.pool) {\n      if (!p.alive) continue;\n      p.life += dt;\n      if (p.life >= p.maxLife) { p.alive = false; continue; }\n      p.x += p.vx * dt;\n      p.y += p.vy * dt;\n      if (!p.ring) {\n        p.vx *= 0.96;\n        p.vy *= 0.96;\n      }\n    }\n  }\n  draw(ctx) {\n    for (const p of this.pool) {\n      if (!p.alive) continue;\n      const t = p.life / p.maxLife;\n      const a = 1 - t;\n      if (p.ring) {\n        const r = 8 + t * 60;\n        ctx.beginPath();\n        ctx.arc(p.x, p.y, r, 0, TAU);\n        ctx.strokeStyle = `rgba(0,240,255,${a * 0.9})`;\n        ctx.lineWidth = 2;\n        ctx.stroke();\n      } else {\n        ctx.fillStyle = p.color;\n        ctx.globalAlpha = a;\n        ctx.beginPath();\n        ctx.arc(p.x, p.y, p.size * (1 - t * 0.5), 0, TAU);\n        ctx.fill();\n        ctx.globalAlpha = 1;\n      }\n    }\n  }\n}\n", "js/player.js": "// Player vessel - octahedron, 8-dir movement, trail, state\nimport { TAU, clamp, normalize, dist } from \"./utils.js\";\n\nexport class Player {\n  constructor(x, y) {\n    this.x = x; this.y = y;\n    this.r = 28;          // visual radius\n    this.hitR = 14;       // hitbox\n    this.speed = 420;\n    this.alive = true;\n    this.invulnerable = false;\n    this.invTimer = 0;\n    this.flickerT = 0;\n    this.angle = 0;\n    this.trail = [];\n    this.trailMax = 8;\n    this.boundsPad = 20;\n    this.vx = 0; this.vy = 0;\n    this.flash = 0;\n    this.bounds = { x: 0, y: 0, w: 1920, h: 1080 };\n    this.mouseAim = false;\n    this.mouseX = 0; this.mouseY = 0;\n  }\n  setBounds(x, y, w, h) {\n    this.bounds = { x, y, w, h };\n  }\n  reset(x, y) {\n    this.x = x; this.y = y;\n    this.vx = 0; this.vy = 0;\n    this.alive = true;\n    this.invulnerable = false;\n    this.invTimer = 0;\n    this.trail.length = 0;\n    this.flash = 0;\n  }\n  update(dt, input) {\n    if (!this.alive) return;\n    let dx = 0, dy = 0;\n    if (input.keys.has(\"KeyW\") || input.keys.has(\"ArrowUp\")) dy -= 1;\n    if (input.keys.has(\"KeyS\") || input.keys.has(\"ArrowDown\")) dy += 1;\n    if (input.keys.has(\"KeyA\") || input.keys.has(\"ArrowLeft\")) dx -= 1;\n    if (input.keys.has(\"KeyD\") || input.keys.has(\"ArrowRight\")) dx += 1;\n\n    if (this.mouseAim && (dx === 0 && dy === 0)) {\n      const mx = this.mouseX, my = this.mouseY;\n      const a = Math.atan2(my - this.y, mx - this.x);\n      dx = Math.cos(a); dy = Math.sin(a);\n    }\n\n    const n = normalize(dx, dy);\n    this.vx = n.x * this.speed;\n    this.vy = n.y * this.speed;\n    this.x += this.vx * dt;\n    this.y += this.vy * dt;\n\n    // clamp to bounds\n    const minX = this.bounds.x + this.boundsPad;\n    const maxX = this.bounds.x + this.bounds.w - this.boundsPad;\n    const minY = this.bounds.y + this.boundsPad;\n    const maxY = this.bounds.y + this.bounds.h - this.boundsPad;\n    if (this.x < minX) { this.x = minX; this.flash = 0.18; }\n    if (this.x > maxX) { this.x = maxX; this.flash = 0.18; }\n    if (this.y < minY) { this.y = minY; this.flash = 0.18; }\n    if (this.y > maxY) { this.y = maxY; this.flash = 0.18; }\n\n    // trail\n    this.angle += dt * 1.8;\n    this.trail.unshift({ x: this.x, y: this.y });\n    if (this.trail.length > this.trailMax) this.trail.pop();\n\n    // invuln flicker\n    if (this.invulnerable) {\n      this.invTimer -= dt;\n      this.flickerT += dt;\n      if (this.invTimer <= 0) this.invulnerable = false;\n    }\n    if (this.flash > 0) this.flash -= dt;\n  }\n  draw(ctx) {\n    // trail\n    for (let i = this.trail.length - 1; i >= 0; i--) {\n      const p = this.trail[i];\n      const a = (1 - i / this.trail.length) * 0.5;\n      ctx.fillStyle = `rgba(0,240,255,${a})`;\n      ctx.beginPath();\n      ctx.arc(p.x, p.y, this.r * (0.3 + 0.7 * (1 - i / this.trail.length)) * 0.5, 0, TAU);\n      ctx.fill();\n    }\n\n    // flash overlay\n    if (this.flash > 0) {\n      ctx.fillStyle = `rgba(255,34,68,${this.flash * 2})`;\n      ctx.fillRect(this.bounds.x, this.bounds.y, this.bounds.w, this.bounds.h);\n    }\n\n    let alpha = 1;\n    if (this.invulnerable) {\n      alpha = 0.3 + 0.7 * (0.5 + 0.5 * Math.sin(this.flickerT * 60));\n    }\n    ctx.save();\n    ctx.translate(this.x, this.y);\n    ctx.rotate(this.angle);\n    ctx.globalAlpha = alpha;\n\n    // aura\n    const grd = ctx.createRadialGradient(0, 0, 4, 0, 0, this.r * 1.4);\n    grd.addColorStop(0, \"rgba(0,240,255,0.6)\");\n    grd.addColorStop(1, \"rgba(0,240,255,0)\");\n    ctx.fillStyle = grd;\n    ctx.beginPath();\n    ctx.arc(0, 0, this.r * 1.4, 0, TAU);\n    ctx.fill();\n\n    // octahedron\n    ctx.beginPath();\n    const r = this.r;\n    ctx.moveTo(0, -r);\n    ctx.lineTo(r * 0.7, 0);\n    ctx.lineTo(0, r);\n    ctx.lineTo(-r * 0.7, 0);\n    ctx.closePath();\n    ctx.moveTo(r, 0);\n    ctx.lineTo(0, r * 0.7);\n    ctx.lineTo(-r, 0);\n    ctx.lineTo(0, -r * 0.7);\n    ctx.closePath();\n    ctx.fillStyle = \"#ffffff\";\n    ctx.shadowColor = \"#00f0ff\";\n    ctx.shadowBlur = 24;\n    ctx.fill();\n    ctx.shadowBlur = 0;\n    ctx.strokeStyle = \"#00f0ff\";\n    ctx.lineWidth = 2;\n    ctx.stroke();\n\n    // vertex particles\n    ctx.fillStyle = \"#00f0ff\";\n    const verts = [\n      [0, -r], [r * 0.7, 0], [0, r], [-r * 0.7, 0],\n      [r, 0], [0, r * 0.7], [-r, 0], [0, -r * 0.7]\n    ];\n    for (const v of verts) {\n      ctx.beginPath();\n      ctx.arc(v[0], v[1], 2.5, 0, TAU);\n      ctx.fill();\n    }\n\n    ctx.globalAlpha = 1;\n    ctx.restore();\n\n    // hitbox debug (subtle)\n    // ctx.strokeStyle = \"rgba(255,0,170,0.2)\";\n    // ctx.beginPath(); ctx.arc(this.x, this.y, this.hitR, 0, TAU); ctx.stroke();\n  }\n}\n", "js/obstacle.js": "// Obstacle classes - Shard, Pulse Orb, Tracker, Splitter\nimport { TAU, rand, dist, angleBetween } from \"./utils.js\";\n\nclass Base {\n  constructor(x, y, vx, vy, r, color) {\n    this.x = x; this.y = y;\n    this.vx = vx; this.vy = vy;\n    this.r = r; this.hitR = r * 0.8;\n    this.color = color;\n    this.alive = true;\n    this.age = 0;\n    this.rotation = rand(0, TAU);\n    this.rotSpeed = rand(-2, 2);\n    this.trail = [];\n  }\n  update(dt) {\n    this.age += dt;\n    this.x += this.vx * dt;\n    this.y += this.vy * dt;\n    this.rotation += this.rotSpeed * dt;\n    if (this.trail.length > 6) this.trail.pop();\n    this.trail.unshift({ x: this.x, y: this.y });\n  }\n  drawTrail(ctx) {\n    for (let i = this.trail.length - 1; i >= 0; i--) {\n      const t = this.trail[i];\n      const a = (1 - i / this.trail.length) * 0.35;\n      ctx.fillStyle = this.color.replace(\")\", `,${a})`).replace(\"rgb\", \"rgba\");\n      // fallback for hex\n      ctx.fillStyle = this.color + \"55\";\n      ctx.beginPath();\n      ctx.arc(t.x, t.y, this.r * 0.5 * (1 - i / this.trail.length), 0, TAU);\n      ctx.fill();\n    }\n  }\n}\n\nexport class Shard extends Base {\n  constructor(x, y, vx, vy) {\n    const r = rand(16, 22);\n    super(x, y, vx, vy, r, \"#ff00aa\");\n  }\n  draw(ctx) {\n    this.drawTrail(ctx);\n    ctx.save();\n    ctx.translate(this.x, this.y);\n    ctx.rotate(this.rotation);\n    ctx.beginPath();\n    const r = this.r;\n    ctx.moveTo(0, -r);\n    ctx.lineTo(r, r * 0.7);\n    ctx.lineTo(-r, r * 0.7);\n    ctx.closePath();\n    ctx.shadowColor = \"#ff00aa\"; ctx.shadowBlur = 16;\n    ctx.fillStyle = \"#ff00aa\";\n    ctx.fill();\n    ctx.shadowBlur = 0;\n    ctx.strokeStyle = \"#ffaaee\";\n    ctx.lineWidth = 1.5;\n    ctx.stroke();\n    ctx.restore();\n }
}

export class PulseOrb extends Base {
  constructor(x, y, vx, vy) {
    const r = rand(14, 20);
    super(x, y, vx, vy, r, "#ffcc00");
    this.pulseT = 0;
    this.baseR = r;
  }
  update(dt) {
    super.update(dt);
    this.pulseT += dt * 4;
  }
  draw(ctx) {
    const pulse = 1 + 0.3 * Math.sin(this.pulseT);
    const r = this.r * pulse;
    this.drawTrail(ctx);
    ctx.save();
    ctx.translate(this.x, this.y);
    ctx.beginPath();
    ctx.arc(0, 0, r, 0, TAU);
    ctx.shadowColor = "#ffcc00"; ctx.shadowBlur = 20;
    ctx.fillStyle = "#ffcc00";
    ctx.fill();
    ctx.shadowBlur = 0;
    ctx.strokeStyle = "#fff8e0";
    ctx.lineWidth = 2;
    ctx.stroke();
    // inner glow
    const grd = ctx.createRadialGradient(0, 0, 0, 0, 0, r);
    grd.addColorStop(0, "rgba(255,255,255,0.8)");
    grd.addColorStop(1, "rgba(255,204,0,0)");
    ctx.fillStyle = grd;
    ctx.beginPath();
    ctx.arc(0, 0, r * 0.6, 0, TAU);
    ctx.fill();
    ctx.restore();
  }
}

export class Tracker extends Base {
  constructor(x, y) {
    const r = 18;
    super(x, y, 0, 0, r, "#ff2244");
    this.speed = 160;
    this.accel = 120;
    this.target = null;
    this.seekTimer = 0;
  }
  setTarget(t) { this.target = t; }
  update(dt) {
    super.update(dt);
    this.seekTimer += dt;
    if (this.target && this.target.alive) {
      const dx = this.target.x - this.x;
      const dy = this.target.y - this.y;
      const d = Math.hypot(dx, dy);
      if (d > 1) {
        this.vx += (dx / d) * this.accel * dt;
        this.vy += (dy / d) * this.accel * dt;
        const spd = Math.hypot(this.vx, this.vy);
        if (spd > this.speed) {
          this.vx = (this.vx / spd) * this.speed;
          this.vy = (this.vy / spd) * this.speed;
        }
      }
    }
  }
  draw(ctx) {
    this.drawTrail(ctx);
    ctx.save();
    ctx.translate(this.x, this.y);
    ctx.rotate(this.rotation);
    // diamond shape
    ctx.beginPath();
    const r = this.r;
    ctx.moveTo(0, -r);
    ctx.lineTo(r * 0.6, 0);
    ctx.lineTo(0, r);
    ctx.lineTo(-r * 0.6, 0);
    ctx.closePath();
    ctx.shadowColor = "#ff2244"; ctx.shadowBlur = 18;
    ctx.fillStyle = "#ff2244";
    ctx.fill();
    ctx.shadowBlur = 0;
    ctx.strokeStyle = "#ff8899";
    ctx.lineWidth = 1.5;
    ctx.stroke();
    // center eye
    ctx.beginPath();
    ctx.arc(0, 0, 4, 0, TAU);
    ctx.fillStyle = "#fff";
    ctx.fill();
    ctx.restore();
  }
}

export class Splitter extends Base {
  constructor(x, y, vx, vy, tier = 1) {
    const r = 24 + tier * 4;
    super(x, y, vx, vy, r, "#aa44ff");
    this.tier = tier;
    this.splitAge = 2.5 + tier * 0.5;
    this.canSplit = tier < 2;
  }
  update(dt) {
    super.update(dt);
    this.splitAge -= dt;
  }
  shouldSplit() {
    return this.canSplit && this.splitAge <= 0;
  }
  draw(ctx) {
    this.drawTrail(ctx);
    ctx.save();
    ctx.translate(this.x, this.y);
    ctx.rotate(this.rotation);
    const r = this.r;
    // hex-ish shape
    ctx.beginPath();
    for (let i = 0; i < 6; i++) {
      const a = (i / 6) * TAU - Math.PI / 6;
      const px = Math.cos(a) * r;
      const py = Math.sin(a) * r;
      if (i === 0) ctx.moveTo(px, py);
      else ctx.lineTo(px, py);
    }
    ctx.closePath();
    ctx.shadowColor = "#aa44ff"; ctx.shadowBlur = 16;
    ctx.fillStyle = "#aa44ff";
    ctx.fill();
    ctx.shadowBlur = 0;
    ctx.strokeStyle = "#dd99ff";
    ctx.lineWidth = 2;
    ctx.stroke();
    // inner pattern
    ctx.beginPath();
    ctx.arc(0, 0, r * 0.4, 0, TAU);
    ctx.fillStyle = "#fff";
    ctx.globalAlpha = 0.5;
    ctx.fill();
    ctx.globalAlpha = 1;
    ctx.restore();
  }
}
", "js/spawner.js": "// Wave-based obstacle spawning with difficulty ramp\nimport { rand, randInt, makeRng } from \"./utils.js\";\nimport { Shard, PulseOrb, Tracker, Splitter } from \"./obstacle.js\";\n\nconst BOUNDS = { x: 0, y: 0, w: 1280, h: 720 };\n\nexport class Spawner {\n  constructor() {\n    this.wave = 0;\n    this.waveTimer = 0;\n    this.waveInterval = 4.5;\n    this.spawnTimer = 0;\n    this.spawnInterval = 0.6;\n    this.intensity = 1;\n    this.rng = makeRng(Date.now());\n    this.trackTimer = 0;\n  }\n  reset() {\n    this.wave = 0;\n    this.waveTimer = 0;\n    this.spawnTimer = 0;\n    this.intensity = 1;\n    this.trackTimer = 0;\n  }\n  update(dt, player, obstacles) {\n    const t = this;\n    t.waveTimer += dt;\n    t.spawnTimer += dt;\n    t.trackTimer += dt;\n\n    // wave ramp every 10s\n    t.intensity = 1 + Math.floor(t.waveTimer / 10) * 0.25;\n    t.spawnInterval = Math.max(0.18, 0.6 - t.intensity * 0.06);\n\n    if (t.spawnTimer >= t.spawnInterval) {\n      t.spawnTimer = 0;\n      t.spawnWave(player, obstacles);\n    }\n\n    // tracker spawn every 8s base\n    if (t.trackTimer >= 8 / t.intensity && obstacles) {\n      t.trackTimer = 0;\n      t.spawnTracker(player, obstacles);\n    }\n  }\n  spawnWave(player, obstacles) {\n    const count = Math.floor(1 + this.intensity * 1.5);\n    for (let i = 0; i < count; i++) {\n      const type = this.rng() * 10;\n      if (type < 4) this.spawnShard(player, obstacles);\n      else if (type < 7) this.spawnPulseOrb(player, obstacles);\n      else if (type < 9) this.spawnSplitter(player, obstacles);\n    }\n  }\n  spawnFromEdge(player, obstacles) {\n    const side = Math.floor(this.rng() * 4);\n    const margin = 60;\n    let x, y, vx, vy;\n    const speed = 180 + this.rng() * 220 * this.intensity;\n    switch (side) {\n      case 0: // top\n        x = rand(margin, BOUNDS.w - margin);\n        y = -margin;\n        vx = rand(-80, 80);\n        vy = speed;\n        break;\n      case 1: // right\n        x = BOUNDS.w + margin;\n        y = rand(margin, BOUNDS.h - margin);\n        vx = -speed;\n        vy = rand(-80, 80);\n        break;\n      case 2: // bottom\n        x = rand(margin, BOUNDS.w - margin);\n        y = BOUNDS.h + margin;\n        vx = rand(-80, 80);\n        vy = -speed;\n        break;\n      case 3: // left\n        x = -margin;\n        y = rand(margin, BOUNDS.h - margin);\n        vx = speed;\n        vy = rand(-80, 80);\n        break;\n    }\n    return { x, y, vx, vy };\n  }\n  spawnShard(player, obstacles) {\n    const { x, y, vx, vy } = this.spawnFromEdge(player);\n    obstacles.push(new Shard(x, y, vx, vy));\n  }\n  spawnPulseOrb(player, obstacles) {\n    const { x, y, vx, vy } = this.spawnFromEdge(player);\n    obstacles.push(new PulseOrb(x, y, vx, vy));\n  }\n  spawnSplitter(player, obstacles) {\n    const { x, y, vx, vy } = this.spawnFromEdge(player);\n    obstacles.push(new Splitter(x, y, vx, vy));\n  }\n  spawnTracker(player, obstacles) {\n    const margin = 50;\n    const side = Math.floor(this.rng() * 4);\n    let x, y;\n    switch (side) {\n      case 0: x = rand(margin, BOUNDS.w - margin); y = -margin; break;\n      case 1: x = BOUNDS.w + margin; y = rand(margin, BOUNDS.h - margin); break;\n      case 2: x = rand(margin, BOUNDS.w - margin); y = BOUNDS.h + margin; break;\n      case 3: x = -margin; y = rand(margin, BOUNDS.h - margin); break;\n    }\n    const t = new Tracker(x, y);\n    t.setTarget(player);\n    obstacles.push(t);\n  }\n}
", "js/game.js": "// Main game module - orchestrates all systems\nimport { TAU, dist, clamp, rand } from \"./utils.js\";\nimport { ParticleSystem } from \"./particles.js\";\nimport { Player } from \"./player.js\";\nimport { Spawner } from \"./spawner.js\";\nimport { loadScores, saveScore, bestScore } from \"./storage.js\";\nimport { initAudio, resumeAudio, sfx } from \"./audio.js\";\n\n// Canvas & context\nconst canvas = document.getElementById(\"game\");\nconst ctx = canvas.getContext(\"2d\");\nconst W = 1280, H = 720;\n\n// DOM elements\nconst hud = document.getElementById(\"hud\");\nconst titleScreen = document.getElementById(\"title-screen\");\nconst deathScreen = document.getElementById(\"death-screen\");\nconst pauseScreen = document.getElementById(\"pause-screen\");\nconst fluxTimeEl = document.getElementById(\"flux-time\");\nconst bestTimeEl = document.getElementById(\"best-time\");\nconst nearmissCountEl = document.getElementById(\"nearmiss-count\");\nconst titleBestEl = document.getElementById(\"title-best\");\nconst dDurationEl = document.getElementById(\"d-duration\");\nconst dBestEl = document.getElementById(\"d-best\");\nconst dNearmissEl = document.getElementById(\"d-nearmiss\");\nconst dMilestonesEl = document.getElementById(\"d-milestones\");\nconst leaderboardList = document.getElementById(\"leaderboard-list\");\nconst speedrunCanvas = document.getElementById(\"speedrun-timer\");\nconst speedrunCtx = speedrunCanvas.getContext(\"2d\");\nconst radarCanvas = document.getElementById(\"radar\");\nconst radarCtx = radarCanvas.getContext(\"2d\");\n\n// Game state\nconst STATE = { TITLE: 0, PLAYING: 1, DEAD: 2, PAUSED: 3 };\nlet state = STATE.TITLE;\nlet player, spawner, particles;\nlet obstacles = [];\nlet duration = 0;\nlet best = bestScore();\nlet nearmissCount = 0;\nlet milestones = 0;\nlet lastMilestone = 0;\nconst MILESTONE_INTERVAL = 10;\nlet nearMissCooldown = 0;\n\n// Input\nconst keys = new Set();\nlet mouseX = 0, mouseY = 0;\nlet mouseDown = false;\n\n// Timing\nlet lastTime = 0;\nlet rafId = null;\n\nfunction init() {\n  canvas.width = W;\n  canvas.height = H;\n  player = new Player(W / 2, H / 2);\n  player.setBounds(0, 0, W, H);\n  spawner = new Spawner();\n  particles = new ParticleSystem(800);\n  obstacles = [];\n  duration = 0;\n  nearmissCount = 0;\n  milestones = 0;\n  lastMilestone = 0;\n  nearMissCooldown = 0;\n  best = bestScore();\n  bestTimeEl.textContent = best.toFixed(2);\n  titleBestEl.textContent = best.toFixed(2);\n  nearmissCountEl.textContent = \"0\";\n  initAudio();\n  drawTitleLeaderboard();\n}\n\nfunction startGame() {\n  state = STATE.PLAYING;\n  player.reset(W / 2, H / 2);\n  spawner.reset();\n  particles = new ParticleSystem(800);\n  obstacles = [];\n  duration = 0;\n  nearmissCount = 0;\n  milestones = 0;\n  lastMilestone = 0;\n  nearmissCooldown = 0;\n  hud.classList.remove(\"hidden\");\n  titleScreen.classList.add(\"hidden\");\n  deathScreen.classList.add(\"hidden\");\n  pauseScreen.classList.add(\"hidden\");\n  nearmissCountEl.textContent = \"0\";\n  resumeAudio();\n  sfx.start();\n}\n\nfunction die() {\n  state = STATE.DEAD;\n  sfx.death();\n  particles.burst(player.x, player.y, 80, { minSpeed: 100, maxSpeed: 400, color: \"#00f0ff\" });\n  particles.burst(player.x, player.y, 40, { minSpeed: 80, maxSpeed: 300, color: \"#ff00aa\" });\n  player.alive = false;\n  hud.classList.add(\"hidden\");\n  setTimeout(() => {\n    deathScreen.classList.remove(\"hidden\");\n    dDurationEl.textContent = duration.toFixed(2) + \"s\";\n    dNearmissEl.textContent = nearmissCount;\n    dMilestonesEl.textContent = milestones;\n    const top = saveScore(duration);\n    dBestEl.textContent = (top[0] ? top[0].score : 0).toFixed(2) + \"s\";\n    renderLeaderboard(top);\n  }, 600);\n}\n\nfunction togglePause() {\n  if (state === STATE.PLAYING) {\n    state = STATE.PAUSED;\n    pauseScreen.classList.remove(\"hidden\");\n  } else if (state === STATE.PAUSED) {\n    state = STATE.PLAYING;\n    pauseScreen.classList.add(\"hidden\");\n    resumeAudio();\n    lastTime = performance.now();\n  }\n}\n\nfunction renderLeaderboard(scores) {\n  leaderboardList.innerHTML = \"\";\n  scores.slice(0, 5).forEach((s, i) => {\n    const li = document.createElement(\"li\");\n    li.innerHTML = `<span>#${i + 1}</span><span>${s.score.toFixed(2)}s</span>`;\n    leaderboardList.appendChild(li);\n  });\n}\n\nfunction drawTitleLeaderboard() {\n  const scores = loadScores();\n  renderLeaderboard(scores);\n}\n\nfunction update(dt) {\n  if (state !== STATE.PLAYING) return;\n\n  duration += dt;\n  fluxTimeEl.textContent = duration.toFixed(2);\n\n  // milestones\n  const milestone = Math.floor(duration / MILESTONE_INTERVAL);\n  if (milestone > lastMilestone) {\n    lastMilestone = milestone;\n    milestones++;\n    sfx.milestone();\n  }\n\n  // near miss cooldown\n  if (nearMissCooldown > 0) nearMissCooldown -= dt;\n\n  player.update(dt, { keys, mouseX, mouseY });\n  spawner.update(dt, player, obstacles);\n\n  // update obstacles\n  for (let i = obstacles.length - 1; i >= 0; i--) {\n    const o = obstacles[i];\n    o.update(dt);\n    if (o instanceof Tracker) o.setTarget(player);\n\n    // splitter check\n    if (o.shouldSplit && o.shouldSplit()) {\n      const angle1 = rand(0, TAU);\n      const angle2 = angle1 + Math.PI * 0.7 + rand(-0.3, 0.3);\n      const spd = 200 + rand(0, 100);\n      obstacles.push(new Splitter(o.x, o.y, Math.cos(angle1) * spd, Math.sin(angle1) * spd, o.tier + 1));\n      obstacles.push(new Splitter(o.x, o.y, Math.cos(angle2) * spd, Math.sin(angle2) * spd, o.tier + 1));\n      o.alive = false;\n      particles.burst(o.x, o.y, 20, { color: \"#aa44ff\" });\n    }\n\n    // cull off-screen\n    if (o.x < -200 || o.x > W + 200 || o.y < -200 || o.y > H + 200) {\n      o.alive = false;\n    }\n\n    // collision\n    if (player.alive && !player.invulnerable) {\n      const d = dist(player.x, player.y, o.x, o.y);\n      if (d < player.hitR + o.hitR) {\n        die();\n        return;\n      }\n      // near miss\n      const nearDist = player.hitR + o.hitR + 28;\n      if (d < nearDist && nearMissCooldown <= 0 && o.alive) {\n        nearmissCount++;\n        nearMissCooldown = 0.3;\n        nearmissCountEl.textContent = nearmissCount;\n        sfx.nearMiss();\n        particles.nearMissRing(player.x, player.y);\n      }\n    }\n\n    if (!o.alive) {\n      obstacles.splice(i, 1);\n    }\n  }\n\n  particles.update(dt);\n}\n\nfunction drawGrid() {\n  const gridSize = 60;\n  ctx.strokeStyle = \"rgba(26,26,58,0.8)\";\n  ctx.lineWidth = 1;\n  for (let x = 0; x <= W; x += gridSize) {\n    ctx.beginPath();\n    ctx.moveTo(x, 0);\n    ctx.lineTo(x, H);\n    ctx.stroke();\n  }\n  for (let y = 0; y <= H; y += gridSize) {\n    ctx.beginPath();\n    ctx.moveTo(0, y);\n    ctx.lineTo(W, y);\n    ctx.stroke();\n  }\n}\n\nfunction drawRadar() {\n  const r = 40;\n  radarCtx.clearRect(0, 0, 80, 80);\n  radarCtx.strokeStyle = \"rgba(0,240,255,0.2)\";\n  radarCtx.lineWidth = 1;\n  radarCtx.beginPath();\n  radarCtx.arc(40, 40, r, 0, TAU);\n  radarCtx.stroke();\n  radarCtx.beginPath();\n  radarCtx.arc(40, 40, r * 0.5, 0, TAU);\n  radarCtx.stroke();\n  radarCtx.strokeStyle = \"rgba(0,240,255,0.1)\";\n  radarCtx.beginPath();\n  radarCtx.moveTo(40, 0);\n  radarCtx.lineTo(40, 80);\n  radarCtx.moveTo(0, 40);\n  radarCtx.lineTo(80, 40);\n  radarCtx.stroke();\n\n  // player dot\n  radarCtx.fillStyle = \"#00f0ff\";\n  radarCtx.beginPath();\n  radarCtx.arc(40, 40, 3, 0, TAU);\n  radarCtx.fill();\n\n  // obstacle dots\n  for (const o of obstacles) {\n    const dx = (o.x - player.x) / W * r * 2.5;\n    const dy = (o.y - player.y) / H * r * 2.5;\n    const ox = 40 + dx;\n    const oy = 40 + dy;\n    const d = Math.hypot(ox - 40, oy - 40);\n    if (d < r - 2) {\n      radarCtx.fillStyle = o.color;\n      radarCtx.beginPath();\n      radarCtx.arc(ox, oy, 2, 0, TAU);\n      radarCtx.fill();\n    }\n  }\n}\n\nfunction drawSpeedrunTimer() {\n  speedrunCtx.clearRect(0, 0, 160, 40);\n  speedrunCtx.font = \"16px Orbitron, monospace\";\n  speedrunCtx.fillStyle = \"#ff00aa\";\n  speedrunCtx.textAlign = \"center\";\n  speedrunCtx.fillText(\"TIME\", 80, 16);\n  speedrunCtx.fillStyle = \"#00f0ff\";\n  speedrunCtx.font = \"18px Orbitron, monospace\";\n  speedrunCtx.fillText(duration.toFixed(2) + \"s\", 80, 36);\n}\n\nfunction draw() {\n  ctx.fillStyle = \"#0a0a1f\";\n  ctx.fillRect(0, 0, W, H);\n  drawGrid();\n\n  for (const o of obstacles) {\n    o.draw(ctx);\n  }\n\n  if (player.alive) player.draw(ctx);\n  particles.draw(ctx);\n\n  if (state === STATE.PLAYING) {\n    drawRadar();\n    drawSpeedrunTimer();\n  }\n}\n\nfunction loop(ts) {\n  rafId = requestAnimationFrame(loop);\n  const dt = Math.min((ts - lastTime) / 1000, 0.05);\n  lastTime = ts;\n  update(dt);\n  draw();\n}\n\nfunction onKeyDown(e) {\n  keys.add(e.code);\n  if (e.code === \"Space\") {\n    if (state === STATE.TITLE || state === STATE.DEAD) {\n      startGame();\n    }\n  }\n  if (e.code === \"Escape\") {\n    if (state === STATE.PLAYING || state === STATE.PAUSED) {\n      togglePause();\n    }\n  }\n  if (e.code === \"ShiftLeft\" || e.code === \"ShiftRight\") {\n    player.mouseAim = true;\n  }\n}\n\nfunction onKeyUp(e) {\n  keys.delete(e.code);\n  if (e.code === \"ShiftLeft\" || e.code === \"ShiftRight\") {\n    player.mouseAim = false;\n  }\n}\n\nfunction onMouseMove(e) {\n  const rect = canvas.getBoundingClientRect();\n  const scaleX = W / rect.width;\n  const scaleY = H / rect.height;\n  mouseX = (e.clientX - rect.left) * scaleX;\n  mouseY = (e.clientY - rect.top) * scaleY;\n  player.mouseX = mouseX;\n  player.mouseY = mouseY;\n}\n\nfunction onTouchStart(e) {\n  e.preventDefault();\n  const t = e.touches[0];\n  mouseX = (t.clientX / window.innerWidth) * W;\n  mouseY = (t.clientY / window.innerHeight) * H;\n  player.mouseX = mouseX;\n  player.mouseY = mouseY;\n  if (state === STATE.TITLE || state === STATE.DEAD) startGame();\n}\n\nfunction onTouchMove(e) {\n  e.preventDefault();\n  const t = e.touches[0];\n  mouseX = (t.clientX / window.innerWidth) * W;\n  mouseY = (t.clientY / window.innerHeight) * H;\n  player.mouseX = mouseX;\n  player.mouseY = mouseY;\n}\n\n// Event listeners\nwindow.addEventListener(\"keydown\", onKeyDown);\nwindow.addEventListener(\"keyup\", onKeyUp);\ncanvas.addEventListener(\"mousemove\", onMouseMove);\ncanvas.addEventListener(\"touchstart\", onTouchStart, { passive: false });\ncanvas.addEventListener(\"touchmove\", onTouchMove, { passive: false });\ndocument.getElementById(\"btn-start\")?.addEventListener(\"click\", startGame);\ndocument.getElementById(\"btn-retry\")?.addEventListener(\"click\", startGame);\n\n// Responsive canvas\nfunction resizeCanvas() {\n  const scale = Math.min(window.innerWidth / W, window.innerHeight / H);\n  canvas.style.width = W * scale + \"px\";\n  canvas.style.height = H * scale + \"px\";\n}\nwindow.addEventListener(\"resize\", resizeCanvas);\n\n// Boot\ninit();\nresizeCanvas();\nlastTime = performance.now();\nrafId = requestAnimationFrame(loop);\n}