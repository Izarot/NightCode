        this.state = 'MENU';
        this.score = 0;
        this.lives = 3;
        this.level = 1;
        this.timer = 0;
        this.bricks = [];
        this.particles = [];
        this.ball = null;
        this.paddle = null;
        this.input = { left: false, right: false };
        this.lastTime = 0;
        this.highScore = parseInt(localStorage.getItem('neonAngleHighScore') || '0', 10);
        this.setupCanvas();
        this.setupInput();
        this.setupUI();
    }
    
    setupCanvas() {
        this.resize();
        window.addEventListener('resize', () => this.resize());
    }
    
    {"index.html":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no\">\n<title>NEON ANGLE</title>\n<link rel=\"icon\" href=\"data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🎯</text></svg>\">\n<link rel=\"stylesheet\" href=\"style.css\">\n</head>\n<body>\n<div id=\"game-container\">\n  <canvas id=\"game-canvas\"></canvas>\n  <div id=\"hud\">\n    <div id=\"score-display\">SCORE 0</div>\n    <div id=\"lives-display\"></div>\n    <div id=\"level-display\">LEVEL 1</div>\n    <div id=\"timer-display\">TIME 0.00</div>\n    <div id=\"angle-indicator\"><canvas id=\"angle-gauge\" width=\"140\" height=\"140\"></canvas></div>\n  </div>\n  <div id=\"pause-menu\" class=\"overlay hidden\">\n    <div class=\"modal\">\n      <h1>PAUSED</h1>\n      <button class=\"btn\" data-action=\"resume\">RESUME</button>\n      <button class=\"btn\" data-action=\"restart\">RESTART</button>\n      <button class=\"btn\" data-action=\"menu\">MAIN MENU</button>\n    </div>\n  </div>\n  <div id=\"start-screen\" class=\"overlay\">\n    <div class=\"modal\">\n      <h1>NEON ANGLE</h1>\n      <p class=\"subtitle\">Aim precise. Strike devastating.</p>\n      <button class=\"btn btn-primary\" data-action=\"start\">PRESS TO START</button>\n      <p class=\"hint\">Arrows / WASD to move · Space to launch</p>\n    </div>\n  </div>\n  <div id=\"game-over-screen\" class=\"overlay hidden\">\n    <div class=\"modal\">\n      <h1>GAME OVER</h1>\n      <p id=\"final-score\">SCORE 0</p>\n      <p id=\"best-score\">BEST 0</p>\n      <button class=\"btn btn-primary\" data-action=\"restart\">PLAY AGAIN</button>\n      <button class=\"btn\" data-action=\"menu\">MAIN MENU</button>\n    </div>\n  </div>\n  <div id=\"level-complete-screen\" class=\"overlay hidden\">\n    <div class=\"modal\">\n      <h1>LEVEL CLEAR</h1>\n      <p id=\"level-time\">TIME 0.00</p>\n      <button class=\"btn btn-primary\" data-action=\"next\">NEXT LEVEL</button>\n    </div>\n  </div>\n</div>\n<script src=\"js/audio.js\"></script>\n<script src=\"js/entities/Ball.js\"></script>\n<script src=\"js/entities/Paddle.js\"></script>\n<script src=\"js/entities/Brick.js\"></script>\n<script src=\"js/systems/Physics.js\"></script>\n<script src=\"js/systems/Collision.js\"></script>\n<script src=\"js/ui/HUD.js\"></script>\n<script src=\"js/ui/PauseMenu.js\"></script>\n<script src=\"js/game.js\"></script>\n<script src=\"js/main.js\"></script>\n</body>\n</html>",
"style.css":"* { margin: 0; padding: 0; box-sizing: border-box; }\nhtml, body { width: 100%; height: 100%; overflow: hidden; background: #050510; font-family: 'Courier New', monospace; }\n#game-container {\n  position: relative;\n  width: 100vw;\n  height: 100vh;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\n#game-canvas {\n  display: block;\n  background: #050510;\n  image-rendering: crisp-edges;\n  touch-action: none;\n}\n#hud {\n  position: absolute;\n  top: 0;\n  left: 0;\n  width: 100%;\n  pointer-events: none;\n  z-index: 10;\n  padding: 8px 12px;\n  display: flex;\n  justify-content: space-between;\n  align-items: flex-start;\n  gap: 12px;\n}\n#score-display, #level-display, #timer-display {\n  font-size: 16px;\n  font-weight: bold;\n  color: #00f3ff;\n  text-shadow: 0 0 8px rgba(0, 243, 255, 0.7);\n  letter-spacing: 1px;\n  white-space: nowrap;\n}\n#lives-display {\n  font-size: 16px;\n  color: #ff00e5;\n  text-shadow: 0 0 8px rgba(255, 0, 229, 0.7);\n  letter-spacing: 1px;\n}\n#angle-indicator {\n  position: relative;\n  width: 140px;\n  height: 140px;\n  align-self: center;\n  margin-top: -60px;\n}\n#angle-gauge {\n  position: absolute;\n  top: 0;\n  left: 50%;\n  transform: translateX(-50%);\n  border-radius: 50%;\n  border: 2px solid rgba(0, 243, 255, 0.4);\n  background: rgba(0, 243, 255, 0.05);\n}\n.overlay {\n  position: absolute;\n  inset: 0;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  background: rgba(5, 5, 16, 0.85);\n  backdrop-filter: blur(4px);\n  z-index: 20;\n}\n.overlay.hidden { display: none; }\n.modal {\n  text-align: center;\n  padding: 40px 50px;\n  border: 2px solid rgba(0, 243, 255, 0.5);\n  border-radius: 16px;\n  background: rgba(10, 10, 30, 0.9);\n  box-shadow: 0 0 40px rgba(0, 243, 255, 0.2), inset 0 0 30px rgba(0, 243, 255, 0.05);\n  max-width: 90vw;\n}\n.modal h1 {\n  font-size: 42px;\n  color: #00f3ff;\n  text-shadow: 0 0 20px rgba(0, 243, 255, 0.8), 0 0 40px rgba(0, 243, 255, 0.4);\n  letter-spacing: 3px;\n  margin-bottom: 12px;\n}\n.subtitle {\n  color: #ff00e5;\n  font-size: 16px;\n  margin-bottom: 24px;\n  text-shadow: 0 0 10px rgba(255, 0, 229, 0.6);\n}\n.hint {\n  color: rgba(255, 255, 255, 0.4);\n  font-size: 12px;\n  margin-top: 20px;\n}\n.btn {\n  display: inline-block;\n  padding: 12px 32px;\n  margin: 8px;\n  font-size: 16px;\n  font-weight: bold;\n  font-family: 'Courier New', monospace;\n  color: #00f3ff;\n  background: transparent;\n  border: 2px solid #00f3ff;\n  border-radius: 8px;\n  cursor: pointer;\n  letter-spacing: 2px;\n  transition: all 0.2s ease;\n  text-transform: uppercase;\n}\n.btn:hover {\n  background: rgba(0, 243, 255, 0.15);\n  box-shadow: 0 0 20px rgba(0, 243, 255, 0.5);\n  transform: scale(1.05);\n}\n.btn-primary {\n  color: #ffffff;\n  border-color: #00f3ff;\n  font-size: 18px;\n  padding: 14px 40px;\n}\n.btn-primary:hover {\n  background: rgba(0, 243, 255, 0.3);\n  box-shadow: 0 0 30px rgba(0, 243, 255, 0.7);\n}\n@media (max-width: 600px) {\n  .modal h1 { font-size: 30px; }\n  .modal { padding: 30px 30px; }\n  #score-display, #level-display, #timer-display { font-size: 13px; }\n  #angle-indicator { width: 100px; height: 100px; }\n  #angle-gauge { width: 100px; height: 100px; }\n}",
"js/audio.js":"const AudioFX = {\n  ctx: null,\n  masterGain: null,\n  enabled: true,\n  init() {\n    try {\n      this.ctx = new (window.AudioContext || window.webkitAudioContext)();\n      this.masterGain = this.ctx.createGain();\n      this.masterGain.gain.value = 0.25;\n      this.masterGain.connect(this.ctx.destination);\n    } catch (e) {\n      this.enabled = false;\n    }\n  },\n  resume() {\n    if (this.ctx && this.ctx.state === 'suspended') {\n      this.ctx.resume();\n    }\n  },\n  playTone(freq, duration, type, volume) {\n    type = type || 'square';\n    volume = volume || 0.3;\n    if (!this.enabled || !this.ctx) return;\n    const osc = this.ctx.createOscillator();\n    const gain = this.ctx.createGain();\n    osc.type = type;\n    osc.frequency.value = freq;\n    gain.gain.setValueAtTime(volume, this.ctx.currentTime);\n    gain.gain.exponentialRampToValueAtTime(0.001, this.ctx.currentTime + duration);\n    osc.connect(gain);\n    gain.connect(this.masterGain);\n    osc.start();\n    osc.stop(this.ctx.currentTime + duration);\n  },\n  hit() { this.playTone(220, 0.06, 'square', 0.15); },\n  hitHard() { this.playTone(140, 0.12, 'sawtooth', 0.2); },\n  destroy() { this.playTone(80, 0.18, 'sawtooth', 0.25); },\n  launch() { this.playTone(440, 0.08, 'triangle', 0.15); },\n  wall() { this.playTone(330, 0.04, 'sine', 0.1); },\n  bonus() { this.playTone(880, 0.1, 'triangle', 0.2); },\n  loseLife() { this.playTone(110, 0.35, 'sawtooth', 0.25); },\n  levelClear() {\n    this.playTone(523, 0.12, 'triangle', 0.2);\n    setTimeout(() => this.playTone(659, 0.12, 'triangle', 0.2), 120);\n    setTimeout(() => this.playTone(784, 0.25, 'triangle', 0.2), 240);\n  },\n  gameOver() {\n    this.playTone(220, 0.2, 'sawtooth', 0.2);\n    setTimeout(() => this.playTone(165, 0.3, 'sawtooth', 0.2), 200);\n    setTimeout(() => this.playTone(110, 0.5, 'sawtooth', 0.2), 450);\n  }\n};",
"js/entities/Ball.js":"class Ball {\n  constructor(x, y, radius) {\n    this.pos = { x: x, y: y };\n    this.vel = { x: 0, y: 0 };\n    this.radius = radius;\n    this.trail = [];\n    this.maxTrail = 14;\n    this.spin = 0;\n    this.active = false;\n    this.glowPhase = 0;\n  }\n  launch(angleDeg, power) {\n    const angle = angleDeg * Math.PI / 180;\n    this.vel.x = Math.cos(angle) * power;\n    this.vel.y = Math.sin(angle) * power;\n    this.spin = this.vel.x * 0.01;\n    this.active = true;\n  }\n  update(dt) {\n    if (!this.active) return;\n    this.glowPhase += dt * 8;\n    const speed = Math.hypot(this.vel.x, this.vel.y);\n    const steps = Math.max(1, Math.ceil(speed * dt / (this.radius * 0.4)));\n    const sdt = dt / steps;\n    for (let i = 0; i < steps; i++) {\n      this.pos.x += this.vel.x * sdt;\n      this.pos.y += this.vel.y * sdt;\n    }\n    this.trail.push({ x: this.pos.x, y: this.pos.y });\n    if (this.trail.length > this.maxTrail) this.trail.shift();\n    this.spin *= 0.97;\n  }\n  draw(ctx) {\n    // Trail\n    for (let i = 0; i < this.trail.length; i++) {\n      const t = this.trail[i];\n      const ratio = i / this.trail.length;\n      const alpha = ratio * 0.5;\n      ctx.fillStyle = 'rgba(0, 243, 255, ' + alpha + ')';\n      ctx.beginPath();\n      ctx.arc(t.x, t.y, this.radius * ratio * 0.9, 0, Math.PI * 2);\n      ctx.fill();\n    }\n    // Glow\n    const glowSize = this.radius * (1.5 + Math.sin(this.glowPhase) * 0.15);\n    const grad = ctx.createRadialGradient(this.pos.x, this.pos.y, 0, this.pos.x, this.pos.y, glowSize);\n    grad.addColorStop(0, 'rgba(0, 243, 255, 1)');\n    grad.addColorStop(0.4, 'rgba(0, 243, 255, 0.4)');\n    grad.addColorStop(1, 'rgba(0, 243, 255, 0)');\n    ctx.fillStyle = grad;\n    ctx.beginPath();\n    ctx.arc(this.pos.x, this.pos.y, glowSize, 0, Math.PI * 2);\n    ctx.fill();\n    // Core\n    ctx.fillStyle = '#ffffff';\n    ctx.beginPath();\n    ctx.arc(this.pos.x, this.pos.y, this.radius, 0, Math.PI * 2);\n    ctx.fill();\n  }\n}",
"js/entities/Paddle.js":"class Paddle {\n  constructor(x, y, width, height) {\n    this.pos = { x: x, y: y };\n    this.width = width;\n    this.height = height;\n    this.accel = 1400;\n    this.friction = 0.82;\n    this.vx = 0;\n    this.vMax = 520;\n    this.pulse = 0;\n    this.glowIntensity = 0;\n  }\n  update(dt, input, bounds) {\n    let ax = 0;\n    if (input.left) ax -= this.accel;\n    if (input.right) ax += this.accel;\n    this.vx += ax * dt;\n    this.vx *= Math.pow(this.friction, dt * 60);\n    this.vx = Math.max(-this.vMax, Math.min(this.vMax, this.vx));\n    this.pos.x += this.vx * dt;\n    if (this.pos.x < this.width / 2) {\n      this.pos.x = this.width / 2;\n      this.vx *= -0.5;\n    }\n    if (this.pos.x > bounds.w - this.width / 2) {\n      this.pos.x = bounds.w - this.width / 2;\n      this.vx *= -0.5;\n    }\n    this.pulse += dt * 5;\n    this.glowIntensity = 0.5 + Math.sin(this.pulse) * 0.2;\n  }\n  draw(ctx) {\n    const w = this.width, h = this.height;\n    const x = this.pos.x, y = this.pos.y;\n    ctx.save();\n    ctx.shadowColor = '#00f3ff';\n    ctx.shadowBlur = 20 * this.glowIntensity;\n    const grad = ctx.createLinearGradient(x - w / 2, y, x + w / 2, y);\n    grad.addColorStop(0, 'rgba(0, 243, 255, 0.2)');\n    grad.addColorStop(0.5, 'rgba(0, 243, 255, 0.95)');\n    grad.addColorStop(1, 'rgba(0, 243, 255, 0.2)');\n    ctx.fillStyle = grad;\n    ctx.beginPath();\n    ctx.moveTo(x - w / 2, y);\n    ctx.lineTo(x + w / 2, y);\n    ctx.lineTo(x + w / 2 * 0.65, y - h);\n    ctx.lineTo(x - w / 2 * 0.65, y - h);\n    ctx.closePath();\n    ctx.fill();\n    ctx.strokeStyle = '#00f3ff';\n    ctx.lineWidth = 2;\n    ctx.stroke();\n    ctx.restore();\n  }\n}",
"js/entities/Brick.js":"class Brick {\n  constructor(x, y, w, h, hp, tier, color) {\n    this.pos = { x: x, y: y };\n    this.w = w;\n    this.h = h;\n    this.hp = hp;\n    this.maxHp = hp;\n    this.tier = tier;\n    this.color = color;\n    this.alive = true;\n    this.flashTimer = 0;\n    this.shakeTimer = 0;\n  }\n  get centerX() { return this.pos.x + this.w / 2; }\n  get centerY() { return this.pos.y + this.h / 2; }\n  takeDamage(amount) {\n    this.hp -= amount;\n    this.flashTimer = 0.12;\n    this.shakeTimer = 0.1;\n    if (this.hp <= 0) this.alive = false;\n  }\n  update(dt) {\n    if (this.flashTimer > 0) this.flashTimer -= dt;\n    if (this.shakeTimer > 0) this.shakeTimer -= dt;\n  }\n  draw(ctx) {\n    if (!this.alive) return;\n    const shakeX = this.shakeTimer > 0 ? (Math.random() - 0.5) * 3 : 0;\n    const shakeY = this.shakeTimer > 0 ? (Math.random() - 0.5) * 3 : 0;\n    const x = this.pos.x + shakeX, y = this.pos.y + shakeY;\n    const alpha = this.flashTimer > 0 ? 1 : 0.88;\n    const strokeAlpha = this.flashTimer > 0 ? 1 : 0.9;\n    const grad = ctx.createLinearGradient(x, y, x, y + this.h);\n    grad.addColorStop(0, this.color.top);\n    grad.addColorStop(1, this.color.bottom);\n    ctx.globalAlpha = alpha;\n    ctx.fillStyle = grad;\n    ctx.fillRect(x, y, this.w, this.h);\n    ctx.globalAlpha = strokeAlpha;\n    ctx.strokeStyle = this.color.stroke;\n    ctx.lineWidth = 2;\n    ctx.strokeRect(x, y, this.w, this.h);\n    if (this.hp < this.maxHp) {\n      ctx.globalAlpha = 0.7;\n      ctx.fillStyle = '#ffffff';\n      ctx.font = 'bold 13px Courier New';\n      ctx.textAlign = 'center';\n      ctx.textBaseline = 'middle';\n      ctx.fillText(this.hp, this.centerX, this.centerY);\n    }\n    ctx.globalAlpha = 1;\n  }\n}",
"js/systems/Physics.js":"const Physics = {\n  clamp(val, min, max) {\n    return Math.max(min, Math.min(max, val));\n  },\n  lerp(a, b, t) {\n    return a + (b - a) * t;\n  },\n  normalize(x, y) {\n    const len = Math.hypot(x, y);\n    if (len === 0) return { x: 0, y: 0 };\n    return { x: x / len, y: y / len };\n  },\n  substep(pos, vel, dt, steps) {\n    const sdt = dt / steps;\n    for (let i = 0; i < steps; i++) {\n      pos.x += vel.x * sdt;\n      pos.y += vel.y * sdt;\n    }\n  }\n};",
"js/systems/Collision.js":"const Collision = {\n  circleRect(cx, cy, cr, rx, ry, rw, rh) {\n    const closestX = Math.max(rx, Math.min(cx, rx + rw));\n    const closestY = Math.max(ry, Math.min(cy, ry + rh));\n    const dx = cx - closestX;\n    const dy = cy - closestY;\n    const distSq = dx * dx + dy * dy;\n    if (distSq < cr * cr) {\n      const dist = Math.sqrt(distSq) || 0.001;\n      return {\n        hit: true,\n        nx: dx / dist,\n        ny: dy / dist,\n        penetration: cr - dist,\n        closestX: closestX,\n        closestY: closestY\n      };\n    }\n    return { hit: false };\n  },\n  resolveBallBrick(ball, brick) {\n    const result = this.circleRect(\n      ball.pos.x, ball.pos.y, ball.radius,\n      brick.pos.x, brick.pos.y, brick.w, brick.h\n    );\n    if (!result.hit) return null;\n    const cx = result.closestX;\n    const cy = result.closestY;\n    let nx = ball.pos.x - cx;\n    let ny = ball.pos.y - cy;\n    const nlen = Math.hypot(nx, ny) || 1;\n    nx /= nlen;\n    ny /= nlen;\n    const dot = ball.vel.x * nx + ball.vel.y * ny;\n    const deviation = Math.acos(Math.max(-1, Math.min(1, dot))) * 180 / Math.PI;\n    let damage;\n    if (deviation < 45) {\n      damage = 1;\n    } else {\n      damage = Math.min(3, brick.tier);\n    }\n    const reflectDot = ball.vel.x * nx + ball.vel.y * ny;\n    ball.vel.x -= 2 * reflectDot * nx;\n    ball.vel.y -= 2 * reflectDot * ny;\n    ball.vel.x *= 0.82;\n    ball.vel.y *= 0.82;\n    ball.pos.x = cx + nx * ball.radius;\n    ball.pos.y = cy + ny * ball.radius;\n    return { hit: true, nx: nx, ny: ny, deviation: deviation, damage: damage };\n  },\n  resolveWall(ball, bounds) {\n    let hit = false;\n    let nx = 0, ny = 0;\n    if (ball.pos.x - ball.radius < 0) {\n      nx = 1; ny = 0;\n      ball.pos.x = ball.radius;\n      hit = true;\n    } else if (ball.pos.x + ball.radius > bounds.w) {\n      nx = -1; ny = 0;\n      ball.pos.x = bounds.w - ball.radius;\n      hit = true;\n    }\n    if (ball.pos.y - ball.radius < 0) {\n      nx = 0; ny = 1;\n      ball.pos.y = ball.radius;\n      hit = true;\n    } else if (ball.pos.y + ball.radius > bounds.h) {\n      nx = 0; ny = -1;\n      ball.pos.y = bounds.h - ball.radius;\n      hit = true;\n    }\n    if (hit) {\n      const reflectDot = ball.vel.x * nx + ball.vel.y * ny;\n      ball.vel.x -= 2 * reflectDot * nx;\n      ball.vel.y -= 2 * reflectDot * ny;\n      ball.vel.x *= 0.9;\n      ball.vel.y *= 0.9;\n      return { hit: true, nx: nx, ny: ny };\n    }\n    return { hit: false };\n  }\n};",
"js/ui/HUD.js":"class HUD {\n  constructor(canvas, gaugeCanvas) {\n    this.canvas = canvas;\n    this.ctx = canvas.getContext('2d');\n    this.gaugeCanvas = gaugeCanvas;\n    this.gctx = gaugeCanvas.getContext('2d');\n    this.score = 0;\n    this.lives = 3;\n    this.level = 1;\n    this.timer = 0;\n    this.angle = 0;\n    this.particles = [];\n  }\n  setScore(s) { this.score = s; }\n  setLives(l) { this.lives = l; }\n  setLevel(l) { this.level = l; }\n  setTimer(t) { this.timer = t; }\n  setAngle(a) { this.angle = a; }\n  addParticle(p) { this.particles.push(p); }\n  updateParticles(dt) {\n    for (let i = this.particles.length - 1; i >= 0; i--) {\n      const p = this.particles[i];\n      p.life -= dt;\n      p.x += p.vx * dt;\n      p.y += p.vy * dt;\n      p.vy += 200 * dt;\n      if (p.life <= 0) this.particles.splice(i, 1);\n    }\n  }\n  draw(ctx, paddle) {\n    ctx.save();\n    // Score\n    ctx.font = 'bold 18px Courier New';\n    ctx.textAlign = 'left';\n    ctx.textBaseline = 'top';\n    ctx.fillStyle = '#00f3ff';\n    ctx.shadowColor = 'rgba(0, 243, 255, 0.8)';\n    ctx.shadowBlur = 10;\n    ctx.fillText('SCORE ' + this.score, 12, 10);\n    // Level\n    ctx.fillStyle = '#00f3ff';\n    ctx.fillText('LEVEL ' + this.level, 12, 32);\n    // Timer\n    ctx.fillStyle = '#ff00e5';\n    ctx.fillText('TIME ' + this.timer.toFixed(2), 12, 54);\n    // Lives\n    ctx.textAlign = 'right';\n    ctx.fillStyle = '#ff00e5';\n    ctx.fillText('LIVES', this.canvas.width - 12, 10);\n    for (let i = 0; i < this.lives; i++) {\n      ctx.font = '20px serif';\n      ctx.fillText('♥', this.canvas.width - 12 - i * 24, 30);\n    }\n    // Angle gauge\n    this.drawGauge(paddle);\n    // Particles\n    for (const p of this.particles) {\n      const alpha = p.life / p.maxLife;\n      ctx.globalAlpha = alpha;\n      ctx.fillStyle = p.color;\n      ctx.beginPath();\n      ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);\n      ctx.fill();\n    }\n    ctx.globalAlpha = 1;\n    ctx.restore();\n  }\n  drawGauge(paddle) {\n    const g = this.gctx;\n    const w = this.gaugeCanvas.width;\n    const h = this.gaugeCanvas.height;\n    const cx = w / 2, cy = h / 2;\n    g.clearRect(0, 0, w, h);\n    // Background ring\n    g.strokeStyle = 'rgba(0, 243, 255, 0.2)';\n    g.