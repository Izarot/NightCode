#### js/entities/Ball.js
```javascript
class Ball {
    constructor(x, y, radius) {
        this.pos = { x, y };
        this.vel = { x: 0, y: 0 };
        this.radius = radius;
        this.trail = [];
        this.maxTrail = 12;
        this.spin = 0;
        this.active = false;
    }
    launch(angleDeg, power) {
        const angle = angleDeg * Math.PI / 180;
        this.vel.x = Math.cos(angle) * power;
        this.vel.y = Math.sin(angle) * power;
        this.spin = this.vel.x * 0.02;
        this.active = true;
    }
    update(dt) {
        if (!this.active) return;
        // Substep movement
        const speed = Math.hypot(this.vel.x, this.vel.y);
        const steps = Math.max(1, Math.ceil(speed * dt / (this.radius * 0.5)));
        const sdt = dt / steps;
        for (let i = 0; i < steps; i++) {
            this.pos.x += this.vel.x * sdt;
            this.pos.y += this.vel.y * sdt;
        }
        // Trail
        this.trail.push({ x: this.pos.x, y: this.pos.y });
        if (this.trail.length > this.maxTrail) this.trail.shift();
        // Spin affects trajectory slightly
        this.spin *= 0.98;
    }
    draw(ctx) {
        // Trail
        for (let i = 0; i < this.trail.length; i++) {
            const t = this.trail[i];
            const alpha = (i / this.trail.length) * 0.5;
            ctx.fillStyle = `rgba(0, 243, 255, ${alpha})`;
            ctx.beginPath();
            ctx.arc(t.x, t.y, this.radius * (i / this.trail.length), 0, Math.PI * 2);
            ctx.fill();
        }
        // Glow
        const grad = ctx.createRadialGradient(this.pos.x, this.pos.y, 0, this.pos.x, this.pos.y, this.radius * 2);
        grad.addColorStop(0, 'rgba(0, 243, 255, 1)');
        grad.addColorStop(0.5, 'rgba(0, 243, 255, 0.5)');
        grad.addColorStop(1, 'rgba(0, 243, 255, 0)');
        ctx.fillStyle = grad;
        ctx.beginPath();
        ctx.arc(this.pos.x, this.pos.y, this.radius * 2, 0, Math.PI * 2);
        ctx.fill();
        // Core
        ctx.fillStyle = '#ffffff';
        ctx.beginPath();
        ctx.arc(this.pos.x, this.pos.y, this.radius, 0, Math.PI * 2);
        ctx.fill();
    }
}
```

#### js/entities/Paddle.js
```javascript
class Paddle {
    constructor(x, y, width, height) {
        this.pos = { x, y };
        this.width = width;
        this.height = height;
        this.accel = 1200; // px/s^2
        this.friction = 0.85;
        this.vx = 0;
        this.vy = 0;
        this.vMax = 500;
        this.pulse = 0;
    }
    update(dt, input, bounds) {
        let ax = 0;
        if (input.left) ax -= this.accel;
        if (input.right) ax += this.accel;
        this.vx += ax * dt;
        // Friction
        this.vx *= Math.pow(this.friction, dt * 60);
        // Clamp
        this.vx = Math.max(-this.vMax, Math.min(this.vMax, this.vx));
        this.pos.x += this.vx * dt;
        // Boundary constraints
        if (this.pos.x < this.width / 2) {
            this.pos.x = this.width / 2;
            this.vx *= -0.5;
        }
        if (this.pos.x > bounds.w - this.width / 2) {
            this.pos.x = bounds.w - this.width / 2;
            this.vx *= -0.5;
        }
        this.pulse += dt * 4;
    }
    draw(ctx) {
        const w = this.width, h = this.height;
        const x = this.pos.x, y = this.pos.y;
        const glow = 0.5 + Math.sin(this.pulse) * 0.2;
        // Glow
        ctx.shadowColor = '#00f3ff';
        ctx.shadowBlur = 20 * glow;
        // Body gradient
        const grad = ctx.createLinearGradient(x - w/2, y, x + w/2, y);
        grad.addColorStop(0, 'rgba(0, 243, 255, 0.3)');
        grad.addColorStop(0.5, 'rgba(0, 243, 255, 0.9)');
        grad.addColorStop(1, 'rgba(0, 243, 255, 0.3)');
        ctx.fillStyle = grad;
        ctx.beginPath();
        ctx.moveTo(x - w/2, y);
        ctx.lineTo(x + w/2, y);
        ctx.lineTo(x + w/2 * 0.7, y - h);
        ctx.lineTo(x - w/2 * 0.7, y - h);
        ctx.closePath();
        ctx.fill();
        // Stroke
        ctx.strokeStyle = '#00f3ff';
        ctx.lineWidth = 2;
        ctx.stroke();
        ctx.shadowBlur = 0;
    }
}
```

#### js/entities/Brick.js
```javascript
class Brick {
    constructor(x, y, w, h, hp, tier, color) {
        this.pos = { x, y };
        this.w = w;
        this.h = h;
        this.hp = hp;
        this.maxHp = hp;
        this.tier = tier;
        this.color = color;
        this.alive = true;
        this.flashTimer = 0;
    }
    get centerX() { return this.pos.x + this.w / 2; }
    get centerY() { return this.pos.y + this.h / 2; }
    get normalX() { return 0; } // Will be set on collision
    get normalY() { return -1; }
    takeDamage(amount) {
        this.hp -= amount;
        this.flashTimer = 0.15;
        if (this.hp <= 0) {
            this.alive = false;
        }
    }
    update(dt) {
        if (this.flashTimer > 0) this.flashTimer -= dt;
    }
    draw(ctx) {
        if (!this.alive) return;
        const alpha = this.flashTimer > 0 ? 1 : 0.85;
        const strokeAlpha = this.flashTimer > 0 ? 1 : 0.9;
        // Gradient fill
        const grad = ctx.createLinearGradient(this.pos.x, this.pos.y, this.pos.x, this.pos.y + this.h);
        grad.addColorStop(0, this.color.top);
        grad.addColorStop(1, this.color.bottom);
        ctx.globalAlpha = alpha;
        ctx.fillStyle = grad;
        ctx.fillRect(this.pos.x, this.pos.y, this.w, this.h);
        // Stroke
        ctx.globalAlpha = strokeAlpha;
        ctx.strokeStyle = this.color.stroke;
        ctx.lineWidth = 2;
        ctx.strokeRect(this.pos.x, this.pos.y, this.w, this.h);
        // HP indicator
        if (this.hp < this.maxHp) {
            ctx.globalAlpha = 0.6;
            ctx.fillStyle = '#ffffff';
            ctx.font = 'bold 12px Courier New';
            ctx.textAlign = 'center';
            ctx.textBaseline = 'middle';
            ctx.fillText(this.hp, this.centerX, this.centerY);
        }
        ctx.globalAlpha = 1;
    }
}
```

#### js/systems/Physics.js
