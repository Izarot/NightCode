    let nx = ball.pos.x - cx;
    let ny = ball.pos.y - cy;
    const nlen = Math.hypot(nx, ny) || 1;
    nx /= nlen;
    ny /= nlen;
    
    // Deviation angle (using original velocity)
    const dot = ball.vel.x * nx + ball.vel.y * ny;
    const deviation = Math.acos(Math.max(-1, Math.min(1, dot))) * 180 / Math.PI;
    
