  "index.html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, user-scalable=no\">\n  <title>DUNGEON MASTER: TRAP LAYER</title>\n  <link rel=\"icon\" href=\"data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🏰</text></svg>\">\n  <style>\n    *{margin:0;padding:0;box-sizing:border-box}\n    body{background:#0d0d1a;font-family:'Courier New',monospace;overflow:hidden;touch-action:none}\n    #gameContainer{display:flex;justify-content:center;align-items:center;min-height:100vh;padding:10px}\n    #canvas{background:#1a1a2e;border:2px solid #3a3a5e;border-radius:4px;box-shadow:0 0 30px rgba(247,37,133,0.3),inset 0 0 60px rgba(0,0,0,0.5);display:block}\n    #uiOverlay{position:fixed;top:10px;left:10px;right:10px;bottom:10px;pointer-events:none;z-index:10}\n    .hud{position:absolute;color:#ffd700;font-size:14px;text-shadow:0 0 5px #000;pointer-events:auto}\n    .hudTop{top:15px;left:15px;right:15px;display:flex;justify-content:space-between}\n    .hudCenter{top:15px;left:50%;transform:translateX(-50%)}\n    .hudRight{top:15px;right:15px}\n    .panel{position:absolute;top:50px;right:15px;width:200px;background:rgba(26,26,46,0.95);border:1px solid #3a3a5e;border-radius:4px;padding:10px;color:#e0e0e0;font-size:12px;line-height:1.6;pointer-events:auto}\n    .panel h3{color:#f72585;border-bottom:1px solid #3a3a5e;padding-bottom:5px;margin-bottom:8px}\n    .trapBtn{display:block;width:100%;padding:6px;margin:4px 0;background:#2a2a3d;border:1px solid #3a3a5e;color:#e0e0e0;cursor:pointer;border-radius:2px;text-align:left;transition:all 0.1s}\n    .trapBtn:hover,.trapBtn.selected{background:#f72585;border-color:#f72585}\n    .trapBtn:disabled{opacity:0.4;cursor:not-allowed}\n    .budgetBar{height:8px;background:#1a1a2e;border:1px solid #3a3a5e;border-radius:4px;overflow:hidden;margin:8px 0}\n    .budgetFill{height:100%;background:linear-gradient(90deg,#f72585,#7209b7);transition:width 0.2s}\n    .bigBtn{width:100%;padding:10px;margin:8px 0;background:linear-gradient(135deg,#4361ee,#7209b7);border:none;color:#fff;font-weight:bold;cursor:pointer;border-radius:2px;font-size:14px;transition:transform 0.1s}\n    .bigBtn:hover{transform:scale(1.02)}\n    .bigBtn:active{transform:scale(0.98)}\n    .bigBtn.danger{background:linear-gradient(135deg,#e63946,#f77f00)}\n    .phaseBanner{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);font-size:32px;font-weight:bold;color:#fff;text-shadow:0 0 20px #f72585,0 0 40px #7209b7;pointer-events:none;white-space:nowrap;z-index:20}\n    .resultBox{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);background:rgba(26,26,46,0.98);border:2px solid #f72585;border-radius:8px;padding:30px 40px;text-align:center;pointer-events:auto;z-index:30}\n    .resultBox h2{margin-bottom:15px;color:#ffd700}\n    .resultBox p{margin:8px 0;color:#e0e0e0}\n    @media(max-width:768px){.panel{width:100%;right:0;top:auto;bottom:0;border-radius:8px 8px 0 0;max-height:50vh;overflow-y:auto}.hudTop{flex-direction:column;gap:5px}.phaseBanner{font-size:24px}}\n  </style>\n</head>\n<body>\n  <div id=\"gameContainer\">\n    <canvas id=\"canvas\"></canvas>\n    <div id=\"uiOverlay\">\n      <div class=\"hud hudTop\">\n        <div id=\"hudLeft\">LEVEL: 1 | SCORE: 0</div>\n        <div id=\"hudRight\" class=\"hudRight\">HP: 100</div>\n      </div>\n      <div class=\"hud hudCenter\" id=\"timer\">PLANNING: 30s</div>\n      <div class=\"panel\" id=\"panel\">\n        <h3>TRAP BUDGET: <span id=\"budgetNum\">10</span>/10</h3>\n        <div class=\"budgetBar\"><div class=\"budgetFill\" id=\"budgetFill\" style=\"width:100%\"></div></div>\n        <button class=\"trapBtn selected\" data-trap=\"spike\" data-cost=\"1\">[1] SPIKE  (1) - 30 DMG</button>\n        <button class=\"trapBtn\" data-trap=\"pit\" data-cost=\"2\">[2] PIT    (2) - INSTANT KILL</button>\n        <button class=\"trapBtn\" data-trap=\"fire\" data-cost=\"2\">[3] FIRE   (2) - 15/tick</button>\n        <button class=\"trapBtn\" data-trap=\"freeze\" data-cost=\"3\">[4] FREEZE (3) - SLOW 50%</button>\n        <div style=\"margin:8px 0;border-top:1px solid #3a3a5e;padding-top:8px\">WALLS: <span id=\"wallsLeft\">5</span> left</div>\n        <button class=\"trapBtn\" id=\"wallBtn\" data-trap=\"wall\">PLACE WALL</button>\n        <div style=\"margin:8px 0;border-top:1px solid #3a3a5e;padding-top:8px\">\n          LEVEL: <span id=\"levelNum\">1</span> | BEST: <span id=\"bestScore\">0</span> pts\n        </div>\n        <button class=\"bigBtn\" id=\"startBtn\">START SIMULATION</button>\n        <button class=\"bigBtn danger\" id=\"resetBtn\">RESET LEVEL</button>\n      </div>\n      <div class=\"phaseBanner\" id=\"phaseBanner\" style=\"display:none\"></div>\n      <div class=\"resultBox\" id=\"resultBox\" style=\"display:none\"></div>\n    </div>\n  </div>\n\n  <script>\n  // ============ GAME CONSTANTS ============\n  const COLS=16, ROWS=12, TS=50;\n  const TRAPS={\n    spike:{cost:1,dmg:30,color:'#e63946',name:'SPIKE'},\n    pit:{cost:2,dmg:100,color:'#1d3557',name:'PIT'},\n    fire:{cost:2,dmg:15,color:'#f77f00',name:'FIRE',dot:3,interval:666},\n    freeze:{cost:3,dmg:0,color:'#4cc9f0',name:'FREEZE',slow:0.5,dur:3000},\n    wall:{cost:0,color:'#3a3a5e',name:'WALL'}\n  };\n  const LEVELS=[\n    {budget:8,hp:100,unlock:['spike','pit']},\n    {budget:10,hp:100,unlock:['spike','pit','fire']},\n    {budget:12,hp:120,unlock:['spike','pit','fire','freeze']},\n    {budget:15,hp:120,unlock:['spike','pit','fire','freeze']}\n  ];\n  const ENTRY={x:1,y:1}, EXIT={x:COLS-2,y:ROWS-2};\n  const PHASE={PLAN:0,SIM:1,RESULT:2};\n\n  // ============ AUDIO ============\n  const AC=new (window.AudioContext||window.webkitAudioContext)();\n  function beep(freq,type,dur,vol=0.1,start=0){if(!AC||AC.state==='suspended')return;\n    const o=AC.createOscillator(),g=AC.createGain();o.type=type;o.frequency.value=freq;\n    g.gain.value=vol;o.connect(g).connect(AC.destination);\n    const t=AC.currentTime+start;o.start(t);o.stop(t+dur);}\n  function sfx(type){\n    if(!AC||AC.state==='suspended'){AC?.resume();return;}\n    switch(type){\n      case 'place':beep(440,'square',0.05,0.08);beep(660,'square',0.05,0.08,0.05);break;\n      case 'remove':beep(330,'sawtooth',0.1,0.08);break;\n      case 'spike':beep(800,'square',0.08,0.15);beep(1200,'square',0.05,0.1,0.08);break;\n      case 'pit':beep(100,'sine',0.3,0.2);beep(60,'sine',0.4,0.15,0.1);break;\n      case 'fire':for(let i=0;i<5;i++)beep(200+Math.random()*300,'sawtooth',0.05,0.05,i*0.03);break;\n      case 'freeze':beep(880,'sine',0.1,0.1);beep(1320,'sine',0.1,0.08,0.1);break;\n      case 'hit':beep(200,'square',0.1,0.2);break;\n      case 'win':beep(523,'triangle',0.15,0.15);beep(659,'triangle',0.15,0.15,0.15);beep(784,'triangle',0.2,0.15,0.3);break;\n      case 'lose':beep(200,'sawtooth',0.3,0.2);beep(150,'sawtooth',0.4,0.15,0.3);break;\n      case 'start':beep(300,'square',0.1,0.1);beep(400,'square',0.1,0.1,0.1);beep(500,'square',0.15,0.1,0.2);break;\n    }\n  }\n\n  // ============ PARTICLES ============\n  class Particles{\n    constructor(){this.list=[];this.pool=[];}\n    spawn(x,y,color,count,vel,life,size,gravity=0){\n      for(let i=0;i<count;i++){\n        const p=this.pool.pop()||{};\n        p.x=x;p.y=y;p.color=color;\n        p.vx=(Math.random()-0.5)*vel;p.vy=(Math.random()-0.5)*vel-gravity;\n        p.life=life;p.maxLife=life;p.size=size*(0.5+Math.random()*0.5);\n        this.list.push(p);\n      }\n    }\n    update(dt){for(let i=this.list.length-1;i>=0;i--){const p=this.list[i];p.x+=p.vx*dt;p.y+=p.vy*dt;p.vy+=30*dt;p.life-=dt;if(p.life<=0){this.pool.push(this.list.splice(i,1)[0]);}}}\n    draw(ctx){this.list.forEach(p=>{ctx.globalAlpha=p.life/p.maxLife;ctx.fillStyle=p.color;ctx.beginPath();ctx.arc(p.x,p.y,p.size,0,Math.PI*2);ctx.fill();});ctx.globalAlpha=1;}\n  }\n\n  // ============ GRID & PATHFINDING ============\n  class Grid{\n    constructor(){this.tiles=[];this.walls=new Set();this.traps=new Map();this.reset();}\n    reset(){this.tiles=[];for(let y=0;y<ROWS;y++){this.tiles[y]=[];for(let x=0;x<COLS;x++)this.tiles[y][x]=0;}\n      this.walls.clear();this.traps.clear();\n      for(let x=0;x<COLS;x++){this.walls.add(`${x},0`);this.walls.add(`${x},${ROWS-1}`);}\n      for(let y=0;y<ROWS;y++){this.walls.add(`0,${y}`);this.walls.add(`${COLS-1},${y}`);}\n      this.walls.delete(`${ENTRY.x},${ENTRY.y}`);this.walls.delete(`${EXIT.x},${EXIT.y}`);\n    }\n    key(x,y){return `${x},${y}`;}\n    isWall(x,y){return this.walls.has(this.key(x,y));}\n    isFloor(x,y){return x>0&&x<COLS-1&&y>0&&y<ROWS-1&&!this.isWall(x,y);}\n    getTrap(x,y){return this.traps.get(this.key(x,y));}\n    placeTrap(x,y,type){if(this.isFloor(x,y)&&!this.getTrap(x,y)){this.traps.set(this.key(x,y),{type,active:true,time:0});return true;}return false;}\n    removeTrap(x,y){const k=this.key(x,y);if(this.traps.has(k)){const t=this.traps.get(k);this.traps.delete(k);return TRAPS[t.type].cost;}return 0;}\n    placeWall(x,y){if(this.isFloor(x,y)&&!this.getTrap(x,y)){this.walls.add(this.key(x,y));return true;}return false;}\n    removeWall(x,y){this.walls.delete(this.key(x,y));}\n    neighbors(x,y){const r=[];[[1,0],[-1,0],[0,1],[0,-1]].forEach(([dx,dy])=>{const nx=x+dx,ny=y+dy;if(nx>=0&&nx<COLS&&ny>=0&&ny<ROWS&&!this.isWall(nx,ny))r.push({x:nx,y:ny});});return r;}\n    heuristic(a,b){return Math.abs(a.x-b.x)+Math.abs(a.y-b.y);}\n    findPath(sx,sy,tx,ty){\n      const open=[{x:sx,y:sy,g:0,h:this.heuristic({x:sx,y:sy},{x:tx,y:ty}),f:0,parent:null}];open[0].f=open[0].h;\n      const closed=new Set();\n      while(open.length){open.sort((a,b)=>a.f-b.f);const cur=open.shift();const ck=this.key(cur.x,cur.y);if(closed.has(ck))continue;if(cur.x===tx&&cur.y===ty){const path=[];let p=cur;while(p){path.unshift({x:p.x,y:p.y});p=p.parent;}return path;}\n      closed.add(ck);\n      this.neighbors(cur.x,cur.y).forEach(n=>{const nk=this.key(n.x,n.y);if(closed.has(nk))return;const g=cur.g+1;const existing=open.find(o=>o.x===n.x&&o.y===n.y);if(!existing||g<existing.g){open.push({x:n.x,y:n.y,g,h:this.heuristic(n,{x:tx,y:ty}),f:g+this.heuristic(n,{x:tx,y:ty}),parent:cur});}});}\n      return null;\n    }\n  }\n\n  // ============ HERO ============\n  class Hero{\n    constructor(grid){this.grid=grid;this.reset();}\n    reset(){this.x=ENTRY.x*TS+TS/2;this.y=ENTRY.y*TS+TS/2;this.tx=this.x;this.ty=this.y;\n      this.hp=100;this.maxHp=100;this.speed=80;this.path=[];this.pathIndex=0;\n      this.state='idle';this.stagger=0;this.slow=1;this.slowTimer=0;\n      this.bob=0;this.trail=[];this.damageFlash=0;}\n    setStats(hp){this.maxHp=this.hp=hp;}\n    update(dt,particles){\n      if(this.slowTimer>0){this.slowTimer-=dt*1000;this.slow=0.5;if(this.slowTimer<=0)this.slow=1;}\n      this.damageFlash=Math.max(0,this.damageFlash-dt);\n      this.bob+=dt*10;\n      if(this.state==='moving'&&this.path.length){\n        const target=this.path[this.pathIndex];\n        if(target){\n          this.tx=target.x*TS+TS/2;this.ty=target.y*TS+TS/2;\n          const dx=this.tx-this.x,dy=this.ty-this.y;const dist=Math.hypot(dx,dy);\n          const moveDist=this.speed*this.slow*dt;\n          if(dist<moveDist){this.x=this.tx;this.y=this.ty;this.pathIndex++;}\n          else{this.x+=dx/dist*moveDist;this.y+=dy/dist*moveDist;}\n          this.trail.unshift({x:this.x,y:this.y,life:0.5});if(this.trail.length>10)this.trail.pop();\n          if(this.pathIndex>=this.path.length){this.state='idle';}\n        }else this.state='idle';\n      }\n      this.trail.forEach(t=>t.life-=dt);this.trail=this.trail.filter(t=>t.life>0);\n      const trap=this.grid.getTrap(Math.floor(this.x/TS),Math.floor(this.y/TS));\n      if(trap&&trap.active){this.triggerTrap(trap,particles);}\n      if(this.stagger>0)this.stagger-=dt;\n    }\n    triggerTrap(trap,particles){\n      const t=TRAPS[trap.type];\n      if(trap.type==='spike'){this.hp-=t.dmg;trap.active=false;sfx('spike');particles.spawn(this.x,this.y,t.color,15,200,0.5,6);sfx('hit');}\n      else if(trap.type==='pit'){this.hp=0;sfx('pit');particles.spawn(this.x,this.y,'#000',30,300,1,8);}\n      else if(trap.type==='fire'){if(!trap.lastTick||Date.now()-trap.lastTick>t.interval){this.hp-=t.dmg;trap.lastTick=Date.now();sfx('fire');particles.spawn(this.x,this.y,t.color,8,150,0.3,4);sfx('hit');}}\n      else if(trap.type==='freeze'){this.slowTimer=t.dur;trap.active=false;sfx('freeze');particles.spawn(this.x,this.y,t.color,12,100,0.8,5);}\n      this.damageFlash=0.1;this.stagger=0.2;\n      if(this.hp<=0){this.state='dying';sfx('win');particles.spawn(this.x,this.y,'#e63946',25,250,1,10);}\n    }\n    recalcPath(){this.path=this.grid.findPath(Math.floor(this.x/TS),Math.floor(this.y/TS),EXIT.x,EXIT.y)||[];this.pathIndex=0;this.state=this.path.length?'moving':'stuck';}\n    draw(ctx){\n      ctx.save();\n      this.trail.forEach((t,i)=>{ctx.globalAlpha=t.life/0.5*0.3;ctx.fillStyle='#4cc9f0';ctx.beginPath();ctx.arc(t.x,t.y,15*(1-i/10),0,Math.PI*2);ctx.fill();});\n      ctx.globalAlpha=1;\n      if(this.slowTimer>0){ctx.fillStyle='rgba(76,201,240,0.3)';ctx.beginPath();ctx.arc(this.x,this.y,25,0,Math.PI*2);ctx.fill();}\n      ctx.fillStyle=this.damageFlash>0?'#fff':this.hp>0?'#4361ee':'#e63946';\n      const bobY=Math.sin(this.bob)*2;\n      ctx.beginPath();ctx.arc(this.x,this.y+bobY,15,0,Math.PI*2);ctx.fill();\n      ctx.fillStyle='#fff';ctx.beginPath();ctx.arc(this.x+3,this.y+bobY-3,4,0,Math.PI*2);ctx.fill();\n      if(this.state==='dying'){ctx.save();ctx.translate(this.x,this.y+bobY);ctx.rotate(Date.now()/200);ctx.fillStyle='rgba(230,57,70,0.5)';ctx.fillRect(-20,-20,40,40);ctx.restore();}\n      ctx.restore();\n    }\n  }\n\n  // ============ MAIN GAME ============\n  const canvas=document.getElementById('canvas');\n  const ctx=canvas.getContext('2d');\n  const grid=new Grid();\n  const hero=new Hero(grid);\n  const particles=new Particles();\n  let phase=PHASE.PLAN,level=1,score=0,budget=10,wallsLeft=5,selectedTrap='spike',planTime=30,simTime=0,lastTime=0,shake=0;\n  const bestScore=parseInt(localStorage.getItem('dmtl_best')||'0');\n  document.getElementById('bestScore').textContent=bestScore;\n\n  function resize(){\n    const maxW=Math.min(1200,window.innerWidth-20);\n    const maxH=Math.min(800,window.innerHeight-20);\n    const scale=Math.min(maxW/(COLS*TS),maxH/(ROWS*TS));\n    canvas.width=COLS*TS*scale;canvas.height=ROWS*TS*scale;\n    canvas.style.width=COLS*TS*scale+'px';\n    canvas.style.height=ROWS*TS*scale+'px';\n    ctx.setTransform(scale,0,0,scale,0,0);\n  }\n  window.addEventListener('resize',resize);resize();\n\n  function initLevel(lvl){\n    level=lvl;const ld=LEVELS[Math.min(lvl-1,LEVELS.length-1)];\n    budget=ld.budget;wallsLeft=5;hero.setStats(ld.hp);hero.reset();grid.reset();\n    document.querySelectorAll('.trapBtn[data-trap]').forEach(b=>{const t=b.dataset.trap;b.disabled=!ld.unlock.includes(t)&&t!=='wall';if(b.disabled)b.style.opacity='0.3';});\n    updateUI();phase=PHASE.PLAN;planTime=30;simTime=0;\n    document.getElementById('phaseBanner').style.display='none';\n    document.getElementById('resultBox').style.display='none';\n  }\n\n  function updateUI(){\n    document.getElementById('hudLeft').textContent=`LEVEL: ${level} | SCORE: ${score}`;\n    document.getElementById('hudRight').textContent=`HP: ${Math.max(0,Math.ceil(hero.hp))}`;\n    document.getElementById('budgetNum').textContent=budget;\n    document.getElementById('budgetFill').style.width=`${budget/LEVELS[Math.min(level-1,LEVELS.length-1)].budget*100}%`;\n    document.getElementById('wallsLeft').textContent=wallsLeft;\n    document.getElementById('levelNum').textContent=level;\n    document.querySelectorAll('.trapBtn[data-trap]').forEach(b=>b.classList.toggle('selected',b.dataset.trap===selectedTrap));\n  }\n\n  function update(dt){\n    if(shake>0){shake-=dt;}\n    particles.update(dt);\n    if(phase===PHASE.PLAN){\n      planTime-=dt;\n      document.getElementById('timer').textContent=`PLANNING: ${Math.ceil(planTime)}s`;\n      if(planTime<=0)startSim();\n    }else if(phase===PHASE.SIM){\n      simTime+=dt;\n      document.getElementById('timer').textContent=`SIM: ${simTime.toFixed(1)}s`;\n      hero.update(dt,particles);\n      if(hero.hp<=0){endGame(true);}\n      else if(hero.state==='idle'&&hero.pathIndex>=hero.path.length){\n        const hx=Math.floor(hero.x/TS),hy=Math.floor(hero.y/TS);\n        if(hx===EXIT.x&&hy===EXIT.y)endGame(false);\n        else if(hero.state==='stuck'){if(simTime>10)endGame(true);}\n        else hero.recalcPath();\n      }\n    }\n  }\n\n  function render(){\n    ctx.save();if(shake>0)ctx.translate((Math.random()-0.5)*4,(Math.random()-0.5)*4);\n    // Background\n    ctx.fillStyle='#1a1a2e';ctx.fillRect(0,0,COLS*TS,ROWS*TS);\n    // Floor pattern\n    ctx.strokeStyle='#2a2a3d';ctx.lineWidth=0.5;\n    for(let y=0;y<ROWS;y++)for(let x=0;x<COLS;x++){\n      if((x+y)%2===0){ctx.strokeRect(x*TS,y*TS,TS,TS);}\n    }\n    // Walls\n    grid.walls.forEach(k=>{const [x,y]=k.split(',').map(Number);\n      ctx.fillStyle='#1a1a2e';ctx.fillRect(x*TS,y*TS,TS,TS);\n      ctx.strokeStyle='#3a3a5e';ctx.lineWidth=2;\n      ctx.beginPath();ctx.moveTo(x*TS,y*TS+TS);ctx.lineTo(x*TS,y*TS);ctx.lineTo(x*TS+TS,y*TS);ctx.stroke();\n      ctx.strokeStyle='#0a0a1a';ctx.beginPath();ctx.moveTo(x*TS+TS,y*TS);ctx.lineTo(x*TS+TS,y*TS+TS);ctx.lineTo(x*TS,y*TS+TS);ctx.stroke();\n    });\n    // Exit portal\n    const ex=EXIT.x*TS+TS/2,ey=EXIT.y*TS+TS/2;\n    const t=Date.now()/300;\n    for(let i=3;i>0;i--){ctx.globalAlpha=0.15*i;ctx.fillStyle='#7209b7';ctx.beginPath();ctx.arc(ex,ey,TS/2*0.8+Math.sin(t+i)*4,0,Math.PI*2);ctx.fill();}\n    ctx.globalAlpha=1;\n    // Traps\n    grid.traps.forEach((trap,k)=>{const [x,y]=k.split(',').map(Number);const cx=x*TS+TS/2,cy=y*TS+TS/2;const T=TRAPS[trap.type];\n      if(trap.type==='spike'&&trap.active){ctx.fillStyle=T.color;ctx.beginPath();ctx.moveTo(cx,cy-15);ctx.lineTo(cx-10,cy+10);ctx.lineTo(cx+10,cy+10);ctx.fill();ctx.fillStyle='#ff6b6b';ctx.beginPath();ctx.moveTo(cx,cy-10);ctx.lineTo(cx-6,cy+5);ctx.lineTo(cx+6,cy+5);ctx.fill();}\n      else if(trap.type==='pit'){const g=ctx.createRadialGradient(cx,cy,0,cx,cy,TS/2);g.addColorStop(0,'#0a0a1a');g.addColorStop(0.5,'#1d3557');g.addColorStop(1,'#0a0a1a');ctx.fillStyle=g;ctx.beginPath();ctx.arc(cx,cy,TS/2-2,0,Math.PI*2);ctx.fill();ctx.strokeStyle='#0a0a1a';ctx.lineWidth=3;ctx.stroke();}\n      else if(trap.type==='fire'&&trap.active){for(let i=0;i<5;i++){const fx=cx+(Math.random()-0.5)*20,fy=cy-10+Math.random()*20,fs=5+Math.random()*8;ctx.fillStyle=`hsl(${20+Math.random()*30},100%,${50+Math.random()*20}%)`;ctx.globalAlpha=0.7;ctx.beginPath();ctx.arc(fx,fy,fs,0,Math.PI*2);ctx.fill();}ctx.globalAlpha=1;}\n      else if(trap.type==='freeze'&&trap.active){ctx.fillStyle=T.color;ctx.globalAlpha=0.6;for(let i=0;i<6;i++){const a=i*Math.PI/3;ctx.beginPath();ctx.moveTo(cx,cy);ctx.lineTo(cx+Math.cos(a)*18,cy+Math.sin(a)*18);ctx.lineTo(cx+Math.cos(a+0.2)*10,cy+Math.sin(a+0.2)*10);ctx.fill();}ctx.globalAlpha=1;}\n    });\n    // Hero\n    hero.draw(ctx);\n    // Planning hover preview\n    if(phase===PHASE.PLAN&&hoverTile){\n      const [hx,hy]=hoverTile;const valid=grid.isFloor(hx,hy)&&!grid.getTrap(hx,hy)&&(selectedTrap!=='wall'||wallsLeft>0);\n      ctx.fillStyle=valid?'rgba(76,201,240,0.3)':'rgba(230,57,70,0.3)';ctx.fillRect(hx*TS,hy*TS,TS,TS);\n      ctx.strokeStyle=valid?'#4cc9f0':'#e63946';ctx.lineWidth=2;ctx.strokeRect(hx*TS+1,hy*TS+1,TS-2,TS-2);\n    }\n    ctx.restore();\n    particles.draw(ctx);\n  }\n\n  let hoverTile=null;\n  canvas.addEventListener('mousemove',e=>{const r=canvas.getBoundingClientRect();const scale=canvas.width/r.width;\n    const x=Math.floor((e.clientX-r.left)*scale/TS),y=Math.floor((e.clientY-r.top)*scale/TS);\n    if(x>=0&&x<COLS&&y>=0&&y<ROWS){hoverTile=[x,y];}else hoverTile=null;});\n  canvas.addEventListener('click',e=>{if(phase!==PHASE.PLAN||!hoverTile)return;\n    const [hx,hy]=hoverTile;const cost=TRAPS[selectedTrap]?.cost||0;\n    if(selectedTrap==='wall'){if(wallsLeft>0&&grid.placeWall(hx,hy)){wallsLeft--;sfx('place');updateUI();}}else if(budget>=cost&&grid.placeTrap(hx,hy,selectedTrap)){budget-=cost;sfx('place');updateUI();}\n  });\n  canvas.addEventListener('contextmenu',e=>{e.preventDefault();if(phase!==PHASE.PLAN||!hoverTile)return;\n    const [hx,hy]=hoverTile;const trap=grid.getTrap(hx,hy);\n    if(trap){budget+=grid.removeTrap(hx,hy);sfx('remove');updateUI();}\n    else if(grid.isWall(hx,hy)&&!grid.walls.has(`${ENTRY.x},${ENTRY.y}`)&&!grid.walls.has(`${EXIT.x},${EXIT.y}`)){grid.removeWall(hx,hy);wallsLeft++;sfx('remove');updateUI();}\n  });\n  document.addEventListener('keydown',e=>{if(e.key>='1'&&e.key<='4'){const traps=['spike','pit','fire','freeze'];const t=traps[parseInt(e.key)-1];if(!document.querySelector(`.trapBtn[data-trap=\"${t}\"]`)?.disabled){selectedTrap=t;updateUI();sfx('place');}}\n    else if(e.key==='w'||e.key==='W'){selectedTrap='wall';updateUI();sfx('place');}\n    else if(e.key===' '||e.key==='Enter'){if(phase===PHASE.PLAN)startSim();else if(phase===PHASE.RESULT)initLevel(level);}\n    else if(e.key==='r'||e.key==='R'){initLevel(level);}\n    else if(e.key==='Escape'){if(phase===PHASE.SIM)endGame(true);}\n  });\n  document.getElementById('startBtn').addEventListener('click',startSim);\n  document.getElementById('resetBtn').addEventListener('click',()=>initLevel(level));\n  document.querySelectorAll('.trapBtn[data-trap]').forEach(b=>b.addEventListener('click',()=>{if(!b.disabled){selectedTrap=b.dataset.trap;updateUI();sfx('place');}}));\n\n  function startSim(){if(phase!==PHASE.PLAN)return;\n    phase=PHASE.SIM;simTime=0;hero.recalcPath();sfx('start');\n    document.getElementById('phaseBanner').textContent='SIMULATION RUNNING';\n    document.getElementById('phaseBanner').style.display='block';\n    setTimeout(()=>document.getElementById('phaseBanner').style.display='none',2000);\n  }\n\n  function endGame(heroDied){\n    phase=PHASE.RESULT;\n    const timeBonus=Math.max(0,Math.floor((30-simTime)*10));\n    const hpBonus=Math.floor(hero.hp/10);\n    const levelScore=heroDied?0:100+timeBonus+hpBonus;\n    score+=levelScore;\n    if(score>bestScore){localStorage.setItem('dmtl_best',score);document.getElementById('bestScore').textContent=score;}\n    shake=0.5;\n    const box=document.getElementById('resultBox');\n    box.style.display='block';\n    box.innerHTML=`\n      <h2>${heroDied?'HERO SURVIVED - DUNGEON FAILED':'HERO DEFEATED - VICTORY!'}</h2>\n      <p>Level ${level} ${heroDied?'FAILED':'CLEARED'}</p>\n      <p>Time: ${simTime.toFixed(1)}s</p>\n      <p>Hero HP: ${Math.max(0,Math.ceil(hero.hp))}</p>\n      <p>Level Score: ${levelScore}</p>\n      <p>Total Score: ${score}</p>\n      <button class=\"bigBtn\" style=\"margin-top:15px\" onclick=\"initLevel(${heroDied?level:level+1})\">${heroDied?'RETRY LEVEL':'NEXT LEVEL'}</button>\n    `;\n    sfx(heroDied?'lose':'win');\n  }\n\n  function loop(ts){\n    const dt=(ts-lastTime)/1000;lastTime=ts;\n    update(dt);\n    render();\n    requestAnimationFrame(loop);\n  }\n  requestAnimationFrame(loop);\n  initLevel(1);\n  </script>\n</body>\n</html>"\n}