        gameState.rivals.push(new Boulder(gameState.track.segments[0].x + (i - 1) * 30, gameState.track.segments[0].y - 20 - i * 10, CONSTANTS.COLORS['RIVAL_' + i], false));
    }
    gameState.state = 'title';
