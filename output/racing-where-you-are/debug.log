                    const relativeVy = rival.vy - gameState.rivals[j].vy;
                    const velAlongNormal = relativeVx * nx + relativeVy * ny;
                    if (velAlongNormal > 0) continue;
                    const restitution = CONSTANTS.PHYSICS.RESTITUTION;
                    rival.vx -= (1 + restitution) * velAlongNormal * gameState.rivals[j].mass / (1 / rival.mass + 1 / gameState.rivals[j].mass) * nx;
                    rival.vy -= (1 + restitution) * velAlongNormal * gameState.rivals[j].mass / (1 / rival.mass + 1 / gameState.rivals[j].mass) * ny;
                    gameState.rivals[j].vx += (1 + restitution) * velAlongNormal * rival.mass / (1 / rival.mass + 1 / gameState.rivals[j].mass) * nx;
                    gameState.rivals[j].vy += (1 + restitution) * velAlongNormal * rival.mass / (1 / rival.mass + 1 / gameState.rivals[j].mass) * ny;
                    gameState.race.collisions++;
                    playSound('collision');
                }
            }
        }
    }
}
function updateParticles(dt) {
    for (let i = gameState.particles.length - 1; i >= 0; i--) {
        const p = gameState.particles[i];
        p.x += p.vx * dt;
        p.y += p.vy * dt;
        p.vx *= 0.98;
        p.vy *= 0.98;
        p.age += dt;
        if (p.age > p.lifetime) {
            gameState.particles.splice(i, 1);
        }
    }
}
function draw() {
    const ctx = document.getElementById('gameCanvas').getContext('2d');
    ctx.clearRect(0, 0, ctx.canvas.width, ctx.canvas.height);
    ctx.save();
    ctx.translate(-gameState.camera.x, -gameState.camera.y);
    ctx.scale(gameState.camera.zoom, gameState.camera.zoom);
    for (let i = 0; i < gameState.track.segments.length - 1; i++) {
        const seg = gameState.track.segments[i];
        const nextSeg = gameState.track.segments[i + 1];
        ctx.beginPath();
        ctx.moveTo(seg.x, seg.y);
        ctx.lineTo(nextSeg.x, nextSeg.y);
        ctx.strokeStyle = CONSTANTS.COLORS.TRACK;
        ctx.lineWidth = seg.width;
        ctx.lineCap = 'round';
        ctx.stroke();
    }
    for (let i = 0; i < gameState.particles.length; i++) {
        const p = gameState.particles[i];
        ctx.fillStyle = p.color;
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
        ctx.fill();
    }
    for (let i = 0; i < gameState.rivals.length; i++) {
        const b = gameState.rivals[i];
        ctx.fillStyle = b.color;
        ctx.beginPath();
        ctx.arc(b.x, b.y, b.radius, 0, Math.PI * 2);
        ctx.fill();
        ctx.strokeStyle = '#fff';
        ctx.lineWidth = 2;
        ctx.beginPath();
        ctx.moveTo(b.x, b.y);
        ctx.lineTo(b.x + Math.cos(b.heading) * b.radius, b.y + Math.sin(b.heading) * b.radius);
        ctx.stroke();
    }
    const player = gameState.player;
    ctx.fillStyle = player.color;
    ctx.beginPath();
    ctx.arc(player.x, player.y, player.radius, 0, Math.PI * 2);
    ctx.fill();
    ctx.strokeStyle = '#fff';
    ctx.lineWidth = 2;
    ctx.beginPath();
    ctx.moveTo(player.x, player.y);
    ctx.lineTo(player.x + Math.cos(player.heading) * player.radius, player.y + Math.sin(player.heading) * player.radius);
    ctx.stroke();
    ctx.restore();
    drawHUD();
}
function drawHUD() {
    const ctx = document.getElementById('gameCanvas').getContext('2d');
    ctx.save();
    ctx.font = '20px Arial';
    ctx.fillStyle = '#fff';
    ctx.fillText(`Placement: ${gameState.race.placements[0] || 0}`, 20, 40);
    ctx.fillText(`Time: ${formatTime(gameState.race.time)}`, ctx.canvas.width / 2 - 50, 40);
    ctx.restore();
}
function formatTime(ms) {
    const totalSeconds = Math.floor(ms / 1000);
    const minutes = Math.floor(totalSeconds / 60);
    const seconds = totalSeconds % 60;
    const millis = Math.floor(ms % 1000);
    return `${minutes.toString().padStart(2, '0')}:${seconds.toString().padStart(2, '0')}.${millis.toString().padStart(3, '0')}`;
}
function gameLoop() {
    const dt = CONSTANTS.PHYSICS.DT;
    if (gameState.state === 'playing') {
        gameState.race.time = Date.now() - gameState.race.startTime;
        gameState.player.update(dt, gameState.track, gameState.rivals);
        updateRivals(dt, gameState.track);
        updateParticles(dt);
        updateBoostMeter(dt);
        if (gameState.race.time > 60000) {
            gameState.state = 'results';
            showResults();
        }
    }
    draw();
    requestAnimationFrame(gameLoop);
}
function updateBoostMeter(dt) {
    if (gameState.boostReady) {
        gameState.boostMeter = Math.min(1, gameState.boostMeter + dt * 0.5);
    } else {
        gameState.boostMeter = Math.max(0, gameState.boostMeter - dt * 2);
        if (gameState.boostMeter <= 0) {
            gameState.boostReady = true;
        }
    }
    const fill = document.getElementById('boostFill');
    fill.style.width = `${gameState.boostMeter * 100}%`;
}
function showResults() {
    const placement = gameState.race.placements[0] || 1;
    document.getElementById('resultsPlacement').textContent = `You finished: ${placement === 1 ? '1st' : placement === 2 ? '2nd' : placement === 3 ? '3rd' : `${placement}th`}`;
    document.getElementById('resultsTime').textContent = `Time: ${formatTime(gameState.race.time)}`;
    document.getElementById('resultsTopSpeed').textContent = `Top Speed: ${gameState.race.topSpeed} MPH`;
    document.getElementById('resultsBoosts').textContent = `Boost Pads: ${gameState.race.boostsCollected}`;
    document.getElementById('resultsCollisions').textContent = `Collisions: ${gameState.race.collisions}`;
    document.getElementById('resultsScreen').classList.remove('hidden');
}
function init() {
    initAudio();
    gameState.track = generateTrack(Date.now());
    gameState.player = new Boulder(gameState.track.segments[0].x, gameState.track.segments[0].y, CONSTANTS.COLORS.PLAYER, true);
