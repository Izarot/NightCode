  "index.html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Snail Rocket Racer</title>\n<link rel=\"icon\" href=\"data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ctext y='70' font-size='60' fill='%23ff6b6b'%3E🐌%3C/text%3E%3C/svg%3E\">\n<style>\nbody{margin:0;overflow:hidden;background:#1a1a2e;color:#eee;font-family:sans-serif}\n#gameCanvas{background:#0f0f23;display:block;margin:0 auto}\n#hud{position:absolute;top:10px;left:10px;color:#fff;font-size:14px}\n#highScore{position:absolute;top:10px;right:10px;color:#ff6b6b}\n#timer{position:absolute;top:10px;right:150px;color:#4ecdc4;font-family:monospace}\n</style>\n</head>\n<body>\n<canvas id=\"gameCanvas\"></canvas>\n<div id=\"hud\">Lap: <span id=\"lap\">1/3</span> | Score: <span id=\"score\">0</span> | Lives: <span id=\"lives\">3</span></div>\n<div id=\"highScore\">Best: <span id=\"bestScore\">0</span></div>\n<div id=\"timer\">00:00</div>\n<script src=\"bundle.js\"></script>\n</body>\n</html>",
  "bundle.js": "class Vector2{constructor(x=0,y=0){this.x=x;this.y=y}add(v){return new Vector2(this.x+v.x,this.y+v.y)}sub(v){return new Vector2(this.x-v.x,this.y-v.y)}mul(s){return new Vector2(this.x*s,this.y*s)}len(){return Math.hypot(this.x,this.y)}norm(){const l=this.len();return l>0?this.mul(1/l):new Vector2()}\n}\nclass AudioManager{constructor(){this.audioCtx=new(window.AudioContext||window.webkitAudioContext)();this.sounds={}}\nplay(name){const osc=this.audioCtx.createOscillator();const gain=this.audioCtx.createGain();osc.type='sine';osc.frequency.setValueAtTime(220, this.audioCtx.currentTime);gain.gain.setValueAtTime(0.1, this.audioCtx.currentTime);osc.connect(gain);gain.connect(this.audioCtx.destination);osc.start();osc.stop(this.audioCtx.currentTime+0.1)}}\n}\nclass Player{constructor(){this.pos=new Vector2(100,300);this.vel=new Vector2();this.acc=new Vector2();this.speed=0;this.maxSpeed=5;this.boosting=false;this.boostTimer=0;this.boostCooldown=0;this.lives=3;this.score=0;this.fuel=100;this.color='#4ecdc4';this.sprite=new Vector2(0,0)}\nupdate(dt,keys){const F_ENGINE=0.15;const F_ROCKET=0.8;const DRAG=0.02;const FRICTION=0.05;let acc=new Vector2();if(keys.ArrowLeft||keys.A){acc.acc.x=-0.1}\nif(keys.ArrowRight||keys.D){acc.acc.x=0.1}\nif(this.boosting&&this.boostCooldown<=0){acc.acc.x+=F_ROCKET;this.boostTimer=2;this.boostCooldown=5}\nif(this.boostTimer>0){this.boostTimer-=dt;if(this.boostTimer<=0){this.boosting=false}}\nif(this.boostCooldown>0){this.boostCooldown-=dt}\nthis.vel=this.vel.mul(1-DRAG).add(acc.acc.mul(dt*60));if(this.vel.len()>this.maxSpeed){this.vel=this.vel.norm().mul(this.maxSpeed)}\nthis.pos=this.pos.add(this.vel);this.fuel=Math.max(0,this.fuel-0.01*dt*60)}\n}\nclass Game{constructor(){this.canvas=document.getElementById('gameCanvas');this.ctx=this.canvas.getContext('2d');this.resize();window.addEventListener('resize',()=>this.resize());this.keys={};this.player=new Player();this.audio=new AudioManager();this.highScore=localStorage.getItem('snailHighScore')||0;this.lastTime=0;this.timer=0;this.lap=1;this.totalLaps=3;this.running=true;document.addEventListener('keydown',e=>this.keys[e.key]=true);document.addEventListener('keyup',e=>this.keys[e.key]=false);requestAnimationFrame(t=>this.loop(t))}\nresize(){const w=800,h=600;const sw=Math.min(window.innerWidth,w);const sh=sw/w*h;this.canvas.width=sw;this.canvas.height=sh;this.canvas.style.transform='scale('+sw/w+')';this.canvas.style.transformOrigin='top left'}\nloop(timestamp){if(!this.lastTime)this.lastTime=timestamp;const dt=(timestamp-this.lastTime)/1000;this.lastTime=timestamp;if(this.running){this.update(dt);this.render();requestAnimationFrame(t=>this.loop(t))}}\nupdate(dt){const keys=this.keys;if(keys[' ']){this.player.boosting=true}if(keys['r']){}this.player.update(dt,keys);this.timer+=dt;document.getElementById('timer').textContent=this.formatTime(this.timer);document.getElementById('score').textContent=this.player.score;document.getElementById('lives').textContent=this.player.lives;document.getElementById('lap').textContent=this.lap+'/'+this.totalLaps;if(this.player.score>this.highScore){this.highScore=this.player.score;localStorage.setItem('snailHighScore',this.highScore);document.getElementById('bestScore').textContent=this.highScore}}\nrender(){const ctx=this.ctx;ctx.clearRect(0,0,this.canvas.width,this.canvas.height);ctx.fillStyle='#0f0f23';ctx.fillRect(0,0,this.canvas.width,this.canvas.height);ctx.fillStyle=this.player.color;ctx.fillRect(this.player.pos.x,this.player.pos.y-15,20,30);ctx.fillStyle='#fff';ctx.font='12px sans-serif';ctx.fillText('🐌',this.player.pos.x-5,this.player.pos.y-10)}\nformatTime(s){const m=Math.floor(s/60);const sec=Math.floor(s%60);return(m<10?'0':'')+m+':'+(sec<10?'0':'')+sec}\n}\nnew Game();"</arg>
