#game-container {
    position: relative;
    width: 100%;
    max-width: 800px;
    height: 600px;
    margin: 0 auto;
}

#game-canvas {
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.5);
    border-radius: 20px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
}

.glass-panel {
    background: var(--glass-bg);
    border: 1px solid var(--glass-border);
    border-radius: 15px;
    padding: 15px;
    backdrop-filter: blur(10px);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.2);
    color: var(--text-light);
}

#ui-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
}

.score-panel, .timer-panel, .next-animal-panel, .stability-panel {
    position: absolute;
    pointer-events: auto;
}

.score-panel {
    top: 20px;
    left: 20px;
}

.timer-panel {
    top: 20px;
    right: 20px;
}

.next-animal-panel {
    bottom: 20px;
    left: 20px;
}

.stability-panel {
    bottom: 20px;
    right: 20px;
    width: 200px;
}

#score {
    font-size: 24px;
    font-weight: bold;
    margin-bottom: 5px;
}

#combo {
    font-size: 16px;
}

#timer {
    font-size: 18px;
    font-family: 'Courier New', monospace;
}

#next-animal-preview {
    font-size: 40px;
    text-align: center;
}

#stability-meter {
    width: 100%;
    height: 20px;
    background: rgba(255, 255, 255, 0.2);
    border-radius: 10px;
    overflow: hidden;
}

#stability-fill {
    height: 100%;
    width: 100%;
    background: linear-gradient(to right, #ff6b6b, #4ecdc4);
    transition: width 0.3s;
}

#start-screen, #game-over-screen {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    text-align: center;
    width: 80%;
    max-width: 500px;
}

#start-screen h1, #game-over-screen h1 {
    font-size: 3em;
    margin-bottom: 20px;
    color: var(--accent);
    text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.5);
}

#start-screen p {
    font-size: 1.2em;
    margin-bottom: 30px;
}

button {
    background: var(--primary);
    color: white;
    border: none;
    padding: 12px 30px;
    font-size: 1.1em;
    border-radius: 50px;
    cursor: pointer;
    transition: all 0.3s;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
}

button:hover {
    background: var(--secondary);
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.3);
}

#final-score, #high-score {
    font-size: 1.5em;
    margin: 10px 0;
}

