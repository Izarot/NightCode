  "index.html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no\">\n    <title>NEO-MINERAL</title>\n    <link rel=\"icon\" href=\"data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ctext y='.9em' font-size='90'%3E%F0%9F%92%8E%3C/text%3E%3C/svg%3E\">\n    <style>\n        :root {\n            --bg: #0a0a12;\n            --neon-cyan: #00f0ff;\n            --neon-magenta: #ff0055;\n            --neon-amber: #ffaa00;\n        }\n        * { box-sizing: border-box; }\n        body {\n            margin: 0;\n            padding: 0;\n            overflow: hidden;\n            background-color: var(--bg);\n            color: var(--neon-cyan);\n            font-family: 'Courier New', Courier, monospace;\n            touch-action: none;\n        }\n        canvas {\n            display: block;\n            width: 100vw;\n            height: 100vh;\n        }\n        #ui {\n            position: absolute;\n            top: 0;\n            left: 0;\n            width: 100%;\n            height: 100%;\n            pointer-events: none;\n            padding: 20px;\n        }\n        .hud-timer {\n            position: absolute;\n            top: 20px;\n            left: 50%;\n            transform: translateX(-50%);\n            font-size: 28px;\n            font-weight: bold;\n            text-shadow: 0 0 15px var(--neon-cyan);\n            letter-spacing: 2px;\n        }\n        .hud-stats {\n            position: absolute;\n            bottom: 20px;\n            left: 20px;\n            font-size: 20px;\n            display: flex;\n            flex-direction: column;\n            gap: 5px;\n        }\n        .hud-highscore {\n            position: absolute;\n            bottom: 20px;\n            right: 20px;\n            font-size: 20px;\n            text-align: right;\n        }\n        .game-over {\n            position: absolute;\n            top: 50%;\n            left: 50%;\n            transform: translate(-50%, -50%);\n            text-align: center;\n            display: none;\n            background: rgba(10, 10, 18, 0.9);\n            border: 2px solid var(--neon-magenta);\n            padding: 40px;\n            box-shadow: 0 0 30px var(--neon-magenta);\n            pointer-events: auto;\n        }\n        .game-over h1 {\n            color: var(--neon-magenta);\n            margin: 0 0 20px 0;\n            font-size: 48px;\n            text-transform: uppercase;\n        }\n        .game-over p {\n            font-size: 24px;\n            margin: 0 0 30px 0;\n        }\n        button {\n            background: var(--neon-amber);\n            border: none;\n            color: #000;\n            padding: 15px 30px;\n            font-family: inherit;\n            font-size: 18px;\n            font-weight: bold;\n            cursor: pointer;\n            text-transform: uppercase;\n        }\n        button:hover {\n            filter: brightness(1.2);\n        }\n    </style>\n</head>\n<body>\n    <canvas id=\"gameCanvas\"></canvas>\n    <div id=\"ui\">\n        <div class=\"hud-timer\" id=\"timer\">00:00</div>\n        <div class=\"hud-stats\">\n            <div id=\"score\">CELLS: 0</div>\n            <div id=\"wave\">WAVE: 1</div>\n        </div>\n        <div class=\"hud-highscore\" id=\"highscore\">BEST: 0</div>\n        <div class=\"game-over\" id=\"gameOver\">\n            <h1>SYSTEM FAILURE</h1>\n            <p id=\"finalScore">TOTAL CELLS: 0</p>\n            <button onclick=\"location.reload()\">REBOOT SYSTEM</button>\n        </div>\n    </div>\n    <script src=\"src/main.js\"></script>\n</body>\n</html>",
  "src/main.js": "const canvas = document.getElementById('gameCanvas');\nconst ctx = canvas.getContext('2d');\nconst timerEl = document.getElementById('timer');\nconst scoreEl = document.getElementById('score');\nconst waveEl = document.getElementById('wave');\nconst highscoreEl = document.getElementById('highscore');\nconst gameOverEl = document.getElementById('gameOver');\nconst finalScoreEl = document.getElementById('finalScore');\n\n// --- CONFIG & PALETTE ---\nconst COLORS = {\n    bg: '#0a0a12',\n    player: '#00f0ff',\n    playerAccent: '#ffffff',\n    enemy: '#ff0055',\n    enemyAccent: '#ffffff',\n    ammo: '#ffaa00',\n    text: '#00f0ff',\n    wall: '#333344'\n};\n\nconst CONFIG = {\n    playerMaxSpeed: 350,\n    playerAccel: 2000,\n    playerFriction: 1800,\n    playerRadius: 16,\n    playerHp: 5,\n    bulletSpeed: 800,\n    bulletLife: 1.5,\n    shootCooldown: 0.25,\n    cellRegenRate: 0.01 // 1% per second\n};\n\n// --- STATE ---\nlet width, height;\nlet gameActive = true;\nlet gameOver = false;\nlet score = 0;\nlet wave = 1;\nlet waveTimer = 0;\nlet waveSpawnInterval = 2;\nlet startTime = Date.now();\nlet highScore = parseInt(localStorage.getItem('neo_mineral_highscore') || '0', 10);\nhighscoreEl.textContent = `BEST: ${highScore}`;\n\nlet screenShake = 0;\nlet particles = [];\nlet bullets = [];\nlet enemies = [];\nlet cells = 0;\nlet ammo = 10;\nlet maxAmmo = 10;\n\n// --- INPUT ---\nconst keys = {};\nconst mouse = { x: 0, y: 0, down: false };\n\nwindow.addEventListener('keydown', e => keys[e.code] = true);\nwindow.addEventListener('keyup', e => keys[e.code] = false);\nwindow.addEventListener('mousemove', e => {\n    const rect = canvas.getBoundingClientRect();\n    mouse.x = e.clientX - rect.left;\n    mouse.y = e.clientY - rect.top;\n});\nwindow.addEventListener('mousedown', () => mouse.down = true);\nwindow.addEventListener('mouseup', () => mouse.down = false);\ncanvas.addEventListener('touchstart', e => {\n    e.preventDefault();\n    const rect = canvas.getBoundingClientRect();\n    mouse.x = e.touches[0].clientX - rect.left;\n    mouse.y = e.touches[0].clientY - rect.top;\n    mouse.down = true;\n}, {passive: false});\ncanvas.addEventListener('touchmove', e => {\n    e.preventDefault();\n    const rect = canvas.getBoundingClientRect();\n    mouse.x = e.touches[0].clientX - rect.left;\n    mouse.y = e.touches[0].clientY - rect.top;\n}, {passive: false});\ncanvas.addEventListener('touchend', () => mouse.down = false);\n\n// --- AUDIO (WEB AUDIO API) ---\nconst AudioCtx = window.AudioContext || window.webkitAudioContext;\nconst audioCtx = new AudioCtx();\n\nfunction playSfx(type) {\n    if (audioCtx.state === 'suspended') audioCtx.resume();\n    const osc = audioCtx.createOscillator();\n    const gain = audioCtx.createGain();\n    osc.connect(gain);\n    gain.connect(audioCtx.destination);\n    const now = audioCtx.currentTime;\n\n    if (type === 'shoot') {\n        osc.type = 'square';\n        osc.frequency.setValueAtTime(300, now);\n        osc.frequency.exponentialRampToValueAtTime(100, now + 0.1);\n        gain.gain.setValueAtTime(0.05, now);\n        gain.gain.exponentialRampToValueAtTime(0.01, now + 0.1);\n        osc.start(now); osc.stop(now + 0.1);\n    } else if (type === 'hit') {\n        osc.type = 'sawtooth';\n        osc.frequency.setValueAtTime(150, now);\n        osc.frequency.exponentialRampToValueAtTime(50, now + 0.1);\n        gain.gain.setValueAtTime(0.1, now);\n        gain.gain.exponentialRampToValueAtTime(0.01, now + 0.1);\n        osc.start(now); osc.stop(now + 0.1);\n    } else if (type === 'explode') {\n        osc.type = 'sawtooth';\n        osc.frequency.setValueAtTime(100, now);\n        osc.frequency.exponentialRampToValueAtTime(10, now + 0.3);\n        gain.gain.setValueAtTime(0.2, now);\n        gain.gain.exponentialRampToValueAtTime(0.01, now + 0.3);\n        osc.start(now); osc.stop(now + 0.3);\n    } else if (type === 'collect') {\n        osc.type = 'sine';\n        osc.frequency.setValueAtTime(800, now);\n        osc.frequency.exponentialRampToValueAtTime(1600, now + 0.1);\n        gain.gain.setValueAtTime(0.1, now);\n        gain.gain.exponentialRampToValueAtTime(0.01, now + 0.1);\n        osc.start(now); osc.stop(now + 0.1);\n    }\n}\n\n// --- RESIZE ---\nfunction resize() {\n    width = window.innerWidth;\n    height = window.innerHeight;\n    canvas.width = width;\n    canvas.height = height;\n}\nwindow.addEventListener('resize', resize);\nresize();\n\n// --- CLASSES ---\nclass Player {\n    constructor() {\n        this.x = width / 2;\n        this.y = height / 2;\n        this.vx = 0;\n        this.vy = 0;\n        this.radius = CONFIG.playerRadius;\n        this.hp = CONFIG.playerHp;\n        this.maxHp = CONFIG.playerHp;\n        this.angle = 0;\n        this.shootTimer = 0;\n        this.invuln = 0;\n    }\n    update(dt) {\n        // Movement\n        let ax = 0, ay = 0;\n        if (keys['KeyW'] || keys['ArrowUp']) ay = -1;\n        if (keys['KeyS'] || keys['ArrowDown']) ay = 1;\n        if (keys['KeyA'] || keys['ArrowLeft']) ax = -1;\n        if (keys['KeyD'] || keys['ArrowRight']) ax = 1;\n\n        const len = Math.sqrt(ax*ax + ay*ay);\n        if (len > 0) {\n            ax /= len; ay /= len;\n        }\n\n        const accel = CONFIG.playerAccel;\n        this.vx += ax * accel * dt;\n        this.vy += ay * accel * dt;\n\n        // Friction\n        const friction = CONFIG.playerFriction;\n        this.vx *= (1 - friction * dt);\n        this.vy *= (1 - friction * dt);\n\n        // Clamp speed\n        const speed = Math.sqrt(this.vx*this.vx + this.vy*this.vy);\n        if (speed > CONFIG.playerMaxSpeed) {\n            this.vx = (this.vx / speed) * CONFIG.playerMaxSpeed;\n            this.vy = (this.vy / speed) * CONFIG.playerMaxSpeed;\n        }\n\n        this.x += this.vx * dt;\n        this.y += this.vy * dt;\n\n        // Bounds\n        this.x = Math.max(this.radius, Math.min(width - this.radius, this.x));\n        this.y = Math.max(this.radius, Math.min(height - this.radius, this.y));\n\n        // Aim\n        const dx = mouse.x - this.x;\n        const dy = mouse.y - this.y;\n        this.angle = Math.atan2(dy, dx);\n\n        // Shooting\n        if (this.shootTimer > 0) this.shootTimer -= dt;\n        if (mouse.down && this.shootTimer <= 0 && ammo > 0) {\n            this.shoot();\n        }\n\n        // Passive ammo regen\n        if (ammo < maxAmmo) {\n            ammo += CONFIG.cellRegenRate * maxAmmo * dt;\n            if (ammo > maxAmmo) ammo = maxAmmo;\n        }\n\n        if (this.invuln > 0) this.invuln -= dt;\n    }\n    shoot() {\n        ammo--;\n        this.shootTimer = CONFIG.shootCooldown;\n        playSfx('shoot');\n        bullets.push(new Bullet(this.x, this.y, this.angle, 'player'));\n        screenShake = 0.1;\n    }\n    draw() {\n        if (this.invuln > 0 && Math.floor(Date.now() / 100) % 2 === 0) return;\n        ctx.save();\n        ctx.translate(this.x, this.y);\n        ctx.rotate(this.angle);\n        // Body\n        ctx.fillStyle = COLORS.player;\n        ctx.beginPath();\n        ctx.arc(0, 0, this.radius, 0, Math.PI * 2);\n        ctx.fill();\n        // Cockpit\n        ctx.fillStyle = COLORS.playerAccent;\n        ctx.beginPath();\n        ctx.arc(10, 0, 6, 0, Math.PI * 2);\n        ctx.fill();\n        // Thruster\n        ctx.fillStyle = '#0044ff';\n        ctx.beginPath();\n        ctx.arc(-12, 0, 8, 0, Math.PI * 2);\n        ctx.fill();\n        ctx.restore();\n\n        // Health Bar\n        const barW = 40;\n        const barH = 6;\n        ctx.fillStyle = '#333';\n        ctx.fillRect(this.x - barW/2, this.y - this.radius - 12, barW, barH);\n        ctx.fillStyle = COLORS.player;\n        ctx.fillRect(this.x - barW/2, this.y - this.radius - 12, (this.hp / this.maxHp) * barW, barH);\n    }\n}\n\nclass Enemy {\n    constructor(type) {\n        this.type = type; // 'swarmer', 'shooter', 'heavy'\n        this.spawn();\n        this.vx = 0;\n        this.vy = 0;\n        this.angle = 0;\n        this.shootTimer = 0;\n    }\n    spawn() {\n        // Spawn outside screen\n        const side = Math.floor(Math.random() * 4);\n        if (side === 0) { this.x = Math.random() * width; this.y = -50; }\n        else if (side === 1) { this.x = width + 50; this.y = Math.random() * height; }\n        else if (side === 2) { this.x = Math.random() * width; this.y = height + 50; }\n        else { this.x = -50; this.y = Math.random() * height; }\n\n        if (this.type === 'swarmer') {\n            this.radius = 14;\n            this.hp = 1;\n            this.maxHp = 1;\n            this.speed = 150 + (wave * 10);\n            this.damage = 1;\n            this.color = COLORS.enemy;\n        } else if (this.type === 'shooter') {\n            this.radius = 16;\n            this.hp = 2;\n            this.maxHp = 2;\n            this.speed = 100 + (wave * 5);\n            this.damage = 1;\n            this.color = '#ff00aa';\n        } else if (this.type === 'heavy') {\n            this.radius = 24;\n            this.hp = 5 + wave;\n            this.maxHp = this.hp;\n            this.speed = 60 + (wave * 2);\n            this.damage = 2;\n            this.color = '#aa00ff';\n        }\n    }\n    update(dt, player) {\n        const dx = player.x - this.x;\n        const dy = player.y - this.y;\n        const dist = Math.sqrt(dx*dx + dy*dy);\n        this.angle = Math.atan2(dy, dx);\n\n        if (this.type === 'shooter' && dist > 200) {\n            // Move towards but stop at range\n            const moveSpeed = this.speed;\n            this.vx = (dx / dist) * moveSpeed;\n            this.vy = (dy / dist) * moveSpeed;\n            this.shootTimer -= dt;\n            if (this.shootTimer <= 0 && dist < 400) {\n                this.shootTimer = 1.5;\n                bullets.push(new Bullet(this.x, this.y, this.angle, 'enemy'));\n            }\n        } else {\n            const moveSpeed = this.speed;\n            this.vx = (dx / dist) * moveSpeed;\n            this.vy = (dy / dist) * moveSpeed;\n        }\n\n        this.x += this.vx * dt;\n        this.y += this.vy * dt;\n\n        // Collision with player\n        if (dist < this.radius + player.radius && player.invuln <= 0) {\n            player.hp -= this.damage * dt * 2;\n            player.invuln = 0.5;\n            screenShake = 0.2;\n            if (player.hp <= 0) endGame();\n        }\n    }\n    draw() {\n        ctx.save();\n        ctx.translate(this.x, this.y);\n        ctx.rotate(this.angle);\n        ctx.fillStyle = this.color;\n        ctx.beginPath();\n        ctx.arc(0, 0, this.radius, 0, Math.PI * 2);\n        ctx.fill();\n        ctx.strokeStyle = COLORS.enemyAccent;\n        ctx.lineWidth = 2;\n        ctx.stroke();\n        // Eye\n        ctx.fillStyle = '#000';\n        ctx.beginPath();\n        ctx.arc(8, 0, 4, 0, Math.PI * 2);\n        ctx.fill();\n        ctx.restore();\n    }\n}\n\nclass Bullet {\n    constructor(x, y, angle, owner) {\n        this.x = x;\n        this.y = y;\n        this.angle = angle;\n        this.owner = owner;\n        this.life = CONFIG.bulletLife;\n        this.speed = CONFIG.bulletSpeed;\n        this.radius = 4;\n    }\n    update(dt) {\n        this.x += Math.cos(this.angle) * this.speed * dt;\n        this.y += Math.sin(this.angle) * this.speed * dt;\n        this.life -= dt;\n    }\n    draw() {\n        ctx.fillStyle = this.owner === 'player' ? COLORS.ammo : '#ff4444';\n        ctx.beginPath();\n        ctx.arc(this.x, this.y, this.radius, 0, Math.PI * 2);\n        ctx.fill();\n    }\n}\n\nclass Particle {\n    constructor(x, y, color) {\n        this.x = x;\n        this.y = y;\n        this.color = color;\n        this.vx = (Math.random() - 0.5) * 300;\n        this.vy = (Math.random() - 0.5) * 300;\n        this.life = 0.5;\n        this.maxLife = 0.5;\n    }\n    update(dt) {\n        this.x += this.vx * dt;\n        this.y += this.vy * dt;\n        this.life -= dt;\n    }\n    draw() {\n        ctx.globalAlpha = this.life / this.maxLife;\n        ctx.fillStyle = this.color;\n        ctx.fillRect(this.x, this.y, 4, 4);\n        ctx.globalAlpha = 1;\n    }\n}\n\n// --- GAME LOGIC ---\nconst player = new Player();\n\nfunction spawnEnemy() {\n    const types = ['swarmer', 'swarmer', 'shooter', 'heavy'];\n    const type = types[Math.floor(Math.random() * types.length)];\n    if (wave > 3 && Math.random() < 0.3) type ='heavy';\n    enemies.push(new Enemy(type));\n}\n\nfunction endGame() {\n    gameOver = true;\n    gameActive = false;\n    if (score > highScore) {\n        highScore = score;\n        localStorage.setItem('neo_mineral_highscore', highScore.toString());\n        highscoreEl.textContent = `BEST: ${highScore}`;\n    }\n    finalScoreEl.textContent = `TOTAL CELLS: ${score}`;\n    gameOverEl.style.display = 'block';\n}\n\nfunction resetGame() {\n    score = 0;\n    wave = 1;\n    waveTimer = 0;\n    waveSpawnInterval = 2;\n    cells = 0;\n    ammo = maxAmmo;\n    bullets = [];\n    enemies = [];\n    particles = [];\n    player.x = width / 2;\n    player.y = height / 2;\n    player.vx = 0;\n    player.vy = 0;\n    player.hp = player.maxHp;\n    gameOver = false;\n    gameActive = true;\n    gameOverEl.style.display = 'none';\n    startTime = Date.now();\n    scoreEl.textContent = `CELLS: ${score}`;\n    waveEl.textContent = `WAVE: ${wave}`;\n    timerEl.textContent = `00:00`;\n}\n\nfunction update(dt) {\n    if (!gameActive) return;\n    \n    player.update(dt);\n    \n    // Wave timer\n    waveTimer += dt;\n    if (waveTimer >= waveSpawnInterval) {\n        waveTimer = 0;\n        waveSpawnInterval = Math.max(0.5, waveSpawnInterval - 0.05);\n        spawnEnemy();\n        if (Math.random() < 0.3) spawnEnemy();\n    }\n    \n    // Update bullets\n    for (let i = bullets.length - 1; i >= 0; i--) {\n        bullets[i].update(dt);\n        if (bullets[i].life <= 0) {\n            bullets.splice(i, 1);\n            continue;\n        }\n    }\n    \n    // Update enemies\n    for (let i = enemies.length - 1; i >= 0; i--) {\n        enemies[i].update(dt, player);\n        if (enemies[i].hp <= 0) {\n            for (let j = 0; j < 8; j++) {\n                particles.push(new Particle(enemies[i].x, enemies[i].y, enemies[i].color));\n            }\n            playSfx('explode');\n            score += 10;\n            cells += 1;\n            ammo = Math.min(maxAmmo, ammo + 1);\n            enemies.splice(i, 1);\n            scoreEl.textContent = `CELLS: ${cells}`;\n            continue;\n        }\n    }\n    \n    // Update particles\n    for (let i = particles.length - 1; i >= 0; i--) {\n        particles[i].update(dt);\n        if (particles[i].life <= 0) particles.splice(i, 1);\n    }\n    \n    // Bullet collisions\n    for (let i = bullets.length - 1; i >= 0; i--) {\n        const b = bullets[i];\n        if (b.owner === 'player') {\n            for (let j = enemies.length - 1; j >= 0; j--) {\n                const e = enemies[j];\n                const dx = b.x - e.x;\n                const dy = b.y - e.y;\n                if (dx*dx + dy*dy < (b.radius + e.radius)*(b.radius + e.radius)) {\n                    e.hp--;\n                    b.life = 0;\n                    playSfx('hit');\n                    break;\n                }\n            }\n        } else {\n            const dx = b.x - player.x;\n            const dy = b.y - player.y;\n            if (dx*dx + dy*dy < (b.radius + player.radius)*(b.radius + player.radius) && player.invuln <= 0) {\n                player.hp -= 1;\n                player.invuln = 1;\n                b.life = 0;\n                screenShake = 0.3;\n                playSfx('hit');\n                if (player.hp <= 0) endGame();\n            }\n        }\n    }\n    \n    // Timer\n    const elapsed = Math.floor((Date.now() - startTime) / 1000);\n    const m = Math.floor(elapsed / 60).toString().padStart(2, '0');\n    const s = (elapsed % 60).toString().padStart(2, '0');\n    timerEl.textContent = `${m}:${s}`;\n    \n    waveEl.textContent = `WAVE: ${wave}`;\n}\n\nfunction draw() {\n    ctx.fillStyle = COLORS.bg;\n    ctx.fillRect(0, 0, width, height);\n    \n    // Apply screen shake\n    if (screenShake > 0) {\n        const shakeX = (Math.random() - 0.5) * screenShake * 20;\n        const shakeY = (Math.random() - 0.5) * screenShake * 20;\n        ctx.translate(shakeX, shakeY);\n        screenShake *= 0.9;\n        if (screenShake < 0.01) screenShake = 0;\n    }\n    \n    // Draw grid\n    ctx.strokeStyle = '#1a1a2e';\n    ctx.lineWidth = 1;\n    const gridSize = 50;\n    const offsetX = (player.x * 0.5) % gridSize;\n    const offsetY = (player.y * 0.5) % gridSize;\n    for (let x = offsetX; x < width; x += gridSize) {\n        ctx.beginPath();\n        ctx.moveTo(x, 0);\n        ctx.lineTo(x, height);\n        ctx.stroke();\n    }\n    for (let y = offsetY; y < height; y += gridSize) {\n        ctx.beginPath();\n        ctx.moveTo(0, y);\n        ctx.lineTo(width, y);\n        ctx.stroke();\n    }\n    \n    // Draw bullets\n    bullets.forEach(b => b.draw());\n    \n    // Draw enemies\n    enemies.forEach(e => e.draw());\n    \n    // Draw player\n    player.draw();\n    \n    // Draw particles\n    particles.forEach(p => p.draw());\n}\n\nfunction loop() {\n    const now = Date.now();\n    const dt = Math.min((now - (loop.last || now)) / 1000, 0.1);\n    loop.last = now;\n    \n    update(dt);\n    draw();\n    \n    requestAnimationFrame(loop);\n}\n\nloop();\n"\n}