ACCEL_UP: 0.5,         // Vertical acceleration (px/frame²)\n        GRAVITY: 0.3,          // Downward gravity (px/frame²)\n        TERMINAL_VELOCITY: 8,  // Max downward speed\n        AIR_RESISTANCE: 0.95,  // Multiplier when no input (0.95x)\n        BOOST_DURATION: 3,     // Seconds of boost cooldown\n        BOOST_SPEED_MULTIPLIER: 1.5,\n        CLOSURE_INITIAL: 0.2,  // Starting wall closure rate (px/frame)\n        CLOSURE_INCREMENT_PER_10S: 0.01,\n        MIN_GAP: 50,           // Minimum vertical gap (px)\n        MAX_GAP: 150,          // Maximum vertical gap (px)\n    },\n    \n    // Game Parameters\n    GAME: {\n        WIDTH: 800,\n        HEIGHT: 600,\n        FPS: 60,\n        PLAYER_SPEED: 1.2,\n        LIFE_START: 3,\n        SCORE_BASE: 10,\n        OBSTACLE_SPAWN_RATE: 0.05, // Per second\n        POWERUP_CHANCE: 0.05,       // 5% per second\n    },\n    \n    // Difficulty Scaling\n    DIFFICULTY: {\n        EARLY: { speed: 0.20, gaps: [80, 120, 160] },\n        MIDDLE: { speed: 0.35, gaps: [60, 90, 130] },\n        LATE:   { speed: 0.55, gaps: [40, 70, 110] }\n    },\n};\n\n// Load high score from LocalStorage\nfunction loadHighScore() {\n    try {\n        const score = localStorage.getItem(\'cavenrunner_highscore\');\n        return score ? parseInt(score, 10) : 0;\n    } catch (e) {\n        return 0;\n    }\n}\n\nfunction saveHighScore(score) {\n    try {\n        localStorage.setItem(\'cavenrunner_highscore\', score.toString());\n    } catch (e) {\n        console.warn(\'Failed to save high score\');\n    }\n}\n\n// Get current difficulty level based on time\nlet currentLevel = CONFIG.DIFFICULTY.MIDDLE;\nfunction getCurrentLevel() {\n    if (!window.gameTime) return currentLevel;\n    const elapsed = Math.floor(window.gameTime.elapsedSeconds);\n    if (elapsed >= 15 && elapsed < 30) currentLevel = CONFIG.DIFFICULTY.LATE;\n    else if (elapsed >= 30) currentLevel = CONFIG.DIFFICULTY.LATE;\n    return currentLevel;\n}\n\n// Update difficulty based on elapsed time\nwindow.addEventListener('load', () => {\n    updateDifficulty();\n});\n\nfunction updateDifficulty() {\n    const level = getCurrentLevel();\n    if (level !== currentLevel) {\n        currentLevel = level;\n        // Adjust parameters based on new difficulty\n        CONFIG.PHYSICS.CLOSURE_INITIAL = CONFIG.PHYSICS.CLOSURE_INITIAL + (level === CONFIG.DIFFICULTY.LATE ? 0.02 : 0);\n        CONFIG.GAME.SPEED = CONFIG.GAME.SPEED * (level === CONFIG.DIFFICULTY.LATE ? 1.5 : 1);\n    }\n}\n')]<|tool_call_end|>User Safety: safe