id=\"uiOverlay\">\n        <div class=\"hud-element\" id=\"speedometer\">\n            <div id=\"speedFill\"></div>\n        </div>\n        <div class=\"hud-element\" id=\"scoreDisplay\">0</div>\n        <div class=\"hud-element\" id=\"timer\">⏱️ 00:00</div>\n        <div class=\"hud-element\" id=\"highScore\">HI: 0</div>\n        <div id=\"powerUpSlots\">\n            <div class=\"powerup-slot\" data-slot=\"0\"></div>\n            <div class=\"powerup-slot\" data-slot=\"1\"></div>\n            <div class=\"powerup-slot\" data-slot=\"2\"></div>\n            <div class=\"powerup-slot\" data-slot=\"3\"></div>\n            <div class=\"powerup-slot\" data-slot=\"4\"></div>\n        </div>\n    </div>\n    <div id=\"gameOver\">\n        <h1>GAME OVER</h1>\n        <p id=\"finalScore\">Score: 0</p>\n        <button onclick=\"restartGame()\">Play Again</button>\n    </div>\n    <div id=\"mainMenu\">\n        <h1>Luminous Dash</h1>\n        <button onclick=\"startGame()\">START</button>\n    </div>\n    <script src=\"game.js\"></script>\n</body>\n</html>\n\", \"game.js\": \"const canvas = document.getElementById('gameCanvas');\nconst ctx = canvas.getContext('2d');\n\nlet width, height;\nlet player = { x: 0, y: 0, radius: 15, speed: 0, maxSpeed: 8, angle: 0 };\nlet obstacles = [];\nlet particles = [];\nlet score = 0;\nlet highScore = 0;\nlet gameTime = 0;\nlet startTime = 0;\nlet isRunning = false;\nlet powerUps = [];\nconst POWERUP_TYPES = ['shield', 'speed', 'score'];\nconst POWERUP_DURATION = 10000;\n\nfunction init() {\n    resizeCanvas();\n    window.addEventListener('resize', resizeCanvas);\n    document.addEventListener('keydown', handleKey);\n    document.addEventListener('mousemove', handleMouse);\n    resetGame();\n}\n\nfunction resizeCanvas() {\n    width = canvas.width = window.innerWidth;\n    height = canvas.height = window.innerHeight;\n    player.x = width / 2;\n    player.y = height / 2;\n}\n\nfunction resetGame() {\n    player = { x: width/2, y: height/2, radius: 15, speed: 0, maxSpeed: 8, angle: 0 };\n    obstacles = [];\n    particles = [];\n    score = 0;\n    gameTime = 0;\n        startTime = 0;\n    isRunning = false;\n    powerUps = [];\n    document.getElementById('scoreDisplay').textContent = '0';\n    document.getElementById('highScore').textContent = 'HI: ' + highScore;\n    document.getElementById('speedFill').style.width = '0%';\n    document.getElementById('mainMenu').style.display = 'flex';\n    document.getElementById('gameOver').style.display = 'none';\n    document.getElementById('timer').textContent = '⏱️ 00:00';\n}\n\nfunction startGame() {\n    resetGame();\n    isRunning = true;\n    startTime = Date.now();\n    document.getElementById('mainMenu').style.display = 'none';\n    gameLoop();\n}\n\nfunction restartGame() {\n    highScore = Math.max(highScore, score);\n    resetGame();\n    startGame();\n}\n\nfunction handleKey(e) {\n    if (e.key === ' ') {\n        player.speed = player.maxSpeed;\n    }\n}\n\nfunction handleMouse(e) {\n    const dx = e.clientX - player.x;\n    const dy = e.clientY - player.y;\n    player.angle = Math.atan2(dy, dx);\n}\n\nfunction update(delta) {\n    if (!isRunning) return;\n    \n    gameTime += delta;\n    const seconds = Math.floor(gameTime / 1000);\n    const mins = Math.floor(seconds / 60);\n    const secs = seconds % 60;\n    document.getElementById('timer').textContent = '⏱️ ' + String(mins).padStart(2, '0') + ':' + String(secs).padStart(2, '0');\n    \n    player.x += Math.cos(player.angle) * player.speed * delta * 0.01;\n    player.y += Math.sin(player.angle) * player.speed * delta * 0.01;\n    player.speed *= 0.98;\n    \n    if (player.x < 0 || player.x > width || player.y < 0 || player.y > height) {\n        gameOver();\n        return;\n    }\n    \n    for (let i = obstacles.length - 1; i >= 0; i--) {\n        const obs = obstacles[i];\n        obs.x += obs.dx;\n        obs.y += obs.dy;\n        \n        if (dist(player.x, player.y, obs.x, obs.y) < player.radius + obs.radius) {\n            gameOver();\n            return;\n        }\n        \n        if (obs.x < -100 || obs.x > width + 100 || obs.y < -100 || obs.y > height + 100) {\n            obstacles.splice(i, 1);\n        }\n    }\n    \n    for (let i = powerUps.length - 1; i >= 0; i--) {\n        const pu = powerUps[i];\n        pu.x += pu.dx;\n        pu.y += pu.dy;\n        \n        if (dist(player.x, player.y, pu.x, pu.y) < player.radius + pu.radius) {\n            activatePowerUp(pu.type);\n            powerUps.splice(i, 1);\n        }\n        \n        if (pu.x < -100 || pu.x > width + 100 || pu.y < -100 || pu.y > height + 100) {\n            powerUps.splice(i, 1);\n        }\n    }\n    \n    const speedPercent = Math.min(100, (player.speed / player.maxSpeed) * 100);\n    document.getElementById('speedFill').style.width = speedPercent + '%';\n    \n    score = Math.floor(gameTime * 0.1);\n    document.getElementById('scoreDisplay').textContent = score;\n}\n\nfunction dist(x1, y1, x2, y2) {\n    return Math.sqrt((x2 - x1)**2 + (y2 - y1)**2);\n}\n\nfunction spawnObstacle() {\n    const side = Math.floor(Math.random() * 4);\n    let x, y, dx, dy;\n    \n    if (side === 0) { x = Math.random() * width; y = -50; dx = 0; dy = 4; }\n    else if (side === 1) { x = width + 50; y = Math.random() * height; dx = -4; dy = 0; }\n    else if (side === 2) { x = Math.random() * width; y = height + 50; dx = 0; dy = -4; }\n    else { x = -50; y = Math.random() * height; dx = 4; dy = 0; }\n    \n    obstacles.push({ x, y, radius: 20, dx, dy });\n}\n\nfunction spawnPowerUp() {\n    const x = Math.random() * width;\n    const y = Math.random() * height;\n    const type = POWERUP_TYPES[Math.floor(Math.random() * POWERUP_TYPES.length)];\n    powerUps.push({ x, y, radius: 15, dx: 0, dy: 0, type });\n}\n\nfunction activatePowerUp(type) {\n    const slot = document.querySelector('.powerup-slot:not(.active):not(.cooldown)');\n    if (!slot) return;\n    \n    slot.classList.add('active');\n    slot.textContent = type === 'shield' ? '🛡' : type === 'speed' ? '⚡' : '💎';\n    \n    setTimeout(() => {\n        slot.classList.remove('active');\n        slot.classList.add('cooldown');\n        setTimeout(() => slot.classList.remove('cooldown'), POWERUP_DURATION);\n    }, POWERUP_DURATION);\n    \n    if (type === 'shield') {\n        setTimeout(() => {}, POWERUP_DURATION);\n    } else if (type === 'speed') {\n        player.maxSpeed *= 1.5;\n        setTimeout(() => { player.maxSpeed = 8; }, POWERUP_DURATION);\n    }\n}\n\nfunction gameOver() {\n    isRunning = false;\n    document.getElementById('gameOver').style.display = 'block';\n    document.getElementById('finalScore').textContent = 'Score: ' + score;\n}\n\nfunction draw() {\n    ctx.fillStyle = 'rgba(0, 0, 0, 0.1)';\n    ctx.fillRect(0, 0, width, height);\n    \n    ctx.fillStyle = '#00ffff';\n    ctx.beginPath();\n    ctx.arc(player.x, player.y, player.radius, 0, Math.PI * 2);\n    ctx.fill();\n    \n    ctx.fillStyle = '#ff00ff';\n    for (const obs of obstacles) {\n        ctx.beginPath();\n        ctx.arc(obs.x, obs.y, obs.radius, 0, Math.PI * 2);\n        ctx.fill();\n    }\n    \n    ctx.fillStyle = '#00ff88';\n    for (const pu of powerUps) {\n        ctx.beginPath();\n        ctx.arc(pu.x, pu.y, pu.radius, 0, Math.PI * 2);\n        ctx.fill();\n    }\n    \n    for (const p of particles) {\n        ctx.fillStyle = p.color;\n        ctx.globalAlpha = p.alpha;\n        ctx.beginPath();\n        ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);\n        ctx.fill();\n    }\n    ctx.globalAlpha = 1;\n}\n\nlet lastSpawn = 0;\nlet lastPowerUp = 0;\n\nfunction gameLoop(timestamp) {\n    if (!startTime) startTime = timestamp;\n    const delta = timestamp - startTime;\n    startTime = timestamp;\n    \n    update(delta);\n    draw();\n    \n    lastSpawn += delta;\n    lastPowerUp += delta;\n    \n    if (lastSpawn > 1000) {\n        spawnObstacle();\n        lastSpawn = 0;\n    }\n    \n    if (lastPowerUp > 5000) {\n        spawnPowerUp();\n        lastPowerUp = 0;\n    }\n    \n    if (isRunning) {\n        requestAnimationFrame(gameLoop);\n    }\n}\n\ninit();\n"}
