  update(dt, platforms, buttons) {
    // Verlet integration
    const ax = keys.left ? -MOVE_ACCEL : (keys.right ? MOVE_ACCEL : 0);
    const ay = 0; // gravity handled separately
    
    // Apply gravity
    this.vy += this.gravityDir.y * GRAVITY_STRENGTH * dt * 60;
    
    // Friction
