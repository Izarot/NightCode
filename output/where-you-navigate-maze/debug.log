 src=\"./js/main.js\"></script>\n</body>\n</html>\n", "js/config.js": "export const CONFIG = {\n  // Maze\n  MAZE_W: 30,\n  MAZE_H: 30,\n  CELL: 20,            // 30*20 = 600 logical\n  WALL_THICK: 4,\n  WALL_SHADOW: 1,\n  SYMMETRY_BREAK_PCT: 0.04, // 4% inner walls removed\n\n  // Player\n  PLAYER_SIZE: 14,\n  PLAYER_LERP: 0.25,\n  PLAYER_SPEED: 6,     // cells / sec\n  PLAYER_DASH_SPEED: 9,\n  PLAYER_DASH_DURATION: 1.5,\n  PLAYER_DASH_COOLDOWN: 15,\n  PLAYER_DASH_RAMP: 0.2, // sec\n  TRAIL_LIFE: 0.4, // sec\n\n  // Glitch\n  GLITCH_SIZE: 16,\n  GLITCH_SPEED_BASE: 4,\n  GLITCH_SPEED_STEP: 0.5,\n  GLITCH_SPEED_STEP_TIME: 10,\n  GLITCH_SPEED_MAX: 8,\n  GLITCH_REPATH_TIME: 0.5,\n  GLITCH_HIT_KNOCKBACK: 2, // cells\n  GLITCH_PROX_VIGNETTE: 6, // cells\n  GLITCH_WARN: 3, // cells\n\n  // Fragments\n  FRAG_SIZE: 12,\n  FRAG_RADIUS: 12,\n  FRAG_ROT_SPEED: Math.PI, // rad / sec (45°/sec * 4 to scale)\n  FRAG_PARTICLES_PER_SEC: 6,\n  FRAG_FLASH_DUR: 0.08,\n\n  // Exit\n  EXIT_RING_MIN: 10,\n  EXIT_RING_MAX: 14,\n  EXIT_RING_HZ: 2,\n\n  // Loop\n  HIT_LIMIT: 5, // hard loss\n  FRAGMENT_TOTAL: 4,\n\n  // Palette\n  COLORS: {\n    bg: '#0A0E27',\n    bgDeep: '#070924',\n    wall: '#2A3556',\n    wallShadow: '#161C36',\n    playerCore: '#FFFFFF',\n    playerOutline: '#00F0FF',\n    glitch: '#FF1F8F',\n    glitchAlt: '#FF2A5E',\n    fragment: '#00F0FF',\n    fragmentCore: '#FFFFFF',\n    exit: '#FFFFFF',\n    exitInactive: '#5A6280',\n    star: '#7DF9FF',\n    grid: '#1A2150',\n    vignette: '#FF2A5E'\n  },\n\n  // HUD sizes (logical)\n  HUD_FONT: 'bold 14px \"Courier New\", monospace',\n  HUD_FONT_BIG: 'bold 28px \"Courier New\", monospace',\n  MINIMAP: 96,\n\n  // Canvas\n  LOGICAL_W: 800,\n  LOGICAL_H: 800,\n\n  // Audio\n  AUDIO_FOOT_VOL: 0.06,\n  AUDIO_PICKUP_VOL: 0.18,\n  AUDIO_DRONE_VOL: 0.12,\n  AUDIO_SHIMMER_VOL: 0.10\n};\n", "js/rng.js": "// Mulberry32 seeded RNG + daily seed derivation\nexport function mulberry32(seed){\n  let a = seed >>> 0;\n  return function(){\n    a = (a + 0x6D2B79F5) >>> 0;\n    let t = a;\n    t = Math.imul(t ^ (t >>> 15), t | 1);\n    t ^= t + Math.imul(t ^ (t >>> 7), t | 61);\n    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;\n  };\n}\n\nexport function dailySeed(){\n  // date in user's local time; format YYYYMMDD\n  const d = new Date();\n  return d.getFullYear() * 10000 + (d.getMonth()+1)*100 + d.getDate();\n}\n\nexport function hashString(str){\n  let h = 2166136261 >>> 0;\n  for(let i=0;i<str.length;i++){\n    h ^= str.charCodeAt(i);\n    h = Math.imul(h, 16777619);\n  }\n  return h >>> 0;\n}\n", "js/storage.js": "// LocalStorage wrapper with safety\nconst KEY_BEST = 'tmn.bestTime';\nconst KEY_HITS = 'tmn.bestFragments';\nconst KEY_HARD = 'tmn.hardMode';\nconst KEY_SEED = 'tmn.dailySeed';\n\nexport const storage = {\n  getBestTime(){\n    try{ const v = localStorage.getItem(KEY_BEST); return v ? parseFloat(v) : null; }catch(e){ return null; }\n  },\n  setBestTime(t){\n    try{ localStorage.setItem(KEY_BEST, String(t)); }catch(e){}\n  },\n  getBestFragments(){\n    try{ const v = localStorage.getItem(KEY_HITS); return v ? parseInt(v,10) : 0; }catch(e){ return 0; }\n  },\n  setBestFragments(n){\n    try{ localStorage.setItem(KEY_HITS, String(n)); }catch(e){}\n  },\n  getHardMode(){\n    try{ const v = localStorage.getItem(KEY_HARD); return v === '1'; }catch(e){ return false; }\n  },\n  setHardMode(on){\n    try{ localStorage.setItem(KEY_HARD, on ? '1' : '0'); }catch(e){}\n  },\n  getDailySeed(){\n    try{ const v = localStorage.getItem(KEY_SEED); return v ? parseInt(v,10) : null; }catch(e){ return null; }\n  },\n  setDailySeed(s){\n    try{ localStorage.setItem(KEY_SEED, String(s)); }catch(e){}\n  }\n};\n", "js/topology.js": "// Toroidal math helpers\nexport const MAZE_W = 30;\nexport const MAZE_H = 30;\n\nexport function wrapX(x, w=MAZE_W){\n  return ((x % w) + w) % w;\n}\nexport function wrapY(y, h=MAZE_H){\n  return ((y % h) + h) % h;\n}\nexport function wrapCell(cx, cy){\n  return [wrapX(cx), wrapY(cy)];\n}\n\n// Shortest signed delta on torus (in range [-floor(n/2), floor(n/2)])\nexport function torDelta(a, b, n){\n  let d = (b - a) % n;\n  if(d > n/2) d -= n;\n  else if(d < -n/2) d += n;\n  return d;\n}\n\n// Toroidal distance (cells, Chebyshev)\nexport function torDist(ax, ay, bx, by){\n  const dx = Math.abs(torDelta(ax, bx, MAZE_W));\n  const dy = Math.abs(torDelta(ay, by, MAZE_H));\n  return Math.max(dx, dy); // Chebyshev for game feel\n}\nexport function torDistManhattan(ax, ay, bx, by){\n  return Math.abs(torDelta(ax, bx, MAZE_W)) + Math.abs(torDelta(ay, by, MAZE_H));\n}\n\n// Linear interpolation that takes the shortest path on the torus.\n// Returns the interpolated coordinate.\nexport function torLerp(a, b, t, n){\n  const d = torDelta(a, b, n);\n  return a + d * t;\n}\n\n// Given a continuous position (could be near a seam), snap to logical cell and return offset for visual smoothing.\n// pos is {x, y} as float (cell coords). Returns {cellX, cellY, ox, oy} where ox/oy in [-0.5,0.5] approx.\nexport function snapToCell(px, py){\n  const cx = Math.round(px);\n  const cy = Math.round(py);\n  return { cellX: wrapX(cx), cellY: wrapY(cy), ox: px - cx, oy: py - cy };\n}\n", "js/maze.js": "import { CONFIG } from './config.js';\nimport { MAZE_W, MAZE_H, wrapX, wrapY, torDelta } from './topology.js';\n\n// Maze representation:\n//  - cells[y][x] = { walls: {N,E,S,W} } booleans\n//  - Walls on outer edges removed to support toroidal wrap.\n\nexport class Maze {\n  constructor(rng){\n    this.rng = rng;\n    this.W = MAZE_W;\n    this.H = MAZE_H;\n    this.cells = [];\n    this.generate();\n    this.breakSymmetry();\n    this.buildWallSegments();\n  }\n\n  idx(x,y){ return y*this.W + wrapX(x); }\n\n  generate(){\n    const W = this.W, H = this.H;\n    for(let y=0;y<H;y++){\n      const row = [];\n      for(let x=0;x<W;x++){\n        row.push({ walls:{N:true,E:true,S:true,W:true}, visited:false });\n      }\n      this.cells.push(row);\n    }\n    // Recursive backtracker iterative (stack)\n    const startX = Math.floor(this.rng()*W);\n    const startY = Math.floor(this.rng()*H);\n    const stack = [[startX, startY]];\n    this.cells[startY][startX].visited = true;\n    const dirs = [\n      {dx:0, dy:-1, a:'N', b:'S'},\n      {dx:1, dy:0,  a:'E', b:'W'},\n      {dx:0, dy:1,  a:'S', b:'N'},\n      {dx:-1, dy:0, a:'W', b:'E'}\n    ];\n    while(stack.length){\n      const [cx, cy] = stack[stack.length-1];\n      // collect unvisited neighbors (with wrap)\n      const neighbors = [];\n      for(const d of dirs){\n        const nx = wrapX(cx + d.dx);\n        const ny = wrapY(cy + d.dy);\n        if(!this.cells[ny][nx].visited){\n          neighbors.push({ nx, ny, d });\n        }\n      }\n      if(neighbors.length === 0){\n        stack.pop();\n        continue;\n      }\n      const pick = neighbors[Math.floor(this.rng()*neighbors.length)];\n      // carve\n      this.cells[cy][cx].walls[pick.d.a] = false;\n      this.cells[pick.ny][pick.nx].walls[pick.d.b] = false;\n      this.cells[pick.ny][pick.nx].visited = true;\n      stack.push([pick.nx, pick.ny]);\n    }\n    // For torus, every outer edge has exactly the same wall as the opposite cell's interior edge.\n    // E.g., cell (x, 0).N pairs with (x, H-1).S. Ensure consistency:\n    for(let x=0;x<W;x++){\n      const top = this.cells[0][x];\n      const bot = this.cells[H-1][x];\n      // Use AND of the two (either can be open). Choose OR so wrap path exists more often; we keep them in sync.\n      const openNS = top.walls.N || bot.walls.S;\n      top.walls.N = openNS;\n      bot.walls.S = openNS;\n    }\n    for(let y=0;y<H;y++){\n      const left = this.cells[y][0];\n      const right = this.cells[y][W-1];\n      const openEW = left.walls.W || right.walls.E;\n      left.walls.W = openEW;\n      right.walls.E = openEW;\n    }\n  }\n\n  breakSymmetry(){\n    // Remove a small percentage of inner walls to create loops\n    const W = this.W, H = this.H;\n    const pct = CONFIG.SYMMETRY_BREAK_PCT;\n    // We iterate over the unique walls: each cell contributes N and W walls (and S/Wrap and E/Wrap are duplicates).\n    let candidates = [];\n    for(let y=0;y<H;y++){\n      for(let x=0;x<W;x++){\n        if(this.cells[y][x].walls.N) candidates.push([x,y,'N']);\n        if(this.cells[y][x].walls.W) candidates.push([x,y,'W']);\n      }\n    }\n    const nRemove = Math.floor(candidates.length * pct);\n    for(let i=0;i<nRemove;i++){\n      const k = Math.floor(this.rng()*candidates.length);\n      const [x,y,dir] = candidates[k];\n      this.removeWall(x,y,dir);\n      candidates.splice(k,1);\n    }\n  }\n\n  removeWall(x,y,dir){\n    const W = this.W, H = this.H;\n    let nx = x, ny = y, a = dir, b = '';\n    switch(dir){\n      case 'N': ny = wrapY(y-1); b='S'; break;\n      case 'S': ny = wrapY(y+1); b='N'; break;\n      case 'W': nx = wrapX(x-1); b='E'; break;\n      case 'E': nx = wrapX(x+1); b='W'; break;\n    }\n    this.cells[y][x].walls[a] = false;\n    this.cells[ny][nx].walls[b] = false;\n  }\n\n  hasWall(cx, cy, dir){\n    const c = this.cells[wrapY(cy)][wrapX(cx)];\n    return !!c.walls[dir];\n  }\n\n  // Pre-build render segments to avoid recompute each frame\n  buildWallSegments(){\n    // Two arrays: segments (axis aligned) and wrapSegments (arcs to indicate seam)\n    this.segments = []; // {x1,y1,x2,y2,horizontal:bool}\n    const W = this.W, H = this.H;\n    for(let y=0;y<H;y++){\n      for(let x=0;x<W;x++){\n        const c = this.cells[y][x];\n        // Only emit N and W walls to avoid duplicates.\n        if(c.walls.N){\n          // Horizontal segment from (x-0.5,y-0.5) to (x+0.5,y-0.5); if y==0, this is the top seam — mark wrap.\n          const isWrap = (y === 0);\n          this.segments.push({\n            x1: x - 0.5, y1: y - 0.5,\n            x2: x + 0.5, y2: y - 0.5,\n            horizontal: true, wrap: isWrap\n          });\n        }\n        if(c.walls.W){\n          const isWrap = (x === 0);\n          this.segments.push({\n            x1: x - 0.5, y1: y - 0.5,\n            x2: x - 0.5, y2: y + 0.5,\n            horizontal: false, wrap: isWrap\n          });\n        }\n      }\n    }\n    // Also ensure E wall of rightmost column and S wall of bottom row are included (they were skipped).\n    for(let y=0;y<H;y++){\n      const c = this.cells[y][W-1];\n      if(c.walls.E){\n        this.segments.push({\n          x1: W - 0.5, y1: y - 0.5,\n          x2: W - 0.5, y2: y + 0.5,\n          horizontal: false, wrap: true\n        });\n      }\n    }\n    for(let x=0;x<W;x++){\n      const c = this.cells[H-1][x];\n      if(c.walls.S){\n        this.segments.push({\n          x1: x - 0.5, y1: H - 0.5,\n          x2: x + 0.5, y2: H - 0.5,\n          horizontal: true, wrap: true\n        });\n      }\n    }\n  }\n\n  // A* pathfinding on torus from (sx,sy) to (gx,gy), returns array of cells [{x,y}, ...] excluding start, including goal.\n  // Uses Manhattan heuristic with toroidal distance.\n  pathfind(sx, sy, gx, gy){\n    const W = this.W, H = this.H;\n    const startKey = sx + sy*W;\n    const goalKey = gx + gy*W;\n    if(startKey === goalKey) return [{x:gx, y:gy}];\n\n    const open = new MinHeap();\n    const gScore = new Map();\n    const cameFrom = new Map();\n    const closed = new Set();\n\n    gScore.set(startKey, 0);\n    open.push({ key: startKey, x: sx, y: sy, f: this._h(sx,sy,gx,gy) });\n\n    const dirs = [\n      {dx:0, dy:-1, a:'N', b:'S'},\n      {dx:1, dy:0,  a:'E', b:'W'},\n      {dx:0, dy:1,  a:'S', b:'N'},\n      {dx:-1, dy:0, a:'W', b:'E'}\n    ];\n    let safety = W*H*8; // hard cap\n    while(open.size() > 0 && safety-- > 0){\n      const cur = open.pop();\n      const ck = cur.key;\n      if(closed.has(ck)) continue;\n      closed.add(ck);\n      if(ck === goalKey){\n        // reconstruct\n        const path = [];\n        let k = goalKey;\n        while(k !== startKey){\n          const prev = cameFrom.get(k);\n          const x = k % W, y = Math.floor(k / W);\n          path.push({x,y});\n          k = prev;\n        }\n        path.reverse();\n        return path;\n      }\n      const cx = cur.x, cy = cur.y;\n      const cell = this.cells[cy][cx];\n      for(const d of dirs){\n        if(cell.walls[d.a]) continue;\n        const nx = wrapX(cx + d.dx);\n        const ny = wrapY(cy + d.dy);\n        const nk = nx + ny*W;\n        if(closed.has(nk)) continue;\n        // Step cost is 1 (uniform)\n        const tentative = gScore.get(ck) + 1;\n        if(!gScore.has(nk) || tentative < gScore.get(nk)){\n          gScore.set(nk, tentative);\n          cameFrom.set(nk, ck);\n          const f = tentative + this._h(nx,ny,gx,gy);\n          open.push({ key: nk, x: nx, y: ny, f });\n        }\n      }\n    }\n    return null;\n  }\n\n  _h(ax,ay,bx,by){\n    const dx = Math.abs(torDelta(ax, bx, this.W));\n    const dy = Math.abs(torDelta(ay, by, this.H));\n    return dx + dy; // Manhattan\n  }\n}\n\n// Minimal binary heap keyed by .f\nclass MinHeap {\n  constructor(){ this.data = []; }\n  size(){ return this.data.length; }\n  push(item){\n    this.data.push(item);\n    let i = this.data.length - 1;\n    while(i > 0){\n      const parent = (i - 1) >> 1;\n      if(this.data[parent].f <= this.data[i].f) break;\n      [this.data[parent], this.data[i]] = [this.data[i], this.data[parent]];\n      i = parent;\n    }\n  }\n  pop(){\n    const top = this.data[0];\n    const last = this.data.pop();\n    if(this.data.length){\n      this.data[0] = last;\n      let i = 0;\n      const n = this.data.length;\n      while(true){\n        const l = i*2+1, r = i*2+2;\n        let s = i;\n        if(l < n && this.data[l].f < this.data[s].f) s = l;\n        if(r < n && this.data[r].f < this.data[s].f) s = r;\n        if(s === i) break;\n        [this.data[s], this.data[i]] = [this.data[i], this.data[s]];\n        i = s;\n      }\n    }\n    return top;\n  }\n}\n", "js/effects.js": "import { CONFIG } from './config.js';\n\n// Particle system, screen flash, scanlines, chromatic aberration\nexport class ParticleSystem {\n  constructor(){\n    this.list = [];\n  }\n  emit(x, y, opts){\n    const count = opts.count ?? 1;\n    for(let i=0;i<count;i++){\n      const a = (opts.angleMin + Math.random()*(opts.angleMax - opts.angleMin));\n      const sp = (opts.speedMin + Math.random()*(opts.speedMax - opts.speedMin));\n      this.list.push({\n        x, y,\n        vx: Math.cos(a) * sp,\n        vy: Math.sin(a) * sp,\n        life: opts.life,\n        age: 0,\n        size: opts.size ?? 1.5,\n        color: opts.color ?? '#7DF9FF',\n        gravity: opts.gravity ?? 0,\n        fade: opts.fade ?? 1.0\n      });\n    }\n  }\n  update(dt){\n    const out = [];\n    for(const p of this.list){\n      p.age += dt;\n      if(p.age >= p.life) continue;\n      p.x += p.vx * dt;\n      p.y += p.vy * dt;\n      p.vy += p.gravity * dt;\n      out.push(p);\n    }\n    this.list = out;\n  }\n  draw(ctx, offsetX, offsetY){\n    ctx.save();\n    for(const p of this.list){\n      const t = p.age / p.life;\n      const alpha = (1 - t) * p.fade;\n      ctx.globalAlpha = Math.max(0, alpha);\n      ctx.fillStyle = p.color;\n      ctx.beginPath();\n      ctx.arc(offsetX + p.x, offsetY + p.y, p.size * (1 - t*0.4), 0, Math.PI*2);\n      ctx.fill();\n    }\n    ctx.restore();\n  }\n}\n\nexport class ScreenFlash {\n  constructor(){ this.t = 0; this.dur = 0; this.color = '#00F0FF'; this.alpha = 0; }\n  trigger(color, dur, alpha){\n    this.color = color;\n    this.dur = dur;\n    this.t = dur;\n    this.alpha = alpha;\n  }\n  update(dt){\n    if(this.t > 0) this.t = Math.max(0, this.t - dt);\n  }\n  draw(ctx, w, h){\n    if(this.t <= 0) return;\n    const t = this.t / this.dur;\n    ctx.save();\n    ctx.globalAlpha = t * this.alpha;\n    ctx.fillStyle = this.color;\n    ctx.fillRect(0,0,w,h);\n    ctx.restore();\n  }\n}\n\nexport function drawScanlines(ctx, w, h){\n  ctx.save();\n  ctx.globalAlpha = 0.05;\n  ctx.fillStyle = '#000';\n  for(let y=0; y<h; y+=3){\n    ctx.fillRect(0, y, w, 1);\n  }\n  ctx.restore();\n}\n\nexport function drawStars(ctx, stars, w, h, scrollX, scrollY){\n  ctx.save();\n  for(const s of stars){\n    // parallax using s.depth\n    const px = ((s.x + scrollX * s.depth) % w + w) % w;\n    const py = ((s.y + scrollY * s.depth) % h + h) % h;\n    ctx.globalAlpha = s.alpha * (0.5 + 0.5 * Math.sin(performance.now()*0.001 + s.phase));\n    ctx.fillStyle = CONFIG.COLORS.star;\n    ctx.fillRect(px, py, s.size, s.size);\n  }\n  ctx.restore();\n}\n\n// Chromatic aberration pass — draws three offset layers of an entity callback.\n// intensity in [0,1]\nexport function withChromatic(ctx, intensity, drawFn){\n  if(intensity < 0.05){\n    drawFn(0,0);\n    return;\n  }\n  const off = 1 + intensity * 2;\n  ctx.save();\n  ctx.globalCompositeOperation = 'screen';\n  ctx.globalAlpha = 0.6;\n  ctx.fillStyle = '#FF1F8F';\n  drawFn(-off, 0);\n  ctx.globalAlpha = 0.6;\n  ctx.fillStyle = '#00F0FF';\n  drawFn(off, 0);\n  ctx.globalCompositeOperation = 'source-over';\n  ctx.globalAlpha = 1;\n  drawFn(0,0);\n  ctx.restore();\n}\n", "js/audio.js": "// Web Audio API simple synth for SFX\nclass Audio {\n  constructor(){\n    this.ctx = null;\n    this.master = null;\n    this.drone = null;\n    this.droneGain = null;\n    this.muted = false;\n    this.lastFoot = 0;\n    this._wrapCooldown = 0;\n  }\n  init(){\n    if(this.ctx) return;\n    try{\n      const Ctx = window.AudioContext || window.webkitAudioContext;\n      if(!Ctx) return;\n      this.ctx = new Ctx();\n      this.master = this.ctx.createGain();\n      this.master.gain.value = 0.6;\n      this.master.connect(this.ctx.destination);\n      this._setupDrone();\n    }catch(e){ this.ctx = null; }\n  }\n  resume(){\n    if(this.ctx && this.ctx.state === 'suspended') this.ctx.resume();\n  }\n  _setupDrone(){\n    if(!this.ctx) return;\n    const o1 = this.ctx.createOscillator();\n    o1.type = 'sawtooth';\n    o1.frequency.value = 55;\n    const o2 = this.ctx.createOscillator();\n    o2.type = 'sine';\n    o2.frequency.value = 58;\n    const g = this.ctx.createGain();\n    g.gain.value = 0;\n    const lp = this.ctx.createBiquadFilter();\n    lp.type = 'lowpass';\n    lp.frequency.value = 220;\n    o1.connect(lp); o2.connect(lp);\n    lp.connect(g);\n    g.connect(this.master);\n    o1.start(); o2.start();\n    this.drone = o1;\n    this.droneGain = g;\n  }\n  setDroneIntensity(v){ // 0..1\n    if(!this.droneGain) return;\n    this.droneGain.gain.setTargetAtTime(v * 0.18, this.ctx.currentTime, 0.15);\n  }\n  footstep(cx, cy){\n    if(!this.ctx || this.muted) return;\n    const t = this.ctx.currentTime;\n    if(t - this.lastFoot < 0.05) return;\n    this.lastFoot = t;\n    const osc = this.ctx.createOscillator();\n    const g = this.ctx.createGain();\n    osc.type = 'square';\n    const base = 200 + ((cx + cy) % 5) * 25;\n    osc.frequency.setValueAtTime(base, t);\n    osc.frequency.exponentialRampToValueAtTime(base * 0.5, t + 0.06);\n    g.gain.setValueAtTime(0.06, t);\n    g.gain.exponentialRampToValueAtTime(0.0001, t + 0.07);\n    osc.connect(g); g.connect(this.master);\n    osc.start(t); osc.stop(t + 0.08);\n  }\n  pickup(){\n    if(!this.ctx || this.muted) return;\n    const t = this.ctx.currentTime;\n    const notes = [523.25, 659.25, 783.99, 1046.5];\n    notes.forEach((f,i)=>{\n      const osc = this.ctx.createOscillator();\n      const g = this.ctx.createGain();\n      osc.type = 'triangle';\n      osc.frequency.setValueAtTime(f, t + i*0.05);\n      g.gain.setValueAtTime(0.0001, t + i*0.05);\n      g.gain.exponentialRampToValueAtTime(0.18, t + i*0.05 + 0.01);\n      g.gain.exponentialRampToValueAtTime(0.0001, t + i*0.05 + 0.18);\n      osc.connect(g); g.connect(this.master);\n      osc.start(t + i*0.05); osc.stop(t + i*0.05 + 0.2);\n    });\n  }\n  wrapShimmer(){\n    if(!this.ctx || this.muted) return;\n    const t = this.ctx.currentTime;\n    if(t - this._wrapCooldown < 0.2) return;\n    this._wrapCooldown = t;\n    const osc = this.ctx.createOscillator();\n    const g = this.ctx.createGain();\n    osc.type = 'sine';\n    osc.frequency.setValueAtTime(880, t);\n    osc.frequency.exponentialRampToValueAtTime(1760, t + 0.2);\n    g.gain.setValueAtTime(0.0001, t);\n    g.gain.exponentialRampToValueAtTime(0.1, t + 0.05);\n    g.gain.exponentialRampToValueAtTime(0.0001, t + 0.3);
    osc.connect(g); g.connect(this.master);
    osc.start(t); osc.stop(t + 0.35);
  }
  hit(){
    if(!this.ctx || this.muted) return;
    const t = this.ctx.currentTime;
    const osc = this.ctx.createOscillator();
    const g = this.ctx.createGain();
    osc.type = 'sawtooth';
    osc.frequency.setValueAtTime(220, t);
    osc.frequency.exponentialRampToValueAtTime(55, t + 0.2);
    g.gain.setValueAtTime(0.0001, t);
    g.gain.exponentialRampToValueAtTime(0.25, t + 0.02);
    g.gain.exponentialRampToValueAtTime(0.0001, t + 0.25);
    osc.connect(g); g.connect(this.master);
    osc.start(t); osc.stop(t + 0.3);
  }
  win(){
    if(!this.ctx || this.muted) return;
    const t = this.ctx.currentTime;
    const seq = [261.63, 329.63, 392, 523.25, 659.25, 783.99];
    seq.forEach((f,i)=>{
      const osc = this.ctx.createOscillator();
      const g = this.ctx.createGain();
      osc.type = 'triangle';
      osc.frequency.setValueAtTime(f, t + i*0.08);
      g.gain.setValueAtTime(0.0001, t + i*0.08);
      g.gain.exponentialRampToValueAtTime(0.18, t + i*0.08 + 0.02);
      g.gain.exponentialRampToValueAtTime(0.0001, t + i*0.08 + 0.4);
      osc.connect(g); g.connect(this.master);
      osc.start(t + i*0.08); osc.stop(t + i*0.08 + 0.45);
    });
  }
  lose(){
    if(!this.ctx || this.muted) return;
    const t = this.ctx.currentTime;
    const osc = this.ctx.createOscillator();
    const g = this.ctx.createGain();
    osc.type = 'sawtooth';
    osc.frequency.setValueAtTime(196, t);
    osc.frequency.exponentialRampToValueAtTime(49, t + 0.6);
    g.gain.setValueAtTime(0.0001, t);
    g.gain.exponentialRampToValueAtTime(0.22, t + 0.05);
    g.gain.exponentialRampToValueAtTime(0.0001, t + 0.7);
    osc.connect(g); g.connect(this.master);
    osc.start(t); osc.stop(t + 0.75);
  }
}
export const audio = new Audio();
", "js/player.js": "import { CONFIG } from './config.js';\nimport { MAZE_W, MAZE_H, wrapX, wrapY, torDelta } from './topology.js';\n\nexport class Player {\n  constructor(maze, startCell){\n    this.maze = maze;\n    this.cellX = startCell.x;\n    this.cellY = startCell.y;\n    this.posX = startCell.x; // continuous (cell coords)\n    this.posY = startCell.y;\n    this.targetX = startCell.x;\n    this.targetY = startCell.y;\n    this.dx = 0; // input direction\n    this.dy = 0;\n    this.prevCellX = startCell.x;\n    this.prevCellY = startCell.y;\n    this.dashing = false;\n    this.dashTime = 0;\n    this.dashCooldown = 0;\n    this.dashProgress = 0; // 0..1\n    this.trail = []; // array of {x,y,age,life}\n    this.alive = true;\n    this.hits = 0;\n    this.fragments = 0;\n    this.t = 0;\n  }\n  setInput(dx, dy){\n    this.dx = dx;\n    this.dy = dy;\n  }\n  tryDash(){\n    if(this.dashCooldown > 0 || this.dashing) return false;\n    this.dashing = true;\n    this.dashTime = CONFIG.PLAYER_DASH_DURATION;\n    this.dashCooldown = CONFIG.PLAYER_DASH_COOLDOWN;\n    this.dashProgress = 0;\n    return true;\n  }\n  update(dt, audio){\n    this.t += dt;\n    if(this.dashCooldown > 0) this.dashCooldown = Math.max(0, this.dashCooldown - dt);\n    if(this.dashing){\n      this.dashTime -= dt;\n      this.dashProgress = 1 - (this.dashTime / CONFIG.PLAYER_DASH_DURATION);\n      if(this.dashTime <= 0) this.dashing = false;\n    }\n    // Determine target cell from current position + input\n    let tx = this.targetX;\n    let ty = this.targetY;\n    if(this.dx !== 0 || this.dy !== 0){\n      // Determine which direction the player wants to move (8-way not allowed; just 4)\n      let ddx = 0, ddy = 0;\n      if(this.dx < 0) ddx = -1;\n      else if(this.dx > 0) ddx = 1;\n      if(this.dy < 0) ddy = -1;\n      else if(this.dy > 0) ddy = 1;\n      // If both, prefer axis with larger magnitude (here equal — prioritize vertical)\n      // For game feel allow both axes but we step one per frame at speed (PLAYER_SPEED cells/sec).\n      // Use diagonal as two separate checks later? For simplicity allow cardinal only with priority on larger component.\n      // Here we treat |dx| and |dy|; if both pressed we alternate by checking dominant or do two-step.\n      // We'll step on the primary axis with more input magnitude.\n      let primary = 'x';\n      if(Math.abs(this.dy) > Math.abs(this.dx)) primary = 'y';\n      // Step 1 cell at a time along primary axis when close to cell center\n      const speed = this.dashing ? CONFIG.PLAYER_DASH_SPEED : CONFIG.PLAYER_SPEED;\n      const step = speed * dt;\n      if(primary === 'x'){\n        const dir = ddx;\n        // Check wall on east/west at current cell\n        if(dir !== 0){\n          const wallKey = dir > 0 ? 'E' : 'W';\n          if(!this.maze.hasWall(this.cellX, this.cellY, wallKey)){\n            // Move towards the edge then step\n            this.targetX = wrapX(this.cellX + dir);\n            this.targetY = this.cellY;\n          }\n        }\n        // Also check y for secondary: if at center, allow y step\n        if(Math.abs(this.posY - this.cellY) < 0.05 && ddy !== 0){\n          const wallKey = ddy > 0 ? 'S' : 'N';\n          if(!this.maze.hasWall(this.cellX, this.cellY, wallKey)){\n            this.targetX = this.cellX;\n            this.targetY = wrapY(this.cellY + ddy);\n          }\n        }\n      } else {\n        const dir = ddy;\n        if(dir !== 0){\n          const wallKey = dir > 0 ? 'S' : 'N';\n          if(!this.maze.hasWall(this.cellX, this.cellY, wallKey)){\n            this.targetX = this.cellX;\n            this.targetY = wrapY(this.cellY + dir);\n          }\n        }\n        if(Math.abs(this.posX - this.cellX) < 0.05 && ddx !== 0){\n          const wallKey = ddx > 0 ? 'E' : 'W';\n          if(!this.maze.hasWall(this.cellX, this.cellY, wallKey)){\n            this.targetX = wrapX(this.cellX + ddx);\n            this.targetY = this.cellY;\n          }\n        }\n      }\n      // Move continuously towards targetX/targetY using shortest toroidal path\n      this._moveTowardsTarget(step, audio);\n    } else {\n      // No input: gently return to cell center\n      this._returnToCenter(dt, audio);\n    }\n    // Update trail\n    for(const tr of this.trail) tr.age += dt;\n    this.trail = this.trail.filter(tr => tr.age < tr.life);\n    // Push trail\n    if(this.dashing || (this.dx !== 0 || this.dy !== 0)){\n      if(Math.random() < (this.dashing ? 0.9 : 0.4)){\n        this.trail.push({ x: this.posX, y: this.posY, age: 0, life: CONFIG.TRAIL_LIFE, dashing: this.dashing });\n      }\n    }\n  }\n  _moveTowardsTarget(step, audio){\n    // Compute toroidal delta to target on x and y independently.\n    const tx = this.targetX;\n    const ty = this.targetY;\n    const dxC = torDelta(this.posX, tx, MAZE_W);\n    const dyC = torDelta(this.posY, ty, MAZE_H);\n    const dist = Math.hypot(dxC, dyC);\n    if(dist <= step){\n      // Snap to target\n      this.posX = tx;\n      this.posY = ty;\n      this.prevCellX = this.cellX;\n      this.prevCellY = this.cellY;\n      this.cellX = wrapX(Math.round(this.posX));\n      this.cellY = wrapY(Math.round(this.posY));\n      // Detect wrap (cell index changed across seam)\n      if(this.cellX !== this.prevCellX && Math.abs(this.prevCellX - this.cellX) > 1){\n        // wrapped horizontally\n        audio && audio.wrapShimmer();\n      } else if(this.cellY !== this.prevCellY && Math.abs(this.prevCellY - this.cellY) > 1){\n        audio && audio.wrapShimmer();\n      } else {\n        audio && audio.footstep(this.cellX, this.cellY);\n      }\n      this.targetX = this.cellX;\n      this.targetY = this.cellY;\n    } else {\n      const ux = dxC / dist;\n      const uy = dyC / dist;\n      this.posX += ux * step;\n      this.posY += uy * step;\n    }\n  }\n  _returnToCenter(dt, audio){\n    // Pull posX/posY toward cellX/cellY using toroidal shortest path\n    const dxC = torDelta(this.posX, this.cellX, MAZE_W);\n    const dyC = torDelta(this.posY, this.cellY, MAZE_H);\n    const dist = Math.hypot(dxC, dyC);\n    if(dist < 0.001) return;\n    const step = CONFIG.PLAYER_SPEED * 0.5 * dt;\n    if(dist <= step){\n      this.posX = this.cellX;\n      this.posY = this.cellY;\n    } else {\n      this.posX += (dxC/dist) * step;\n      this.posY += (dyC/dist) * step;\n    }\n  }\n  applyKnockback(dirX, dirY, cells){\n    // dirX/dirY in {-1,0,1}\n    this.targetX = wrapX(this.cellX + dirX * cells);\n    this.targetY = wrapY(this.cellY + dirY * cells);\n    // Force move now by directly setting pos slightly toward target\n    const dxC = torDelta(this.posX, this.targetX, MAZE_W);\n    const dyC = torDelta(this.posY, this.targetY, MAZE_H);\n    this.posX += dxC * 0.2;\n    this.posY += dyC * 0.2;\n  }\n  continuousCell(){\n    return { x: this.posX, y: this.posY };\n  }\n}\n", "js/glitch.js": "import { CONFIG } from './config.js';\nimport { MAZE_W, MAZE_H, wrapX, wrapY } from './topology.js';\n\nexport class Glitch {\n  constructor(maze, startCell){\n    this.maze = maze;\n    this.cellX = startCell.x;\n    this.cellY = startCell.y;\n    this.path = null; // array of {x,y}\n    this.pathIdx = 0;\n    this.repathTimer = CONFIG.GLITCH_REPATH_TIME;\n    this.speed = CONFIG.GLITCH_SPEED_BASE;\n    this.t = 0;\n    this.alive = true;\n    this.warn = 0; // 0..1 warning flash when near player\n  }\n  update(dt, playerCell, audio){\n    this.t += dt;\n    // speed scales over time\n    const steps = Math.floor(this.t / CONFIG.GLITCH_SPEED_STEP_TIME);\n    this.speed = Math.min(CONFIG.GLITCH_SPEED_MAX, CONFIG.GLITCH_SPEED_BASE + steps * CONFIG.GLITCH_SPEED_STEP);\n    this.repathTimer -= dt;\n    if(this.repathTimer <= 0 || !this.path || this.pathIdx >= this.path.length){\n      this.repathTimer = CONFIG.GLITCH_REPATH_TIME + Math.random()*0.3;\n      this.path = this.maze.pathfind(this.cellX, this.cellY, playerCell.x, playerCell.y);\n      this.pathIdx = 0;\n    }\n    if(this.path && this.path.length){\n      const next = this.path[this.pathIdx];\n      if(next === undefined) return;\n      // Move toward next cell\n      const dxC = ((next.x - this.cellX + MAZE_W + MAZE_W/2) % MAZE_W) - MAZE_W/2;\n      const dyC = ((next.y - this.cellY + MAZE_H + MAZE_H/2) % MAZE_H) - MAZE_H/2;\n      // step speed in cells per second; we move continuously between cells\n      const step = this.speed * dt;\n      // We are conceptually at (this.cellX, this.cellY) and moving toward (next.x, next.y)\n      // Represent continuous position internally:\n      if(this.contX === undefined){\n        this.contX = this.cellX + 0.5;\n        this.contY = this.cellY + 0.5;\n      }\n      // Shift cont by toroidal shortest delta toward next+0.5\n      const targetCx = next.x + 0.5;\n      const targetCy = next.y + 0.5;\n      const ddx = ((targetCx - this.contX + MAZE_W + MAZE_W/2) % MAZE_W) - MAZE_W/2;\n      const ddy = ((targetCy - this.contY + MAZE_H + MAZE_H/2) % MAZE_H) - MAZE_H/2;\n      const dist = Math.hypot(ddx, ddy);\n      if(dist <= step){\n        this.contX = targetCx;\n        this.contY = targetCy;\n        this.cellX = next.x;\n        this.cellY = next.y;\n        this.pathIdx++;\n      } else {\n        this.contX += (ddx/dist) * step;\n        this.contY += (ddy/dist) * step;\n      }\n    }\n    // Warning state\n    const distCells = Math.max(Math.abs(((playerCell.x - this.cellX + MAZE_W + MAZE_W/2) % MAZE_W) - MAZE_W/2),\n                                Math.abs(((playerCell.y - this.cellY + MAZE_H + MAZE_H/2) % MAZE_H) - MAZE_H/2));\n    this.warn = distCells <= CONFIG.GLITCH_WARN ? 1 : 0;\n  }\n  continuousCell(){\n    return { x: this.contX !== undefined ? this.contX - 0.5 : this.cellX, y: this.contY !== undefined ? this.contY - 0.5 : this.cellY };\n  }\n}\n", "js/fragments.js": "import { CONFIG } from './config.js';\nimport { MAZE_W, MAZE_H, wrapX, wrapY, torDist } from './topology.js';\n\nexport class FragmentManager {\n  constructor(maze, count){\n    this.maze = maze;\n    this.list = [];\n    this.collected = 0;\n    this.spawn(count);\n  }\n  spawn(count){\n    // Pick random cells that are not the player start and not each other, with min spacing\n    const tries = 200;\n    const minSpacing = 6;\n    let placed = 0;\n    while(placed < count && tries-- > 0){\n      const x = Math.floor(Math.random()*MAZE_W);\n      const y = Math.floor(Math.random()*MAZE_H);\n      // Ensure not in a wall-only cell? In maze, every cell is reachable. Skip near (0,0) start.\n      if(x === 0 && y === 0) continue;\n      let ok = true;\n      for(const f of this.list){\n        if(torDist(x,y,f.x,f.y) < minSpacing){ ok = false; break; }\n      }\n      if(ok){\n        this.list.push({ x, y, collected: false, age: 0, flash: 0 });\n        placed++;\n      }\n    }\n  }\n  update(dt, playerContCell){\n    for(const f of this.list){\n      f.age += dt;\n      if(f.flash > 0) f.flash = Math.max(0, f.flash - dt);\n      if(f.collected) continue;\n      const d = torDist(f.x, f.y, Math.round(playerContCell.x), Math.round(playerContCell.y));\n      if(d < 0.6){\n        f.collected = true;\n        f.flash = CONFIG.FRAG_FLASH_DUR;\n        this.collected++;\n      }\n    }\n  }\n  draw(ctx, camera, particles){\n    for(const f of this.list){\n      if(f.collected && f.flash <= 0) continue;\n      const cx = camera.toScreenX(f.x + 0.5);\n      const cy = camera.toScreenY(f.y + 0.5);\n      ctx.save();\n      ctx.translate(cx, cy);\n      const rot = f.age * CONFIG.FRAG_ROT_SPEED;\n      ctx.rotate(rot);\n      // Outer diamond\n      ctx.fillStyle = CONFIG.COLORS.fragment;\n      ctx.beginPath();\n      const s = CONFIG.FRAG_SIZE;\n      ctx.moveTo(0, -s);\n      ctx.lineTo(s, 0);\n      ctx.lineTo(0, s);\n      ctx.lineTo(-s, 0);\n      ctx.closePath();\n      ctx.fill();\n      // Inner core\n      ctx.rotate(-rot*2);\n      ctx.fillStyle = CONFIG.COLORS.fragmentCore;\n      ctx.fillRect(-2, -2, 4, 4);\n      ctx.restore();\n      if(!f.collected){\n        // Emit particles occasionally\n        if(Math.random() < CONFIG.FRAG_PARTICLES_PER_SEC * 0.016){\n          particles.emit(cx, cy, {\n            count: 1,\n            angleMin: 0, angleMax: Math.PI*2,\n            speedMin: 20, speedMax: 50,\n            life: 0.6, size: 1.5, color: CONFIG.COLORS.fragment\n          });\n        }\n      } else {\n        // Pickup flash\n        ctx.save();\n        ctx.globalAlpha = f.flash / CONFIG.FRAG_FLASH_DUR;\n        ctx.fillStyle = CONFIG.COLORS.fragmentCore;\n        ctx.beginPath();\n        ctx.arc(cx, cy, CONFIG.FRAG_SIZE * 2, 0, Math.PI*2);\n        ctx.fill();\n        ctx.restore();\n      }\n    }\n  }\n  allCollected(){\n    return this.collected >= this.list.length;\n  }\n  remaining(){\n    return this.list.length - this.collected;\n  }\n}\n", "js/exit.js": "import { CONFIG } from './config.js';\nimport { wrapX, wrapY } from './topology.js';\n\nexport class Exit {\n  constructor(cell){\n    this.cellX = cell.x;\n    this.cellY = cell.y;\n    this.t = 0;\n  }\n  update(dt, active){\n    this.t += dt;\n    this.active = active;\n  }\n  draw(ctx, camera){\n    const cx = camera.toScreenX(this.cellX + 0.5);\n    const cy = camera.toScreenY(this.cellY + 0.5);\n    const minR = CONFIG.EXIT_RING_MIN;\n    const maxR = CONFIG.EXIT_RING_MAX;\n    const r = minR + (maxR - minR) * (0.5 + 0.5 * Math.sin(this.t * Math.PI*2 * CONFIG.EXIT_RING_HZ));\n    ctx.save();\n    // Outer ring\n    ctx.strokeStyle = this.active ? CONFIG.COLORS.exit : CONFIG.COLORS.exitInactive;\n    ctx.lineWidth = 2;\n    ctx.beginPath();\n    ctx.arc(cx, cy, r, 0, Math.PI*2);\n    ctx.stroke();\n    // Inner cross\n    ctx.beginPath();\n    ctx.moveTo(cx - r*0.4, cy); ctx.lineTo(cx + r*0.4, cy);\n    ctx.moveTo(cx, cy - r*0.4); ctx.lineTo(cx, cy + r*0.4);\n    ctx.stroke();\n    ctx.restore();\n  }\n}\n", "js/camera.js": "import { CONFIG } from './config.js';\nimport { MAZE_W, MAZE_H, wrapX, wrapY, torDelta } from './topology.js';\n\n// Camera follows the player smoothly, taking the shortest toroidal path.\nexport class Camera {\n  constructor(){\n    this.x = 0; // center in cell coords\n    this.y = 0;\n    this.viewW = CONFIG.LOGICAL_W / CONFIG.CELL;\n    this.viewH = CONFIG.LOGICAL_H / CONFIG.CELL;\n    this.shake = 0;\n    this.shakeT = 0;\n  }\n  setTarget(px, py){\n    // Move camera center toward target with shortest toroidal delta\n    const dxC = torDelta(this.x, px, MAZE_W);\n    const dyC = torDelta(this.y, py, MAZE_H);\n    this.x = wrapX(this.x + dxC);\n    this.y = wrapY(this.y + dyC);\n  }\n  update(dt, targetContX, targetContY){\n    // Smoothly approach target's continuous cell position via toroidal lerp\n    const dx = torDelta(this.x, targetContX, MAZE_W);\n    const dy = torDelta(this.y, targetContY, MAZE_H);\n    this.x = wrapX(this.x + dx * CONFIG.PLAYER_LERP);\n    this.y = wrapY(this.y + dy * CONFIG.PLAYER_LERP);\n    if(this.shakeT > 0){\n      this.shakeT = Math.max(0, this.shakeT - dt);\n    }\n  }\n  toScreenX(cellX){ // cellX can be continuous\n    const dx = torDelta(this.x, cellX, MAZE_W);\n    return CONFIG.LOGICAL_W/2 + dx * CONFIG.CELL + (Math.random()-0.5) * this.shake * (this.shakeT>0?1:0);\n  }\n  toScreenY(cellY){\n    const dy = torDelta(this.y, cellY, MAZE_H);\n    return CONFIG.LOGICAL_H/2 + dy * CONFIG.CELL + (Math.random()-0.5) * this.shake * (this.shakeT>0?1:0);\n  }\n  addShake(amount, duration){\n    this.shake = amount;\n    this.shakeT = duration;\n  }\n}\n", "js/renderer.js": "import { CONFIG } from './config.js';\nimport { drawScanlines, drawStars, withChromatic } from './effects.js';\nimport { MAZE_W, MAZE_H, wrapX, wrapY, torDelta } from './topology.js';\n\nexport class Renderer {\n  constructor(canvas){\n    this.canvas = canvas;\n    this.ctx = canvas.getContext('2d');\n    this.stars = this._makeStars(120);\n    this.time = 0;\n  }\n  _makeStars(n){\n    const arr = [];\n    for(let i=0;i<n;i++){\n      arr.push({\n        x: Math.random() * CONFIG.LOGICAL_W,\n        y: Math.random() * CONFIG.LOGICAL_H,\n        size: Math.random() < 0.8 ? 1 : 2,\n        depth: 0.2 + Math.random()*0.8,\n        alpha: 0.3 + Math.random()*0.7,\n        phase: Math.random() * Math.PI*2\n      });\n    }\n    return arr;\n  }\n  drawBackground(camera, glitch){\n    const ctx = this.ctx;\n    const w = CONFIG.LOGICAL_W, h = CONFIG.LOGICAL_H;\n    // Solid bg\n    ctx.fillStyle = CONFIG.COLORS.bg;\n    ctx.fillRect(0,0,w,h);\n    // Stars parallax\n    drawStars(ctx, this.stars, w, h, camera.x * CONFIG.CELL * 0.1, camera.y * CONFIG.CELL * 0.1);\n    // Grid\n    ctx.save();\n    ctx.strokeStyle = CONFIG.COLORS.grid;\n    ctx.globalAlpha = 0.25;\n    ctx.lineWidth = 1;\n    const startX = Math.floor(camera.x - camera.viewW/2) - 1;\n    const endX = Math.ceil(camera.x + camera.viewW/2) + 1;\n    const startY = Math.floor(camera.y - camera.viewH/2) - 1;\n    const endY = Math.ceil(camera.y + camera.viewH/2) + 1;\n    for(let i=startX; i<=endX; i++){\n      const sx = camera.toScreenX(i);\n      ctx.beginPath();\n      ctx.moveTo(sx, 0); ctx.lineTo(sx, h);\n      ctx.stroke();\n    }\n    for(let i=startY; i<=endY; i++){\n      const sy = camera.toScreenY(i);\n      ctx.beginPath();\n      ctx.moveTo(0, sy); ctx.lineTo(w, sy);\n      ctx.stroke();\n    }\n    ctx.restore();\n    // Proximity vignette if glitch is near\n    if(glitch && glitch.warn){\n      const gx = camera.toScreenX(glitch.cellX + 0.5);\n      const gy = camera.toScreenY(glitch.cellY + 0.5);\n      const grad = ctx.createRadialGradient(w/2, h/2, 50, w/2, h/2, w*0.6);\n      grad.addColorStop(0, 'rgba(255,42,94,0)');\n      grad.addColorStop(1, `rgba(255,42,94,${0.35 * glitch.warn})`);\n      ctx.fillStyle = grad;\n      ctx.fillRect(0,0,w,h);\n    }\n  }\n  drawMaze(maze, camera){\n    const ctx = this.ctx;\n    ctx.save();\n    ctx.strokeStyle = CONFIG.COLORS.wallShadow;\n    ctx.lineWidth = CONFIG.WALL_THICK + CONFIG.WALL_SHADOW*2;\n    ctx.lineCap = 'round';\n    for(const s of maze.segments){\n      this._strokeSeg(s, camera, CONFIG.COLORS.wallShadow);\n    }\n    ctx.strokeStyle = CONFIG.COLORS.wall;\n    ctx.lineWidth = CONFIG.WALL_THICK;\n    for(const s of maze.segments){\n      this._strokeSeg(s, camera, CONFIG.COLORS.wall);\n    }\n    ctx.restore();\n  }\n  _strokeSeg(s, camera, color){\n    const ctx = this.ctx;\n    const x1 = camera.toScreenX(s.x1);\n    const y1 = camera.toScreenY(s.y1);\n    const x2 = camera.toScreenX(s.x2);\n    const y2 = camera.toScreenY(s.y2);\n    ctx.strokeStyle = color;\n    ctx.beginPath();\n    ctx.moveTo(x1, y1);\n    ctx.lineTo(x2, y2);\n    ctx.stroke();\n  }\n  drawPlayer(player, camera){\n    const ctx = this.ctx;\n    const cx = camera.toScreenX(player.posX + 0.5);\n    const cy = camera.toScreenY(player.posY + 0.5);\n    const s = CONFIG.PLAYER_SIZE;\n    // Trail\n    for(const tr of player.trail){\n      const t = tr.age / tr.life;\n      const a = (1 - t) * (tr.dashing ? 0.5 : 0.25);\n      ctx.fillStyle = tr.dashing ? CONFIG.COLORS.glitch : CONFIG.COLORS.playerOutline;\n      ctx.globalAlpha = a;\n      const tx = camera.toScreenX(tr.x + 0.5);\n      const ty = camera.toScreenY(tr.y + 0.5);\n      ctx.fillRect(tx - s/2, ty - s/2, s, s);\n    }\n    ctx.globalAlpha = 1;\n    const chroma = player.dashing ? Math.min(1, player.dashProgress) : 0;\n    withChromatic(ctx, chroma, (ox, oy) => {\n      ctx.save();\n      ctx.translate(cx + ox, cy + oy);\n      // Outer ring\n      ctx.fillStyle = CONFIG.COLORS.playerOutline;\n      ctx.beginPath();\n      ctx.arc(0, 0, s, 0, Math.PI*2);\n      ctx.fill();\n      // Inner core\n      ctx.fillStyle = CONFIG.COLORS.playerCore;\n      ctx.beginPath();\n      ctx.arc(0, 0, s*0.45, 0, Math.PI*2);\n      ctx.fill();\n      ctx.restore();\n    });\n  }\n  drawGlitch(g, camera, intensity){\n    const ctx = this.ctx;\n    const cx = camera.toScreenX(g.cellX + 0.5);\n    const cy = camera.toScreenY(g.cellY + 0.5);\n    const baseSize = CONFIG.GLITCH_SIZE;\n    const flicker = 0.7 + 0.3 * Math.sin(performance.now()*0.02 + g.cellX);\n    const size = baseSize * flicker;\n    ctx.save();\n    ctx.translate(cx, cy);\n    ctx.rotate(performance.now()*0.001);\n    // Outer diamond\n    ctx.fillStyle = CONFIG.COLORS.glitch;\n    ctx.beginPath();\n    ctx.moveTo(0, -size);\n    ctx.lineTo(size, 0);\n    ctx.lineTo(0, size);\n    ctx.lineTo(-size, 0);\n    ctx.closePath();\n    ctx.fill();\n    // Inner alt\n    ctx.fillStyle = CONFIG.COLORS.glitchAlt;\n    ctx.beginPath();\n    ctx.arc(0, 0, size*0.4, 0, Math.PI*2);\n    ctx.fill();\n    ctx.restore();\n  }\n  drawHUD(state, minimap, hud){\n    const ctx = this.ctx;\n    ctx.save();\n    // Top-left: timer + hits\n    ctx.fillStyle = '#F2F7FF';\n    ctx.font = CONFIG.HUD_FONT;\n    ctx.textBaseline = 'top';\n    ctx.fillText(`TIME  ${state.timeStr}`, 12, 12);\n    ctx.fillText(`FRAG  ${state.fragments}/${state.fragTotal}`, 12, 32);\n    ctx.fillText(`HITS  ${'♥'.repeat(CONFIG.HIT_LIMIT - state.hits)}${'♡'.repeat(state.hits)}`, 12, 52);\n    if(state.hardMode){\n      ctx.fillStyle = CONFIG.COLORS.glitch;\n      ctx.fillText('HARD MODE', 12, 72);\n    }\n    // Top-right: best\n    ctx.textAlign = 'right';\n    ctx.fillStyle = '#7DF9FF';\n    ctx.fillText(`BEST  ${state.bestTimeStr}`, CONFIG.LOGICAL_W - 12, 12);\n    ctx.fillText(`SEED  ${state.seed}`, CONFIG.LOGICAL_W - 12, 32);\n    ctx.textAlign = 'left';\n    // Bottom: hint\n    if(state.hint){\n      ctx.fillStyle = '#7DF9FF';\n      ctx.font = 'bold 12px \"Courier New\", monospace';\n      ctx.textAlign = 'center';\n      ctx.fillText(state.hint, CONFIG.LOGICAL_W/2, CONFIG.LOGICAL_H - 24);\n    }\n    // Minimap\n    if(minimap) minimap(ctx);\n    ctx.restore();\n  }\n  drawCenterMessage(msg, sub){\n    const ctx = this.ctx;\n    ctx.save();\n    ctx.fillStyle = 'rgba(7,9,36,0.7)';\n    ctx.fillRect(0, CONFIG.LOGICAL_H/2 - 80, CONFIG.LOGICAL_W, 160);\n    ctx.fillStyle = '#00F0FF';\n    ctx.font = CONFIG.HUD_FONT_BIG;\n    ctx.textAlign = 'center';\n    ctx.textBaseline = 'middle';\n    ctx.fillText(msg, CONFIG.LOGICAL_W/2, CONFIG.LOGICAL_H/2 - 16);\n    if(sub){\n      ctx.fillStyle = '#F2F7FF';\n      ctx.font = 'bold 14px \"Courier New\", monospace';\n      ctx.fillText(sub, CONFIG.LOGICAL_W/2, CONFIG.LOGICAL_H/2 + 18);\n    }\n    ctx.restore();\n  }\n  drawScanlines(){\n    drawScanlines(this.ctx, CONFIG.LOGICAL_W, CONFIG.LOGICAL_H);\n  }\n}\n", "js/minimap.js": "import { CONFIG } from './config.js';\nimport { MAZE_W