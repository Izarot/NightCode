              if ((e.code === 'KeyP' || e.code === 'Escape') && (this.state === 'playing' || this.state === 'paused')) {\n                        this.togglePause();\n                    }\n                });\n\n                document.addEventListener('keyup', (e) => {\n                    thiskeys[e.code] = false;
