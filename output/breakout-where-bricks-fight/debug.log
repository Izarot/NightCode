                });
            }

            updateHighScoreDisplay() {
                document.getElementById('title-highscore').textContent = `HIGH SCORE: ${this.highScore}`;
            }

            showScreen(id) {
                this.hideAllScreens();
                const screen = document.getElementById(id);
                if (screen) screen.classList.add('active');
            }

            hideAllScreens() {
                document.querySelectorAll('.overlay-screen').forEach(s => s.classList.remove('active'));
            }

            startGame() {
                this.state = 'playing';
                this.score = 0;
                this.lives = 3;
                this.level = 1;
                this.combo = 0;
                this.comboTimer = 0;
                this.noDamageThisLevel = true;
                this.hideAllScreens();
                this.initEntities();
            }

            initEntities() {
                this.paddle = new Paddle(this.width / 2 - 60, this.height - 40);
                this.ball = new Ball(this.paddle.x + this.paddle.width / 2, this.paddle.y - 8);
                this.bricks = [];
                this.lasers = [];
                this.createLevel();
            }

            createLevel() {
                this.bricks = [];
                const patterns = [
                    // Level 1 - Simple rows
                    () => {
                        const rows = 4;
                        const cols = 10;
                        const brickW = 70;
                        const brickH = 25;
                        const padding = 5;
                        const startX = (this.width - (cols * (brickW + padding))) / 2;
                        const startY = 80;
                        for (let row = 0; row < rows; row++) {
                            for (let col = 0; col < cols; col++) {
                                const tier = row < 1 ? 1 : row < 2 ? 1 : row < 3 ? 1 : 1;
                                this.bricks.push(new Brick(
                                    startX + col * (brickW + padding),
                                    startY + row * (brickH + padding),
                                    tier
                                ));
                            }
                        }
                    },
                    // Level 2 - Introduce tier 2
                    () => {
                        const rows = 5;
                        const cols = 10;
                        const brickW = 70;
                        const brickH = 25;
                        const padding = 5;
                        const startX = (this.width - (cols * (brickW + padding))) / 2;
                        const startY = 80;
                        for (let row = 0; row < rows; row++) {
                            for (let col = 0; col < cols; col++) {
                                const tier = row < 2 ? 1 : row < 4 ? 2 : 1;
                                this.bricks.push(new Brick(
                                    startX + col * (brickW + padding),
                                    startY + row * (brickH + padding),
                                    tier
                                ));
                            }
                        }
                    },
                    // Level 3 - Introduce tier 3
                    () => {
                        const rows = 5;
                        const cols = 10;
                        const brickW = 70;
                        const brickH = 25;
                        const padding = 5;
                        const startX = (this.width - (cols * (brickW + padding))) / 2;
                        const startY = 80;
                        for (let row = 0; row < rows; row++) {
                            for (let col = 0; col < cols; col++) {
                                const tier = row < 1 ? 3 : row < 3 ? 2 : 1;
                                this.bricks.push(new Brick(
                                    startX + col * (brickW + padding),
                                    startY + row * (brickH + padding),
                                    tier
                                ));
                            }
                        }
                    },
                    // Level 4 - Introduce tier 4
                    () => {
                        const rows = 5;
                        const cols = 10;
                        const brickW = 70;
                        const brickH = 25;
                        const padding = 5;
                        const startX = (this.width - (cols * (brickW + padding))) / 2;
                        const startY = 80;
                        for (let row = 0; row < rows; row++) {
                            for (let col = 0; col < cols; col++) {
                                const tier = row < 2 ? 4 : row < 3 ? 3 : row < 4 ? 2 : 1;
                                this.bricks.push(new Brick(
                                    startX + col * (brickW + padding),
                                    startY + row * (brickH + padding),
                                    tier
                                ));
                            }
                        }
                    },
                    // Level 5 - Dense grid
                    () => {
                        const rows = 6;
                        const cols = 10;
                        const brickW = 70;
                        const brickH = 25;
                        const padding = 5;
                        const startX = (this.width - (cols * (brickW + padding))) / 2;
                        const startY = 80;
                        for (let row = 0; row < rows; row++) {
                            for (let col = 0; col < cols; col++) {
                                const tier = Math.floor(Math.random() * 4) + 1;
                                this.bricks.push(new Brick(
                                    startX + col * (brickW + padding),
                                    startY + row * (brickH + padding),
                                    tier
                                ));
                            }
                        }
                    }
                ];

                const patternIndex = Math.min(this.level - 1, patterns.length - 1);
                patterns[patternIndex]();
            }

            spawnLaser(brick) {
                const laser = new Laser(brick.x + brick.width / 2, brick.y + brick.height);
                this.lasers.push(laser);
                this.audio.laserFire();
            }

            togglePause() {
                if (this.state === 'playing') {
                    this.state = 'paused';
                    this.showScreen('pause-screen');
                } else if (this.state === 'paused') {
                    this.state = 'playing';
                    this.hideAllScreens();
                }
            }

            update(deltaTime) {
                if (this.state !== 'playing') return;

                // Update paddle position from mouse
                this.paddle.targetX = this.mouseX - this.paddle.width / 2;
                this.paddle.update(this.width);

                // Update ball
                this.ball.update(this.paddle);

                // Ball wall collision
                this.ball.checkWallCollision(this.width, this.height);

                // Ball paddle collision
                if (this.ball.checkPaddleCollision(this.paddle)) {
                    this.audio.paddleHit();
                    this.particles.emit(this.ball.x, this.ball.y, '#00ffff', 8);
                }

                // Ball brick collision
                this.checkBallBrickCollision();

                // Update bricks (laser firing)
                this.bricks.forEach(brick => {
                    if (brick.update(this.level)) {
                        this.spawnLaser(brick);
                    }
                });

                // Update lasers
                this.lasers = this.lasers.filter(laser => laser.update());

                // Laser-paddle collision
                this.lasers.forEach(laser => {
                    if (laser.active && laser.checkCollision(this.paddle) && !this.paddle.invincible) {
                        laser.active = false;
                        this.playerHit();
                    }
                });
                this.lasers = this.lasers.filter(l => l.active);

                // Ball out of bounds
                if (this.ball.y > this.height + this.ball.radius) {
                    this.lives--;
                    if (this.lives <= 0) {
                        this.gameOver();
                    } else {
                        this.ball = new Ball(this.paddle.x + this.paddle.width / 2, this.paddle.y - 8);
                        this.lasers = [];
                    }
                }

                // Update particles
                this.particles.update();

                // Update combo timer
                if (this.comboTimer > 0) {
                    this.comboTimer--;
                    if (this.comboTimer <= 0) {
                        this.combo = 0;
                    }
                }

                // Screen shake
                if (this.shakeTimer > 0) {
                    this.shakeTimer--;
                    this.shakeAmount = this.shakeTimer > 0 ? 5 : 0;
                }

                // Check level complete
                if (this.bricks.every(b => !b.active)) {
                    this.levelComplete();
                }
            }

            checkBallBrickCollision() {
                const ball = this.ball;
                if (ball.docked) return;

                for (let brick of this.bricks) {
                    if (!brick.active) continue;

                    const bx = brick.x;
                    const by = brick.y;
                    const bw = brick.width;
                    const bh = brick.height;

                    // AABB collision
                    if (ball.x + ball.radius > bx && ball.x - ball.radius < bx + bw &&
                        ball.y + ball.radius > by && ball.y - ball.radius < by + bh) {
                        
                        // Determine collision side
                        const overlapLeft = ball.x + ball.radius - bx;
                        const overlapRight = bx + bw - (ball.x - ball.radius);
                        const overlapTop = ball.y + ball.radius - by;
                        const overlapBottom = by + bh - (ball.y - ball.radius);

                        const minOverlapX = Math.min(overlapLeft, overlapRight);
                        const minOverlapY = Math.min(overlapTop, overlapBottom);

                        if (minOverlapX < minOverlapY) {
                            ball.dx = -ball.dx;
                        } else {
                            ball.dy = -ball.dy;
                        }

                        // Hit brick
                        const destroyed = brick.hit();
                        this.audio.brickHit();

                        // Combo
                        this.combo++;
                        this.comboTimer = 60;
                        this.comboDisplay = this.combo;

                        if (this.combo > 1) {
                            this.audio.combo();
                        }

                        // Score
                        const points = brick.points * (1 + Math.floor(this.combo / 5) * 0.5);
                        this.score += Math.floor(points);

                        // Effects
                        this.particles.emit(brick.x + brick.width / 2, brick.y + brick.height / 2, brick.getColor(), destroyed ? 25 : 10);

                        if (destroyed) {
                            this.audio.brickDestroy();
                            this.shakeTimer = 10;
                        }

                        break; // Only hit one brick per frame
                    }
                }
            }

            playerHit() {
                this.noDamageThisLevel = false;
                this.paddle.hit();
                this.audio.playerHit();
                this.shakeTimer = 15;
                this.particles.emit(this.paddle.x + this.paddle.width / 2, this.paddle.y, '#ff0044', 20);
            }

            levelComplete() {
                this.state = 'levelcomplete';
                this.audio.levelUp();

                // Calculate bonus
                const levelBonus = 500 * this.level;
                const noDamageBonus = this.noDamageThisLevel ? 1000 : 0;
                const totalBonus = levelBonus + noDamageBonus;
                this.score += totalBonus;

                document.getElementById('level-bonus').textContent = `BONUS: +${levelBonus}`;
                document.getElementById('nodamage-bonus').style.display = this.noDamageThisLevel ? 'block' : 'none';

                this.showScreen('levelcomplete-screen');

                // Auto advance after delay
                setTimeout(() => {
                    if (this.state === 'levelcomplete') {
                        this.level++;
                        this.noDamageThisLevel = true;
                        this.state = 'playing';
                        this.hideAllScreens();
                        this.initEntities();
                    }
                }, 3000);
            }

            gameOver() {
                this.state = 'gameover';
                this.audio.gameOver();

                document.getElementById('final-score').textContent = `SCORE: ${this.score}`;

                const newHighscore = document.getElementById('new-highscore');
                if (this.score > this.highScore) {
                    this.highScore = this.score;
                    localStorage.setItem('neonBreakerHighScore', this.highScore);
                    newHighscore.style.display = 'block';
                    this.updateHighScoreDisplay();
                } else {
                    newHighscore.style.display = 'none';
                }

                this.showScreen('gameover-screen');
            }

            draw() {
                const ctx = this.ctx;
                
                // Apply screen shake
                ctx.save();
                if (this.shakeAmount > 0) {
                    ctx.translate(
                        (Math.random() - 0.5) * this.shakeAmount,
                        (Math.random() - 0.5) * this.shakeAmount
                    );
                }

                // Clear and draw background
                this.drawBackground(ctx);

                // Draw bricks
                this.bricks.forEach(brick => brick.draw(ctx));

                // Draw lasers
                this.lasers.forEach(laser => laser.draw(ctx));

                // Draw paddle
                this.paddle.draw(ctx);

                // Draw ball
                this.ball.draw(ctx);

                // Draw particles
                this.particles.draw(ctx);

                // Draw HUD
                this.drawHUD(ctx);

                ctx.restore();
            }

            drawBackground(ctx) {
                // Dark background
                ctx.fillStyle = '#050508';
                ctx.fillRect(0, 0, this.width, this.height);

                // Animated stars
                ctx.fillStyle = 'rgba(255, 255, 255, 0.5)';
                this.stars.forEach(star => {
                    star.y += star.speed;
                    if (star.y > this.height) {
                        star.y = 0;
                        star.x = Math.random() * this.width;
                    }
                    ctx.beginPath();
                    ctx.arc(star.x, star.y, star.size, 0, Math.PI * 2);
                    ctx.fill();
                });

                // Grid lines
                ctx.strokeStyle = 'rgba(0, 255, 255, 0.05)';
                ctx.lineWidth = 1;
                for (let x = 0; x < this.width; x += 40) {
                    ctx.beginPath();
                    ctx.moveTo(x, 0);
                    ctx.lineTo(x, this.height);
                    ctx.stroke();
                }
                for (let y = 0; y < this.height; y += 40) {
                    ctx.beginPath();
                    ctx.moveTo(0, y);
                    ctx.lineTo(this.width, y);
                    ctx.stroke();
                }
            }

            drawHUD(ctx) {
                ctx.save();
                ctx.font = '16px Orbitron';
                ctx.textAlign = 'left';
                ctx.fillStyle = '#00ffff';
                ctx.shadowBlur = 10;
                ctx.shadowColor = '#00ffff';

                // Score
                ctx.fillText(`SCORE: ${this.score}`, 20, 28);

                // Lives
                ctx.fillStyle = '#ff0044';
                ctx.shadowColor = '#ff0044';
                ctx.fillText(`LIVES: ${this.lives}`, this.width / 2 - 60, 28);

                // Level
                ctx.fillStyle = '#00ff88';
                ctx.shadowColor = '#00ff88';
                ctx.textAlign = 'right';
                ctx.fillText(`LEVEL: ${this.level}`, this.width - 20, 28);

                // Combo
                if (this.comboDisplay > 1) {
                    ctx.textAlign = 'center';
                    ctx.font = '20px Orbitron';
                    ctx.fillStyle = '#ffff00';
                    ctx.shadowColor = '#ffff00';
                    ctx.shadowBlur = 15;
                    const pulse = Math.sin(Date.now() * 0.01) * 0.2 + 1;
                    ctx.font = `${20 * pulse}px Orbitron`;
                    ctx.fillText(`${this.comboDisplay}x COMBO!`, this.width / 2, 55);
                }

                ctx.restore();
            }

            loop(timestamp) {
                const deltaTime = timestamp - this.lastTime;
                this.lastTime = timestamp;

                this.update(deltaTime);
                this.draw();

                requestAnimationFrame(this.loop);
            }
        }

        // Start game when page loads
        window.addEventListener('load', () => {
            new Game();
        });
    </script>
</body>
</html>"}