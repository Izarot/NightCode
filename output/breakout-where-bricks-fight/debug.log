               // Left/Right walls\n                if (this.x - this.radius < 0) {\n                    this.x = this.radius;\n                    this.dx = Math.abs(this.dx);\n                }\n                if (this.x + this.radius > width) {\n                    this.x = width - this.radius;\n                    this.dx = -Math.abs(this.dx);\n                }\n                // Top\n                if (this.y - this.radius < 40) {\n                    this.y = 40 + this.radius;\n                    this.dy = Math.abs(this.dy);\n                }\n            }\n\n            checkPaddleCollision(paddle) {\n                if (this.dy < 0) return false;\n                \n                const px = paddle.x;\n                const py = paddle.y;\n                const pw = paddle.width;\n                const ph = paddle.height;\n\n                if (this.x + this.radius > px && this.x - this.radius < px + pw &&\n                    this.y + this.radius > py && this.y - this.radius < py + ph) {\n                    \n                    this.y = py - this.radius - 1;\n                    \n                    // Angle based on hit position\n                    const hitPos = (this.x - px) / pw;\n                    const angle = (hitPos - 0.5) * Math.PI * 0.7;\n                    \n                    this.dx = Math.sin(angle) * this.speed;\n                    this.dy = -Math.cos(angle) * this.speed;\n                    \n                    return true;\n                }\n                return false;\n            }\n        }\n\n        // ============================================\n        // PADDLE CLASS\n        // ============================================\n        class Paddle {\n            constructor(x, y) {\n                this.x = x;\n                this.y = y;\n                this.width = 120;\n                this.height = 15;\n                this.targetX = x;\n                this.speed = 12;\n                this.invincible = false;\n                this.invincibleTimer = 0;\n                this.flashTimer = 0;\n            }\n\n            update(canvasWidth) {\n                // Smooth movement\n                this.x += (this.targetX - this.x) * 0.15;\n                \n                // Bounds\n                if (this.x < 10) this.x = 10;\n                if (this.x + this.width > canvasWidth - 10) this.x = canvasWidth - this.width - 10;\n\n                // Invincibility\n                if (this.invincible) {\n                    this.invincibleTimer--;\n                    this.flashTimer++;\n                    if (this.invincibleTimer <= 0) {\n                        this.invincible = false;\n                    }\n                }\n            }\n\n            draw(ctx) {\n                ctx.save();\n                \n                // Flash effect when invincible\n                if (this.invincible && Math.floor(this.flashTimer / 5) % 2 === 0) {\n                    ctx.globalAlpha = 0.3;\n                }\n\n                // Glow\n                ctx.shadowBlur = 20;\n                ctx.shadowColor = this.invincible ? '#ff0044' : '#00ffff';\n                \n                // Main paddle\n                ctx.fillStyle = this.invincible ? '#ff0044' : '#00ffff';\n                ctx.beginPath();\n                ctx.roundRect(this.x, this.y, this.width, this.height, 5);\n                ctx.fill();\n                \n                // Inner highlight\n                ctx.fillStyle = 'rgba(255, 255, 255, 0.3)';\n                ctx.beginPath();\n                ctx.roundRect(this.x + 5, this.y + 2, this.width - 10, 4, 2);\n                ctx.fill();\n                \n                ctx.restore();\n            }\n\n            hit() {\n                this.invincible = true;\n                this.invincibleTimer = 90; // 1.5 seconds at 60fps\n                this.flashTimer = 0;\n            }\n\n            moveLeft() {\n                this.targetX -= this.speed;\n            }\n\n            moveRight(canvasWidth) {\n                this.targetX += this.speed;\n            }\n        }\n\n        // ============================================\n        // BRICK CLASS\n        // ============================================\n        class Brick {\n            constructor(x, y, tier) {\n                this.x = x;\n                this.y = y;\n                this.width = 70;\n                this.height = 25;\n                this.tier = tier;\n                this.hp = tier;\n                this.maxHp = tier;\n                this.points = tier * 10 * (tier === 4 ? 2 : 1);\n                this.fireRate = tier === 1 ? 0 : (tier === 2 ? 240 : tier === 3 ? 150 : 90);\n                this.fireTimer = Math.random() * this.fireRate;\n                this.charging = false;\n                this.chargeTime = 30;\n                this.chargeTimer = 0;\n                this.flashTimer = 0;\n                this.active = true;\n            }\n\n            getColor() {\n                const colors = ['#00ff88', '#ff8800', '#ff0044', '#ff00ff'];\n                return colors[this.tier - 1];\n            }\n\n            update(level) {\n                if (!this.active || this.tier === 1) return;\n                \n                const rateMod = Math.max(0.5, 1 - (level - 1) * 0.1);\n                const adjustedRate = this.fireRate * rateMod;\n                \n                this.fireTimer++;\n                \n                if (this.fireTimer >= adjustedRate - this.chargeTime && !this.charging) {\n                    this.charging = true;\n                    this.chargeTimer = 0;\n                }\n                \n                if (this.charging) {\n                    this.chargeTimer++;\n                    if (this.chargeTimer >= this.chargeTime) {\n                        this.fireTimer = 0;\n                        this.charging = false;\n                        return true; // Should fire\n                    }\n                }\n                return false;\n            }\n\n            draw(ctx) {\n                if (!this.active) return;\n                \n                const color = this.getColor();\n                \n                ctx.save();\n                \n                // Charging glow\n                if (this.charging) {\n                    const pulse = Math.sin(this.chargeTimer * 0.3) * 0.5 + 0.5;\n                    ctx.shadowBlur = 30 * pulse;\n                    ctx.shadowColor = '#ff00ff';\n                } else {\n                    ctx.shadowBlur = 10;\n                    ctx.shadowColor = color;\n                }\n                \n                // Main brick\n                ctx.fillStyle = color;\n                ctx.fillRect(this.x, this.y, this.width, this.height);\n                \n                // Damage cracks\n                if (this.hp < this.maxHp) {\n                    ctx.strokeStyle = 'rgba(0, 0, 0, 0.5)';\n                    ctx.lineWidth = 2;\n                    const cracks = this.maxHp - this.hp;\n                    for (let i = 0; i < cracks; i++) {\n                        ctx.beginPath();\n                        ctx.moveTo(this.x + 15 + i * 20, this.y);\n                        ctx.lineTo(this.x + 25 + i * 20, this.y + this.height);\n                        ctx.stroke();\n                    }\n                }\n                \n                // HP indicator\n                ctx.fillStyle = 'rgba(255, 255, 255, 0.8)';\n                ctx.font = '12px Orbitron';\n                ctx.textAlign = 'center';\n                ctx.fillText(this.hp.toString(), this.x + this.width / 2, this.y + this.height / 2 + 4);\n                \n                // Border\n                ctx.strokeStyle = 'rgba(255, 255, 255, 0.3)';\n                ctx.lineWidth = 1;\n                ctx.strokeRect(this.x, this.y, this.width, this.height);\n                \n                ctx.restore();\n            }\n\n            hit() {\n                this.hp--;\n                this.flashTimer = 5;\n                if (this.hp <= 0) {\n                    this.active = false;\n                    return true;\n                }\n                return false;\n            }\n        }\n\n        // ============================================\n        // LASER CLASS\n        // ============================================\n        class Laser {\n            constructor(x, y) {\n                this.x = x;\n                this.y = y;\n                this.width = 3;\n                this.height = 20;\n                this.speed = 8;\n                this.active = true;\n            }\n\n            update() {\n                this.y += this.speed;\n                return this.y < 620;\n            }\n\n            draw(ctx) {\n                ctx.save();\n                ctx.fillStyle = '#ff00ff';\n                ctx.shadowBlur = 15;\n                ctx.shadowColor = '#ff00ff';\n                ctx.fillRect(this.x - this.width / 2, this.y, this.width, this.height);\n                \n                // Glow trail\n                const gradient = ctx.createLinearGradient(this.x, this.y, this.x, this.y + this.height + 10);\n                gradient.addColorStop(0, 'rgba(255, 0, 255, 0.8)');\n                gradient.addColorStop(1, 'rgba(255, 0, 255, 0)');\n                ctx.fillStyle = gradient;\n                ctx.fillRect(this.x - this.width / 2 - 5, this.y + this.height, this.width + 10, 15);\n                ctx.restore();\n            }\n\n            checkCollision(paddle) {\n                return this.x > paddle.x && this.x < paddle.x + paddle.width &&\n                       this.y + this.height > paddle.y && this.y < paddle.y + paddle.height;\n            }\n        }\n\n        // ============================================\n        // MAIN GAME CLASS\n        // ============================================\n        class Game {\n            constructor() {\n          