    spawnParticles(x, y, color) {
        for (let i = 0; i < 10; i++) {
            this.particles.push(new Particle(x, y, color));
        }
    }
    checkPowerupCollision() {
        for (const pu of this.powerups) {
            if (pu.pos.x < this.paddle.pos.x + this.paddle.width &&
                pu.pos.x + pu.width > this.paddle.pos.x &&
                pu.pos.y < this.paddle.pos.y + this.paddle.height &&
                pu.pos.y + pu.height > this.paddle.pos.y) {
                pu.alive = false;
                this.audio.powerup();
                if (pu.type === 'widen') {
                    this.paddle.width = Math.min(this.paddle.width + 20, 200);
                } else if (pu.type === 'life') {
                    this.lives++;
                } else if (pu.type === 'speed') {
                    this.ball.speed = Math.min(this.ball.speed * 1.1, CONFIG.BALL_SPEED * CONFIG.MAX_SPEED_MULTIPLIER);
                    this.ball.vel.normalize().mul(this.ball.speed);
                }
            }
        }
    }
    levelUp() {
        this.state = STATE.LEVELUP;
        this.level++;
        this.ball.speed = Math.min(this.ball.speed * (1 + CONFIG.LEVEL_SPEED_INCREASE), CONFIG.BALL_SPEED * CONFIG.MAX_SPEED_MULTIPLIER);
        setTimeout(() => {
            this.spawnBricks();
            this.paddle.reset();
            this.ball.reset();
            this.state = STATE.PLAYING;
        }, 1500);
    }
    loseLife() {
        this.lives--;
        this.audio.lifeLost();
        this.combo = 0;
        if (this.lives <= 0) {
            this.gameOver();
        } else {
            this.paddle.reset();
            this.ball.reset();
        }
    }
    gameOver() {
        this.state = STATE.GAMEOVER;
        this.audio.gameOver();
        if (this.score > this.highScore) {
            this.highScore = this.score;
            localStorage.setItem('starBreakoutHighScore', this.highScore);
        }
    }
    render() {
        const ctx = this.ctx;
        // Background gradient
        const grad = ctx.createLinearGradient(0, 0, 0, CONFIG.GAME_HEIGHT);
        CONFIG.COLORS.BG_GRADIENT.forEach((c, i) => grad.addColorStop(i / (CONFIG.COLORS.BG_GRADIENT.length - 1), c));
        ctx.fillStyle = grad;
        ctx.fillRect(0, 0, CONFIG.GAME_WIDTH, CONFIG.GAME_HEIGHT);
        // Stars background
        ctx.fillStyle = '#fff';
        for (let i = 0; i < 50; i++) {
            const x = (i * 123 + this.timer * 10) % CONFIG.GAME_WIDTH;
            const y = (i * 456 + this.timer * 5) % CONFIG.GAME_HEIGHT;
            const size = Math.sin(this.timer + i) * 0.5 + 1;
            ctx.globalAlpha = 0.3 + 0.3 * Math.sin(this.timer * 2 + i);
            drawStar(ctx, x, y, size, 5, 0);
            ctx.fill();
        }
        ctx.globalAlpha = 1;
        // Draw game objects
        this.bricks.forEach(b => b.draw(ctx));
        this.particles.forEach(p => p.draw(ctx));
        this.powerups.forEach(p => p.draw(ctx));
        this.paddle.draw(ctx);
        this.ball.draw(ctx);
        // HUD
        ctx.fillStyle = CONFIG.COLORS.HUD;
        ctx.font = '20px Montserrat';
        ctx.textAlign = 'left';
        ctx.fillText(`Score: ${this.score}`, 20, 30);
        ctx.fillText(`Level: ${this.level}`, 20, 55);
        ctx.fillText(`Lives: ${this.lives}`, 20, 80);
        ctx.textAlign = 'right';
        ctx.fillStyle = CONFIG.COLORS.HIGH_SCORE;
        ctx.fillText(`High Score: ${this.highScore}`, CONFIG.GAME_WIDTH - 20, 30);
        ctx.fillStyle = CONFIG.COLORS.HUD;
        ctx.fillText(`Combo: ${this.combo}`, CONFIG.GAME_WIDTH - 20, 55);
        // State overlays
        if (this.state === STATE.MENU) {
            this.drawOverlay('STAR BREAKOUT', 'Click or press SPACE to start', 'Use ← → or A/D to move, P to pause');
        } else if (this.state === STATE.PAUSED) {
            this.drawOverlay('PAUSED', 'Press SPACE to resume');
        } else if (this.state === STATE.GAMEOVER) {
            this.drawOverlay('GAME OVER', `Final Score: ${this.score}`, 'Click or press R to restart');
        } else if (this.state === STATE.LEVELUP) {
            this.drawOverlay(`LEVEL ${this.level}`, 'Get ready!');
        }
    }
    drawOverlay(title, subtitle, hint = '') {
        const ctx = this.ctx;
        ctx.fillStyle = 'rgba(10, 15, 51, 0.85)';
        ctx.fillRect(0, 0, CONFIG.GAME_WIDTH, CONFIG.GAME_HEIGHT);
        ctx.fillStyle = '#fff';
        ctx.textAlign = 'center';
        ctx.font = 'bold 48px Montserrat';
        ctx.fillText(title, CONFIG.GAME_WIDTH / 2, CONFIG.GAME_HEIGHT / 2 - 40);
        ctx.font = '24px Montserrat';
        ctx.fillText(subtitle, CONFIG.GAME_WIDTH / 2, CONFIG.GAME_HEIGHT / 2 + 10);
        if (hint) {
            ctx.font = '18px Montserrat';
            ctx.fillStyle = '#aaa';
            ctx.fillText(hint, CONFIG.GAME_WIDTH / 2, CONFIG.GAME_HEIGHT / 2 + 50);
        }
    }
}

