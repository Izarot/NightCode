== 'ArrowRight' || e.key === 'd') this.input.right = false;\n        });\n        this.canvas.addEventListener('mousemove', e => this.handleMouse(e));\n        this.canvas.addEventListener('touchmove', e => { e.preventDefault(); this.handleTouch(e.touches[0]); }, { passive: false });\n        this.canvas.addEventListener('touchstart', e => { e.preventDefault(); this.handleTouch(e.touches[0]); }, { passive: false });\n        this.canvas.addEventListener('click', () => {\n            if (this.state === STATE.MENU) this.start();\n            else if (this.state === STATE.GAMEOVER) this.restart();\n        });\n    }\n    handleMouse(e) {\n        const rect = this.canvas.getBoundingClientRect();\n        const x = (e.clientX - rect.left - this.offsetX) / this.scale;\n        this.paddle.targetX = x - this.paddle.width / 2;\n    }\n    handleTouch(touch) {\n        const rect = this.canvas.getBoundingClientRect();\n        const x = (touch.clientX - rect.left - this.offsetX) / this.scale;\n        this.paddle.targetX = x - this.paddle.width / 2;\n    }\n    resize() {\n        const cw = window.innerWidth;\n        const ch = window.innerHeight;\n        const gameAspect = CONFIG.GAME_WIDTH / CONFIG.GAME_HEIGHT;\n        const screenAspect = cw / ch;\n        if (screenAspect > gameAspect) {\n            this.scale = ch / CONFIG.GAME_HEIGHT;\n            this.offsetX = (cw - CONFIG.GAME_WIDTH * this.scale) / 2;\n            this.offsetY = 0;\n        } else {\n            this.scale = cw / CONFIG.GAME_WIDTH;\n            this.offsetX = 0;\n            this.offsetY = (ch - CONFIG.GAME_HEIGHT * this.scale) / 2;\n        }\n        this.canvas.style.width = `${CONFIG.GAME_WIDTH * this.scale}px`;\n        this.canvas.style.height = `${CONFIG.GAME_HEIGHT * this.scale}px`;\n        this.canvas.width = CONFIG.GAME_WIDTH;\n        this.canvas.height = CONFIG.GAME_HEIGHT;\n    }\n    togglePause() {\n        if (this.state === STATE.PLAYING) this.state = STATE.PAUSED;\n        else if (this.state === STATE.PAUSED) this.state = STATE.PLAYING;\n    }\n    start() {\n        this.state = STATE.PLAYING;\n        this.timer = 0;\n        this.level = 1;\n        this.score = 0;\n        this.lives = CONFIG.LIVES;\n        this.combo = 0;\n        this.maxCombo = 0;\n        this.ball.speed = CONFIG.BALL_SPEED;\n        this.spawnBricks();\n        this.paddle.reset();\n        this.ball.reset();\n    }\n    restart() {\n        this.start();\n    }\n    spawnBricks() {\n        this.bricks = [];\n        const colors = CONFIG.COLORS.BRICKS;\n        for (let r = 0; r < CONFIG.BRICK_ROWS; r++) {\n            for (let c = 0; c < CONFIG.BRICK_COLS; c++) {\n                const x = CONFIG.BRICK_OFFSET_LEFT + c * (CONFIG.BRICK_WIDTH + CONFIG.BRICK_PADDING);\n                const y = CONFIG.BRICK_OFFSET_TOP + r * (CONFIG.BRICK_HEIGHT + CONFIG.BRICK_PADDING);\n                const color = colors[(r + c + this.level) % colors.length];\n                const tier = Math.random() < 0.1 ? 1 : 0;\n                this.bricks.push(new Brick(x, y, color, tier));\n            }\n        }\n    }\n    loop(time) {\n        const dt = (time - this.lastTime) / 1000;\n        this.lastTime = time;\n        this.accumulator += dt;\n        while (this.accumulator >= this.fixedDt) {\n            this.update(this.fixedDt);\n            this.accumulator -= this.fixedDt;\n        }\n        this.render();\n        requestAnimationFrame(t => this.loop(t));\n    }\n    update(dt) {\n        if (this.state !== STATE.PLAYING) return;\n        this.timer += dt;\n        this.paddle.update(dt, this.input);\n        this.ball.update(dt);\n        this.checkCollisions();\n        this.particles = this.particles.filter(p => p.life > 0);\n        this.particles.forEach(p => p.update(dt));\n        this.powerups = this.powerups.filter(p => p.alive);\n        this.powerups.forEach(p => p.update(dt));\n        this.checkPowerupCollision();\n        if (this.bricks.every(b => !b.alive)) this.levelUp();\n        if (this.ball.pos.y > CONFIG.GAME_HEIGHT) this.loseLife();\n    }\n    checkCollisions() {\n        // Paddle\n        if (this.ball.pos.y + this.ball.radius >= this.paddle.pos.y &&\n            this.ball.pos.y - this.ball.radius <= this.paddle.pos.y + this.paddle.height &&\n            this.ball.pos.x >= this.paddle.pos.x &&\n            this.ball.pos.x <= this.paddle.pos.x + this.paddle.width) {\n            this.ball.pos.y = this.paddle.pos.y - this.ball.radius;\n            const rel = (this.ball.pos.x - (this.paddle.pos.x + this.paddle.width/2)) / (this.paddle.width/2);\n            const angle = Math.max(-1, Math.min(1, rel)) * Math.PI / 6;\n            this.ball.vel.set(Math.sin(angle), -Math.cos(angle)).mul(this.ball.speed);\n            this.audio.bounce();\n            this.combo = 0;\n        }\n        // Bricks\n        for (const brick of this.bricks) {\n            if (!brick.alive) continue;\n            if (this.ball.pos.x + this.ball.radius > brick.pos.x &&\n                this.ball.pos.x - this.ball.radius < brick.pos.x + brick.width &&\n                this.ball.pos.y + this.ball.radius > brick.pos.y &&\n                this.ball.pos.y - this.ball.radius < brick.pos.y + brick.height) {\n                brick.alive = false;\n                this.audio.brickBreak();\n                this.score += brick.points * (1 + Math.floor(this.combo / 5));\n                this.combo++;\n                this.maxCombo = Math.max(this.maxCombo, this.combo);\n                this.spawnParticles(brick.pos.x + brick.width/2, brick.pos.y + brick.height/2, brick.color);\n                if (Math.random() < CONFIG.POWERUP_CHANCE) {\n                    const types = ['widen', 'life', 'speed'];\n                    this.powerups.push(new PowerUp(brick.pos.x + brick.width/2, brick.pos.y + brick.height/2, types[Math.floor(Math.random()*types.length)]));\n                }\n                // Determine bounce direction\n                const overlapX = Math.min(this.ball.pos.x + this.ball.radius - brick.pos.x, brick.pos.x + brick.width - (this.ball.pos.x - this.ball.radius));\n                const overlapY = Math.min(this.ball.pos.y + this.ball.radius - brick.pos.y, brick.pos.y + brick.height - (this.ball.pos.y - this.ball.radius));\n                if (overlapX < overlapY) this.ball.vel.x = -this.ball.vel.x;\n               else this.ball.vel.y = -this.ball.vel.y;
