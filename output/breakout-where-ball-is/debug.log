();\n        this.vel = new Vector();\n        this.speed = CONFIG.BALL_SPEED;\n        this.trail = [];\n        this.reset();\n    }\n    reset() {\n        this.pos.set(CONFIG.GAME_WIDTH / 2, CONFIG.GAME_HEIGHT / 2);\n        const angle = (Math.random() * 30 + 30) * Math.PI / 180;\n        this.vel.set(Math.cos(angle), -Math.sin(angle)).mul(this.speed);\n        this.trail = [];\n    }\n    update(dt) {\n        this.trail.unshift(this.pos.clone());\n        if (this.trail.length > 8) this.trail.pop();\n        this.pos.add(this.vel.clone().mul(dt));\n        if (this.pos.x - this.radius < 0) { this.pos.x = this.radius; this.vel.x = -this.vel.x; }\n        if (this.pos.x + this.radius > CONFIG.GAME_WIDTH) { this.pos.x = CONFIG.GAME_WIDTH - this.radius; this.vel.x = -this.vel.x; }\n        if (this.pos.y - this.radius < 0) { this.pos.y = this.radius; this.vel.y = -this.vel.y; }\n    }\n    draw(ctx) {\n        ctx.strokeStyle = CONFIG.COLORS.BALL;\n        ctx.lineWidth = 2;\n        this.trail.forEach((p, i) => {\n            const alpha = 1 - i / this.trail.length;\n            ctx.globalAlpha = alpha * 0.5;\n            drawStar(ctx, p.x, p.y, this.radius * 0.5, 5, 0);\n            ctx.stroke();\n        });\n        ctx.globalAlpha = 1;\n        ctx.fillStyle = CONFIG.COLORS.BALL;\n        ctx.shadowColor = CONFIG.COLORS.BALL;\n        ctx.shadowBlur = 10;\n        drawStar(ctx, this.pos.x, this.pos.y, this.radius, 5, 0);\n        ctx.fill();\n        ctx.shadowBlur = 0;\n    }\n}\n\nfunction drawStar(ctx, cx, cy, r, spikes, rot) {\n    ctx.beginPath();\n    ctx.moveTo(cx, cy - r);\n    for (let i = 0; i < spikes; i++) {\n        const angle = rot + i * 2 * Math.PI / spikes;\n        const x = cx + Math.sin(angle) * r;\n        const y = cy - Math.cos(angle) * r;\n        ctx.lineTo(x, y);\n        const innerAngle = angle + Math.PI / spikes;\n        const ix = cx + Math.sin(innerAngle) * r * 0.4;\n        const iy = cy - Math.cos(innerAngle) * r * 0.4;\n   