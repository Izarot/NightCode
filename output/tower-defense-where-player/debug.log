"></canvas>\n<div id=\"ui-layer\">\n<div class=\"top-bar\">\n<div class=\"level-info\">\n<span id=\"level-name\">Clockwork Factory - Level 1</span><br>\n<span class=\"wave-num\">Wave <span id=\"wave-num\">1</span>/10</span>\n</div>\n<div class=\"core-hp\">\n<span class=\"core-hp-label\">CORE HP</span>\n<div class=\"hp-bar-outer\"><div class=\"hp-bar-inner\" id=\"hp-bar\"></div></div>\n<span id=\"hp-text\" style=\"font-weight:bold;color:#E74C3C\">20/20</span>\n</div>\n<div class=\"gear-display\">\n<div class=\"gear-icon\"></div>\n<span id=\"gear-count\">200</span>\n</div>\n</div>\n<div class=\"speedrun-timer\">⏱ <span id=\"speedrun-timer\">00:00.0</span></div>\n<div class=\"bottom-panel\">\n<div class=\"hotbar\" id=\"hotbar\"></div>\n<button class=\"start-wave-btn\" id=\"start-wave-btn\">⚔ Start Wave</button>\n</div>\n<div class=\"context-panel\" id=\"context-panel\">\n<h3>Trap Info</h3>\n<div id=\"context-content\">\n<div style=\"text-align:center;color:#888;font-style:italic;\">Select a trap to view details</div>\n</div>\n</div>\n<div id=\"modal-root\"></div>\n</div>\n</div>\n</div>\n<script>\n(() => {\n'use strict';\n\n// ========== CONFIG ==========\nconst CONFIG = {\n  GRID_W: 40,\n  GRID_H: 30,\n  TILE: 32,\n  LOGICAL_W: 1280,\n  LOGICAL_H: 720,\n  CORE_HP: 20,\n  START_GEARS: 250,\n  HIGH_SCORE_KEY: 'tinkerer_bastion_highscore',\n  TIMER_KEY: 'tinkerer_bastion_best_time'\n};\n\nconst TRAP_TYPES = {\n  spike: { name: 'Spike Pit', icon: '🗡️', cost: 50, dmg: 15, cd: 1.0, color: '#C0392B', range: 0.5, desc: '15 dmg, 0.5s stun' },\n  zapper: { name: 'Arcane Zapper', icon: '⚡', cost: 120, dmg: 25, cd: 2.0, color: '#9B59B6', range: 2.5, desc: '25 dmg + chain' },\n  boulder: { name: 'Boulder Drop', icon: '🪨', cost: 200, dmg: 100, cd: 5.0, color: '#7F8C8D', range: 2.0, aoe: true, size: 2, desc: '100 AoE dmg' },\n  steam: { name: 'Steam Vent', icon: '💨', cost: 80, dmg: 5, cd: 0.5, color: '#ECF0F1', range: 0.5, dot: true, desc: '5 dmg/sec continuous' },\n  tar: { name: 'Tar Pit', icon: '🛢️', cost: 40, cd: 3.0, color: '#34495E', range: 0.5, slow: true, desc: 'Slows 30% for 2s' },\n  net: { name: 'Tripwire Net', icon: '🕸️', cost: 100, cd: 4.0, color: '#16A085', range: 1.0, stun: true, desc: 'Stuns 1.5s' },\n  push: { name: 'Force Bellows', icon: '💨', cost: 90, cd: 3.0, color: '#3498DB', range: 1.0, knockback: true, desc: 'Knockback 2 tiles' },\n  scrap: { name: 'Scrap Collector', icon: '⚙️', cost: 60, cd: 0, color: '#F39C12', range: 3.0, generate: 2, desc: '+2 Gears per kill' },\n  repair: { name: 'Repair Node', icon: '🔧', cost: 50, cd: 1.0, color: '#27AE60', range: 1.5, heal: true, desc: 'Heals adjacent traps' },\n  spotlight: { name: 'Spotlight', icon: '🔦', cost: 70, cd: 0, color: '#F1C40F', range: 5.0, reveal: true, desc: 'Reveals stealth' }\n};\n\nconst ENEMY_TYPES = {\n  grunt: { name: 'Cogwalker', hp: 50, speed: 2.0, color: '#5D6D7E', reward: 8, size: 0.7, icon: '🤖' },\n  bruiser: { name: 'Ironclad', hp: 200, speed: 1.0, color: '#34495E', reward: 20, size: 0.9, icon: '🦾' },\n  swarm: { name: 'Sparks', hp: 10, speed: 3.5, color: '#F39C12', reward: 3, size: 0.4, icon: '✨' },\n  stealth: { name: 'Shade', hp: 80, speed: 2.5, color: '#2C3E50', reward: 15, size: 0.6, icon: '👤', stealth: true },\n  boss: { name: 'Gearking', hp: 2000, speed: 1.5, color: '#8E44AD', reward: 200, size: 1.4, icon: '👑' }\n};\n\nconst WAVES = [\n  [{type:'grunt',count:8,delay:1.5}],\n  [{type:'grunt',count:10,delay:1.2},{type:'swarm',count:10,delay:0.4}],\n  [{type:'grunt',count:6,delay:1.5},{type:'bruiser',count:2,delay:4}],\n  [{type:'swarm',count:20,delay:0.3},{type:'stealth',count:4,delay:2}],\n  [{type:'bruiser',count:4,delay:3},{type:'grunt',count:8,delay:1}],\n  [{type:'grunt',count:12,delay:1},{type:'stealth',count:6,delay:2.5}],\n  [{type:'swarm',count:30,delay:0.2},{type:'bruiser',count:3,delay:4}],\n  [{type:'stealth',count:10,delay:2},{type:'bruiser',count:5,delay:3}],\n  [{type:'grunt',count:20,delay:0.8},{type:'swarm',count:40,delay:0.2}],\n  [{type:'boss',count:1,delay:1},{type:'grunt',count:15,delay:1.5}]\n];\n\n// ========== UTILITIES ==========\nconst dist = (a, b) => Math.hypot(a.x - b.x, a.y - b.y);\nconst lerp = (a, b, t) => a + (b - a) * t;\nconst clamp = (v, mn, mx) => Math.max(mn, Math.min(mx, v));\nconst rand = (a, b) => a + Math.random() * (b - a);\n\n// ========== AUDIO ==========\nconst Audio = {\n  ctx: null,\n  init() {\n    if (!this.ctx) {\n      try { this.ctx = new (window.AudioContext || window.webkitAudioContext)(); } catch(e) {}\n    }\n  },\n  play(type) {\n    if (!this.ctx) return;\n    if (this.ctx.state === 'suspended') this.ctx.resume();\n    const t = this.ctx.currentTime;\n    const osc = this.ctx.createOscillator();\n    const gain = this.ctx.createGain();\n    osc.connect(gain); gain.connect(this.ctx.destination);\n    const presets = {\n      place: { f: 220, f2: 150, d: 0.15, type: 'square', vol: 0.15 },\n      trigger: { f: 440, f2: 220, d: 0.1, type: 'sawtooth', vol: 0.12 },\n      hit: { f: 180, f2: 90, d: 0.08, type: 'square', vol: 0.1 },\n      death: { f: 300, f2: 50, d: 0.25, type: 'triangle', vol: 0.15 },\n      ui: { f: 800, f2: 800, d: 0.05, type: 'sine', vol: 0.08 },\n      error: { f: 150, f2: 100, d: 0.2, type: 'square', vol: 0.12 },\n      wave: { f: 600, f2: 400, d: 0.4, type: 'triangle', vol: 0.18 },\n      victory: { f: 523, f2: 784, d: 0.8, type: 'sine', vol: 0.2 }\n    };\n    const p = presets[type] || presets.ui;\n    osc.type = p.type;\n    osc.frequency.setValueAtTime(p.f, t);\n    osc.frequency.exponentialRampToValueAtTime(Math.max(p.f2, 1), t + p.d);\n    gain.gain.setValueAtTime(p.vol, t);\n    gain.gain.exponentialRampToValueAtTime(0.001, t + p.d);\n    osc.start(t);\n    osc.stop(t + p.d);\n  }\n};\n\n// ========== PARTICLES ==========\nclass Particle {\n  constructor() { this.active = false; }\n  init(x, y, vx, vy, color, life, size, type = 'normal') {\n    this.x = x; this.y = y;\n    this.vx = vx; this.vy = vy;\n    this.color = color;\n    this.life = this.maxLife = life;\n    this.size = size;\n    this.type = type;\n    this.active = true;\n  }\n  update(dt) {\n    if (!this.active) return;\n    this.x += this.vx * dt;\n    this.y += this.vy * dt;\n    this.life -= dt;\n    if (this.type === 'steam') this.vy -= 30 * dt;\n    if (this.life <= 0) this.active = false;\n  }\n  render(ctx) {\n    if (!this.active) return;\n    const a = this.life / this.maxLife;\n    ctx.globalAlpha = a;\n    ctx.fillStyle = this.color;\n    ctx.beginPath();\n    ctx.arc(this.x, this.y, this.size * a, 0, Math.PI * 2);\n    ctx.fill();\n    ctx.globalAlpha = 1;\n  }\n}\nclass ParticlePool {\n  constructor(size) {\n    this.pool = [];\n    for (let i = 0; i < size; i++) this.pool.push(new Particle());\n  }\n  spawn(x, y, vx, vy, color, life, size, type) {\n    for (let p of this.pool) {\n      if (!p.active) { p.init(x, y, vx, vy, color, life, size, type); return p; }\n    }\n    if (this.pool.length < 500) {\n      const np = new Particle();\n      np.init(x, y, vx, vy, color, life, size, type);\n      this.pool.push(np);\n      return np;\n    }\n  }\n  update(dt) { for (let p of this.pool) p.update(dt); }\n  render(ctx) { for (let p of this.pool) if (p.active) p.render(ctx); }\n}\n\n// ========== FLOATING TEXT ==========\nclass FloatingText {\n  constructor() { this.active = false; this.text = ''; }\n  init(x, y, text, color) {\n    this.x = x; this.y = y;\n    this.vy = -40;\n    this.life = this.maxLife = 1.0;\n    this.text = text;\n    this.color = color;\n    this.active = true;\n  }\n  update(dt) {\n    if (!this.active) return;\n    this.y += this.vy * dt;\n    this.vy *= 0.95;\n    this.life -= dt;\n    if (this.life <= 0) this.active = false;\n  }\n  render(ctx) {\n    if (!this.active) return;\n    ctx.globalAlpha = this.life / this.maxLife;\n    ctx.fillStyle = this.color;\n    ctx.font = 'bold 16px Georgia';\n    ctx.strokeStyle = '#000';\n    ctx.lineWidth = 3;\n    ctx.textAlign = 'center';\n    ctx.strokeText(this.text, this.x, this.y);\n    ctx.fillText(this.text, this.x, this.y);\n    ctx.globalAlpha = 1;\n  }\n}\n\n// ========== PATH SYSTEM ==========\nclass PathSystem {\n  constructor() {\n    this.grid = [];\n    this.spawn = { x: 1, y: 1 };\n    this.core = { x: CONFIG.GRID_W - 2, y: CONFIG.GRID_H - 2 };\n    this.initGrid();\n    this.makePath();\n  }\n  initGrid() {\n    for (let y = 0; y < CONFIG.GRID_H; y++) {\n      this.grid[y] = [];\n      for (let x = 0; x < CONFIG.GRID_W; x++) {\n        this.grid[y][x] = 0; // 0=empty, 1=path, 2=wall\n      }\n    }\n  }\n  makePath() {\n    const path = [];\n    let x = 1, y = 1;\n    path.push({x, y});\n    const steps = 80;\n    for (let i = 0; i < steps; i++) {\n      const dirs = [{dx:1,dy:0},{dx:-1,dy:0},{dx:0,dy:1},{dx:0,dy:-1}];\n      const valid = dirs.filter(d => {\n        const nx = x + d.dx, ny = y + d.dy;\n        if (nx < 0 || nx >= CONFIG.GRID_W || ny < 0 || ny >= CONFIG.GRID_H) return false;\n        if (this.grid[ny] && this.grid[ny][nx] === 2) return false;\n        return true;\n      });\n      const chosen = valid[Math.floor(Math.random() * valid.length)] || {dx:1,dy:0};\n      x += chosen.dx; y += chosen.dy;\n      path.push({x, y});\n    }\n    this.pathPoints = path;\n    this.spawn = path[0];\n    this.core = path[path.length - 1];\n    path.forEach(p => { if (this.grid[p.y]) this.grid[p.y][p.x] = 1; });\n    // Walls on edges\n    for (let y = 0; y < CONFIG.GRID_H; y++) {\n      for (let x = 0; x < CONFIG.GRID_W; x++) {\n        if (x === 0 || x === CONFIG.GRID_W-1 || y === 0 || y === CONFIG.GRID_H-1) {\n          this.grid[y][x] = 2;\n        }\n      }\n    }\n    // Some interior walls\n    for (let i = 0; i < 30; i++) {\n      const wx = 2 + Math.floor(Math.random() * (CONFIG.GRID_W - 4));\n      const wy = 2 + Math.floor(Math.random() * (CONFIG.GRID_H - 4));\n      if (this.grid[wy] && this.grid[wy][wx] === 0) this.grid[wy][wx] = 2;\n    }\n    // Carve path through walls\n    path.forEach(p => { if (this.grid[p.y]) this.grid[p.y][p.x] = 1; });\n  }\n  getNeighbors(node) {\n    const dirs = [{x:1,y:0},{x:-1,y:0},{x:0,y:1},{x:0,y:-1}];\n    const result = [];\n    for (let d of dirs) {\n      const nx = node.x + d.x, ny = node.y + d.y;\n      if (nx >= 0 && nx < CONFIG.GRID_W && ny >= 0 && ny < CONFIG.GRID_H) {\n        const tile = this.grid[ny][nx];\n        if (tile !== 2) result.push({x: nx, y: ny, g: node.g + 1, parent: node});\n      }\n    }\n    return result;\n  }\n  findPath(start, end) {\n    const open = [{x: start.x, y: start.y, g: 0, h: dist(start, end), parent: null}];\n    const closed = new Set();\n    const key = n => n.x + ',' + n.y;\n    while (open.length) {\n      open.sort((a, b) => (a.g + a.h) - (b.g + b.h));\n      const curr = open.shift();\nif (closed.has(key(curr))) continue;\n      closed.add(key(curr));\n      if (curr.x === end.x && curr.y === end.y) {\n        const path = [];\n        let n = curr;\n        while (n) { path.unshift({x: n.x, y: n.y}); n = n.parent; }\n        return path;\n      }\n      const neighbors = this.getNeighbors(curr);\n      neighbors.forEach(n => {\n        const k = key(n);\n        if (!closed.has(k)) {\n          n.h = dist(n, end);\n          open.push(n);\n        }\n      });\n    }\n    return null;\n  }\n  buildFullPath() {\n    const p = this.findPath(this.spawn, this.core);\n    if (!p) {\n      // Fallback straight path\n      const path = [];\n      for (let i = 0; i < 40; i++) path.push({x: i % CONFIG.GRID_W, y: Math.floor(i / CONFIG.GRID_W) || 1});\n      this.fullPath = path;\n      this.smoothPath = this.smooth(path);\n    } else {\n      this.fullPath = p;\n      this.smoothPath = this.smooth(p);\n    }\n  }\n  smooth(path) {\n    if (!path || path.length < 2) return path || [];\n    const result = [];\n    for (let i = 0; i < path.length - 1; i++) {\n      const a = path[i], b = path[i+1];\n      const steps = 4;\n      for (let s = 0; s < steps; s++) {\n        const t = s / steps;\n        result.push({x: lerp(a.x, b.x, t), y: lerp(a.y, b.y, t)});\n      }\n    }\n    result.push(path[path.length - 1]);\n    return result;\n  }\n  isPath(gx, gy) { return this.grid[gy] && this.grid[gy][gx] === 1; }\n  isWall(gx, gy) { return this.grid[gy] && this.grid[gy][gx] === 2; }\n  isEmpty(gx, gy) { return this.grid[gy] && this.grid[gy][gx] === 0; }\n}\n\n// ========== TRAPS ==========\nclass Trap {\n  constructor(type, gx, gy) {\n    this.type = type;\n    this.gx = gx; this.gy = gy;\n    const cfg = TRAP_TYPES[type];\n    this.dmg = cfg.dmg || 0;\n    this.cd = cfg.cd;\n    this.range = cfg.range;\n    this.aoe = cfg.aoe || false;\n    this.size = cfg.size || 1;\n    this.dot = cfg.dot || false;\n    this.slow = cfg.slow || false;\n    this.stun = cfg.stun || false;\n    this.knockback = cfg.knockback || false;\n    this.generate = cfg.generate || 0;\n    this.heal = cfg.heal || false;\n    this.reveal = cfg.reveal || false;\n    this.level = 1;\n    this.cooldown = 0;\n    this.targets = new Set();\n    this.kills = 0;\n    this.color = cfg.color;\n    this.flash = 0;\n  }\n  upgradeCost() { return Math.floor(TRAP_TYPES[this.type].cost * 0.7 * this.level); }\n  sellValue() { return Math.floor(TRAP_TYPES[this.type].cost * 0.5 + this.kills * 2); }\n  upgrade() {\n    this.level++;\n    this.dmg = Math.floor((TRAP_TYPES[this.type].dmg || 0) * (1 + 0.5 * (this.level - 1)));\n    if (this.dot) this.dmg = Math.floor(5 * this.level);\n    if (this.cd > 0) this.cd = Math.max(0.2, TRAP_TYPES[this.type].cd - 0.1 * (this.level - 1));\n    this.range = TRAP_TYPES[this.type].range + 0.3 * (this.level - 1);\n    Audio.play('ui');\n  }\n  update(dt, enemies, game) {\n    if (this.cooldown > 0) this.cooldown -= dt;\n    if (this.flash > 0) this.flash -= dt;\n    const cx = (this.gx + (this.size > 1 ? this.size / 2 : 0.5)) * CONFIG.TILE;\n    const cy = (this.gy + (this.size > 1 ? this.size / 2 : 0.5)) * CONFIG.TILE;\n    // Reveal stealth\n    if (this.reveal) {\n      enemies.forEach(e => {\n        if (e.alive && dist({x: cx, y: cy}, e) < this.range * CONFIG.TILE) e.revealed = true;\n      });\n    }\n    if (this.heal) {\n      // Heal adjacent traps\n      if (this.cooldown <= 0) {\n        game.traps.forEach(t => {\n          if (t !== this && Math.abs(t.gx - this.gx) + Math.abs(t.gy - this.gy) <= this.range * 2) {\n            // Visual only effect\n          }\n        });\n      }\n    }\n    if (this.cooldown > 0 || !enemies.length) return;\n    // Find target in range\n    let inRange = [];\n    enemies.forEach(e => {\n      if (!e.alive) return;\n      const dx = e.x - cx, dy = e.y - cy;\n      const d = Math.hypot(dx, dy);\n      if (d < this.range * CONFIG.TILE) inRange.push(e);\n    });\n    if (!inRange.length) return;\n    inRange.sort((a, b) => b.pathIdx - a.pathIdx);\n    const target = inRange[0];\n    this.fire(target, cx, cy, enemies, game);\n    this.cooldown = this.cd;\n  }\n  fire(target, cx, cy, enemies, game) {\n    this.flash = 0.15;\n    if (this.generate) {\n      game.gears += this.generate * this.level;\n      game.spawnText(cx, cy - 20, '+' + (this.generate * this.level) + '⚙', '#F39C12');\n    }\n    if (this.stun) {\n      target.stunTimer = 1.5 * this.level;\n      target.applyEffect('stun', 1.5 * this.level);\n    }\n    if (this.slow) {\n      target.slowTimer = 2.0;\n      target.slowFactor = 0.7;\n    }\n    if (this.knockback) {\n      const ang = Math.atan2(target.y - cy, target.x - cx);\n      target.knockX = Math.cos(ang) * CONFIG.TILE * 2;\n      target.knockY = Math.sin(ang) * CONFIG.TILE * 2;\n      target.knockTimer = 0.3;\n    }\n    if (this.aoe) {\n      game.spawnExplosion(cx, cy, this.range * CONFIG.TILE * 1.2, this.dmg, this.color);\n      enemies.forEach(e => {\n        if (e.alive && e !== target && dist({x: cx, y: cy}, e) < this.range * CONFIG.TILE * 1.2) {\n          e.takeDamage(this.dmg, game);\n        }\n      });\n      target.takeDamage(this.dmg, game);\n      Audio.play('trigger');\n    } else if (this.dot) {\n      target.applyEffect('dot', {dmg: this.dmg, time: 3, color: this.color});\n      target.takeDamage(this.dmg, game);\n      game.spawnParticles(cx, cy, this.color, 3);\n      Audio.play('trigger');\n    } else if (this.dmg > 0) {\n      target.takeDamage(this.dmg, game);\n      game.spawnParticles(target.x, target.y, this.color, 4);\n      Audio.play('hit');\n    } else {\n      game.spawnParticles(cx, cy, this.color, 3);\n      Audio.play('trigger');\n    }\n  }\n  render(ctx) {\n    const x = this.gx * CONFIG.TILE;\n    const y = this.gy * CONFIG.TILE;\n    const sz = this.size * CONFIG.TILE;\n    // Base\n    ctx.fillStyle = this.color;\n    ctx.globalAlpha = 0.6;\n    ctx.fillRect(x + 2, y + 2, sz - 4, sz - 4);\n    ctx.globalAlpha = 1;\n    // Border\n    ctx.strokeStyle = '#1a1a1a';\n    ctx.lineWidth = 2;\n    ctx.strokeRect(x + 2, y + 2, sz - 4, sz - 4);\n    // Flash effect\n    if (this.flash > 0) {\n      ctx.globalAlpha = this.flash / 0.15;\n      ctx.fillStyle = '#fff';\n      ctx.fillRect(x + 2, y + 2, sz - 4, sz - 4);\n      ctx.globalAlpha = 1;\n    }\n    // Level indicators\n    if (this.level > 1) {\n      ctx.fillStyle = '#FFF';\n      ctx.font = 'bold 10px Georgia';\n      ctx.textAlign = 'right';\n      ctx.fillText('Lv' + this.level, x + sz - 4, y + 12);\n    }\n    // Icon\n    ctx.font = (sz > 40 ? '24px' : '16px') + ' sans-serif';\n    ctx.textAlign = 'center';\n    ctx.fillText(TRAP_TYPES[this.type].icon, x + sz / 2, y + sz / 2 + 8);\n  }\n}\n\n// ========== ENEMIES ==========\nclass Enemy {\n  constructor(type, path) {\n    this.type = type;\n    const cfg = ENEMY_TYPES[type];\n    this.maxHp = cfg.hp;\n    this.hp = cfg.hp;\n    this.speed = cfg.speed;\n    this.baseSpeed = cfg.speed;\n    this.color = cfg.color;\n    this.reward = cfg.reward;\n    this.size = cfg.size;\n    this.icon = cfg.icon;\n    this.stealth = cfg.stealth || false;\n    this.revealed = false;\n    this.alive = true;\n    this.path = path;\n    this.pathIdx = 0;\n    this.x = path[0].x * CONFIG.TILE + CONFIG.TILE / 2;\n    this.y = path[0].y * CONFIG.TILE + CONFIG.TILE / 2;\n    this.slowTimer = 0;\n    this.slowFactor = 1;\n    this.stunTimer = 0;\n    this.dotEffects = [];\n    this.knockTimer = 0;\n    this.knockX = 0;\n    this.knockY = 0;\n    this.deathTimer = 0;\n  }\n  applyEffect(type, val) {\n    if (type === 'dot') this.dotEffects.push(val);\n  }\n  takeDamage(dmg, game) {\n    if (!this.alive) return;\n    this.hp -= dmg;\n    game.spawnText(this.x, this.y - 20, '-' + dmg, '#E74C3C');\n    if (this.hp <= 0) {\n      this.alive = false;\n      game.gears += this.reward;\n      game.score += this.reward;\n      game.kills++;\n      game.spawnText(this.x, this.y - 35, '+' + this.reward + '⚙', '#F39C12');\n      game.spawnParticles(this.x, this.y, this.color, 12);\n      Audio.play('death');\n    }\n  }\n  update(dt, game) {\n    if (!this.alive) {\n      this.deathTimer += dt;\n      return;\n    }\n    // DOT\n    if (this.dotEffects.length) {\n      this.dotEffects.forEach(d => {\n        d.time -= dt;\n        this.hp -= d.dmg * dt;\n        if (Math.random() < 0.3) game.spawnParticles(this.x, this.y, d.color, 1, 2, 'steam');\n      });\n      this.dotEffects = this.dotEffects.filter(d => d.time > 0);\n      if (this.hp <= 0) { this.alive = false; return; }\n    }\n    if (this.slowTimer > 0) { this.slowTimer -= dt; this.slowFactor = 0.6; }\n    else this.slowFactor = 1;\n    if (this.stunTimer > 0) { this.stunTimer -= dt; return; }\n    if (this.knockTimer > 0) {\n      this.x += this.knockX * dt;\n      this.y += this.knockY * dt;\n      this.knockTimer -= dt;\n      return;\n    }\n    const sp = this.baseSpeed * this.slowFactor * CONFIG.TILE;\n    const target = this.path[Math.min(this.pathIdx + 1, this.path.length - 1)];\n    if (!target) { this.alive = false; return; }\n    const tx = target.x * CONFIG.TILE + CONFIG.TILE / 2;\n    const ty = target.y * CONFIG.TILE + CONFIG.TILE / 2;\n    const dx = tx - this.x, dy = ty - this.y;\n    const d = Math.hypot(dx, dy);\n    if (d < sp * dt) {\n      this.x = tx; this.y = ty;\n      this.pathIdx++;\n      if (this.pathIdx >= this.path.length - 1) {\n        this.alive = false;\n        game.coreHP -= (this.type === 'boss' ? 5 : 1);\n        game.shake = 0.3;\n        Audio.play('error');\n      }\n    } else {\n      this.x += (dx / d) * sp * dt;\n      this.y += (dy / d) * sp * dt;\n    }\n  }\n  render(ctx) {\n    if (!this.alive && this.deathTimer > 0.3) return;\n    const sz = this.size * CONFIG.TILE;\n    const x = this.x - sz / 2;\n    const y = this.y - sz / 2;\n    // Stealth fade\n    if (this.stealth && !this.revealed) {\n      ctx.globalAlpha = 0.4;\n    }\n    // Body\n    ctx.fillStyle = this.color;\n    ctx.beginPath();\n    ctx.arc(this.x, this.y, sz / 2, 0, Math.PI * 2);\n    ctx.fill();\n    // Border\n    ctx.strokeStyle = '#1a1a1a';\n    ctx.lineWidth = 2;\n    ctx.stroke();\n    // Icon\n    ctx.font = (sz > 30 ? '20px' : '14px') + ' sans-serif';\n    ctx.textAlign = 'center';\n    ctx.fillText(this.icon, this.x, this.y + 6);\n    // HP bar\n    if (this.hp < this.maxHp) {\n      const bw = sz;\n      const bh = 4;\n      ctx.fillStyle = '#333';\n      ctx.fillRect(this.x - bw / 2, this.y - sz / 2 - 8, bw, bh);\n      ctx.fillStyle = this.hp / this.maxHp > 0.5 ? '#2ECC71' : '#E74C3C';\n      ctx.fillRect(this.x - bw / 2, this.y - sz / 2 - 8, bw * (this.hp / this.maxHp), bh);\n    }\n    ctx.globalAlpha = 1;\n  }\n}\n\n// ========== GAME ==========\nclass Game {\n  constructor() {\n    this.canvas = document.getElementById('game-canvas');\n    this.ctx = this.canvas.getContext('2d');\n    this.particles = new ParticlePool(300);\n    this.texts = [];\n    this.traps = [];\n    this.enemies = [];\n    this.path = new PathSystem();\n    this.path.buildFullPath();\n    this.gears = CONFIG.START_GEARS;\n    this.coreHP = CONFIG.CORE_HP;\n    this.maxCoreHP = CONFIG.CORE_HP;\n    this.score = 0;\n    this.kills = 0;\n    this.wave = 1;\n    this.maxWave = 10;\n    this.waveActive = false;\n    this.waveTimer = 0;\n    this.spawnQueue = [];\n    this.selectedTrap = 'spike';\n    this.selectedPlaced = null;\n    this.shake = 0;\n    this.hoverCell = null;\n    this.dragging = null;\n    this.elapsedTime = 0;\n    this.lastTime = 0;\n    this.hoveredPlaced = null;\n    this.timerInterval = null;\n    this.startTime = 0;\n    this.gameOver = false;\n    this.victory = false;\n    this.highScore = parseInt(localStorage.getItem(CONFIG.HIGH_SCORE_KEY)) || 0;\n    this.bestTime = localStorage.getItem(CONFIG.TIMER_KEY) || null;\n    this.setupCanvas();\n    this.buildHotbar();\n    this.updateUI();\n    this.bindEvents();\n    this.setupModal();\n    requestAnimationFrame(t => this.loop(t));\n  }\n  setupCanvas() {\n    this.canvas.width = CONFIG.LOGICAL_W;\n    this.canvas.height = CONFIG.LOGICAL_H;\n  }\n  setupModal() {\n    const overlay = document.createElement('div');\n    overlay.className = 'modal-overlay';\n    overlay.innerHTML = `<div class=\"modal-box\">\n      <h1>⚙ Tinkerer's Bastion ⚙</h1>\n      <p>Defend your Core from waves of clockwork invaders using an arsenal of traps!</p>\n      <p style=\"font-size:12px;color:#666;\">Click hotbar traps (1-5) or press number keys, then click the map to place.<br>Use mouse wheel or +/- to cycle traps. Right-click to sell.</p>\n      <div class=\"high-score-display\">High Score: ${this.highScore} gears${this.bestTime ? ' | Best Time: ' + this.bestTime : ''}</div>\n      <button class=\"modal-btn\" id=\"start-btn\">Begin Defense</button>\n    </div>`;\n    document.getElementById('modal-root').appendChild(overlay);\n    document.getElementById('start-btn').onclick = () => {\n      Audio.init();\n      overlay.remove();\n      this.startTimer();\n    };\n  }\n  startTimer() {\n    this.startTime = performance.now();\n    this.timerInterval = setInterval(() => {\n      if (this.waveActive) {\n        const e = (performance.now() - this.startTime) / 1000;\n        const m = Math.floor(e / 60);\n        const s = Math.floor(e % 60);\n        const ms = Math.floor((e * 10) % 10);\n        document.getElementById('speedrun-timer').textContent =\n          String(m).padStart(2, '0') + ':' + String(s).padStart(2, '0') + '.' + ms;\n      }\n    }, 100);\n  }\n  buildHotbar() {\n    const hotbar = document.getElementById('hotbar');\n    hotbar.innerHTML = '';\n    const traps = ['spike', 'zapper', 'boulder', 'steam', 'tar', 'net', 'push', 'scrap', 'repair', 'spotlight'];\n    traps.forEach((t, i) => {\n      const cfg = TRAP_TYPES[t];\n      const slot = document.createElement('div');\n      slot.className = 'trap-slot';\n      slot.dataset.type = t;\n      slot.innerHTML = `<span class=\"trap-key\">${i + 1}</span><div class=\"trap-icon\">${cfg.icon}</div><div class=\"trap-cost\">⚙${cfg.cost}</div>`;\n      slot.onclick = () => this.selectTrap(t);\n      hotbar.appendChild(slot);\n    });\n    this.selectTrap('spike');\n  }\n  selectTrap(t) {\n    this.selectedTrap = t;\n    this.selectedPlaced = null;\n    document.querySelectorAll('.trap-slot').forEach(s => {\n      s.classList.toggle('selected', s.dataset.type === t);\n    });\n    this.updateContext();\n  }\n  bindEvents() {\n    this.canvas.addEventListener('mousemove', e => this.onMouseMove(e));\n    this.canvas.addEventListener('mousedown', e => this.onMouseDown(e));\n    this.canvas.addEventListener('mouseup', e => this.onMouseUp(e));\n    this.canvas.addEventListener('mouseleave', () => { this.hoverCell = null; });\n    this.canvas.addEventListener('contextmenu', e => { e.preventDefault(); this.onRightClick(e); });\n    this.canvas.addEventListener('wheel', e => { e.preventDefault(); this.onWheel(e); });\n    // Touch\n    this.canvas.addEventListener('touchstart', e => { e.preventDefault(); const t = e.touches[0]; this.onTouch(t, 'down'); }, {passive: false});\n    this.canvas.addEventListener('touchmove', e => { e.preventDefault(); const t = e.touches[0]; this.onTouch(t, 'move'); }, {passive: false});\n    this.canvas.addEventListener('touchend', e => { e.preventDefault(); const t = e.changedTouches[0]; this.onTouch(t, 'up'); }, {passive: false});\n    // Keyboard\n    window.addEventListener('keydown', e => this.onKey(e));\n    document.getElementById('start-wave-btn').onclick = () => this.startWave();\n    window.addEventListener('resize', () => {});\n  }\n  getCellFromEvent(e) {\n    const r = this.canvas.getBoundingClientRect();\n    const x = (e.clientX - r.left) * (CONFIG.LOGICAL_W / r.width);\n    const y = (e.clientY - r.top) * (CONFIG.LOGICAL_H / r.height);\n    return { gx: Math.floor(x / CONFIG.TILE), gy: Math.floor(y / CONFIG.TILE) };\n  }\n  onMouseMove(e) {\n    this.hoverCell = this.getCellFromEvent(e);\n  }\n  onTouch(t, phase) {\n    const cell = this.getCellFromEvent(t);\n    this.hoverCell = cell;\n    if (phase === 'down') this.onMouseDown({clientX: t.clientX, clientY: t.clientY, button: 0});\n    else if (phase === 'up') this.onMouseUp({clientX: t.clientX, clientY: t.clientY});\n  }\n  onMouseDown(e) {\n    if (e.button === 2) return;\n    Audio.init();\n    const {gx, gy} = this.hoverCell || this.getCellFromEvent(e);\n    this.handleClick(gx, gy);\n  }\n  onMouseUp(e) {}\n  onRightClick(e) {\n    const {gx, gy} = this.getCellFromEvent(e);\n    const trap = this.traps.find(t => t.gx === gx && t.gy === gy);\n    if (trap) this.sellTrap(trap);\n  }\n  onWheel(e) {\n    const types = Object.keys(TRAP_TYPES);\n    let idx = types.indexOf(this.selectedTrap);\n    if (e.deltaY > 0) idx = (idx + 1) % types.length;\n    else idx = (idx - 1 + types.length) % types.length;\n    this.selectTrap(types[idx]);\n  }\n  onKey(e) {\n    const types = Object.keys(TRAP_TYPES);\n    const num = parseInt(e.key);\n    if (num >= 1 && num <= types.length) {\n      this.selectTrap(types[num - 1]);\n    }\n    if (e.key === ' ') { e.preventDefault(); this.startWave(); }\n    if (e.key === 'Escape') this.selectedPlaced = null;\n  }\n  handleClick(gx, gy) {\n    if (gx < 0 || gx >= CONFIG.GRID_W || gy < 0 || gy >= CONFIG.GRID_H) return;\n    if (this.selectedPlaced) {\n      const t = this.selectedPlaced;\n      if (gx === t.gx && gy === t.gy) {\n        // Try upgrade\n        const cost = t.upgradeCost();\n        if (this.gears >= cost) {\n          this.gears -= cost;\n          t.upgrade();\n          this.updateUI();\n        } else {\n          Audio.play('error');\n        }\n      } else {\n        this.selectedPlaced = null;\n      }\n      this.updateContext();\n      return;\n    }\n    // Check existing trap\n    const existing = this.traps.find(t => t.gx === gx && t.gy === gy);\n    if (existing) {\n      this.selectedPlaced = existing;\n      this.updateContext();\n      return;\n    }\n    if (!this.path.isEmpty(gx, gy)) {\n      Audio.play('error');\n      return;\n    }\n    const cfg = TRAP_TYPES[this.selectedTrap];\n    if (this.gears < cfg.cost) {\n      Audio.play('error');\n      return;\n    }\n    const size = cfg.size || 1;\n    // Check bounds for big traps\n    if (gx + size > CONFIG.GRID_W || gy + size > CONFIG.GRID_H) {\n      Audio.play('error');\n      return;\n    }\n    // Check path/walls under size\n    let canPlace = true;\n    for (let dx = 0; dx < size && canPlace; dx++) {\n      for (let dy = 0; dy < size && canPlace; dy++) {\n        if (!this.path.isEmpty(gx + dx, gy + dy)) canPlace = false;\n        if (this.traps.find(t => t.gx === gx + dx && t.gy === gy + dy)) canPlace = false;\n      }\n    }\n    if (!canPlace) { Audio.play('error'); return; }\n    this.gears -= cfg.cost;\n    const trap = new Trap(this.selectedTrap, gx, gy);\n    this.traps.push(trap);\n    this.spawnParticles((gx + size / 2) * CONFIG.TILE, (gy + size / 2) * CONFIG.TILE, cfg.color, 8);\n    Audio.play('place');\n    this.updateUI();\n  }\n  sellTrap(trap) {\n    this.gears += trap.sellValue();\n    this.spawnText(trap.gx * CONFIG.TILE + CONFIG.TILE / 2, trap.gy * CONFIG.TILE, '+' + trap.sellValue() + '⚙', '#F39C12');\n    this.traps = this.traps.filter(t => t !== trap);\n    if (this.selectedPlaced === trap) this.selectedPlaced = null;\n    Audio.play('ui');\n    this.updateUI();\n    this.updateContext();\n  }\n  startWave() {\n    if (this.waveActive || this.wave > this.maxWave) return;\n    const btn = document.getElementById('start-wave-btn');\n    btn.disabled = true;\n    this.waveActive = true;\n    this.waveTimer = 3;\n    const banner = document.createElement('div');\n    banner.className = 'wave-banner';\n    banner.textContent = '⚔ Wave ' + this.wave + ' ⚔';\n    document.getElementById('game-wrapper').appendChild(banner);\n    setTimeout(() => banner.remove(), 2500);\n    Audio.play('wave');\n    this.spawnQueue = [];\n    const cfg = WAVES[this.wave - 1];\n    cfg.forEach(g => {\n      let d = 0;\n      for (let i = 0; i < g.count; i++) {\n        this.spawnQueue.push({type: g.type, time: d});\n        d += g.delay;\n      }\n    });\n  }\n  spawnParticles(x, y, color, count, size = 3, type = 'normal') {\n    for (let i = 0; i < count; i++) {\n      const ang = Math.random() * Math.PI * 2;\n      const spd = rand(50, 150);\n      this.particles.spawn(x, y, Math.cos(ang) * spd, Math.sin(ang) * spd, color, rand(0.4, 0.8), size, type);\n    }\n  }\n  spawnExplosion(x, y, radius, dmg, color) {\n    this.spawnParticles(x, y, color, 20, 5);\n  }\n  spawnText(x, y, text, color) {\n    const ft = new FloatingText();\n    ft.init(x, y, text, color);\n    this.texts.push(ft);\n  }\n  updateUI() {\n    document.getElementById('gear-count').textContent = this.gears;\n    document.getElementById('hp-text').textContent = this.coreHP + '/' + this.maxCoreHP;\n    document.getElementById('hp-bar').style.width = (this.coreHP / this.maxCoreHP * 100) + '%';\n    document.getElementById('wave-num').textContent = this.wave;\n    document.getElementById('level-name').textContent = 'Clockwork Factory - Level ' + Math.ceil(this.wave / 2);\n    document.getElementById('start-wave-btn').disabled = this.waveActive || this.wave > this.maxWave;\n    document.querySelectorAll('.trap-slot').forEach(s => {\n      const t = TRAP_TYPES[s.dataset.type];\n      s.classList.toggle('disabled', this.gears < t.cost);\n    });\n  }\n  updateContext() {\n    const ctx = document.getElementById('context-content');\n    if (this.selectedPlaced) {\n      const t = this.selectedPlaced;\n      const cfg = TRAP_TYPES[t.type];\n      const upgradeCost = t.upgradeCost();\n      ctx.innerHTML = `<div style=\"font-weight:bold;color:${cfg.color};\">${cfg.icon} ${cfg.name} (Lv${t.level})</div>\n        <div class=\"context-row\"><span class=\"label\">Damage:</span><span>${t.dmg}</span></div>\n        <div class=\"context-row\"><span class=\"label\">Cooldown:</span><span>${t.cd.toFixed(1)}s</span></div>\n        <div class=\"context-row\"><span class=\"label\">Range:</span><span>${t.range.toFixed(1)}</span></div>\n        <div class=\"context-row\"><span class=\"label\">Kills:</span><span>${t.kills}</span></div>\n        <div class=\"context-row\"><span class=\"label\">Upgrade:</span><span style=\"color:#F1C40F;\">⚙${upgradeCost}</span></div>\n        <button class=\"upgrade-btn\" onclick=\"window.game.upgradeSelected()\">⬆ Upgrade</button>\n        <button class=\"sell-btn\" onclick=\"window.game.sellSelected()\">💰 Sell (⚙${t.sellValue()})</button>`;\n    } else {\n      const cfg = TRAP_TYPES[this.selectedTrap];\n      ctx.innerHTML = `<div style=\"font-weight:bold;color:${cfg.color};\">${cfg.icon} ${cfg.name}</div>\n        <div style=\"font-style:italic;color:#aaa;margin-top:4px;\">${cfg.desc}</div>\n        <div class=\"context-row\"><span class=\"label\">Damage:</span><span>${cfg.dmg || '—'}</span></div>\n        <div class=\"context-row\"><span class=\"label\">Cooldown:</span><span>${cfg.cd === 0 ? 'Passive' : cfg.cd + 's'}</span></div>\n        <div class=\"context-row\"><span class=\"label\">Cost:</span><span style=\"color:#F1C40F;\">⚙${cfg.cost}</span></div>`;\n    }\n  }\n  upgradeSelected() {\n    if (!this.selectedPlaced) return;\n    const t = this.selectedPlaced;\n    const cost = t.upgradeCost();\n    if (this.gears >= cost) {\n      this.gears -= cost;\n      t.upgrade();\n      this.updateUI();\n      this.updateContext();\n    } else Audio.play('error');\n  }\n  sellSelected() {\n    if (!this.selectedPlaced) return;\n    this.sellTrap(this.selectedPlaced);\n  }\n  checkGameEnd() {\n    if (this.coreHP <= 0 && !this.gameOver) {\n      this.gameOver = true;\n      this.showEndModal(false);\n    }\n    if (this.wave > this.maxWave && !this.enemies.some(e => e.alive) && !this.gameOver && !this.victory) {\n      this.victory = true;\n      const finalTime = document.getElementById('speedrun-timer').textContent;\n      if (!this.bestTime || this.compareTime(finalTime, this.bestTime) < 0) {\n        localStorage.setItem(CONFIG.TIMER_KEY, finalTime);\n      }\n      if (this.score > this.highScore) {\n        localStorage.setItem(CONFIG.HIGH_SCORE_KEY, this.score);\n      }\n