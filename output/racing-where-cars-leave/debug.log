          car.thrustBonus = 1.1; // increase acceleration slightly
          break;
        }
      }
      if(car.drafting) break;
    }
    if(car.drafting) break;
  }
  if(!car.drafting){
    car.lateralGrip = FRICTION;
    car.thrustBonus = 1.0;
  }
}


