```javascript
(() => {
'use strict';

// ---------- Constants ----------
const FIXED_DT = 1000 / 60;
const MAX_SPEED = 1400;
const THRUST = 600;
const FRICTION = 0.985;
const RAIL_LIFESPAN = 8;
const RAIL_FADE_START = 5;
const RAIL_MAX_LEN = 400;
const RAIL_WIDTH = 12;
const RAIL_ALPHA_DECAY = 0.15; // per second
const LAPS_TO_WIN = 3;
const TRACK_RADIUS = 900;

// Colors
const C_BG = '#05050f';
const C_RAIL = '#00f0ff';
const C_PLAYER = '#ff00aa';
const C_AI = '#ffaa00';
const C_STAR = '#ffffff';
const C_NEBULA = 'rgba(80,40,120,0.15)';

// ---------- Canvas setup ----------
const canvas = document.getElementById('game');
const ctx = canvas.getContext('2d');
const minimapCanvas = document.getElementById('minimap');
const mmCtx = minimapCanvas.getContext('2d');

let W = 0, H = 0, dpr = 1;
function resize() {
  dpr = Math.min(window.devicePixelRatio || 1, 2);
  W = window.innerWidth;
  H = window.innerHeight;
  canvas.width = Math.floor(W * dpr);
  canvas.height = Math.floor(H * dpr);
  canvas.style.width = W + 'px';
  canvas.style.height = H + 'px';
  ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
  // minimap fixed size
  minimapCanvas.width = 150 * dpr;
  minimapCanvas.height = 150 * dpr;
  minimapCanvas.style.width = '150px';
  minimapCanvas.style.height = '150px';
  mmCtx.setTransform(dpr, 0, 0, dpr, 0, 0);
}
window.addEventListener('resize', resize);
resize();

// ---------- Input ----------
const keys = {};
const keyMap = {
  ArrowUp:'up', ArrowDown:'down', ArrowLeft:'left', ArrowRight:'right',
  KeyW:'up', KeyS:'down', KeyA:'left', KeyD:'right',
  Space:'boost'
};
window.addEventListener('keydown', e => {
  if (keyMap[e.code]) { keys[keyMap[e.code]] = true; e.preventDefault(); }
});
window.addEventListener('keyup', e => {
  if (keyMap[e.code]) { keys[keyMap[e.code]] = false; e.preventDefault(); }
});

// ---------- Audio ----------
let audioCtx = null;
function initAudio() {
  if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
}
function playTone(freq, dur, type='sine', vol=0.2) {
  if (!audioCtx) return;
  const o = audioCtx.createOscillator();
  const g = audioCtx.createGain();
  o.type = type; o.frequency.value = freq;
  g.gain.value = vol;
  o.connect(g); g.connect(audioCtx.destination);
  const t = audioCtx.currentTime;
  g.gain.setValueAtTime(vol, t);
  g.gain.exponentialRampToValueAtTime(0.001, t + dur);
  o.start(t); o.stop(t + dur);
}
function playNoise(dur, vol=0.3) {
  if (!audioCtx) return;
  const bufferSize = audioCtx.sampleRate * dur;
  const buffer = audioCtx.createBuffer(1, bufferSize, audioCtx.sampleRate);
  const data = buffer.getChannelData(0);
  for (let i=0;i<bufferSize;i++) data[i] = (Math.random()*2-1)*Math.pow(1-i/bufferSize,2);
  const src = audioCtx.createBufferSource();
  src.buffer = buffer;
  const g = audioCtx.createGain();
  g.gain.value = vol;
  src.connect(g); g.connect(audioCtx.destination);
  src.start();
}
function sfxBoost() { playTone(220, 0.15, 'sawtooth', 0.15); }
function sfxExplosion() { playNoise(0.4, 0.4); playTone(80, 0.4, 'square', 0.2); }
function sfxLap() { playTone(660, 0.1, 'triangle', 0.2); setTimeout(()=>playTone(880,0.15,'triangle',0.2),100); }
function sfxWin() { [523,659,784,1046].forEach((f,i)=>setTimeout(()=>playTone(f,0.2,'triangle',0.25), i*120)); }

// ---------- Utility ----------
function v(x,y){return {x,y};}
function vadd(a,b){return {x:a.x+b.x, y:a.y+b.y};}
function vsub(a,b){return {x:a.x-b.x, y:a.y-b.y};}
function vmul(a,s){return {x:a.x*s, y:a.y*s};}
function vlen(a){return Math.hypot(a.x,a.y);}
function vnorm(a){const l=vlen(a)||1;return {x:a.x/l,y:a.y/l};}
function vdot(a,b){return a.x*b.x+a.y*b.y;}
function vperp(a){return {x:-a.y,y:a.x};}
function clamp(v,a,b){return Math.max(a,Math.min(b,v));}
function lerp(a,b,t){return a+(b-a)*t;}

// ---------- Starfield ----------
const starLayers = [];
for (let l=0;l<3;l++){
  const stars=[];
  const count = 80+l*40;
  for(let i=0;i<count;i++){
    stars.push({x:(Math.random()-0.5)*4000, y:(Math.random()-0.5)*4000, r:0.5+Math.random()*1.5+l*0.3, tw:Math.random()*Math.PI*2});
  }
  starLayers.push({stars, speed:0.3+l*0.4, parallax:0.05+l*0.05});
}
const nebulae = [];
for(let i=0;i<6;i++){
  nebulae.push({x:(Math.random()-0.5)*2000, y:(Math.random()-0.5)*2000, r:200+Math.random()*300, c:`rgba(${Math.floor(120+Math.random()*80)},${Math.floor(40+Math.random()*60)},${Math.floor(140+Math.random()*80)},0.12)`});
}

// ---------- Entities ----------
class Rail {
  constructor(){ this.points=[]; this.age=0; this.dead=false; }
  addPoint(p){
    this.points.push(p);
    // trim segments longer than max
    while(this.points.length>=2){
      const a=this.points[this.points.length-2], b=this.points[this.points.length-1];
      if(vlen(vsub(b,a))>RAIL_MAX_LEN){ this.points.pop(); }
      else break;
    }
  }
  update(dt){ this.age+=dt; }
  alpha(){
    const a = 1 - this.age/RAIL_LIFESPAN;
    if(this.age>RAIL_FADE_START) return Math.max(0, a)*( (this.age-RAIL_FADE_START)/3 );
    return Math.max(0,a);
  }
  render(ctx){
    if(this.points.length<2) return;
    const al = this.alpha();
    if(al<=0.01) return;
    ctx.save();
    ctx.strokeStyle = `rgba(0,240,255,${al})`;
    ctx.lineWidth = RAIL_WIDTH;
    ctx.lineCap='round'; ctx.lineJoin='round';
    ctx.shadowColor='#00f0ff'; ctx.shadowBlur=12;
    ctx.beginPath();
    ctx.moveTo(this.points[0].x,this.points[0].y);
    for(let i=1;i<this.points.length;i++) ctx.lineTo(this.points[i].x,this.points[i].y);
    ctx.stroke();
    ctx.restore();
  }
}

class Particle {
  constructor(x,y,vx,vy,life,color,size){
    this.x=x;this.y=y;this.vx=vx;this.vy=vy;this.life=life;this.maxLife=life;this.color=color;this.size=size;
  }
  update(dt){ this.x+=this.vx*dt; this.y+=this.vy*dt; this.vx*=0.96; this.vy*=0.96; this.life-=dt; }
  dead(){ return this.life<=0; }
  render(ctx){
    const a=clamp(this.life/this.maxLife,0,1);
    ctx.globalAlpha=a;
    ctx.fillStyle=this.color;
    ctx.fillRect(this.x-this.size/2,this.y-this.size/2,this.size,this.size);
    ctx.globalAlpha=1;
  }
}

class Asteroid {
  constructor(x,y,r){ this.x=x;this.y=y;this.r=r; this.rot=Math.random()*Math.PI*2; this.spin=Math.random()*2-1; }
