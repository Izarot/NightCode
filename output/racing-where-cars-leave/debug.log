function updateLaps(car){
  const dx=car.pos.x, dy=car.pos.y;
  const distFromCenter=Math.hypot(dx,dy);
  const angle=Math.atan2(dy,dx);
  // detect crossing start line (angle near 0, going counterclockwise = increasing angle in canvas coords? )
  // In canvas coords (y down), going counterclockwise visually means angle decreases.
  // Let's say we want to go counterclockwise visually = angle decreasing.
  // Detect wrap from angle near PI to near -PI (decreasing) or vice versa.
  // Track previous angle.
  if(car===player){
    // detect crossing
    // crossing happens when angle wraps from ~PI to ~-PI (going CCW visually = decreasing angle)
    // or from ~-PI to ~PI (going CW visually = increasing angle)
    // We want CCW (decreasing angle): prev > PI*0.75 && curr <= -PI*0.75
    // Actually let's just detect any crossing and check direction.
    if(prevPlayerAngle > Math.PI*0.75 && angle <= -Math.PI*0.75){
      // crossed going one way
      // determine direction by angular velocity
      const dAngle = angle - prevPlayerAngle;
      // if dAngle < 0, going CCW (decreasing) -> valid lap
      // if dAngle > 0, going CW (increasing) -> invalid
      if(dAngle < 0){
        car.lap++;
        if(car.lap >= LAPS_TO_WIN){
          car.finished=true;
          car.finishTime=speedrunTime;
          if(speedrunTime > highScore){
            highScore=speedrunTime;
            try{ localStorage.setItem('cosmicRailsHighScore', String(highScore)); }catch(e){}
          }
          sfxWin();
          gameState='win';
        } else {
          sfxLap();
        }
      }
    }
    prevPlayerAngle=angle;
  }