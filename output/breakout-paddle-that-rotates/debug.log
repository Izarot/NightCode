class InputHandler {
  constructor(game) {
    this.game = game;
    this.mouseX = 0;
    this.mouseY = 0;
    this.rotateSpeed = 0;
    this.lastMouse = {x:0,y:0};
    this.wheelDelta = 0;
    this.clickPending = false;
    window.addEventListener('mousemove', e => {
      const rect = this.game.canvas.getBoundingClientRect();
      this.mouseX = e.clientX - rect.left;
      this.mouseY = e.clientY - rect.top;
    });
    window.addEventListener('wheel', e => {
      this.wheelDelta += e.deltaY;
    });
    window.addEventListener('click', e => {
      if (this.game.ball.isLocked) {
        this.clickPending = true;
      }
    });
    window.addEventListener('keydown', e => {
      if (e.code === 'Space' || e.code === 'Enter') {
        this.game.paused = !this.game.paused;
      }
    });
  }
  update(dt) {
    // paddle rotation speed based on wheel or key?
    // We'll use wheel for rotation speed
    const rotSpeed = this.wheelDelta * 0.5 * dt; // adjust
    this.wheelDelta = 0;
    this.rotateSpeed = rotSpeed;
    // reset click pending after launch
    if (this.clickPending) {
      this.clickPending = false;
      this.game.ball.reset(this.game.paddle);
    }
  }
  get mouseX() { return this.mouseX; }
  get paddle() { return this.game.paddle; }
}

