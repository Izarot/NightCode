"src/game/Game.js": "import { InputHandler } from './InputHandler.js';\nimport { Paddle } from '../entities/Paddle.js';\nimport { Ball } from '../entities/Ball.js';\nimport { Brick } from '../entities/Brick.js';\nimport { PowerUp } from '../entities/PowerUp.js';\nimport { ParticleSystem } from '../rendering/ParticleSystem.js';\nexport class Game {\n  constructor(canvas) {\n    this.canvas = canvas;\n    this.ctx = canvas.getContext('2d');\n    this.resizeCanvas();\n    window.addEventListener('resize', () => this.resizeCanvas());\n    this.lastTime = 0;\n    this.running = false;\n    this.paused = false;\n    this.score = 0;\n    this.lives = 3;\n    this.highScore = parseInt(localStorage.getItem('angleBreakoutHighScore') || '0');\n    this.startTime = performance.now();\n    this.parTime = 45;\n    this.parEnd = this.startTime + this.parTime * 1000;\n    this.levelData = {\n      background: '#0d0d0d',\n      paddleWidth: 120,\n      parTime: 45,\n      bricks: [\n        {row:0,col:0,type:'normal',color:'#ff5555'},\n        {row:0,col:1,type:'normal',color:'#ffaa55'},\n        {row:0,col:2,type:'durable',color:'#ffcc66'},\n      ]\n    };\n    this.input = new InputHandler(this);\n    this.paddle = new Paddle(this);\n    this.ball = new Ball(this);\n    this.bricks = [];\n    for (let b of this.levelData.bricks) {\n      this.bricks.push(new Brick(this, b.row, b.col, b.type, b.color));\n    }\n    this.powerUps = [];\n    this.particles = new ParticleSystem();\n    this.timers = { speedrun: 0 };\n    this.loadLevel();\n    this.initEntities();\n    this.startLoop();\n  }\n  resizeCanvas() {\n    const w = this.canvas.clientWidth;\n    const h = this.canvas.clientHeight;\n    this.canvas.width = w;\n    this.canvas.height = h;\n    this.width = w;\n    this.height = h;\n  }\n  loadLevel() {\n    // level data already set\n  }\n  initEntities() {\n    // already done\n  }\n  startLoop() {\n    this.running = true;\n    requestAnimationFrame(this.loop.bind(this));\n  }\n  loop(timestamp) {\n    const dt = (timestamp - this.lastTime) / 1000;\n    this.lastTime = timestamp;\n    if (!this.paused) {\n      this.update(dt);\n      this.render();\n    }\n    if (this.running) requestAnimationFrame(this.loop.bind(this));\n  }\n  update(dt) {\n    this.timers.speedrun += dt;\n    this.paddle.update(dt);\n    this.ball.update(dt);\n    this.checkCollisions();\n    this.checkLives();\n    if (this.bricks.length === 0) this.levelComplete();\n  }\n  render() {\n    this.ctx.clearRect(0, 0, this.width, this.height);\n    this.drawBackground();\n    this.drawBricks();\n    this.paddle.draw(this.ctx);\n    this.ball.draw(this.ctx);\n    this.particles.update(dt);\n    this.particles.draw(this.ctx);\n    this.drawPowerUps();\n    this.drawHUD();\n  }\n  drawBackground() {\n    this.ctx.fillStyle = this.levelData.background;\n    this.ctx.fillRect(0, 0, this.width, this.height);\n  }\n  drawBricks() {\n    for (let b of this.bricks) b.draw(this.ctx);\n  }\n  drawPowerUps() {\n    for (let pu of this.powerUps) pu.draw(this.ctx);\n  }\n  drawHUD() {\n    const ctx = this.ctx;\n    ctx.fillStyle = '#fff';\n    ctx.font = '16px sans-serif';\n    ctx.fillText('Lives: ' + this.lives, 10, 20);\n    ctx.fillText('Score: ' + this.score, 10, 40);\n    const remaining = Math.max(0, this.parEnd - this.timers.speedrun * 1000);\n    const secs = Math.floor(remaining / 1000);\n    ctx.fillText('Time: ' + secs + 's', this.width - 100, 20);\n  }\n  checkCollisions() {\n    if (this.ball.isLocked) return;\n    const paddleBounds = this.paddle.getBounds();\n    if (paddleBounds.minX <= this.ball.x && this.ball.x <= paddleBounds.maxX &&\n        paddleBounds.minY <= this.ball.y && this.ball.y <= paddleBounds.maxY) {\n      this.ball.isLocked = false;\n      this.ball.launch(this.paddle.angle);\n    }\n    // walls\n    if (this.ball.x - this.ball.radius < 0) this.ball.vx = Math.abs(this.ball.vx);\n    if (this.ball.x + this.ball.radius > this.width) this.ball.vx = -Math.abs(this.ball.vx);\n    if (this.ball.y - this.ball.radius < 0) this.ball.vy = Math.abs(this.ball.vy);\n    // bottom\n    if (this.ball.y + this.ball.radius > this.height) {\n      this.lives--;\n      this.ball.reset(this.paddle);\n    }\n    // bricks\n    for (let i = this.bricks.length - 1; i >= 0; i--) {\n      const b = this.bricks[i];\n      if (this.ball.isLocked) break;\n      if (this.ball.getBounds().overlaps(b.getBounds())) {\n        this.ball.vx = -this.ball.vx;\n        this.ball.vy = -this.ball.vy;\n        b.hit();\n        if (b.health <= 0) {\n          this.bricks.splice(i, 1);\n          this.particles.emit(b.x, b.y);\n          if (Math.random() < 0.05) {\n            const types = ['expand','shrink','fast','slow','multi','laser','gravity','extra','boost'];\n            const type = types[Math.floor(Math.random() * types.length)];\n            this.powerUps.push(new PowerUp(this.ball.x, this.ball.y, type));\n          }\n        }\n      }\n    }\n  }\n  checkLives() {\n    if (this.lives <= 0) this.gameOver();\n  }\n  resetBall(paddle) {\n    this.ball.x = paddle.x + this.paddle.width / 2 - this.ball.radius;\n    this.ball.y = paddle.y - this.paddle.height / 2 - this.ball.radius;\n    this.ball.vx = 0;\n    this.ball.vy = 0;\n    this.ball.isLocked = true;\n  }\n  levelComplete() {\n    this.running = false;\n  }\n  gameOver() {\n    this.running = false;\n  }\n}"

Now src/game/InputHandler.js:

"src/game/InputHandler.js": "import { Game } from './Game.js';\nexport class InputHandler {\n  constructor(game) {\n    this.game = game;\n    this.mouseX = 0;\n    this.rotateSpeed = 0;\n    this.wheelDelta = 0;\n    window.addEventListener('mousemove', e => {\n      const rect = this.game.canvas.getBoundingClientRect();\n      this.mouseX = e.clientX - rect.left;\n    });\n    window.addEventListener('wheel', e => {\n      this.wheelDelta += e.deltaY;\n    });\n    window.addEventListener('click', e => {\n      if (this.game.ball.isLocked) {\n        this.game.ball.reset(this.game.paddle);\n      }\n    });\n    window.addEventListener('keydown', e => {\n      if (e.code === 'Space' || e.code === 'Enter') {\n        this.game.paused = !this.game.paused;\n      }\n    });\n  }\n  update(dt) {\n    this.rotateSpeed = this.wheelDelta * 0.5 * dt;\n    this.wheelDelta = 0;\n  }\n}"

Now src/entities/Paddle.js:

"src/entities/Paddle.js": "import { Vector2D } from '../physics/Vector2D.js';\nexport class Paddle {\n  constructor(game) {\n    this.game = game;\n    this.width = game.levelData.paddleWidth;\n    this.height = 20;\n    this.x = this.game.canvas.width / 2 - this.width / 2;\n    this.y = this.game.canvas.height - this.height - 10;\n    this.angle = 0;\n    this.vx = 0;\n    this.ax = 0;\n    this.maxSpeed = 800;\n    this.acc = 1500;\n  }\n  getBounds() {\n    const halfW = this.width / 2;\n    const halfH = this.height / 2;\n    const cosA = Math.cos(this.angle);\n    const sinA = Math.sin(this.angle);\n    const points = [\n      {x: -halfW, y: -halfH},\n      {x: halfW, y: -halfH},\n      {x: halfW, y: halfH},\n      {x: -halfW, y: halfH}\n    ];\n    let minX = Infinity, maxX = -Infinity, minY = Infinity, maxY = -Infinity;\n    for (let p of points) {\n      const xr = p.x * cosA - p.y * sinA + this.x;\n      const yr = p.x * sinA + p.y * cosA + this.y;\n      if (xr < minX) minX = xr;\n      if (xr > maxX) maxX = xr;\n      if (yr < minY) minY = yr;\n      if (yr > maxY) maxY = yr;\n    }\n    return {minX, maxX, minY, maxY};\n  }\n  launchAngle() {\n    return this.angle;\n  }\n  update(dt) {\n    const targetX = this.game.input.mouseX - this.game.canvas.width / 2;\n    const dx = targetX - this.x;\n    if (dx > 0) {\n      this.ax = this.acc * dt;\n    } else if (dx < 0) {\n      this.ax = -this.acc * dt;\n    } else {\n      this.ax = 0;\n    }\n    this.vx += this.ax;\n    if (this.vx > this.maxSpeed) this.vx = this.maxSpeed;\n    if (this.vx < -this.maxSpeed) this.vx = -this.maxSpeed;\n    this.x += this.vx * dt;\n    const halfW = this.width / 2;\n    if (this.x - halfW < 0) this.x = halfW;\n    if (this.x + halfW > this.game.canvas.width) this.x = this.game.canvas.width - halfW;\n    this.rotationSpeed = this.game.input.rotateSpeed;\n    this.angle += this.rotationSpeed * dt;\n    this.angle = Math.max(-Math.PI / 4, Math.min(Math.PI / 4, this.angle));\n  }\n  draw(ctx) {\n    ctx.save();\n    ctx.translate(this.x, this.y);\n    ctx.rotate(this.angle);\n    ctx.fillStyle = '#00ff00';\n    ctx.fillRect(-this.width / 2, -this.height / 2, this.width, this.height);\n    ctx.restore();\n  }\n}"

Now src/entities/Ball.js:

"src/entities/Ball.js": "import { Vector2D } from '../physics/Vector2D.js';\nexport class Ball {\n  constructor(game) {\n    this.game = game;\n    this.radius = 10;\n    this.x = 0;\n    this.y = 0;\n    this.vx = 0;\n    this.vy = 0;\n    this.speed = 300;\n    this.maxSpeed = 600;\n    this.isLocked = true;\n  }\n  launch(paddleAngle) {\n    const dir = {x: Math.cos(paddleAngle), y: Math.sin(paddleAngle)};\n    let vx = dir.x * this.speed;\n    let vy = dir.y * this.speed;\n    const spread = (Math.random() - 0.5) * 10 * Math.PI / 180; // ±5°\n    const cosS = Math.cos(spread);\n    const sinS = Math.sin(spread);\n    vx = vx * cosS - vy * sinS;\n    vy = vx * sinS + vy * cosS;\n    this.vx = vx;\n    this.vy = vy;\n    this.isLocked = false;\n  }\n  reset(paddle) {\n    this.x = paddle.x + this.game.paddle.width / 2 - this.radius;\n    this.y = paddle.y - this.game.paddle.height / 2 - this.radius;\n    this.vx = 0;\n    this.vy = 0;\n    this.isLocked = true;\n  }\n  update(dt) {\n    if (this.isLocked) return;\n    this.x += this.vx * dt;\n    this.y += this.vy * dt;\n    // speed cap\n    let speed = Math.hypot(this.vx, this.vy);\n    if (speed > this.maxSpeed) {\n      const factor = this.maxSpeed / speed;\n      this.vx *= factor;\n      this.vy *= factor;\n    }\n  }\n  getBounds() {\n    return {minX: this.x - this.radius, maxX: this.x + this.radius, minY: this.y - this.radius, maxY: this.y + this.radius};\n  }\n  draw(ctx) {\n    ctx.beginPath();\n    ctx.arc(this.x, this.y, this.radius, 0, Math.PI * 2);\n    ctx.fillStyle = '#ff0000';\n    ctx.fill();\n  }\n}"

Now src/entities/Brick.js:

"src/entities/Brick.js": "export class Brick {\n  constructor(game, row, col, type, color) {\n    this.game = game;\n    this.row = row;\n    this.col = col;\n    this.type = type;\n    this.color = color;\n    this.health = (type === 'normal' ? 1 : type === 'durable' ? 2 : 0);\n    const w = 60, h = 20;\n    const padding = 4;\n    this.x = col * (w + padding) + padding;\n    this.y = row * (h + padding) + padding;\n    this.w = w;\n    this.h = h;\n  }\n  getBounds() {\n    return {minX: this.x, maxX: this.x + this.w, minY: this.y, maxY: this.y + this.h};\n  }\n  hit() {\n    this.health--;\n  }\n  draw(ctx) {\n    if (this.health <= 0) return;\n    ctx.fillStyle = this.color;\n    ctx.fillRect(this.x, this.y, this.w, this.h);\n    if (this.type === 'durable' && this.health === 1) {\n      ctx.strokeStyle = '#000';\n      ctx.lineWidth = 2;\n      ctx.strokeRect(this.x, this.y, this.w, this.h);\n    }\n  }\n}"

Now src/entities/PowerUp.js:

"src/entities/PowerUp.js": "export class PowerUp {\n  constructor(x, y, type) {\n    this.x = x;\n    this.y = y;\n    this.type = type;\n    this.vy = -150;\n    this.radius = 12;\n    this.collected = false;\n  }\n  update(dt) {\n    this.y += this.vy * dt;\n  }\n  draw(ctx) {\n    ctx.save();\n    ctx.translate(this.x, this.y);\n    ctx.globalAlpha = 0.8;\n    ctx.fillStyle = '#ff0';\n    ctx.fillRect(-6, -6, 12, 12);\n    ctx.restore();\n  }\n  collect(paddle) {\n    const pBounds = paddle.getBounds();\n    const bBounds = {minX: this.x - this.radius, maxX: this.x + this.radius, minY: this.y - this.radius, maxY: this.y + this.radius};\n    if (pBounds.minX < bBounds.maxX && pBounds.maxX > bBounds.minX &&\n        pBounds.minY < bBounds.maxY && pBounds.maxY > bBounds.minY) {\n      this.collected = true;\n      return true;\n    }\n    return false;\n  }\n}"

Now src/physics/Collision.js:

"src/physics/Collision.js": "export function getRotatedAABB(paddle) {\n  const halfW = paddle.width / 2;\n  const halfH = paddle.height / 2;\n  const cosA = Math.cos(paddle.angle);\n  const sinA = Math.sin(paddle.angle);\n  const points = [\n    {x: -halfW, y: -halfH},\n    {x: halfW, y: -halfH},\n    {x: halfW, y: halfH},\n    {x: -halfW, y: halfH}\n  ];\n  let minX = Infinity, maxX = -Infinity, minY = Infinity, maxY = -Infinity;\n  for (let p of points) {\n    const xr = p.x * cosA - p.y * sinA + paddle.x;\n    const yr = p.x * sinA + p.y * cosA + paddle.y;\n    if (xr < minX) minX = xr;\n    if (xr > maxX) maxX = xr;\n    if (yr < minY) minY = yr;\n    if (yr > maxY) maxY = yr;\n  }\n  return {minX, maxX, minY, maxY};\n}\n\nexport function circleAABBCollision(circle, aabb) {\n  const closestX = Math.max(aabb.minX, Math.min(circle.x, aabb.maxX));\n  const closestY = Math.max(aabb.minY, Math.min(circle.y, aabb.maxY));\n  const dx = circle.x - closestX;\n  const dy = circle.y - closestY;\n  const distSq = dx * dx + dy * dy;\n  return distSq < circle.radius * circle.radius;\n}"

Now src/physics/Vector2D.js:

"src/physics/Vector2D.js": "export class Vector2D {\n  constructor(x = 0, y = 0) {\n    this.x = x;\n    this.y = y;\n  }\n  add(v) {\n    this.x += v.x;\n    this.y += v.y;\n    return this;\n  }\n}"

Now src/rendering/ParticleSystem.js:

"src/rendering/ParticleSystem.js": "export class ParticleSystem {\n  constructor() {\n    this.particles = [];\n    this.maxParticles = 200;\n  }\n  emit(x, y) {\n    const count = 12 + Math.floor(Math.random() * 8);\n    for (let i = 0; i < count; i++) {\n      const size = 2 + Math.random() * 2;\n      const angle = Math.random() * Math.PI * 2;\n      const speed = 50 + Math.random() * 100;\n      this.particles.push({\n        x,\n        y,\n        vx: Math.cos(angle) * speed,\n        vy: Math.sin(angle) * speed,\n        size,\n        life: 0.3\n      });\n    }\n  }\n  update(dt) {\n    for (let i = this.particles.length - 1; i >= 0; i--) {\n      const p = this.particles[i];\n      p.x += p.vx * dt;\n      p.y += p.vy * dt;\n      p.life -= dt;\n      if (p.life <= 0) this.particles.splice(i, 1);\n    }\n  }\n  draw(ctx) {\n    for (let p of this.particles) {\n      ctx.globalAlpha = p.life;\n      ctx.fillStyle = '#fff';\n      ctx.beginPath();\n      ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);\n      ctx.fill();\n    }\n  }\n}"

