Ball.launch:

```
launch(paddleAngle) {
  const dir = {x: Math.cos(paddleAngle), y: Math.sin(paddleAngle)};
  let vx = dir.x * this.speed;
  let vy = dir.y * this.speed;
  const spread = (Math.random()-0.5)*10*Math.PI/180; // ±5°
  const cosS = Math.cos(spread);
  const sinS = Math.sin(spread);
  vx = vx*cosS - vy*sinS;
  vy = vx*sinS + vy*cosS;
  this.vx = vx;
  this.vy = vy;
  this.isLocked = false;
}
