"src/audio/SoundManager.js": "export class SoundManager {\n  constructor() {\n    this.ctx = new (window.AudioContext || window.webkitAudioContext)();\n    this.buffers = {};\n    this.loadSounds();\n  }\n  async loadSounds() {\n    const names = ['paddle', 'ball', 'brick', 'destroy', 'powerup', 'life', 'levelup'];\n    for (let n of names) {\n      const resp = await fetch(`assets/sounds/${n}.wav`);\n      const array = await resp.arrayBuffer();\n      const audioBuf = await this.ctx.decodeAudioData(array);\n      this.buffers[n] = audioBuf;\n    }\n  }\n  play(name) {\n    const buf = this.buffers[name];\n    if (!buf) return;\n    const source = this.ctx.createBufferSource();\n    source.buffer = buf;\n    const gain = this.ctx.createGain();\n    gain.gain.value = 0.5;\n    source.connect(gain);\n    gain.connect(this.ctx.destination);\n    source.start();\n  }\n}"

