But we need to capture wheel delta per frame. Let's adjust: In InputHandler.update(dt) we can read wheelDelta and compute rotation speed.

Let's rewrite InputHandler:

```javascript
export class InputHandler {
  constructor(game) {
    this.game = game;
    this.mouseX = 0;
    this.rotateSpeed = 0;
    this.wheelDelta = 0;
    window.addEventListener('mousemove', e => {
      const rect = this.game.canvas.getBoundingClientRect();
      this.mouseX = e.clientX - rect.left;
    });
    window.addEventListener('wheel', e => {
      this.wheelDelta += e.deltaY;
    });
    window.addEventListener('click', e => {
      if (this.game.ball.isLocked) {
        this.game.ball.reset(this.game.paddle);
      }
    });
    window.addEventListener('keydown', e => {
      if (e.code === 'Space' || e.code === 'Enter') {
        this.game.paused = !this.game.paused;
      }
    });
  }
  update(dt) {
    // compute rotation speed from wheel delta (accumulated per frame)
    this.rotateSpeed = this.wheelDelta * 0.5 * dt; // 0.5 deg per pixel? adjust
    this.wheelDelta = 0;
  }
}
