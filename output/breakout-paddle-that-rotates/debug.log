class Game {
  constructor(canvas) {
    this.canvas = canvas;
    this.ctx = canvas.getContext('2d');
    this.resizeCanvas();
    window.addEventListener('resize', () => this.resizeCanvas());
    this.lastTime = 0;
    this.running = false;
    this.paused = false;
    this.score = 0;
    this.lives = 3;
    this.highScore = parseInt(localStorage.getItem('angleBreakoutHighScore') || '0');
    this.startTime = performance.now();
    this.parTime = 45; // seconds
    this.parEnd = this.startTime + this.parTime * 1000;
    this.loadLevel();
    this.initEntities();
    this.startLoop();
  }
  resizeCanvas() {
    const w = this.canvas.clientWidth;
    const h = this.canvas.clientHeight;
    this.canvas.width = w;
    this.canvas.height = h;
    this.width = w;
    this.height = h;
  }
  loadLevel() {
    // simple level data
    this.levelData = {
      background: '#0d0d0d',
      paddleWidth: 120,
      parTime: 45,
      bricks: [
        {row:0,col:0,type:'normal',color:'#ff5555'},
        {row:0,col:1,type:'normal',color:'#ffaa55'},
        // ... we can add few bricks
      ]
    };
  }
  initEntities() {
    this.paddle = new Paddle(this);
    this.ball = new Ball(this);
    this.bricks = [];
    // create bricks from levelData
    for (let b of this.levelData.bricks) {
      this.bricks.push(new Brick(this, b.row, b.col, b.type, b.color));
    }
    this.powerUps = [];
    this.particles = new ParticleSystem();
    this.timers = { speedrun: 0 };
  }
  startLoop() {
    this.running = true;
    requestAnimationFrame(this.loop.bind(this));
  }
  loop(timestamp) {
    const dt = (timestamp - this.lastTime) / 1000;
    this.lastTime = timestamp;
    if (!this.paused) {
      this.update(dt);
      this.render();
    }
    if (this.running) requestAnimationFrame(this.loop.bind(this));
  }
  update(dt) {
    this.timers.speedrun += dt;
    this.paddle.update(dt);
    this.ball.update(dt);
    // update bricks, powerUps, particles
    this.checkCollisions();
    this.checkLives();
    // check win condition
    if (this.bricks.length === 0) {
      this.levelComplete();
    }
  }
  render() {
    this.ctx.clearRect(0,0,this.width,this.height);
    this.drawBackground();
    this.drawBricks();
    this.paddle.draw(this.ctx);
    this.ball.draw(this.ctx);
    this.particles.update(dt);
    this.particles.draw(this.ctx);
    this.drawPowerUps();
    this.drawHUD();
  }
  drawBackground() {
    this.ctx.fillStyle = this.levelData.background;
    this.ctx.fillRect(0,0,this.width,this.height);
  }
  drawBricks() {
    for (let b of this.bricks) b.draw(this.ctx);
  }
  drawPowerUps() {
    for (let pu of this.powerUps) pu.draw(this.ctx);
  }
  drawHUD() {
    // lives
    this.ctx.fillStyle = '#fff';
    this.ctx.font = '16px sans-serif';
    this.ctx.fillText('Lives: ' + this.lives, 10, 20);
    // score
    this.ctx.fillText('Score: ' + this.score, 10, 40);
    // timer
    const remaining = Math.max(0, this.parEnd - this.timers.speedrun*1000);
    const secs = Math.floor(remaining/1000);
    this.ctx.fillText('Time: ' + secs + 's', this.width-100, 20);
    // angle indicator (simple)
    this.ctx.save();
    this.ctx.translate(this.width/2, this.height-30);
    this.ctx.rotate(-this.paddle.angle);
    this.ctx.fillStyle = '#0ff';
    this.ctx.fillRect(-20, -5, 40, 10);
    this.ctx.restore();
  }
  checkCollisions() {
    // ball-paddle
    if (this.ball.isLocked) return;
    if (this.paddle.getBounds().contains(this.ball.x, this.ball.y)) {
      this.ball.isLocked = false;
      this.ball.launch(this.paddle.angle);
    }
    // ball-walls
    if (this.ball.x - this.ball.radius < 0) { this.ball.vx = Math.abs(this.ball.vx); }
    if (this.ball.x + this.ball.radius > this.width) { this.ball.vx = -Math.abs(this.ball.vx); }
    if (this.ball.y - this.ball.radius < 0) { this.ball.vy = Math.abs(this.ball.vy); }
    // ball-bottom
    if (this.ball.y + this.ball.radius > this.height) {
      this.lives--;
      this.ball.reset(this.paddle);
    }
    // ball-brick
    for (let i = this.bricks.length-1; i>=0; i--) {
      let b = this.bricks[i];
      if (this.ball.isLocked) break;
      if (this.ball.getBounds().overlaps(b.getBounds())) {
        this.ball.vx = -this.ball.vx;
        this.ball.vy = -this.ball.vy;
        b.hit();
        if (b.health <= 0) {
          this.bricks.splice(i,1);
          this.particles.emit(b.x, b.y);
          // chance to drop power-up
          if (Math.random() < 0.05) {
            const types = ['expand','shrink','fast','slow','multi','laser','gravity','extra','boost'];
            const type = types[Math.floor(Math.random()*types.length)];
            this.powerUps.push(new PowerUp(this.ball.x, this.ball.y, type));
          }
        }
      }
    }
  }
  checkLives() {
    if (this.lives <= 0) {
      this.gameOver();
    }
  }
  resetBall(paddle) {
    this.ball.x = paddle.x;
    this.ball.y = paddle.y - this.ball.radius;
    this.ball.vx = 0;
    this.ball.vy = 0;
    this.ball.isLocked = true;
  }
  levelComplete() {
    // show overlay maybe
    this.running = false;
  }
  gameOver() {
    // show overlay
    this.running = false;
  }
}

Now Paddle.js:

class Paddle {
  constructor(game) {
    this.game = game;
    this.width = game.levelData.paddleWidth;
    this.height = 20;
    this.x = this.game.canvas.width/2 - this.width/2;
    this.y = this.game.canvas.height - this.height - 10;
    this.angle = 0;
    this.vx = 0;
    this.ax = 0;
    this.ay = 0;
    this.rotationSpeed = 0;
    this.maxSpeed = 800;
    this.acc = 1500;
  }
  getBounds() {
    const halfW = this.width/2;
    const halfH = this.height/2;
    const cosA = Math.cos(this.angle);
    const sinA = Math.sin(this.angle);
    const pts = [
      {x: this.x - halfW, y: this.y - halfH},
      {x: this.x + halfW, y: this.y - halfH},
      {x: this.x + halfW, y: this.y + halfH},
      {x: this.x - halfW, y: this.y + halfH}
    ];
    return {minX: Infinity, maxX: -Infinity, minY: Infinity, maxY: -Infinity};
    // compute min/max
    let minX = pts[0].x, maxX = pts[0].x, minY = pts[0].y, maxY = pts[0].y;
    for (let p of pts) {
      if (p.x < minX) minX = p.x;
      if (p.x > maxX) maxX = p.x;
      if (p.y < minY) minY = p.y;
      if (p.y > maxY) maxY = p.y;
    }
    return {minX, maxX, minY, maxY};
  }
  launchAngle() {
    return this.angle;
  }
  update(dt) {
    // horizontal movement
    let target = this.game.input.mouseX - this.game.canvas.width/2;
    let dx = target - this.x;
    let speed = this.vx;
    if (dx > 0) {
      speed = Math.min(speed + this.acc*dt, this.maxSpeed);
    } else if (dx < 0) {
      speed = Math.max(speed - this.acc*dt, -this.maxSpeed);
    }
    this.vx = speed;
    this.x += this.vx * dt;
    // clamp
    const bounds = this.getBounds();
    if (this.x - this.width/2 < 0) this.x = this.width/2;
    if (this.x + this.width/2 > this.game.canvas.width) this.x = this.game.canvas.width - this.width/2;
    // rotation
    this.rotationSpeed = this.game.input.rotateSpeed;
    this.angle += this.rotationSpeed * dt;
    // clamp angle
    this.angle = Math.max(-Math.PI/4, Math.min(Math.PI/4, this.angle));
  }
  draw(ctx) {
    ctx.save();
    ctx.translate(this.x, this.y);
    ctx.rotate(this.angle);
    ctx.fillStyle = '#00ff00';
    ctx.fillRect(-this.width/2, -this.height/2, this.width, this.height);
    ctx.restore();
  }
}

Ball.js:

class Ball {
  constructor(game) {
    this.game = game;
    this.radius = 10;
    this.x = 0;
    this.y = 0;
    this.vx = 0;
    this.vy = 0;
    this.speed = 300;
    this.maxSpeed = 600;
    this.isLocked = true;
  }
  launch(angle) {
    const dir = {x: Math.cos(angle), y: Math.sin(angle)};
    let vx = dir.x * this.speed;
    let vy = dir.y * this.speed;
    const spread = (Math.random()-0.5)*10*Math.PI/180; // ±5°
    vx = (vx*Math.cos(spread) - vy*Math.sin(spread));
    vy = (vx*Math.sin(spread) + vy*Math.cos(spread));
    this.vx = vx;
    this.vy = vy;
    this.isLocked = false;
  }
  reset(paddle) {
    this.x = paddle.x + paddle.width/2 - this.radius;
    this.y = paddle.y - this.height/2 - this.radius;
    this.vx = 0;
    this.vy = 0;
    this.isLocked = true;
  }
  update(dt) {
    if (this.isLocked) return;
    this.x += this.vx * dt;
    this.y += this.vy * dt;
    // speed cap
    let speed = Math.hypot(this.vx, this.vy);
    if (speed > this.maxSpeed) {
      const factor = this.maxSpeed / speed;
      this.vx *= factor;
      this.vy *= factor;
    }
  }
  getBounds() {
    return {minX: this.x - this.radius, maxX: this.x + this.radius, minY: this.y - this.radius, maxY: this.y + this.radius};
  }
  draw(ctx) {
    ctx.beginPath();
    ctx.arc(this.x, this.y, this.radius, 0, Math.PI*2);
    ctx.fillStyle = '#ff0000';
    ctx.fill();
  }
}

Brick.js:

class Brick {
  constructor(game, row, col, type, color) {
    this.game = game;
    this.row = row;
    this.col = col;
    this.type = type;
    this.color = color;
    this.health = (type === 'normal' ? 1 : type === 'durable' ? 2 : 0);
    const w = 60, h = 20;
    this.x = col * (w + 4) + 4; // 4px padding
    this.y = row * (h + 4) + 4;
    this.w = w;
    this.h = h;
  }
  getBounds() {
    return {minX: this.x, maxX: this.x + this.w, minY: this.y, maxY: this.y + this.h};
  }
  hit() {
    this.health--;
    if (this.health <= 0) {
      this.destroy();
    }
  }
  destroy() {
    this.game.bricks.splice(this.row, 1); // wrong; need to remove by index; we stored row but not index.
    // For simplicity, we will store index in array; but we can just set health and let renderer hide.
    // We'll just mark as destroyed by setting a flag.
  }
  draw(ctx) {
    if (this.health <= 0) return;
    ctx.fillStyle = this.color;
    ctx.fillRect(this.x, this.y, this.w, this.h);
    // durable crack after first hit
    if (this.type === 'durable' && this.health === 1) {
      ctx.strokeStyle = '#000';
      ctx.lineWidth = 2;
      ctx.strokeRect(this.x, this.y, this.w, this.h);
    }
  }
}

