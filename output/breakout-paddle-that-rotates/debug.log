PowerUp.js:

class PowerUp {
  constructor(x, y, type) {
    this.x = x;
    this.y = y;
    this.type = type;
    this.vy = -150;
    this.radius = 12;
    this.collected = false;
  }
  update(dt) {
    this.y += this.vy * dt;
  }
  draw(ctx) {
    ctx.save();
    ctx.translate(this.x, this.y);
    ctx.globalAlpha = 0.8;
    // simple icon based on type
    ctx.fillStyle = '#ff0';
    if (this.type === 'expand') {
      ctx.fillRect(-6, -6, 12, 12);
    } else if (this.type === 'shrink') {
      ctx.fillRect(-6, -6, 12, 12);
    } else if (this.type === 'fast') {
      ctx.fillRect(-6, -6, 12, 12);
    } else if (this.type === 'slow') {
      ctx.fillRect(-6, -6, 12, 12);
    } else if (this.type === 'multi') {
      ctx.fillRect(-6, -6, 12, 12);
    } else if (this.type === 'laser') {
      ctx.fillRect(-6, -6, 12, 12);
    } else if (this.type === 'gravity') {
      ctx.fillRect(-6, -6, 12, 12);
    } else if (this.type === 'extra') {
      ctx.fillRect(-6, -6, 12, 12);
    } else if (this.type === 'boost') {
      ctx.fillRect(-6, -6, 12, 12);
    }
    ctx.restore();
  }
  collect(paddle) {
    const pBounds = paddle.getBounds();
    const bBounds = {minX: this.x - this.radius, maxX: this.x + this.radius, minY: this.y - this.radius, maxY: this.y + this.radius};
    if (pBounds.minX < bBounds.maxX && pBounds.maxX > bBounds.minX &&
        pBounds.minY < bBounds.maxY && pBounds.maxY > bBounds.minY) {
      this.collected = true;
      return true;
    }
    return false;
  }
}

Collision.js:

function getAABB(a) { return {minX:a.minX, maxX:a.maxX, minY:a.minY, maxY:a.maxY}; }
function getRotatedAABB(paddle) {
  const halfW = paddle.width/2;
  const halfH = paddle.height/2;
  const cosA = Math.cos(paddle.angle);
  const sinA = Math.sin(paddle.angle);
  const points = [
    {x: -halfW, y: -halfH},
    {x: halfW, y: -halfH},
    {x: halfW, y: halfH},
    {x: -halfW, y: halfH}
  ];
  let minX = Infinity, maxX = -Infinity, minY = Infinity, maxY = -Infinity;
  for (let p of points) {
    const xr = p.x * cosA - p.y * sinA + paddle.x;
    const yr = p.x * sinA + p.y * cosA + paddle.y;
    if (xr < minX) minX = xr;
    if (xr > maxX) maxX = xr;
    if (yr < minY) minY = yr;
    if (yr > maxY) maxY = yr;
  }
  return {minX, maxX, minY, maxY};
}
function circleAABBCollision(circle, aabb) {
  // find closest point on AABB to circle center
  const closestX = Math.max(aabb.minX, Math.min(circle.x, aabb.maxX));
  const closestY = Math.max(aabb.minY, Math.min(circle.y, aabb.maxY));
  const dx = circle.x - closestX;
  const dy = circle.y - closestY;
  const distSq = dx*dx + dy*dy;
  return distSq < circle.radius*circle.radius;
}
function resolvePaddleBall(paddle, ball) {
  const bounds = getRotatedAABB(paddle);
  if (circleAABBCollision(ball, bounds)) {
    // reflect velocity based on impact normal
    const nx = ball.x - (bounds.minX + bounds.maxX)/2;
    const ny = ball.y - (bounds.minY + bounds.maxY)/2;
    const len = Math.hypot(nx, ny) || 1;
    const ux = nx / len;
    const uy = ny / len;
    // reflect
    const dot = ball.vx * ux + ball.vy * uy;
    ball.vx = ball.vx - 2 * dot * ux;
    ball.vy = ball.vy - 2 * dot * uy;
    // add paddle tangential speed
    const tangent = {x: -uy, y: ux};
    const paddleSpeed = paddle.vx; // horizontal speed influences tangential
    ball.vx += paddleSpeed * tangent.x;
    ball.vy += paddleSpeed * tangent.y;
  }
}
function resolveWall(ball) {
  if (ball.x - ball.radius < 0) ball.vx = Math.abs(ball.vx);
  if (ball.x + ball.radius > canvasWidth) ball.vx = -Math.abs(ball.vx);
  if (ball.y - ball.radius < 0) ball.vy = Math.abs(ball.vy);
}
function resolveBrickBall(ball, brick) {
  // simple AABB collision
  const b = brick.getBounds();
  if (ball.x - ball.radius < b.maxX && ball.x + ball.radius > b.minX &&
      ball.y - ball.radius < b.maxY && ball.y + ball.radius > b.minY) {
    // reflect
    ball.vx = -ball.vx;
    ball.vy = -ball.vy;
  }
}

Note: We need canvas width variable; we can pass it.

Renderer.js:

class Renderer {
  constructor(game) {
    this.game = game;
    this.ctx = game.ctx;
  }
  render() {
    this.ctx.clearRect(0,0,this.game.width,this.game.height);
    this.drawBackground();
    this.drawBricks();
    this.paddle.draw(this.ctx);
    this.ball.draw(this.ctx);
    this.particles.update(this.game.timers.speedrun);
    this.particles.draw(this.ctx);
    this.drawPowerUps();
    this.drawHUD();
  }
  drawBackground() {
    this.ctx.fillStyle = this.game.levelData.background;
    this.ctx.fillRect(0,0,this.game.width,this.game.height);
  }
  drawBricks() {
    for (let b of this.game.bricks) b.draw(this.ctx);
  }
  drawPowerUps() {
    for (let pu of this.game.powerUps) pu.draw(this.ctx);
  }
  drawHUD() {
    const ctx = this.ctx;
    // lives
    ctx.fillStyle = '#fff';
    ctx.font = '16px sans-serif';
    ctx.fillText('Lives: ' + this.game.lives, 10, 20);
    // score
    ctx.fillText('Score: ' + this.game.score, 10, 40);
    // timer
    const remaining = Math.max(0, this.game.parEnd - this.game.timers.speedrun*1000);
    const secs = Math.floor(remaining/1000);
    ctx.fillText('Time: ' + secs + 's', this.game.width-100, 20);
    // angle indicator (simple)
    ctx.save();
    ctx.translate(this.game.width/2, this.game.height-30);
    ctx.rotate(-this.game.paddle.angle);
    ctx.fillStyle = '#0ff';
    ctx.fillRect(-20, -5, 40, 10);
    ctx.restore();
  }
}

ParticleSystem.js:

class ParticleSystem {
  constructor() {
    this.particles = [];
    this.maxParticles = 200;
  }
  emit(x, y) {
    const count = 12 + Math.floor(Math.random()*8);
    for (let i=0;i<count;i++) {
      const size = 2 + Math.random()*2;
      const angle = Math.random()*Math.PI*2;
      const speed = 50 + Math.random()*100;
      this.particles.push({x, y, vx: Math.cos(angle)*speed, vy: Math.sin(angle)*speed, size, life: 0.3});
    }
  }
  update(dt) {
    for (let i=this.particles.length-1; i>=0; i--) {
      const p = this.particles[i];
      p.x += p.vx * dt;
      p.y += p.vy * dt;
      p.life -= dt;
      if (p.life <= 0) this.particles.splice(i,1);
    }
  }
  draw(ctx) {
    for (let p of this.particles) {
      ctx.globalAlpha = p.life;
      ctx.fillStyle = '#fff';
      ctx.beginPath();
      ctx.arc(p.x, p.y, p.size, 0, Math.PI*2);
      ctx.fill();
    }
  }
}

SoundManager.js:

class SoundManager {
  constructor() {
    this.ctx = new (window.AudioContext || window.webkitAudioContext)();
    this.buffers = {};
    this.loadSounds();
  }
  async loadSounds() {
    const names = ['paddle','ball','brick','destroy','powerup','life','levelup'];
    for (let n of names) {
      const resp = await fetch(`assets/sounds/${n}.wav`);
      const array = await resp.arrayBuffer();
      const audioBuf = await this.ctx.decodeAudioData(array);
      this.buffers[n] = audioBuf;
    }
  }
  play(name, loop=false) {
    const buf = this.buffers[name];
    if (!buf) return;
    const source = this.ctx.createBufferSource();
    source.buffer = buf;
    const gain = this.ctx.createGain();
    gain.gain.value = 0.5;
    source.connect(gain);
    gain.connect(this.ctx.destination);
    source.start();
    if (loop) source.loop = true;
  }
}

