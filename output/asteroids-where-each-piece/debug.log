  "styles.css": "/* Global Styles */\n* {\n    margin: 0;\n    padding: 0;\n    box-sizing: border-box;\n}\n\nbody {\n    font-family: 'Orbitron', 'Monospace', sans-serif;\n    background: #000011;\n    overflow: hidden;\n    display: flex;\n    justify-content: center;\n    align-items: center;\n    min-height: 100vh;\n}\n\n#game-container {\n    position: relative;\n    cursor: crosshair;\n}\n\ncanvas {\n    display: block;\n    image-rendering: pixelated;\n}\n\n/* --- Emoji Favicon Already In HTML Head --- */\n\n/* --- HUD Styles --- */\n#hud {\n    position: absolute;\n    top: 16px;\n    left: 16px;\n    z-index: 100;\n    display: flex;\n    gap: 24px;\n}\n\n.health-bar {\n    width: 120px;\n    height: 8px;\n    background: #1a1a2e;\n    border-radius: 4px;\n    transition: width 0.3s ease;\n}\n\n.score-display {\n    font-size: 28px;\n    font-weight: bold;\n    color: #fff;\n    text-shadow: 0 0 10px rgba(255,255,255,0.5);\n    min-width: 60px;\n}\n\n.mini-map {\n    position: absolute;\n    bottom: 16px;\n    right: 16px;\n    width: 100px;\n    height: 100px;\n    background: rgba(0,0,0,0.7);\n    border: 2px solid #00ffff;\n    border-radius: 8px;\n    overflow: hidden;\n}\n\n/* --- Start Screen --- */\n#start-screen,\n#game-over-screen {\n    position: absolute;\n    inset: 0;\n    display: none;\n    flex-direction: column;\n    align-items: center;\n    justify-content: center;\n    background: rgba(0,0,0,0.85);\n    z-index: 200;\n}\n\n#start-screen h1 {\n    font-size: 48px;\n    color: #ff3366;\n    text-shadow: 0 0 20px #ff3366;\n    margin-bottom: 32px;\n}\n\n#game-over-screen h1 {\n    font-size: 36px;\n    color: #ff00ff;\n    text-shadow: 0 0 20px #ff00ff;\n}\n\n#start-screen button,\n#game-over-screen button,\n#pause-menu button {\n    padding: 16px 48px;\n    font-size: 20px;\n    font-weight: bold;\n    color: #fff;\n    background: #00ffff;\n    border: none;\n    border-radius: 8px;\n    cursor: pointer;\n    transition: all 0.3s ease;\n}