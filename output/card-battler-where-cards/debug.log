  "gameState.js": "export class GameState {\n  constructor() {\n    this.reset();\n  }\n\n  reset() {\n    this.playerHP = 100;\n    this.energy = 3;\n    this.maxEnergy = 3;\n    this.weatherType = null; // null, 'clear', 'rain', 'sandstorm', 'fire', 'blizzard', 'aurora'\n    this.weatherTurns = 3;\n    this.hand = [];\n    this.deck = generateDeck();\n    this.avatarX = 400;\n    this.avatarLane = 1; // 1 = left, 2 = right\n    this.turnCount = 0;\n    this.speedRunTimer = 60;\n    this.isPaused = false;\n  }\n\n  drawHand(size) {\n    this.hand = this.deck.slice(0, size);\n  }\n\n  gainEnergy() {\n    this.energy = Math.min(this.maxEnergy, this.energy + 3);\n  }\n\n  playCard(card) {\n    if (this.energy >= card.cost && !this.isPaused) {\n      this.energy -= card.cost;\n      this.hand.push(card);\n      return true;\n    }\n    return false;\n  }\n\n  playWeather(card) {\n    if (this.weatherTurns > 0) {\n      this.weatherTurns--;\n      this.applyWeather(card.type);\n      return true;\n    }\n    return false;\n  }\n\n  takeDamage(amount) {\n    this.playerHP = Math.max(0, this.playerHP - amount);\n  }\n\n  heal(amount) {\n    this.playerHP = Math.min(100, this.playerHP + amount);\n  }\n\n  getState() {\n    return {\n      playerHP: this.playerHP,\n      energy: this.energy,\n      maxEnergy: this.maxEnergy,\n      weatherType: this.weatherType,\n      weatherTurns: this.weatherTurns,\n      hand: [...this.hand],\n      deck: [...this.deck],\n      avatarX: this.avatarX,\n      avatarLane: this.avatarLane,\n      turnCount: this.turnCount,\n      speedRunTimer: this.speedRunTimer,\n      isPaused: this.isPaused\n    };\n  }\n}\n\nfunction generateDeck() {\n  const deck = [];\n  const types = ['clear', 'rain', 'sandstorm', 'fire', 'blizzard', 'aurora'];\n  const costs = [1, 2, 3];\n  for (let i = 0; i < 30; i++) {\n    const type = types[Math.floor(Math.random() * types.length)];\n    deck.push({\n      id: `card_${i}`,\n      type,\n      cost: costs[Math.floor(Math.random() * costs.length)],\n      name: getCardName(type),\n      effect: getCardEffect(type)\n    });\n  }\n  return deck;\n}\n\nfunction getCardName(type) {\n  const names = {\n    clear: 'Clear Shield',\n    rain: 'Rain Storm',\n    sandstorm: 'Sandstorm',\n    fire: 'Inferno Flame',\n    blizzard: 'Blizzard Burst',\n    aurora: 'Aurora Wave'\n  };\n  return names[type] || type;\n}\n\nfunction getCardEffect(type) {\n  const effects = {\n    clear: () => {},\n    rain: () => { this.weatherType = 'rain'; this.applyWeather('rain'); },\n    sandstorm: () => { this.weatherType = 'sandstorm'; this.applyWeather('sandstorm'); },\n    fire: () => { this.weatherType = 'fire'; this.applyWeather('fire'); },\n    blizzard: () => { this.weatherType = 'blizzard'; this.applyWeather('blizzard'); },\n    aurora: () => { this.weatherType = 'aurora'; this.applyWeather('aurora'); }\n  };\n  if (effects[type]) effects[type]();\n}\n\nexport async function initGame() {\n  return new Promise((resolve) => {\n    const state = new GameState();\n    state.drawHand(5);\n    resolve(state);\n  });\n}",
  "physics.js": "export function updatePhysics(state) {\n  const { avatarX, avatarLane, maxSpeed, friction, deceleration, acceleration } = state;\n  \n  // Get current weather modifiers\n  let speedMultiplier = 1.0;\n  let frictionMultiplier = 1.0;\n  \n  switch (state.weatherType) {\n    case 'rain':\n      speedMultiplier = 0.85;\n      frictionMultiplier = 1.1;\n      break;\n    case 'sandstorm':\n      speedMultiplier = 0.9;\n      frictionMultiplier = 1.05;\n      break;\n    case 'fire':\n      speedMultiplier = 1.1;\n      frictionMultiplier = 1.0;\n      break;\n    case 'blizzard':\n      speedMultiplier = 0.8;\n      frictionMultiplier = 1.2;\n      break;\n    case 'aurora':\n      speedMultiplier = 1.0;\n      frictionMultiplier = 1.0;\n      break;\n    default:\n      speedMultiplier = 1.0;\n      frictionMultiplier = 1.0;\n  }\n  \n  // Apply velocity limits\n  const maxVel = maxSpeed * speedMultiplier;\n  \n  // Simple velocity-based movement (for demo - actual physics would use delta time)\n  // In a real implementation, you'd track previous position and compute dx/dt\n  const moveAmount = Math.sign(acceleration) * Math.abs(acceleration) * 0.016; // simplified\n  const newVelocity = avatarX + moveAmount;\n  \n  // Lane change handling (space key)\n  if (state.isPaused) return;\n  \n  // Simulate movement with friction\n  let velocity = newVelocity;\n  velocity *= frictionMultiplier;\n  \n  // Cap at max speed\n  if (velocity > maxVel) velocity = maxVel;\n  else if (velocity < -maxVel) velocity = -maxVel;\n  \n  // Apply deceleration when coasting\n  if (Math.abs(velocity) < 0.01) {\n    velocity *= deceleration;\n  }\n  \n  // Update position\n  state.avatarX = newVelocity;\n  \n  // Keep within bounds (bounce)\n  if (state.avatarX < 0) {\n    state.avatarX = -state.avatarX;\n    state.avatarX = Math.max(0, state.avatarX);\n  } else if (state.avatarX > 800) {\n    state.avatarX = 800 - state.avatarX;\n    state.avatarX = Math.min(800, state.avatarX);\n  }\n  \n  return state;\n}",
  "weather.js": "import { getCurrentWeatherEffect } from './physics.js';\n\nexport function applyWeather(type) {\n  const weatherData = {\n    clear: {\n      name: 'Clear Sky',\n      icon: '☀️',\n      multiplier: 1.0,\n      friction: 1.0,\n      effects: []\n    },\n    rain: {\n      name: 'Rain Storm',\n      icon: '🌧️',\n      multiplier: 0.85,\n      friction: 1.1,\n      effects: [\n        { desc: 'Slippery ground reduces traction', fn: () => {} }\n      ]\n    },\n    sandstorm: {\n      name: 'Sandstorm',\n      icon: '🏜️',\n      multiplier: 0.9,\n      friction: 1.05,\n      effects: [\n        { desc: 'Reduced visibility, dust clouds', fn: () => {} }\n      ]\n    },\n    fire: {\n      name: 'Inferno Flame',\n      icon: '🔥',\n      multiplier: 1.1,\n      friction: 1.0,\n      effects: [\n        { desc: '+5 damage to Water cards', fn: () => {} }\n      ]\n    },\n    blizzard: {\n      name: 'Blizzard Burst',\n      icon: '❄️',\n      multiplier: 0.8,\n      friction: 1.2,\n      effects: [\n        { desc: '-3 damage to Cold cards', fn: () => {} }\n      ]\n    },\n    aurora: {\n      name: 'Aurora Wave',\n      icon: '🌈',\n      multiplier: 1.0,\n      friction: 1.0,\n      effects: [\n        { desc: 'Visual glow around avatar', fn: () => {} }\n      ]\n    }\n  };\n  \n  const weather = weatherData[type];\n  if (!weather) return;\n  \n  state.weatherType = type;\n  state.weatherTurns = 3;\n  \n  // Apply weather modifiers immediately\n  const modifier = weather.effects[0]; // first effect gets applied\n  if (modifier) {\n    state.maxSpeed = state.maxSpeed * modifier.multiplier;\n    state.friction = state.friction * modifier.friction;\n  }\n  \n  // Spawn weather particles\n  spawnWeatherParticles(weather.icon, type);\n  \n  console.log(`Weather activated: ${weather.name} (${type})`);\n}\n\nexport function clearWeather() {\n  state.weatherType = null;\n  state.weatherTurns = 3;\n  state.maxSpeed = 1.0;\n  state.friction = 1.0;\n  \n  // Remove weather particles\n  removeWeatherParticles();\n  \n  console.log('Weather cleared');\n}\n\nfunction spawnWeatherParticles(icon, type) {\n  // Create temporary particle objects (simplified)\n  const particles = [];\n  for (let i = 0; i < 20; i++) {\n    particles.push({\n      x: 400,\n      y: Math.random() * 600,\n      vx: (Math.random() - 0.5) * 2,\n      vy: (Math.random() - 0.5) * 2,\n      life: 1.0,\n      color: getWeatherColor(type)\n    });\n  }\n  state.particles = particles;\n}\n\nfunction removeWeatherParticles() {\n  state.particles = [];\n}\n\nfunction getWeatherColor(type) {\n  const colors = {\n    clear: '#4A90E2',\n    rain: '#4A90E2',\n    sandstorm: '#F5A623',\n    fire: '#E84393',\n    blizzard: '#E84393',\n    aurora: '#7ED321'\n  };\n  return colors[type] || '#888';\n}",
  "audio.js": "class AudioManager {\n  constructor() {\n    this.ctx = null;\n    this.initialized = false;\n  }\n\n  async init() {\n    if (this.initialized) return;\n    try {\n      this.ctx = new (window.AudioContext || window.webkitAudioContext)();\n      this.initialized = true;\n      console.log('Audio context initialized');\n    } catch (e) {\n      console.error('Failed to initialize audio context:', e);\n    }\n  }\n\n  playCardPlay() {\n    if (!this.ctx) return;\n    const notes = ['C4', 'E4', 'G4', 'A4', 'B4'];\n    const note = notes[Math.floor(Math.random() * notes.length)];\n    this.playTone(note, 0.1);\n  }\n\n  playWeatherEnter() {\n    if (!this.ctx) return;\n    const osc = this.ctx.createOscillator();\n    const gain = this.ctx.createGain();\n    osc.type = 'sine';\n    osc.frequency.setValueAtTime(523.25, this.ctx.currentTime); // A4\n    gain.gain.setValueAtTime(0.3, this.ctx.currentTime);\n    gain.gain.exponentialRampToValueAtTime(0.01, this.ctx.currentTime + 0.2);\n    osc.connect(gain);\n    gain.connect(this.ctx.destination);\n    osc.start();\n    osc.stop(this.ctx.currentTime + 0.2);\n  }\n\n  playHit() {\n    if (!this.ctx) return;\n    const osc = this.ctx.createOscillator();\n    const gain = this.ctx.createGain();\n    osc.type = 'square';\n    osc.frequency.setValueAtTime(150, this.ctx.currentTime);\n    gain.gain.setValueAtTime(0.2, this.ctx.currentTime);\n    gain.gain.exponentialRampToValueAtTime(0.01, this.ctx.currentTime + 0.3);\n    osc.connect(gain);\n    gain.connect(this.ctx.destination);\n    osc.start();\n    osc.stop(this.ctx.currentTime + 0.3);\n  }\n\n  playWeatherExit() {\n    if (!this.ctx) return;\n    const osc = this.ctx.createOscillator();\n    const gain = this.ctx.createGain();\n    osc.type = 'triangle';\n    osc.frequency.setValueAtTime(440, this.ctx.currentTime); // A4\n    gain.gain.setValueAtTime(0.2, this.ctx.currentTime);\n    gain.gain.exponentialRampToValueAtTime(0.01, this.ctx.currentTime + 0.4);\n    osc.connect(gain);\n    gain.connect(this.ctx.destination);\n    osc.start();\n    osc.stop(this.ctx.currentTime + 0.4);\n  }\n\n  playTurnTimer() {\n    if (!this.ctx) return;\n    // Continuous low hum during timer\n    const osc = this.ctx.createOscillator();\n    const gain = this.ctx.createGain();\n    osc.type = 'sine';\n    osc.frequency.setValueAtTime(110, this.ctx.currentTime); // A2\n    gain.gain.setValueAtTime(0.05, this.ctx.currentTime);\n    gain.gain.exponentialRampToValueAtTime(0.001, this.ctx.currentTime + 2);\n    osc.connect(gain);\n    gain.connect(this.ctx.destination);\n    osc.start();\n    osc.stop(this.ctx.currentTime + 2);\n  }\n}\n\nexport default new AudioManager();",
  "ui.js": "export function renderUI(state) {\n  const container = document.getElementById('game-container');\n  \n  // Speed Run Timer\n  const timerEl = document.getElementById('speedrun-timer');\n  if (state.speedRunTimer > 0) {\n    timerEl.textContent = state.speedRunTimer;\n  } else {\n    timerEl.style.display = 'none';\n  }\n  \n  // Turn Info\n  const turnInfo = document.getElementById('turn-info');\n  turnInfo.textContent = `Turn ${state.turnCount} — ${state.weatherType || 'Clear'}`;\n  \n  // Health Bars\n  const pBar = document.createElement('div');\n  pBar.className = 'health-bar player1';\n  pBar.style.width = `${state.playerHP}%`;\n  document.body.appendChild(pBar);\n  \n  const pBar2 = document.createElement('div');\n  pBar2.className = 'health-bar player2';\n  pBar2.style.width = `${100 - state.playerHP}%`;\n  document.body.appendChild(pBar2);\n  \n  // Energy Counter\n  const energyContainer = document.createElement('div');\n  energyContainer.className = 'energy-counter';\n  const energyIcon = document.createElement('div');\n  energyIcon.className = 'energy-icon';\n  energyIcon.id = 'energy-icon';\n  energyContainer.appendChild(energyIcon);\n  document.body.appendChild(energyContainer);\n  \n  // Hand Display\n  const handDiv = document.createElement('div');\n  handDiv.id = 'hand-display';\n  document.body.appendChild(handDiv);\n  \n  // Deck / Discard\n  const deckDiv = document.createElement('div');\n  deckDiv.id = 'deck-display';\n  deckDiv.className = 'deck-display';\n  document.body.appendChild(deckDiv);\n  \n  function updateHandUI(state) {\n    const hand = state.getState().hand;\n    if (hand.length === 0) {\n      handDiv.innerHTML = '<span style=\\"color:#666\\">Empty hand</span>';\n      return;\n    }\n    \n    hand.forEach((card, index) => {\n      const cardEl = document.createElement('div');\n      cardEl.className = 'card-thumbnail';\n      cardEl.style.background = getCardBackground(colorForCard(card));\n      cardEl.title = `${ca