  "index.html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, user-scalable=no\">\n    <title>COIL: KINETIC ASCENT</title>\n    <link rel=\"icon\" href=\"data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🌪️</text></svg>\">\n    <style>\n        * { margin: 0; padding: 0; box-sizing: border-box; touch-action: none; -webkit-tap-highlight-color: transparent; }\n        body { background: #1a1a2e; overflow: hidden; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; color: #e0e0e0; }\n        #game-container { width: 100vw; height: 100vh; display: flex; justify-content: center; align-items: center; background: #0d0d1a; }\n        canvas { display: block; max-width: 100%; max-height: 100%; image-rendering: pixelated; image-rendering: crisp-edges; }\n        #ui-overlay { position: absolute; top: 0; left: 0; width: 100%; height: 100%; pointer-events: none; display: flex; flex-direction: column; justify-content: space-between; padding: 20px; box-sizing: border-box; }\n        .hud-element { pointer-events: auto; }\n        .timer { font-size: 1.5rem; font-weight: 700; color: #00f2ff; text-shadow: 0 0 10px #00f2ff, 0 0 20px #00f2ff; font-variant-numeric: tabular-nums; letter-spacing: 2px; }\n        .gear-counter { font-size: 1.2rem; color: #ffd700; text-shadow: 0 0 5px #ffd700; display: flex; align-items: center; gap: 8px; }\n        .charge-meter-container { width: 120px; height: 120px; }\n        .charge-meter-bg { width: 100%; height: 100%; border-radius: 50%; border: 4px solid #3a3a5e; background: rgba(26,26,46,0.8); position: relative; box-shadow: inset 0 0 20px #000, 0 0 15px #00f2ff44; }\n        .charge-meter-fill { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%) rotate(-90deg); width: 90%; height: 90%; border-radius: 50%; border: 6px solid transparent; border-top-color: #00f2ff; border-right-color: #00f2ff; box-shadow: 0 0 15px #00f2ff; transition: opacity 0.1s; }\n        .charge-text { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); font-size: 1.5rem; font-weight: bold; color: #fff; text-shadow: 0 0 5px #00f2ff; }\n        .menu-screen { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); text-align: center; pointer-events: auto; z-index: 10; width: 90%; max-width: 400px; padding: 40px; background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%); border: 2px solid #00f2ff44; border-radius: 16px; box-shadow: 0 0 30px #00f2ff22, inset 0 0 30px #00000088; display: none; flex-direction: column; gap: 20px; }\n        .menu-screen.active { display: flex; }\n        .menu-title { font-size: 3rem; font-weight: 900; background: linear-gradient(90deg, #00f2ff, #ff3131, #ffd700); -webkit-background-clip: text; background-clip: text; color: transparent; text-shadow: 0 0 30px #00f2ff88; letter-spacing: 4px; margin-bottom: 10px; }\n        .menu-subtitle { color: #888; font-size: 1rem; letter-spacing: 2px; text-transform: uppercase; }\n        .btn { padding: 15px 40px; font-size: 1.2rem; font-weight: bold; color: #1a1a2e; background: linear-gradient(90deg, #00f2ff, #4facfe); border: none; border-radius: 50px; cursor: pointer; transition: all 0.2s ease; text-transform: uppercase; letter-spacing: 2px; box-shadow: 0 5px 15px #00f2ff66; }\n        .btn:hover { transform: translateY(-3px); box-shadow: 0 8px 25px #00f2ff99; background: linear-gradient(90deg, #4facfe, #00f2ff); }\n        .btn:active { transform: translateY(1px); }\n        .btn-secondary { background: linear-gradient(90deg, #4a4e69, #6a6e8f); box-shadow: 0 5px 15px #4a4e6966; }\n        .btn-secondary:hover { box-shadow: 0 8px 25px #4a4e6999; background: linear-gradient(90deg, #6a6e8f, #4a4e69); }\n        .btn-danger { background: linear-gradient(90deg, #ff3131, #ff6b6b); box-shadow: 0 5px 15px #ff313166; }\n        .btn-danger:hover { box-shadow: 0 8px 25px #ff313199; background: linear-gradient(90deg, #ff6b6b, #ff3131); }\n        .stats-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 15px; margin-top: 10px; text-align: center; }\n        .stat-box { background: rgba(0,0,0,0.3); padding: 15px; border-radius: 8px; border: 1px solid #00f2ff22; }\n        .stat-value { font-size: 1.8rem; font-weight: bold; color: #00f2ff; }\n        .stat-label { font-size: 0.7rem; color: #888; text-transform: uppercase; letter-spacing: 1px; }\n        .controls-hint { font-size: 0.8rem; color: #666; margin-top: 20px; line-height: 1.8; }\n        .controls-hint kbd { background: #333; padding: 2px 6px; border-radius: 4px; border: 1px solid #444; margin: 0 2px; }\n        .hidden { display: none !important; }\n        @media (max-width: 768px) { .menu-title { font-size: 2rem; } .timer { font-size: 1rem; } .charge-meter-container { width: 80px; height: 80px; } .charge-text { font-size: 1rem; } }\n    </style>\n</head>\n<body>\n    <div id=\"game-container\">\n        <canvas id=\"game-canvas\" width=\"1280\" height=\"720\"></canvas>\n        <div id=\"ui-overlay\">\n            <div style=\"display: flex; justify-content: space-between; align-items: flex-start;\">\n                <div class=\"hud-element timer\" id=\"timer-display\">00:00.00</div>\n                <div class=\"hud-element gear-counter\" id=\"gear-display\">⚙️ <span id=\"gear-count\">0</span>/<span id=\"gear-total\">0</span></div>\n            </div>\n            <div style=\"display: flex; justify-content: center; align-items: flex-end; height: 100%; padding-bottom: 20px;\">\n                <div class=\"hud-element charge-meter-container\">\n                    <div class=\"charge-meter-bg\">\n                        <svg class=\"charge-meter-fill\" viewBox=\"0 0 100 100\"><circle cx=\"50\" cy=\"50\" r=\"45\" fill=\"none\" stroke-width=\"10\" stroke-linecap=\"round\" stroke-dasharray=\"283\" stroke-dashoffset=\"283\" id=\"charge-circle\"/></svg>\n                        <div class=\"charge-text\" id=\"charge-text\">0</div>\n                    </div>\n                </div>\n            </div>\n        </div>\n        <div id=\"main-menu\" class=\"menu-screen active\">\n            <div class=\"menu-title\">COIL</div>\n            <div class=\"menu-subtitle\">KINETIC ASCENT</div>\n            <button class=\"btn\" id=\"btn-start\">Ascend</button>\n            <button class=\"btn btn-secondary\" id=\"btn-settings\">Settings</button>\n            <div class=\"controls-hint\">\n                <kbd>A</kbd>/<kbd>D</kbd> or <kbd>←</kbd>/<kbd>→</kbd> Move<br>\n                <kbd>Space</kbd>/<kbd>S</kbd>/<kbd>↓</kbd> Charge / Launch<br>\n                <kbd>R</kbd> Restart &nbsp; <kbd>Esc</kbd> Pause\n            </div>\n        </div>\n        <div id=\"pause-menu\" class=\"menu-screen\">\n            <div class=\"menu-title\">PAUSED</div>\n            <button class=\"btn\" id=\"btn-resume\">Resume</button>\n            <button class=\"btn btn-secondary\" id=\"btn-restart-pause\">Restart</button>\n            <button class=\"btn btn-secondary\" id=\"btn-quit\">Main Menu</button>\n        </div>\n        <div id=\"death-menu\" class=\"menu-screen\">\n            <div class=\"menu-title\" style=\"background: linear-gradient(90deg, #ff3131, #ff6b6b); -webkit-background-clip: text; background-clip: text; color: transparent;\">SYSTEM FAILURE</div>\n            <div class=\"menu-subtitle\">REBOOTING...</div>\n            <button class=\"btn btn-danger\" id=\"btn-respawn\">Respawn</button>\n        </div>\n        <div id=\"win-menu\" class=\"menu-screen\">\n            <div class=\"menu-title\" style=\"background: linear-gradient(90deg, #ffd700, #ffaa00); -webkit-background-clip: text; background-clip: text; color: transparent;\">ANCHOR SECURED</div>\n            <div class=\"stats-grid\">\n                <div class=\"stat-box\"><div class=\"stat-value\" id=\"stat-time\">00:00.00</div><div class=\"stat-label\">Time</div></div>\n                <div class=\"stat-box\"><div class=\"stat-value\" id=\"stat-gears\">0/0</div><div class=\"stat-label\">Gears</div></div>\n                <div class=\"stat-box\"><div class=\"stat-value\" id=\"stat-bounces\">0</div><div class=\"stat-label\">Bounces</div></div>\n            </div>\n            <div class=\"stat-box\" style=\"max-width: 300px; margin: 10px auto 0; background: rgba(0,242,255,0.1); border-color: #00f2ff66;\">\n                <div class=\"stat-label\">Best Time (Level 1)</div>\n                <div class=\"stat-value\" id=\"stat-best\" style=\"color: #ffd700; font-size: 1.5rem;\">--:--.--</div>\n            </div>\n            <button class=\"btn\" id=\"btn-next\">Next Level</button>\n            <button class=\"btn btn-secondary\" id=\"btn-replay\">Replay</button>\n            <button class=\"btn btn-secondary\" id=\"btn-menu\">Main Menu</button>\n        </div>\n    </div>\n    <script type=\"module\" src=\"src/main.js\"></script>\n</body>\n</html>",
  "src/main.js": "import { Game } from './game.js';\n\nconst canvas = document.getElementById('game-canvas');\nconst ctx = canvas.getContext('2d');\n\nconst game = new Game(canvas, ctx);\ngame.init();\n\nfunction resize() {\n    const container = document.getElementById('game-container');\n    const rect = container.getBoundingClientRect();\n    const scale = Math.min(rect.width / 1280, rect.height / 720);\n    canvas.style.width = `${1280 * scale}px`;\n    canvas.style.height = `${720 * scale}px`;\n}\n\nwindow.addEventListener('resize', resize);\nresize();\n\nlet lastTime = 0;\nfunction gameLoop(timestamp) {\n    const dt = (timestamp - lastTime) / 1000; // seconds\n    lastTime = timestamp;\n    game.update(dt);\n    game.render();\n    requestAnimationFrame(gameLoop);\n}\nrequestAnimationFrame(gameLoop);",
  "src/game.js": "import { Input } from './core/Input.js';\nimport { Renderer } from './core/Renderer.js';\nimport { AudioManager } from './core/Audio.js';\nimport { Level } from './level/Level.js';\nimport { Player } from './player/Player.js';\nimport { HUD } from './ui/HUD.js';\nimport { Menus } from './ui/Menus.js';\nimport { LEVELS } from './levels/levelData.js';\n\nexport class Game {\n    constructor(canvas, ctx) {\n        this.canvas = canvas;\n        this.ctx = ctx;\n        this.width = 1280;\n        this.height = 720;\n        \n        this.input = new Input();\n        this.renderer = new Renderer(ctx, this.width, this.height);\n        this.audio = new AudioManager();\n        \n        this.currentLevelIndex = 0;\n        this.level = null;\n        this.player = null;\n        \n        this.state = 'MENU'; // MENU, PLAYING, PAUSED, DEAD, WIN\n        \n        this.timer = 0;\n        this.gearsCollected = 0;\n        this.totalGears = 0;\n        this.bounceCount = 0;\n        \n        this.screenShake = 0;\n        \n        this.hud = new HUD(this);\n        this.menus = new Menus(this);\n        \n        this.bestTimes = JSON.parse(localStorage.getItem('coil_best_times')) || {};\n    }\n\n    init() {\n        this.loadLevel(0);\n        this.menus.setupEventListeners();\n        this.audio.init();\n    }\n\n    loadLevel(index) {\n        this.currentLevelIndex = index;\n        const data = LEVELS[index];\n        this.level = new Level(data, this);\n        this.player = new Player(this.level.spawnX, this.level.spawnY, this);\n        \n        this.timer = 0;\n        this.gearsCollected = 0;\n        this.totalGears = this.level.gears.length;\n        this.bounceCount = 0;\n        this.screenShake = 0;\n        \n        this.hud.updateGearTotal(this.totalGears);\n        this.state = 'PLAYING';\n        this.menus.hideAll();\n    }\n\n    restartLevel() {\n        this.loadLevel(this.currentLevelIndex);\n    }\n\n    nextLevel() {\n        const next = (this.currentLevelIndex + 1) % LEVELS.length;\n        this.loadLevel(next);\n    }\n\n    goToMenu() {\n        this.state = 'MENU';\n        this.menus.show('main');\n    }\n\n    update(dt) {\n        if (this.state !== 'PLAYING') return;\n\n        this.timer += dt;\n        \n        this.player.update(dt, this.input);\n        this.level.update(dt);\n        \n        // Camera follow player\n        const targetX = this.player.x - this.width / 2;\n        const targetY = this.player.y - this.height / 2;\n        this.renderer.cameraX += (targetX - this.renderer.cameraX) * 0.1;\n        this.renderer.cameraY += (targetY - this.renderer.cameraY) * 0.1;\n        \n        // Clamp camera to level bounds\n        this.renderer.cameraX = Math.max(0, Math.min(this.renderer.cameraX, this.level.width - this.width));\n        this.renderer.cameraY = Math.max(0, Math.min(this.renderer.cameraY, this.level.height - this.height));\n\n        if (this.screenShake > 0) this.screenShake -= dt * 10;\n    }\n\n    render() {\n        this.renderer.clear();\n        this.renderer.save();\n        \n        if (this.screenShake > 0) {\n            const intensity = this.screenShake * 3;\n            this.renderer.ctx.translate(\n                (Math.random() - 0.5) * intensity,\n                (Math.random() - 0.5) * intensity\n            );\n        }\n\n        this.level.render(this.renderer);\n        this.player.render(this.renderer);\n        \n        this.renderer.restore();\n        \n        this.hud.render(this.renderer);\n    }\n\n    addScreenShake(amount) {\n        this.screenShake = Math.max(this.screenShake, amount);\n    }\n\n    collectGear() {\n        this.gearsCollected++;\n        this.hud.updateGearCount(this.gearsCollected);\n        this.audio.play('gear');\n    }\n\n    playerDied() {\n        if (this.state !== 'PLAYING') return;\n        this.state = 'DEAD';\n        this.audio.play('death');\n        this.addScreenShake(15);\n        setTimeout(() => this.menus.show('death'), 500);\n    }\n\n    playerWon() {\n        if (this.state !== 'PLAYING') return;\n        this.state = 'WIN';\n        this.audio.play('win');\n        \n        // Save best time\n        const key = `level_${this.currentLevelIndex}`;\n        const best = this.bestTimes[key] || Infinity;\n        if (this.timer < best) {\n            this.bestTimes[key] = this.timer;\n            localStorage.setItem('coil_best_times', JSON.stringify(this.bestTimes));\n        }\n        \n        this.menus.showWinScreen(this.timer, this.gearsCollected, this.totalGears, this.bounceCount, this.bestTimes[key]);\n    }\n\n    registerBounce() {\n        this.bounceCount++;\n    }\n\n    formatTime(t) {\n        const m = Math.floor(t / 60).toString().padStart(2, '0');\n        const s = Math.floor(t % 60).toString().padStart(2, '0');\n        const ms = Math.floor((t * 100) % 100).toString().padStart(2, '0');\n        return `${m}:${s}.${ms}`;\n    }\n}",
  "src/core/Input.js": "export class Input {\n    constructor() {\n        this.keys = {};\n        this.keyMap = {\n            'ArrowLeft': 'left', 'KeyA': 'left',\n            'ArrowRight': 'right', 'KeyD': 'right',\n            'ArrowDown': 'down', 'KeyS': 'down',\n            'Space': 'jump',\n            'KeyR': 'restart',\n            'Escape': 'pause'\n        };\n        \n        window.addEventListener('keydown', (e) => this.onKeyDown(e));\n        window.addEventListener('keyup', (e) => this.onKeyUp(e));\n        \n        // Prevent default for game keys\n        window.addEventListener('keydown', (e) => {\n            if (['ArrowLeft', 'ArrowRight', 'ArrowDown', 'ArrowUp', 'Space', 'KeyA', 'KeyD', 'KeyS', 'KeyW'].includes(e.code)) {\n                e.preventDefault();\n            }\n        }, { passive: false });\n    }\n\n    onKeyDown(e) {\n        const action = this.keyMap[e.code];\n        if (action) this.keys[action] = true;\n    }\n\n    onKeyUp(e) {\n        const action = this.keyMap[e.code];\n        if (action) this.keys[action] = false;\n    }\n\n    isPressed(action) {\n        return !!this.keys[action];\n    }\n\n    getAxis() {\n        let x = 0;\n        if (this.isPressed('left')) x -= 1;\n        if (this.isPressed('right')) x += 1;\n        return x;\n    }\n}",
  "src/core/Renderer.js": "export class Renderer {\n    constructor(ctx, width, height) {\n        this.ctx = ctx;\n        this.width = width;\n        this.height = height;\n        this.cameraX = 0;\n        this.cameraY = 0;\n    }\n\n    clear() {\n        this.ctx.fillStyle = '#1a1a2e';\n        this.ctx.fillRect(0, 0, this.width, this.height);\n        // Subtle grid background\n        this.ctx.strokeStyle = '#2a2a4e';\n        this.ctx.lineWidth = 1;\n        this.ctx.beginPath();\n        const gridSize = 40;\n        const startX = -this.cameraX % gridSize;\n        const startY = -this.cameraY % gridSize;\n        for (let x = startX; x < this.width; x += gridSize) {\n            this.ctx.moveTo(x, 0);\n            this.ctx.lineTo(x, this.height);\n        }\n        for (let y = startY; y < this.height; y += gridSize) {\n            this.ctx.moveTo(0, y);\n            this.ctx.lineTo(this.width, y);\n        }\n        this.ctx.stroke();\n    }\n\n    save() { this.ctx.save(); }\n    restore() { this.ctx.restore(); }\n\n    translate(x, y) { this.ctx.translate(x, y); }\n    scale(x, y) { this.ctx.scale(x, y); }\n    rotate(a) { this.ctx.rotate(a); }\n\n    drawRect(x, y, w, h, color, centered = false) {\n        if (centered) { x -= w/2; y -= h/2; }\n        this.ctx.fillStyle = color;\n        this.ctx.fillRect(x - this.cameraX, y - this.cameraY, w, h);\n    }\n\n    drawRectStroke(x, y, w, h, color, lineWidth = 2, centered = false) {\n        if (centered) { x -= w/2; y -= h/2; }\n        this.ctx.strokeStyle = color;\n        this.ctx.lineWidth = lineWidth;\n        this.ctx.strokeRect(x - this.cameraX, y - this.cameraY, w, h);\n    }\n\n    drawCircle(x, y, r, color, centered = true) {\n        this.ctx.beginPath();\n        this.ctx.arc(x - this.cameraX, y - this.cameraY, r, 0, Math.PI * 2);\n        this.ctx.fillStyle = color;\n        this.ctx.fill();\n    }\n\n    drawImage(img, x, y, w, h, centered = true) {\n        if (centered) { x -= w/2; y -= h/2; }\n        this.ctx.drawImage(img, x - this.cameraX, y - this.cameraY, w, h);\n    }\n\n    drawText(text, x, y, opts = {}) {\n        const { size = '16px', font = 'Segoe UI', color = '#fff', align = 'left', baseline = 'top', shadow = true } = opts;\n        this.ctx.font = `${size} ${font}`;\n        this.ctx.fillStyle = color;\n        this.ctx.textAlign = align;\n        this.ctx.textBaseline = baseline;\n        if (shadow) {\n            this.ctx.shadowColor = '#000';\n            this.ctx.shadowBlur = 4;\n            this.ctx.shadowOffsetX = 1;\n            this.ctx.shadowOffsetY = 1;\n        } else {\n            this.ctx.shadowColor = 'transparent';\n        }\n        this.ctx.fillText(text, x, y);\n        this.ctx.shadowColor = 'transparent';\n    }\n\n    // Particle rendering helper\n    drawParticle(p) {\n        this.ctx.globalAlpha = p.life / p.maxLife;\n        this.ctx.fillStyle = p.color;\n        this.ctx.beginPath();\n        this.ctx.arc(p.x - this.cameraX, p.y - this.cameraY, p.size, 0, Math.PI * 2);\n        this.ctx.fill();\n        this.ctx.globalAlpha = 1;\n    }\n}",
  "src/core/Audio.js": "export class AudioManager {\n    constructor() {\n        this.ctx = null;\n        this.sounds = {};\n        this.enabled = true;\n    }\n\n    init() {\n        // Create context on first user interaction\n        const resume = () => {\n            if (!this.ctx) {\n                this.ctx = new (window.AudioContext || window.webkitAudioContext)();\n                this.createSounds();\n            } else if (this.ctx.state === 'suspended') {\n                this.ctx.resume();\n            }\n            window.removeEventListener('click', resume);\n            window.removeEventListener('keydown', resume);\n        };\n        window.addEventListener('click', resume);\n        window.addEventListener('keydown', resume);\n    }\n\n    createSounds() {\n        // Launch: Quick upward sweep\n        this.sounds.launch = () => {\n            if (!this.enabled || !this.ctx) return;\n            const o = this.ctx.createOscillator();\n            const g = this.ctx.createGain();\n            o.type = 'square';\n            o.frequency.setValueAtTime(200, this.ctx.currentTime);\n            o.frequency.exponentialRampToValueAtTime(800, this.ctx.currentTime + 0.1);\n            g.gain.setValueAtTime(0.3, this.ctx.currentTime);\n            g.gain.exponentialRampToValueAtTime(0.01, this.ctx.currentTime + 0.15);\n            o.connect(g).connect(this.ctx.destination);\n            o.start();\n            o.stop(this.ctx.currentTime + 0.2);\n        };\n\n        // Land: Low thud\n        this.sounds.land = () => {\n            if (!this.enabled || !this.ctx) return;\n            const o = this.ctx.createOscillator();\n            const g = this.ctx.createGain();\n            o.type = 'sine';\n            o.frequency.setValueAtTime(150, this.ctx.currentTime);\n            o.frequency.exponentialRampToValueAtTime(50, this.ctx.currentTime + 0.1);\n            g.gain.setValueAtTime(0.4, this.ctx.currentTime);\n            g.gain.exponentialRampToValueAtTime(0.01, this.ctx.currentTime + 0.2);\n            o.connect(g).connect(this.ctx.destination);\n            o.start();\n            o.stop(this.ctx.currentTime + 0.25);\n        };\n\n        // Gear: High ping\n        this.sounds.gear = () => {\n            if (!this.enabled || !this.ctx) return;\n            const o = this.ctx.createOscillator();\n            const g = this.ctx.createGain();\n            o.type = 'triangle';\n            o.frequency.setValueAtTime(1200, this.ctx.currentTime);\n            g.gain.setValueAtTime(0.2, this.ctx.currentTime);\g.gain.exponentialRampToValueAtTime(0.01, this.ctx.currentTime + 0.15);\n            o.connect(g).connect(this.ctx.destination);\n            o.start();\n            o.stop(this.ctx.currentTime + 0.2);\n        };\n\n        // Death: Harsh noise\n        this.sounds.death = () => {\n            if (!this.enabled || !this.ctx) return;\n            const o = this.ctx.createOscillator();\n            const g = this.ctx.createGain();\n            o.type = 'sawtooth';\n            o.frequency.setValueAtTime(300, this.ctx.currentTime);\n            o.frequency.exponentialRampToValueAtTime(50, this.ctx.currentTime + 0.5);\n            g.gain.setValueAtTime(0.5, this.ctx.currentTime);\n            g.gain.exponentialRampToValueAtTime(0.01, this.ctx.currentTime + 0.5);\n            o.connect(g).connect(this.ctx.destination);\n            o.start();\n            o.stop(this.ctx.currentTime + 0.55);\n        };\n\n        // Win: Victory chord\n        this.sounds.win = () => {\n            if (!this.enabled || !this.ctx) return;\n            const notes = [523.25, 659.25, 783.99, 1046.50];\n            notes.forEach((freq, i) => {\n                const o = this.ctx.createOscillator();\n                const g = this.ctx.createGain();\n                o.type = 'triangle';\n                o.frequency.value = freq;\n                const t = this.ctx.currentTime + i * 0.08;\n                g.gain.setValueAtTime(0.15, t);\n                g.gain.exponentialRampToValueAtTime(0.01, t + 0.6);\n                o.connect(g).connect(this.ctx.destination);\n                o.start(t);\n                o.stop(t + 0.7);\n            });\n        };\n\n        // Bounce: Boing\n        this.sounds.bounce = () => {\n            if (!this.enabled || !this.ctx) return;\n            const o = this.ctx.createOscillator();\n            const g = this.ctx.createGain();\n            o.type = 'sine';\n            o.frequency.setValueAtTime(400, this.ctx.currentTime);\n            o.frequency.exponentialRampToValueAtTime(200, this.ctx.currentTime + 0.05);\n            o.frequency.exponentialRampToValueAtTime(400, this.ctx.currentTime + 0.1);\n            g.gain.setValueAtTime(0.25, this.ctx.currentTime);\n            g.gain.exponentialRampToValueAtTime(0.01, this.ctx.currentTime + 0.15);\n            o.connect(g).connect(this.ctx.destination);\n            o.start();\n            o.stop(this.ctx.currentTime + 0.2);\n        };\n\n        // Charge: Rising hum\n        this.sounds.charge = (progress) => {\n            if (!this.enabled || !this.ctx) return;\n            const o = this.ctx.createOscillator();\n            const g = this.ctx.createGain();\n            o.type = 'sine';\n            const baseFreq = 100 + progress * 300;\n            o.frequency.setValueAtTime(baseFreq, this.ctx.currentTime);\n            o.frequency.linearRampToValueAtTime(baseFreq + 50, this.ctx.currentTime + 0.05);\n            g.gain.setValueAtTime(0.1 * progress, this.ctx.currentTime);\n            g.gain.linearRampToValueAtTime(0.01, this.ctx.currentTime + 0.1);\n            o.connect(g).connect(this.ctx.destination);\n            o.start();\n            o.stop(this.ctx.currentTime + 0.12);\n        };\n    }\n\n    play(name, ...args) {\n        if (this.sounds[name]) this.sounds[name](...args);\n    }\n\n    setEnabled(enabled) {\n        this.enabled = enabled;\n    }\n}",
  "src/player/Player.js": "import { PARTICLES } from '../core/Particles.js';\n\nexport class Player {\n    constructor(x, y, game) {\n        this.game = game;\n        this.x = x;\n        this.y = y;\n        this.vx = 0;\n        this.vy = 0;\n        \n        this.radius = 16;\n        this.color = '#00f2ff';\n        this.glowColor = '#00f2ff';\n        \n        this.onGround = false;\n        this.wasOnGround = false;\n        \n        this.charge = 0;\n        this.maxCharge = 1.5; // seconds\n        this.chargeRate = 1 / this.maxCharge;\n        this.isCharging = false;\n        this.chargeDirection = 0; // -1 left, 1 right\n        \n        this.launchPower = 28;\n        this.minLaunchPower = 12;\n        \n        this.moveSpeed = 8;\n        this.airControl = 0.3;\n        \n        this.gravity = 35;\n        this.terminalVelocity = 45;\n        \n        this.friction = 0.85;\n        this.airFriction = 0.98;\n        \n        this.bounceDamping = 0.7;\n        this.wallSlideSpeed = 8;\n        \n        this.trail = [];\n        this.maxTrailLength = 12;\n        \n        this.invulnerable = 0;\n        \n        // Visual\n        this.rotation = 0;\n        this.squash = 1;\n        this.stretch = 1;\n        \n        this.chargeParticles = [];\n    }\n\n    update(dt, input) {\n        this.wasOnGround = this.onGround;\n        \n        // Handle charging\n        const chargeHeld = input.isPressed('jump') || input.isPressed('down');\n        const horizontal = input.getAxis();\n        \n        if (chargeHeld && this.onGround) {\n            if (!this.isCharging) {\n                this.isCharging = true;\n                this.charge = 0;\n                this.chargeDirection = horizontal !== 0 ? Math.sign(horizontal) : 1;\n                this.vx = 0;\n                this.vy = 0;\n            }\n            this.charge = Math.min(this.maxCharge, this.charge + dt * this.chargeRate);\n            \n            // Charge particles\n            if (Math.random() < 0.3) {\n                this.chargeParticles.push({\n                    x: this.x + (Math.random() - 0.5) * this.radius * 2,\n                    y: this.y + this.radius + Math.random() * 10,\n                    vx: (Math.random() - 0.5) * 20,\n                    vy: Math.random() * 30 + 20,\n                    life: 0.3,\n                    maxLife: 0.3,\n                    size: Math.random() * 3 + 2,\n                    color: `hsl(${180 + this.charge * 100}, 100%, 60%)`\n                });\n            }\n            \n            // Play charge sound occasionally\n            if (Math.random() < 0.05) {\n                this.game.audio.play('charge', this.charge / this.maxCharge);\n            }\n        } else if (this.isCharging) {\n            this.launch(this.chargeDirection);\n            this.isCharging = false;\n        }\n\n        // Movement\n        if (!this.isCharging) {\n            if (this.onGround) {\n                this.vx += horizontal * this.moveSpeed * dt * 60;\n                this.vx *= Math.pow(this.friction, dt * 60);\n            } else {\n                this.vx += horizontal * this.moveSpeed * this.airControl * dt * 60;\n                this.vx *= Math.pow(this.airFriction, dt * 60);\n            }\n        }\n\n        // Gravity\n        if (!this.onGround || this.isCharging) {\n            this.vy += this.gravity * dt;\n            if (this.vy > this.terminalVelocity) this.vy = this.terminalVelocity;\n        }\n\n        // Update position\n        this.x += this.vx * dt;\n        this.y += this.vy * dt;\n\n        // Level collision\n        this.handleLevelCollision();\n\n        // Trail\n        this.trail.push({ x: this.x, y: this.y, life: 1 });\n        if (this.trail.length > this.maxTrailLength) this.trail.shift();\n        this.trail.forEach(p => p.life -= dt * 3);\n        this.trail = this.trail.filter(p => p.life > 0);\n\n        // Charge particles update\n        this.chargeParticles.forEach(p => {\n            p.x += p.vx * dt;\n            p.y += p.vy * dt;\n            p.vy -= 50 * dt;\n            p.life -= dt;\n        });\n        this.chargeParticles = this.chargeParticles.filter(p => p.life > 0);\n\n        // Visual squash/stretch\n        const targetSquash = this.onGround && !this.isCharging ? 0.7 : 1;\n        const targetStretch = this.onGround && !this.isCharging ? 1.3 : 1;\n        this.squash += (targetSquash - this.squash) * dt * 15;\n        this.stretch += (targetStretch - this.stretch) * dt * 15;\n        \n        // Rotation based on velocity\n        this.rotation += this.vx * dt * 0.02;\n\n        // Invulnerability\n        if (this.invulnerable > 0) this.invulnerable -= dt;\n\n        // Check hazards\n        this.checkHazards();\n    }\n\n    handleLevelCollision() {\n        this.onGround = false;\n        \n        // Platform collisions\n        for (const platform of this.game.level.platforms) {\n            if (this.checkPlatformCollision(platform)) {\n                this.resolvePlatformCollision(platform);\n            }\n        }\n\n        // Wall collisions\n        for (const wall of this.game.level.walls) {\n            this.resolveWallCollision(wall);\n        }\n\n        // Ceiling\n        if (this.y - this.radius < 0) {\n            this.y = this.radius;\n            this.vy = Math.abs(this.vy) * 0.3;\n        }\n\n        // Level bounds\n        if (this.x < this.radius) { this.x = this.radius; this.vx = Math.abs(this.vx) * 0.5; }\n        if (this.x > this.game.level.width - this.radius) { this.x = this.game.level.width - this.radius; this.vx = -Math.abs(this.vx) * 0.5; }\n        if (this.y > this.game.level.height + 100) {\n            this.game.playerDied();\n        }\n    }\n\n    checkPlatformCollision(platform) {\n        const px = this.x;\n        const py = this.y;\n        const pr = this.radius;\n        \n        // Check if player is above platform and moving down\n        if (py + pr > platform.y && py - pr < platform.y && this.vy > 0) {\n            if (px + pr > platform.x && px - pr < platform.x + platform.width) {\n                return true;\n            }\n        }\n        return false;\n    }\n\n    resolvePlatformCollision(platform) {\n        this.y = platform.y - this.radius;\n        \n        if (!this.wasOnGround && this.vy > 5) {\n            this.game.audio.play('land');\n            this.game.addScreenShake(Math.min(this.vy * 0.1, 5));\n            this.game.registerBounce();\n            \n            // Bounce particles\n            for (let i = 0; i < 8; i++) {\n                this.game.level.particles.push(new PARTICLES.Dust(\n                    this.x + (Math.random() - 0.5) * this.radius * 2,\n                    this.y + this.radius,\n                    (Math.random() - 0.5) * 100,\n                    -Math.random() * 100 - 50\n                ));\n            }\n        }\n        \n        this.vy = 0;\n        this.onGround = true;\n    }\n\n    resolveWallCollision(wall) {\n        const px = this.x;\n        const py = this.y;\n        const pr = this.radius;\n        \n        // Left wall\n        if (px + pr > wall.x && px - pr < wall.x && py + pr > wall.y && py - pr < wall.y + wall.height) {\n            this.x = wall.x - pr;\n            if (this.vx > 0) {\n                this.vx *= -0.3;\n                this.game.audio.play('bounce');\n            }\n            // Wall slide\n            if (!this.onGround && this.vy > this.wallSlideSpeed) {\n                this.vy = this.wallSlideSpeed;\n            }\n        }\n        \n        // Right wall\n        if (px - pr < wall.x + wall.width && px + pr > wall.x + wall.width && py + pr > wall.y && py - pr < wall.y + wall.height) {\n            this.x = wall.x + wall.width + pr;\n            if (this.vx < 0) {\n                this.vx *= -0.3;\n                this.game.audio.play('bounce');\n            }\n            if (!this.onGround && this.vy > this.wallSlideSpeed) {\n                this.vy = this.wallSlideSpeed;\n            }\n        }\n    }\n\n    launch(direction) {\n        const power = this.minLaunchPower + (this.launchPower - this.minLaunchPower) * (this.charge / this.maxCharge);\n        const angle = direction < 0 ? Math.PI * 0.75 : Math.PI * 0.25; // 135° or 45°\n        \n        this.vx = Math.cos(angle) * power * direction;\n        this.vy = Math.sin(angle) * power * -1;\n        \n        this.game.audio.play('launch');\n        this.game.addScreenShake(3 + this.charge * 2);\n        \n        // Launch particles\n        for (let i = 0; i < 15; i++) {\n            const a = angle + (Math.random() - 0.5) * 0.5;\n            const s = Math.random() * 50 + 50;\n            this.game.level.particles.push(new PARTICLES.Launch(\n                this.x, this.y,\n                Math.cos(a) * s * direction,\n                Math.sin(a) * s\n            ));\n        }\n    }\n\n    checkHazards() {\n        if (this.invulnerable > 0) return;\n        \n        for (const hazard of this.game.level.hazards) {\n            const dx = this.x - hazard.x;\n            const dy = this.y - hazard.y;\n            const dist = Math.sqrt(dx * dx + dy * dy);\n            \n            if (dist < this.radius + hazard.radius) {\n                this.game.playerDied();\n                break;\n            }\n        }\n    }\n\n    checkGearCollection() {\n        for (let i = this.game.level.gears.length - 1; i >= 0; i--) {\n            const gear = this.game.level.gears[i];\n            if (!gear.collected) {\n                const dx = this.x - gear.x;\n                const dy = this.y - gear.y;\n                const dist = Math.sqrt(dx * dx + dy * dy);\n                \n                if (dist < this.radius + gear.radius) {\n                    gear.collected = true;\n                    this.game.collectGear();\n                    \n                    // Collection particles\n                    for (let j = 0; j < 12; j++) {\n                        this.game.level.particles.push(new PARTICLES.GearCollect(\n                            gear.x, gear.y\n                        ));\n                    }\n                }\n            }\n        }\n    }\n\n    checkWin() {\n        const goal = this.game.level.goal;\n        if (goal) {\n            const dx = this.x - goal.x;\n            const dy = this.y - goal.y;\n            const dist = Math.sqrt(dx * dx + dy * dy);\n            \n            if (dist < this.radius + goal.radius) {\n                this.game.playerWon();\n            }\n        }\n    }\n\n    render(renderer) {\n        const ctx = renderer.ctx;\n        \n        // Trail\n        this.trail.forEach((p, i) => {\n            ctx.globalAlpha = p.life * 0.3;\n            ctx.fillStyle = this.color;\n            ctx.beginPath();\n            ctx.arc(p.x - renderer.cameraX, p.y - renderer.cameraY, this.radius * p.life * this.squash, 0, Math.PI * 2);\n            ctx.fill();\n        });\n        ctx.globalAlpha = 1;\n\n        // Charge particles\n        this.chargeParticles.forEach(p => {\n            ctx.globalAlpha = p.life / p.maxLife;\n            ctx.fillStyle = p.color;\n            ctx.beginPath();\n            ctx.arc(p.x - renderer.cameraX, p.y - renderer.cameraY, p.size, 0, Math.PI * 2);\n            ctx.fill();\n        });\n        ctx.globalAlpha = 1;\n\n        // Player body\n        ctx.save();\n        ctx.translate(this.x - renderer.cameraX, this.y - renderer.cameraY);\n        ctx.rotate(this.rotation);\n        ctx.scale(this.squash, this.stretch);\n        \n        // Glow\n        if (this.isCharging) {\n            const gradient = ctx.createRadialGradient(0, 0, 0, 0, 0, this.radius * 2);\n            gradient.addColorStop(0, `hsla(${180 + this.charge * 100}, 100%, 60%, 0.4)`);\n            gradient.addColorStop(1, 'hsla(180, 100%, 60%, 0)');\n            ctx.fillStyle = gradient;\n            ctx.beginPath();\n            ctx.arc(0, 0, this.radius * 2.5, 0, Math.PI * 2);\n            ctx.fill();\n        }\n\n        // Main body\n        const bodyGradient = ctx.createRadialGradient(-4, -4, 0, 0, 0, this.radius);\n        bodyGradient.addColorStop(0, '#ffffff');\n        bodyGradient.addColorStop(0.3, this.color);\n        bodyGradient.addColorStop(1, '#0066cc');\n        ctx.fillStyle = bodyGradient;\n        ctx.beginPath();\n        ctx.arc(0, 0, this.radius, 0, Math.PI * 2);\n        ctx.fill();\n\n        // Inner core\n        ctx.fillStyle = '#00ffff';\n        ctx.beginPath();\n        ctx.arc(0, 0, this.radius * 0.4, 0, Math.PI * 2);\n        ctx.fill();\n\n        // Charge indicator\n        if (this.isCharging) {\n            ctx.strokeStyle = '#fff';\n            ctx.lineWidth = 3;\n            ctx.beginPath();\n            ctx.arc(0, 0, this.radius + 5, -Math.PI / 2, -Math.PI / 2 + (this.charge / this.maxCharge) * Math.PI * 2);\n            ctx.stroke();\n        }\n\n        // Direction indicator when charging\n        if (this.isCharging) {\n            ctx.fillStyle = '#fff';\n            ctx.beginPath();\n            const dir = this.chargeDirection;\n            ctx.moveTo(dir * (this.radius + 10), -5);\n            ctx.lineTo(dir * (this.radius + 20), 0);\n            ctx.lineTo(dir * (this.radius + 10), 5);\n            ctx.fill();\n        }\n\n        ctx.restore();\n\n        // Invulnerability flash\n        if (this.invulnerable > 0 && Math.floor(this.invulnerable * 10) % 2 === 0) {\n            ctx.globalAlpha = 0.5;\n            ctx.drawImage(renderer.ctx.canvas, 0, 0);\n            ctx.globalAlpha = 1;\n        }\n    }\n}",
  "src/level/Level.js": "import { PARTICLES } from '../core/Particles.js';\n\nexport class Level {\n    constructor(data, game) {\n        this.game = game;\n        this.width = data.width;\n        this.height = data.height;\n        this.spawnX = data.spawnX;\n        this.spawnY = data.spawnY;\n        \n        this.platforms = data.platforms.map(p => ({ ...p }));\n        this.walls = data.walls.map(w => ({ ...w }));\n        this.hazards = data.hazards.map(h => ({ ...h, time: 0 }));\n        this.gears = data.gears.map(g => ({ ...g, collected: false, bobOffset: Math.random() * Math.PI * 2, rotation: 0 }));\n        this.goal = data.goal ? { ...data.goal, pulse: 0 } : null;\n        \n        this.particles = [];\n        \n        this.backgroundElements = this.generateBackground();\n    }\n\n    generateBackground() {\n        const elements = [];\n        const cols = Math.ceil(this.width / 200);\n        const rows = Math.ceil(this.height / 200);\n        \n        for (let i = 0; i < cols * rows; i++) {\n            elements.push({\n                x: Math.random() * this.width,\n                y: Math.random() * this.height,\n                size: Math.random() * 3 + 1,\n                alpha: Math.random() * 0.3 + 0.1,\n                speed: Math.random() * 0.5 + 0.1,\n                angle: Math.random() * Math.PI * 2\n            });\n        }\n        return elements;\n    }\n\n    update(dt) {\n        // Update hazards\n        this.hazards.forEach(h => {\n            h.time += dt;\n            if (h.type === 'orbiter') {\n                h.x = h.centerX + Math.cos(h.time * h.speed + h.offset) * h.radius;\n                h.y = h.centerY + Math.sin(h.time * h.speed + h.offset) * h.radius;\n            } else if (h.type === 'patrol') {\n                const t = (Math.sin(h.time * h.speed) + 1) / 2;\n                h.x = h.startX + (h.endX - h.startX) * t;\n                h.y = h.startY + (h.endY - h.startY) * t;\n            }\n        });\n\n        // Update gears\n        this.gears.forEach(g => {\n            if (!g.collected) {\n                g.bobOffset += dt * 3;\n                g.rotation += dt * 2;\n                g.y = g.baseY + Math.sin(g.bobOffset) * 5;\n            }\n        });\n\n        // Update goal\n        if (this.goal) {\n            this.goal.pulse += dt * 5;\n        }\n\n        // Update particles\n        this.particles.forEach(p => p.update(dt));\n        this.particles = this.particles.filter(p => p.life > 0);\n\n        // Update background\n        this.backgroundElements.forEach(el => {\n            el.y += el.speed * 10 * dt;\n            if (el.y > this.height) el.y = 0;\n        });\n    }\n\n    render(renderer) {\n        const ctx = renderer.ctx;\n        \n        // Background elements\n        ctx.fillStyle = '#2a2a4e';\n        this.backgroundElements.forEach(el => {\n            ctx.globalAlpha = el.alpha;\n            ctx.beginPath();\n            ctx.arc(el.x - renderer.cameraX, el.y - renderer.cameraY, el.size, 0, Math.PI * 2);\n            ctx.fill();\n        });\n        ctx.globalAlpha = 1;\n\n        // Platforms\n        this.platforms.forEach(p => {\n            const gradient = ctx.createLinearGradient(0, p.y - renderer.cameraY, 0, p.y + p.height - renderer.cameraY);\n            gradient.addColorStop(0, '#2a2a4e');\n            gradient.addColorStop(1, '#1a1a3e');\n            ctx.fillStyle = gradient;\n            ctx.fillRect(p.x - renderer.cameraX, p.y - renderer.cameraY, p.width, p.height);\n            \n            // Top highlight\n            ctx.fillStyle = '#3a3a5e';\n            ctx.fillRect(p.x - renderer.cameraX, p.y - renderer.cameraY, p.width, 3);\n            \n            // Edge glow\n            ctx.strokeStyle = '#00f2ff44';\n            ctx.lineWidth = 2;\n            ctx.strokeRect(p.x - renderer.cameraX, p.y - renderer.cameraY, p.width, p.height);\n        });\n\n        // Walls\n        this.walls.forEach(w => {\n            const gradient = ctx.createLinearGradient(w.x - renderer.cameraX, 0, w.x + w.width - renderer.cameraX, 0);\n            gradient.addColorStop(0, '#2a2a4e');\n            gradient.addColorStop(0.5, '#3a3a5e');\n            gradient.addColorStop(1, '#2a2a4e');\n            ctx.fillStyle = gradient;\n            ctx.fillRect(w.x - renderer.cameraX, w.y - renderer.cameraY, w.width, w.height);\n            \n            ctx.strokeStyle = '#00f2ff44';\n            ctx.lineWidth = 2;\n            ctx.strokeRect(w.x - renderer.cameraX, w.y - renderer.cameraY, w.width, w.height);\n        });\n\n        // Hazards\n        this.hazards.forEach(h => {\n            ctx.save();\n            ctx.translate(h.x - renderer.cameraX, h.y - renderer.cameraY);\n            ctx.rotate(h.time * 2);\n            \n            const grad = ctx.createRadialGradient(0, 0, 0, 0, 0, h.radius);\n            grad.addColorStop(0, '#ff3131');\n            grad.addColorStop(0.5, '#ff0000');\n            grad.addColorStop(1, '#8b0000');\n            ctx.fillStyle = grad;\n            \n            // Spiky circle\n            ctx.beginPath();\n            const spikes = 8;\n            for (let i = 0; i < spikes; i++) {\n                const angle = (i / spikes) * Math.PI * 2;\n                const r = i % 2 === 0 ? h.radius : h.radius * 0.6;\n                ctx.lineTo(Math.cos(angle) * r, Math.sin(angle) * r);\n            }\n            ctx.closePath();\n            ctx.fill();\n            \n            // Inner glow\n            ctx.fillStyle = '#ff6b6b';\n            ctx.beginPath();\n            ctx.arc(0, 0, h.radius * 0.4, 0, Math.PI * 2);\n            ctx.fill();\n            \n            ctx.restore();\n        });\n\n        // Gears\n        this.gears.forEach(g => {\n            if (!g.collected) {\n                ctx.save();\n                ctx.translate(g.x - renderer.cameraX, g.y - renderer.cameraY);\n                ctx.rotate(g.rotation);\n                \n                // Glow\n                const glowGrad = ctx.createRadialGradient(0, 0, 0, 0, 0, g.radius * 2);\n                glowGrad.addColorStop(0, 'rgba(255, 215, 0, 0.3)');\n                glowGrad.addColorStop(1, 'rgba(255, 215, 0, 0)');\n                ctx.fillStyle = glowGrad;\n                ctx.beginPath();\n                ctx.arc(0, 0, g.radius * 2, 0, Math.PI * 2);\n                ctx.fill();\n\n                // Gear body\n                const gearGrad = ctx.createLinearGradient(-g.radius, -g.radius, g.radius, g.radius);\n                gearGrad.addColorStop(0, '#ffd700');\n                gearGrad.addColorStop(0.5, '#ffaa00');\n                gearGrad.addColorStop(1, '#cc8800');\n                ctx.fillStyle = gearGrad;\n                ctx.strokeStyle = '#b8860b';\n                ctx.lineWidth = 2;\n                \n                ctx.beginPath();\n                const teeth = 8;\n                for (let i = 0; i < teeth * 2; i++) {\n                    const angle = (i / (teeth * 2)) * Math.PI * 2;\n                    const r = i % 2 === 0 ? g.radius : g.radius * 0.6;\n                    ctx.lineTo(Math.cos(angle) * r, Math.sin(angle) * r);\n                }\n                ctx.closePath();\n                ctx.fill();\n                ctx.stroke();\n\n                // Center hole\n                ctx.fillStyle = '#1a1a2e';\n                ctx.beginPath();\n                ctx.arc(0, 0, g.radius * 0.3, 0, Math.PI * 2);\n                ctx.fill();\n                \n                ctx.restore();\n            }\n        });\n\n        // Goal\n        if (this.goal) {\n            ctx.save();\n            ctx.translate(this.goal.x - renderer.cameraX, this.goal.y - renderer.cameraY);\n            \n            // Pulsing rings\n            for (let i = 0; i < 3; i++) {\n                const r = this.goal.radius + Math.sin(this.goal.pulse + i * 2) * 10 + i * 15;\n                ctx.strokeStyle = `rgba(0, 242, 255, ${0.3 - i * 0.1})`;\n                ctx.lineWidth = 2;\n                ctx.beginPath();\n                ctx.arc(0, 0, r, 0, Math.PI * 2);\n                ctx.stroke();\n            }\n\n            // Anchor symbol\n            ctx.fillStyle = '#00f2ff';\n            ctx.strokeStyle = '#fff';\n            ctx.lineWidth = 3;\n            \n            // Ring\n            ctx.beginPath();\n            ctx.arc(0, -5, this.goal.radius * 0.6, 0, Math.PI * 2);\n            ctx.stroke();\n            ctx.fill();\n\n            // Shank\n            ctx.beginPath();\n            ctx.moveTo(0, -5 + this.goal.radius * 0.6);\n            ctx.lineTo(0, 15);\n            ctx.stroke();\n\n            // Flukes\n            ctx.beginPath();\n            ctx.moveTo(-12, 15);\n            ctx.lineTo(0, 25);\n            ctx.lineTo(12, 15);\n            ctx.closePath();\n            ctx.fill();\n            ctx.stroke();\n\n            ctx.restore();\n        }\n\n        // Particles\n        this.particles.forEach(p => p.render(renderer));\n    }\n\n    addParticle(particle) {\n        this.particles.push(particle);\n    }\n}",
  "src/levels/levelData.js": "export const LEVELS = [\n    // Level 1: Tutorial\n    {\n        width: 1280,\n        height: 2000,\n        spawnX: 640,\n        spawnY: 1800,\n        platforms: [\n            { x: 0, y: 1900, width: 1280, height: 100 },\n            { x: 200, y: 1600, width: 200, height: 20 },\n            { x: 600, y: 1400, width: 300, height: 20 },\n            { x: 1000, y: 1200, width: 200, height: 20 },\n            { x: 400