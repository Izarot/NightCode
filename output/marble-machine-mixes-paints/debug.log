      position: absolute;\n            inset: 0;\n            overflow: hidden;\n        }\n        \n        .match-badge {\n            position: absolute;\n            top: 10px;\n            left: 50%;\n            transform: translateX(-50%);\n            padding: 6px 16px;\n            border-radius: 20px;\n            font-size: 14px;\n            font-weight: bold;\n            text-align: center;\n        }\n        \n        .star-badge {\n            display: flex;\n            gap: 4px;\n            margin-top: 4px;\n        }\n        .star {\n            width: 24px;\n            height: 24px;\n            border-radius: 50%;\n            color: #ffd700;\n            box-shadow: 0 0 8px rgba(255,213,0,0.5);\n        }\n        \n        /* Result Overlay */\n        .result-overlay {\n            position: absolute;\n            inset: 0;\n            background: rgba(0,0,0,0.6);\n            display: flex;\n            flex-direction: column;\n            align-items: center;\n            justify-content: center;\n            z-index: 100;\n            opacity: 0;\n            pointer-events: none;\n            transition: opacity 0.3s;\n        }\n        \n        .result-overlay.active {\n            opacity: 1;\n            pointer-events: auto;\n        }\n        \n        .result-title {\n            font-size: 32px;\n            font-weight: bold;\n            color: #3b2a1a;\n            margin-bottom: 16px;\n        }\n        \n        .comparison-circles {\n            display: flex;\n            gap: 40px;\n            margin: 20px 0;\n        }\n        \n        .comp-circle {\n            width: 80px;\n            height: 80px;\n            border-radius: 50%;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            font-size: 40px;\n            color: #fff;\n        }\n        \n        .stars-container {\n            display: flex;\n            gap: 8px;\n            margin: 16px 0;\n        }\n        .star {\n            width: 24px;\n            height: 24px;\n            border-radius: 50%;\n            color: #ffd700;\n            box-shadow: 0 0 12px rgba(255,213,0,0.6);\n            animation: popIn 0.3s ease-out;\n        }\n        @keyframes popIn {\n            0% { transform: scale(0); opacity: 0; }\n            50% { transform: scale(1.2); }\n            100% { transform: scale(1); opacity: 1; }\n        }\n        \n        .retry-btn, .next-btn {\n            padding: 12px 24px;\n            border: none;\n            border-radius: 6px;\n            font-size: 16px;\n            font-weight: 600;\n            cursor: pointer;\n            transition: all 0.2s;\n        }\n        \n        .retry-btn {\n            background: #ffb74d;\n            color: #333;\n        }\n        .next-btn {\n            background: #4caf50;\n            color: #fff;\n        }\n        \n        /* Responsive adjustments for mobile */\n        @media (max-width: 768px) {\n            #game-container {\n                width: 95vw;\n                height: 90vh;\n            }\n            .speedrun-timer {\n                top: 10px;\n                right: 10px;\n                left: 10px;\n            }\n            .hud {\n                top: 10px;\n                left: 10px;\n                right: 10px;\n            }\n            .parts-tray {\n                left: 10px;\n                top: 520px;\n                width: 140px;\n            }\n            .color-selector {\n                right: 10px;\n                top: 560px;\n            }\n            .color-btn {\n                width: 40px;\n                height: 40px;\n            }\n            .queuen-preview {\n                gap: 2px;\n            }\n        }\n    </style>\n</head>\n<body>\n    <div id=\"game-container\">\n        <canvas id=\"canvas\"></canvas>\n        <div class=\"speedrun-timer\">\n            <span class=\"timer-value\" id=\"timer\">00:00</span>\n        </div>\n        \n        <!-- HUD -->\n        <div class=\"hud\">\n            <div class=\"top-bar\">\n                <span class=\"level-label\" id=\"level-label\">Level 1</span>\n                \n                <div class=\"target-preview\" id=\"target-preview\">⚪</div>\n                \n                <div class=\"marble-counter\">\n                    <span>Marbles:</span>\n                    <div class=\"marble-circle marble-filled\" id=\"marble-remaining\" style=\"display:none;\">●●●●●●●●●●●●●●●●</div>\n                    <span>Remaining</span>\n                    <div class=\"marble-circle marble-empty\" id=\"marble-used\" style=\"display:none;\">○○○○○○○○○○○○○○○○</div>\n                </div>\n                \n                <span class=\"score-display\" id=\"score-display\">Score: 0</span>\n                \n                <div class=\"buttons\">\n                    <button class=\"btn btn-run\" id=\"run-btn\">▶ RUN</button>\n                    <button class=\"btn btn-reset\" id=\"reset-btn\">↺ RESET</button>\n                    <button class=\"btn btn-menu\" id=\"menu-btn\">Menu</button>\n                </div>\n            </div>\n            \n            <!-- Parts Tray -->\n            <div class=\"parts-tray\" id=\"parts-tray\">\n                <div class=\"part-list\" id=\"part-list\">\n                    <!-- Populated by JS -->\n                </div>\n            </div>\n            \n            <!-- Color Selector -->\n            <div class=\"color-selector\" id=\"color-selector\">\n                <div class=\"queue-preview\" id=\"queue-preview\"></div>\n                <div class=\"color-buttons\">\n                    <div class=\"color-btn active\" data-color=\"red\" title=\"Red (255,0,0)\">🔴 Red</div>\n                    <div class=\"color-btn\" data-color=\"blue\" title=\"Blue (0,0,255)\">🔵 Blue</div>\n                    <div class=\"color-btn\" data-color=\"yellow\" title=\"Yellow (255,255,0)\">🟡 Yellow</div>\n                    <div class=\"color-btn\" data-color=\"white\" title=\"White (255,255,255)\">⚪ White</div>\n                    <div class=\"color-btn\" data-color=\"black\" title=\"Black (0,0,0)\">⚫ Black</div>\n                </div>\n            </div>\n            \n            <!-- Vat Zone -->\n            <div class=\"vat-zone\" id=\"vat-zone\">\n                <div class=\"swirl-container\" id=\"swirl-container\"></div>\n                <div class=\"match-badge\" id=\"match-badge\">Match: 0%</div>\n                <div class=\"star-badge\" id=\"star-badges\"></div>\n            </div>\n        </div>\n        \n        <!-- Result Overlay -->\n        <div class=\"result-overlay\" id=\"result-overlay\">\n            <div class=\"result-title\" id=\"result-title\">Level Complete!</div>\n            <div class=\"comparison-circles\">\n                <div class=\"comp-circle\" id=\"your-circle\">Your</div>\n                <div class=\"comp-circle\" id=\"target-circle\">Target</div>\n            </div>\n            <div class=\"match-percent\" id=\"match-percent\">Match: 0%</div>\n            <div class=\"stars-container\" id=\"stars-container\"></div>\n            <div class=\"score\" id=\"final-score\">Score: 0</div>\n            <div class=\"retry-btn\" id=\"retry-btn\">Retry</div>\n            <div class=\"next-btn\" id=\"next-btn\">Next Level</div>\n        </div>\n    </div>\n\n    <script src=\"audio.js\"></audio.js>\n    <script src=\"engine.js\"></script>\n    <script src=\"main.js\"></script>\n</body>\n</html>\n