function update(dt) {
  // Paint meter
  const moving = car.speed > 0.1;
  if (moving) {
    paintMeter = Math.max(0, paintMeter - paintDepletion * dt);
    const distance = car.speed * dt; // meters
    paintMeter = Math.max(0, paintMeter - (distance * paintConsumption) * dt);
  } else {
    paintMeter = Math.min(100, paintMeter + paintRefill * dt);
  }

  // Car physics
  let accel = 0;
  if (keys['w'] || keys['ArrowUp']) accel += 1;
  if (keys['s'] || keys['ArrowDown']) accel -= 1;
  // Apply friction
  accel *= car.friction;
  // Apply acceleration / braking
  if (accel < 0) {
    car.speed = Math.max(0, car.speed + accel * dt);
  } else {
    car.speed = Math.min(car.maxSpeed, car.speed + accel * dt);
  }

  // Drift handling
  const lateralSpeed = Math.abs(car.vel.x) + Math.abs(car.vel.y);
  if (lateralSpeed > car.driftThreshold) {
    car.driftSpeed += dt;
    car.turnRate *= 1.3;
    car.speed *= 0.8;
  } else {
    car.driftSpeed = 0;
    car.turnRate = 2.5;
  }

  // Update angle based on steering
  if (keys['a'] || keys['ArrowLeft']) car.angle -= car.turnRate * dt;
  if (keys['d'] || keys['ArrowRight']) car.angle += car.turnRate * dt;
  // wrap angle
  car.angle = (car.angle + Math.PI * 2) % (Math.PI * 2);

  // Update velocity and position
  const rad = car.angle;
  car.vel.x = Math.cos(rad) * car.speed;
  car.vel.y = Math.sin(rad) * car.speed;
  car.pos.x += car.vel.x * dt;
  car.pos.y += car.vel.y * dt;

  // Wrap around screen edges (optional)
  if (car.pos.x < 0) car.pos.x += canvas.width;
  if (car.pos.x > canvas.width) car.pos.x -= canvas.width;
  if (car.pos.y < 0) car.pos.y += canvas.height;
  if (car.pos.y > canvas.height) car.pos.y -= canvas.height;

  // Trail
  if (moving) {
    trail.push({x: car.pos.x, y: car.pos.y, color: paintTypes[selectedPaint].color, width: paintTypes[selectedPaint].width});
    if (trail.length > 500) trail.shift();
  }

  // Allies
  for (let a of allies) {
    // Move toward goal
    const dx = goal.x - a.pos.x;
    const dy = goal.y - a.pos.y;
    const dist = Math.hypot(dx, dy);
    if (dist > 0.5) {
      const speed = a.baseSpeed * (a.onTrail ? 1.15 : 1);
      const angle = Math.atan2(dy, dx);
      a.vel.x = Math.cos(angle) * speed;
      a.vel.y = Math.sin(angle) * speed;
      a.pos.x += a.vel.x * dt;
      a.pos.y += a.vel.y * dt;
    }

    // Check trail proximity
    a.onTrail = false;
    for (let i=0; i<trail.length-1; i++) {
      const p1 = trail[i];
      const p2 = trail[i+1];
      if (distToSegment(a.pos, p1, p2) < 2) {
        a.onTrail = true;
        break;
      }
    }
    if (a.onTrail && a.buffTimer == null) {
      a.buffTimer = 3; // seconds
      playBeep(1.5);
    }
    if (a.buffTimer) {
      a.buffTimer -= dt;
      if (a.buffTimer <= 0) a.buffTimer = null;
    }
  }

  // Timer UI
  if (!startTime) startTime = performance.now();
  const elapsed = (performance.now() - startTime) / 1000;
  timerCtx.clearRect(0,0,timerCanvas.width,timerCanvas.height);
  timerCtx.fillStyle = '#fff';
  timerCtx.font = '24px sans-serif';
  timerCtx.fillText(`Time: ${elapsed.toFixed(2)}s`, 10, 30);

  // Win condition
  const carToGoal = Math.hypot(car.pos.x - goal.x, car.pos.y - goal.y);
  if (carToGoal < 30) {
    gameRunning = false;
    const finalTime = elapsed;
    if (finalTime < highScore) {
      highScore = finalTime;
      localStorage.setItem('highScore', highScore);
    }
    ctx.fillStyle = '#fff';
    ctx.font = '48px sans-serif';
    ctx.fillText('Level Complete!', canvas.width/2-120, canvas.height/2);
    ctx.fillText(`Best Time: ${highScore.toFixed(2)}s`, canvas.width/2-150, canvas.height/2+30);
    playBeep(2);
  }

  // Rendering
  ctx.clearRect(0,0,canvas.width,canvas.height);
  // draw trail
  ctx.lineWidth = 4;
  for (let i=0; i<trail.length-1; i++) {
    const p1 = trail[i];
    const p2 = trail[i+1];
    ctx.strokeStyle = paintTypes[selectedPaint].color;
    ctx.globalAlpha = 0.4;
    ctx.beginPath();
    ctx.moveTo(p1.x, p1.y);
    ctx.lineTo(p2.x, p2.y);
    ctx.stroke();
    ctx.globalAlpha = 1;
  }

