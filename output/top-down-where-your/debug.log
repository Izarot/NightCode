  "index.html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<title>Paint‑Trail Rally</title>\n<link rel=\"stylesheet\" href=\"style.css\">\n<link rel=\"icon\" href=\"data:image/svg+xml,%3Csvg%20xmlns=%22http://www.w3.org/2000/svg%22%20viewBox=%220%200%20100%20100%22%3E%3Ctext%20y=%22.9em%22%20font-size=%2280%22%3E%F0%9F%9A%81%3C/text%3E%3C/svg%3E\">\n</head>\n<body>\n<div id=\"gameContainer\">\n<canvas id=\"gameCanvas\"></canvas>\n</div>\n<div id=\"ui\">\n<canvas id=\"timerCanvas\" class=\"timer\"></canvas>\n</div>\n<script src=\"game.js\"></script>\n</body>\n</html>",
  "style.css": "body { margin:0; background:#0d0d0d; color:#fff; font-family:sans-serif; }\n#gameContainer { position:relative; width:100%; max-width:1280px; margin:auto; }\n#gameCanvas { width:100%; height:100%; display:block; }\n#timerCanvas { position:absolute; top:10px; left:10px; pointer-events:none; }",
  "game.js": "const canvas = document.getElementById('gameCanvas');\nconst ctx = canvas.getContext('2d');\nconst container = document.getElementById('gameContainer');\nconst timerCanvas = document.getElementById('timerCanvas');\nconst timerCtx = timerCanvas.getContext('2d');\n\nfunction resizeCanvas() {\n  const dpr = window.devicePixelRatio || 1;\n  const rect = container.getBoundingClientRect();\n  canvas.width = rect.width * dpr;\n  canvas.height = rect.height * dpr;\n  ctx.scale(dpr, dpr);\n  timerCanvas.width = rect.width * dpr;\n  timerCanvas.height = rect.height * dpr;\n  timerCtx.scale(dpr, dpr);\n}\nwindow.addEventListener('resize', resizeCanvas);\nresizeCanvas();\n\nconst paintTypes = {\n  red: {color:'#FF3B30', width:0.5, safety:80},\n  blue:'#3B82F6', width:0.7, safety:70},\n  green:'#10B981', width:0.6, safety:75},\n  yellow:'#FBBF24', width:0.55, safety:85}\nlet selectedPaint = 'red';\n\nlet paintMeter = 100;\nconst paintDepletion = 0.5; // %/s while moving\nconst paintRefill = 1; // %/s idle\nconst paintConsumption = 0.1; // % per meter\n\nlet trail = [];\nlet car = {\n  pos: {x: 640, y: 360},\n  vel: {x:0, y:0},\n  angle: 0,\n  speed: 0,\n  maxSpeed: 8,\n  accel: 12,\n  brakeDecel: 18,\n  turnRate: 2.5,\n  driftThreshold: 3,\n  driftCoeff: 0.4,\n  friction: 0.6,\n  driftSpeed: 0\n};\nlet keys = {};\nlet allies = [];\nlet goal = {x: 100, y: 50};\nlet startTime = null;\nlet gameRunning = true;\nlet highScore = parseFloat(localStorage.getItem('highScore')) || 0;\n\n// Input handling\nwindow.addEventListener('keydown', e => { keys[e.key] = true; });\nwindow.addEventListener('keyup', e => { keys[e.key] = false; });\n\n// Sound\nconst audioCtx = new (window.AudioContext || window.webkitAudioContext)();\nfunction playBeep(pitch, duration=0.1) {\n  const osc = audioCtx.createOscillator();\n  const gain = audioCtx.createGain();\n  osc.frequency.value = pitch;\n  gain.gain.value = 0.2;\n  osc.connect(gain).connect(audioCtx.destination);\n  gain.connect(audioCtx.destination);\n  osc.start();\n  gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + duration);\n  osc.stop(audioCtx.currentTime + duration);\n}\n\n// Utility: distance from point to line segment\nfunction distToSegment(pt, a, b) {\n  const dx = b.x - a.x;\n  const dy = b.y - a.y;\n  const len2 = dx*dx + dy*dy;\n  if (len2 === 0) return Math.hypot(pt.x - a.x, pt.y - a.y);\n  let t = ((pt.x - a.x) * dx + (pt.y - a.y) * dy) / len2;\n  t = Math.max(0, Math.min(1, t));\n  const projX = a.x + t * dx;\n  const projY = a.y + t * dy;\n  return Math.hypot(pt.x - projX, pt.y - projY);\n}\n\n// Game loop\nlet lastTime = performance.now();\nfunction update(dt) {\n  // Paint meter\n  const moving = car.speed > 0.1;\n  if (moving) {\n    paintMeter = Math.max(0, paintMeter - paintDepletion * dt);\n    const distance = car.speed * dt; // meters\n    paintMeter = Math.max(0, paintMeter - (distance * paintConsumption) * dt);\n  } else {\n    paintMeter = Math.min(100, paintMeter + paintRefill * dt);\n  }\n\n  // Car physics\n  let accel = 0;\n  if (keys['w'] || keys['ArrowUp']) accel += 1;\n  if (keys['s'] || keys['ArrowDown']) accel -= 1;\n  // Apply friction\n  accel *= car.friction;\n  // Apply acceleration / braking\n  if (accel < 0) {\n    car.speed = Math.max(0, car.speed + accel * dt);\n  } else {\n    car.speed = Math.min(car.maxSpeed, car.speed + accel * dt);\n  }\n\n  // Drift handling\n  const lateralSpeed = Math.abs(car.vel.x) + Math.abs(car.vel.y);\n  if (lateralSpeed > car.driftThreshold) {\n    car.driftSpeed += dt;\n    car.turnRate *= 1.3;\n    car.speed *= 0.8;\n  } else {\n    car.driftSpeed = 0;\n    car.turnRate = 2.5;\n  }\n\n  // Update angle based on steering\n  if (keys['a'] || keys['ArrowLeft']) car.angle -= car.turnRate * dt;\n  if (keys['d'] || keys['ArrowRight']) car.angle += car.turnRate * dt;\n  // wrap angle\n  car.angle = (car.angle + Math.PI * 2) % (Math.PI * 2);\n\n  // Update velocity and position\n  const rad = car.angle;\n  car.vel.x = Math.cos(rad) * car.speed;\n  car.vel.y = Math.sin(rad) * car.speed;\n  car.pos.x += car.vel.x * dt;\n  car.pos.y += car.vel.y * dt;\n\n  // Wrap around screen edges (optional)\n  if (car.pos.x < 0) car.pos.x += canvas.width;\n  if (car.pos.x > canvas.width) car.pos.x -= canvas.width;\n  if (car.pos.y < 0) car.pos.y += canvas.height;\n  if (car.pos.y > canvas.height) car.pos.y -= canvas.height;\n\n  // Trail\n  if (moving) {\n    trail.push({x: car.pos.x, y: car.pos.y, color: paintTypes[selectedPaint].color, width: paintTypes[selectedPaint].width});\n    if (trail.length > 500) trail.shift();\n  }\n\n  // Allies\n  for (let a of allies) {\n    // Move toward goal\n    const dx = goal.x - a.pos.x;\n    const dy = goal.y - a.pos.y;\n    const dist = Math.hypot(dx, dy);\n    if (dist > 0.5) {\n      const speed = a.baseSpeed * (a.onTrail ? 1.15 : 1);\n      const angle = Math.atan2(dy, dx);\n      a.vel.x = Math.cos(angle) * speed;\n      a.vel.y = Math.sin(angle) * speed;\n      a.pos.x += a.vel.x * dt;\n      a.pos.y += a.vel.y * dt;\n    }\n\n    // Check trail proximity\n    a.onTrail = false;\n    for (let i=0; i<trail.length-1; i++) {\n      const p1 = trail[i];\n      const p2 = trail[i+1];\n      if (distToSegment(a.pos, p1, p2) < 2) {\n        a.onTrail = true;\n        break;\n      }\n    }\n    if (a.onTrail && a.buffTimer == null) {\n      a.buffTimer = 3; // seconds\n      playBeep(1.5);\n    }\n    if (a.buffTimer) {\n      a.buffTimer -= dt;\n      if (a.buffTimer <= 0) a.buffTimer = null;\n    }\n  }\n\n  // Timer UI\n  if (!startTime) startTime = performance.now();\n  const elapsed = (performance.now() - startTime) / 1000;\n  timerCtx.clearRect(0,0,timerCanvas.width,timerCanvas.height);\n  timerCtx.fillStyle = '#fff';\n  timerCtx.font = '24px sans-serif';\n  timerCtx.fillText(`Time: ${elapsed.toFixed(2)}s`, 10, 30);\n\n  // Win condition\n  const carToGoal = Math.hypot(car.pos.x - goal.x, car.pos.y - goal.y);\n  if (carToGoal < 30) {\n    gameRunning = false;\n    const finalTime = elapsed;\n    if (finalTime < highScore) {\n      highScore = finalTime;\n      localStorage.setItem('highScore', highScore);\n    }\n    ctx.fillStyle = '#fff';\n    ctx.font = '48px sans-serif';\n    ctx.fillText('Level Complete!', canvas.width/2-120, canvas.height/2);\n    ctx.fillText(`Best Time: ${highScore.toFixed(2)}s`, canvas.width/2-150, canvas.height/2+30);\n    playBeep(2);\n  }\n\n  // Rendering\n  ctx.clearRect(0,0,canvas.width,canvas.height);\n  // draw trail\n  ctx.lineWidth = 4;\n  for (let i=0; i<trail.length-1; i++) {\n    const p1 = trail[i];\n    const p2 = trail[i+1];\n    ctx.strokeStyle = paintTypes[selectedPaint].color;\n    ctx.globalAlpha = 0.4;\n    ctx.beginPath();\n    ctx.moveTo(p1.x, p1.y);\n    ctx.lineTo(p2.x, p2.y);\n    ctx.stroke();\n    ctx.globalAlpha = 1;\n  }\n\n  // draw car\n  ctx.save();\n  ctx.translate(car.pos.x, car.pos.y);\n  ctx.rotate(car.angle);\n  ctx.fillStyle = '#0f0';\n  ctx.beginPath();\n  ctx.moveTo(0, -10);\n  ctx.lineTo(8, 0);\n  ctx.lineTo(-8, 0);\n  ctx.closePath();\n  ctx.fill();\n  ctx.restore();\n\n  // draw allies\n  for (let a of allies) {\n    ctx.save();\n    ctx.translate(a.pos.x, a.pos.y);\n    ctx.rotate(a.angle ?? 0);\n    ctx.fillStyle = '#ff0';\n    ctx.beginPath();\n    ctx.moveTo(0, -8);\n    ctx.lineTo(6,0);\n    ctx.lineTo(-6,0);\n    ctx.closePath();\n    ctx.fill();\n    ctx.restore();\n  }\n\n  // UI: paint meter\n  ctx.fillStyle = '#0f0';\n  ctx.fillRect(10, 10, (paintMeter/100)*150, 20);\n  ctx.fillStyle = '#fff';\n  ctx.fillText('Paint Meter', 10, 20);\n}\nfunction loop(timestamp) {\n  const dt = (timestamp - lastTime) / 1000;\n  lastTime = timestamp;\n  if (gameRunning) update(dt);\n  requestAnimationFrame(loop);\n}\nrequestAnimationFrame(loop);\n\n// Initialize allies\nfor (let i=0; i<3; i++) {\n  allies.push({\n    id:i,\n    pos:{x:200+i*100, y:200},\n    baseSpeed:2,\n    onTrail:false,\n    buffTimer:null,\n    angle:0,\n    vel:{x:0,y:0}\n  });\n}"
}

Now we need to ensure that all double quotes inside the strings are escaped. Let's verify each string.

index.html string: we need to escape double quotes inside attributes and within the data URL. Let's rewrite with proper escaping.

Original index.html content (with double quotes):

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Paint‑Trail Rally</title>
<link rel="stylesheet" href="style.css">
<link rel="icon" href="data:image/svg+xml,%3Csvg%20xmlns=%22http://www.w3.org/2000/svg%22%20viewBox=%220%200%20100%20100%22%3E%3Ctext%20y=%22.9em%22%20font-size=%2280%22%3E%F0%9F%9A%81%3C/text%3E%3C/svg%3E">
</head>
<body>
<div id="gameContainer">
<canvas id="gameCanvas"></canvas>
</div>
<div id="ui">
<canvas id="timerCanvas" class="timer"></canvas>
</div>
<script src="game.js"></script>
</body>
</html>

Now we need to escape double quotes:

- In <html lang="en">, the double quote after en needs escaping: lang=\"en\"
- In <meta charset="UTF-8">, charset=\"UTF-8\"
- In <title> there is no double quote.
- In <link rel="stylesheet" href="style.css">, there are double quotes around stylesheet and style.css. Need to escape them: rel=\"stylesheet\" href=\"style.css\"
- In <link rel="icon" href="data:image/svg+xml,%3Csvg%20xmlns=%22http://www.w3.org/2000/svg%22%20viewBox=%220%200%20100%20100%22%3E%3Ctext%20y=%22.9em%22%20font-size=%2280%22%3E%F0%9F%9A%81%3C/text%3E%3C/svg%3E">, there are many double quotes: xmlns=\"http://www.w3.org/2000/svg\", viewBox=\"0%200%20100%20100\", y=\"0.9em\", font-size=\"80\". All need escaping.

Also the id attributes: id=\"gameContainer\", id=\"gameCanvas\", id=\"timerCanvas\", class=\"timer\". Also need escaping.

Also the script tag: src=\"game.js\".

Also the closing tags: </head>, </body>, etc. Those have no double quotes.

Thus we need to produce a string with escaped double quotes.

Let's construct index.html string:

"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<title>Paint‑Trail Rally</title>\n<link rel=\"stylesheet\" href=\"style.css\">\n<link rel=\"icon\" href=\"data:image/svg+xml,%3Csvg%20xmlns=%22http://www.w3.org/2000/svg%22%20viewBox=%220%200%20100%20100%22%3E%3Ctext%20y=%22.9em%22%20font-size=%2280%22%3E%F0%9F%9A%81%3C/text%3E%3C/svg%3E\">\n</head>\n<body>\n<div id=\"gameContainer\">\n<canvas id=\"gameCanvas\"></canvas>\n</div>\n<div id=\"ui\">\n<canvas id=\"timerCanvas\" class=\"timer\"></canvas>\n</div>\n<script src=\"game.js\"></script>\n</body>\n</html>"

Now style.css string:

"body { margin:0; background:#0d0d0d; color:#fff; font-family:sans-serif; }\n#gameContainer { position:relative; width:100%; max-width:1280px; margin:auto; }\n#gameCanvas { width:100%; height:100%; display:block; }\n#timerCanvas { position:absolute; top:10px; left:10px; pointer-events:none; }"

No double quotes inside, except maybe in class name? class=\"timer\" includes double quotes, need to escape: class=\"timer\". Also there is no other double quotes. So we need to escape class=\"timer\" as class=\"timer\". Also the CSS uses #0d0d0d etc, which are fine.

Thus style.css string:

"body { margin:0; background:#0d0d0d; color:#fff; font-family:sans-serif; }\n#gameContainer { position:relative; width:100%; max-width:1280px; margin:auto; }\n#gameCanvas { width:100%; height:100%; display:block; }\n#timerCanvas { position:absolute; top:10px; left:10px; pointer-events:none; }"

But need to escape the double quotes around class name: class=\"timer\". So we need to write:

"#timerCanvas { position:absolute; top:10px; left:10px; pointer-events:none; class=\"timer\"; }" Wait that's not correct; class is not part of CSS rule. Actually the CSS rule is "#timerCanvas { position:absolute; top:10px; left:10px; pointer-events:none; }". The class attribute is in HTML, not CSS. So there is no double quote in CSS. So we can keep as is.

Thus style.css string is fine.

Now game.js string: This is large; we need to escape double quotes. Let's go through and replace each double quote with \". Also need to escape backslashes (like in \n). But we are using actual newline characters in the JSON string, which need to be represented as \n. However we can embed actual newline characters inside the string (the JSON parser will treat them as line breaks). But to be safe, we can keep the string with \n escapes.

But the code includes many double quotes inside strings like "http://www.w3.org/2000/svg". Those need escaping.

Let's rewrite game.js with escaped double quotes.

We'll rewrite each line with escaped quotes.

First line:

const canvas = document.getElementById('gameCanvas');

No double quotes, only single quotes, fine.

But there is a string 'gameCanvas' inside getElementById, which uses single quotes, fine.

But there are double quotes in the string literals like 'Time: ${elapsed.toFixed(2)}s' - that's a template literal using backticks, not double quotes. So fine.

But there are double quotes in the string "Time: ${elapsed.toFixed(2)}s" - that's backticks, not double quotes, so fine.

But there are double quotes in the string "http://www.w3.org/2000/svg" inside the data URL? Not in game.js.

But there are double quotes in the string "Time: ${elapsed.toFixed(2)}s" - not double quotes.

But there are double quotes in the string "Level Complete!" - not double quotes.

But there are double quotes in the string "Best Time: ${highScore.toFixed(2)}s" - not double quotes.

But there are double quotes in the string "Level Complete!" - no.

