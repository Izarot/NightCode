```javascript
const canvas = document.getElementById('gameCanvas');
const ctx = canvas.getContext('2d');
const container = document.getElementById('gameContainer');
const timerCanvas = document.getElementById('timerCanvas');
const timerCtx = timerCanvas.getContext('2d');

function resizeCanvas() {
  const dpr = window.devicePixelRatio || 1;
  const rect = container.getBoundingClientRect();
  canvas.width = rect.width * dpr;
  canvas.height = rect.height * dpr;
  ctx.scale(dpr, dpr);
  // also resize timer canvas similarly
  timerCanvas.width = rect.width * dpr;
  timerCanvas.height = rect.height * dpr;
  timerCtx.scale(dpr, dpr);
}
window.addEventListener('resize', resizeCanvas);
resizeCanvas();

const paintTypes = {
  red: {color:'#FF3B30', width:0.5, safety:80},
  blue:'#3B82F6', width:0.7, safety:70},
  green:'#10B981', width:0.6, safety:75},
  yellow:'#FBBF24', width:0.55, safety:85}
let selectedPaint = 'red';

let paintMeter = 100;
const paintDepletion = 0.5; // %/s while moving
const paintRefill = 1; // %/s idle
const paintConsumption = 0.1; // % per meter

let trail = [];
let car = {
  pos: {x: 640, y: 360},
  vel: {x:0, y:0},
  angle: 0,
  speed: 0,
  maxSpeed: 8,
  accel: 12,
  brakeDecel: 18,
  turnRate: 2.5,
  driftThreshold: 3,
  driftCoeff: 0.4,
  friction: 0.6,
  driftSpeed: 0
};
let keys = {};
let allies = [];
let goal = {x: 100, y: 50};
let startTime = null;
let gameRunning = true;
let highScore = parseFloat(localStorage.getItem('highScore')) || 0;

// Input
window.addEventListener('keydown', e => { keys[e.key] = true; });
window.addEventListener('keyup', e => { keys[e.key] = false; });

// Sound
const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
function playBeep(pitch, duration=0.1) {
  const osc = audioCtx.createOscillator();
  const gain = audioCtx.createGain();
  osc.frequency.value = pitch;
  gain.gain.value = 0.2;
  osc.connect(gain).connect(audioCtx.destination);
  gain.connect(audioCtx.destination);
  osc.start();
  gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + duration);
  osc.stop(audioCtx.currentTime + duration);
}

// Game loop
let lastTime = performance.now();
function update(dt) {
  // --- Paint meter ---
  const moving = car.speed > 0.1;
  if (moving) {
    paintMeter = Math.max(0, paintMeter - paintDepletion * dt);
    const distance = car.speed * dt; // meters per second * seconds = meters
    paintMeter = Math.max(0, paintMeter - (distance * paintConsumption) * dt);
  } else {
    paintMeter = Math.min(100, paintMeter + paintRefill * dt);
  }

  // --- Car physics ---
  // Acceleration / braking
  let accel = 0;
  if (keys['w'] || keys['ArrowUp']) accel += 1;
  if (keys['s'] || keys['ArrowDown']) accel -= 1;
  // Apply friction
  accel *= car.friction;
  // Apply brake deceleration if braking
  if (accel < 0) {
    car.speed = Math.max(0, car.speed + accel * dt);
  } else {
    car.speed = Math.min(car.maxSpeed, car.speed + accel * dt);
  }

  // Drift handling
  const lateralSpeed = Math.abs(car.vel.x) + Math.abs(car.vel.y);
  if (lateralSpeed > car.driftThreshold) {
    car.driftSpeed += dt;
    car.turnRate *= 1.3; // increase turn rate by 30%
    car.speed *= 0.8; // reduce straight speed by 20%
  } else {
    car.driftSpeed = 0;
    car.turnRate = 2.5;
  }

  // Update velocity and position based on angle
  const rad = car.angle;
  car.vel.x = Math.cos(rad) * car.speed;
  car.vel.y = Math.sin(rad) * car.speed;
  car.pos.x += car.vel.x * dt;
  car.pos.y += car.vel.y * dt;

  // Wrap around screen edges (optional)
  if (car.pos.x < 0) car.pos.x += canvas.width;
  if (car.pos.x > canvas.width) car.pos.x -= canvas.width;
  if (car.pos.y < 0) car.pos.y += canvas.height;
  if (car.pos.y > canvas.height) car.pos.y -= canvas.height;

  // --- Trail ---
  if (moving) {
    // add segment
    trail.push({x: car.pos.x, y: car.pos.y, color: paintTypes[selectedPaint].color, width: paintTypes[selectedPaint].width});
    // limit trail length maybe
    if (trail.length > 500) trail.shift();
  }

  // --- Allies ---
  for (let a of allies) {
    // move toward goal
    const dx = goal.x - a.pos.x;
    const dy = goal.y - a.pos.y;
    const dist = Math.hypot(dx, dy);
    if (dist > 0.5) {
      const speed = a.baseSpeed * (a.onTrail ? 1.15 : 1);
      const angle = Math.atan2(dy, dx);
      a.vel.x = Math.cos(angle) * speed;
      a.vel.y = Math.sin(angle) * speed;
      a.pos.x += a.vel.x * dt;
      a.pos.y += a.vel.y * dt;
    }

    // check trail proximity
    a.onTrail = false;
    for (let i=0; i<trail.length-1; i++) {
      const p1 = trail[i];
      const p2 = trail[i+1];
      if (distToSegment(a.pos, p1, p2) < 2) {
        a.onTrail = true;
        break;
      }
    }
    if (a.onTrail && a.buffTimer == null) {
      a.buffTimer = 3; // seconds
      playBeep(1.5); // sound cue
    }
    if (a.buffTimer) {
      a.buffTimer -= dt;
      if (a.buffTimer <= 0) {
        a.buffTimer = null;
      }
    }
  }

  // --- Timer UI ---
  if (!startTime) startTime = performance.now();
  const elapsed = (performance.now() - startTime) / 1000;
  // draw timer
  timerCtx.clearRect(0,0,timerCanvas.width,timerCanvas.height);
  timerCtx.fillStyle = '#fff';
  timerCtx.font = '24px sans-serif';
  timerCtx.fillText(`Time: ${elapsed.toFixed(2)}s`, 10, 30);

  // --- Win condition ---
  // simple: if car reaches goal
  const carToGoal = Math.hypot(car.pos.x - goal.x, car.pos.y - goal.y);
  if (carToGoal < 30) {
    gameRunning = false;
    const finalTime = elapsed;
    if (finalTime < highScore) {
      highScore = finalTime;
      localStorage.setItem('highScore', highScore);
    }
    // show message
    ctx.fillStyle = '#fff';
    ctx.font = '48px sans-serif';
    ctx.fillText('Level Complete!', canvas.width/2-120, canvas.height/2);
    ctx.fillText(`Best Time: ${highScore.toFixed(2)}s`, canvas.width/2-150, canvas.height/2+30);
    // sound cue
    playBeep(2);
  }

  // --- Rendering ---
  // clear
  ctx.clearRect(0,0,canvas.width,canvas.height);
  // draw trail
  ctx.lineWidth = 4;
  for (let i=0; i<trail.length-1; i++) {
    const p1 = trail[i];
    const p2 = trail[i+1];
    ctx.strokeStyle = paintTypes[selectedPaint].color;
    ctx.globalAlpha = 0.4;
    ctx.beginPath();
    ctx.moveTo(p1.x, p1.y);
    ctx.lineTo(p2.x, p2.y);
    ctx.stroke();
    ctx.globalAlpha = 1;
  }

  // draw car (simple triangle)
  ctx.save();
  ctx.translate(car.pos.x, car.pos.y);
  ctx.rotate(car.angle);
  ctx.fillStyle = '#0f0';
  ctx.beginPath();
  ctx.moveTo(0, -10);
  ctx.lineTo(8, 0);
  ctx.lineTo(-8, 0);
  ctx.closePath();
  ctx.fill();
  ctx.restore();

  // draw allies
  for (let a of allies) {
    ctx.save();
    ctx.translate(a.pos.x, a.pos.y);
    ctx.rotate(a.angle ?? 0);
    ctx.fillStyle = '#ff0';
    ctx.beginPath();
    ctx.moveTo(0, -8);
    ctx.lineTo(6,0);
    ctx.lineTo(-6,0);
    ctx.closePath();
    ctx.fill();
    ctx.restore();
  }

  // UI
  // paint meter
  ctx.fillStyle = '#0f0';
  ctx.fillRect(10, 10, (paintMeter/100)*150, 20);
  ctx.fillStyle = '#fff';
  ctx.fillText('Paint Meter', 10, 20);
}
function loop(timestamp) {
  const dt = (timestamp - lastTime) / 1000;
  lastTime = timestamp;
  if (gameRunning) update(dt);
  requestAnimationFrame(loop);
}
requestAnimationFrame(loop);

// Initialize allies
for (let i=0; i<3; i++) {
  allies.push({
    id:i,
    pos:{x:200+i*100, y:200},
    baseSpeed:2,
    onTrail:false,
    buffTimer:null,
    angle:0,
    vel:{x:0,y:0}
  });
}
```

