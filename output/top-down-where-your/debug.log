  ctx.save();
  ctx.translate(car.pos.x, car.pos.y);
  ctx.rotate(car.angle);
  ctx.fillStyle = '#0f0';
  ctx.beginPath();
  ctx.moveTo(0, -10);
  ctx.lineTo(8, 0);
  ctx.lineTo(-8, 0);
  ctx.closePath();
  ctx.fill();
  ctx.restore();

  // draw allies
  for (let a of allies) {
    ctx.save();
    ctx.translate(a.pos.x, a.pos.y);
    ctx.rotate(a.angle ?? 0);
    ctx.fillStyle = '#ff0';
    ctx.beginPath();
    ctx.moveTo(0, -8);
    ctx.lineTo(6,0);
    ctx.lineTo(-6,0);
    ctx.closePath();
    ctx.fill();
    ctx.restore();
  }

  // UI: paint meter
  ctx.fillStyle = '#0f0';
  ctx.fillRect(10, 10, (paintMeter/100)*150, 20);
  ctx.fillStyle = '#fff';
  ctx.fillText('Paint Meter', 10, 20);
}
function loop(timestamp) {
