ew Vector2(this.x, this.y); }\n  static add(a, b) { return new Vector2(a.x + b.x, a.y + b.y); }\n  static sub(a, b) { return new Vector2(a.x - b.x, a.y - b.y); }\n  static mul(v, s) { return new Vector2(v.x * s, v.y * s); }\n}", "utils/GeometryUtils.js": "export function lineCircleIntersection(start, end, center, radius) {\n  const d = Vector2.sub(end, start);\n  const f = Vector2.sub(start, center);\n  const a = d.dot(d);\n  const b = 2 * f.dot(d);\n  const c = f.dot(f) - radius * radius;\n  let discriminant = b * b - 4 * a * c;\n  if (discriminant < 0) return null;\n  discriminant = Math.sqrt(discriminant);\n  const t1 = (-b - discriminant) / (2 * a);\n  const t2 = (-b + discriminant) / (2 * a);\n  if (t1 >= 0 && t1 <= 1) return t1;\n  if (t2 >= 0 && t2 <= 1) return t2;\n  return null;\n}\n\nexport function reflect(velocity, normal) {\n  const dot = velocity.dot(normal);\n  return Vector2.sub(velocity, Vector2.mul(normal, 2 * dot));\n}", "utils/ColorPalette.js": "export const COLORS = {\n  BACKGROUND: '#050508',\n  PHOTON: '#00FFFF',\n  MIRROR: '#FFFFFF',\n  MIRROR_EDGE: '#00FFFF',\n  ENEMY: '#FF0055',\n  PARTICLE_YELLOW: '#FFFF00',\n  PARTICLE_MAGENTA: '#FF0055',\n  UI_TEXT: '#E0E0E0',\n  UI_ACCENT: '#00FFFF',\n  HEALTH_HIGH: '#00FF00',\n  HEALTH_MID: '#FFFF00',\n  HEALTH_LOW: '#FF0000'\n};", "systems/ObjectPool.js": "export default class ObjectPool {\n  constructor(createFn, resetFn, initialSize = 50) {\n    this.createFn = createFn;\n    this.resetFn = resetFn;\n    this.pool = [];\n    for (let i = 0; i < initialSize; i++) {\n      this.pool.push(this.createFn());\n    }\n  }\n  acquire() {\n    if (this.pool.length > 0) {\n      return this.pool.pop();\n    } else {\n      return this.createFn();\n    }\n  }\n  release(obj) {\n    this.resetFn(obj);\n    this.pool.push(obj);\n  }\n}", "systems/AudioManager.js": "export default class AudioManager {\n  constructor() {\n    this.ctx = null;\n    this.enabled = true;\n    this.masterGain = null;\n    this.sfxGain = null;\n    this.musicGain = null;\n    this.init();\n  }\n  init() {\n    try {\n      this.ctx = new (window.AudioContext || window.webkitAudioContext)();\n      this.masterGain = this.ctx.createGain();\n      this.sfxGain = this.ctx.createGain();\n      this.musicGain = this.ctx.createGain();\n      this.sfxGain.connect(this.masterGain);\n      this.musicGain.connect(this.masterGain);\n      this.masterGain.connect(this.ctx.destination);\n      this.masterGain.gain.value = 0.7;\n      this.sfxGain.gain.value = 0.8;\n      this.musicGain.gain.value = 0.3;\n    } catch (e) {\n      this.enabled = false;\n    }\n  }\n  playBounce(freq = 400, duration = 0.1) {\n    if (!this.enabled) return;\n    const osc = this.ctx.createOscillator();\n    const gain = this.ctx.createGain();\n    osc.type = 'sine';\n    osc.frequency.setValueAtTime(freq, this.ctx.currentTime);\n    osc.frequency.exponentialRampToValueAtTime(freq * 2, this.ctx.currentTime + duration);\n    gain.gain.setValueAtTime(0.3, this.ctx.currentTime);\n    gain.gain.exponentialRampToValueAtTime(0.001, this.ctx.currentTime + duration);\n    osc.connect(gain);\n    gain.connect(this.sfxGain);\n    osc.start();\n    osc.stop(this.ctx.currentTime + duration);\n  }\n  playDroneSpawn() {\n    if (!this.enabled) return;\n    const bufferSize = this.ctx.createBufferSource ? 1 : 0;\n    const osc = this.ctx.createOscillator();\n    const gain = this.ctx.createGain();\n    const filter = this.ctx.createBiquadFilter();\n    osc.type = 'whitenoise';\n    filter.type = 'lowpass';\n    filter.frequency.setValueAtTime(800, this.ctx.currentTime);\n    filter.frequency.exponentialRampToValueAtTime(100, this.ctx.currentTime + 0.2);\n    gain.gain.setValueAtTime(0.2, this.ctx.currentTime);\n    gain.gain.exponentialRampToValueAtTime(0.001, this.ctx.currentTime + 0.2);\n    osc.connect(filter);\n    filter.connect(gain);\n    gain.connect(this.sfxGain);\n    osc.start();\n    osc.stop(this.ctx.currentTime + 0.2);\n  }\n  playDamage() {\n    if (!this.enabled) return;\n    const osc = this.ctx.createOscillator();\n const gain = this.ctx.createGain();\n    const filter = this.ctx.createBiquadFilter();\n    osc.type = 'sawtooth';\n    filter.type = 'lowpass';\n    filter.frequency.setValueAtTime(200, this.ctx.currentTime);\n    gain.gain.setValueAtTime(0.4, this.ctx.currentTime);\n    gain.gain.exponentialRampToValueAtTime(0.001, this.ctx.currentTime + 0.3);\n    osc.connect(filter);\n    filter.connect(gain);\n    gain.connect(this.sfxGain);\n    osc.start();\n    osc.stop(this.ctx.currentTime + 0.3);\n  }\n  playUIClick() {\n    if (!this.enabled) return;\n    const osc = this.ctx.createOscillator();\n    const gain = this.ctx.createGain();\n    osc.type = 'sine';\n    osc.frequency.setValueAtTime(1200, this.ctx.currentTime);\n    gain.gain.setValueAtTime(0.15, this.ctx.currentTime);\n    gain.gain.exponentialRampToValueAtTime(0.001, this.ctx.currentTime + 0.1);\n    osc.connect(gain);\n    gain.connect(this.sfxGain);\n    osc.start();\n    osc.stop(this.ctx.currentTime + 0.1);\n  }\n  playMovementTone(speedRatio) {\n    if (!this.enabled) return;\n    if (!this._moveOsc) {\n      this._moveOsc = this.ctx.createOscillator();\n      this._moveGain = this.ctx.createGain();\n      this._moveOsc.type = 'sine';\n      this._moveOsc.frequency.setValueAtTime(30, this.ctx.currentTime);\n      this._moveGain.gain.setValueAtTime(0.05, this.ctx.currentTime);\n      this._moveOsc.connect(this._moveGain);\n      this._moveGain.connect(this.sfxGain);\n      this._moveOsc.start();\n    }\n    const targetFreq = 30 + speedRatio * 100;\n    this._moveOsc.frequency.setValueAtTime(targetFreq, this.ctx.currentTime);\n  }\n  stopMovementTone() {\n    if (this._moveOsc) {\n      this._moveOsc.stop();\n      this._moveOsc = null;\n      this._moveGain = null;\n    }\n  }\n}", "systems/ComboManager.js": "export default class ComboManager {\n  constructor() {\n    this.bounces = 0;\n    this.multiplier = 1;\n    this.resonance = false;\n    this.lastBounceTime = 0;\n    this.comboTimeout = 2.0; // seconds\n  }\n  onBounce(timestamp) {\n    const dt = timestamp - this.lastBounceTime;\n    if (dt > this.comboTimeout) {\n      this.bounces = 0;\n    }\n    this.bounces++;\n    this.lastBounceTime = timestamp;\n    if (this.bounces >= 3 && !this.resonance) {\n      this.resonance = true;\n      this.multiplier = 2;\n    }\n  }\n  reset() {\n    this.bounces = 0;\n    this.multiplier = 1;\n    this.resonance = false;\n    this.lastBounceTime = 0;\n  }\n  update(timestamp) {\n    if (this.resonance && (timestamp - this.lastBounceTime > this.comboTimeout)) {\n      this.resonance = false;\n      this.multiplier = 1;\n    }\n  }\n}", "systems/DifficultyDirector.js": "export default class DifficultyDirector {\n  constructor() {\n    this.elapsed = 0;\n    this.spawnRate = 1.0;\n    this.mirrorRegenTime = 2.0;\n  }\n  update(dt) {\n    this.elapsed += dt;\n    if (this.elapsed % 30 < dt) {\n      this.spawnRate *= 1.1;\n      this.mirrorRegenTime *= 0.9;\n    }\n  }\n  getSpawnInterval() {\n    return Math.max(0.5, 2.0 / this.spawnRate);\n  }\n  reset() {\n    this.elapsed = 0;\n    this.spawnRate = 1.0;\n    this.mirrorRegenTime = 2.0;\n  }\n}", "entities/Entity.js": "import Vector2 from '../utils/Vector2.js';\n\nexport default class Entity {\n  constructor(x = 0, y = 0) {\n    this.position = new Vector2(x, y);\n    this.active = true;\n  }\n  update(dt) {}\n  render(ctx) {}\n  destroy() { this.active = false; }\n}", "entities/Photon.js": "import Entity from './Entity.js';\nimport Vector2 from '../utils/Vector2.js';\n\nexport default class Photon extends Entity {\n  constructor(x, y) {\n    super(x, y);\n    this.velocity = new Vector2(1, 0).normalize();\n    this.baseSpeed = 400;\n    this.speed = this.baseSpeed;\n    this.radius = 8;\n    this.health = 100;\n    this.maxHealth = 100;\n    this.turnRate = Math.PI; // 180 deg/s\n    this.boostActive = false;\n    this.boostTimer = 0;\n    this.boostCooldown = 0;\n    this.trail = [];\n    this.trailIndex = 0;\n    this.trailCapacity = 20;\n    this.phaseShiftActive = false;\n    this.phaseTimer = 0;\n    this.stasisActive = false;\n    this.stasisTimer = 0;\n    for (let i = 0; i < this.trailCapacity; i++) {\n      this.trail.push(new Vector2());\n    }\n  }\n  update(dt, input) {\n    if (this.boostCooldown > 0) this.boostCooldown -= dt;\n    if (this.boostActive) {\n      this.boostTimer -= dt;\n      if (this.boostTimer <= 0) this.boostActive = false;\n    }\n    if (this.phaseShiftActive) {\n      this.phaseTimer -= dt;\n      if (this.phaseTimer <= 0) this.phaseShiftActive = false;\n    }\n    if (this.stasisActive) {\n      this.stasisTimer -= dt;\n      if (this.stasisTimer <= 0) this.stasisActive = false;\n    }\n    if (input.left) {\n      const angle = -this.turnRate * dt;\n      this.rotateVelocity(angle);\n    }\n    if (input.right) {\n      const angle = this.turnRate * dt;\n      this.rotateVelocity(angle);\n    }\n    if (input.up && this.boostCooldown <= 0 && !this.boostActive) {\n      this.boostActive = true;\n      this.boostTimer = 0.5;\n      this.boostCooldown = 3;\n    }\n    const currentSpeed = this.boostActive ? this.speed * 1.5 : this.speed;\n    this.velocity.normalize().mul(currentSpeed);\n    this.position.add(Vector2.mul(this.velocity, dt));\n    this.trail[this.trailIndex].x = this.position.x;\n    this.trail[this.trailIndex].y = this.position.y;\n    this.trailIndex = (this.trailIndex + 1) % this.trailCapacity;\n  }\n  rotateVelocity(angle) {\n    const cos = Math.cos(angle);\n    const sin = Math.sin(angle);\n    const nx = this.velocity.x * cos - this.velocity.y * sin;\n    const ny = this.velocity.x * sin + this.velocity.y * cos;\n    this.velocity.x = nx;\n    this.velocity.y = ny;\n  }\n  reflect(normal) {\n    const dot = this.velocity.dot(normal);\n    this.velocity.x -= 2 * dot * normal.x;\n    this.velocity.y -= 2 * dot * normal.y;\n    this.speed = Math.max(this.baseSpeed * 0.5, this.speed * 0.99);\n  }\n  renderTrail(ctx) {\n    ctx.save();\n    ctx.globalCompositeOperation = 'lighter';\n    for (let i = 0; i < this.trailCapacity; i++) {\n      const idx = (this.trailIndex - i + this.trailCapacity) % this.trailCapacity;\n      const p = this.trail[idx];\n      const alpha = Math.max(0, 1 - i / this.trailCapacity);\n      const width = Math.max(0, 4 - i * 0.2);\n      ctx.strokeStyle = `rgba(0, 255, 255, ${alpha})`;\n      ctx.lineWidth = width;\n      ctx.beginPath();\n      ctx.arc(p.x, p.y, width / 2, 0, Math.PI * 2);\n      ctx.stroke();\n    }\n    ctx.restore();\n  }\n  render(ctx) {\n    this.renderTrail(ctx);\n    ctx.save();\n    if (this.phaseShiftActive) {\n      ctx.globalAlpha = 0.5 + 0.3 * Math.sin(performance.now() / 100);\n    } else {\n      ctx.globalAlpha = 1;\n    }\n    ctx.fillStyle = '#00FFFF';\n    ctx.shadowBlur = 15;\n    ctx.shadowColor = '#00FFFF';\n    ctx.beginPath();\n    ctx.arc(this.position.x, this.position.y, this.radius, 0, Math.PI * 2);\n    ctx.fill();\n    ctx.restore();\n  }\n}", "entities/Drone.js": "import Entity from './Entity.js';\nimport Vector2 from '../utils/Vector2.js';\n\nexport default class Drone extends Entity {\n  constructor(x, y, type = 'chaser') {\n    super(x, y);\n    this.type = type;\n    this.radius = 12;\n    this.velocity = new Vector2(0, 0);\n    this.speed = 0;\n    this.health = 3;\n  }\n  update(dt, photon) {\n    if (this.type === 'chaser') {\n      this.speed = photon.baseSpeed * 0.7;\n      const dir = Vector2.sub(photon.position, this.position).normalize();\n      this.velocity = Vector2.mul(dir, this.speed);\n    } else if (this.type === 'bouncer') {\n      if (this.speed === 0) {\n        this.velocity = new Vector2(Math.random() - 0.5, Math.random() - 0.5).normalize();\n        this.speed = photon.baseSpeed * 0.6;\n      }\n      this.velocity.normalize().mul(this.speed);\n    } else if (this.type === 'sniper') {\n      this.speed = 50;\n      const dir = Vector2.sub(photon.position, this.position).normalize();\n      this.velocity = Vector2.mul(dir, this.speed);\n    }\n    this.position.add(Vector2.mul(this.velocity, dt));\n  }\n  render(ctx) {\n    ctx.save();\n    ctx.fillStyle = '#FF0055';\n    ctx.shadowBlur = 10;\n    ctx.shadowColor = '#FF0055';\n    ctx.beginPath();\n    ctx.arc(this.position.x, this.position.y, this.radius, 0, Math.PI * 2);\n    ctx.fill();\n    ctx.restore();\n  }\n}", "entities/Mirror.js": "import Entity from './Entity.js';\nimport Vector2 from '../utils/Vector2.js';\n\nexport default class Mirror extends Entity {\n  constructor(x1, y1, x2, y2, rotating = false, phase = false) {\n    super((x1 + x2) / 2, (y1 + y2) / 2);\n    this.start = new Vector2(x1, y1);\n    this.end = new Vector2(x2, y2);\n    this.rotating = rotating;\n    this.phase = phase;\n    this.phaseVisible = true;\n    this.phaseTimer = 0;\n    this.rotationSpeed = rotating ? (Math.random() * 0.5 + 0.2) : 0;\n    this.angle = 0;\n  }\n  update(dt) {\n    if (this.rotating) {\n      this.angle += this.rotationSpeed * dt;\n      const cx = (this.start.x + this.end.x) / 2;\n      const cy = (this.start.y + this.end.y) / 2;\n      const len = Vector2.sub(this.end, this.start).len();\n      const dx = Math.cos(this.angle) * len / 2;\n      const dy = Math.sin(this.angle) * len / 2;\n      this.start.x = cx - dx; this.start.y = cy - dy;\n      this.end.x = cx + dx; this.end.y = cy + dy;\n    }\n    if (this.phase) {\n      this.phaseTimer += dt;\n      if (this.phaseTimer >= 2) {\n        this.phaseVisible = !this.phaseVisible;\n        this.phaseTimer = 0;\n      }\n    }\n  }\n  getNormal() {\n    const dx = this.end.x - this.start.x;\n    const dy = this.end.y - this.start.y;\n    const len = Math.hypot(dx, dy);\n    return new Vector2(-dy / len, dx / len);\n  }\n  render(ctx) {\n    if (this.phase && !this.phaseVisible) return;\n    ctx.save();\n    ctx.strokeStyle = '#FFFFFF';\n    ctx.shadowBlur = 8;\n    ctx.shadowColor = '#00FFFF';\n    ctx.lineWidth = 2;\n    ctx.beginPath();\n    ctx.moveTo(this.start.x, this.start.y);\n    ctx.lineTo(this.end.x, this.end.y);\n    ctx.stroke();\n    ctx.restore();\n  }\n}", "entities/Particle.js": "import Entity from './Entity.js';\nimport Vector2 from '../utils/Vector2.js';\n\nexport default class Particle extends Entity {\n  constructor() {\n    super(0, 0);\n    this.velocity = new Vector2(0, 0);\n    this.color = '#FFFF00';\n    this.size = 2;\n    this.life = 1;\n    this.maxLife = 1;\n    this.gravity = 0;\n  }\n  update(dt) {\n    this.velocity.add(new Vector2(0, this.gravity * dt));\n    this.position.add(Vector2.mul(this.velocity, dt));\n    this.life -= dt / this.maxLife;\n    if (this.life <= 0) this.active = false;\n  }\n  render(ctx) {\n    if (!this.active) return;\n    ctx.save();\n    ctx.globalAlpha = this.life;\n    ctx.fillStyle = this.color;\n    ctx.beginPath();\n    ctx.arc(this.position.x, this.position.y, this.size, 0, Math.PI * 2);\n    ctx.fill();\n    ctx.restore();\n  }\n}", "physics/FixedStepLoop.js": "export default class FixedStepLoop {\n  constructor(fps = 240) {\n    this.dt = 1 / fps;\n    this.accumulator = 0;\n    this.lastTime = 0;\n  }\n  update(realDt, callback) {\n    this.accumulator += realDt;\n    while (this.accumulator >= this.dt) {\n      callback(this.dt);\n      this.accumulator -= this.dt;\n    }\n  }\n}", "InputManager.js": "export default class InputManager {\n  constructor(canvas) {\n    this.canvas = canvas;\n    this.keys = {};\n    this.touch = { x: 0, y: 0, active: false };\n    this.left = false;\n    this.right = false;\n    this.up = false;\n    this.down = false;\n    this.setupKeyboard();\n    this.setupTouch();\n  }\n  setupKeyboard() {\n    window.addEventListener('keydown', (e) => {\n      this.keys[e.code] = true;\n      this.updateInputState();\n    });\n    window.addEventListener('keyup', (e) => {\n      this.keys[e.code] = false;\n      this.updateInputState();\n    });\n  }\n  setupTouch() {\n    this.canvas.addEventListener('touchstart', (e) => {\n      e.preventDefault();\n      const rect = this.canvas.getBoundingClientRect();\n      const touch = e.touches[0];\n      this.touch.x = touch.clientX - rect.left;\n      this.touch.y = touch.clientY - rect.top;\n      this.touch.active = true;\n      this.updateInputState();\n    }, { passive: false });\n    this.canvas.addEventListener('touchmove', (e) => {\n      e.preventDefault();\n      const rect = this.canvas.getBoundingClientRect();\n      const touch = e.touches[0];\n      this.touch.x = touch.clientX - rect.left;\n      this.touch.y = touch.clientY - rect.top;\n      this.updateInputState();\n    }, { passive: false });\n    this.canvas.addEventListener('touchend', () => {\n      this.touch.active = false;\n      this.updateInputState();\n    });\n  }\n  updateInputState() {\n    this.left = this.keys['ArrowLeft'] || this.keys['KeyA'] || (this.touch.active && this.touch.x < this.canvas.width / 2);\n    this.right = this.keys['ArrowRight'] || this.keys['KeyD'] || (this.touch.active && this.touch.x > this.canvas.width / 2);\n    this.up = this.keys['ArrowUp'] || this.keys['KeyW'] || this.touch.active;\n  }\n  reset() {\n    this.keys = {};\n    this.touch.active = false;\n    this.left = false;\n    this.right = false;\n    this.up = false;\n  }\n}", "Renderer.js": "import { COLORS } from './utils/ColorPalette.js';\n\nexport default class Renderer {\n  constructor(canvas) {\n    this.canvas = canvas;\n    this.ctx = canvas.getContext('2d');\n    this.dpr = window.devicePixelRatio || 1;\n    this.resize();\n    window.addEventListener('resize', () => this.resize());\n  }\n  resize() {\n    const rect = this.canvas.getBoundingClientRect();\n    this.canvas.width = rect.width * this.dpr;\n    this.canvas.height = rect.height * this.dpr;\n    this.ctx.scale(this.dpr, this.dpr);\n    this.ctx.imageSmoothingEnabled = false;\n  }\n  clear() {\n    this.ctx.fillStyle = COLORS.BACKGROUND;\n    this.ctx.fillRect(0, 0, this.canvas.width, this.canvas.height);\n  }\n  applyVignette() {\n    const grad = this.ctx.createRadialGradient(\n      this.canvas.width / 2, this.canvas.height / 2,\n      this.canvas.width * 0.3,\n      this.canvas.width / 2, this.canvas.height / 2,\n      this.canvas.width\n    );\n    grad.addColorStop(0, 'rgba(0,0,0,0)');\n    grad.addColorStop(1, 'rgba(0,0,0,0.15)');\n    this.ctx.fillStyle = grad;\n    this.ctx.fillRect(0, 0, this.canvas.width, this.canvas.height);\n  }\n  renderHUD(ctx, score, health, maxHealth, combo, resonance, phaseReady, boostCooldown, boostMax) {\n    ctx.save();\n    ctx.font = '32px \"Courier New\", monospace';\n    ctx.fillStyle = COLORS.UI_TEXT;\n    ctx.textAlign = 'center';\n    ctx.fillText(`SCORE: ${score}`, this.canvas.width / 2, 50);\n\n    const healthPercent = health / maxHealth;\n    let healthColor = COLORS.HEALTH_HIGH;\n    if (healthPercent < 0.5) healthColor = COLORS.HEALTH_LOW;\n    else if (healthPercent < 0.75) healthColor = COLORS.HEALTH_MID;\n    ctx.strokeStyle = '#333';\n    ctx.lineWidth = 2;\n    ctx.strokeRect(this.canvas.width - 220, 20, 200, 20);\n    ctx.fillStyle = healthColor;\n    ctx.fillRect(this.canvas.width - 220, 20, 200 * healthPercent, 20);\n\n    if (resonance) {\n      ctx.fillStyle = COLORS.PARTICLE_YELLOW;\n      ctx.font = '24px \"Courier New\", monospace';\n      ctx.textAlign = 'left';\n      ctx.fillText(`x${combo} RESONANCE`, 20, 50);\n    }\n\n    if (phaseReady) {\n      ctx.fillStyle = COLORS.UI_ACCENT;\n      ctx.font = '16px \"Courier New\", monospace';\n      ctx.textAlign = 'center';\n      ctx.fillText('PHASE SHIFT READY', this.canvas.width / 2, this.canvas.height - 30);\n    }\n    ctx.restore();\n  }\n  renderMenu(ctx, title, subtitle, buttons) {\n    ctx.save();\n    ctx.fillStyle = COLORS.UI_TEXT;\n    ctx.font = '48px \"Courier New\", monospace';\n    ctx.textAlign = 'center';\n    ctx.fillText(title, this.canvas.width / 2, this.canvas.height / 2 - 60);\n    ctx.font = '24px \"Courier New\", monospace';\n    ctx.fillText(subtitle, this.canvas.width / 2, this.canvas.height / 2 - 20);\n    buttons.forEach((btn, i) => {\n      ctx.fillStyle = btn.hovered ? COLORS.UI_ACCENT : COLORS.UI_TEXT;\n      ctx.font = '20px \"Courier New\", monospace';\n      ctx.fillText(btn.text, this.canvas.width / 2, this.canvas.height / 2 + 40 + i * 40);\n    });\n    ctx.restore();\n  }\n  renderGameOver(ctx, score, highScore) {\n    ctx.save();\n    ctx.fillStyle = COLORS.ENEMY;\n    ctx.font = '48px \"Courier New\", monospace';\n    ctx.textAlign = 'center';\n    ctx.fillText('SIGNAL LOST', this.canvas.width / 2, this.canvas.height / 2 - 60);\n    ctx.fillStyle = COLORS.UI_TEXT;\n    ctx.font = '32px \"Courier New\", monospace';\n    ctx.fillText(`SCORE: ${score}`, this.canvas.width / 2, this.canvas.height / 2);\n    ctx.font = '24px \"Courier New\", monospace';\n    ctx.fillText(`HIGH SCORE: ${highScore}`, this.canvas.width / 2, this.canvas.height / 2 + 50);\n    ctx.fillText('RETRY', this.canvas.width / 2, this.canvas.height / 2 + 100);\n    ctx.fillText('MENU', this.canvas.width / 2, this.canvas.height / 2 + 140);\n    ctx.restore();\n  }\n}", "main.js": "import Vector2 from './utils/Vector2.js';\nimport { COLORS } from './utils/ColorPalette.js';\nimport ObjectPool from './systems/ObjectPool.js';\nimport AudioManager from './systems/AudioManager.js';\nimport ComboManager from './systems/ComboManager.js';\nimport DifficultyDirector from './systems/DifficultyDirector.js';\nimport Photon from './entities/Photon.js';\nimport Drone from './entities/Drone.js';\nimport Mirror from './entities/Mirror.js';\nimport Particle from './entities/Particle.js';\nimport FixedStepLoop from './physics/FixedStepLoop.js';\nimport InputManager from './InputManager.js';\nimport Renderer from './Renderer.js';\n\nconst canvas = document.getElementById('gameCanvas');\nconst renderer = new Renderer(canvas);\nconst ctx = renderer.ctx;\nconst input = new InputManager(canvas);\nconst audio = new AudioManager();\nconst combo = new ComboManager();\nconst difficulty = new DifficultyDirector();\nconst fixedLoop = new FixedStepLoop(240);\n\nconst STATE = { MENU: 0, PLAYING: 1, PAUSED: 2, GAME_OVER: 3, VICTORY: 4 };\nlet gameState = STATE.MENU;\n\nlet photon;\nlet drones = [];\nlet mirrors = [];\nlet particles = [];\nlet particlePool;\nlet score = 0;\nlet highScore = localStorage.getItem('photonReflexHighScore') || 0;\nlet speedrunTime = 0;\nlet lastTime = 0;\nlet spawnTimer = 0;\nlet menuButtons = [\n  { text: 'INITIATE', hovered: false },\n  { text: 'SETTINGS', hovered: false }\n];\nlet settings = {\n  masterVolume: 0.7,\n  sfxVolume: 0.8,\n  musicVolume: 0.3,\n  bloomEnabled: true,\n  sensitivity: 1.0\n};\n\nfunction initParticle(p) {\n  p.position.x = 0; p.position.y = 0;\n  p.velocity.x = 0; p.velocity.y = 0;\n  p.color = COLORS.PARTICLE_YELLOW;\n  p.size = 2;\n  p.life = 1; p.maxLife = 1;\n  p.gravity = 0;\n  p.active = false;\n}\n\nparticlePool = new ObjectPool(\n  () => new Particle(),\n  initParticle,\n  100\n);\n\nfunction createMirrors() {\n  mirrors = [];\n  const w = canvas.width / renderer.dpr;\n  const h = canvas.height / renderer.dpr;\n  mirrors.push(new Mirror(100, 100, w - 100, 100, false, false));\n  mirrors.push(new Mirror(100, h - 100, w - 100, h - 100, false, false));\n  mirrors.push(new Mirror(100, 100, 100, h - 100, false, false));\n  mirrors.push(new Mirror(w - 100, 100, w -{"index.html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, user-scalable=no\" />\n  <title>PHOTON REFLEX</title>\n  <link rel=\"icon\" href=\"data:,🚀\" type=\"image/svg+xml\" />\n  <style>\n    * { margin: 0; padding: 0; box-sizing: border-box; }\n    html, body { width: 100%; height: 100%; overflow: hidden; background: #050508; font-family: 'Courier New', monospace; }\n    #gameCanvas { display: block; width: 100%; height: 100%; touch-action: none; }\n    .hidden { display: none; }\n  </style>\n</head>\n<body>\n  <canvas id=\"gameCanvas\"></canvas>\n  <script src=\"utils/Vector2.js\"></script>\n  <script src=\"utils/GeometryUtils.js\"></script>\n  <script src=\"utils/ColorPalette.js\"></script>\n  <script src=\"systems/ObjectPool.js\"></script>\n  <script src=\"systems/AudioManager.js\"></script>\n  <script src=\"systems/ComboManager.js\"></script>\n  <script src=\"systems/DifficultyDirector.js\"></script>\n  <script src=\"entities/Entity.js\"></script>\n  <script src=\"entities/Photon.js\"></script>\n  <script src=\"entities/Drone.js\"></script>\n  <script src=\"entities/Mirror.js\"></script>\n  <script src=\"entities/Particle.js\"></script>\n  <script src=\"physics/FixedStepLoop.js\"></script>\n  <script src=\"InputManager.js\"></script>\n  <script src=\"Renderer.js\"></script>\n  <script src=\"main.js\"></script>\n</body>\n</html>", "utils/Vector2.js": "export default class Vector2 {\n  constructor(x = 0, y = 0) {\n    this.x = x;\n    this.y = y;\n  }\n  add(v) { this.x += v.x; this.y += v.y; return this; }\n  sub(v) { this.x -= v.x; this.y -= v.y; return this; }\n  mul(s) { this.x *= s; this.y *= s; return this; }\n  normalize() {\n    const len = this.len();\n    if (len > 0) { this.x /= len; this.y /= len; }\n    return this;\n  }\n  dot(v) { return this.x * v.x + this.y * v.y; }\n  len() { return Math.hypot(this.x, this.y); }\n  clone() { return new Vector2(this.x, this.y); }\n  static add(a, b) { return new Vector2(a.x + b.x, a.y + b.y); }\n  static sub(a, b) { return new Vector2(a.x - b.x, a.y - b.y); }\n  static mul(v, s) { return new Vector2(v.x * s, v.y * s); }\n}", "utils/GeometryUtils.js": "export function lineCircleIntersection(start, end, center, radius) {\n  const d = Vector2.sub(end, start);\n  const f = Vector2.sub(start, center);\n  const a = d.dot(d);\n  const b = 2 * f.dot(d);\n  const c = f.dot(f) - radius * radius;\n  let discriminant = b * b - 4 * a * c;\n  if (discriminant < 0) return null;\n  discriminant = Math.sqrt(discriminant);\n  const t1 = (-b - discriminant) / (2 * a);\n  const t2 = (-b + discriminant) / (2 * a);\n  if (t1 >= 0 && t1 <= 1) return t1;\n  if (t2 >= 0 && t2 <= 1) return t2;\n  return null;\n}\n\nexport function reflect(velocity, normal) {\n  const dot = velocity.dot(normal);\n  return Vector2.sub(velocity, Vector2.mul(normal, 2 * dot));\n}", "utils/ColorPalette.js": "export const COLORS = {\n  BACKGROUND: '#050508',\n  PHOTON: '#00FFFF',\n  MIRROR: '#FFFFFF',\n  MIRROR_EDGE: '#00FFFF',\n  ENEMY: '#FF0055',\n  PARTICLE_YELLOW: '#FFFF00',\n  PARTICLE_MAGENTA: '#FF0055',\n  UI_TEXT: '#E0E0E0',\n  UI_ACCENT: '#00FFFF',\n  HEALTH_HIGH: '#00FF00',\n  HEALTH_MID: '#FFFF00',\n  HEALTH_LOW: '#FF0000'\n};", "systems/ObjectPool.js": "export default class ObjectPool {\n  constructor(createFn, resetFn, initialSize = 50) {\n    this.createFn = createFn;\n    this.resetFn = resetFn;\n    this.pool = [];\n    for (let i = 0; i < initialSize; i++) {\n      this.pool.push(this.createFn());\n    }\n  }\n  acquire() {\n    if (this.pool.length > 0) {\n      return this.pool.pop();\n    } else {\n      return this.createFn();\n    }\n  }\n  release(obj) {\n    this.resetFn(obj);\n    this.pool.push(obj);\n  }\n}", "systems/AudioManager.js": "export default class AudioManager {\n  constructor() {\n    this.ctx = null;\n    this.enabled = true;\n    this.masterGain = null;\n    this.sfxGain = null;\n    this.musicGain = null;\n    this.init();\n  }\n  init() {\n    try {\n      this.ctx = new (window.AudioContext || window.webkitAudioContext)();\n      this.masterGain = this.ctx.createGain();\n      this.sfxGain = this.ctx.createGain();\n      this.musicGain = this.ctx.createGain();\n      this.sfxGain.connect(this.masterGain);\n      this.musicGain.connect(this.masterGain);\n      this.masterGain.connect(this.ctx.destination);\n      this.masterGain.gain.value = 0.7;\n      this.sfxGain.gain.value = 0.8;\n      this.musicGain.gain.value = 0.3;\n    } catch (e) {\n      this.enabled = false;\n    }\n  }\n  playBounce(freq = 400, duration = 0.1) {\n    if (!this.enabled) return;\n    const osc = this.ctx.createOscillator();\n    const gain = this.ctx.createGain();\n    osc.type = 'sine';\n    osc.frequency.setValueAtTime(freq, this.ctx.currentTime);\n    osc.frequency.exponentialRampToValueAtTime(freq * 2, this.ctx.currentTime + duration);\n    gain.gain.setValueAtTime(0.3, this.ctx.currentTime);\n    gain.gain.exponentialRampToValueAtTime(0.001, this.ctx.currentTime + duration);\n    osc.connect(gain);\n    gain.connect(this.sfxGain);\n    osc.start();\n    osc.stop(this.ctx.currentTime + duration);\n  }\n  playDroneSpawn() {\n    if (!this.enabled) return;\n    const osc = this.ctx.createOscillator();\n    const gain = this.ctx.createGain();\n    const filter = this.ctx.createBiquadFilter();\n    osc.type = 'whitenoise';\n    filter.type = 'lowpass';\n    filter.frequency.setValueAtTime(800, this.ctx.currentTime);\n    filter.frequency.exponentialRampToValueAtTime(100, this.ctx.currentTime + 0.2);\n    gain.gain.setValueAtTime(0.2, this.ctx.currentTime);\n    gain.gain.exponentialRampToValueAtTime(0.001, this.ctx.currentTime + 0.2);\n    osc.connect(filter);\n    filter.connect(gain);\n    gain.connect(this.sfxGain);\n    osc.start();\n    osc.stop(this.ctx.currentTime + 0.2);\n  }\n  playDamage() {\n    if (!this.enabled) return;\n    const osc = this.ctx.createOscillator();\n    const gain = this.ctx.createGain();\n    const filter = this.ctx.createBiquadFilter();\n    osc.type = 'sawtooth';\n    filter.type = 'lowpass';\n    filter.frequency.setValueAtTime(200, this.ctx.currentTime);\n    gain.gain.setValueAtTime(0.4, this.ctx.currentTime);\n    gain.gain.exponentialRampToValueAtTime(0.001, this.ctx.currentTime + 0.3);\n    osc.connect(filter);\n    filter.connect(gain);\n    gain.connect(this.sfxGain);\n    osc.start();\n    osc.stop(this.ctx.currentTime + 0.3);\n  }\n  playUIClick() {\n    if (!this.enabled) return;\n    const osc = this.ctx.createOscillator();\n    const gain = this.ctx.createGain();\n    osc.type = 'sine';\n    osc.frequency.setValueAtTime(1200, this.ctx.currentTime);\n    gain.gain.setValueAtTime(0.15, this.ctx.currentTime);\n    gain.gain.exponentialRampToValueAtTime(0.001, this.ctx.currentTime + 0.1);\n    osc.connect(gain);\n    gain.connect(this.sfxGain);\n    osc.start();\n    osc.stop(this.ctx.currentTime + 0.1);\n  }\n  playMovementTone(speedRatio) {\n    if (!this.enabled) return;\n    if (!this._moveOsc) {\n      this._moveOsc = this.ctx.createOscillator();\n      this._moveGain = this.ctx.createGain();\n      this._moveOsc.type = 'sine';\n      this._moveOsc.frequency.setValueAtTime(30, this.ctx.currentTime);\n      this._moveGain.gain.setValueAtTime(0.05, this.ctx.currentTime);\n      this._moveOsc.connect(this._moveGain);\n      this._moveGain.connect(this.sfxGain);\n      this._moveOsc.start();\n    }\n    const targetFreq = 30 + speedRatio * 100;\n    this._moveOsc.frequency.setValueAtTime(targetFreq, this.ctx.currentTime);\n  }\n  stopMovementTone() {\n    if (this._moveOsc) {\n      this._moveOsc.stop();\n      this._moveOsc = null;\n      this._moveGain = null;\n    }\n  }\n}", "systems/ComboManager.js": "export default class ComboManager {\n  constructor() {\n    this.bounces = 0;\n    this.multiplier = 1;\n    this.resonance = false;\n    this.lastBounceTime = 0;\n    this.comboTimeout = 2.0; // seconds\n  }\n  onBounce(timestamp) {\n    const dt = timestamp - this.lastBounceTime;\n    if (dt > this.comboTimeout) {\n      this.bounces = 0;\n    }\n    this.bounces++;\n    this.lastBounceTime = timestamp;\n    if (this.bounces >= 3 && !this.resonance) {\n      this.resonance = true;\n      this.multiplier = 2;\n    }\n  }\n  reset() {\n    this.bounces = 0;\n    this.multiplier = 1;\n    this.resonance = false;\n    this.lastBounceTime = 0;\n  }\n  update(timestamp) {\n    if (this.resonance && (timestamp - this.lastBounceTime > this.comboTimeout)) {\n      this.resonance = false;\n      this.multiplier = 1;\n    }\n  }\n}", "systems/DifficultyDirector.js": "export default class DifficultyDirector {\n  constructor() {\n    this.elapsed = 0;\n    this.spawnRate = 1.0;\n    this.mirrorRegenTime = 2.0;\n  }\n  update(dt) {\n    this.elapsed += dt;\n    if (this.elapsed % 30 < dt) {\n      this.spawnRate *= 1.1;\n      this.mirrorRegenTime *= 0.9;\n    }\n  }\n  getSpawnInterval() {\n    return Math.max(0.5, 2.0 / this.spawnRate);\n  }\n  reset() {\n    this.elapsed = 0;\n    this.spawnRate = 1.0;\n    this.mirrorRegenTime = 2.0;\n  }\n}", "entities/Entity.js": "import Vector2 from '../utils/Vector2.js';\n\nexport default class Entity {\n  constructor(x = 0, y = 0) {\n    this.position = new Vector2(x, y);\n    this.active = true;\n  }\n  update(dt) {}\n  render(ctx) {}\n  destroy() { this.active = false; }\n}", "entities/Photon.js": "import Entity from './Entity.js';\nimport Vector2 from '../utils/Vector2.js';\n\nexport default class Photon extends Entity {\n  constructor(x, y) {\n    super(x, y);\n    this.velocity = new Vector2(1, 0).normalize();\n    this.baseSpeed = 400;\n    this.speed = this.baseSpeed;\n    this.radius = 8;\n    this.health = 100;\n    this.maxHealth = 100;\n    this.turnRate = Math.PI; // 180 deg/s\n    this.boostActive = false;\n    this.boostTimer = 0;\n    this.boostCooldown = 0;\n    this.trail = [];\n    this.trailIndex = 0;\n    this.trailCapacity = 20;\n    this.phaseShiftActive = false;\n    this.phaseTimer = 0;\n    this.stasisActive = false;\n    this.stasisTimer = 0;\n    for (let i = 0; i < this.trailCapacity; i++) {\n      this.trail.push(new Vector2());\n    }\n  }\n  update(dt, input) {\n    if (this.boostCooldown > 0) this.boostCooldown -= dt;\n    if (this.boostActive) {\n      this.boostTimer -= dt;\n      if (this.boostTimer <= 0) this.boostActive = false;\n    }\n    if (this.phaseShiftActive) {\n      this.phaseTimer -= dt;\n      if (this.phaseTimer <= 0) this.phaseShiftActive = false;\n    }\n    if (this.stasisActive) {\n      this.stasisTimer -= dt;\n      if (this.stasisTimer <= 0) this.stasisActive = false;\n    }\n    if (input.left) {\n      const angle = -this.turnRate * dt;\n      this.rotateVelocity(angle);\n    }\n    if (input.right) {\n      const angle = this.turnRate * dt;\n      this.rotateVelocity(angle);\n    }\n    if (input.up && this.boostCooldown <= 0 && !this.boostActive) {\n      this.boostActive = true;\n      this.boostTimer = 0.5;\n      this.boostCooldown = 3;\n    }\n    const currentSpeed = this.boostActive ? this.speed * 1.5 : this.speed;\n    this.velocity.normalize().mul(currentSpeed);\n    this.position.add(Vector2.mul(this.velocity, dt));\n    this.trail[this.trailIndex].x = this.position.x;\n    this.trail[this.trailIndex].y = this.position.y;\n    this.trailIndex = (this.trailIndex + 1) % this.trailCapacity;\n  }\n  rotateVelocity(angle) {\n    const cos = Math.cos(angle);\n    const sin = Math.sin(angle);\n    const nx = this.velocity.x * cos - this.velocity.y * sin;\n    const ny = this.velocity.x * sin + this.velocity.y * cos;\n    this.velocity.x = nx;\n    this.velocity.y = ny;\n  }\n  reflect(normal) {\n    const dot = this.velocity.dot(normal);\n    this.velocity.x -= 2 * dot * normal.x;\n    this.velocity.y -= 2 * dot * normal.y;\n    this.speed = Math.max(this.baseSpeed * 0.5, this.speed * 0.99);\n  }\n  renderTrail(ctx) {\n    ctx.save();\n    ctx.globalCompositeOperation = 'lighter';\n    for (let i = 0; i < this.trailCapacity; i++) {\n      const idx = (this.trailIndex - i + this.trailCapacity) % this.trailCapacity;\n      const p = this.trail[idx];\n      const alpha = Math.max(0, 1 - i / this.trailCapacity);\n      const width = Math.max(0, 4 - i * 0.2);\n      ctx.strokeStyle = `rgba(0, 255, 255, ${alpha})`;\n      ctx.lineWidth = width;\n      ctx.beginPath();\n      ctx.arc(p.x, p.y, width / 2, 0, Math.PI * 2);\n      ctx.stroke();\n    }\n    ctx.restore();\n  }\n  render(ctx) {\n    this.renderTrail(ctx);\n    ctx.save();\n    if (this.phaseShiftActive) {\n      ctx.globalAlpha = 0.5 + 0.3 * Math.sin(performance.now() / 100);\n    } else {\n      ctx.globalAlpha = 1;\n    }\n    ctx.fillStyle = '#00FFFF';\n    ctx.shadowBlur = 15;\n    ctx.shadowColor = '#00FFFF';\n    ctx.beginPath();\n    ctx.arc(this.position.x, this.position.y, this.radius, 0, Math.PI * 2);\n    ctx.fill();\n    ctx.restore();\n  }\n}", "entities/Drone.js": "import Entity from './Entity.js';\nimport Vector2 from '../utils/Vector2.js';\n\nexport default class Drone extends Entity {\n  constructor(x, y, type = 'chaser') {\n    super(x, y);\n    this.type = type;\n    this.radius = 12;\n    this.velocity = new Vector2(0, 0);\n    this.speed = 0;\n    this.health = 3;\n  }\n  update(dt, photon) {\n    if (this.type === 'chaser') {\n      this.speed = photon.baseSpeed * 0.7;\n      const dir = Vector2.sub(photon.position, this.position).normalize();\n      this.velocity = Vector2.mul(dir, this.speed);\n    } else if (this.type === 'bouncer') {\n      if (this.speed === 0) {\n        this.velocity = new Vector2(Math.random() - 0.5, Math.random() - 0.5).normalize();\n        this.speed = photon.baseSpeed * 0.6;\n      }\n      this.velocity.normalize().mul(this.speed);\n    } else if (this.type === 'sniper') {\n      this.speed = 50;\n      const dir = Vector2.sub(photon.position, this.position).normalize();\n      this.velocity = Vector2.mul(dir, this.speed);\n    }\n    this.position.add(Vector2.mul(this.velocity, dt));\n  }\n  render(ctx) {\n    ctx.save();\n    ctx.fillStyle = '#FF0055';\n    ctx.shadowBlur = 10;\n    ctx.shadowColor = '#FF0055';\n    ctx.beginPath();\n    ctx.arc(this.position.x, this.position.y, this.radius, 0, Math.PI * 2);\n    ctx.fill();\n    ctx.restore();\n  }\n}", "entities/Mirror.js": "import Entity from './Entity.js';\nimport Vector2 from '../utils/Vector2.js';\n\nexport default class Mirror extends Entity {\n  constructor(x1, y1, x2, y2, rotating = false, phase = false) {\n    super((x1 + x2) / 2, (y1 + y2) / 2);\n    this.start = new Vector2(x1, y1);\n    this.end = new Vector2(x2, y2);\n    this.rotating = rotating;\n    this.phase = phase;\n    this.phaseVisible = true;\n    this.phaseTimer = 0;\n    this.rotationSpeed = rotating ? (Math.random() * 0.5 + 0.2) : 0;\n    this.angle = 0;\n  }\n  update(dt) {\n    if (this.rotating) {\n      this.angle += this.rotationSpeed * dt;\n      const cx = (this.start.x + this.end.x) / 2;\n      const cy = (this.start.y + this.end.y) / 2;\n      const len = Vector2.sub(this.end, this.start).len();\n      const dx = Math.cos(this.angle) * len / 2;\n      const dy = Math.sin(this.angle) * len / 2;\n      this.start.x = cx - dx; this.start.y = cy - dy;\n      this.end.x = cx + dx; this.end.y = cy + dy;\n    }\n    if (this.phase) {\n      this.phaseTimer += dt;\n      if (this.phaseTimer >= 2) {\n        this.phaseVisible = !this.phaseVisible;\n        this.phaseTimer = 0;\n      }\n    }\n  }\n  getNormal() {\n    const dx = this.end.x - this.start.x;\n    const dy = this.end.y - this.start.y;\n    const len = Math.hypot(dx, dy);\n    return new Vector2(-dy / len, dx / len);\n  }\n  render(ctx) {\n    if (this.phase && !this.phaseVisible) return;\n    ctx.save();\n    ctx.strokeStyle = '#FFFFFF';\n    ctx.shadowBlur = 8;\n    ctx.shadowColor = '#00FFFF';\n    ctx.lineWidth = 2;\n    ctx.beginPath();\n    ctx.moveTo(this.start.x, this.start.y);\n    ctx.lineTo(this.end.x, this.end.y);\n    ctx.stroke();\n    ctx.restore();\n  }\n}", "entities/Particle.js": "import Entity from './Entity.js';\nimport Vector2 from '../utils/Vector2.js';\n\nexport default class Particle extends Entity {\n  constructor() {\n    super(0, 0);\n    this.velocity = new Vector2(0, 0);\n    this.color = '#FFFF00';\n    this.size = 2;\n    this.life = 1;\n    this.maxLife = 1;\n    this.gravity = 0;\n  }\n  update(dt) {\n    this.velocity.add(new Vector2(0, this.gravity * dt));\n    this.position.add(Vector2.mul(this.velocity, dt));\n    this.life -= dt / this.maxLife;\n    if (this.life <= 0) this.active = false;\n  }\n  render(ctx) {\n    if (!this.active) return;\n    ctx.save();\n    ctx.globalAlpha = this.life;\n    ctx.fillStyle = this.color;\n    ctx.beginPath();\n    ctx.arc(this.position.x, this.position.y, this.size, 0, Math.PI * 2);\n    ctx.fill();\n    ctx.restore();\n  }\n}", "physics/FixedStepLoop.js": "export default class FixedStepLoop {\n  constructor(fps = 240) {\n    this.dt = 1 / fps;\n    this.accumulator = 0;\n    this.lastTime = 0;\n  }\n  update(realDt, callback) {\n    this.accumulator += realDt;\n    while (this.accumulator >= this.dt) {\n      callback(this.dt);\n      this.accumulator -= this.dt;\n    }\n  }\n}", "InputManager.js": "export default class InputManager {\n  constructor(canvas) {\n    this.canvas = canvas;\n    this.keys = {};\n    this.touch = { x: 0, y: 0, active: false };\n    this.left = false;\n    this.right = false;\n    this.up = false;\n    this.down = false;\n    this.setupKeyboard();\n    this.setupTouch();\n  }\n  setupKeyboard() {\n    window.addEventListener('keydown', (e) => {\n      this.keys[e.code] = true;\n      this.updateInputState();\n    });\n    window.addEventListener('keyup', (e) => {\n      this.keys[e.code] = false;\n      this.updateInputState();\n    });\n  }\n  setupTouch() {\n    this.canvas.addEventListener('touchstart', (e) => {\n      e.preventDefault();\n      const rect = this.canvas.getBoundingClientRect();\n      const touch = e.touches[0];\n      this.touch.x = touch.clientX - rect.left;\n      this.touch.y = touch.clientY - rect.top;\n      this.touch.active = true;\n      this.updateInputState();\n    }, { passive: false });\n    this.canvas.addEventListener('touchmove', (e) => {\n      e.preventDefault();\n      const rect = this.canvas.getBoundingClientRect();\n      const touch = e.touches[0];\n      this.touch.x = touch.clientX - rect.left;\n      this.touch.y = touch.clientY - rect.top;\n      this.updateInputState();\n    }, { passive: false });\n    this.canvas.addEventListener('touchend', () => {\n      this.touch.active = false;\n      this.updateInputState();\n    });\n  }\n  updateInputState() {\n    this.left = this.keys['ArrowLeft'] || this.keys['KeyA'] || (this.touch.active && this.touch.x < this.canvas.width / 2);\n    this.right = this.keys['ArrowRight'] || this.keys['KeyD'] || (this.touch.active && this.touch.x > this.canvas.width / 2);\n    this.up = this.keys['ArrowUp'] || this.keys['KeyW'] || this.touch.active;\n  }\n  reset() {\n    this.keys = {};\n    this.touch.active = false;\n    this.left = false;\n    this.right = false;\n    this.up = false;\n  }\n}", "Renderer.js": "import { COLORS } from './utils/ColorPalette.js';\n\nexport default class Renderer {\n  constructor(canvas) {\n    this.canvas = canvas;\n    this.ctx = canvas.getContext('2d');\n    this.dpr = window.devicePixelRatio || 1;\n    this.resize();\n    window.addEventListener('resize', () => this.resize());\n  }\n  resize() {\n    const rect = this.canvas.getBoundingClientRect();\n    this.canvas.width = rect.width * this.dpr;\n    this.canvas.height = rect.height * this.dpr;\n    this.ctx.scale(this.dpr, this.dpr);\n    this.ctx.imageSmoothingEnabled = false;\n  }\n  clear() {\n    this.ctx.fillStyle = COLORS.BACKGROUND;\n    this.ctx.fillRect(0, 0, this.canvas.width, this.canvas.height);\n  }\n  applyVignette() {\n    const grad = this.ctx.createRadialGradient(\n      this.canvas.width / 2, this.canvas.height / 2,\n      this.canvas.width * 0.3,\n      this.canvas.width / 2, this.canvas.height / 2,\n      this.canvas.width\n    );\n    grad.addColorStop(0, 'rgba(0,0,0,0)');\n    grad.addColorStop(1, 'rgba(0,0,0,0.15)');\n    this.ctx.fillStyle = grad;\n    this.ctx.fillRect(0, 0, this.canvas.width, this.canvas.height);\n  }\n  renderHUD(ctx, score, health, maxHealth, combo, resonance, phaseReady, boostCooldown, boostMax) {\n    ctx.save();\n    ctx.font = '32px \"Courier New\", monospace';\n    ctx.fillStyle = COLORS.UI_TEXT;\n    ctx.textAlign = 'center';\n    ctx.fillText(`SCORE: ${score}`, this.canvas.width / 2, 50);\n\n    const healthPercent = health / maxHealth;\n    let healthColor = COLORS.HEALTH_HIGH;\n    if (healthPercent < 0.5) healthColor = COLORS.HEALTH_LOW;\n    else if (healthPercent < 0.75) healthColor = COLORS.HEALTH_MID;\n    ctx.strokeStyle = '#333';\n    ctx.lineWidth = 2;\n    ctx.strokeRect(this.canvas.width - 220, 20, 200, 20);\n    ctx.fillStyle = healthColor;\n    ctx.fillRect(this.canvas.width - 220, 20, 200 * healthPercent, 20);\n\n    if (resonance) {\n      ctx.fillStyle = COLORS.PARTICLE_YELLOW;\n      ctx.font = '24px \"Courier New\", monospace';\n      ctx.textAlign = 'left';\n      ctx.fillText(`x${combo} RESONANCE`, 20, 50);\n    }\n\n    if (phaseReady) {\n      ctx.fillStyle = COLORS.UI_ACCENT;\n      ctx.font = '16px \"Courier New\", monospace';\n      ctx.textAlign = 'center';\n      ctx.fillText('PHASE SHIFT READY', this.canvas.width / 2, this.canvas.height - 30);\n    }\n    ctx.restore();\n  }\n  renderMenu(ctx, title, subtitle, buttons) {\n    ctx.save();\n    ctx.fillStyle = COLORS.UI_TEXT;\n    ctx.font = '48px \"Courier New\", monospace';\n    ctx.textAlign = 'center';\n    ctx.fillText(title, this.canvas.width / 2, this.canvas.height / 2 - 60);\n    ctx.font = '24px \"Courier New\", monospace';\n    ctx.fillText(subtitle, this.canvas.width / 2, this.canvas.height / 2 - 20);\n    buttons.forEach((btn, i) => {\n      ctx.fillStyle = btn.hovered ? COLORS.UI_ACCENT : COLORS.UI_TEXT;\n      ctx.font = '20px \"Courier New\", monospace';\n      ctx.fillText(btn.text, this.canvas.width / 2, this.canvas.height / 2 + 40 + i * 40);\n    });\n    ctx.restore();\n  }\n  renderGameOver(ctx, score, highScore) {\n    ctx.save();\n    ctx.fillStyle = COLORS.ENEMY;\n    ctx.font = '48px \"Courier New\", monospace';\n    ctx.textAlign = 'center';\n    ctx.fillText('SIGNAL LOST', this.canvas.width / 2, this.canvas.height / 2 - 60);\n    ctx.fillStyle = COLORS.UI_TEXT;\n    ctx.font = '32px \"Courier New\", monospace';\n    ctx.fillText(`SCORE: ${score}`, this.canvas.width / 2, this.canvas.height / 2);\n    ctx.font = '24px \"Courier New\", monospace';\n    ctx.fillText(`HIGH SCORE: ${highScore}`, this.canvas.width / 2, this.canvas.height / 2 + 50);\n    ctx.fillText('RETRY', this.canvas.width / 2, this.canvas.height / 2 + 100);\n    ctx.fillText('MENU', this.canvas.width / 2, this.canvas.height / 2 + 140);\n    ctx.restore();\n  }\n}", "main.js": "import Vector2 from './utils/Vector2.js';\nimport { COLORS } from './utils/ColorPalette.js';\nimport ObjectPool from './systems/ObjectPool.js';\nimport AudioManager from './systems/AudioManager.js';\nimport ComboManager from './systems/ComboManager.js';\nimport DifficultyDirector from './systems/DifficultyDirector.js';\nimport Photon from './entities/Photon.js';\nimport Drone from './entities/Drone.js';\nimport Mirror from './entities/Mirror.js';\nimport Particle from './entities/Particle.js';\nimport FixedStepLoop from './physics/FixedStepLoop.js';\nimport InputManager from './InputManager.js';\nimport Renderer from './Renderer.js';\n\nconst canvas = document.getElementById('gameCanvas');\nconst renderer = new Renderer(canvas);\nconst ctx = renderer.ctx;\nconst input = new InputManager(canvas);\nconst audio = new AudioManager();\nconst combo = new ComboManager();\nconst difficulty = new DifficultyDirector();\nconst fixedLoop = new FixedStepLoop(240);\n\nconst STATE = { MENU: 0, PLAYING: 1, PAUSED: 2, GAME_OVER: 3, VICTORY: 4 };\nlet gameState = STATE.MENU;\n\nlet photon;\nlet drones = [];\nlet mirrors = [];\nlet particles = [];\nlet particlePool;\nlet score = 0;\nlet highScore = localStorage.getItem('photonReflexHighScore') || 0;\nlet speedrunTime = 0;\nlet lastTime = 0;\nlet spawnTimer = 0;\nlet menuButtons = [\n  { text: 'INITIATE', hovered: false },\n  { text: 'SETTINGS', hovered: false }\n];\nlet settings = {\n  masterVolume: 0.7,\n  sfxVolume: 0.8,\n  musicVolume: 0.3,\n  bloomEnabled: true,\n  sensitivity: 1.0\n};\n\nfunction initParticle(p) {\n  p.position.x = 0; p.position.y = 0;\n  p.velocity.x = 0; p.velocity.y = 0;\n  p.color = COLORS.PARTICLE_YELLOW;\n  p.size = 2;\n  p.life = 1; p.maxLife = 1;\n  p.gravity = 0;\n  p.active = false;\n}\n\nparticlePool = new ObjectPool(\n  () => new Particle(),\n  initParticle,\n  100\n);\n\nfunction createMirrors() {\n  mirrors = [];\n  const w = canvas.width / renderer.dpr;\n  const h = canvas.height / renderer.dpr;\n  mirrors.push(new Mirror(100, 100, w - 100, 100, false, false));\n  mirrors.push(new Mirror(100, h - 100, w - 100, h - 100, false, false));\n  mirrors.push(new Mirror(100, 100, 100, h - 100, false, false));\n  mirrors.push(new Mirror(w - 100, 100, w - 100, h - 100, false, false));